+/// A compile-time constant: `KEY=VALUE`, where the value is JSON (a string is `'"text"'`) or else an
+/// expression, as Next.js's `defines` reads its env map.
+#[turbo_tasks::task_input]
+#[derive(Clone, Debug, PartialEq, Eq, Hash, Encode, Decode)]
+pub struct Define {
+    pub key: turbo_rcstr::RcStr,
+    pub value: turbo_rcstr::RcStr,
+}
+
+fn parse_define(s: &str) -> anyhow::Result<Define> {
+    let (key, value) = s
+        .split_once('=')
+        .ok_or_else(|| anyhow!("a define is KEY=VALUE, not {s}"))?;
+    Ok(Define {
+        key: key.into(),
+        value: value.into(),
+    })
+}
+
 #[derive(Debug, Args)]
 #[clap(author, version, about, long_about = None)]
 pub struct BuildArguments {
     #[clap(flatten)]
     pub common: CommonArguments,
 
+    /// Replace a global expression with a constant: `--define process.env.X='"value"'`. May be
+    /// given more than once.
+    #[clap(long = "define", value_parser = parse_define)]
+    pub defines: Vec<Define>,
+
     /// Don't generate sourcemaps.
     #[clap(long)]
     pub no_sourcemap: bool,
