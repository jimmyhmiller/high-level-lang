;;; The `.rules` grammar as ordinary compile-time Coil. A reader's implementation cannot
;;; come from another reader, but a generator in a plain module can expand one. The text
;;; is read here, so the generated names belong to this module.
(module hl.grammars.rules)
(import "coil.primitive" :as primitive)
(import "hl.syntax" :as syntax)
;; What the generated code uses: imports inside a macro's expansion come too late.
(import "coil.alloc" :use [malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(import "hl.quote" :as hq)
(defn generate [] (-> Code)
  (primitive/code-read
    (syntax/read-grammar (include-str "../../../lang/languages/rules.syntax") "lang/languages/rules.syntax")
    `(reader-config)))
(generate)
