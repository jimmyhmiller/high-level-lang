# A source coarsely: where a top-level statement may begin, so a large file can be cut there and
# parsed in pieces. A cut is a line break at the top level before a declaration; everything between
# two cuts is one piece of code, matched and not kept. Brackets and template holes nest; strings,
# comments, template text and regular expressions are opaque. A `/` right after an operand divides,
# and anywhere else begins a regular expression. A cut in the wrong place costs only time: a piece
# that is not a program sends the whole file to the full parser.
syntax
start Coarse
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
fragment Declaration = "function " | "function*" | "async function" | "class " | "export " | "var " | "let " | "const " ;
fragment WordByte = [a-zA-Z0-9_$] | [\x80-\xff] ;
fragment Blank = [ \t\r]+ ;
fragment Note = "//" [^\n]* | "/*" (!"*/" .)* "*/" ;
fragment Quoted = "\"" ("\\" . | [^"\\\n])* "\"" | "'" ("\\" . | [^'\\\n])* "'" ;
fragment Keyword = ("return" | "typeof" | "instanceof" | "in" | "of" | "new" | "delete" | "void"
                   | "throw" | "case" | "do" | "else" | "yield" | "await") !WordByte ;
fragment Regex = "/" ![/*] ("\\" [^\n] | "[" ("\\" [^\n] | [^\]\\\n])* "]" | [^/\\\[\n])+ "/" ;
fragment Division = "/" ![/*] ;
fragment TemplateChars = ("\\" . | !"`" !"${" .)* ;
fragment Template = "`" TemplateChars ("${" Inner* "}" TemplateChars)* "`" ;
fragment Atom = Quoted | WordByte+ | Template | "(" Inner* ")" | "[" Inner* "]" | "{" Inner* "}" ;
# An operand and the divisions after it.
fragment Operand = Atom ((Blank | "\n")* Division)* ;
fragment Other = [^\n \t\r/"'`(){}\[\]a-zA-Z0-9_$\x80-\xff]+ ;
fragment Element = Blank | Note | Keyword | Operand | Regex | Division | Other ;
fragment Inner = Element | "\n" ;

token Cut = "\n" &Declaration ;
token Code = (Element | "\n" !Declaration)+ ;

rule Coarse = Piece* -> Coarse ;
rule Piece = Cut | Code ;
