# What a file loads at run time: its `require("x")` and `import("x")` calls, in source order,
# gathered in one traversal.
attrs bundle.calls over bundle.js

collect requires: [Text]
collect imports: [Text]

on CallExpr(Ident("require"), Args(List(Str(raw)))) { requires += unquote(raw) }
on ImportCall(Str(raw), ...) { imports += unquote(raw) }
