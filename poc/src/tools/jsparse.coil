;;; Test driver for the JavaScript parser.
;;;   jsparse print FILE        print the compact form to stdout
;;;   jsparse check LISTFILE    parse each path in LISTFILE; report the ones that fail
;;; A path ending in .module.js parses with module flags (top-level await).
(module tools.jsparse)
(import "coil.args" :as args)
(import "coil.slice" :use [subslice])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "demo.js" :as js)
(import "hl.rt" :as rt)

(defn module-file? [(path (slice u8))] (-> bool)
  (let [suffix ".module.js" n (len path) m (len suffix)]
    (and (>= n m) (= (subslice path (- n m) n) suffix))))

(defn flags-for [(path (slice u8))] (-> i64)
  (if (module-file? path) js/FLAG-await 0))

(defn lines-of [(text (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator)) (mut start) 0]
    (for i (range 0 (len text))
      (when (= (get text i) #\newline)
        (when (> i start) (push! (mut out) (subslice text start i)))
        (set! start (+ i 1))))
    out))

(defn check-list [(list (slice u8)) (quiet bool)] (-> i64)
  (let [(mut good) 0 (mut bad) 0]
    (for path (lines-of (rt/read-all list))
      (match (js/parse-result (rt/read-all path) path (flags-for path))
        (Ok [_] (set! good (+ good 1)) (when quiet (println "OK {}" path)))
        (Err [e]
          (set! bad (+ bad 1))
          (unless quiet
            (println "FAIL {}:{}:{} expected {} found {:?}" (.path e) (.line e) (.col e) (.want e) (.found e))))))
    (println "parsed {} failed {}" good bad)
    0))

;;; Print each listed file to OUTDIR/<index>.js, for differential testing.
(defn print-all [(list (slice u8)) (outdir (slice u8))] (-> i64)
  (let [(mut i) 0]
    (for path (lines-of (rt/read-all list))
      (match (js/parse-result (rt/read-all path) path (flags-for path))
        (Ok [tree]
          (rt/write-output (rt/join (rt/join outdir "/") (rt/join (rt/num-text i) ".js"))
                           (js/render tree false)))
        (Err [_] 0))
      (set! i (+ i 1)))
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [cmd (if (> (args/count) 1) (args/nth 1) "")
        arg (if (> (args/count) 2) (args/nth 2) "")]
    (cond
      (= cmd "print")
        (let [src (rt/read-all arg)]
          (match (js/parse-result src arg (flags-for arg))
            (Ok [tree] (println "{}" (js/render tree false)) 0)
            (Err [e] (rt/parse-failed e))))
      (= cmd "printall") (print-all arg (args/nth 3))
      (= cmd "check") (check-list arg false)
      (= cmd "accepted") (check-list arg true)
      :else (do (println "usage: jsparse print FILE | check LIST | accepted LIST") 1))))
