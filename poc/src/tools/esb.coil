;;; Command line, esbuild style:
;;;   esb ENTRY --outfile=PATH [--format=iife|esm|cjs] [--global-name=X] [--minify]
;;;       [--minify-identifiers] [--minify-syntax] [--pretty] [--timing]
;;;       [--define:KEY=VALUE]…
(module tools.esb)
(import "coil.args" :as args)
(import "coil.slice" :use [subslice])
(import "bundle.api" :as api)
(import "hl.rt" :as rt)

(defn after [(a (slice u8)) (prefix (slice u8))] (-> (slice u8))
  (subslice a (len prefix) (len a)))

(defn define-arg! [(o (mut api/Options)) (body (slice u8))] (-> void)
  (let [(mut cut) -1]
    (for i (range 0 (len body))
      (when (and (< cut 0) (= (get body i) #\=)) (set! cut i)))
    (when (< cut 0) (panic "--define needs KEY=VALUE, got {}" body))
    (api/define! (mut o) (subslice body 0 cut) (subslice body (+ cut 1) (len body)))))

(defn run [] (-> void)
  (let [(mut o) (api/options-new (args/nth 1) "")]
    (for i (range 2 (args/count))
      (let [a (args/nth i)]
        (cond
          (rt/at? a 0 "--outfile=") (set! (.outfile o) (after a "--outfile="))
          (= a "--format=iife") (set! (.format o) (api/Iife))
          (= a "--format=esm") (set! (.format o) (api/Esm))
          (= a "--format=cjs") (set! (.format o) (api/Cjs))
          (rt/at? a 0 "--global-name=") (set! (.global-name o) (after a "--global-name="))
          (rt/at? a 0 "--define:") (define-arg! (mut o) (after a "--define:"))
          (= a "--pretty") (set! (.pretty o) true)
          (= a "--timing") (set! (.timing o) true)
          (= a "--minify-identifiers") (set! (.minify-identifiers o) true)
          (= a "--minify-syntax") (set! (.minify-syntax o) true)
          (= a "--minify")
            (do (set! (.minify-identifiers o) true) (set! (.minify-syntax o) true))
          :else (panic "unknown option {}" a))))
    (api/build o)))

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (run)
  arg)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (api/run-on-big-stack (fnptr-of worker))
  0)
