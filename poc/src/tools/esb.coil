;;; Boot: arguments, a big stack, then the program in esb.rules.
(module tools.esb-main)
(import "coil.args" :as args)
(import "hl.rt" :as rt)
(import "tools.esb" :as esb)

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (esb/run)
  arg)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (rt/run-on-big-stack (fnptr-of worker))
  0)
