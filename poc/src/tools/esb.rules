# The command line, esbuild style:
#   esb ENTRY… --outfile=PATH | --outdir=DIR [--splitting] [--format=iife|esm|cjs] [--global-name=X] [--minify]
#       [--minify-identifiers] [--minify-syntax] [--pretty] [--timing] [--define:KEY=VALUE]…
rules tools.esb
use bundle.api as api
use bundle.modules as m
use bundle.jsx as jsx

main run on big stack

fn after(a: Text, prefix: Text) -> Text = a[len(prefix)..len(a)]

fn split-at-equals(body: Text) -> m.TextPair {
  var cut = -1
  for i in 0..len(body) {
    if cut < 0 and body[i] == '=' { cut = i }
  }
  if cut < 0 { panic "expected KEY=VALUE, got {}", body }
  m.TextPair(key: body[0..cut], value: body[cut + 1..len(body)])
}

fn split-commas(s: Text) -> [Text] {
  var out: [Text] = []
  var start = 0
  for i in 0..len(s) {
    if s[i] == ',' {
      out += s[start..i]
      start = i + 1
    }
  }
  out += s[start..len(s)]
  [x for x in out if len(x) > 0]
}

fn define-arg!(o: mut api.Options, body: Text) -> Void {
  let pair = split-at-equals(body)
  api.define!(o, pair.key, pair.value)
}

fn option!(o: mut api.Options, a: Text) -> Void = match a {
  "--format=iife" => { o.format = api.iife-format() }
  "--format=esm" => { o.format = api.esm-format() }
  "--format=cjs" => { o.format = api.cjs-format() }
  "--tree-shaking=false" => { o.tree-shaking = false }
  "--jsx-dev" => api.jsx-dev!(o)
  "--jsx-side-effects" => {
    o.jsx.side-effects = true
    o.jsx.explicit = true
  }
  "--pretty" => { o.pretty = true }
  "--timing" => { o.timing = true }
  "--sourcemap" => { o.sourcemap = true }
  "--platform=node" => api.platform-node!(o)
  "--platform=browser" => {}
  "--bundle" => {}
  "--charset=utf8" => { o.charset-ascii = false }
  "--charset=ascii" => { o.charset-ascii = true }
  "--drop:console" => { o.drop-console = true }
  "--drop:debugger" => { o.drop-debugger = true }
  "--packages=external" => { o.packages-external = true }
  "--packages=bundle" => { o.packages-external = false }
  "--splitting" => { o.splitting = true }
  "--minify-identifiers" => { o.minify-identifiers = true }
  "--minify-syntax" => { o.minify-syntax = true }
  "--minify" => {
    o.minify-identifiers = true
    o.minify-syntax = true
  }
  _ if starts-with(a, "--jsx=") => api.jsx-runtime!(o, after(a, "--jsx="))
  _ if starts-with(a, "--jsx-factory=") => api.jsx-factory!(o, after(a, "--jsx-factory="))
  _ if starts-with(a, "--jsx-fragment=") => api.jsx-fragment!(o, after(a, "--jsx-fragment="))
  _ if starts-with(a, "--jsx-import-source=") => api.jsx-import-source!(o, after(a, "--jsx-import-source="))
  _ if starts-with(a, "--tsconfig=") => { o.tsconfig = after(a, "--tsconfig=") }
  _ if starts-with(a, "--outfile=") => { o.outfile = after(a, "--outfile=") }
  _ if starts-with(a, "--legal-comments=") => { o.legal-comments = after(a, "--legal-comments=") }
  _ if starts-with(a, "--target=") => api.target!(o, after(a, "--target="))
  _ if starts-with(a, "--outdir=") => { o.outdir = after(a, "--outdir=") }
  _ if starts-with(a, "--outbase=") => { o.outbase = after(a, "--outbase=") }
  _ if starts-with(a, "--entry-names=") => { o.entry-names = after(a, "--entry-names=") }
  _ if starts-with(a, "--chunk-names=") => { o.chunk-names = after(a, "--chunk-names=") }
  _ if starts-with(a, "--global-name=") => { o.global-name = after(a, "--global-name=") }
  _ if starts-with(a, "--define:") => define-arg!(o, after(a, "--define:"))
  _ if starts-with(a, "--external:") => { o.external += after(a, "--external:") }
  _ if starts-with(a, "--alias:") => {
    let pair = split-at-equals(after(a, "--alias:"))
    api.alias!(o, pair.key, pair.value)
  }
  _ if starts-with(a, "--loader:") => {
    let pair = split-at-equals(after(a, "--loader:"))
    api.loader!(o, pair.key, pair.value)
  }
  _ if starts-with(a, "--banner:js=") => { o.banner = after(a, "--banner:js=") }
  _ if starts-with(a, "--footer:js=") => { o.footer = after(a, "--footer:js=") }
  _ if starts-with(a, "--main-fields=") => { o.main-fields = split-commas(after(a, "--main-fields=")) }
  _ if starts-with(a, "--conditions=") => { o.conditions = split-commas(after(a, "--conditions=")) }
  _ if starts-with(a, "--resolve-extensions=") => { o.extensions = split-commas(after(a, "--resolve-extensions=")) }
  _ if starts-with(a, "--pure:") => { o.pure += after(a, "--pure:") }
  _ if starts-with(a, "--public-path=") => { o.public-path = after(a, "--public-path=") }
  _ if starts-with(a, "--log-level=") => {}
  _ if not starts-with(a, "--") => { o.entries += a }
  _ => panic "unknown option {}", a
}

fn run() -> Void {
  var o = api.options-new(arg-at(1), "")
  var times = 1
  for i in 2..arg-count() {
    let a = arg-at(i)
    # For a profiler: run the whole build this many times in one process.
    if starts-with(a, "--repeat=") { times = parse-int(after(a, "--repeat=")) } else { option!(o, a) }
  }
  for i in 0..times { api.build(o) }
}
