# esbuild's plugin model, as ordinary functions a spec wires in: a resolve hook claims an import, a
# load hook supplies its text.
rules app.plugins

fn virtual-resolve(spec: Text, importer: Text) -> Text? =
  if starts-with(spec, "virtual:") then some(spec) else none

fn virtual-load(path: Text) -> Text? =
  if path == "virtual:version" then some("export const version = \"1.2.3\";") else none
