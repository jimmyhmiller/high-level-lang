# The demo build, from the top of the tower: three targets, each its own bundler.
bundler

use rewrite strip-debug = app.strip-debug
use rewrite shrink = bundle.minify
use rewrite spell = bundle.final
use rules note = app.passes/note
use rules virtual-resolve = app.plugins/virtual-resolve
use rules virtual-load = app.plugins/virtual-load

# A format is something a spec writes: this one sets a global, whatever the module exports.
format attach
  prefix "(function(){"
  suffix "})();\n"
  exports "globalThis.bundled = %;"
end

target client
  entry "app/named.js"
  outfile "out/spec/client.js"
  format iife
  define process.env.NODE_ENV = "production"
  main-fields module main
  conditions import browser
  minify
  transform strip-debug
  optimize note shrink spell
end

target server
  entry "app/named.js"
  outfile "out/spec/server.js"
  format cjs
  platform node
  define process.env.NODE_ENV = "development"
  sourcemap
  pretty
end

target library
  entry "app/lib.js"
  outfile "out/spec/lib.mjs"
  format esm
  minify syntax
end

# JSX, its call chosen by the spec.
target ui
  entry "app/jsx/spec.jsx"
  outfile "out/spec/ui.cjs"
  jsx-factory "h"
end

# Code for an older engine.
target old
  entry "app/lower/spec.js"
  outfile "out/spec/old.js"
  language es2017
end

# Plugins, a spec-defined format, a banner and a loader.
target plugged
  entry "app/plugged.js"
  outfile "out/spec/plugged.js"
  format attach
  banner "/* built by the spec */"
  loader ".txt" = text
  on-resolve virtual-resolve
  on-load virtual-load
end
