# The demo build, from the top of the tower: one app, three targets.
bundler

use rewrite strip-debug = app.strip-debug
use rewrite minify = bundle.minify
use rewrite final = bundle.final
use coil drop-empty-exports = app.passes/note

target client
  entry "app/named.js"
  outfile "out/spec/client.js"
  format iife
  define process.env.NODE_ENV = "production"
  main-fields module main
  conditions import browser
  minify
  transform strip-debug
  optimize minify final
end

target server
  entry "app/named.js"
  outfile "out/spec/server.js"
  format cjs
  define process.env.NODE_ENV = "development"
  pretty
end

target library
  entry "app/lib.js"
  outfile "out/spec/lib.mjs"
  format esm
  minify syntax
end
