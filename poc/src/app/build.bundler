# The demo build, from the top of the tower: three targets, each its own bundler.
bundler

use rewrite strip-debug = app.strip-debug
use rewrite shrink = bundle.minify
use rewrite spell = bundle.final
use coil note = app.passes/note

target client
  entry "app/named.js"
  outfile "out/spec/client.js"
  format iife
  define process.env.NODE_ENV = "production"
  main-fields module main
  conditions import browser
  minify
  transform strip-debug
  optimize note shrink spell
end

target server
  entry "app/named.js"
  outfile "out/spec/server.js"
  format cjs
  platform node
  define process.env.NODE_ENV = "development"
  sourcemap
  pretty
end

target library
  entry "app/lib.js"
  outfile "out/spec/lib.mjs"
  format esm
  minify syntax
end
