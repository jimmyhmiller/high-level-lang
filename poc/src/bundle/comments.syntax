# A source file as block comments and whatever is between them. Comments are not in the JavaScript
# tree, and annotations live in them.
syntax
start Scan
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
token Comment = "/*" (!"*/" .)* "*/" ;
token Stray = "/*" ;
token Gap = (!"/*" .)+ ;

rule Scan = ScanPiece* -> Scan ;
rule ScanPiece = Comment | Stray | Gap ;
