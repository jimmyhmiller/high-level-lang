# The last pass: shortest spellings, once nothing needs to recognise the long ones.
rewrite bundle.js
host bundle.minhost
leaves Num Str Ident PropName ;

rule true-short  : True() => Not(Num(0)) ;
rule false-short : False() => Not(Num(1)) ;
rule num-short   : Num(_) as n when @num-shorter(n) => @num-short(n) ;
rule str-best    : Str(_) as n when @str-better(n) => @str-best(n) ;
