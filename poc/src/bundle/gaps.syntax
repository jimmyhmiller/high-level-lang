# What lies between two tokens of a parsed program: space and comments, and in TypeScript the types
# the grammar threw away, whose strings must not be taken for comments.
syntax
start Gap
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
token BlockNote = "/*" (!"*/" .)* "*/" ;
token LineNote = "//" [^\n\r]* ;
token Quoted = "\"" ("\\" . | [^"\\\n])* "\"" | "'" ("\\" . | [^'\\\n])* "'" | "`" ("\\" . | [^`\\])* "`" ;
token Other = . ;

rule Gap = GapPiece* -> Gap ;
rule GapPiece = BlockNote | LineNote | Quoted | Other ;
