;;; Identifier minification, after esbuild's minify renamer. Symbols in sibling scopes
;;; can share a name, so nested symbols get a "slot" by depth; top-level symbols each get
;;; their own. Slots are sorted by how often their symbols are used, and the commonest
;;; gets the shortest name, drawn from an alphabet ordered by character frequency.
(module bundle.mangle)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "bundle.js" :as js)
(import "bundle.graph" :as g)
(import "bundle.emit" :as e)
(import "bundle.link" :as facts)
(import "hl.symtab" :as sym)
(import "hl.rt" :as rt)

(defstruct Mangler
  [(counts (ArrayList i64))      ; uses per slot
   (slot (HashMap i64 i64))      ; symbol -> slot
   (uses (HashMap i64 i64))      ; symbol -> uses in live code
   (freq (ArrayList i64))])      ; per byte value

(defn bump! [(m (mut Mangler)) (s i64)] (-> void)
  (match (get (.uses m) s)
    (Some [n] (set! (mut (.uses m)) s (+ n 1)))
    (None [] (set! (mut (.uses m)) s 1))))

;;; Count uses in live code only, attributing an import to what it resolves to.
(defn count-uses! [(gr (mut g/Graph)) (ma (mut Mangler)) (mo g/Module) (n js/Node)] (-> void)
  (when (or (= (.kind n) (js/KIdent)) (= (.kind n) (js/KBindName)))
    (match (get (.bindings mo) (.lo n))
      (Some [s] (bump! (mut ma) (e/target-of (mut gr) s)))
      (None [] 0)))
  (for k (.kids n) (count-uses! (mut gr) (mut ma) mo k)))

(defn uses-of [(ma (mut Mangler)) (s i64)] (-> i64)
  (match (get (.uses ma) s) (Some [n] n) (None [] 0)))

(defn take-slot! [(ma (mut Mangler)) (s i64) (slot i64)] (-> void)
  (while (<= (len (.counts ma)) slot) (push! (mut (.counts ma)) 0))
  (set! (mut (.slot ma)) s slot)
  (set! (mut (.counts ma)) slot (+ (get (.counts ma) slot) (uses-of (mut ma) s))))

;;; Nested symbols: siblings restart from where their parent's symbols stopped.
(defn nested-slots! [(gr (mut g/Graph)) (ma (mut Mangler)) (scope i64) (first i64)] (-> void)
  (let [sc (get (.scopes (.table gr)) scope)
        (mut next) first]
    (unless (.dynamic sc)
      (for s (.symbols sc)
        (take-slot! (mut ma) s next)
        (set! next (+ next 1))))
    (for child (.children sc) (nested-slots! (mut gr) (mut ma) child next))))

(defn scan-freq! [(ma (mut Mangler)) (src (slice u8))] (-> void)
  (for c src
    (let [i (cast i64 c)]
      (set! (mut (.freq ma)) i (+ (get (.freq ma) i) 1)))))

;;; Name characters, commonest first, so frequent symbols compress well.
(defn sorted-chars [(ma (mut Mangler)) (candidates (slice u8))] (-> (ArrayList u8))
  (let [(mut out) (ArrayList::new [u8] (malloc-allocator))]
    (for c candidates (push! (mut out) c))
    (for i (range 1 (len out))
      (let [(mut j) i]
        (while (and (> j 0)
                    (> (get (.freq ma) (cast i64 (get out j)))
                       (get (.freq ma) (cast i64 (get out (- j 1))))))
          (let [x (get out j)]
            (set! (mut out) j (get out (- j 1)))
            (set! (mut out) (- j 1) x))
          (set! j (- j 1)))))
    out))

(defn minified-name [(head (ArrayList u8)) (tail (ArrayList u8)) (index i64)] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] (malloc-allocator))
        (mut i) index
        h (len head)
        t (len tail)]
    (push! (mut b) (get head (% i h)))
    (set! i (/ i h))
    (while (> i 0)
      (set! i (- i 1))
      (push! (mut b) (get tail (% i t)))
      (set! i (/ i t)))
    (slice b)))

;;; Slot numbers, by descending use; ties keep slot order.
(defn order-by-count [(counts (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut order) (ArrayList::new [i64] (malloc-allocator))
        (mut buckets) (HashMap::new-scalar [i64 (ArrayList i64)] (malloc-allocator))
        (mut top) 0]
    (for i (range 0 (len counts))
      (let [c (get counts i)]
        (when (> c top) (set! top c))
        (match (get buckets c)
          (Some [b]
            (let [(mut x) b]
              (push! (mut x) i)
              (set! (mut buckets) c x)))
          (None []
            (let [(mut x) (ArrayList::new [i64] (malloc-allocator))]
              (push! (mut x) i)
              (set! (mut buckets) c x))))))
    (let [(mut c) top]
      (while (>= c 0)
        (match (get buckets c)
          (Some [b] (for i b (push! (mut order) i)))
          (None [] 0))
        (set! c (- c 1))))
    order))

(defn assign-minified! [(gr (mut g/Graph))] (-> void)
  (let [(mut ma) (Mangler
                   :counts (ArrayList::new [i64] (malloc-allocator))
                   :slot (HashMap::new-scalar [i64 i64] (malloc-allocator))
                   :uses (HashMap::new-scalar [i64 i64] (malloc-allocator))
                   :freq (ArrayList::new [i64] (malloc-allocator)))
        (mut n) (e/Namer :used (e/new-names)
                         :stack (ArrayList::new [(HashMap (slice u8) i64)] (malloc-allocator)))
        (mut toplevel) (ArrayList::new [i64] (malloc-allocator))]
    (for _ (range 0 256) (push! (mut (.freq ma)) 0))
    (for w (e/keywords) (e/reserve! (mut n) w))
    (for id (.order gr)
      (when (or (= id 0) (e/included? (mut gr) id))
        (for f (.free (g/module-at (mut gr) id)) (e/reserve! (mut n) f))))
    ;; Live code: uses, character frequency, and the top-level symbols in order.
    (for id (.order gr)
      (when (e/included? (mut gr) id)
        (let [mo (g/module-at (mut gr) id)]
          (scan-freq! (mut ma) (.text-for-freq mo))
          (for p (e/parts-of (mut gr) id)
            (when (e/live? (mut gr) p)
              (count-uses! (mut gr) (mut ma) mo (get (.part-stmt gr) p))
              (for row (rt/rel-bucket (mut (.declares (.db gr))) 0 p)
                (let [s (rt/rel-at (mut (.declares (.db gr))) row 1)]
                  (unless (e/import-symbol? (mut gr) s)
                    (push! (mut toplevel) s)))))))))
    ;; Nested slots first, so top-level symbols never collide with them.
    (for id (.order gr)
      (when (e/included? (mut gr) id)
        (let [mo (g/module-at (mut gr) id)
              root (get (.scopes (.table gr)) (.root mo))]
          (if (= (.kind mo) (g/Cjs))
              (nested-slots! (mut gr) (mut ma) (.parent root) 0)
              (for child (.children root) (nested-slots! (mut gr) (mut ma) child 0))))))
    (let [(mut next) (len (.counts ma))]
      (for s toplevel
        (take-slot! (mut ma) s next)
        (set! next (+ next 1))))
    (let [head (sorted-chars (mut ma) "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$")
          tail (sorted-chars (mut ma) "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789")
          order (order-by-count (.counts ma))
          (mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut index) 0]
      (for _ (range 0 (len (.counts ma))) (push! (mut names) ""))
      (for slot order
        (let [(mut candidate) (minified-name head tail index)]
          (while (e/taken? (mut n) candidate)
            (set! index (+ index 1))
            (set! candidate (minified-name head tail index)))
          (set! index (+ index 1))
          (set! (mut names) slot candidate)))
      ;; Names for every slotted symbol; a dynamic scope's symbols keep theirs.
      (for s (range 0 (len (.symbols (.table gr))))
        (match (get (.slot ma) s)
          (Some [slot] (e/set-final! (mut gr) s (get names slot)))
          (None [] 0))))))
