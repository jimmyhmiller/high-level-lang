# What follows minifying, in one walk: the shortest spellings (`final.rewrite`), strings as
# templates where that is shorter, and, with `--charset=ascii`, ASCII. Each changes only leaves, so
# one walk does what three did, leaf by leaf in the same order; what each skips is a subtree,
# carried down as a flag. Nothing is copied where nothing changes.
rules bundle.finish over bundle.js
use bundle.js as js
use bundle.final as final
use bundle.minhost as host
use bundle.ascii as ascii

# The finished program; `ascii-on` when the output is to be ASCII.
fn finished(n: Node, ascii-on: Bool) -> Node = finished-under(n, true, ascii-on) ?? n

# `templates`: whether strings here may become templates; `ascii-on`: whether text here is made
# ASCII. Nothing when nothing under `n` changes.
fn finished-under(n: Node, templates: Bool, ascii-on: Bool) -> Node? = match n {
  True() | False() | Num(_) | Str(_) => leaf-finished(n, templates, ascii-on)
  _ => if len(n.kids) == 0 then (if ascii-on then ascii.ascii-opt(n) else none) else {
    # What `ascii.ascii-opt` leaves alone here, it leaves alone beneath.
    if ascii-on and (n is Regex(_) | JsxText(_) | JsxStr(_) | JsxTagText(_) | JsxName(_)) {
      return finished-under(n, templates, false)
    }
    var out: [Node] = []
    var changed = false
    for i in 0..len(n.kids) {
      let k = n.kids[i]
      let r = finished-under(k, templates and kid-templates?(n, i, k), ascii-on and kid-ascii?(n, i))
      if is-some(r) and not changed {
        changed = true
        out = n.kids[0..i]
      }
      if changed { out += r ?? k }
    }
    if changed then some(n with { kids: out }) else none
  }
}

# A leaf: its shortest spelling, then a template, then ASCII, as the three passes made it.
fn leaf-finished(n: Node, templates: Bool, ascii-on: Bool) -> Node? {
  let short = final.run(n)
  let tpl = if templates and short is Str(_) then host.templated(short) ?? short else short
  let out = if ascii-on then ascii.ascii-opt(tpl) ?? tpl else tpl
  if unchanged-leaf?(out, n) then none else some(out)
}

# The same leaf, whatever pass stamped it.
fn unchanged-leaf?(a: Node, b: Node) -> Bool =
  len(a.kids) == 0 and a.kind == b.kind and a.text == b.text and a.lo == b.lo and a.hi == b.hi

# `host.templates` leaves a directive's string as it is, and the first child of a node whose first
# child is a key.
fn kid-templates?(n: Node, i: Int, k: Node) -> Bool =
  not (n is ExprStmt(_) and k is Str(_)) and not (i == 0 and host.key-first?(n))

# `ascii.ascii-opt` leaves JSX names, and a tagged template's text, as they are.
fn kid-ascii?(n: Node, i: Int) -> Bool = match n {
  JsxElement(...) | JsxAttr(...) => i != 0
  JsxClose(...) => i != 1
  Tagged(...) => i != 1
  _ => true
}
