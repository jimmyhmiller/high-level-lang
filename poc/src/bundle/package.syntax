# JSON: enough to read package.json.
syntax
start Doc
space Space
word WordChar

fragment Space = [ \t\n\r]* ;
fragment WordChar = [a-z] ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Num = [\-]? [0-9]+ ("." [0-9]+)? ([eE] [+\-]? [0-9]+)? ;

rule Doc = Value ;
rule Value
  = Str | Num
  | "true" -> True
  | "false" -> False
  | "null" -> Null
  | "[" Value,* "]" -> Array
  | "{" Member,* "}" -> Object
  ;
rule Member = Str ":" Value -> Member ;
