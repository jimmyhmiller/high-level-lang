# Identifier minification, after esbuild's minify renamer. Symbols in sibling scopes can share a
# name, so nested symbols get a "slot" by depth; top-level symbols each get their own. Slots are
# sorted by how often their symbols are used, and the commonest gets the shortest name, drawn from
# an alphabet ordered by character frequency.
rules bundle.mangle over bundle.js
use bundle.modules as m
use bundle.emit as e
use bundle.analysis as an

state counts: [Int] = []       # uses per slot
state slot: [Int] = []         # symbol -> slot, -1 for none
state uses: [Int] = []         # symbol -> uses in live code
state freq: [Int] = []         # per byte value
state tags: [Bool] = []        # symbol -> whether a kept JSX tag names it
state capital: {Int:Bool} = {} # slots holding one of those

# What one module's live code uses: how often each symbol, which name kept JSX tags, how often
# each byte, and the top-level symbols its parts declare, in order. Modules are counted at once;
# the sums do not depend on the order they are added in.
record Usage { uses: {Int:Int}, tags: [Int], freq: [Int], toplevel: [Int] }

task state module-uses: {Int:Int} = {}
task state module-tags: [Int] = []

# Count uses in live code only, attributing an import to what it resolves to.
fn count-uses(mo: m.Module, n: Node) -> Void {
  if n is Ident(_) | BindName(_) {
    if let some(s) = mo.bindings[n.lo] {
      let t = e.target-of(s)
      module-uses[t] = (module-uses[t] ?? 0) + 1
    }
  }
  if n is JsxElement(Ident(_), ...) {
    if let some(s) = mo.bindings[n.tag.lo] { module-tags += e.target-of(s) }
  }
  for k in n.kids { count-uses(mo, k) }
}

fn unit-usage(i: Int) -> Usage {
  let u = e.units[i]
  let id = u.module
  module-uses = {}
  module-tags = []
  var bytes: [Int] = []
  var toplevel: [Int] = []
  if e.included?(id) {
    let mo = m.modules[id]
    if u.from == 0 { bytes = byte-counts(mo.text) }
    let ps = e.parts-of(id)
    for j in u.from..u.to {
      let p = ps[j]
      if e.live?(p) {
        count-uses(mo, an.part-stmt[p])
        for m.db.declares(p, ?s) {
          if not e.import-symbol?(s) { toplevel += s }
        }
      }
    }
  }
  Usage(uses: module-uses, tags: module-tags, freq: bytes, toplevel: toplevel)
}

# How many threads count.
state count-threads: Int = 1

fn take-slot(s: Int, at: Int) -> Void {
  while len(counts) <= at { counts += 0 }
  slot[s] = at
  counts[at] = counts[at] + uses[s]
  if tags[s] { capital[at] = true }
}

# Nested symbols: siblings restart from where their parent's symbols stopped.
fn nested-slots(scope: Int, from: Int) -> Void {
  let now = sym.scope-at(m.table, scope)
  var next = from
  if not now.dynamic {
    for s in now.symbols {
      take-slot(s, next)
      next += 1
    }
  }
  for child in now.children { nested-slots(child, next) }
}

# Name characters, commonest first, so frequent symbols compress well.
fn sorted-chars(candidates: Text) -> [Int] {
  let chars = [c for c in candidates]
  sort c in chars by freq[c] desc
}

fn minified-name(head: [Int], tail: [Int], index: Int) -> Text {
  var b = buf-new()
  var i = index
  buf-byte!(b, head[i % len(head)])
  i = i / len(head)
  while i > 0 {
    i = i - 1
    buf-byte!(b, tail[i % len(tail)])
    i = i / len(tail)
  }
  buf-text(b)
}

fn assign-minified() -> Void {
  let symbols = sym.symbol-count(m.table)
  counts = []
  slot = [-1 for i in 0..symbols]
  uses = [0 for i in 0..symbols]
  freq = [0 for i in 0..256]
  tags = [false for i in 0..symbols]
  capital = {}
  e.used = {}
  e.stack = []
  var toplevel: [Int] = []
  for w in e.keywords { e.reserve(w) }
  for id in m.order {
    if id == 0 or e.included?(id) {
      for f in m.modules[id].free { e.reserve(f) }
    }
  }
  # Live code: uses, character frequency, and the top-level symbols in order.
  e.units = e.units-of-order()
  for u in parallel-map([i for i in 0..len(e.units)], unit-usage, count-threads) {
    for s in keys(u.uses) { uses[s] = uses[s] + (u.uses[s] ?? 0) }
    for s in u.tags { tags[s] = true }
    if len(u.freq) > 0 {
      for c in 0..256 { freq[c] = freq[c] + u.freq[c] }
    }
    toplevel ++= u.toplevel
  }
  # Nested slots first, so top-level symbols never collide with them.
  for id in m.order {
    if e.included?(id) {
      let mo = m.modules[id]
      let root = sym.scope-at(m.table, mo.root)
      if mo.kind == Cjs {
        nested-slots(root.parent, 0)
      } else {
        for child in root.children { nested-slots(child, 0) }
      }
    }
  }
  var next = len(counts)
  for s in toplevel {
    take-slot(s, next)
    next += 1
  }
  let head = sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$")
  let tail = sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789")
  let capitals = sorted-chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
  # Slot numbers, by descending use; ties keep slot order.
  let all-slots = [i for i in 0..len(counts)]
  let order = sort i in all-slots by counts[i] desc
  var names = ["" for i in 0..len(counts)]
  var index = 0
  var capital-index = 0
  var given: {Text:Bool} = {}
  for at in order {
    if at in capital {
      # A lower-case name would turn a kept `<Foo/>` into an element called `a`.
      var candidate = minified-name(capitals, tail, capital-index)
      while e.taken?(candidate) or candidate in given {
        capital-index += 1
        candidate = minified-name(capitals, tail, capital-index)
      }
      capital-index += 1
      given[candidate] = true
      names[at] = candidate
    } else {
      var candidate = minified-name(head, tail, index)
      while e.taken?(candidate) or candidate in given {
        index += 1
        candidate = minified-name(head, tail, index)
      }
      index += 1
      given[candidate] = true
      names[at] = candidate
    }
  }
  # Names for every slotted symbol; a dynamic scope's symbols keep theirs.
  for s in 0..sym.symbol-count(m.table) {
    if slot[s] >= 0 { sym.set-final!(m.table, s, names[slot[s]]) }
  }
}
