;;; Node-style module resolution. Hand-written Coil: it is a filesystem algorithm,
;;; and its knobs (main fields, conditions, extensions) come from the options.
(module bundle.resolve)
(import "coil.alloc" :use [malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.slice" :use [subslice])
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "bundle.package" :as pkg)
(import "hl.rt" :as rt)

;;; Everything the filesystem answered, so each question is asked once.
(defstruct Cache
  [(files (HashMap (slice u8) bool))
   (docs (HashMap (slice u8) pkg/Node))
   (resolved (HashMap (slice u8) (slice u8)))
   (effects (HashMap (slice u8) bool))
   (type-module (HashMap (slice u8) bool))])

(defstruct Options
  [(main-fields (ArrayList (slice u8)))
   (conditions (ArrayList (slice u8)))
   (extensions (ArrayList (slice u8)))
   (cache (ptr Cache))])

(defn cache-new [] (-> (ptr Cache))
  (box! (malloc-allocator) Cache
        (Cache :files (HashMap::new [(slice u8) bool] (malloc-allocator) (str/keyops))
               :docs (HashMap::new [(slice u8) pkg/Node] (malloc-allocator) (str/keyops))
               :resolved (HashMap::new [(slice u8) (slice u8)] (malloc-allocator) (str/keyops))
               :effects (HashMap::new [(slice u8) bool] (malloc-allocator) (str/keyops))
               :type-module (HashMap::new [(slice u8) bool] (malloc-allocator) (str/keyops)))))

(defstruct Resolved [(path (slice u8)) (side-effects bool)])

;;; Does this name a readable file? Most probes are misses, which `exists?` answers
;;; without opening anything; a directory exists but cannot be read.
(defn file? [(path (slice u8)) (o Options)] (-> bool)
  (match (get (.files (.cache o)) path)
    (Some [known] known)
    (None []
      (let [there (match (fs/exists? (malloc-allocator) path)
                    (Ok [e] (and e (match (fs/read-file (malloc-allocator) path)
                                     (Ok [_] true)
                                     (Err [_] false))))
                    (Err [_] false))]
        (set! (mut (.files (.cache o))) path there)
        there))))

(defn doc-of [(pj (slice u8)) (o Options)] (-> pkg/Node)
  (match (get (.docs (.cache o)) pj)
    (Some [d] d)
    (None []
      (let [d (pkg/parse (rt/read-all pj) pj)]
        (set! (mut (.docs (.cache o))) pj d)
        d))))

;;; Remove `.` and `..` segments.
(defn normalize [(path (slice u8))] (-> (slice u8))
  (let [(mut parts) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut start) 0
        absolute (and (> (len path) 0) (= (get path 0) #\/))]
    (for i (range 0 (+ (len path) 1))
      (when (or (= i (len path)) (= (get path i) #\/))
        (let [seg (subslice path start i)]
          (cond
            (or (= (len seg) 0) (= seg ".")) 0
            (and (= seg "..") (> (len parts) 0) (!= (get parts (- (len parts) 1)) ".."))
              (do (pop! (mut parts)) 0)
            :else (do (push! (mut parts) seg) 0)))
        (set! start (+ i 1))))
    (let [(mut b) (str/StrBuf::new (malloc-allocator))]
      (when absolute (push-str! (mut b) "/"))
      (for i (range 0 (len parts))
        (when (> i 0) (push-str! (mut b) "/"))
        (push-str! (mut b) (get parts i)))
      (finish! (mut b)))))

(defn strip-quotes [(s (slice u8))] (-> (slice u8)) (subslice s 1 (- (len s) 1)))

(defn member [(object pkg/Node) (key (slice u8))] (-> (Option pkg/Node))
  (let [(mut out) (None [pkg/Node])]
    (when (= (.kind object) (pkg/KObject))
      (for m (.kids (get (.kids object) 0))
        (when (= (strip-quotes (.text (get (.kids m) 0))) key)
          (set! out (Some (get (.kids m) 1))))))
    out))

;;; A package `exports` value: a path, or conditions tried in the file's order.
(defn exports-target [(v pkg/Node) (o Options)] (-> (Option (slice u8)))
  (match (.kind v)
    (pkg/KStr [] (Some (strip-quotes (.text v))))
    (pkg/KObject []
      (let [(mut out) (None [(slice u8)])]
        (for m (.kids (get (.kids v) 0))
          (match out
            (Some [_] 0)
            (None []
              (let [key (strip-quotes (.text (get (.kids m) 0)))
                    (mut wanted) (= key "default")]
                (for c (.conditions o) (when (= c key) (set! wanted true)))
                (when wanted
                  (set! out (exports-target (get (.kids m) 1) o)))))))
        out))
    (_ (None [(slice u8)]))))

(defn package-exports [(doc pkg/Node) (subpath (slice u8)) (o Options)] (-> (Option (slice u8)))
  (match (member doc "exports")
    (None [] (None [(slice u8)]))
    (Some [e]
      (if (= (.kind e) (pkg/KObject))
          (let [first (get (.kids (get (.kids e) 0)) 0)
                dotted (= (get (strip-quotes (.text (get (.kids first) 0))) 0) #\.)]
            (if dotted
                (match (member e subpath)
                  (Some [v] (exports-target v o))
                  (None [] (None [(slice u8)])))
                (if (= subpath ".") (exports-target e o) (None [(slice u8)]))))
          (if (= subpath ".") (exports-target e o) (None [(slice u8)]))))))

(defn try-file [(base (slice u8)) (o Options)] (-> (Option (slice u8)))
  (block :found
    (when (file? base o) (return-from :found (Some base)))
    (for ext (.extensions o)
      (let [p (rt/join base ext)]
        (when (file? p o) (return-from :found (Some p)))))
    (None [(slice u8)])))

;;; A directory: its package.json entry, then its index.
(defn try-dir [(dir (slice u8)) (o Options)] (-> (Option (slice u8)))
  (block :found
    (let [pj (rt/join dir "/package.json")]
      (when (file? pj o)
        (let [doc (doc-of pj o)]
          (for field (.main-fields o)
            (match (member doc field)
              (Some [v]
                (when (= (.kind v) (pkg/KStr))
                  (match (try-path (normalize (rt/join (rt/join dir "/") (strip-quotes (.text v)))) o)
                    (Some [p] (return-from :found (Some p)))
                    (None [] 0))))
              (None [] 0))))))
    (try-file (rt/join dir "/index") o)))

(defn try-path [(base (slice u8)) (o Options)] (-> (Option (slice u8)))
  (match (try-file base o)
    (Some [p] (Some p))
    (None [] (try-dir base o))))

;;; The package.json governing a directory: the nearest one at or above it.
(defn package-json-for [(start (slice u8)) (o Options)] (-> (Option (slice u8)))
  (let [(mut dir) start (mut out) (None [(slice u8)]) (mut go) true]
    (while go
      (let [pj (if (= dir ".") "package.json" (rt/join dir "/package.json"))]
        (if (file? pj o)
            (do (set! out (Some pj)) (set! go false))
            (if (or (= dir ".") (= (len dir) 0) (= dir "/"))
                (set! go false)
                (set! dir (rt/dir-of dir))))))
    out))

;;; Is the package.json governing a file `"type": "module"`?
(defn package-type-module? [(path (slice u8)) (o Options)] (-> bool)
  (let [dir (rt/dir-of path)]
    (match (get (.type-module (.cache o)) dir)
      (Some [known] known)
      (None []
        (let [answer
                (match (package-json-for dir o)
                  (None [] false)
                  (Some [pj]
                    (match (member (doc-of pj o) "type")
                      (Some [v] (and (= (.kind v) (pkg/KStr)) (= (strip-quotes (.text v)) "module")))
                      (None [] false))))]
          (set! (mut (.type-module (.cache o))) dir answer)
          answer)))))

;;; `"sideEffects": false` in the package.json governing a file.
(defn side-effects-of [(path (slice u8)) (o Options)] (-> bool)
  (let [dir (rt/dir-of path)]
    (match (get (.effects (.cache o)) dir)
      (Some [known] known)
      (None []
        (let [answer
                (match (package-json-for dir o)
                  (None [] true)
                  (Some [pj]
                    (match (member (doc-of pj o) "sideEffects")
                      (Some [v] (!= (.kind v) (pkg/KFalse)))
                      (None [] true))))]
          (set! (mut (.effects (.cache o))) dir answer)
          answer)))))

(defn split-package [(spec (slice u8))] (-> i64)
  (let [(mut slashes) 0 (mut out) (len spec)
        need (if (= (get spec 0) #\@) 2 1)]
    (for i (range 0 (len spec))
      (when (and (= (get spec i) #\/) (= out (len spec)))
        (set! slashes (+ slashes 1))
        (when (= slashes need) (set! out i))))
    out))

(defn resolve-bare [(spec (slice u8)) (from-dir (slice u8)) (o Options)] (-> (Option (slice u8)))
  (block :found
    (let [cut (split-package spec)
          name (subslice spec 0 cut)
          sub (if (< cut (len spec))
                  (rt/join "." (subslice spec cut (len spec)))
                  ".")
          (mut dir) from-dir
          (mut go) true]
      (while go
        (let [pdir (if (= dir ".")
                       (rt/join "node_modules/" name)
                       (rt/join (rt/join dir "/node_modules/") name))
              pj (rt/join pdir "/package.json")]
          (when (file? pj o)
            (let [doc (doc-of pj o)]
              (match (package-exports doc sub o)
                (Some [target]
                  (return-from :found (Some (normalize (rt/join (rt/join pdir "/") target)))))
                (None []
                  (if (= sub ".")
                      (match (try-dir pdir o)
                        (Some [p] (return-from :found (Some p)))
                        (None [] 0))
                      (match (try-path (normalize (rt/join (rt/join pdir "/") sub)) o)
                        (Some [p] (return-from :found (Some p)))
                        (None [] 0))))))))
        (if (or (= dir ".") (= (len dir) 0) (= dir "/"))
            (set! go false)
            (set! dir (rt/dir-of dir))))
      (None [(slice u8)]))))

(defn resolve [(spec (slice u8)) (importer (slice u8)) (o Options)] (-> Resolved)
  (let [from-dir (rt/dir-of importer)
        key (rt/join (rt/join from-dir "\n") spec)]
    (match (get (.resolved (.cache o)) key)
      (Some [p] (Resolved :path p :side-effects (side-effects-of p o)))
      (None []
        (let [r (resolve-uncached spec importer from-dir o)]
          (set! (mut (.resolved (.cache o))) key (.path r))
          r)))))

(defn resolve-uncached [(spec (slice u8)) (importer (slice u8)) (from-dir (slice u8)) (o Options)] (-> Resolved)
  (let [target
          (if (or (rt/at? spec 0 "./") (rt/at? spec 0 "../") (= spec ".") (= spec "..")
                  (rt/at? spec 0 "/"))
              (try-path (normalize (if (rt/at? spec 0 "/")
                                       spec
                                       (rt/join (rt/join from-dir "/") spec)))
                        o)
              (resolve-bare spec from-dir o))]
    (match target
      (Some [p] (Resolved :path p :side-effects (side-effects-of p o)))
      (None [] (panic "{}: could not resolve {}" importer spec)))))
