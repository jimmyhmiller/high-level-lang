# CSS, as a bundler needs it: rules, at-rules, declarations, and every token in between. Space means
# something in CSS (`.a .b` is not `.a.b`), so it is a token here, not something skipped, and a
# comment counts as space.
syntax
start Sheet
space Nothing
word NamePart
printwords "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\\" high ;
breaks ";" "{" "}" ;

fragment Nothing = (!. .)* ;
fragment Comment = "/*" (!"*/" .)* "*/" ;
fragment Hex = [0-9a-fA-F] ;
fragment Escape = "\\" (Hex Hex? Hex? Hex? Hex? Hex? [ \t\n]? | [^\n0-9a-fA-F]) ;
fragment NameStart = [a-zA-Z_] | [\x80-\xff] | Escape ;
fragment NamePart = [a-zA-Z0-9_\-] | [\x80-\xff] | Escape ;
fragment IdentBody = "--" NamePart* | "-"? NameStart NamePart* ;
fragment Number = [+\-]? ([0-9]* "." [0-9]+ | [0-9]+) ([eE] [+\-]? [0-9]+)? ;
fragment UrlByte = [^"'() \t\n\r\\] | Escape ;

raw token Ws = ([ \t\n\r\x0c] | Comment)+ ;
token CustomName = "--" NamePart* ;
# `U+0025-00FF` is one token, or it would print as two.
token UnicodeRange = [uU] "+" [0-9a-fA-F?]+ ("-" [0-9a-fA-F]+)? ;
token Url = [uU] [rR] [lL] "(" [ \t\n\r]* UrlByte* [ \t\n\r]* ")" ;
token FuncName = IdentBody "(" ;
token AtName = "@" IdentBody ;
token Hash = "#" NamePart+ ;
token Str = "\"" ("\\" . | [^"\\\n])* "\"" | "'" ("\\" . | [^'\\\n])* "'" ;
token Dimension = Number IdentBody ;
token Percentage = Number "%" ;
token Num = Number ;
token Ident = IdentBody ;
token Delim = [^ \t\n\r\x0c{}()\[\];,:"'] ;

rule Sheet = SheetItem* -> Sheet(items) ;
rule SheetItem
  = Ws
  | AtRule
  | "<!--" -> Cdo
  | "-->" -> Cdc
  | QualifiedRule
  ;

rule AtRule = AtName Comp* AtEnd -> AtRule ;
rule AtEnd = Block | ";" -> AtSemi | @eof -> AtEof ;

rule QualifiedRule = Comp+ Block -> Rule ;
rule Block = "{" BlockItem* "}" -> Block ;
rule BlockItem
  = Ws
  | ";" -> Semi
  | AtRule
  | Declaration
  | QualifiedRule
  ;

# A declaration ends where its block or its `;` does. A name with a `{` after it starts a nested rule
# instead, unless the name is a custom property, whose value may hold blocks.
rule Declaration
  = CustomName Ws? ":" CustomPart* &(";" | "}") -> CustomDecl
  | Ident Ws? ":" Comp* &(";" | "}") -> Decl
  ;
rule CustomPart = Comp | "{" CustomPart* "}" -> Braces ;

rule Comp
  = Ws
  | Url
  | UnicodeRange
  | FuncName Comp* ")" -> Func(name, args)
  | "(" Comp* ")" -> Parens
  | "[" Comp* "]" -> Brackets
  | Str
  | Dimension
  | Percentage
  | Num
  | Hash
  | AtName
  | CustomName
  | Ident
  | "," -> Comma
  | ":" -> Colon
  | Delim
  ;
