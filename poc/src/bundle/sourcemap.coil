;;; Source map v3 from the printer's marks: where each leaf token landed in the output,
;;; and which module and byte it came from. A mark's source is (module+1)<<32 | offset.
(module bundle.sourcemap)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.str" :as str)
(import "bundle.graph" :as g)
(import "hl.rt" :as rt)

(const BASE64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defn vlq! [(b (mut str/StrBuf)) (value i64)] (-> void)
  (let [(mut v) (if (< value 0) (+ (* (- 0 value) 2) 1) (* value 2))
        (mut go) true]
    (while go
      (let [digit (% v 32)]
        (set! v (/ v 32))
        (push! (mut (.bytes b))
               (get BASE64 (if (> v 0) (+ digit 32) digit)))
        (when (= v 0) (set! go false))))))

;;; JSON text, quoted.
(defn json-string! [(b (mut str/StrBuf)) (s (slice u8))] (-> void)
  (push-str! (mut b) "\"")
  (for c s
    (cond
      (= c #\") (push-str! (mut b) "\\\"")
      (= c #\\) (push-str! (mut b) "\\\\")
      (= c #\newline) (push-str! (mut b) "\\n")
      (= c #\return) (push-str! (mut b) "\\r")
      (= c #\tab) (push-str! (mut b) "\\t")
      (< c (: 32 u8))
        (do (push-str! (mut b) "\\u00")
            (push! (mut (.bytes b)) (get "0123456789abcdef" (/ (cast i64 c) 16)))
            (push! (mut (.bytes b)) (get "0123456789abcdef" (% (cast i64 c) 16))))
      :else (push! (mut (.bytes b)) c)))
  (push-str! (mut b) "\""))

;;; UTF-16 code units a UTF-8 lead byte stands for, 0 for a continuation byte.
(defn utf16-width [(c u8)] (-> i64)
  (cond
    (< c (: 128 u8)) 1
    (< c (: 192 u8)) 0
    (< c (: 240 u8)) 1
    :else 2))

;;; Line starts of a source, for offset -> line lookups.
(defn line-starts [(src (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (malloc-allocator))]
    (push! (mut out) 0)
    (for i (range 0 (len src))
      (when (= (get src i) #\newline) (push! (mut out) (+ i 1))))
    out))

(defn line-of [(starts (ArrayList i64)) (offset i64)] (-> i64)
  (let [(mut lo) 0 (mut hi) (- (len starts) 1)]
    (while (< lo hi)
      (let [mid (/ (+ lo hi 1) 2)]
        (if (<= (get starts mid) offset) (set! lo mid) (set! hi (- mid 1)))))
    lo))

(defn column-in [(src (slice u8)) (from i64) (to i64)] (-> i64)
  (let [(mut col) 0]
    (for i (range from to) (set! col (+ col (utf16-width (get src i)))))
    col))

;;; `../` for each directory of the output file, so paths resolve from the map.
(defn up-from [(outfile (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (for c outfile (when (= c #\/) (push-str! (mut b) "../")))
    (finish! (mut b))))

;;; The map as JSON. `marks` are in output order, and `base` is where the printed body
;;; starts in `text`.
(defn build [(gr (mut g/Graph)) (text (slice u8)) (base i64) (marks (ArrayList rt/Mark)) (outfile (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))
        (mut map) (str/StrBuf::new (malloc-allocator))
        (mut used) (ArrayList::new [i64] (malloc-allocator))
        (mut index-of) (ArrayList::new [i64] (malloc-allocator))
        (mut starts) (ArrayList::new [(ArrayList i64)] (malloc-allocator))
        (mut pos) 0
        (mut gen-col) 0
        (mut prev-gen-col) 0
        (mut prev-src) 0
        (mut prev-line) 0
        (mut prev-col) 0
        (mut first) true]
    (for _ (range 0 (len (.modules gr))) (push! (mut index-of) -1))
    (for m marks
      (let [at (+ base (.out m))
            module (- (/ (.src m) 4294967296) 1)
            offset (% (.src m) 4294967296)]
        (when (>= module 0)
          (when (= (get index-of module) -1)
            (set! (mut index-of) module (len used))
            (push! (mut used) module)
            (push! (mut starts) (line-starts (.text-for-freq (g/module-at (mut gr) module)))))
          ;; Advance the generated position to this mark.
          (while (< pos at)
            (let [c (get text pos)]
              (if (= c #\newline)
                  (do
                    (push-str! (mut map) ";")
                    (set! gen-col 0)
                    (set! prev-gen-col 0)
                    (set! first true))
                  (set! gen-col (+ gen-col (utf16-width c))))
              (set! pos (+ pos 1))))
          (let [source-index (get index-of module)
                src (.text-for-freq (g/module-at (mut gr) module))
                table (get starts source-index)
                line (line-of table offset)
                col (column-in src (get table line) offset)]
            (unless first (push-str! (mut map) ","))
            (set! first false)
            (vlq! (mut map) (- gen-col prev-gen-col))
            (vlq! (mut map) (- source-index prev-src))
            (vlq! (mut map) (- line prev-line))
            (vlq! (mut map) (- col prev-col))
            (set! prev-gen-col gen-col)
            (set! prev-src source-index)
            (set! prev-line line)
            (set! prev-col col)))))
    (push-str! (mut b) "{\"version\":3,\"sources\":[")
    (let [up (up-from outfile)]
      (for i (range 0 (len used))
        (when (> i 0) (push-str! (mut b) ","))
        (json-string! (mut b) (rt/join up (.path (g/module-at (mut gr) (get used i)))))))
    (push-str! (mut b) "],\"sourcesContent\":[")
    (for i (range 0 (len used))
      (when (> i 0) (push-str! (mut b) ","))
      (json-string! (mut b) (.text-for-freq (g/module-at (mut gr) (get used i)))))
    (push-str! (mut b) "],\"mappings\":")
    (json-string! (mut b) (finish! (mut map)))
    (push-str! (mut b) ",\"names\":[]}\n")
    (finish! (mut b))))
