# Node-style module resolution: a search over the filesystem, whose knobs come from the build.
rules bundle.resolve
use bundle.package as pkg

record Options {
  main-fields: [Text],
  conditions: [Text],
  extensions: [Text],
  external: [Text],
  node-builtins: Bool
}

record Resolved { path: Text, side-effects: Bool }

# Answers derived from the filesystem's, so each is worked out once per worker: they are caches,
# and a new build's generation empties them. What the filesystem itself says is a memo, below,
# asked once for all workers.
task state files: {Text:Bool} = {}
task state resolved: {Text:Text} = {}
task state effects: {Text:[Text]} = {}
task state type-module: {Text:Bool} = {}
task state seen-generation: Int = -1
state generation: Int = 0

fn fresh-caches!() -> Void {
  if seen-generation != generation {
    files = {}
    resolved = {}
    effects = {}
    type-module = {}
    seen-generation = generation
  }
}

# A new build: every worker's caches start over the next time it asks, and the memos now. The
# number comes from a counter no reset of this module's state can rewind.
fn new-generation!() -> Void {
  generation = next-pass!()
  forget-memos!()
}

# What a directory holds, by name: 'f' a file, 'd' a directory, 'l' a link. Read once, as esbuild does,
# so each candidate a resolution tries costs a lookup and not a system call.
memo fn listing-of(dir: Text) -> {Text:Int} {
  let text = dir-listing(dir)
  var out: {Text:Int} = {}
  var start = 0
  for i in 0..len(text) {
    if text[i] == '\n' {
      out[text[start + 1..i]] = text[start]
      start = i + 1
    }
  }
  out
}

fn file?(path: Text) -> Bool {
  fresh-caches!()
  if let some(known) = files[path] { return known }
  let kind = listing-of(dir-of(path))[base-of(path)] ?? 0
  # A link is the one case the listing cannot answer.
  let there = if kind == 'l' then readable-file?(path) else kind == 'f'
  files[path] = there
  there
}

fn base-of(path: Text) -> Text {
  var cut = -1
  for i in 0..len(path) {
    if path[i] == '/' { cut = i }
  }
  path[cut + 1..len(path)]
}

memo fn doc-of(path: Text) -> pkg.Node = pkg.parse(read-file(path), path)

# Remove `.` and `..` segments.
fn normalize(path: Text) -> Text {
  var parts: [Text] = []
  var start = 0
  for i in 0..len(path) + 1 {
    if i == len(path) or path[i] == '/' {
      let seg = path[start..i]
      if len(seg) == 0 or seg == "." {
      } else if seg == ".." and len(parts) > 0 and last(parts) != ".." {
        pop(parts)
      } else {
        parts += seg
      }
      start = i + 1
    }
  }
  var b = buf-new()
  if len(path) > 0 and path[0] == '/' { buf-add!(b, "/") }
  for i in 0..len(parts) {
    if i > 0 { buf-add!(b, "/") }
    buf-add!(b, parts[i])
  }
  buf-text(b)
}

fn member(object: pkg.Node, key: Text) -> pkg.Node? {
  var out: pkg.Node? = none
  match object {
    pkg.Object(List(ms...)) => {
      for m in ms {
        if unquote(m.key.text) == key { out = some(m.value) }
      }
    }
    _ => {}
  }
  out
}

fn text-member(object: pkg.Node, key: Text) -> Text? = match member(object, key) {
  some(pkg.Str(raw)) => some(unquote(raw))
  _ => none
}

# A package `exports` value: a path, or conditions tried in the file's order.
fn exports-target(v: pkg.Node, o: Options) -> Text? = match v {
  pkg.Str(raw) => some(unquote(raw))
  pkg.Object(List(ms...)) => first m in ms: condition-target(m, o)
  _ => none
}

fn condition-target(m: pkg.Node, o: Options) -> Text? {
  let key = unquote(m.key.text)
  if key == "default" or key in o.conditions then exports-target(m.value, o) else none
}

fn package-exports(doc: pkg.Node, subpath: Text, o: Options) -> Text? = match member(doc, "exports") {
  none => none
  some(e) => match e {
    pkg.Object(List(first-member, ...)) =>
      if unquote(first-member.key.text)[0] == '.' {
        match member(e, subpath) {
          some(v) => exports-target(v, o)
          none => none
        }
      } else if subpath == "." then exports-target(e, o) else none
    _ => if subpath == "." then exports-target(e, o) else none
  }
}

fn try-file(base: Text, o: Options) -> Text? {
  if file?(base) { return some(base) }
  let found = first ext in o.extensions: if file?(base ++ ext) then some(base ++ ext) else none
  found ?? typescript-instead(base)
}

# TypeScript writes `./x.js` and means `./x.ts`: what it will be called once compiled.
fn typescript-instead(base: Text) -> Text? {
  if ends-with(base, ".js") { return same-stem(base, 3, [".ts", ".tsx"]) }
  if ends-with(base, ".jsx") { return same-stem(base, 4, [".ts", ".tsx"]) }
  if ends-with(base, ".mjs") { return same-stem(base, 4, [".mts"]) }
  if ends-with(base, ".cjs") { return same-stem(base, 4, [".cts"]) }
  none
}

fn same-stem(base: Text, cut: Int, exts: [Text]) -> Text? {
  let stem = base[0..len(base) - cut]
  first ext in exts: if file?(stem ++ ext) then some(stem ++ ext) else none
}

# A directory: its package.json entry, then its index.
fn try-dir(dir: Text, o: Options) -> Text? {
  let pj = dir ++ "/package.json"
  let from-main: Text? =
    if file?(pj) {
      let doc = doc-of(pj)
      first field-name in o.main-fields: match text-member(doc, field-name) {
        some(target) => try-path(normalize(dir ++ "/" ++ target), o)
        none => none
      }
    } else { none }
  from-main ?? try-file(dir ++ "/index", o)
}

fn try-path(base: Text, o: Options) -> Text? = try-file(base, o) ?? try-dir(base, o)

fn top-of-tree?(dir: Text) -> Bool = dir == "." or len(dir) == 0 or dir == "/"

# The package.json governing a directory: the nearest one at or above it.
fn package-json-for(start: Text) -> Text? {
  var dir = start
  while true {
    let pj = if dir == "." then "package.json" else dir ++ "/package.json"
    if file?(pj) { return some(pj) }
    if top-of-tree?(dir) { return none }
    dir = dir-of(dir)
  }
  none
}

# Is the package.json governing a file `"type": "module"`?
fn package-type-module?(path: Text) -> Bool {
  fresh-caches!()
  let dir = dir-of(path)
  if let some(known) = type-module[dir] { return known }
  let answer = match package-json-for(dir) {
    none => false
    some(pj) => match text-member(doc-of(pj), "type") {
      some(t) => t == "module"
      none => false
    }
  }
  type-module[dir] = answer
  answer
}

# `"sideEffects"` in the package.json governing a file: `false`, or the files that have them. No
# list at all is every file, written as the empty pattern.
fn effect-patterns(dir: Text) -> [Text] {
  fresh-caches!()
  if let some(known) = effects[dir] { return known }
  let answer: [Text] = match package-json-for(dir) {
    none => [""]
    some(pj) => match member(doc-of(pj), "sideEffects") {
      some(pkg.False()) => []
      some(pkg.Array(List(items...))) => {
        let root = dir-of(pj)
        var out: [Text] = []
        for item in items {
          if item is pkg.Str(_) {
            # A pattern with no slash may be anywhere in the package.
            let pattern = unquote(item.text)
            let anywhere = all c in pattern: c != '/'
            out += normalize(root ++ (if anywhere then "/**/" else "/") ++ pattern)
          }
        }
        out
      }
      _ => [""]
    }
  }
  effects[dir] = answer
  answer
}

fn side-effects-of(path: Text) -> Bool =
  any p in effect-patterns(dir-of(path)): len(p) == 0 or glob-match?(p, 0, path, 0)

# `*` is within one path segment, `?` is one byte, and `**` as a whole segment is any number of them.
fn glob-match?(p: Text, i: Int, s: Text, j: Int) -> Bool {
  if i == len(p) { return j == len(s) }
  match p[i] {
    '?' => return j < len(s) and glob-match?(p, i + 1, s, j + 1)
    '*' => {
      var after = i
      while after < len(p) and p[after] == '*' { after += 1 }
      let whole-segment = after - i > 1 and (i == 0 or p[i - 1] == '/')
                          and (after == len(p) or p[after] == '/')
      if whole-segment {
        let rest = if after < len(p) then after + 1 else after
        var k = j
        while true {
          if glob-match?(p, rest, s, k) { return true }
          while k < len(s) and s[k] != '/' { k += 1 }
          if k >= len(s) { return false }
          k += 1
        }
      }
      var k = j
      while true {
        if glob-match?(p, after, s, k) { return true }
        if k >= len(s) or s[k] == '/' { return false }
        k += 1
      }
    }
    c => return j < len(s) and s[j] == c and glob-match?(p, i + 1, s, j + 1)
  }
  false
}

# Where a package's name ends: `@scope/name` has two parts.
fn split-package(spec: Text) -> Int {
  let need = if spec[0] == '@' then 2 else 1
  var slashes = 0
  var out = len(spec)
  for i in 0..len(spec) {
    if spec[i] == '/' and out == len(spec) {
      slashes += 1
      if slashes == need { out = i }
    }
  }
  out
}

fn resolve-bare(spec: Text, from-dir: Text, o: Options) -> Text? {
  let cut = split-package(spec)
  let name = spec[0..cut]
  let sub = if cut < len(spec) then "." ++ spec[cut..len(spec)] else "."
  var dir = from-dir
  while true {
    let pdir = if dir == "." then "node_modules/" ++ name else dir ++ "/node_modules/" ++ name
    let pj = pdir ++ "/package.json"
    if file?(pj) {
      match package-exports(doc-of(pj), sub, o) {
        some(target) => return some(normalize(pdir ++ "/" ++ target))
        none => {
          let found = if sub == "." then try-dir(pdir, o) else try-path(normalize(pdir ++ "/" ++ sub), o)
          if let some(p) = found { return some(p) }
        }
      }
    }
    if top-of-tree?(dir) { return none }
    dir = dir-of(dir)
  }
  none
}

const node-builtin-names: [Text] = ["assert", "async_hooks", "buffer", "child_process", "cluster",
  "console", "constants", "crypto", "dgram", "diagnostics_channel", "dns", "domain", "events", "fs",
  "fs/promises", "http", "http2", "https", "inspector", "module", "net", "os", "path", "perf_hooks",
  "process", "punycode", "querystring", "readline", "repl", "stream", "stream/promises",
  "string_decoder", "timers", "tls", "tty", "url", "util", "v8", "vm", "wasi", "worker_threads", "zlib"]

fn node-builtin?(spec: Text) -> Bool = starts-with(spec, "node:") or spec in node-builtin-names

# Is this import left for the runtime to resolve?
fn external?(spec: Text, o: Options) -> Bool =
  (o.node-builtins and node-builtin?(spec)) or spec in o.external

fn relative?(spec: Text) -> Bool =
  starts-with(spec, "./") or starts-with(spec, "../") or spec == "." or spec == ".." or starts-with(spec, "/")

fn target-of(spec: Text, from-dir: Text, o: Options) -> Text? =
  if relative?(spec) then try-path(normalize(if starts-with(spec, "/") then spec else from-dir ++ "/" ++ spec), o)
  else resolve-bare(spec, from-dir, o)

fn resolve-uncached(spec: Text, importer: Text, from-dir: Text, o: Options) -> Text =
  target-of(spec, from-dir, o) ?? panic "{}: could not resolve {}", importer, spec

# The same, or nothing: for looking ahead at imports that may never be needed.
fn resolve-opt(spec: Text, importer: Text, o: Options) -> Resolved? {
  fresh-caches!()
  let from-dir = dir-of(importer)
  let key = from-dir ++ "\n" ++ spec
  let found: Text? = match resolved[key] {
    some(p) => some(p)
    none => target-of(spec, from-dir, o)
  }
  match found {
    some(p) => {
      resolved[key] = p
      some(Resolved(path: p, side-effects: side-effects-of(p)))
    }
    none => none
  }
}

fn resolve(spec: Text, importer: Text, o: Options) -> Resolved {
  fresh-caches!()
  let from-dir = dir-of(importer)
  let key = from-dir ++ "\n" ++ spec
  let path = match resolved[key] {
    some(p) => p
    none => {
      let p = resolve-uncached(spec, importer, from-dir, o)
      resolved[key] = p
      p
    }
  }
  Resolved(path: path, side-effects: side-effects-of(path))
}
