# What is inside a JavaScript string or template: runs of text, and escapes. Anything that cares
# about escapes matches on these instead of walking bytes.
syntax
start Content
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
fragment Hex = [0-9a-fA-F] ;
token Plain = [^\\]+ ;
token EscHex = "\\x" Hex Hex ;
token EscUni = "\\u" Hex Hex Hex Hex ;
token EscBrace = "\\u{" Hex+ "}" ;
token EscOctal = "\\" ([1-9] | "0" [0-9]) ;
token EscOther = "\\" . ;
token Lone = "\\" ;

rule Content = Piece* -> Content ;
rule Piece = Plain | EscHex | EscUni | EscBrace | EscOctal | EscOther | Lone ;
