;;; From a solved graph to one program: name every symbol, rewrite identifiers to their
;;; final names, wrap CommonJS modules and pick the live statements.
(module bundle.emit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as str)
(import "bundle.js" :as js)
(import "bundle.scopes" :as sc)
(import "bundle.link" :as facts)
(import "bundle.graph" :as g)
(import "hl.symtab" :as sym)
(import "hl.rt" :as rt)

;;; Name-collision state: every name taken at the bundle's top level or reserved, plus
;;; a stack of names taken in the nested scopes around the current one.
(defstruct Namer
  [(used (HashMap (slice u8) i64))
   (stack (ArrayList (HashMap (slice u8) i64)))])

(defn new-names [] (-> (HashMap (slice u8) i64))
  (HashMap::new [(slice u8) i64] (malloc-allocator) (str/keyops)))

(defn taken? [(n (mut Namer)) (name (slice u8))] (-> bool)
  (let [(mut hit) (match (get (.used n) name) (Some [_] true) (None [] false))]
    (for m (.stack n)
      (match (get m name) (Some [_] (set! hit true)) (None [] 0)))
    hit))

(defn reserve! [(n (mut Namer)) (name (slice u8))] (-> void)
  (set! (mut (.used n)) name 1))

;;; `name`, or `name2`, `name3`… as esbuild's number renamer does.
(defn unique-name [(n (mut Namer)) (name (slice u8))] (-> (slice u8))
  (if (taken? (mut n) name)
      (let [(mut tries) 2
            (mut candidate) (rt/join name "2")]
        (while (taken? (mut n) candidate)
          (set! tries (+ tries 1))
          (set! candidate (rt/join name (rt/num-text tries))))
        candidate)
      name))

(defn keywords [] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (for w ["arguments" "await" "break" "case" "catch" "class" "const" "continue" "debugger"
            "default" "delete" "do" "else" "enum" "eval" "export" "extends" "false" "finally"
            "for" "function" "if" "implements" "import" "in" "instanceof" "interface" "let"
            "new" "null" "package" "private" "protected" "public" "return" "static" "super"
            "switch" "this" "throw" "true" "try" "typeof" "var" "void" "while" "with" "yield"]
      (push! (mut out) w))
    out))

(defn set-final! [(gr (mut g/Graph)) (s i64) (name (slice u8))] (-> void)
  (let [(mut symbol) (get (.symbols (.table gr)) s)]
    (set! (.final symbol) name)
    (set! (mut (.symbols (.table gr))) s symbol)))

(defn import-symbol? [(gr (mut g/Graph)) (s i64)] (-> bool)
  (> (len (rt/rel-bucket (mut (.import-of (.db gr))) 0 s)) 0))

;;; What a symbol finally means: an import means whatever it resolves to.
(defn target-of [(gr (mut g/Graph)) (s i64)] (-> i64)
  (let [rows (rt/rel-bucket (mut (.import-of (.db gr))) 0 s)]
    (if (= (len rows) 0)
        s
        (let [row (get rows 0)
              d (rt/rel-at (mut (.import-of (.db gr))) row 1)
              n (rt/rel-at (mut (.import-of (.db gr))) row 2)
              (mut out) -1]
          (for r (rt/rel-bucket (mut (.resolved (.db gr))) 0 d)
            (when (= (rt/rel-at (mut (.resolved (.db gr))) r 1) n)
              (let [candidate (rt/rel-at (mut (.resolved (.db gr))) r 2)]
                (when (or (< out 0) (not (import-symbol? (mut gr) candidate)))
                  (set! out candidate)))))
          (when (< out 0)
            (panic "No matching export in {} for import {}"
                   (.path (g/module-at (mut gr) d)) (rt/name-of (mut (.names gr)) n)))
          out))))

(defn included? [(gr (mut g/Graph)) (m i64)] (-> bool)
  (facts/has-included? (mut (.db gr)) m))

(defn live? [(gr (mut g/Graph)) (p i64)] (-> bool)
  (facts/has-live? (mut (.db gr)) p))

(defn parts-of [(gr (mut g/Graph)) (m i64)] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (malloc-allocator))]
    (for row (rt/rel-bucket (mut (.part-of (.db gr))) 1 m)
      (push! (mut out) (rt/rel-at (mut (.part-of (.db gr))) row 0)))
    out))

;;; Nested names: a nested symbol must not shadow anything in scope above it. A scope
;;; code can reach by name at run time keeps its names.
(defn name-nested! [(gr (mut g/Graph)) (n (mut Namer)) (scope i64)] (-> void)
  (let [sc-now (get (.scopes (.table gr)) scope)
        (mut mine) (new-names)]
    (push! (mut (.stack n)) mine)
    (for s (.symbols sc-now)
      (let [name (.name (get (.symbols (.table gr)) s))
            chosen (if (.dynamic sc-now) name (unique-name (mut n) name))]
        (set-final! (mut gr) s chosen)
        (let [top (- (len (.stack n)) 1)]
          (set! (mut (elem (mut (.stack n)) top)) chosen 1))))
    (for child (.children sc-now) (name-nested! (mut gr) (mut n) child))
    (pop! (mut (.stack n)))
    0))

;;; Assign final names, in esbuild's order: reserved words and the free names of live
;;; modules first, then top-level symbols of live statements, then nested scopes.
(defn assign-names! [(gr (mut g/Graph))] (-> void)
  (let [(mut n) (Namer :used (new-names)
                       :stack (ArrayList::new [(HashMap (slice u8) i64)] (malloc-allocator)))]
    (for w (keywords) (reserve! (mut n) w))
    ;; Globals esbuild's full runtime refers to, which our smaller one need not.
    ;; Reserving them only keeps generated names the same as esbuild's.
    (for w ["Math" "Object" "Array" "Error" "Proxy" "TypeError" "Reflect" "require"] (reserve! (mut n) w))
    ;; The runtime is part of every bundle, even when no helper of it survives.
    (for id (.order gr)
      (when (or (= id 0) (included? (mut gr) id))
        (for f (.free (g/module-at (mut gr) id)) (reserve! (mut n) f))))
    (for id (.order gr)
      (when (included? (mut gr) id)
        (for p (parts-of (mut gr) id)
          (when (live? (mut gr) p)
            (reserve-cjs-imports! (mut gr) (mut n) (get (.part-stmt gr) p) (g/module-at (mut gr) id))
            (for row (rt/rel-bucket (mut (.declares (.db gr))) 0 p)
              (let [s (rt/rel-at (mut (.declares (.db gr))) row 1)]
                (unless (import-symbol? (mut gr) s)
                  (let [symbol (get (.symbols (.table gr)) s)
                        name (unique-name (mut n) (.name symbol))]
                    (reserve! (mut n) name)
                    (set-final! (mut gr) s name)))))))))
    (for id (.order gr)
      (when (included? (mut gr) id)
        (let [m (g/module-at (mut gr) id)
              root (get (.scopes (.table gr)) (.root m))]
          (if (= (.kind m) (g/Cjs))
              ;; The wrapper's own (exports, module) scope, then the file's.
              (name-nested! (mut gr) (mut n) (.parent root))
              (for child (.children root) (name-nested! (mut gr) (mut n) child))))))))

;;; An import from CommonJS is rewritten to a property read, but its own name stays
;;; taken at the top level, as in esbuild.
(defn reserve-cjs-imports! [(gr (mut g/Graph)) (n (mut Namer)) (s js/Node) (m g/Module)] (-> void)
  (if (= (.kind s) (js/KBindName))
      (match (get (.bindings m) (.lo s))
        (Some [sy]
          (match (get (.cjs-imports gr) sy)
            (Some [_] (reserve! (mut n) (unique-name (mut n) (.text s))))
            (None [] 0)))
        (None [] 0))
      (when (or (= (.kind s) (js/KImport))
                (= (.kind s) (js/KImportDefault)) (= (.kind s) (js/KImportDefaultAnd))
                (= (.kind s) (js/KImportNamespace)) (= (.kind s) (js/KImportNamed))
                (= (.kind s) (js/KImportAs)) (= (.kind s) (js/KImportName))
                (= (.kind s) (js/KList)))
        (for k (.kids s) (reserve-cjs-imports! (mut gr) (mut n) k m)))))

(defn final-of [(gr (mut g/Graph)) (s i64)] (-> (slice u8))
  (.final (get (.symbols (.table gr)) s)))

(defn ident [(name (slice u8))] (-> js/Node) (js/leaf (js/KIdent) name 0 0))

(defn member-read [(object js/Node) (name (slice u8))] (-> js/Node)
  (js/node2 (js/KMember) object (js/leaf (js/KPropName) name 0 0)))

(defn cjs-read [(gr (mut g/Graph)) (ci g/CjsImport)] (-> js/Node)
  (let [base (ident (final-of (mut gr) (.import-var ci)))]
    (if (.namespace ci) base (member-read base (.name ci)))))

(defn cjs-import-of [(gr (mut g/Graph)) (m g/Module) (leaf js/Node)] (-> (Option g/CjsImport))
  (match (get (.bindings m) (.lo leaf))
    (Some [s] (get (.cjs-imports gr) s))
    (None [] (None [g/CjsImport]))))

;;; Function-like kinds rebind `this`; arrows do not.
(defn rebinds-this? [(k js/Kind)] (-> bool)
  (and (sc/function? k)
       (not (or (= k (js/KArrow)) (= k (js/KAsyncArrow))))))

(defn void-zero [] (-> js/Node)
  (let [(mut kids) (js/new-kids)]
    (push! (mut kids) (js/leaf (js/KNum) "0" 0 0))
    (js/mk (js/KVoid) kids 0 0)))

;;; Rewrite identifiers to final names. `depth` counts `this`-rebinding functions.
(defn rw [(gr (mut g/Graph)) (m g/Module) (n js/Node) (depth i64)] (-> js/Node)
  (match (.kind n)
    (js/KIdent []
      (match (cjs-import-of (mut gr) m n)
        (Some [ci] (cjs-read (mut gr) ci))
        (None []
          (match (get (.bindings m) (.lo n))
            (Some [s] (js/leaf (js/KIdent) (final-of (mut gr) (target-of (mut gr) s)) (.lo n) (.hi n)))
            (None []
              ;; A free `undefined` is the shorter `void 0` under --minify-syntax.
              (if (and (.void-undefined gr) (= (.text n) "undefined"))
                  (void-zero)
                  n))))))
    (js/KBindName []
      (match (get (.bindings m) (.lo n))
        (Some [s] (js/leaf (js/KBindName) (final-of (mut gr) s) (.lo n) (.hi n)))
        (None [] n)))
    (js/KThis []
      (if (> depth 0)
          n
          (if (= (.kind m) (g/Cjs)) (ident (final-of-exports (mut gr) m)) (void-zero))))
    (js/KShorthand []
      (let [old (get (.kids n) 0)
            new (rw (mut gr) m old depth)]
        (if (and (= (.kind new) (js/KIdent)) (= (.text new) (.text old)))
            n
            (js/node2 (js/KProp) (js/leaf (js/KPropName) (.text old) 0 0) new))))
    (js/KPatShort []
      (let [old (get (.kids n) 0)
            new (rw (mut gr) m old depth)
            init (rw (mut gr) m (get (.kids n) 1) depth)]
        (if (= (.text new) (.text old))
            (js/node2 (js/KPatShort) new init)
            (js/node2 (js/KPatProp)
                      (js/leaf (js/KPropName) (.text old) 0 0)
                      (js/node2 (js/KBindElement) new init)))))
    (js/KCallExpr [] (rw-call (mut gr) m n depth))
    (_
      (if (= (len (.kids n)) 0)
          n
          (let [(mut kids) (js/new-kids)
                inner (cond
                        (rebinds-this? (.kind n)) (+ depth 1)
                        (= (.kind n) (js/KClassBody)) (+ depth 1)
                        :else depth)]
            (for k (.kids n)
              ;; An empty statement in a statement list does nothing.
              (unless (and (= (.kind n) (js/KList)) (= (.kind k) (js/KEmpty)))
                (push! (mut kids) (rw (mut gr) m k inner))))
            (js/mk (.kind n) kids (.lo n) (.hi n)))))))

(defn final-of-exports [(gr (mut g/Graph)) (m g/Module)] (-> (slice u8))
  (let [wrapper (.parent (get (.scopes (.table gr)) (.root m)))]
    (match (get (.names (get (.scopes (.table gr)) wrapper)) "exports")
      (Some [s] (final-of (mut gr) s))
      (None [] (panic "{}: a CommonJS wrapper has no exports symbol" (.path m))))))

;;; `require("x")` becomes `require_x()`; a call of a CommonJS import keeps `this`
;;; undefined by reading the function first: `(0, import_x.f)(…)`.
(defn rw-call [(gr (mut g/Graph)) (m g/Module) (n js/Node) (depth i64)] (-> js/Node)
  (let [callee (get (.kids n) 0)
        args (get (.kids n) 1)
        arg-list (.kids (get (.kids args) 0))]
    (if (and (= (.kind callee) (js/KIdent))
             (= (.text callee) "require")
             (= (.kind m) (g/Cjs))
             (= (len arg-list) 1)
             (= (.kind (get arg-list 0)) (js/KStr))
             (match (get (.bindings m) (.lo callee)) (Some [_] false) (None [] true)))
        (let [t (g/module-at (mut gr) (g/dep-of (mut gr) m (g/strip-quotes (.text (get arg-list 0)))))
              (mut none) (js/new-kids)]
          (push! (mut none) (js/mk (js/KList) (js/new-kids) 0 0))
          (js/node2 (js/KCallExpr)
                    (ident (final-of (mut gr) (.require-sym t)))
                    (js/mk (js/KArgs) none 0 0)))
        (let [new-callee (rw (mut gr) m callee depth)
              new-args (rw (mut gr) m args depth)
              wrapped
                (match (if (= (.kind callee) (js/KIdent))
                           (cjs-import-of (mut gr) m callee)
                           (None [g/CjsImport]))
                  (Some [ci]
                    (if (.namespace ci)
                        new-callee
                        (let [(mut kids) (js/new-kids)]
                          (push! (mut kids)
                                 (js/node2 (js/KSeq) (js/leaf (js/KNum) "0" 0 0) new-callee))
                          (js/mk (js/KParen) kids 0 0))))
                  (None [] new-callee))]
          (js/node2 (js/KCallExpr) wrapped new-args)))))

;;; The body statements of a part, ready to print. None for a part with no code.
(defn part-output [(gr (mut g/Graph)) (m g/Module) (s js/Node)] (-> (Option js/Node))
  (match (.kind s)
    (js/KImportBare [] (None [js/Node]))
    (js/KExportAll [] (None [js/Node]))
    (js/KExportFrom [] (None [js/Node]))
    (js/KExportNamed [] (None [js/Node]))
    (js/KImport []
      (let [t (g/module-at (mut gr) (g/dep-of (mut gr) m (g/strip-quotes (.text (get (.kids s) 1)))))]
        (if (= (.kind t) (g/Cjs))
            (Some (import-cjs-stmt (mut gr) m t))
            (None [js/Node]))))
    (js/KExportVar []
      (let [(mut kids) (js/new-kids)]
        (push! (mut kids) (get (.kids s) 0))
        (Some (rw (mut gr) m (js/mk (js/KVarDecl) kids (.lo s) (.hi s)) 0))))
    (js/KExportLexical [] (Some (rw (mut gr) m (get (.kids s) 0) 0)))
    (js/KExportFunction [] (Some (rw (mut gr) m (get (.kids s) 0) 0)))
    (js/KExportClass [] (Some (rw (mut gr) m (get (.kids s) 0) 0)))
    (_ (Some (rw (mut gr) m s 0)))))

(defn first-stmt [(text (slice u8))] (-> js/Node)
  (get (.kids (get (.kids (js/parse text "<generated>")) 1)) 0))

;;; `var import_x = __toESM(require_x(), 1);` Files in node mode (.mjs, or a package
;;; with "type": "module") get the second argument, so `default` is module.exports.
(defn import-cjs-stmt [(gr (mut g/Graph)) (m g/Module) (t g/Module)] (-> js/Node)
  (let [v (g/import-var-of! (mut gr) m (.id t))
        to-esm (final-of (mut gr) (g/helper! (mut gr) "__toESM"))
        (mut b) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut b) "var ")
    (push-str! (mut b) (final-of (mut gr) v))
    (push-str! (mut b) "=")
    (push-str! (mut b) to-esm)
    (push-str! (mut b) "(")
    (push-str! (mut b) (final-of (mut gr) (.require-sym t)))
    (push-str! (mut b) (if (g/node-mode? (.path m)) "(),1);" "());"))
    (first-stmt (finish! (mut b)))))

(defn fill-body [(n js/Node) (body (ArrayList js/Node))] (-> js/Node)
  (if (= (.kind n) (js/KFuncBody))
      (let [(mut kids) (js/new-kids)]
        (push! (mut kids) (js/mk (js/KList) body 0 0))
        (js/mk (js/KFuncBody) kids 0 0))
      (if (= (len (.kids n)) 0)
          n
          (let [(mut kids) (js/new-kids)]
            (for k (.kids n) (push! (mut kids) (fill-body k body)))
            (js/mk (.kind n) kids (.lo n) (.hi n))))))

(defn wrapper-param [(gr (mut g/Graph)) (m g/Module) (name (slice u8))] (-> i64)
  (let [wrapper (.parent (get (.scopes (.table gr)) (.root m)))]
    (match (get (.names (get (.scopes (.table gr)) wrapper)) name)
      (Some [s] s)
      (None [] (panic "{}: a CommonJS wrapper has no {} symbol" (.path m) name)))))

;;; `var require_x = __commonJS({ "path"(exports, module) { … } });`, leaving out
;;; parameters nothing uses, as esbuild does.
(defn cjs-part [(gr (mut g/Graph)) (m g/Module)] (-> js/Node)
  (let [(mut body) (js/new-kids)
        e (wrapper-param (mut gr) m "exports")
        mo (wrapper-param (mut gr) m "module")
        use-module (> (.uses (get (.symbols (.table gr)) mo)) 0)
        use-exports (or use-module (> (.uses (get (.symbols (.table gr)) e)) 0))
        (mut t) (str/StrBuf::new (malloc-allocator))]
    (for s (.kids (get (.kids (.tree m)) 1))
      (push! (mut body) (rw (mut gr) m s 0)))
    (push-str! (mut t) "var ")
    (push-str! (mut t) (final-of (mut gr) (.require-sym m)))
    (push-str! (mut t) "=")
    (push-str! (mut t) (final-of (mut gr) (g/helper! (mut gr) "__commonJS")))
    (push-str! (mut t) "({\"")
    (push-str! (mut t) (.path m))
    (push-str! (mut t) "\"(")
    (when use-exports (push-str! (mut t) (final-of (mut gr) e)))
    (when use-module
      (push-str! (mut t) ",")
      (push-str! (mut t) (final-of (mut gr) mo)))
    (push-str! (mut t) "){}});")
    (fill-body (first-stmt (finish! (mut t))) body)))

;;; Every live statement, in module order.
(defn program [(gr (mut g/Graph))] (-> js/Node)
  (let [(mut out) (js/new-kids)]
    (for id (.order gr)
      (when (included? (mut gr) id)
        (let [m (g/module-at (mut gr) id)]
          (if (= (.kind m) (g/Cjs))
              (push! (mut out) (cjs-part (mut gr) m))
              (for p (parts-of (mut gr) id)
                (when (live? (mut gr) p)
                  (match (part-output (mut gr) m (get (.part-stmt gr) p))
                    (Some [s] (push! (mut out) s))
                    (None [] 0))))))))
    (let [(mut top) (js/new-kids)]
      (push! (mut top) (js/none-node))
      (push! (mut top) (js/mk (js/KList) out 0 0))
      (js/mk (js/KProgram) top 0 0))))
