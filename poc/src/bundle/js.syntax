# JavaScript: ES2023 scripts and modules, as a scannerless PEG.
# A bundler needs the program's structure and tolerates leniency about programs that
# are already invalid, so early errors that depend on semantics are not modelled.
syntax
start Program
space Space
word IdPart
flags noin gen await jsx ts notyped nocond ;
keep noin ;
group "(" ")" Paren
opaque OptMember OptIndex OptCall Coalesce ;
nomix Coalesce Or And ;
keeplevel Call
keepforbid CallExpr OptCall ;
printwords "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$\\" high ;
apart "+" "+" "-" "-" "/" "/" "<" "!" ;
apartdigits "." ;
softclose "}" ;
breaks ";" "{" "}" ;
precedence Seq AssignExpr AssignBase Cond Binary Unary Exp Update NewBare Call New Primary ;

# ---------------------------------------------------------------- bytes

fragment LineEnd = [\n\r] | " " | " " ;
fragment LineComment = "//" (!LineEnd .)* ;
fragment BlockComment = "/*" (!"*/" .)* "*/" ;
fragment HtmlOpen = "<!--" (!LineEnd .)* ;
# Annex B: `-->` opens a comment when only space and comments precede it on its line.
fragment HtmlClose = @linestart "-->" (!LineEnd .)* ;
fragment UnicodeSpace = &[\x80-\xff] ( " " | "﻿" | " " | " " | " " | " "
                      | " " | " " | " " | " " | " " | " " | " "
                      | " " | " " | " " | "　" | " " | " " ) ;
fragment InlineSpace = [ \t\x0b\x0c] | UnicodeSpace ;
fragment Space = ([ \t\n\r\x0b\x0c] | LineComment | BlockComment | UnicodeSpace | HtmlOpen | HtmlClose)* ;

fragment Hex = [0-9a-fA-F] ;
fragment UnicodeEsc = "\\u" (Hex Hex Hex Hex | "{" Hex+ "}") ;
fragment IdStart = [a-zA-Z_$] | UnicodeEsc | !InlineSpace !LineEnd [\x80-\xff] ;
fragment IdPart = [a-zA-Z0-9_$] | UnicodeEsc | !InlineSpace !LineEnd [\x80-\xff] ;
fragment Reserved = ("break" | "case" | "catch" | "class" | "const" | "continue" | "debugger"
                   | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false"
                   | "finally" | "for" | "function" | "if" | "import" | "in" | "instanceof" | "new"
                   | "null" | "return" | "super" | "switch" | "this" | "throw" | "true" | "try"
                   | "typeof" | "var" | "void" | "while" | "with") !IdPart ;

# Each identifier role is its own node kind, so later languages never confuse a
# binding, a reference, a property name and a label.
token Ident = !Reserved IdStart IdPart* ;
token BindName = !Reserved IdStart IdPart* ;
token LabelName = !Reserved IdStart IdPart* ;
token PropName = IdStart IdPart* ;
token PrivateName = "#" IdStart IdPart* ;

fragment Digits = [0-9]+ ("_" [0-9]+)* ;
fragment Exponent = [eE] [+\-]? Digits ;
token Num = ( ("0x" | "0X") Hex (Hex | "_")* "n"?
            | ("0b" | "0B") [01_]+ "n"?
            | ("0o" | "0O") [0-7_]+ "n"?
            | "0" [0-7]+ ![0-9eE_n]
            | Digits "n"
            | Digits "." Digits? Exponent?
            | "." Digits Exponent?
            | Digits Exponent?
            ) !IdStart ;

fragment StrEsc = "\\" ("\r\n" | .) ;
token Str = "\"" (StrEsc | [^"\\\n\r])* "\"" | "'" (StrEsc | [^'\\\n\r])* "'" ;

fragment TplChars = (StrEsc | "$" !"{" | [^`$\\])* ;
token TemplateFull = "`" TplChars "`" ;
token TemplateHead = "`" TplChars "${" ;
token TemplateMiddle = "}" TplChars "${" ;
token TemplateTail = "}" TplChars "`" ;

fragment RegexClass = "[" ("\\" !LineEnd . | [^\]\\\n\r])* "]" ;
fragment RegexChar = "\\" !LineEnd . | RegexClass | [^/\[\\\n\r] ;
token Regex = "/" !"*" !"/" RegexChar+ "/" IdPart* ;

token AssignOp = ">>>=" | "<<=" | ">>=" | "**=" | "&&=" | "||=" | "??=" | "+=" | "-=" | "*=" | "/="
               | "%=" | "&=" | "|=" | "^=" | "=" !("=" | ">") ;

token Hashbang = "#!" (!LineEnd .)* ;

hidden rule Semi prints soft ";" = ";" | &"}" | @eof | @nl ;

# ---------------------------------------------------------------- program

rule Program = Hashbang? Stmt* -> Program ;

rule Stmt
  = Block
  | "var" with(-noin) Declarator,+ Semi -> VarDecl
  | LexicalDecl
  | FunctionDecl
  | ClassDecl
  | if(ts) Decorators ClassDecl -> TsDecoratedClass
  | ";" -> Empty
  | "if" "(" with(-noin) Seq ")" Stmt ("else" Stmt)? -> If
  | "do" Stmt "while" "(" with(-noin) Seq ")" ";"? -> DoWhile
  | "while" "(" with(-noin) Seq ")" Stmt -> While
  | ForStmt
  | "continue" (@nonl LabelName)? Semi -> Continue
  | "break" (@nonl LabelName)? Semi -> Break
  | "return" (@nonl with(-noin) Seq)? Semi -> Return
  | "with" "(" with(-noin) Seq ")" Stmt -> With
  | "switch" "(" with(-noin) Seq ")" "{" with(-noin) SwitchCase* "}" -> Switch
  | "throw" @nonl with(-noin) Seq Semi -> Throw
  | "try" TryBlock CatchClause? ("finally" TryBlock)? -> Try
  | "debugger" Semi -> Debugger
  | ImportDecl
  | ExportDecl
  | if(ts) TsDeclaration -> TsErased
  | if(ts) TsEnumDecl
  | if(ts) TsNamespaceDecl
  | LabelName ":" Stmt -> Labeled
  | !("{" | "function" | "class" | "let" "[" | "async" @nonl "function") with(-noin) Seq Semi -> ExprStmt
  ;

rule Block = "{" with(-noin) Stmt* "}" -> Block ;

rule LexicalDecl
  = "let" with(-noin) Declarator,+ Semi -> LetDecl
  | "const" with(-noin) Declarator,+ Semi -> ConstDecl
  ;

rule Declarator = BindTarget TsBindSuffix ("=" Assign)? -> Declarator ;

rule SwitchCase
  = "case" Seq ":" Stmt* -> Case
  | "default" ":" Stmt* -> Default
  ;

rule TryBlock = "{" with(-noin) Stmt* "}" -> TryBlock ;
rule CatchClause = "catch" CatchHead? TryBlock -> Catch ;
rule CatchHead = "(" BindTarget TsAnn ")" -> CatchHead ;

rule ForStmt
  = "for" "(" ForInit? ";" with(-noin) Seq? ";" with(-noin) Seq? ")" Stmt -> For
  | "for" "(" ForLeft "in" with(-noin) Seq ")" Stmt -> ForIn
  | "for" "await"? "(" ForLeft "of" with(-noin) Assign ")" Stmt -> ForOf
  ;

rule ForInit
  = "var" with(noin) Declarator,+ -> VarInit
  | "let" with(noin) Declarator,+ -> LetInit
  | "const" with(noin) Declarator,+ -> ConstInit
  | with(noin) Seq
  ;

rule ForLeft
  = "var" BindTarget "=" with(noin) Assign -> VarLeftInit
  | "var" BindTarget -> VarLeft
  | "let" BindTarget -> LetLeft
  | "const" BindTarget -> ConstLeft
  | Call
  ;

# ---------------------------------------------------------------- bindings

rule BindTarget = BindName | ArrayPattern | ObjectPattern ;
rule BindElement = BindTarget ("=" with(-noin) Assign)? -> BindElement ;

rule ArrayPattern = "[" PatternSlot* "]" -> ArrayPattern ;
rule PatternSlot
  = "," -> PatHole
  | "..." BindTarget &"]" -> PatRest
  | BindElement "," -> PatItem
  | BindElement &"]" -> PatLast
  ;

rule ObjectPattern = "{" PatternProp,* "}" -> ObjectPattern ;
rule PatternProp
  = "..." BindTarget &"}" -> PatPropRest
  | PropKey ":" BindElement -> PatProp
  | BindName ("=" with(-noin) Assign)? -> PatShort
  ;

# ---------------------------------------------------------------- functions

rule Params = "(" TsThisParam Param,* ")" -> Params ;
rule Param
  = "..." BindTarget TsAnn &")" -> RestParam
  | if(ts) Decorators ParamCore -> TsDecoratedParam
  | ParamCore
  ;
rule ParamCore
  = if(ts) TsParamMods BindTarget TsBindSuffix ("=" with(-noin) Assign)? -> TsParamProp
  | BindTarget TsBindSuffix ("=" with(-noin) Assign)? -> Param
  ;

rule FuncBody = "{" with(-noin -notyped) Stmt* "}" -> FuncBody ;

rule FunctionDecl
  = "async" @nonl "function" "*" BindName TsTypeParams with(gen await -noin) Params TsAnn with(gen await -noin) FuncBody -> AsyncGenDecl
  | "async" @nonl "function" BindName TsTypeParams with(await -gen -noin) Params TsAnn with(await -gen -noin) FuncBody -> AsyncFuncDecl
  | "function" "*" BindName TsTypeParams with(gen -await -noin) Params TsAnn with(gen -await -noin) FuncBody -> GenDecl
  | "function" BindName TsTypeParams with(-gen -await -noin) Params TsAnn with(-gen -await -noin) FuncBody -> FuncDecl
  ;

rule FunctionExpr
  = "async" @nonl "function" "*" BindName? TsTypeParams with(gen await -noin) Params TsAnn with(gen await -noin) FuncBody -> AsyncGenExpr
  | "async" @nonl "function" BindName? TsTypeParams with(await -gen -noin) Params TsAnn with(await -gen -noin) FuncBody -> AsyncFuncExpr
  | "function" "*" BindName? TsTypeParams with(gen -await -noin) Params TsAnn with(gen -await -noin) FuncBody -> GenExpr
  | "function" BindName? TsTypeParams with(-gen -await -noin) Params TsAnn with(-gen -await -noin) FuncBody -> FuncExpr
  ;

rule ArrowParams = Params | BindName ;
rule ArrowBody = with(-gen -await) FuncBody | !"{" Assign -> ExprBody ;
rule AsyncArrowBody = with(await -gen) FuncBody | !"{" with(await) Assign -> ExprBody ;

rule PropKey
  = PropName | Str | Num | PrivateName
  | "[" with(-noin) Assign "]" -> Computed
  ;

rule MethodDef
  = "async" @nonl "*" PropKey TsOptional TsTypeParams with(gen await -noin) Params TsAnn with(gen await -noin) FuncBody -> AsyncGenMethod
  | "async" @nonl PropKey TsOptional TsTypeParams with(await -gen -noin) Params TsAnn with(await -gen -noin) FuncBody -> AsyncMethod
  | "*" PropKey TsOptional TsTypeParams with(gen -await -noin) Params TsAnn with(gen -await -noin) FuncBody -> GenMethod
  | "get" PropKey TsOptional TsTypeParams with(-gen -await -noin) Params TsAnn with(-gen -await -noin) FuncBody -> Getter
  | "set" PropKey TsOptional TsTypeParams with(-gen -await -noin) Params TsAnn with(-gen -await -noin) FuncBody -> Setter
  | PropKey TsOptional TsTypeParams with(-gen -await -noin) Params TsAnn with(-gen -await -noin) FuncBody -> Method
  ;

# ---------------------------------------------------------------- classes

rule ClassHeritage = "extends" Call TsHeritageArgs -> ClassHeritage ;
rule ClassBody = "{" ClassMember* "}" -> ClassBody ;

rule ClassDecl = TsAbstract "class" BindName TsTypeParams ClassHeritage? TsImplements ClassBody -> ClassDecl ;
rule ClassExpr = TsAbstract "class" (!TsImplementsNext BindName)? TsTypeParams ClassHeritage? TsImplements ClassBody -> ClassExpr ;

rule ClassMember
  = ";" -> ClassEmpty
  | if(ts) TsMemberSignature -> TsErased
  | if(ts) Decorators ClassMemberBody -> TsDecoratedMember
  | ClassMemberBody
  ;
rule ClassMemberBody
  = "static" with(-gen -await -noin) FuncBody -> StaticBlock
  | TsMods "static" TsMods MethodDef -> StaticMethod
  | TsMods MethodDef
  | TsMods "static" TsMods PropKey TsBindSuffix ("=" with(-gen -await -noin) Assign)? Semi -> StaticField
  | TsMods PropKey TsBindSuffix ("=" with(-gen -await -noin) Assign)? Semi -> Field
  ;

# ---------------------------------------------------------------- modules

rule ModuleName = PropName | Str ;

rule ImportDecl
  = if(ts) TsTypeImport -> TsErased
  | if(ts) TsImportEquals
  | "import" Str Semi -> ImportBare
  | "import" ImportClause "from" Str Semi -> Import
  ;
rule ImportClause
  = BindName "," ImportRest -> ImportDefaultAnd
  | BindName -> ImportDefault
  | ImportRest
  ;
rule ImportRest
  = "*" "as" BindName -> ImportNamespace
  | "{" ImportSpec,* "}" -> ImportNamed
  ;
rule ImportSpec
  = if(ts) TsTypeSpec -> TsErased
  | ModuleName "as" BindName -> ImportAs
  | BindName -> ImportName
  ;

rule ExportDecl
  = if(ts) TsTypeExport -> TsErased
  | if(ts) "export" "=" with(-noin) Assign Semi -> TsExportAssign
  | if(ts) "export" TsEnumDecl -> TsExportEnum
  | if(ts) "export" TsNamespaceDecl -> TsExportNamespace
  | if(ts) "export" TsImportEquals -> TsExportImport
  | "export" "*" "from" Str Semi -> ExportAll
  | "export" "*" "as" ModuleName "from" Str Semi -> ExportAllAs
  | "export" "{" ExportSpec,* "}" "from" Str Semi -> ExportFrom
  | "export" "{" ExportSpec,* "}" Semi -> ExportNamed
  | if(ts) Decorators "export" ClassDecl -> TsDecoratedExport
  | if(ts) "export" Decorators ClassDecl -> TsExportDecorated
  | if(ts) Decorators "export" "default" ClassExpr -> TsDecoratedDefault
  | if(ts) "export" "default" Decorators ClassExpr -> TsDefaultDecorated
  | "export" "default" FunctionDefault -> ExportDefaultDecl
  | "export" "default" !("function" | "class" | "async" @nonl "function") Assign Semi -> ExportDefault
  | "export" "var" with(-noin) Declarator,+ Semi -> ExportVar
  | "export" LexicalDecl -> ExportLexical
  | "export" FunctionDecl -> ExportFunction
  | "export" ClassDecl -> ExportClass
  ;
rule FunctionDefault = FunctionExpr | ClassExpr ;
rule ExportSpec
  = if(ts) TsTypeSpec -> TsErased
  | ModuleName "as" ModuleName -> ExportAs
  | ModuleName -> ExportName
  ;

# ---------------------------------------------------------------- expressions

postfix Seq over Assign  "," Assign -> Seq ;

memo rule Assign = AssignExpr ;
rule AssignExpr
  = "async" @nonl TsTypeParams ArrowParams TsArrowReturn @nonl "=>" AsyncArrowBody -> AsyncArrow
  | TsTypeParams ArrowParams TsArrowReturn @nonl "=>" ArrowBody -> Arrow
  | if(gen) "yield" @nonl "*" Assign -> YieldStar
  | if(gen) "yield" (@nonl Assign)? -> Yield
  | AssignBase
  ;
suffix AssignBase over Cond  AssignOp Assign -> Assignment ;
suffix Cond over Binary  "?" with(-noin) CondThen ":" Assign -> Cond ;
# In TypeScript `a ? (b) : c => d` could be an arrow with a return type, and only what follows can
# say. If no `:` comes after, look again with return types off.
rule CondThen = Assign &":" | if(ts) with(notyped) Assign ;

infix Binary over Unary
  left "||" Or
  left "&&" And
  left "??" Coalesce
  left "|" BitOr
  left "^" BitXor
  left "&" BitAnd
  left "==" Eq "!=" Ne "===" StrictEq "!==" StrictNe
  left "<" Lt ">" Gt "<=" Le ">=" Ge "instanceof" InstanceOf unless(noin) "in" In
       drop if(ts) @nonl "as" TsType drop if(ts) @nonl "satisfies" TsType
  left "<<" Shl ">>>" Ushr ">>" Shr
  left "+" Add "-" Sub
  left "*" Mul "/" Div "%" Mod
  ;

rule Unary
  = "!" Unary -> Not
  | "~" Unary -> BitNot
  | "+" Unary -> Pos
  | "-" Unary -> Neg
  | "typeof" Unary -> TypeOf
  | "void" Unary -> Void
  | "delete" Unary -> Delete
  | if(await) "await" Unary -> Await
  | if(ts) unless(jsx) TsLt TsType TsGt Unary
  | Exp
  ;

suffix Exp over Update  "**" Unary -> Pow ;

rule Update
  = "++" Unary -> PreInc
  | "--" Unary -> PreDec
  | PostUpdate
  ;
suffix PostUpdate over Call
  @nonl "++" -> PostInc
  | @nonl "--" -> PostDec
  ;

postfix Call over New
  "." PropMember -> Member
  | "[" with(-noin) Seq "]" -> Index
  | TsCallTypeArgs Args -> CallExpr
  | TsCallTypeArgs Template -> Tagged
  | if(ts) @nonl "!"
  | if(ts) TsTypeArgs TsInstantiationEnd
  | "?." TsCallTypeArgs "(" with(-noin) Arg,* ")" -> OptCall
  | "?." "[" with(-noin) Seq "]" -> OptIndex
  | "?." !Digit PropMember -> OptMember
  ;
fragment Digit = [0-9] ;
rule PropMember = PropName | PrivateName ;

rule Args = "(" with(-noin -notyped) Arg,* ")" -> Args ;
rule Arg = "..." with(-noin) Assign -> Spread | with(-noin) Assign ;

memo postfix NewCallee over NewBase
  "." PropMember -> Member
  | "[" with(-noin) Seq "]" -> Index
  | Template -> Tagged
  | if(ts) @nonl "!"
  ;
rule NewBase = New | Primary ;

rule New
  = "new" "." "target" -> NewTarget
  | "new" ~NewCallee TsHeritageArgs Args -> NewExpr
  | NewBare
  | Primary
  ;
# Its own precedence level: `new a` followed by `.b` must print as `(new a).b`.
rule NewBare = "new" ~NewCallee TsBareNewArgs -> NewNoArgs ;

rule Primary
  = "this" -> This
  | "null" -> Null
  | "true" -> True
  | "false" -> False
  | "super" -> Super
  | "import" "." "meta" -> ImportMeta
  | "import" "(" with(-noin) Assign ("," with(-noin) Assign)? ","? ")" -> ImportCall
  | Num
  | Str
  | Template
  | Regex
  | ArrayLit
  | ObjectLit
  | FunctionExpr
  | ClassExpr
  | "(" with(-noin -notyped) Seq ")" -> Paren
  | PrivateName
  | if(ts) Decorators ClassExpr -> TsDecoratedClassExpr
  | if(jsx) JsxNode
  | Ident
  ;

rule Template = TemplateFull | TemplateHead with(-noin) Seq TemplateRest* TemplateTail -> Template ;
rule TemplateRest = TemplateMiddle with(-noin) Seq -> TemplatePart ;

rule ArrayLit = "[" ArraySlot* "]" -> ArrayLit ;
rule ArraySlot
  = "," -> Hole
  | Arg "," -> Elem
  | Arg &"]" -> ElemLast
  ;

rule ObjectLit = "{" ObjectProp,* "}" -> ObjectLit ;
rule ObjectProp
  = "..." with(-noin) Assign -> SpreadProp
  | MethodDef
  | PropKey ":" with(-noin) Assign -> Prop
  | Ident "=" with(-noin) Assign -> CoverInit
  | Ident -> Shorthand
  ;

# ---------------------------------------------------------------- JSX

# A tag that is a string: lower case, or with a dash. Anything else is a reference, and is an
# ordinary Ident or Member, so scopes, renaming and tree shaking need to know nothing about JSX.
fragment JsxPart = IdPart | "-" ;
fragment JsxEnd = ">" ;
token JsxName = IdStart JsxPart* ;
token JsxTagText = [a-z] JsxPart* | IdStart IdPart* "-" JsxPart* ;
token JsxStr = "\"" [^"]* "\"" | "'" [^']* "'" ;
# esbuild only warns about a stray `>` or `}` in text, so they are text.
raw token JsxText = [^{<]+ ;

# Text may begin with `=` or `>`, so the `>` that ends a tag is not the first half of `>=`.
hidden rule JsxGt prints ">" = JsxEnd ;

rule JsxNode
  = "<" JsxGt JsxChild* "<" "/" JsxGt -> JsxFragment
  | "<" JsxTag JsxAttr* JsxRest -> JsxElement
  ;
rule JsxRest
  = "/" JsxGt -> JsxSelfClose
  | JsxGt JsxChild* "<" "/" JsxTag JsxGt -> JsxClose
  ;
rule JsxTag
  = JsxName ":" JsxName -> JsxNs
  | JsxTagText !"."
  | JsxDotted
  ;
memo postfix JsxDotted over JsxRoot  "." PropMember -> Member ;
rule JsxRoot = "this" -> This | Ident ;
rule JsxAttr
  = "{" "..." with(-noin) Assign "}" -> JsxSpreadAttr
  | JsxAttrName ("=" JsxAttrValue)? -> JsxAttr
  ;
rule JsxAttrName = JsxName ":" JsxName -> JsxNs | JsxName ;
rule JsxAttrValue = JsxStr | "{" with(-noin) Assign "}" -> JsxValue | JsxNode ;
rule JsxChild
  = JsxText
  | "{" "..." with(-noin) Assign "}" -> JsxSpreadChild
  | "{" with(-noin) Seq? "}" -> JsxContainer
  | !("<" "/") JsxNode
  ;

# ---------------------------------------------------------------- TypeScript

# Types say nothing at run time, so they are hidden rules: they are parsed, and leave no node. What
# does exist at run time (enums, namespaces, parameter properties) has nodes for ts.rules to lower.
fragment TsOpen = "<" ;
hidden rule TsLt = TsOpen ;
hidden rule TsGt = JsxEnd ;

hidden rule TsAnn = (if(ts) ":" TsReturn)? ;
hidden rule TsArrowReturn = (if(ts) unless(notyped) ":" TsReturn)? ;
hidden rule TsOptional = (if(ts) "?")? ;
hidden rule TsBindSuffix = (if(ts) ("?" | "!"))? TsAnn ;
hidden rule TsThisParam = (if(ts) "this" TsAnn ","?)? ;
hidden rule TsTypeParams = (if(ts) TsLt TsTypeParam,+ TsGt)? ;
hidden rule TsTypeParam = (("const" | "in" | "out") &PropName)* PropName ("extends" TsType)? ("=" TsType)? ;
hidden rule TsTypeArgs = TsLt TsType,+ TsGt ;
hidden rule TsHeritageArgs = (if(ts) TsTypeArgs)? ;
hidden rule TsCallTypeArgs = (if(ts) TsTypeArgs &("(" | "`"))? ;
hidden rule TsBareNewArgs = (if(ts) TsTypeArgs TsInstantiationEnd)? ;
hidden rule TsImplements = (if(ts) "implements" TsNamedType,+)? ;
hidden rule TsImplementsNext = if(ts) "implements" PropName ;
hidden rule TsAbstract = (if(ts) "abstract" @nonl &"class")? ;
hidden rule TsNamedType = TsEntity TsTypeArgs? ;
hidden rule TsEntity = PropName ("." PropName)* ;

# `a<b>` with no call after it is an instantiation unless what follows could continue an expression.
hidden rule TsInstantiationEnd
  = !("<" | ">" | "+" | "-")
    (@nl | "in" | "instanceof" | "as" | "satisfies"
    | !(PropName | Num | Str | PrivateName | "[" | "{" | "(" | "~" | "!" | "/" | "`"))
  ;

hidden rule TsReturn
  = "asserts" @nonl PropName (@nonl "is" TsType)?
  | PropName @nonl "is" TsType
  | TsType
  ;
hidden rule TsType = TsFunctionType | TsUnion (@nonl "extends" TsCheck "?" TsType ":" TsType)? ;
# In the check of a conditional type, `infer U extends X ?` has X as U's constraint. Elsewhere, a `?`
# after X would make `U extends X ? …` the conditional type.
hidden rule TsCheck = with(nocond) TsCheckBody ;
hidden rule TsCheckBody = TsFunctionType | TsUnion ;
hidden rule TsFunctionType
  = ("abstract" @nonl)? "new" TsTypeParams Params "=>" TsReturn
  | TsTypeParams Params "=>" TsReturn
  ;
hidden rule TsUnion = "|"? TsIntersection ("|" TsIntersection)* ;
hidden rule TsIntersection = "&"? TsOperator ("&" TsOperator)* ;
hidden rule TsOperator
  = ("keyof" | "unique" | "readonly") TsOperator
  | "infer" PropName ("extends" TsCheckBody (if(nocond) | !"?"))?
  | TsPostfixType
  ;
hidden rule TsPostfixType = TsPrimaryType (@nonl "[" TsType? "]")* ;
hidden rule TsPrimaryType
  = "(" with(-nocond) TsType ")"
  | "[" TsTupleElem,* "]"
  | TsMappedType
  | TsObjectType
  | "typeof" (TsImportType | TsEntity (@nonl TsTypeArgs)?)
  | TsImportType
  | TemplateFull
  | TemplateHead TsType (TemplateMiddle TsType)* TemplateTail
  | Str
  | Num
  | "-" Num
  | TsEntity (@nonl TsTypeArgs)?
  ;
hidden rule TsImportType = "import" "(" TsType ("," Assign)? ")" ("." TsEntity)? TsTypeArgs? ;
hidden rule TsTupleElem = "..."? (PropName "?"? ":")? TsType "?"? ;
hidden rule TsObjectType = "{" (TsTypeMember ("," | ";")?)* "}" ;
hidden rule TsMappedType
  = "{" (("+" | "-")? "readonly")? "[" PropName "in" TsType ("as" TsType)? "]" (("+" | "-")? "?")? TsAnn ";"? "}"
  ;
# What can follow a word in a member if that word is the member's name, and not a modifier.
hidden rule TsKeyEnd = "?" | "!" | ":" | "=" | "(" | "<" | "," | ";" | "}" ;
hidden rule TsTypeMember
  = ("readonly" !TsKeyEnd)? "[" PropName ":" TsType "]" TsAnn
  | "new" TsTypeParams Params TsAnn
  | TsTypeParams Params TsAnn
  | ("readonly" !TsKeyEnd)? (("get" | "set") !TsKeyEnd)? PropKey "?"? (TsTypeParams Params TsAnn | TsAnn)
  ;

# ---- statements with nothing in them at run time
hidden rule TsDeclaration
  = "type" @nonl PropName TsTypeParams "=" TsType Semi
  | TsInterface
  | "declare" @nonl &TsAmbientStart TsAmbient
  | TsOverload
  ;
hidden rule TsInterface = "interface" @nonl PropName TsTypeParams ("extends" TsNamedType,+)? TsObjectType ;
hidden rule TsAmbientStart
  = "const" | "let" | "var" | "function" | "class" | "enum" | "namespace" | "module" | "global"
  | "type" | "interface" | "abstract" | "async"
  ;
hidden rule TsAmbient
  = "global" Block
  | ("namespace" | "module") (Str | TsEntity) (Block | Semi)
  | Stmt
  ;
hidden rule TsOverload = ("async" @nonl)? "function" "*"? PropName TsTypeParams Params TsAnn Semi ;

hidden rule TsTypeImport
  = "import" "type" ImportClause "from" Str Semi
  | "import" "type" BindName "=" (JsxDotted | "require" "(" Str ")") Semi
  ;
hidden rule TsTypeSpec = "type" !("," | "}" | "as" ("," | "}")) ModuleName ("as" ModuleName)? ;
hidden rule TsTypeExport
  = "export" "type" "{" ExportSpec,* "}" ("from" Str)? Semi
  | "export" "type" "*" ("as" ModuleName)? "from" Str Semi
  | "export" "as" "namespace" PropName Semi
  | "export" TsDeclaration
  | "export" "default" (TsInterface | ("async" @nonl)? "function" "*"? PropName? TsTypeParams Params TsAnn Semi)
  ;

# ---- class members with nothing in them at run time
hidden rule TsMods = (if(ts) (TsAccess !TsKeyEnd)*)? ;
hidden rule TsAccess = "public" | "private" | "protected" | "readonly" | "override" ;
hidden rule TsAnyMods = ((TsAccess | "static") !TsKeyEnd)* ;
hidden rule TsParamMods = (TsAccess !TsKeyEnd)+ ;
hidden rule TsMemberSignature
  = TsAnyMods ("declare" | "abstract") !TsKeyEnd TsAnyMods ("async" @nonl)? "*"? (("get" | "set") !TsKeyEnd)?
    PropKey ("?" | "!")? (TsTypeParams Params)? TsAnn ("=" Assign)? !"{" Semi
  | TsAnyMods "[" PropName ":" TsType "]" TsAnn Semi
  | TsAnyMods ("async" @nonl)? "*"? (("get" | "set") !TsKeyEnd)? PropKey "?"? TsTypeParams Params TsAnn !"{" Semi
  ;

# ---- what is left at run time
hidden rule TsConstMod = ("const" @nonl)? ;
rule TsEnumDecl = TsConstMod "enum" BindName "{" TsEnumMember,* "}" -> TsEnum ;
rule TsEnumMember = PropKey ("=" with(-noin) Assign)? -> TsEnumMember ;
hidden rule TsNamespaceWord = ("namespace" | "module") @nonl &PropName ;
rule TsNamespaceDecl = TsNamespaceWord BindName TsNamespaceBody -> TsNamespace ;
rule TsNamespaceBody
  = "{" with(-noin) Stmt* "}" -> TsNamespaceBlock
  | "." BindName TsNamespaceBody -> TsNamespaceNested
  ;
rule TsImportEquals
  = "import" BindName "=" "require" "(" Str ")" Semi -> TsImportRequire
  | "import" BindName "=" JsxDotted Semi -> TsImportAlias
  ;

# ---- decorators, as TypeScript's experimentalDecorators has them
rule Decorators = Decorator+ ;
rule Decorator = "@" DecoratorExpr -> Decorator ;
rule DecoratorExpr = "(" with(-noin) Seq ")" -> Paren | DecoratorCall ;
memo postfix DecoratorCall over Ident
  "." PropMember -> Member
  | TsCallTypeArgs Args -> CallExpr
  ;
