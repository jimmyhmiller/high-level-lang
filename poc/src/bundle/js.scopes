# JavaScript's binding structure.
scopes bundle.js

ref Ident ;
bind BindName ;

function
  FuncDecl GenDecl AsyncFuncDecl AsyncGenDecl
  FuncExpr GenExpr AsyncFuncExpr AsyncGenExpr
  Arrow AsyncArrow
  Method GenMethod AsyncMethod AsyncGenMethod Getter Setter
  StaticBlock ;

block Block For ForIn ForOf Switch Catch ClassBody ClassExpr ;

var VarDecl VarInit VarLeft VarLeftInit ExportVar ;
lexical LetDecl ConstDecl LetInit ConstInit LetLeft ConstLeft CatchHead Import ;
param Params ;

hoist-name FuncDecl GenDecl AsyncFuncDecl AsyncGenDecl ;
block-name ClassDecl ;
self-name FuncExpr GenExpr AsyncFuncExpr AsyncGenExpr ClassExpr Arrow AsyncArrow ;
key-first Method GenMethod AsyncMethod AsyncGenMethod Getter Setter ;

dynamic-kind With ;
dynamic-name eval ;
