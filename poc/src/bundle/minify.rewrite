# Syntax minification as rules: esbuild's --minify-syntax, for what lodash exercises.
rewrite bundle.js
host bundle.minhost
leaves Num Str Ident PropName ;

# ---------------------------------------------------------------- parentheses
# The printer puts back whatever precedence needs.
rule unparen : Paren(x) when !@opaque(x) => x ;

# ---------------------------------------------------------------- constants
rule fold-add : Add(Num(a), Num(b)) => Num(a + b) ;
rule fold-sub : Sub(Num(a), Num(b)) => Num(a - b) ;
rule fold-mul : Mul(Num(a), Num(b)) => Num(a * b) ;
rule concat   : Add(Str(a), Str(b)) => Str(a ++ b) ;

rule not-true   : Not(True()) => False() ;
rule not-false  : Not(False()) => True() ;
rule not-3      : Not(Not(Not(x))) => Not(x) ;
rule not-eq     : Not(Eq(a, b)) => Ne(a, b) ;
rule not-ne     : Not(Ne(a, b)) => Eq(a, b) ;
rule not-seq    : Not(StrictEq(a, b)) => StrictNe(a, b) ;
rule not-sne    : Not(StrictNe(a, b)) => StrictEq(a, b) ;
rule and-true   : And(True(), x) => x ;
rule and-false  : And(False(), _) => False() ;
rule or-true    : Or(True(), _) => True() ;
rule or-false   : Or(False(), x) => x ;
rule cond-true  : Cond(True(), a, _) => a ;
rule cond-false : Cond(False(), _, b) => b ;
rule cond-not   : Cond(Not(c), a, b) => Cond(c, b, a) ;
rule typeof-eq  : StrictEq(TypeOf(x), Str(s)) => Eq(TypeOf(x), Str(s)) ;
rule typeof-ne  : StrictNe(TypeOf(x), Str(s)) => Ne(TypeOf(x), Str(s)) ;

# ---------------------------------------------------------------- property names
rule index-dot  : Index(o, Str(k)) when @plain-key(k) => @dot(o, k) ;
rule prop-plain : Prop(Str(k), v) when @plain-key(k) => @plain-prop(k, v) ;

# ---------------------------------------------------------------- branches
rule if-true      : If(True(), t, e) when @no-hoist(e) => t ;
rule if-false     : If(False(), t, None()) when @no-hoist(t) => Empty() ;
rule if-false-e   : If(False(), t, e) when @no-hoist(t) => e ;
# Swapping must not let the new then-branch capture the `else`.
rule if-not-else  : If(Not(c), t, e) when @some(e), @no-dangling(e) => If(c, e, t) ;
rule if-not-brace : If(Not(c), t, e) when @some(e), !@no-dangling(e) => If(c, Block(List(e)), t) ;
rule if-empty     : If(c, Empty(), None()) => ExprStmt(c) ;
rule else-empty   : If(c, t, Empty()) => If(c, t, None()) ;
rule then-empty   : If(c, Empty(), e) when @some(e) => If(Not(c), e, None()) ;
rule if-nest      : If(c, If(d, t, None()), None()) => If(And(c, d), t, None()) ;
rule if-to-or     : If(Not(c), ExprStmt(a), None()) => ExprStmt(Or(c, a)) ;
rule if-to-and    : If(c, ExprStmt(a), None()) => ExprStmt(And(c, a)) ;
rule if-to-cond   : If(c, ExprStmt(a), ExprStmt(b)) => ExprStmt(Cond(c, a, b)) ;
rule if-to-return : If(c, Return(a), Return(b)) when @some(a), @some(b) => Return(Cond(c, a, b)) ;

# ---------------------------------------------------------------- blocks and loops
rule block-empty  : Block(List()) => Empty() ;
rule block-unwrap : Block(List(x)) when @not-lexical(x), @no-dangling(x) => x ;
rule while-to-for : While(c, b) => For(None(), c, None(), b) ;

# ---------------------------------------------------------------- statement lists
rule drop-empty : List(xs..., Empty(), ys...) => List(xs..., ys...) ;
rule flatten    : List(xs..., Block(List(ss...)), ys...) when @all-plain(ss) => List(xs..., ss..., ys...) ;
rule merge-expr : List(xs..., ExprStmt(a), ExprStmt(b), ys...)
                    when !@directive(a), !@directive(b)
                    => List(xs..., ExprStmt(Seq(a, b)), ys...) ;
rule merge-var  : List(xs..., VarDecl(List(a...)), VarDecl(List(b...)), ys...)
                    => List(xs..., VarDecl(List(a..., b...)), ys...) ;
rule merge-let  : List(xs..., LetDecl(List(a...)), LetDecl(List(b...)), ys...)
                    => List(xs..., LetDecl(List(a..., b...)), ys...) ;
rule merge-const : List(xs..., ConstDecl(List(a...)), ConstDecl(List(b...)), ys...)
                    => List(xs..., ConstDecl(List(a..., b...)), ys...) ;
rule merge-return : List(xs..., ExprStmt(a), Return(b), ys...)
                    when !@directive(a), @some(b)
                    => List(xs..., Return(Seq(a, b)), ys...) ;
rule merge-throw  : List(xs..., ExprStmt(a), Throw(b), ys...)
                    when !@directive(a)
                    => List(xs..., Throw(Seq(a, b)), ys...) ;
rule merge-if     : List(xs..., ExprStmt(a), If(c, t, e), ys...)
                    when !@directive(a)
                    => List(xs..., If(Seq(a, c), t, e), ys...) ;
rule merge-for-e  : List(xs..., ExprStmt(a), For(None(), c, u, b), ys...)
                    when !@directive(a)
                    => List(xs..., For(a, c, u, b), ys...) ;
rule merge-for-v  : List(xs..., VarDecl(List(a...)), For(None(), c, u, b), ys...)
                    => List(xs..., For(VarInit(List(a...)), c, u, b), ys...) ;
rule merge-for-vi : List(xs..., VarDecl(List(a...)), For(VarInit(List(b...)), c, u, s), ys...)
                    => List(xs..., For(VarInit(List(a..., b...)), c, u, s), ys...) ;
rule if-return-next : List(xs..., If(c, Return(a), None()), Return(b), ys...)
                    when @some(a), @some(b)
                    => List(xs..., Return(Cond(c, a, b)), ys...) ;
rule drop-else    : List(xs..., If(c, t, e), ys...)
                    when @jumps(t), @some(e)
                    => List(xs..., If(c, t, None()), e, ys...) ;
rule dead-code    : List(xs..., s, y, ys...)
                    when @jumps(s), @no-hoist(y)
                    => List(xs..., s, ys...) ;

# ---------------------------------------------------------------- functions
rule ret-void  : FuncBody(List(xs..., Return(None()))) => FuncBody(List(xs...)) ;
rule ret-early : FuncBody(List(xs..., If(c, Return(None()), None()), y, ys...))
                 => FuncBody(List(xs..., If(Not(c), Block(List(y, ys...)), None()))) ;
