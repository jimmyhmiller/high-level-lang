;;; Early errors: programs the grammar accepts because the rule that forbids them depends
;;; on context or on what else is declared. Answers the first problem found.
;;;
;;; Hand-written Coil over the grammar's nodes. It runs after parsing, on the source tree.
(module bundle.early)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "bundle.js" :as js)
(import "bundle.scopes" :as sc)
(import "hl.rt" :as rt)
(import "coil.unicode" :as u)
(import "coil.str" :use [Rune])

(defstruct Problem [(message (slice u8)) (at i64)])

;;; What the code around a node permits.
(defstruct Ctx
  [(strict bool)
   (module bool)
   (in-function bool)
   (in-generator bool)
   (in-async bool)
   (in-loop bool)
   (in-switch bool)
   (labels (ArrayList (slice u8)))
   (loop-labels (ArrayList (slice u8)))
   (allow-new-target bool)
   (allow-super-prop bool)
   (allow-super-call bool)
   (allow-top-return bool)
   (top-level bool)
   (exportable (ArrayList (slice u8)))])

(defstruct Checker [(problem (Option Problem))])

(defn report! [(c (mut Checker)) (message (slice u8)) (n js/Node)] (-> void)
  (match (.problem c)
    (None [] (set! (.problem c) (Some (Problem :message message :at (.lo n)))))
    (Some [_] 0)))

(defn has? [(xs (ArrayList (slice u8))) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x xs (when (= x s) (set! hit true)))
    hit))

(defn strs [] (-> (ArrayList (slice u8))) (ArrayList::new [(slice u8)] (malloc-allocator)))

(defn strict-reserved? [(s (slice u8))] (-> bool)
  (or (= s "implements") (= s "interface") (= s "let") (= s "package") (= s "private")
      (= s "protected") (= s "public") (= s "static") (= s "yield")))

(defn restricted? [(s (slice u8))] (-> bool) (or (= s "eval") (= s "arguments")))

;;; A name's code points: UTF-8 decoded, `a` and `\u{61}` resolved.
(defn hex-value [(d u8)] (-> i64)
  (cond (rt/digit? d) (- (cast i64 d) 48)
        (and (>= d #\a) (<= d #\f)) (+ (- (cast i64 d) 97) 10)
        (and (>= d #\A) (<= d #\F)) (+ (- (cast i64 d) 65) 10)
        :else 0))

(defn code-points [(s (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (malloc-allocator))
        (mut i) 0
        n (len s)]
    (while (< i n)
      (let [c (cast i64 (get s i))]
        (cond
          (and (= c 92) (< (+ i 1) n) (= (get s (+ i 1)) #\u))
            (if (and (< (+ i 2) n) (= (get s (+ i 2)) #\{))
                (let [(mut j) (+ i 3) (mut v) 0]
                  (while (and (< j n) (!= (get s j) #\}))
                    (set! v (+ (* (if (> v 1114111) 1114112 v) 16) (hex-value (get s j))))
                    (set! j (+ j 1)))
                  (push! (mut out) v)
                  (set! i (+ j 1)))
                (let [(mut v) 0 end (if (< (+ i 6) n) (+ i 6) n)]
                  (for k (range (+ i 2) end) (set! v (+ (* v 16) (hex-value (get s k)))))
                  (push! (mut out) v)
                  (set! i end)))
          (< c 128) (do (push! (mut out) c) (set! i (+ i 1)))
          (and (< c 224) (< (+ i 1) n))
            (do (push! (mut out) (+ (* (- c 192) 64) (- (cast i64 (get s (+ i 1))) 128)))
                (set! i (+ i 2)))
          (and (< c 240) (< (+ i 2) n))
            (do (push! (mut out) (+ (* (- c 224) 4096)
                                    (* (- (cast i64 (get s (+ i 1))) 128) 64)
                                    (- (cast i64 (get s (+ i 2))) 128)))
                (set! i (+ i 3)))
          (< (+ i 3) n)
            (do (push! (mut out) (+ (* (- c 240) 262144)
                                    (* (- (cast i64 (get s (+ i 1))) 128) 4096)
                                    (* (- (cast i64 (get s (+ i 2))) 128) 64)
                                    (- (cast i64 (get s (+ i 3))) 128)))
                (set! i (+ i 4)))
          :else (do (push! (mut out) -1) (set! i n)))))
    out))

(defn utf8-push! [(b (mut (ArrayList u8))) (cp i64)] (-> void)
  (cond
    (< cp 128) (push! (mut b) (cast u8 cp))
    (< cp 2048)
      (do (push! (mut b) (cast u8 (+ 192 (/ cp 64))))
          (push! (mut b) (cast u8 (+ 128 (% cp 64)))))
    (< cp 65536)
      (do (push! (mut b) (cast u8 (+ 224 (/ cp 4096))))
          (push! (mut b) (cast u8 (+ 128 (% (/ cp 64) 64))))
          (push! (mut b) (cast u8 (+ 128 (% cp 64)))))
    :else
      (do (push! (mut b) (cast u8 (+ 240 (/ cp 262144))))
          (push! (mut b) (cast u8 (+ 128 (% (/ cp 4096) 64))))
          (push! (mut b) (cast u8 (+ 128 (% (/ cp 64) 64))))
          (push! (mut b) (cast u8 (+ 128 (% cp 64)))))))

;;; `a` in a name means `a`, and an escaped keyword is still a keyword.
(defn unescaped-name [(s (slice u8))] (-> (slice u8))
  (let [(mut any) false]
    (for c s (when (= c #\\) (set! any true)))
    (if (not any)
        s
        (let [(mut b) (ArrayList::new [u8] (malloc-allocator))]
          (for cp (code-points s) (when (>= cp 0) (utf8-push! (mut b) cp)))
          (slice b)))))

;;; ID_Start and ID_Continue, by general category, plus what the language adds.
(defn id-part? [(cp i64) (first bool)] (-> bool)
  (cond
    (or (< cp 0) (> cp 1114111) (and (>= cp 55296) (<= cp 57343))) false
    (or (= cp 36) (= cp 95)) true
    (and (not first) (or (= cp 8204) (= cp 8205))) true
    :else
      (let [cat (u/general-category-abbrev (u/general-category (Rune :value (cast u32 cp))))]
        (or (= cat "Lu") (= cat "Ll") (= cat "Lt") (= cat "Lm") (= cat "Lo") (= cat "Nl")
            ;; Other_ID_Start
            (= cp 4256) (= cp 8472) (= cp 8494) (= cp 12443) (= cp 12444)
            (and (not first)
                 (or (= cat "Mn") (= cat "Mc") (= cat "Nd") (= cat "Pc")
                     ;; Other_ID_Continue
                     (= cp 183) (= cp 903) (and (>= cp 4969) (<= cp 4977)) (= cp 6618)))))))

(defn valid-name? [(s (slice u8))] (-> bool)
  (let [(mut plain) true]
    (for c s (when (or (= c #\\) (>= c (: 128 u8))) (set! plain false)))
    (or plain
        (let [points (code-points s) (mut ok) (> (len points) 0)]
          (for i (range 0 (len points))
            (unless (id-part? (get points i) (= i 0)) (set! ok false)))
          ok))))

(defn reserved-word? [(s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for w ["break" "case" "catch" "class" "const" "continue" "debugger" "default" "delete" "do"
            "else" "enum" "export" "extends" "false" "finally" "for" "function" "if" "import"
            "in" "instanceof" "new" "null" "return" "super" "switch" "this" "throw" "true" "try"
            "typeof" "var" "void" "while" "with"]
      (when (= w s) (set! hit true)))
    hit))

(defn check-name! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (let [name (unescaped-name (.text n))]
    (unless (valid-name? (.text n))
      (report! (mut c) "this is not a valid identifier" n))
    (when (and (!= name (.text n)) (reserved-word? name))
      (report! (mut c) "a keyword cannot contain an escape" n))
    (when (and (.strict x) (strict-reserved? name))
      (report! (mut c) "this name is reserved in strict mode" n))
    (when (and (.in-generator x) (= name "yield"))
      (report! (mut c) "yield is reserved in a generator" n))
    (when (and (or (.in-async x) (.module x)) (= name "await"))
      (report! (mut c) "await is reserved here" n))))

(defn check-binding! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (check-name! (mut c) x n)
  (when (and (.strict x) (restricted? (unescaped-name (.text n))))
    (report! (mut c) "eval and arguments cannot be bound in strict mode" n)))

;;; Bindings of a declaration or pattern, in order.
(defn binds! [(n js/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (if (= (.kind n) (js/KBindName))
      (push! (mut out) (unescaped-name (.text n)))
      (unless (sc/opens? (.kind n))
        (for k (.kids n) (binds! k (mut out))))))

(defn duplicates? [(xs (ArrayList (slice u8)))] (-> bool)
  (let [(mut hit) false]
    (for i (range 0 (len xs))
      (for j (range 0 i)
        (when (= (get xs i) (get xs j)) (set! hit true))))
    hit))

;;; `var` names hoisting through a statement list, not entering nested functions.
(defn var-names! [(n js/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (cond
    (sc/var? (.kind n)) (binds! n (mut out))
    (sc/function? (.kind n)) 0
    :else (for k (.kids n) (var-names! k (mut out)))))

;;; Names a statement list declares lexically, and whether any repeats.
(defn lexical-of! [(s js/Node) (function-top bool) (names (mut (ArrayList (slice u8)))) (functions (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind s)
    (js/KLetDecl [] (binds! s (mut names)))
    (js/KConstDecl [] (binds! s (mut names)))
    (js/KClassDecl [] (push! (mut names) (unescaped-name (.text (get (.kids s) 0)))))
    (js/KFuncDecl []
      (unless function-top
        (push! (mut functions) (unescaped-name (.text (get (.kids s) 0))))))
    (js/KGenDecl []
      (unless function-top (push! (mut names) (unescaped-name (.text (get (.kids s) 0))))))
    (js/KAsyncFuncDecl []
      (unless function-top (push! (mut names) (unescaped-name (.text (get (.kids s) 0))))))
    (js/KAsyncGenDecl []
      (unless function-top (push! (mut names) (unescaped-name (.text (get (.kids s) 0))))))
    (js/KImport [] (binds! s (mut names)))
    (js/KExportFunction [] (lexical-of! (get (.kids s) 0) function-top (mut names) (mut functions)))
    (js/KExportDefaultDecl []
      (let [name (get (.kids (get (.kids s) 0)) 0)]
        (when (= (.kind name) (js/KBindName))
          (push! (mut names) (unescaped-name (.text name))))))
    (js/KExportLexical [] (lexical-of! (get (.kids s) 0) false (mut names) (mut functions)))
    (js/KExportClass [] (lexical-of! (get (.kids s) 0) false (mut names) (mut functions)))
    (js/KLabeled [] (lexical-of! (get (.kids s) 1) function-top (mut names) (mut functions)))
    (_ 0)))

(defn check-declarations! [(c (mut Checker)) (x Ctx) (stmts (ArrayList js/Node)) (function-top bool) (params (ArrayList (slice u8))) (at js/Node)] (-> void)
  (let [(mut names) (strs) (mut functions) (strs) (mut vars) (strs)]
    (for s stmts
      (lexical-of! s function-top (mut names) (mut functions))
      (var-names! s (mut vars)))
    (when (duplicates? names)
      (report! (mut c) "this name is declared twice in one block" at))
    (for f functions
      (when (has? names f) (report! (mut c) "this name is declared twice in one block" at))
      (when (has? vars f) (report! (mut c) "this name is declared twice in one block" at)))
    (when (and (.strict x) (duplicates? functions))
      (report! (mut c) "this function is declared twice in one block" at))
    (for n names
      (when (has? vars n) (report! (mut c) "a let or const collides with a var" at))
      (when (has? params n) (report! (mut c) "a let or const collides with a parameter" at)))))

;;; Does the statement list begin with a `"use strict"` directive?
(defn has-use-strict? [(stmts (ArrayList js/Node))] (-> bool)
  (let [(mut hit) false (mut go) true]
    (for s stmts
      (when go
        (if (and (= (.kind s) (js/KExprStmt)) (= (.kind (get (.kids s) 0)) (js/KStr)))
            (when (= (rt/str-content (.text (get (.kids s) 0))) "use strict") (set! hit true))
            (set! go false))))
    hit))

(defn simple-params? [(params js/Node)] (-> bool)
  (let [(mut ok) true]
    (for p (.kids (get (.kids params) 0))
      (unless (and (= (.kind p) (js/KParam))
                   (= (.kind (get (.kids p) 0)) (js/KBindName))
                   (= (.kind (get (.kids p) 1)) (js/KNone)))
        (set! ok false)))
    ok))

;;; A function's own rules, then its parts in the context it creates.
(defn check-function! [(c (mut Checker)) (x Ctx) (n js/Node) (name js/Node) (params js/Node) (body js/Node)
                       (is-gen bool) (is-async bool) (is-arrow bool) (is-method bool) (super-call bool)] (-> void)
  (let [body-stmts (if (= (.kind body) (js/KFuncBody))
                       (.kids (get (.kids body) 0))
                       (js/new-kids))
        own-strict (has-use-strict? body-stmts)
        strict (or (.strict x) own-strict)
        (mut inner) x
        (mut param-names) (strs)]
    (set! (.strict inner) strict)
    (set! (.in-function inner) true)
    (set! (.in-loop inner) false)
    (set! (.in-switch inner) false)
    (set! (.labels inner) (strs))
    (set! (.loop-labels inner) (strs))
    (set! (.top-level inner) false)
    (unless is-arrow
      (set! (.in-generator inner) is-gen)
      (set! (.in-async inner) is-async)
      (set! (.allow-new-target inner) true)
      (set! (.allow-super-prop inner) is-method)
      (set! (.allow-super-call inner) super-call))
    ;; An arrow resets `yield`, and only ever adds `await`.
    (when is-arrow
      (set! (.in-generator inner) false)
      (when is-async (set! (.in-async inner) true)))
    ;; A declaration's name belongs to the code around it, under the body's strictness.
    (when (= (.kind name) (js/KBindName))
      (let [(mut around) x]
        (set! (.strict around) strict)
        (check-binding! (mut c) around name)))
    (when (= (.kind params) (js/KParams))
      (binds! params (mut param-names))
      (when (and is-arrow (.in-generator x) (has? param-names "yield"))
        (report! (mut c) "yield is reserved in a generator" params))
      (when (and own-strict (not (simple-params? params)))
        (report! (mut c) "use strict needs simple parameters" params))
      (when (and (duplicates? param-names)
                 (or strict is-arrow is-method (not (simple-params? params))))
        (report! (mut c) "a parameter is named twice" params))
      (when (or (and (or is-gen (and is-arrow (.in-generator x))) (contains-yield? params))
                (and (or is-async (and is-arrow (.in-async x))) (contains-await? params)))
        (report! (mut c) "yield and await expressions cannot be parameter defaults here" params))
      (walk! (mut c) inner params))
    (when (= (.kind params) (js/KBindName))
      (push! (mut param-names) (unescaped-name (.text params)))
      (check-binding! (mut c) inner params))
    (when (= (.kind body) (js/KFuncBody))
      (check-declarations! (mut c) inner body-stmts true param-names body)
      (for s body-stmts (walk! (mut c) inner s)))
    (when (= (.kind body) (js/KExprBody))
      (walk! (mut c) inner (get (.kids body) 0)))))

(defn contains-kind? [(n js/Node) (k js/Kind)] (-> bool)
  (if (= (.kind n) k)
      true
      (if (sc/function? (.kind n))
          false
          (let [(mut hit) false]
            (for child (.kids n) (when (contains-kind? child k) (set! hit true)))
            hit))))

(defn contains-yield? [(n js/Node)] (-> bool)
  (or (contains-kind? n (js/KYield)) (contains-kind? n (js/KYieldStar))))
(defn contains-await? [(n js/Node)] (-> bool) (contains-kind? n (js/KAwait)))

;;; Can this be assigned to? `pattern` allows the destructuring forms.
(defn check-target! [(c (mut Checker)) (x Ctx) (t js/Node) (pattern bool)] (-> void)
  (match (.kind t)
    (js/KIdent []
      (check-name! (mut c) x t)
      (when (and (.strict x) (restricted? (unescaped-name (.text t))))
        (report! (mut c) "eval and arguments cannot be assigned in strict mode" t)))
    (js/KMember [] (walk! (mut c) x t))
    (js/KIndex [] (walk! (mut c) x t))
    (js/KParen []
      (let [inner (get (.kids t) 0)]
        (match (.kind inner)
          (js/KIdent [] (check-target! (mut c) x inner false))
          (js/KMember [] (walk! (mut c) x inner))
          (js/KIndex [] (walk! (mut c) x inner))
          (js/KParen [] (check-target! (mut c) x inner false))
          (_ (report! (mut c) "invalid assignment target" t)))))
    (js/KArrayLit []
      (if pattern
          (check-array-pattern! (mut c) x t)
          (report! (mut c) "invalid assignment target" t)))
    (js/KObjectLit []
      (if pattern
          (check-object-pattern! (mut c) x t)
          (report! (mut c) "invalid assignment target" t)))
    (_ (report! (mut c) "invalid assignment target" t))))

(defn check-pattern-element! [(c (mut Checker)) (x Ctx) (e js/Node)] (-> void)
  (if (and (= (.kind e) (js/KAssignment)) (= (.text (get (.kids e) 1)) "="))
      (do
        (check-target! (mut c) x (get (.kids e) 0) true)
        (walk! (mut c) x (get (.kids e) 2)))
      (check-target! (mut c) x e true)))

(defn check-array-pattern! [(c (mut Checker)) (x Ctx) (t js/Node)] (-> void)
  (let [slots (.kids (get (.kids t) 0))]
    (for i (range 0 (len slots))
      (let [s (get slots i)]
        (match (.kind s)
          (js/KHole [] 0)
          (_
            (let [e (get (.kids s) 0)]
              (if (= (.kind e) (js/KSpread))
                  (let [inner (get (.kids e) 0)]
                    (unless (and (= i (- (len slots) 1)) (= (.kind s) (js/KElemLast)))
                      (report! (mut c) "a rest element must come last, with no comma after it" s))
                    (when (= (.kind inner) (js/KAssignment))
                      (report! (mut c) "a rest element cannot have a default" s))
                    (check-target! (mut c) x inner true))
                  (check-pattern-element! (mut c) x e)))))))))

(defn check-object-pattern! [(c (mut Checker)) (x Ctx) (t js/Node)] (-> void)
  (let [props (.kids (get (.kids t) 0))]
    (for i (range 0 (len props))
      (let [p (get props i)]
        (match (.kind p)
          (js/KShorthand [] (check-target! (mut c) x (get (.kids p) 0) false))
          (js/KCoverInit []
            (check-target! (mut c) x (get (.kids p) 0) false)
            (walk! (mut c) x (get (.kids p) 1)))
          (js/KProp []
            (walk! (mut c) x (get (.kids p) 0))
            (check-pattern-element! (mut c) x (get (.kids p) 1)))
          (js/KSpreadProp []
            (let [inner (get (.kids p) 0)]
              (unless (= i (- (len props) 1))
                (report! (mut c) "a rest property must come last" p))
              (unless (or (= (.kind inner) (js/KIdent)) (= (.kind inner) (js/KMember)) (= (.kind inner) (js/KIndex)))
                (report! (mut c) "a rest property must be a simple target" p))
              (check-target! (mut c) x inner false)))
          (_ (report! (mut c) "this cannot be destructured into" p)))))))

;;; A statement position that only takes a statement, not a declaration.
(defn check-substatement! [(c (mut Checker)) (x Ctx) (s js/Node) (allow-function bool)] (-> void)
  (substatement-kind! (mut c) x s allow-function)
  (walk! (mut c) x s))

(defn substatement-kind! [(c (mut Checker)) (x Ctx) (s js/Node) (allow-function bool)] (-> void)
  (match (.kind s)
    (js/KLetDecl [] (report! (mut c) "a lexical declaration needs a block here" s))
    (js/KConstDecl [] (report! (mut c) "a lexical declaration needs a block here" s))
    (js/KClassDecl [] (report! (mut c) "a class declaration needs a block here" s))
    (js/KGenDecl [] (report! (mut c) "a generator declaration needs a block here" s))
    (js/KAsyncFuncDecl [] (report! (mut c) "an async function declaration needs a block here" s))
    (js/KAsyncGenDecl [] (report! (mut c) "an async generator declaration needs a block here" s))
    (js/KFuncDecl []
      (unless (and allow-function (not (.strict x)))
        (report! (mut c) "a function declaration needs a block here" s)))
    (js/KLabeled [] (substatement-kind! (mut c) x (get (.kids s) 1) false))
    (_ 0)))

(defn loop-body! [(c (mut Checker)) (x Ctx) (s js/Node)] (-> void)
  (let [(mut inner) x]
    (set! (.in-loop inner) true)
    (set! (.top-level inner) false)
    (check-substatement! (mut c) inner s false)))

(defn walk-kids! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (for k (.kids n) (walk! (mut c) x k)))

(defn block! [(c (mut Checker)) (x Ctx) (stmts (ArrayList js/Node)) (at js/Node)] (-> void)
  (let [(mut inner) x]
    (set! (.top-level inner) false)
    (check-declarations! (mut c) inner stmts false (strs) at)
    (for s stmts (walk! (mut c) inner s))))

;;; A declaration's names must be initialised where the form requires it.
(defn check-decl-list! [(c (mut Checker)) (x Ctx) (list js/Node) (need-init bool) (lexical bool)] (-> void)
  (for d (.kids list)
    (let [target (get (.kids d) 0) init (get (.kids d) 1)]
      (when (and (= (.kind init) (js/KNone))
                 (or need-init (!= (.kind target) (js/KBindName))))
        (report! (mut c) "this declaration needs an initial value" d))
      (when lexical
        (let [(mut names) (strs)]
          (binds! target (mut names))
          (for n names (when (= n "let") (report! (mut c) "let cannot be the name of a lexical binding" d)))
          (when (duplicates? names) (report! (mut c) "a name is bound twice in one pattern" d))))
      (walk! (mut c) x d))))

(defn class-body! [(c (mut Checker)) (x Ctx) (class js/Node) (heritage js/Node) (body js/Node)] (-> void)
  (let [(mut inner) x
        (mut constructors) 0
        members (.kids (get (.kids body) 0))
        (mut privates) (strs)
        derived (!= (.kind heritage) (js/KNone))]
    (set! (.strict inner) true)
    (set! (.top-level inner) false)
    (for m members (private-decl! (mut c) m (mut privates)))
    (for m members
      (let [is-static (or (= (.kind m) (js/KStaticMethod)) (= (.kind m) (js/KStaticField)))
            method (if (= (.kind m) (js/KStaticMethod)) (get (.kids m) 0) m)]
        (match (.kind method)
          (js/KMethod []
            (let [key (get (.kids method) 0)
                  ctor (and (not is-static) (prop-is? key "constructor"))]
              (when ctor (set! constructors (+ constructors 1)))
              (when (and is-static (prop-is? key "prototype"))
                (report! (mut c) "a static method cannot be named prototype" key))
              (check-function! (mut c) inner method key (get (.kids method) 1) (get (.kids method) 2)
                               false false false true (and ctor derived))
              (walk! (mut c) inner key)))
          (js/KGenMethod [] (class-special! (mut c) inner method is-static true false))
          (js/KAsyncMethod [] (class-special! (mut c) inner method is-static false true))
          (js/KAsyncGenMethod [] (class-special! (mut c) inner method is-static true true))
          (js/KGetter [] (accessor! (mut c) inner method is-static 0))
          (js/KSetter [] (accessor! (mut c) inner method is-static 1))
          (js/KField [] (field! (mut c) inner method false))
          (js/KStaticField [] (field! (mut c) inner method true))
          (js/KStaticBlock []
            (let [(mut b) inner]
              (set! (.in-function b) false)
              (set! (.in-async b) false)
              (set! (.in-generator b) false)
              (set! (.allow-new-target b) true)
              (set! (.allow-super-prop b) true)
              (set! (.allow-super-call b) false)
              (set! (.labels b) (strs))
              (set! (.loop-labels b) (strs))
              (set! (.in-loop b) false)
              (set! (.in-switch b) false)
              (walk-kids! (mut c) b method)))
          (_ 0))))
    (when (> constructors 1)
      (report! (mut c) "a class has one constructor" class))))

(defn prop-is? [(key js/Node) (name (slice u8))] (-> bool)
  (or (and (= (.kind key) (js/KPropName)) (= (.text key) name))
      (and (= (.kind key) (js/KStr)) (= (rt/str-content (.text key)) name))))

(defn private-decl! [(c (mut Checker)) (m js/Node) (privates (mut (ArrayList (slice u8))))] (-> void)
  (let [method (if (or (= (.kind m) (js/KStaticMethod)) (= (.kind m) (js/KStaticField))) m m)
        inner (if (= (.kind method) (js/KStaticMethod)) (get (.kids method) 0) method)]
    (when (and (> (len (.kids inner)) 0) (= (.kind (get (.kids inner) 0)) (js/KPrivateName)))
      (let [name (.text (get (.kids inner) 0))
            accessor (or (= (.kind inner) (js/KGetter)) (= (.kind inner) (js/KSetter)))]
        (when (= name "#constructor")
          (report! (mut c) "#constructor is not a valid private name" inner))
        (when (and (has? privates name) (not accessor))
          (report! (mut c) "a private name is declared twice" inner))
        (push! (mut privates) name)))))

(defn class-special! [(c (mut Checker)) (x Ctx) (m js/Node) (is-static bool) (is-gen bool) (is-async bool)] (-> void)
  (let [key (get (.kids m) 0)]
    (when (and (not is-static) (prop-is? key "constructor"))
      (report! (mut c) "a constructor cannot be a generator, async, or an accessor" key))
    (when (and is-static (prop-is? key "prototype"))
      (report! (mut c) "a static method cannot be named prototype" key))
    (check-function! (mut c) x m key (get (.kids m) 1) (get (.kids m) 2) is-gen is-async false true false)
    (walk! (mut c) x key)))

(defn accessor! [(c (mut Checker)) (x Ctx) (m js/Node) (is-static bool) (params-wanted i64)] (-> void)
  (let [key (get (.kids m) 0)
        params (get (.kids m) 1)
        count (len (.kids (get (.kids params) 0)))]
    (unless (= count params-wanted)
      (report! (mut c) "a getter takes no parameters and a setter takes one" params))
    (when (and (= params-wanted 1) (= count 1)
               (= (.kind (get (.kids (get (.kids params) 0)) 0)) (js/KRestParam)))
      (report! (mut c) "a setter's parameter cannot be a rest" params))
    (when (and (not is-static) (prop-is? key "constructor"))
      (report! (mut c) "a constructor cannot be a generator, async, or an accessor" key))
    (when (and is-static (prop-is? key "prototype"))
      (report! (mut c) "a static method cannot be named prototype" key))
    (check-function! (mut c) x m key params (get (.kids m) 2) false false false true false)
    (walk! (mut c) x key)))

(defn field! [(c (mut Checker)) (x Ctx) (m js/Node) (is-static bool)] (-> void)
  (let [key (get (.kids m) 0)
        (mut inner) x]
    (when (prop-is? key "constructor")
      (report! (mut c) "a field cannot be named constructor" key))
    (when (and is-static (prop-is? key "prototype"))
      (report! (mut c) "a field cannot be named prototype" key))
    (walk! (mut c) x key)
    (set! (.in-function inner) true)
    (set! (.allow-new-target inner) true)
    (set! (.allow-super-prop inner) true)
    (set! (.allow-super-call inner) false)
    (set! (.in-async inner) false)
    (set! (.in-generator inner) false)
    (walk! (mut c) inner (get (.kids m) 1))))

;;; Object literal methods: `super.x` is allowed; nothing else about a class applies.
(defn object-prop! [(c (mut Checker)) (x Ctx) (p js/Node)] (-> void)
  (match (.kind p)
    (js/KMethod [] (check-function! (mut c) x p (get (.kids p) 0) (get (.kids p) 1) (get (.kids p) 2) false false false true false)
                   (walk! (mut c) x (get (.kids p) 0)))
    (js/KGenMethod [] (check-function! (mut c) x p (get (.kids p) 0) (get (.kids p) 1) (get (.kids p) 2) true false false true false)
                      (walk! (mut c) x (get (.kids p) 0)))
    (js/KAsyncMethod [] (check-function! (mut c) x p (get (.kids p) 0) (get (.kids p) 1) (get (.kids p) 2) false true false true false)
                        (walk! (mut c) x (get (.kids p) 0)))
    (js/KAsyncGenMethod [] (check-function! (mut c) x p (get (.kids p) 0) (get (.kids p) 1) (get (.kids p) 2) true true false true false)
                           (walk! (mut c) x (get (.kids p) 0)))
    (js/KGetter [] (accessor-object! (mut c) x p 0))
    (js/KSetter [] (accessor-object! (mut c) x p 1))
    (js/KCoverInit [] (report! (mut c) "`=` here is only allowed when destructuring" p))
    (_ (walk-kids! (mut c) x p))))

(defn accessor-object! [(c (mut Checker)) (x Ctx) (m js/Node) (wanted i64)] (-> void)
  (let [params (get (.kids m) 1)
        count (len (.kids (get (.kids params) 0)))]
    (unless (= count wanted)
      (report! (mut c) "a getter takes no parameters and a setter takes one" params))
    (when (and (= wanted 1) (= count 1) (= (.kind (get (.kids (get (.kids params) 0)) 0)) (js/KRestParam)))
      (report! (mut c) "a setter's parameter cannot be a rest" params))
    (check-function! (mut c) x m (get (.kids m) 0) params (get (.kids m) 2) false false false true false)
    (walk! (mut c) x (get (.kids m) 0))))

(defn duplicate-proto? [(props (ArrayList js/Node))] (-> bool)
  (let [(mut count) 0]
    (for p props
      (when (and (= (.kind p) (js/KProp)) (prop-is? (get (.kids p) 0) "__proto__"))
        (set! count (+ count 1))))
    (> count 1)))

(defn string-has-octal? [(raw (slice u8))] (-> bool)
  (let [s (rt/str-content raw) (mut hit) false (mut i) 0]
    (while (< (+ i 1) (len s))
      (if (= (get s i) #\\)
          (let [e (get s (+ i 1))]
            (when (and (rt/digit? e)
                       (not (and (= e #\0) (or (>= (+ i 2) (len s)) (not (rt/digit? (get s (+ i 2))))))))
              (set! hit true))
            (set! i (+ i 2)))
          (set! i (+ i 1))))
    hit))

(defn hex? [(c u8)] (-> bool)
  (or (rt/digit? c) (and (>= c #\a) (<= c #\f)) (and (>= c #\A) (<= c #\F))))

;;; `\x` and `\u` must be complete, in strings and in untagged templates alike.
(defn bad-escape? [(s (slice u8))] (-> bool)
  (let [(mut hit) false (mut i) 0]
    (while (< (+ i 1) (len s))
      (if (= (get s i) #\\)
          (let [e (get s (+ i 1))]
            (cond
              (= e #\x)
                (unless (and (< (+ i 3) (len s)) (hex? (get s (+ i 2))) (hex? (get s (+ i 3))))
                  (set! hit true))
              (= e #\u)
                (if (and (< (+ i 2) (len s)) (= (get s (+ i 2)) #\{))
                    (let [(mut j) (+ i 3) (mut v) 0 (mut digits) 0]
                      (while (and (< j (len s)) (!= (get s j) #\}))
                        (if (hex? (get s j))
                            (let [d (get s j)]
                              (set! v (+ (* (if (> v 1114111) 1114112 v) 16)
                                         (cond (rt/digit? d) (- (cast i64 d) 48)
                                               (>= d #\a) (+ (- (cast i64 d) 97) 10)
                                               :else (+ (- (cast i64 d) 65) 10))))
                              (set! digits (+ digits 1)))
                            (set! hit true))
                        (set! j (+ j 1)))
                      (when (or (>= j (len s)) (= digits 0) (> v 1114111)) (set! hit true)))
                    (unless (and (< (+ i 5) (len s)) (hex? (get s (+ i 2))) (hex? (get s (+ i 3)))
                                 (hex? (get s (+ i 4))) (hex? (get s (+ i 5))))
                      (set! hit true)))
              :else 0)
            (set! i (+ i 2)))
          (set! i (+ i 1))))
    hit))

(defn template-chunk-octal? [(s (slice u8))] (-> bool)
  (let [(mut hit) false (mut i) 0]
    (while (< (+ i 1) (len s))
      (if (= (get s i) #\\)
          (let [e (get s (+ i 1))]
            (when (and (rt/digit? e)
                       (not (and (= e #\0) (or (>= (+ i 2) (len s)) (not (rt/digit? (get s (+ i 2))))))))
              (set! hit true))
            (set! i (+ i 2)))
          (set! i (+ i 1))))
    hit))

(defn regex-flags-bad? [(text (slice u8))] (-> bool)
  (let [(mut last) 0 (mut bad) false]
    (for i (range 0 (len text)) (when (= (get text i) #\/) (set! last i)))
    (let [flags (subslice text (+ last 1) (len text))]
      (for i (range 0 (len flags))
        (let [f (get flags i)]
          (unless (or (= f #\d) (= f #\g) (= f #\i) (= f #\m) (= f #\s) (= f #\u) (= f #\v) (= f #\y))
            (set! bad true))
          (for j (range 0 i) (when (= (get flags j) f) (set! bad true))))))
    bad))

(defn walk! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (match (.problem c)
    (Some [_] 0)
    (None []
      (match (.kind n)
        (js/KIdent [] (check-name! (mut c) x n))
        (js/KBindName [] (check-binding! (mut c) x n))
        (js/KLabelName [] (check-name! (mut c) x n))
        (js/KNum []
          (when (and (.strict x) (> (len (.text n)) 1) (= (get (.text n) 0) #\0) (rt/digit? (get (.text n) 1)))
            (report! (mut c) "a legacy octal literal is not allowed in strict mode" n))
          (when (and (> (len (.text n)) 1) (= (get (.text n) 0) #\0) (rt/digit? (get (.text n) 1)) (has-underscore? (.text n)))
            (report! (mut c) "a legacy octal literal cannot contain _" n)))
        (js/KStr []
          (when (bad-escape? (rt/str-content (.text n)))
            (report! (mut c) "an incomplete escape sequence" n))
          (when (and (.strict x) (string-has-octal? (.text n)))
            (report! (mut c) "an octal escape is not allowed in strict mode" n)))
        (js/KTemplateFull [] (template-chunk! (mut c) n))
        (js/KTemplateHead [] (template-chunk! (mut c) n))
        (js/KTemplateMiddle [] (template-chunk! (mut c) n))
        (js/KTemplateTail [] (template-chunk! (mut c) n))
        (js/KTagged []
          ;; A tagged template may have any escapes, and is not an optional chain's.
          (let [tag (get (.kids n) 0) tpl (get (.kids n) 1)]
            (when (optional-spine? tag)
              (report! (mut c) "a tagged template cannot be in an optional chain" n))
            (walk! (mut c) x tag)
            (when (= (.kind tpl) (js/KTemplate))
              (for k (.kids tpl)
                (unless (or (= (.kind k) (js/KTemplateHead)) (= (.kind k) (js/KTemplateTail)))
                  (for e (if (= (.kind k) (js/KList)) (.kids k) (singleton k))
                    (if (= (.kind e) (js/KTemplatePart))
                        (walk! (mut c) x (get (.kids e) 1))
                        (walk! (mut c) x e))))))))
        (js/KRegex []
          (when (regex-flags-bad? (.text n))
            (report! (mut c) "invalid regular expression flags" n)))

        ;; ---- assignment and update
        (js/KAssignment []
          (let [op (.text (get (.kids n) 1))]
            (check-target! (mut c) x (get (.kids n) 0) (= op "="))
            (walk! (mut c) x (get (.kids n) 2))))
        (js/KPreInc [] (check-target! (mut c) x (get (.kids n) 0) false))
        (js/KPreDec [] (check-target! (mut c) x (get (.kids n) 0) false))
        (js/KPostInc [] (check-target! (mut c) x (get (.kids n) 0) false))
        (js/KPostDec [] (check-target! (mut c) x (get (.kids n) 0) false))
        (js/KDelete []
          (let [t (unparen (get (.kids n) 0))]
            (when (and (.strict x) (= (.kind t) (js/KIdent)))
              (report! (mut c) "delete of a name is not allowed in strict mode" n))
            (when (or (= (.kind t) (js/KMember)) (= (.kind t) (js/KOptMember)))
              (when (= (.kind (get (.kids t) 1)) (js/KPrivateName))
                (report! (mut c) "a private member cannot be deleted" n)))
            (walk-kids! (mut c) x n)))

        ;; ---- literals that are only valid as patterns
        (js/KCoverInit [] (report! (mut c) "`=` here is only allowed when destructuring" n))
        (js/KObjectLit []
          (let [props (.kids (get (.kids n) 0))]
            (when (duplicate-proto? props)
              (report! (mut c) "__proto__ is set twice" n))
            (for p props (object-prop! (mut c) x p))))

        ;; ---- classes
        (js/KClassDecl []
          (check-binding! (mut c) (strict-ctx x) (get (.kids n) 0))
          (class-heritage! (mut c) x n))
        (js/KClassExpr []
          (when (= (.kind (get (.kids n) 0)) (js/KBindName))
            (check-binding! (mut c) (strict-ctx x) (get (.kids n) 0)))
          (class-heritage! (mut c) x n))
        (js/KSuper []
          (report! (mut c) "super is only valid in a method" n))
        (js/KCallExpr []
          (if (= (.kind (get (.kids n) 0)) (js/KSuper))
              (do
                (unless (.allow-super-call x)
                  (report! (mut c) "super() is only valid in a derived constructor" n))
                (walk! (mut c) x (get (.kids n) 1)))
              (walk-kids! (mut c) x n)))
        (js/KMember [] (member! (mut c) x n))
        (js/KIndex [] (member! (mut c) x n))
        (js/KNewTarget []
          (unless (.allow-new-target x)
            (report! (mut c) "new.target is only valid in a function" n)))
        (js/KNewExpr []
          (when (= (.kind (get (.kids n) 0)) (js/KImportCall))
            (report! (mut c) "import() cannot be used with new" n))
          (when (optional-spine? (get (.kids n) 0))
            (report! (mut c) "new cannot have an optional chain" n))
          (walk-kids! (mut c) x n))
        (js/KImportMeta []
          (unless (.module x)
            (report! (mut c) "import.meta is only valid in a module" n)))

        ;; ---- functions
        (js/KFuncDecl [] (fn-node! (mut c) x n false false))
        (js/KFuncExpr [] (fn-expr-node! (mut c) x n false false))
        (js/KGenDecl [] (fn-node! (mut c) x n true false))
        (js/KGenExpr [] (fn-expr-node! (mut c) x n true false))
        (js/KAsyncFuncDecl [] (fn-node! (mut c) x n false true))
        (js/KAsyncFuncExpr [] (fn-expr-node! (mut c) x n false true))
        (js/KAsyncGenDecl [] (fn-node! (mut c) x n true true))
        (js/KAsyncGenExpr [] (fn-expr-node! (mut c) x n true true))
        (js/KArrow []
          (check-function! (mut c) x n (js/none-node) (get (.kids n) 0) (get (.kids n) 1) false false true false false))
        (js/KAsyncArrow []
          (check-function! (mut c) x n (js/none-node) (get (.kids n) 0) (get (.kids n) 1) false true true false false))

        ;; ---- statements
        (js/KProgram []
          (let [stmts (.kids (get (.kids n) 1))]
            (check-declarations! (mut c) x stmts (not (.module x)) (strs) n)
            (for s stmts (walk! (mut c) x s))))
        (js/KBlock [] (block! (mut c) x (.kids (get (.kids n) 0)) n))
        (js/KTryBlock [] (block! (mut c) x (.kids (get (.kids n) 0)) n))
        (js/KReturn []
          (unless (or (.in-function x) (.allow-top-return x))
            (report! (mut c) "return is only valid in a function" n))
          (walk-kids! (mut c) x n))
        (js/KWith []
          (when (.strict x) (report! (mut c) "with is not allowed in strict mode" n))
          (walk! (mut c) x (get (.kids n) 0))
          (check-substatement! (mut c) x (get (.kids n) 1) false))
        (js/KIf []
          (walk! (mut c) x (get (.kids n) 0))
          (check-substatement! (mut c) (nested x) (get (.kids n) 1) true)
          (unless (= (.kind (get (.kids n) 2)) (js/KNone))
            (check-substatement! (mut c) (nested x) (get (.kids n) 2) true)))
        (js/KWhile [] (walk! (mut c) x (get (.kids n) 0)) (loop-body! (mut c) x (get (.kids n) 1)))
        (js/KDoWhile [] (loop-body! (mut c) x (get (.kids n) 0)) (walk! (mut c) x (get (.kids n) 1)))
        (js/KFor []
          (for-init! (mut c) x (get (.kids n) 0) (get (.kids n) 3))
          (walk! (mut c) x (get (.kids n) 1))
          (walk! (mut c) x (get (.kids n) 2))
          (loop-body! (mut c) x (get (.kids n) 3)))
        (js/KForIn []
          (for-left! (mut c) x (get (.kids n) 0) (get (.kids n) 2) true)
          (walk! (mut c) x (get (.kids n) 1))
          (loop-body! (mut c) x (get (.kids n) 2)))
        (js/KForOf []
          (let [left (get (.kids n) 1)]
            (for-left! (mut c) x left (get (.kids n) 3) false)
            (when (= (spine-root left) "let")
              (report! (mut c) "for (let of …) is not allowed" left))
            (when (and (= (.kind left) (js/KIdent)) (= (.text left) "async")
                       (= (.kind (get (.kids n) 0)) (js/KNone)))
              (report! (mut c) "for (async of …) is not allowed" left))
            (unless (= (.kind (get (.kids n) 0)) (js/KNone))
              (unless (or (.in-async x) (and (.module x) (not (.in-function x))))
                (report! (mut c) "for await is only valid in an async function" n)))
            (walk! (mut c) x (get (.kids n) 2))
            (loop-body! (mut c) x (get (.kids n) 3))))
        (js/KSwitch []
          (walk! (mut c) x (get (.kids n) 0))
          (let [(mut inner) x (mut defaults) 0 (mut stmts) (js/new-kids)]
            (set! (.in-switch inner) true)
            (set! (.top-level inner) false)
            (for s (.kids (get (.kids n) 1))
              (when (= (.kind s) (js/KDefault)) (set! defaults (+ defaults 1)))
              (let [list (if (= (.kind s) (js/KCase)) (get (.kids s) 1) (get (.kids s) 0))]
                (for st (.kids list) (push! (mut stmts) st))))
            (when (> defaults 1) (report! (mut c) "a switch has one default" n))
            (check-declarations! (mut c) inner stmts false (strs) n)
            (for s (.kids (get (.kids n) 1)) (walk-kids! (mut c) inner s))))
        (js/KBreak []
          (let [l (get (.kids n) 0)]
            (if (= (.kind l) (js/KNone))
                (unless (or (.in-loop x) (.in-switch x))
                  (report! (mut c) "break is only valid in a loop or switch" n))
                (unless (has? (.labels x) (.text l))
                  (report! (mut c) "break to an unknown label" n)))))
        (js/KContinue []
          (let [l (get (.kids n) 0)]
            (unless (.in-loop x)
              (report! (mut c) "continue is only valid in a loop" n))
            (unless (= (.kind l) (js/KNone))
              (unless (has? (.loop-labels x) (.text l))
                (report! (mut c) "continue to a label that is not a loop" n)))))
        (js/KLabeled []
          (let [label (get (.kids n) 0)
                body (get (.kids n) 1)
                (mut inner) x
                (mut labels) (js/new-kids)]
            (check-name! (mut c) x label)
            (when (has? (.labels x) (.text label))
              (report! (mut c) "this label is already in use" label))
            (set! (.labels inner) (append-str (.labels x) (.text label)))
            (when (is-loop-through-labels? body)
              (set! (.loop-labels inner) (append-str (.loop-labels x) (.text label))))
            (set! (.top-level inner) false)
            (check-substatement! (mut c) inner body true)))
        (js/KTry []
          (when (and (= (.kind (get (.kids n) 1)) (js/KNone)) (= (.kind (get (.kids n) 2)) (js/KNone)))
            (report! (mut c) "try needs catch or finally" n))
          (walk-kids! (mut c) x n))
        (js/KVarDecl [] (check-decl-list! (mut c) x (get (.kids n) 0) false false))
        (js/KExportVar []
          (module-item! (mut c) x n)
          (check-decl-list! (mut c) x (get (.kids n) 0) false false))
        (js/KLetDecl [] (check-decl-list! (mut c) x (get (.kids n) 0) false true))
        (js/KConstDecl [] (check-decl-list! (mut c) x (get (.kids n) 0) true true))
        (js/KCatch []
          (let [head (get (.kids n) 0)
                body (get (.kids n) 1)
                stmts (.kids (get (.kids body) 0))
                (mut names) (strs) (mut lexical) (strs) (mut funcs) (strs) (mut inner) x]
            (set! (.top-level inner) false)
            (unless (= (.kind head) (js/KNone))
              (binds! head (mut names))
              (when (duplicates? names) (report! (mut c) "a catch parameter is bound twice" head))
              (walk! (mut c) inner head))
            (for s stmts (lexical-of! s false (mut lexical) (mut funcs)))
            (for l lexical (when (has? names l) (report! (mut c) "this name collides with the catch parameter" body)))
            (for l funcs (when (has? names l) (report! (mut c) "this name collides with the catch parameter" body)))
            (when (not (= (.kind head) (js/KNone)))
              (unless (= (.kind (get (.kids head) 0)) (js/KBindName))
                (let [(mut vars) (strs)]
                  (for s stmts (var-names! s (mut vars)))
                  (for v vars (when (has? names v) (report! (mut c) "a var collides with a destructured catch parameter" body))))))
            (walk! (mut c) inner body)))

        ;; ---- modules
        (js/KImport [] (module-item! (mut c) x n))
        (js/KImportBare [] (module-item! (mut c) x n))
        (js/KExportAll [] (module-item! (mut c) x n))
        (js/KExportAllAs [] (module-item! (mut c) x n))
        (js/KExportFrom [] (module-item! (mut c) x n))
        (js/KExportNamed []
          (module-item! (mut c) x n)
          (for spec (.kids (get (.kids n) 0))
            (let [local (get (.kids spec) 0)]
              (when (or (= (.kind local) (js/KStr)) (reserved-word? (.text local)))
                (report! (mut c) "this export names no local binding" local))
              (unless (has? (.exportable x) (unescaped-name (.text local)))
                (report! (mut c) "this export names nothing declared in the module" local)))))
        (js/KExportDefault [] (module-item! (mut c) x n) (walk-kids! (mut c) x n))
        (js/KExportDefaultDecl [] (module-item! (mut c) x n) (walk-kids! (mut c) x n))
        (js/KExportLexical [] (module-item! (mut c) x n) (walk-kids! (mut c) x n))
        (js/KExportFunction [] (module-item! (mut c) x n) (walk-kids! (mut c) x n))
        (js/KExportClass [] (module-item! (mut c) x n) (walk-kids! (mut c) x n))
        (_ (walk-kids! (mut c) x n))))))

(defn singleton [(n js/Node)] (-> (ArrayList js/Node))
  (let [(mut out) (js/new-kids)]
    (push! (mut out) n)
    out))

(defn has-underscore? [(s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for c s (when (= c #\_) (set! hit true)))
    hit))

(defn template-chunk! [(c (mut Checker)) (n js/Node)] (-> void)
  (when (or (bad-escape? (.text n)) (template-chunk-octal? (.text n)))
    (report! (mut c) "an invalid escape in a template" n)))

;;; The name at the start of a member chain, or "".
(defn spine-root [(n js/Node)] (-> (slice u8))
  (match (.kind n)
    (js/KIdent [] (.text n))
    (js/KMember [] (spine-root (get (.kids n) 0)))
    (js/KIndex [] (spine-root (get (.kids n) 0)))
    (_ "")))

(defn unparen [(n js/Node)] (-> js/Node)
  (if (= (.kind n) (js/KParen)) (unparen (get (.kids n) 0)) n))

(defn optional-spine? [(n js/Node)] (-> bool)
  (match (.kind n)
    (js/KOptMember [] true)
    (js/KOptIndex [] true)
    (js/KOptCall [] true)
    (js/KMember [] (optional-spine? (get (.kids n) 0)))
    (js/KIndex [] (optional-spine? (get (.kids n) 0)))
    (js/KCallExpr [] (optional-spine? (get (.kids n) 0)))
    (_ false)))

(defn strict-ctx [(x Ctx)] (-> Ctx)
  (let [(mut o) x]
    (set! (.strict o) true)
    o))

(defn nested [(x Ctx)] (-> Ctx)
  (let [(mut o) x]
    (set! (.top-level o) false)
    o))

(defn append-str [(xs (ArrayList (slice u8))) (s (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (strs)]
    (for x xs (push! (mut out) x))
    (push! (mut out) s)
    out))

(defn is-loop-through-labels? [(s js/Node)] (-> bool)
  (match (.kind s)
    (js/KFor [] true) (js/KForIn [] true) (js/KForOf [] true) (js/KWhile [] true) (js/KDoWhile [] true)
    (js/KLabeled [] (is-loop-through-labels? (get (.kids s) 1)))
    (_ false)))

(defn member! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (if (= (.kind (get (.kids n) 0)) (js/KSuper))
      (do
        (unless (.allow-super-prop x)
          (report! (mut c) "super is only valid in a method" n))
        (walk! (mut c) x (get (.kids n) 1)))
      (walk-kids! (mut c) x n)))

(defn class-heritage! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (let [h (get (.kids n) 1) strict (strict-ctx (nested x))]
    (unless (= (.kind h) (js/KNone)) (walk! (mut c) strict (get (.kids h) 0)))
    (class-body! (mut c) x n h (get (.kids n) 2))))

(defn fn-node! [(c (mut Checker)) (x Ctx) (n js/Node) (is-gen bool) (is-async bool)] (-> void)
  (check-function! (mut c) x n (get (.kids n) 0) (get (.kids n) 1) (get (.kids n) 2) is-gen is-async false false false))

;;; A function expression's own name is checked in the function's own context.
(defn fn-expr-node! [(c (mut Checker)) (x Ctx) (n js/Node) (is-gen bool) (is-async bool)] (-> void)
  (let [(mut named) x]
    (set! (.in-generator named) is-gen)
    (set! (.in-async named) is-async)
    (check-function! (mut c) named n (get (.kids n) 0) (get (.kids n) 1) (get (.kids n) 2) is-gen is-async false false false)))

;;; A `for` head's declarations: their names must not collide with the body's.
(defn for-init! [(c (mut Checker)) (x Ctx) (init js/Node) (body js/Node)] (-> void)
  (match (.kind init)
    (js/KNone [] 0)
    (js/KVarInit [] (check-decl-list! (mut c) x (get (.kids init) 0) false false))
    (js/KLetInit []
      (check-decl-list! (mut c) x (get (.kids init) 0) false true)
      (head-collision! (mut c) init body))
    (js/KConstInit []
      (check-decl-list! (mut c) x (get (.kids init) 0) true true)
      (head-collision! (mut c) init body))
    (_ (walk! (mut c) x init))))

(defn head-collision! [(c (mut Checker)) (head js/Node) (body js/Node)] (-> void)
  (let [(mut names) (strs) (mut vars) (strs)]
    (binds! head (mut names))
    (when (duplicates? names) (report! (mut c) "a name is bound twice in one pattern" head))
    (var-names! body (mut vars))
    (for n names
      (when (has? vars n) (report! (mut c) "a var in the body collides with the loop's binding" head))
      (when (= n "let") (report! (mut c) "let cannot be the name of a lexical binding" head)))))

(defn for-left! [(c (mut Checker)) (x Ctx) (left js/Node) (body js/Node) (is-in bool)] (-> void)
  (match (.kind left)
    (js/KVarLeft [] (walk-kids! (mut c) x left))
    (js/KVarLeftInit []
      (when (or (.strict x) (not is-in) (!= (.kind (get (.kids left) 0)) (js/KBindName)))
        (report! (mut c) "this for-in head cannot have an initial value" left))
      (walk-kids! (mut c) x left))
    (js/KLetLeft [] (walk-kids! (mut c) x left) (head-collision! (mut c) left body))
    (js/KConstLeft [] (walk-kids! (mut c) x left) (head-collision! (mut c) left body))
    (_ (check-target! (mut c) x left true))))

(defn module-item! [(c (mut Checker)) (x Ctx) (n js/Node)] (-> void)
  (unless (.top-level x)
    (report! (mut c) "import and export are only valid at the top level" n))
  (unless (.module x)
    (report! (mut c) "import and export are only valid in a module" n)))

;;; The names a module exports, for spotting one exported twice.
(defn exported-names! [(s js/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind s)
    (js/KExportNamed []
      (for spec (.kids (get (.kids s) 0)) (export-spec-name! spec (mut out))))
    (js/KExportFrom []
      (for spec (.kids (get (.kids s) 0)) (export-spec-name! spec (mut out))))
    (js/KExportAllAs [] (push! (mut out) (spec-text (get (.kids s) 0))))
    (js/KExportDefault [] (push! (mut out) "default"))
    (js/KExportDefaultDecl [] (push! (mut out) "default"))
    (js/KExportVar [] (binds! s (mut out)))
    (js/KExportLexical [] (binds! (get (.kids s) 0) (mut out)))
    (js/KExportFunction [] (push! (mut out) (.text (get (.kids (get (.kids s) 0)) 0))))
    (js/KExportClass [] (push! (mut out) (.text (get (.kids (get (.kids s) 0)) 0))))
    (_ 0)))

(defn spec-text [(n js/Node)] (-> (slice u8))
  (if (= (.kind n) (js/KStr)) (rt/str-content (.text n)) (unescaped-name (.text n))))

(defn export-spec-name! [(spec js/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (push! (mut out)
         (spec-text (if (= (.kind spec) (js/KExportAs)) (get (.kids spec) 1) (get (.kids spec) 0)))))

(defn program-has-module-syntax? [(tree js/Node)] (-> bool)
  (let [(mut hit) false]
    (for s (.kids (get (.kids tree) 1))
      (match (.kind s)
        (js/KImport [] (set! hit true))
        (js/KImportBare [] (set! hit true))
        (js/KExportAll [] (set! hit true))
        (js/KExportAllAs [] (set! hit true))
        (js/KExportFrom [] (set! hit true))
        (js/KExportNamed [] (set! hit true))
        (js/KExportDefault [] (set! hit true))
        (js/KExportDefaultDecl [] (set! hit true))
        (js/KExportVar [] (set! hit true))
        (js/KExportLexical [] (set! hit true))
        (js/KExportFunction [] (set! hit true))
        (js/KExportClass [] (set! hit true))
        (_ 0)))
    hit))

;;; Every name a module declares at its top level.
(defn module-names [(stmts (ArrayList js/Node))] (-> (ArrayList (slice u8)))
  (let [(mut names) (strs) (mut functions) (strs)]
    (for s stmts
      (lexical-of! s false (mut names) (mut functions))
      (var-names! s (mut names))
      (match (.kind s)
        (js/KImport [] (binds! s (mut names)))
        (js/KFuncDecl [] (push! (mut names) (.text (get (.kids s) 0))))
        (js/KExportFunction [] (push! (mut names) (.text (get (.kids (get (.kids s) 0)) 0))))
        (_ 0)))
    (for f functions (push! (mut names) f))
    names))

;;; The first early error in a program. `module` is whether it is an ES module, which
;;; the bundler decides from its syntax. `allow-top-return` is for CommonJS, whose top
;;; level is a function body.
(defn check [(tree js/Node) (module bool) (allow-top-return bool)] (-> (Option Problem))
  (let [stmts (.kids (get (.kids tree) 1))
        (mut c) (Checker :problem (None [Problem]))
        x (Ctx :strict (or module (has-use-strict? stmts))
               :module module
               :in-function false :in-generator false :in-async module
               :in-loop false :in-switch false
               :labels (strs) :loop-labels (strs)
               :allow-new-target false :allow-super-prop false :allow-super-call false
               :allow-top-return allow-top-return
               :top-level true
               :exportable (module-names stmts))]
    (when module
      (let [(mut names) (strs)]
        (for s stmts (exported-names! s (mut names)))
        (when (duplicates? names)
          (report! (mut c) "a name is exported twice" tree))))
    (walk! (mut c) x tree)
    (.problem c)))
