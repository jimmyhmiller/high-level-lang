;;; The `.scopes` grammar as ordinary compile-time Coil: see facts.coil beside it.
(module hl.grammars.scopes)
(import "coil.primitive" :as primitive)
(import "hl.syntax" :as syntax)
(import "coil.alloc" :use [malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(defn generate [] (-> Code)
  (primitive/code-read
    (syntax/read-grammar (include-str "scopes.syntax") "src/hl/grammars/scopes.syntax")
    `(reader-config)))
(generate)
