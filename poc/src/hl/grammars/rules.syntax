# The `.rules` language, in the grammar language.
syntax
start File
space Space
word NameChar
precedence AssignLevel Binary NotLevel IsLevel Unary Postfix Primary ;


fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-?!] ;
fragment Keyword = ("let" | "var" | "if" | "then" | "else" | "match" | "for" | "in" | "is" | "while"
                  | "return" | "with" | "and" | "or" | "not" | "true" | "false" | "none" | "some"
                  | "panic" | "print" | "assert" | "mut" | "Fn") !NameChar ;
token Name = !Keyword [a-z_] NameChar* ;
token Upper = !Keyword [A-Z] [a-zA-Z0-9_\-]* ;
token QName = !Keyword [a-z_] [a-zA-Z0-9_\-]* ("." [a-z_] [a-zA-Z0-9_\-]*)* ;
token Qvar = "?" [a-z_] NameChar* ;
token Rest = !Keyword [a-z_] NameChar* "..." ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Int = [0-9]+ ;
token Char = "'" ("\\" . | [^'\\]) "'" ;
token Tmpl = [a-z] [a-z0-9\-]* "`" ("\\" . | [^`\\])* "`" ;

rule File = "rules" QName ("over" QName)? Decl* -> File
          | "attrs" QName "over" QName Decl* -> AttrsFile ;
rule Decl
  = "use" QName "as" Name -> Use
  | "foreign" QName "as" Name "{" ForeignItem* "}" -> Foreign
  | "record" Upper "{" Field,* "}" -> Record
  | "enum" Upper "{" Upper,* "}" -> Enum
  | "state" Name ":" Type "=" Expr -> State
  | "task" "state" Name ":" Type "=" Expr -> TaskState
  | "context" Name ":" Type "=" Expr -> Context
  | "const" Name ":" Type "=" Expr -> Const
  | "quote" Name "at" Int* ";" -> QuoteDecl
  | "fn" Name "(" Param,* ")" ("->" Type)? FnBody -> Fn
  | "everywhere" "fn" Name "(" Param,* ")" ("->" Type)? FnBody -> EverywhereFn
  | "memo" "fn" Name "(" Param,* ")" ("->" Type)? FnBody -> MemoFn
  | "main" Name BigStack? -> MainDecl
  | "inh" Name ":" Type "=" Expr -> Inh
  | "given" Name ":" Type "=" Expr -> Given
  | "input" Name ":" Type -> Input
  | "collect" Name ":" Type -> Collect
  | "on" PatAs Block -> On
  | "rewrite" PatAs ("if" Expr)? "=>" Expr -> Rewrite
  | "include" QName -> Include
  ;
rule BigStack = "on" "big" "stack" -> BigStack ;
rule FnBody = "=" Expr | Block ;
rule ForeignItem
  = "type" Upper -> FType
  | "record" Upper "{" Field,* "}" -> FRecord
  | "fn" Name ("=" Name)? "(" Param,* ")" ("->" Type)? -> FFn
  ;
rule Field = Name ":" Type -> Field ;
rule Param = Name ":" Type -> Param ;

suffix Type over TypeAtom "?" -> TOpt ;
rule TypeAtom
  = "[" Type "]" -> TList
  | "{" Type ":" Type "}" -> TMap
  | "Fn" "(" Type,* ")" "->" Type -> TFn
  | "mut" Type -> TMut
  | Name "." Upper -> TQual
  | Upper
  ;

rule Block = "{" Stmt* "}" -> Block ;
rule Stmt
  = "let" Name (":" Type)? "=" Expr -> Let
  | "var" Name (":" Type)? "=" Expr -> Var
  | "for" Head Block -> For
  | "while" Expr Block -> While
  | "assert" Postfix -> Assert
  | "with" Init,+ Block -> WithCtx
  | "print" Str CommaExpr* -> Print
  | AssignLevel
  ;
# One parse of the left side: trying each form from scratch would multiply work by nesting.
suffix AssignLevel over Expr
  "=" Expr -> Assign
  | "+=" Expr -> Append
  | "++=" Expr -> Extend
  ;
rule CommaExpr = "," Expr ;
rule Init = Name "=" Expr -> Init ;
rule Head
  = Name "in" Expr ".." Expr -> RangeHead
  | Name "in" Expr ".." -> FromHead
  | Name "in" Expr -> InHead
  | PatAs "in" Expr -> PatHead
  | Postfix -> QueryHead
  ;

memo rule Expr = Binary ;
rule FieldInit = Name ":" Expr -> FieldInit ;
infix Binary over NotLevel
  left "??" Default
  left "or" Or
  left "and" And
  left "==" Eq "!=" Ne "<=" Le ">=" Ge "<" Lt ">" Gt "in" In
  left "++" Concat "+" Add "-" Sub
  left "*" Mul "/" Div "%" Mod
  ;
rule NotLevel = "not" NotLevel -> Not | IsLevel ;
suffix IsLevel over Unary
  "is" PatAs -> IsE
  | "with" "{" FieldInit,* "}" -> WithE
  ;
rule Unary = "-" Unary -> Neg | Postfix ;
postfix Postfix over Primary
  "." Upper -> Member
  | "." Name -> FieldE
  | @nonl "(" Arg,* ")" -> Call
  | @nonl "[" Expr ".." Expr "]" -> Slice
  | @nonl "[" Expr "]" -> Index
  ;
rule Arg = Name ":" Expr -> Named | Rest | Expr "..." -> Spread | Expr ;
rule Primary
  = Int | Str | Char | Tmpl
  | "panic" Str CommaExpr* -> Panic
  | "return" (@nonl Expr)? -> Return
  | "true" -> True
  | "false" -> False
  | "none" -> NoneE
  | "some" "(" Expr ")" -> SomeE
  | Upper "(" Arg,* ")" -> Ctor
  | "all" Head ":" Expr -> All
  | "any" Head ":" Expr -> Any
  | "first" Head ":" Expr -> First
  | "count" Head ":" Expr -> Count
  | "sum" Head ":" Expr -> Sum
  | "fold" Name "=" Expr Clause+ ":" Expr -> Fold
  | "sort" Name "in" Expr "by" Expr Desc? -> Sort
  | Upper
  | Qvar
  | Name
  | "(" Expr ")" -> Group
  | "[" Expr Clause+ "]" -> Comp
  | "[" Expr "..." Clause+ "]" -> CompSpread
  | "{" Expr ":" Expr Clause+ "}" -> MapComp
  | "[" Arg,* "]" -> ListLit
  | "if" "let" PatAs "=" Expr Block ("else" Else)? -> IfLet
  | "if" Expr Then ("else" Else)? -> If
  | "match" Expr "{" Arm* "}" -> Match
  | Block
  ;
rule Then = "then" Stmt | Block ;
rule Else = Stmt ;
rule Desc = "desc" -> Desc ;
# What a comprehension takes, in order: loops, tests, and patterns one value must match. `while`
# ends the loop before it at the first item that fails; `distinct` lets each key through once.
rule Clause = "for" Head | "if" "let" PatAs "=" Expr -> LetClause | "if" Expr -> IfClause
            | "while" Expr -> WhileClause | "distinct" Expr -> DistinctClause ;
rule Arm = PatAs ("if" Expr)? "=>" Stmt -> Arm ;

suffix PatAs over Pat "as" Name -> PAs ;
suffix Pat over PatAtom BarPat+ -> POr ;
rule BarPat = "|" PatAtom ;
rule PatAtom
  = "some" "(" PatAs ")" -> PSome
  | "none" -> PNone
  | "true" -> PTrue
  | "false" -> PFalse
  | Int | Str | Char
  | Upper "(" PatArg,* ")" -> PNode
  | Name "." Upper "(" PatArg,* ")" -> PNodeQ
  | Name "." Upper -> PEnumQ
  | Upper
  | Name
  ;
rule PatArg = "..." -> PAny | Rest | PatAs ;
