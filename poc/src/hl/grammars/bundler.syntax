# The `.bundler` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-./] ;
fragment Keyword = ("bundler" | "use" | "target" | "end" | "entry" | "outfile" | "format"
                  | "global" | "define" | "main-fields" | "conditions" | "minify" | "pretty"
                  | "transform" | "optimize" | "sourcemap" | "platform" | "external"
                  | "alias" | "loader" | "banner" | "footer" | "tree-shaking" | "on-resolve"
                  | "on-load" | "prefix" | "suffix" | "exports" | "names" | "hoist-externals" | "jsx" | "jsx-factory"
                  | "jsx-fragment" | "jsx-import-source" | "jsx-dev" | "language") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Num = [0-9]+ ;

rule File = "bundler" Use* FormatDef* Target* -> File ;
rule Use = "use" Name Name "=" Name -> Use ;

# An output format is something a spec can say, not a list the bundler knows.
rule FormatDef = "format" Name FormatPart* "end" -> FormatDef ;
rule FormatPart
  = "prefix" Str -> Prefix
  | "suffix" Str -> Suffix
  | "exports" Str -> ExportsVia
  | "exports" "names" -> ExportsNames
  | "hoist-externals" -> HoistExternals
  ;

rule Target = "target" Name Setting* "end" -> Target ;
rule Setting
  = "entry" Str -> Entry
  | "outfile" Str -> Outfile
  | "format" Name -> Format
  | "global" Str -> Global
  | "define" Name "=" Value -> Define
  | "main-fields" Name* -> MainFields
  | "conditions" Name* -> Conditions
  | "minify" Name* -> Minify
  | "pretty" -> Pretty
  | "sourcemap" -> Sourcemap
  | "platform" Name -> Platform
  | "external" Name* -> External
  | "alias" Str "=" Str -> Alias
  | "loader" Str "=" Name -> Loader
  | "banner" Str -> Banner
  | "footer" Str -> Footer
  | "tree-shaking" Name -> TreeShaking
  | "jsx" Name -> Jsx
  | "jsx-factory" Str -> JsxFactory
  | "jsx-fragment" Str -> JsxFragment
  | "jsx-import-source" Str -> JsxImportSource
  | "jsx-dev" -> JsxDev
  | "language" Name -> SyntaxTarget
  | "on-resolve" Name* -> OnResolve
  | "on-load" Name* -> OnLoad
  | "transform" Name* -> Transform
  | "optimize" Name* -> Optimize
  ;
rule Value = Str | Num | Name ;
