# The `.rewrite` language, in the grammar language.
syntax
start File
space Space
word NameChar
precedence Arith RhsAtom ;

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-.] ;
token Name = [a-zA-Z_] NameChar* ;
token Rest = [a-zA-Z_] [a-zA-Z0-9_\-]* "..." ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Num = [0-9]+ ;

rule File = "rewrite" Name ("host" Name)? ("leaves" Name* ";")? RuleDef* -> File ;
rule RuleDef = "rule" Name ":" Pat ("as" Name)? ("when" Guard,+)? "=>" Rhs ";" -> RuleDef ;

rule Guard = "!" "@" Name "(" Name,* ")" -> NotGuard | "@" Name "(" Name,* ")" -> Guard ;

rule Pat = Name "(" PatArg,* ")" -> PNode | Name ;
rule PatArg = Rest | Str | Pat ;

rule Rhs
  = "@" Name "(" Name,* ")" -> HostCall
  | Name "(" RhsArg,* ")" -> RNode
  | Name
  ;
rule RhsArg = Rest | Arith ;
infix Arith over RhsAtom
  left "++" Concat
  left "+" Plus "-" Minus
  left "*" Times
  ;
rule RhsAtom = Rhs | Num | Str | "(" Arith ")" -> Group ;
