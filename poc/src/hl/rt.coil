;;; Runtime shared by everything the DSLs generate. It is ordinary Coil and also
;;; runs inside the readers at compile time: the same tokenizer reads the DSL
;;; files and the JavaScript. Nothing here touches Code.
;;;
;;; Allocation: a bundler build is one short batch process, so trees and strings
;;; live until exit, on malloc.
(module hl.rt)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as str)
(import "coil.fs" :as fs)

;; ---------------------------------------------------------------- tokens

(defsum TokKind (TIdent) (TNum) (TStr) (TClass) (TPunct) (TEof))

(derive Eq Debug TokKind)

(defstruct Tok [(kind TokKind) (text (slice u8)) (line i64) (col i64)])

(defstruct LexFail [(msg (slice u8)) (line i64) (col i64)])

;;; `dsl-names` lets a name also contain `- . /`, for names like `fold-add`.
;;; `classes` reads `[a-z]` as one token, for grammars.
(defstruct LexConfig
  [(comment (slice u8)) (puncts (ArrayList (slice u8))) (dsl-names bool) (classes bool)])

(defn digit? [(c u8)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn name-start? [(c u8)] (-> bool)
  (or (and (>= c #\a) (<= c #\z))
      (and (>= c #\A) (<= c #\Z))
      (= c #\_)
      (= c #\$)))

(defn name-char? [(c u8)] (-> bool)
  (or (name-start? c) (digit? c)))

(defn dsl-name-char? [(c u8)] (-> bool)
  (or (name-char? c) (= c #\-) (= c #\.) (= c #\/)))

(defn at? [(src (slice u8)) (i i64) (s (slice u8))] (-> bool)
  (and (<= (+ i (len s)) (len src)) (= (subslice src i (+ i (len s))) s)))

;;; Tokenize. Punctuation is tried in the order given, so list longer ones first.
(defn lex [(src (slice u8)) (cfg LexConfig)]
  (-> (Result (ArrayList Tok) LexFail))
  (block
    :out
      (let [(mut toks) (ArrayList::new [Tok] (malloc-allocator))
            n (len src)
            (mut i) 0
            (mut line) 1
            (mut line-start) 0]
        (while (< i n)
          (let [c (get src i)
                col (+ (- i line-start) 1)]
            (cond (= c #\newline)
                    (do
                      (set! i (+ i 1))
                      (set! line (+ line 1))
                      (set! line-start i))
                  (or (= c #\space) (= c #\tab) (= c #\return)) (set! i (+ i 1))
                  (at? src i (.comment cfg))
                    (while (and (< i n) (!= (get src i) #\newline))
                      (set! i (+ i 1)))
                  (name-start? c)
                    (let [start i]
                      (while (and (< i n)
                                  (if (.dsl-names cfg)
                                      (dsl-name-char? (get src i))
                                      (name-char? (get src i))))
                        (set! i (+ i 1)))
                      (push! (mut toks)
                             (Tok
                               :kind (TIdent)
                               :text (subslice src start i)
                               :line line
                               :col col)))
                  (digit? c)
                    (let [start i]
                      (while (and (< i n) (digit? (get src i)))
                        (set! i (+ i 1)))
                      (when (and (< i n)
                                 (or (= (get src i) #\.)
                                     (name-start? (get src i))))
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "the PoC reads integer literals only"
                                   :line line
                                   :col col))))
                      (push! (mut toks)
                             (Tok
                               :kind (TNum)
                               :text (subslice src start i)
                               :line line
                               :col col)))
                  (and (.classes cfg) (= c #\[))
              (let [start (+ i 1)]
                (set! i start)
                (while (and (< i n) (!= (get src i) #\]))
                  (when (= (get src i) #\newline)
                    (return-from :out
                      (Err (LexFail :msg "unterminated character class" :line line :col col))))
                  (set! i (+ i (if (= (get src i) #\\) 2 1))))
                (when (>= i n)
                  (return-from :out
                    (Err (LexFail :msg "unterminated character class" :line line :col col))))
                (push! (mut toks)
                       (Tok :kind (TClass) :text (subslice src start i) :line line :col col))
                (set! i (+ i 1)))
            (= c #\")
                    (let [start (+ i 1)]
                      (set! i start)
                      (while (and (< i n) (!= (get src i) #\"))
                        (when (= (get src i) #\newline)
                          (return-from
                            :out
                              (Err (LexFail
                                     :msg "unterminated string"
                                     :line line
                                     :col col))))
                        (set! i (+ i (if (= (get src i) #\\) 2 1))))
                      (when (>= i n)
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "unterminated string"
                                   :line line
                                   :col col))))
                      (push! (mut toks)
                             (Tok
                               :kind (TStr)
                               :text (subslice src start i)
                               :line line
                               :col col))
                      (set! i (+ i 1)))
                  :else
                    (let [(mut hit) -1]
                      (for k (range 0 (len (.puncts cfg)))
                        (when (and (< hit 0) (at? src i (get (.puncts cfg) k)))
                          (set! hit k)))
                      (when (< hit 0)
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "unexpected character"
                                   :line line
                                   :col col))))
                      (let [p (get (.puncts cfg) hit)]
                        (push! (mut toks)
                               (Tok
                                 :kind (TPunct)
                                 :text p
                                 :line line
                                 :col col))
                        (set! i (+ i (len p))))))))
        (push! (mut toks)
               (Tok
                 :kind (TEof)
                 :text "end of input"
                 :line line
                 :col (+ (- i line-start) 1)))
        (Ok toks))))

;; ---------------------------------------------------------------- parser state

;;; One memo table entry: did the rule match here, where did it end, and its node
;;; as an address, because this module does not know the grammar's node type.
(defstruct MemoHit [(ok bool) (end i64) (node i64)])

;;; Generated parsers work directly on bytes. `pos` is always just past the last
;;; token with whitespace unskipped, so `@nl` can see what lies before the next
;;; token. `ws-*` caches the most recent skip, and `far`/`want` keep the farthest
;;; failure, the one worth reporting from a backtracking parser.
(defstruct P
  [(src (slice u8))
   (path (slice u8))
   (pos i64)
   (flags i64)
   (ws-from i64)
   (ws-to i64)
   (ws-nl bool)
   (far i64)
   (want (slice u8))
   (memos (ArrayList (HashMap i64 MemoHit)))])

(defstruct ParseError [(path (slice u8)) (line i64) (col i64) (want (slice u8)) (found (slice u8))])

(defn p-new [(src (slice u8)) (path (slice u8)) (flags i64) (memo-count i64)] (-> P)
  (let [(mut memos) (ArrayList::new [(HashMap i64 MemoHit)] (malloc-allocator))]
    (for _ (range 0 memo-count)
      (push! (mut memos) (HashMap::new-scalar [i64 MemoHit] (malloc-allocator))))
    (P :src src :path path :pos 0 :flags flags :ws-from -1 :ws-to 0 :ws-nl false
       :far 0 :want "a program" :memos memos)))

(defn peek [(p (mut P))] (-> i64)
  (if (< (.pos p) (len (.src p))) (cast i64 (get (.src p) (.pos p))) -1))

(defn advance! [(p (mut P)) (n i64)] (-> void)
  (set! (.pos p) (+ (.pos p) n)))

(defn at-bytes? [(p (mut P)) (s (slice u8))] (-> bool)
  (at? (.src p) (.pos p) s))

(defn eof? [(p (mut P))] (-> bool) (>= (.pos p) (len (.src p))))

(defn span [(p (mut P)) (lo i64) (hi i64)] (-> (slice u8)) (subslice (.src p) lo hi))

(defn note-fail! [(p (mut P)) (want (slice u8))] (-> void)
  (when (> (.pos p) (.far p))
    (set! (.far p) (.pos p))
    (set! (.want p) want)))

;;; Does this span cross an ECMAScript line terminator?
(defn has-newline? [(src (slice u8)) (from i64) (to i64)] (-> bool)
  (let [(mut hit) false (mut i) from]
    (while (and (< i to) (not hit))
      (let [c (get src i)]
        (when (or (= c #\newline) (= c #\return)
                  (and (= c (: 226 u8)) (< (+ i 2) to)
                       (= (get src (+ i 1)) (: 128 u8))
                       (or (= (get src (+ i 2)) (: 168 u8)) (= (get src (+ i 2)) (: 169 u8)))))
          (set! hit true)))
      (set! i (+ i 1)))
    hit))

(defn apply-flags [(flags i64) (on i64) (off i64)] (-> i64)
  (| (& flags (- -1 off)) on))

(defn flag? [(p (mut P)) (bit i64)] (-> bool) (!= (& (.flags p) bit) 0))

(defn memo-key [(p (mut P))] (-> i64) (+ (* (.pos p) 16) (.flags p)))

(defn memo-get [(p (mut P)) (id i64) (key i64)] (-> (Option MemoHit))
  (get (get (.memos p) id) key))

(defn memo-put! [(p (mut P)) (id i64) (key i64) (hit MemoHit)] (-> void)
  (set! (mut (elem (mut (.memos p)) id)) key hit))

;;; Where a byte offset falls, for messages.
(defn line-col [(src (slice u8)) (at i64)] (-> Pos)
  (let [(mut line) 1 (mut col) 1]
    (for i (range 0 (if (< at (len src)) at (len src)))
      (if (= (get src i) #\newline)
          (do (set! line (+ line 1)) (set! col 1))
          (set! col (+ col 1))))
    (Pos :line line :col col)))

(defstruct Pos [(line i64) (col i64)])

(defn parse-error [(p (mut P))] (-> ParseError)
  (let [at (line-col (.src p) (.far p))
        n (len (.src p))
        end (if (< (+ (.far p) 20) n) (+ (.far p) 20) n)]
    (ParseError :path (.path p) :line (.line at) :col (.col at) :want (.want p)
                :found (if (>= (.far p) n) "end of input" (subslice (.src p) (.far p) end)))))

(defn parse-failed [(e ParseError)] (-> never)
  (panic "{}:{}:{}: expected {}, found: {}" (.path e) (.line e) (.col e) (.want e) (.found e)))

;; ---------------------------------------------------------------- printer

;;; `keep` counts enclosing positions where parentheses must stay as written, and
;;; `pending` holds a `;` that a following `}` makes unnecessary.
(defstruct W [(buf (ArrayList u8)) (pretty bool) (pending bool) (keep i64) (after-int bool)])

(defn w-new [(pretty bool)] (-> W)
  (W :buf (ArrayList::new [u8] (malloc-allocator)) :pretty pretty :pending false :keep 0
     :after-int false))

(defn printed-name-char? [(c u8)] (-> bool)
  (or (name-char? c) (>= c (: 128 u8)) (= c #\\)))

;;; Two tokens that would read differently run together get a space between them.
(defn must-separate? [(a u8) (next (slice u8))] (-> bool)
  (let [b (get next 0)]
    (or (and (printed-name-char? a) (printed-name-char? b))
        (and (= a #\+) (= b #\+))
        (and (= a #\-) (= b #\-))
        (and (= a #\/) (= b #\/))
        (and (= a #\<) (= b #\!)))))

(defn all-digits? [(s (slice u8))] (-> bool)
  (let [(mut ok) (> (len s) 0)]
    (for c s (unless (digit? c) (set! ok false)))
    ok))

(defn w-bytes! [(w (mut W)) (s (slice u8))] (-> void)
  (for c s (push! (mut (.buf w)) c)))

(defn flush-semi! [(w (mut W))] (-> void)
  (when (.pending w)
    (set! (.pending w) false)
    (push! (mut (.buf w)) #\;)
    (when (.pretty w) (push! (mut (.buf w)) #\newline))))

;;; Write one token. Pretty output breaks lines after `; { }`; compact never does.
(defn tok! [(w (mut W)) (s (slice u8))] (-> void)
  (when (> (len s) 0)
    (if (and (.pending w) (= s "}"))
        (set! (.pending w) false)
        (flush-semi! (mut w)))
    (let [n (len (.buf w))]
      (when (and (> n 0)
                 (or (must-separate? (get (.buf w) (- n 1)) s)
                     (and (.after-int w) (= (get s 0) #\.))))
        (push! (mut (.buf w)) #\space)))
    (w-bytes! (mut w) s)
    (set! (.after-int w) (all-digits? s))
    (when (and (.pretty w) (or (= s ";") (= s "{") (= s "}")))
      (push! (mut (.buf w)) #\newline))))

;;; A `;` the language allows us to drop before `}`.
(defn soft-semi! [(w (mut W))] (-> void)
  (flush-semi! (mut w))
  (set! (.pending w) true))

;;; Remember where the next token will land, for a later `w-wrap!`.
(defn w-mark! [(w (mut W))] (-> i64)
  (flush-semi! (mut w))
  (len (.buf w)))

(defn skip-printed-space [(w (mut W)) (from i64)] (-> i64)
  (let [(mut i) from]
    (while (and (< i (len (.buf w))) (= (get (.buf w) i) #\space)) (set! i (+ i 1)))
    i))

;;; Did what was printed since `mark` begin with this punctuation?
(defn w-starts? [(w (mut W)) (mark i64) (s (slice u8))] (-> bool)
  (at? (slice (.buf w)) (skip-printed-space (mut w) mark) s))

;;; Did it begin with this word?
(defn w-starts-word? [(w (mut W)) (mark i64) (s (slice u8))] (-> bool)
  (let [i (skip-printed-space (mut w) mark)
        end (+ i (len s))]
    (and (at? (slice (.buf w)) i s)
         (or (>= end (len (.buf w)))
             (not (printed-name-char? (get (.buf w) end)))))))

;;; Parenthesise everything printed since `mark`.
(defn w-wrap! [(w (mut W)) (mark i64) (open (slice u8)) (close (slice u8))] (-> void)
  (flush-semi! (mut w))
  (let [at (skip-printed-space (mut w) mark)
        tail (ArrayList::new [u8] (malloc-allocator))
        (mut saved) tail]
    (for i (range at (len (.buf w))) (push! (mut saved) (get (.buf w) i)))
    (while (> (len (.buf w)) at) (pop! (mut (.buf w))))
    (w-bytes! (mut w) open)
    (w-bytes! (mut w) (slice saved))
    (w-bytes! (mut w) close)
    (set! (.after-int w) false)))

(defn w-finish [(w W)] (-> (slice u8)) (slice (.buf w)))

;; ---------------------------------------------------------------- integers

;;; JavaScript numbers are doubles, so folding is exact only below 2^53. Every
;;; helper answers None outside [0, 2^53), and a rule then simply does not fire.
(const SAFE-LIMIT 9007199254740992)

;;; A leading zero is a legacy octal literal in sloppy JavaScript, so `010` is 8
;;; there. Those answer None and stay unfolded rather than folding as decimal.
(defn parse-num [(s (slice u8))] (-> (Option i64))
  (let [(mut v) 0
        (mut ok) (and (> (len s) 0) (or (= (len s) 1) (!= (get s 0) #\0)))]
    (for c s
      (when ok
        (if (and (digit? c) (<= v (/ (- SAFE-LIMIT 10) 10)))
            (set! v (+ (* v 10) (- (cast i64 c) 48)))
            (set! ok false))))
    (if ok (Some v) (None [i64]))))

(defn safe [(v i64)] (-> (Option i64))
  (if (and (>= v 0) (< v SAFE-LIMIT)) (Some v) (None [i64])))

(defn num-add [(a (Option i64)) (b (Option i64))] (-> (Option i64))
  (match a
    (None [] (None [i64]))
    (Some [x] (match b (None [] (None [i64])) (Some [y] (safe (+ x y)))))))

(defn num-sub [(a (Option i64)) (b (Option i64))] (-> (Option i64))
  (match a
    (None [] (None [i64]))
    (Some [x] (match b (None [] (None [i64])) (Some [y] (safe (- x y)))))))

(defn num-mul [(a (Option i64)) (b (Option i64))] (-> (Option i64))
  (match a
    (None [] (None [i64]))
    (Some [x]
          (match b
            (None [] (None [i64]))
            (Some [y]
                  (if (and (> x 0) (> y (/ (- SAFE-LIMIT 1) x)))
                      (None [i64])
                      (safe (* x y))))))))

(defn num-text [(v i64)] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (push-i64! (mut b) v)
    (finish! (mut b))))

;; ---------------------------------------------------------------- relations

;;; A binary relation over interned ids. A unary relation stores 0 in `b`.
(defstruct Row [(a i64) (b i64)])

(defstruct Rel [(rows (ArrayList Row)) (seen (HashMap i64 bool))])

(defn rel-new [] (-> Rel)
  (Rel
    :rows (ArrayList::new [Row] (malloc-allocator))
    :seen (HashMap::new-scalar [i64 bool] (malloc-allocator))))

(const MAX-ID 2147483648)

(defn row-key [(a i64) (b i64)] (-> i64)
  (when (or (< a 0) (>= a MAX-ID) (< b 0) (>= b MAX-ID))
    (panic "relation id out of range: {} {}" a b))
  (+ (* a MAX-ID) b))

;;; True when the row is new.
(defn rel-add! [(r (mut Rel)) (a i64) (b i64)] (-> bool)
  (let [key (row-key a b)]
    (match (get (.seen r) key)
      (Some [_] false)
      (None []
            (set! (mut (.seen r)) key true)
            (push! (mut (.rows r)) (Row :a a :b b))
            true))))

(defn rel-has? [(r Rel) (a i64) (b i64)] (-> bool)
  (match (get (.seen r) (row-key a b)) (Some [_] true) (None [] false)))

;;; Strings to the dense ids relations hold.
(defstruct Names [(ids (HashMap (slice u8) i64)) (count i64)])

(defn names-new [] (-> Names)
  (Names
    :ids (HashMap::new [(slice u8) i64] (malloc-allocator) (str/keyops))
    :count 0))

(defn intern! [(ns (mut Names)) (s (slice u8))] (-> i64)
  (match (get (.ids ns) s)
    (Some [id] id)
    (None []
          (let [id (.count ns)]
            (set! (mut (.ids ns)) s id)
            (set! (.count ns) (+ id 1))
            id))))

;; ---------------------------------------------------------------- files

(defn read-all [(path (slice u8))] (-> (slice u8))
  (try (let [bytes
               (try-or! (fs/read-file (malloc-allocator) path)
                        (panic "cannot read {}" path))]
         bytes)))

;;; Directory part of a path, "." when there is none.
(defn dir-of [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (if (< cut 0) "." (subslice path 0 cut))))

(defn write-output [(path (slice u8)) (bytes (slice u8))] (-> void)
  (let [dir (dir-of path)]
    (try (let [there
                 (try-or! (fs/exists? (malloc-allocator) dir)
                          (panic "cannot inspect directory {}" dir))]
           (unless there
             (match (fs/create-dir (malloc-allocator) dir 493)
               (Ok [_] 0)
               (Err [_] (panic "cannot create directory {}" dir)))))))
  (match (fs/write-file (malloc-allocator) path bytes)
    (Ok [_] 0)
    (Err [_] (panic "cannot write {}" path))))

(defn join [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut sb) a)
    (push-str! (mut sb) b)
    (finish! (mut sb))))
