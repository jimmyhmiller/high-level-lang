;;; `.rewrite`: the transformation language. Rules over a grammar's nodes compile to
;;; pattern tests grouped by head node, plus a bottom-up driver.
;;;
;;;   rewrite bundle.js
;;;   host bundle.minhost               # optional: Coil predicates and builders
;;;   leaves Num Str Ident PropName ;   # node kinds that hold text
;;;
;;;   rule fold-add : Add(Num(a), Num(b)) => Num(a + b) ;
;;;   rule if-true  : If(True(), t, _) => t ;
;;;   rule merge    : List(xs..., ExprStmt(a), ExprStmt(b), ys...)
;;;                     => List(xs..., ExprStmt(Seq(a, b)), ys...) ;
;;;   rule unparen  : Paren(x) when !@opaque(x) => x ;
;;;   rule concat   : Add(Str(a), Str(b)) => Str(a ++ b) ;
;;;   rule shorter  : Num(_) as n when @shortens(n) => @shortest(n) ;
;;;
;;; A name binds a child; `_` ignores one; `name...` binds a run of children, at the
;;; ends of a node's arguments. Inside a leaf a name binds its text, or its integer value
;;; for Num, where arithmetic that leaves [0, 2^53) simply makes the rule not fire.
;;; `when` lists guards, `@name(vars)` calls the host, and `!` negates a guard.
(module hl.rewrite)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.grammars.rewrite" :as g)

(reader-provider "hl.rewrite" read-rewrite)

(defsum VarSort (VNode) (VNum) (VText) (VList))
(derive Eq VarSort)
(defstruct Var [(name (slice u8)) (sort VarSort)])

;;; A pattern, flattened to the tests and bindings it performs, in order.
(defsum Step
  (STest [(subject i64) (kind (slice u8)) (arity i64)])
  (SKind [(subject i64) (kind (slice u8))])
  (SKid [(subject i64) (index i64) (out i64)])
  (SScan [(subject i64) (scan i64) (middle i64) (prefix bool) (suffix bool)])
  (SScanKid [(subject i64) (scan i64) (index i64) (out i64)])
  (SPrefix [(subject i64) (scan i64) (name (slice u8))])
  (SSuffix [(subject i64) (scan i64) (middle i64) (name (slice u8))])
  (SVar [(subject i64) (name (slice u8))])
  (SNum [(subject i64) (name (slice u8))])
  (SText [(subject i64) (name (slice u8))])
  (STextEq [(subject i64) (text (slice u8))])
  (SStrEq [(subject i64) (text (slice u8))]))

(defstruct Use [(where (slice u8)) (name (slice u8)) (arity i64)])
;;; A window rule rewrites a run in the middle of a list and leaves the rest alone:
;;; `List(xs..., P, ys...) => List(xs..., R, ys...)`. `width` is P's length, 0 otherwise.
(defstruct Rule [(name (slice u8)) (head (slice u8)) (width i64)])
(defstruct Guard [(negated bool) (name (slice u8)) (args (ArrayList (slice u8)))])

(defstruct Comp
  [(prefix (slice u8))
   (has-host bool)
   (leaves (ArrayList (slice u8)))
   (uses (ArrayList Use))
   (rules (ArrayList Rule))
   (steps (ArrayList Step))
   (vars (ArrayList Var))
   (guards (ArrayList Guard))
   (src (slice u8))
   (next-subject i64)
   (next-scan i64)
   (window-prefix (slice u8))
   (window-suffix (slice u8))
   (window-width i64)])

(defn kind-sym [(n (slice u8))] (-> Code) (primitive/code-symbol "syn/K" n))
(defn subj-sym [(i i64)] (-> Code) (primitive/code-symbol "s" i))
(defn var-sym [(n (slice u8))] (-> Code) (primitive/code-symbol "v-" n))
(defn scan-sym [(i i64)] (-> Code) (primitive/code-symbol "scan" i))
(defn host-sym [(n (slice u8))] (-> Code) (primitive/code-symbol "host/" n))
(defn pfx-sym [(k (mut Comp)) (n (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join2 (.prefix k) n)))
(defn rule-sym [(k (mut Comp)) (i i64)] (-> Code)
  (primitive/code-symbol (dsl/join2 (.prefix k) "rule") i))

;;; A grammar node's position, for messages, and as a located token.
(defn tok-of [(k (mut Comp)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col (.src k) (.lo n))]
    (rt/Tok :kind (rt/TIdent) :text (.text n) :line (.line at) :col (.col at))))

(defn die [(k (mut Comp)) (c (mut dsl/Cur)) (n g/Node) (msg (slice u8))] (-> never)
  (dsl/die (mut c) (tok-of (mut k) n) msg))

(defn where-of [(k (mut Comp)) (c (mut dsl/Cur)) (n g/Node)] (-> (slice u8))
  (let [t (tok-of (mut k) n)
        b (dsl/join3 (.path c) ":" (primitive/int->str (.line t)))]
    (dsl/join3 b ":" (primitive/int->str (.col t)))))

(defn leaf? [(k (mut Comp)) (n (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for l (.leaves k) (when (= l n) (set! hit true)))
    hit))

(defn bind-var! [(k (mut Comp)) (c (mut dsl/Cur)) (t g/Node) (name (slice u8)) (sort VarSort)] (-> void)
  (for v (.vars k)
    (when (= (.name v) name)
      (die (mut k) (mut c) t (dsl/join3 "the variable " name " is bound twice in this pattern"))))
  (push! (mut (.vars k)) (Var :name name :sort sort)))

(defn fresh-subject! [(k (mut Comp))] (-> i64)
  (let [i (.next-subject k)]
    (set! (.next-subject k) (+ i 1))
    i))

;;; `xs...` without its dots.
(defn rest-name [(n g/Node)] (-> (slice u8))
  (subslice (.text n) 0 (- (len (.text n)) 3)))

(defn raw-str [(n g/Node)] (-> (slice u8))
  (subslice (.text n) 1 (- (len (.text n)) 1)))

(defn pat-leaf! [(k (mut Comp)) (c (mut dsl/Cur)) (kind (slice u8)) (subject i64) (arg g/Node)] (-> void)
  (cond
    (= (.kind arg) (g/KStr))
      (push! (mut (.steps k))
             (if (= kind "Str")
                 (SStrEq :subject subject :text (raw-str arg))
                 (STextEq :subject subject :text (raw-str arg))))
    (= (.kind arg) (g/KName))
      (unless (= (.text arg) "_")
        (if (= kind "Num")
            (do
              (bind-var! (mut k) (mut c) arg (.text arg) (VNum))
              (push! (mut (.steps k)) (SNum :subject subject :name (.text arg))))
            (do
              (bind-var! (mut k) (mut c) arg (.text arg) (VText))
              (push! (mut (.steps k)) (SText :subject subject :name (.text arg))))))
    :else (die (mut k) (mut c) arg "a leaf's pattern is a name, _ or a string")))

;;; The children of a node pattern. With a rest they are found by scanning.
(defn pat-kids! [(k (mut Comp)) (c (mut dsl/Cur)) (t g/Node) (args (ArrayList g/Node)) (subject i64) (test-at i64)] (-> void)
  (let [(mut count) 0
        (mut prefix) ""
        (mut suffix) ""
        (mut has-rest) false
        (mut scan) -1
        (mut scan-at) -1]
    (for arg args
      (if (= (.kind arg) (g/KRest))
          (let [name (rest-name arg)]
            (bind-var! (mut k) (mut c) arg name (VList))
            (set! has-rest true)
            (if (and (= count 0) (= (len prefix) 0))
                (set! prefix name)
                (if (= (len suffix) 0)
                    (set! suffix name)
                    (die (mut k) (mut c) arg "a pattern has at most two rests, one at each end")))
            (when (< scan 0)
              (set! scan (.next-scan k))
              (set! (.next-scan k) (+ scan 1))
              (set! scan-at (len (.steps k)))
              (push! (mut (.steps k))
                     (SScan :subject subject :scan scan :middle 0 :prefix false :suffix false))))
          (do
            (when (> (len suffix) 0)
              (die (mut k) (mut c) arg "nothing may follow a pattern's closing rest"))
            (let [kid (fresh-subject! (mut k))]
              (if has-rest
                  (push! (mut (.steps k)) (SScanKid :subject subject :scan scan :index count :out kid))
                  (push! (mut (.steps k)) (SKid :subject subject :index count :out kid)))
              (pat! (mut k) (mut c) arg kid))
            (set! count (+ count 1)))))
    (if has-rest
        (do
          (set! (mut (.steps k)) test-at (SKind :subject subject :kind (.text t)))
          (set! (mut (.steps k)) scan-at
                (SScan :subject subject :scan scan :middle count
                       :prefix (> (len prefix) 0) :suffix (> (len suffix) 0)))
          ;; The whole-list pattern of a rule might be a window rule: note its shape
          ;; and let `compile-rule` decide once it has seen the right-hand side.
          (when (and (= subject 0) (> (len prefix) 0) (> (len suffix) 0))
            (set! (.window-prefix k) prefix)
            (set! (.window-suffix k) suffix)
            (set! (.window-width k) count))
          (when (> (len prefix) 0)
            (push! (mut (.steps k)) (SPrefix :subject subject :scan scan :name prefix)))
          (when (> (len suffix) 0)
            (push! (mut (.steps k)) (SSuffix :subject subject :scan scan :middle count :name suffix)))
          (push! (mut (.uses k)) (Use :where (where-of (mut k) (mut c) t) :name (.text t) :arity -1)))
        (do
          (set! (mut (.steps k)) test-at (STest :subject subject :kind (.text t) :arity count))
          (push! (mut (.uses k)) (Use :where (where-of (mut k) (mut c) t) :name (.text t) :arity count))))))

;;; One pattern, as steps testing `subject`. Answers the head node's name, or "" for a
;;; pattern that is a plain variable or wildcard.
(defn pat! [(k (mut Comp)) (c (mut dsl/Cur)) (p g/Node) (subject i64)] (-> (slice u8))
  (cond
    (= (.kind p) (g/KName))
      (do
        (unless (= (.text p) "_")
          (bind-var! (mut k) (mut c) p (.text p) (VNode))
          (push! (mut (.steps k)) (SVar :subject subject :name (.text p))))
        "")
    (= (.kind p) (g/KPNode))
      (let [t (get (.kids p) 0)
            args (.kids (get (.kids p) 1))]
        (if (leaf? (mut k) (.text t))
            (do
              (push! (mut (.steps k)) (STest :subject subject :kind (.text t) :arity 0))
              (push! (mut (.uses k)) (Use :where (where-of (mut k) (mut c) t) :name (.text t) :arity 0))
              (unless (= (len args) 1)
                (die (mut k) (mut c) t "a leaf's pattern has one argument"))
              (pat-leaf! (mut k) (mut c) (.text t) subject (get args 0))
              (.text t))
            (let [test-at (len (.steps k))]
              ;; Filled in once the children have been read.
              (push! (mut (.steps k)) (SKind :subject subject :kind (.text t)))
              (pat-kids! (mut k) (mut c) t args subject test-at)
              (.text t))))
    :else (die (mut k) (mut c) p "a pattern is a node, a name or _")))

(defn var-sort [(k (mut Comp)) (c (mut dsl/Cur)) (t g/Node) (name (slice u8))] (-> VarSort)
  (let [(mut out) (None [VarSort])]
    (for v (.vars k) (when (= (.name v) name) (set! out (Some (.sort v)))))
    (match out
      (Some [s] s)
      (None [] (die (mut k) (mut c) t (dsl/join3 "the variable " name " is not bound by the pattern"))))))

;;; Arithmetic in a right-hand side, as a chain over (Option i64).
(defn num-expr [(k (mut Comp)) (c (mut dsl/Cur)) (e g/Node)] (-> Code)
  (match (.kind e)
    (g/KNum [] `(rt/parse-num ~(.text e)))
    (g/KName []
      (do
        (unless (= (var-sort (mut k) (mut c) e (.text e)) (VNum))
          (die (mut k) (mut c) e (dsl/join3 "the variable " (.text e) " is not a number")))
        `(Some ~(var-sym (.text e)))))
    (g/KGroup [] (num-expr (mut k) (mut c) (get (.kids e) 0)))
    (g/KPlus [] `(rt/num-add ~(num-expr (mut k) (mut c) (get (.kids e) 0)) ~(num-expr (mut k) (mut c) (get (.kids e) 1))))
    (g/KMinus [] `(rt/num-sub ~(num-expr (mut k) (mut c) (get (.kids e) 0)) ~(num-expr (mut k) (mut c) (get (.kids e) 1))))
    (g/KTimes [] `(rt/num-mul ~(num-expr (mut k) (mut c) (get (.kids e) 0)) ~(num-expr (mut k) (mut c) (get (.kids e) 1))))
    (_ (die (mut k) (mut c) e "expected arithmetic"))))

(defn host-call [(k (mut Comp)) (c (mut dsl/Cur)) (e g/Node)] (-> Code)
  (let [name (get (.kids e) 0)
        (mut args) (primitive/code-list-new)]
    (unless (.has-host k)
      (die (mut k) (mut c) name "@name needs a `host` module in the header"))
    (for a (.kids (get (.kids e) 1))
      (var-sort (mut k) (mut c) a (.text a))
      (push! (mut args) (var-sym (.text a))))
    `(~(host-sym (.text name)) ~@args)))

;;; A leaf's text on a right-hand side: a literal, a variable, or `a ++ b`.
(defn leaf-value [(k (mut Comp)) (c (mut dsl/Cur)) (kind (slice u8)) (a g/Node)] (-> Code)
  (match (.kind a)
    (g/KStr [] (if (= kind "Str") `(rt/quote-str ~(raw-str a)) `~(raw-str a)))
    (g/KName []
      (do
        (unless (= (var-sort (mut k) (mut c) a (.text a)) (VText))
          (die (mut k) (mut c) a (dsl/join3 "the variable " (.text a) " is not text")))
        (var-sym (.text a))))
    (g/KConcat []
      (let [x (get (.kids a) 0) y (get (.kids a) 1)]
        (var-sort (mut k) (mut c) x (.text x))
        (var-sort (mut k) (mut c) y (.text y))
        `(rt/str-concat ~(var-sym (.text x)) ~(var-sym (.text y)))))
    (_ (die (mut k) (mut c) a "a leaf holds a string or a text variable"))))

;;; A right-hand side: a Node expression that can leave the rule through :r when
;;; arithmetic is out of range.
(defn rhs [(k (mut Comp)) (c (mut dsl/Cur)) (e g/Node)] (-> Code)
  (match (.kind e)
    (g/KHostCall [] (host-call (mut k) (mut c) e))
    (g/KName []
      (do
        (unless (= (var-sort (mut k) (mut c) e (.text e)) (VNode))
          (die (mut k) (mut c) e (dsl/join3 "the variable " (.text e) " is not a node")))
        (var-sym (.text e))))
    (g/KRNode []
      (let [t (get (.kids e) 0)
            args (.kids (get (.kids e) 1))]
        (cond
          (= (.text t) "Num")
            (do
              (unless (= (len args) 1) (die (mut k) (mut c) t "Num holds one expression"))
              (push! (mut (.uses k)) (Use :where (where-of (mut k) (mut c) t) :name "Num" :arity 0))
              `(match ~(num-expr (mut k) (mut c) (get args 0))
                 (Some [v] (syn/leaf (syn/KNum) (rt/num-text v) 0 0))
                 (None [] (return-from :r (None [syn/Node])))))
          (leaf? (mut k) (.text t))
            (do
              (unless (= (len args) 1) (die (mut k) (mut c) t "a leaf holds one value"))
              (push! (mut (.uses k)) (Use :where (where-of (mut k) (mut c) t) :name (.text t) :arity 0))
              `(syn/leaf (~(kind-sym (.text t))) ~(leaf-value (mut k) (mut c) (.text t) (get args 0)) 0 0))
          :else
            (let [(mut pushes) (primitive/code-list-new)
                  (mut count) 0
                  (mut spread) false]
              (for a args
                (if (= (.kind a) (g/KRest))
                    (let [name (rest-name a)]
                      (unless (= (var-sort (mut k) (mut c) a name) (VList))
                        (die (mut k) (mut c) a (dsl/join3 "the variable " name " is not a rest")))
                      (set! spread true)
                      (push! (mut pushes) `(for each ~(var-sym name) (push! (mut kids) each))))
                    (do
                      (push! (mut pushes) `(push! (mut kids) ~(rhs (mut k) (mut c) a)))
                      (set! count (+ count 1)))))
              (push! (mut (.uses k))
                     (Use :where (where-of (mut k) (mut c) t) :name (.text t) :arity (if spread -1 count)))
              `(let [(mut kids) (syn/new-kids)]
                 ~@pushes
                 (syn/mk (~(kind-sym (.text t))) kids 0 0))))))
    (_ (die (mut k) (mut c) e "expected a node or a variable"))))

(defn no-match [] (-> Code) `(None [syn/Node]))

;;; Wrap `inner` in steps from index i on: the pattern's tests, outermost first.
(defn wrap-steps [(steps (ArrayList Step)) (i i64) (inner Code)] (-> Code)
  (if (>= i (len steps))
      inner
      (wrap-one-step (get steps i) (wrap-steps steps (+ i 1) inner))))

(defn wrap-one-step [(step Step) (rest Code)] (-> Code)
  (do
      (do
        (match step
          (STest [s kind arity]
            `(if (and (= (.kind ~(subj-sym s)) (~(kind-sym kind)))
                      (= (len (.kids ~(subj-sym s))) ~arity))
                 ~rest
                 ~(no-match)))
          (SKind [s kind]
            `(if (= (.kind ~(subj-sym s)) (~(kind-sym kind))) ~rest ~(no-match)))
          (SKid [s index out]
            `(let [~(subj-sym out) (get (.kids ~(subj-sym s)) ~index)] ~rest))
          (SScan [s scan middle prefix suffix]
            ;; Without a closing rest the middle must run to the end, and without an
            ;; opening one it must start at the beginning.
            (let [n `(len (.kids ~(subj-sym s)))
                  last `(- ~n ~middle)
                  ;; An empty range when the list is shorter than the pattern.
                  from (if (and prefix (not suffix)) `(if (>= ~last 0) ~last 0) `0)
                  to (cond
                       (and prefix (not suffix)) `(if (>= ~last 0) ~last -1)
                       prefix last
                       suffix `(if (>= ~last 0) 0 -1)
                       :else `0)]
              `(block :scan
                 (for ~(scan-sym scan) (range ~from (+ ~to 1))
                   (match (block :r ~rest)
                     (Some [found] (return-from :scan (Some found)))
                     (None [] 0)))
                 ~(no-match))))
          (SScanKid [s scan index out]
            `(let [~(subj-sym out) (get (.kids ~(subj-sym s)) (+ ~(scan-sym scan) ~index))] ~rest))
          (SPrefix [s scan name]
            `(let [~(var-sym name) (syn/sublist (.kids ~(subj-sym s)) 0 ~(scan-sym scan))] ~rest))
          (SSuffix [s scan middle name]
            `(let [~(var-sym name)
                     (syn/sublist (.kids ~(subj-sym s)) (+ ~(scan-sym scan) ~middle)
                                  (len (.kids ~(subj-sym s))))]
               ~rest))
          (SVar [s name] `(let [~(var-sym name) ~(subj-sym s)] ~rest))
          (SNum [s name]
            `(match (rt/parse-num (.text ~(subj-sym s)))
               (Some [~(var-sym name)] ~rest)
               (None [] ~(no-match))))
          (SText [s name] `(let [~(var-sym name) (.text ~(subj-sym s))] ~rest))
          (STextEq [s text]
            `(if (= (.text ~(subj-sym s)) ~text) ~rest ~(no-match)))
          (SStrEq [s text]
            `(if (rt/str-is? (.text ~(subj-sym s)) ~text) ~rest ~(no-match)))))))

;;; Steps for a window rule's whole-list pattern. The window sits at the end of the
;;; children it is handed, so there is nothing to scan, and no rests to bind.
(defn wrap-steps-window [(steps (ArrayList Step)) (i i64) (inner Code)] (-> Code)
  (if (>= i (len steps))
      inner
      (let [rest (wrap-steps-window steps (+ i 1) inner)]
        (match (get steps i)
          (SScan [s scan middle _ _]
            (if (= s 0)
                `(let [~(scan-sym scan) (- (len (.kids s0)) ~middle)] ~rest)
                (wrap-one-step (get steps i) rest)))
          (SPrefix [s _ _] (if (= s 0) rest (wrap-one-step (get steps i) rest)))
          (SSuffix [s _ _ _] (if (= s 0) rest (wrap-one-step (get steps i) rest)))
          (_ (wrap-one-step (get steps i) rest))))))

;;; `R` of a window rule must be exactly `List(xs..., …, ys...)`, the same two rests
;;; at the same two ends: then nothing outside the window can change.
(defn window-rhs? [(k (mut Comp)) (head (slice u8)) (e g/Node)] (-> bool)
  (and (= (.kind e) (g/KRNode))
       (= (.text (get (.kids e) 0)) head)
       (let [args (.kids (get (.kids e) 1))
             n (len args)]
         (and (>= n 2)
              (= (.kind (get args 0)) (g/KRest))
              (= (rest-name (get args 0)) (.window-prefix k))
              (= (.kind (get args (- n 1))) (g/KRest))
              (= (rest-name (get args (- n 1))) (.window-suffix k))))))

(defn guards! [(k (mut Comp)) (c (mut dsl/Cur)) (list g/Node)] (-> void)
  (when (= (.kind list) (g/KList))
    (for g-node (.kids list)
      (let [negated (= (.kind g-node) (g/KNotGuard))
            name (get (.kids g-node) 0)
            (mut args) (ArrayList::new [(slice u8)] (malloc-allocator))]
        (unless (.has-host k)
          (die (mut k) (mut c) name "@name needs a `host` module in the header"))
        (for a (.kids (get (.kids g-node) 1))
          (var-sort (mut k) (mut c) a (.text a))
          (push! (mut args) (.text a)))
        (push! (mut (.guards k)) (Guard :negated negated :name (.text name) :args args))))))

(defn guards-code [(k (mut Comp))] (-> Code)
  (let [(mut tests) (primitive/code-list-new)]
    (for g (.guards k)
      (let [(mut args) (primitive/code-list-new)]
        (for a (.args g) (push! (mut args) (var-sym a)))
        (if (.negated g)
            (push! (mut tests) `(not (~(host-sym (.name g)) ~@args)))
            (push! (mut tests) `(~(host-sym (.name g)) ~@args)))))
    `(and ~@tests true)))

(defn compile-rule [(k (mut Comp)) (c (mut dsl/Cur)) (r g/Node) (index i64)] (-> Code)
  (let [name (get (.kids r) 0)
        pattern (get (.kids r) 1)
        as-name (get (.kids r) 2)
        guard-list (get (.kids r) 3)
        right (get (.kids r) 4)]
    (clear! (mut (.steps k)))
    (clear! (mut (.vars k)))
    (clear! (mut (.guards k)))
    (set! (.next-subject k) 1)
    (set! (.next-scan k) 0)
    (set! (.window-prefix k) "")
    (set! (.window-suffix k) "")
    (set! (.window-width k) 0)
    (let [head (pat! (mut k) (mut c) pattern 0)]
      (when (= (len head) 0)
        (die (mut k) (mut c) name "a rule's pattern must start with a node"))
      (when (= (.kind as-name) (g/KName))
        (bind-var! (mut k) (mut c) as-name (.text as-name) (VNode))
        (push! (mut (.steps k)) (SVar :subject 0 :name (.text as-name))))
      (guards! (mut k) (mut c) guard-list)
      (let [right-code (rhs (mut k) (mut c) right)
            guarded `(if ~(guards-code (mut k)) (Some ~right-code) ~(no-match))
            is-window (and (> (.window-width k) 0) (window-rhs? (mut k) head right))]
        (push! (mut (.rules k))
               (Rule :name (.text name) :head head :width (if is-window (.window-width k) 0)))
        (if is-window
            ;; The tail of `s0`'s children is the window: `scan` is where it starts.
            ;; The rest variables are bound to empty lists, so the result holds only the
            ;; replacement.
            `(defn ~(rule-sym (mut k) index) [(s0 syn/Node)] (-> (Option syn/Node))
               (let [empty (syn/new-kids)
                     ~(var-sym (.window-prefix k)) empty
                     ~(var-sym (.window-suffix k)) empty]
                 (block :r ~(wrap-steps-window (.steps k) 0 guarded))))
            `(defn ~(rule-sym (mut k) index) [(s0 syn/Node)] (-> (Option syn/Node))
               (block :r ~(wrap-steps (.steps k) 0 guarded))))))))

;;; Try each rule with this head in order.
(defn try-rules [(k (mut Comp)) (head (slice u8)) (i i64)] (-> Code)
  (cond
    (>= i (len (.rules k))) (no-match)
    (or (!= (.head (get (.rules k) i)) head) (> (.width (get (.rules k) i)) 0))
      (try-rules (mut k) head (+ i 1))
    :else
      `(match (~(rule-sym (mut k) i) n)
         (Some [r] (Some r))
         (None [] ~(try-rules (mut k) head (+ i 1))))))

;;; The rules' definitions, a step function dispatching on the head node, a driver,
;;; and the check against the grammar's table. The caller supplies `syn` and `host`.
(defn compile-rules [(c (mut dsl/Cur)) (src (slice u8)) (rules (ArrayList g/Node)) (prefix (slice u8)) (has-host bool) (leaves (ArrayList (slice u8)))] (-> Code)
  (let [(mut k) (Comp
                  :prefix prefix
                  :has-host has-host
                  :leaves leaves
                  :uses (ArrayList::new [Use] (malloc-allocator))
                  :rules (ArrayList::new [Rule] (malloc-allocator))
                  :steps (ArrayList::new [Step] (malloc-allocator))
                  :vars (ArrayList::new [Var] (malloc-allocator))
                  :guards (ArrayList::new [Guard] (malloc-allocator))
                  :src src
                  :next-subject 1
                  :next-scan 0
                  :window-prefix ""
                  :window-suffix ""
                  :window-width 0)
        (mut forms) (primitive/code-list-new)
        (mut arms) (primitive/code-list-new)
        (mut uses) (primitive/code-list-new)
        (mut windows) (primitive/code-list-new)
        feed (primitive/code-symbol (dsl/join2 prefix "feed"))
        (mut index) 0]
    (for r rules
      (push! (mut forms) (compile-rule (mut k) (mut c) r index))
      (set! index (+ index 1)))
    (for i (range 0 (len (.rules k)))
      (let [head (.head (get (.rules k) i)) (mut first) true]
        (for j (range 0 i)
          (when (= (.head (get (.rules k) j)) head) (set! first false)))
        (when first
          (push! (mut arms) `(~(kind-sym head) [] ~(try-rules (mut k) head 0))))))
    (for i (range 0 (len (.rules k)))
      (let [r (get (.rules k) i)]
        (when (> (.width r) 0)
          (push! (mut windows)
                 `(when (>= (len out) ~(.width r))
                    (let [probe (syn/mk (syn/KList) out 0 0)]
                      (match (~(rule-sym (mut k) i) probe)
                        (Some [repl]
                          (for _ (range 0 ~(.width r)) (pop! (mut out)))
                          (set! fuel (- fuel 1))
                          (when (< fuel 0)
                            (panic "rewrite rules did not terminate within 100000000 firings"))
                          (for each (.kids repl) (~feed each pass (mut fuel) (mut out)))
                          (return-from :window 0))
                        (None [] 0))))))))
    (for u (.uses k)
      (push! (mut uses) `(~(.where u) ~(.name u) ~(.arity u))))
    (let [step (pfx-sym (mut k) "step")
          go (pfx-sym (mut k) "go")
          run (pfx-sym (mut k) "run")
          check (pfx-sym (mut k) "check")]
      `(do
         ~@forms
         (defn ~step [(n syn/Node)] (-> (Option syn/Node))
           (match (.kind n) ~@arms (_ ~(no-match))))
         ;;; Window rules run as a peephole: normalise each element, push it, and try
         ;;; the rules on the end of the output. A replacement is fed back in. Earlier
         ;;; elements are already stable, so a long list costs one pass over it.
         (defn ~feed [(item syn/Node) (pass i64) (fuel (mut i64)) (out (mut (ArrayList syn/Node)))] (-> void)
           (push! (mut out) (~go item pass (mut fuel)))
           (block :window
             ~@windows
             0)
           0)
         ;;; Bottom up: normal children first, then rules here until none applies. A
         ;;; node stamped with this pass is already normal, so a rule's reused children
         ;;; are not walked again, and the whole pass stays linear.
         (defn ~go [(n syn/Node) (pass i64) (fuel (mut i64))] (-> syn/Node)
           ;; A loop, not recursion on the result: a long statement list can fire
           ;; thousands of rules in a row.
           (let [(mut cur) n (mut go-on) true]
             (while go-on
               (if (= (.gen cur) pass)
                   (set! go-on false)
                   (let [(mut kids) (syn/new-kids)]
                     (reserve! (mut kids) (len (.kids cur)))
                     (if (= (.kind cur) (syn/KList))
                         (for (ref child) (.kids cur) (~feed child pass (mut fuel) (mut kids)))
                         (for (ref child) (.kids cur) (push! (mut kids) (~go child pass (mut fuel)))))
                     (let [(mut rebuilt) (syn/mk (.kind cur) kids (.lo cur) (.hi cur))]
                       (set! (.text rebuilt) (.text cur))
                       (match (~step rebuilt)
                         (None []
                           (set! (.gen rebuilt) pass)
                           (set! cur rebuilt)
                           (set! go-on false))
                         (Some [r]
                           (set! fuel (- fuel 1))
                           (when (< fuel 0)
                             (panic "rewrite rules did not terminate within 100000000 firings"))
                           (set! cur r)))))))
             cur))
         (defn ~run [(n syn/Node)] (-> syn/Node)
           (let [(mut fuel) 100000000] (~go n (rt/next-pass!) (mut fuel))))
         (defn ~check [] (-> Code)
           (check/against (syn/node-table) (quasiquote (~@uses))))
         (meta (~check))))))

(defn imports-for [(syntax (slice u8)) (host (slice u8))] (-> Code)
  (let [(mut extra) (primitive/code-list-new)]
    (when (> (len host) 0) (push! (mut extra) `(import ~host :as host)))
    `(do
       (import "coil.control" :use [return-from])
       (import "coil.arraylist" :use [ArrayList])
       (import "hl.rt" :as rt)
       (import "hl.check" :as check)
       (import ~syntax :as syn)
       ~@extra)))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree (match (g/parse-result src path 0)
               (Ok [t] t)
               (Err [e] (dsl/fail-at path (.line e) (.col e) (dsl/join2 "expected " (.want e)))))
        syntax (.text (get (.kids tree) 0))
        host-node (get (.kids tree) 1)
        leaves-node (get (.kids tree) 2)
        host (if (= (.kind host-node) (g/KName)) (.text host-node) "")
        (mut leaves) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (when (= (.kind leaves-node) (g/KList))
      (for l (.kids leaves-node) (push! (mut leaves) (.text l))))
    (dsl/render `(do ~(imports-for syntax host)
                     ~(compile-rules (mut c) src (.kids (get (.kids tree) 3)) "" (> (len host) 0) leaves)))))

(defn read-rewrite [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
