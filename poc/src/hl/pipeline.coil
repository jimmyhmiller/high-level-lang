;;; `.pipeline`: how a build divides its work, said once, and checked. A pipeline names its stages,
;;; whether each works per file, per part or on the whole program, and the functions that do it.
;;; Plans then choose, stage by stage, serial or parallel, on how many threads, in how many parts.
;;;
;;;   pipeline app.pipelines fills bundle.api/Plan
;;;   stage load     per file bundle.modules/visit-file bundle.modules/next-files
;;;   stage optimize per part bundle.api/default-optimize
;;;   stage link     whole    bundle.analysis/link
;;;
;;;   plan quick
;;;     threads auto
;;;     load parallel
;;;     optimize parallel 4 parts 8
;;;   end
;;;
;;; A plan may run a stage in parallel only if every function the stage names, and everything
;;; they call, writes no state shared between threads. That is decided here, from the `.rules`
;;; sources: an assignment to a `state` (not a `task state`, which each thread has its own of),
;;; an `assert` into a relation held in one, a `mut` argument that is one, or a call of a
;;; function value, whose effects nothing here can see. A grammar or a rewrite is pure by
;;; construction; a `.facts` or `.scopes` call may change what it is given. A plan that breaks
;;; this does not compile, and the error says what was written, and where.
;;;
;;; The output is a `plan(name)` answering the record the pipeline fills, and `plan-names()`.
(module hl.pipeline)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.meta" :as meta)
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.grammars.pipeline" :as g)
(import "hl.grammars.rules" :as gr)

(reader-provider "hl.pipeline" read-pipeline)

(defn texts [] (-> (ArrayList (slice u8))) (ArrayList::new [(slice u8)] (malloc-allocator)))

(defn has? [(xs (ArrayList (slice u8))) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x xs (when (= x s) (set! hit true)))
    hit))

(defn add-unique! [(xs (mut (ArrayList (slice u8)))) (s (slice u8))] (-> void)
  (unless (has? xs s) (push! (mut xs) s)))

;; ---------------------------------------------------------------- modules, from the manifest

(defstruct Entry [(name (slice u8)) (file (slice u8))])

(defn manifest-entries [(manifest (slice u8))] (-> (ArrayList Entry))
  (let [base (rt/dir-of manifest)
        text (rt/read-all manifest)
        (mut out) (ArrayList::new [Entry] (malloc-allocator))
        (mut start) 0
        (mut in-modules) false]
    (for i (range 0 (+ (len text) 1))
      (when (or (= i (len text)) (= (get text i) #\newline))
        (let [line (subslice text start i)]
          (set! start (+ i 1))
          (cond
            (rt/at? line 0 "[") (set! in-modules (= line "[modules]"))
            (and in-modules (rt/at? line 0 "\""))
              (let [(mut quotes) (ArrayList::new [i64] (malloc-allocator))]
                (for j (range 0 (len line))
                  (when (= (get line j) #\") (push! (mut quotes) j)))
                (when (= (len quotes) 4)
                  (push! (mut out)
                         (Entry :name (subslice line (+ (get quotes 0) 1) (get quotes 1))
                                :file (dsl/join3 base "/" (subslice line (+ (get quotes 2) 1) (get quotes 3)))))))
            :else 0))))
    out))

;; ---------------------------------------------------------------- what a module declares

(defsum Kind (KindRules) (KindPure) (KindMutating) (KindForeign))
(derive Eq Kind)

(defstruct Fun [(name (slice u8)) (body gr/Node) (params (ArrayList (slice u8))) (muts (ArrayList bool))])

(defstruct Info
  [(name (slice u8))
   (kind Kind)
   (shared (ArrayList (slice u8)))
   (task (ArrayList (slice u8)))
   (consts (ArrayList (slice u8)))
   (alias-names (ArrayList (slice u8)))
   (alias-modules (ArrayList (slice u8)))
   (funs (ArrayList Fun))
   ;; States whose type is a module's record, and the alias of that module: a database's queries
   ;; read it.
   (typed-names (ArrayList (slice u8)))
   (typed-aliases (ArrayList (slice u8)))
   (facts bool)])

(defn info-new [(name (slice u8)) (kind Kind)] (-> Info)
  (Info :name name :kind kind :shared (texts) :task (texts) :consts (texts)
        :alias-names (texts) :alias-modules (texts)
        :funs (ArrayList::new [Fun] (malloc-allocator))
        :typed-names (texts) :typed-aliases (texts) :facts false))

;;; A state declared with a type `alias.Record`: remember which module it comes from.
(defn note-typed! [(info (mut Info)) (d gr/Node)] (-> void)
  (let [ty (kid d 1)]
    (when (= (.kind ty) (gr/KTQual))
      (push! (mut (.typed-names info)) (.text (kid d 0)))
      (push! (mut (.typed-aliases info)) (.text (kid ty 0))))
    0))

(defn kid [(n gr/Node) (i i64)] (-> gr/Node) (get (.kids n) i))

(defn params-of [(list gr/Node)] (-> Fun)
  (let [(mut names) (texts)
        (mut muts) (ArrayList::new [bool] (malloc-allocator))]
    (for p (.kids list)
      (push! (mut names) (.text (kid p 0)))
      (push! (mut muts) (= (.kind (kid p 1)) (gr/KTMut))))
    (Fun :name "" :body list :params names :muts muts)))

(defn alias-of [(info Info) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for i (range 0 (len (.alias-names info)))
      (when (= (get (.alias-names info) i) name)
        (set! out (Some (get (.alias-modules info) i)))))
    out))

(defn fun-of [(info Info) (name (slice u8))] (-> (Option Fun))
  (let [(mut out) (None [Fun])]
    (for f (.funs info) (when (= (.name f) name) (set! out (Some f))))
    out))

(defn parse-rules [(src (slice u8)) (path (slice u8))] (-> gr/Node)
  (match (gr/parse-result src path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (dsl/join2 "expected " (.want e))))))

(defn prelude-text [] (-> (slice u8)) (include-str "rules_prelude.rules"))

;;; The foreign modules every `.rules` file can call: `rt.f` and bare `f` are hl.rt, `sym.f` is
;;; hl.symtab. What they change is what their `mut` parameters say.
(defn foreign-infos [] (-> (ArrayList Info))
  (let [tree (parse-rules (prelude-text) "rules_prelude.rules")
        (mut out) (ArrayList::new [Info] (malloc-allocator))]
    (for d (.kids (kid tree 2))
      (when (= (.kind d) (gr/KForeign))
        (let [(mut info) (info-new (.text (kid d 0)) (KindForeign))]
          (for item (.kids (kid d 2))
            (when (= (.kind item) (gr/KFFn))
              (let [ps (params-of (kid item 2))]
                (push! (mut (.funs info))
                       (Fun :name (.text (kid item 0)) :body item :params (.params ps) :muts (.muts ps))))))
          (push! (mut out) info))))
    out))

(defn rules-info [(name (slice u8)) (src (slice u8)) (path (slice u8))] (-> Info)
  (let [tree (parse-rules src path)
        (mut info) (info-new name (KindRules))]
    (push! (mut (.alias-names info)) "rt")
    (push! (mut (.alias-modules info)) "hl.rt")
    (push! (mut (.alias-names info)) "sym")
    (push! (mut (.alias-modules info)) "hl.symtab")
    (for d (.kids (kid tree 2))
      (match (.kind d)
        (gr/KUse []
          (push! (mut (.alias-names info)) (.text (kid d 1)))
          (push! (mut (.alias-modules info)) (.text (kid d 0))))
        (gr/KState [] (do (push! (mut (.shared info)) (.text (kid d 0))) (note-typed! (mut info) d)))
        (gr/KTaskState [] (do (push! (mut (.task info)) (.text (kid d 0))) (note-typed! (mut info) d)))
        (gr/KContext [] (push! (mut (.task info)) (.text (kid d 0))))
        ;; An attribute grammar's attributes live in its task state, one copy to a worker.
        (gr/KInh [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KGiven [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KInput [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KCollect [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KConst [] (push! (mut (.consts info)) (.text (kid d 0))))
        ;; A memo's caching is invisible: what it does is what its body does.
        (gr/KMemoFn []
          (let [ps (params-of (kid d 1))]
            (push! (mut (.funs info))
                   (Fun :name (.text (kid d 0)) :body (kid d 3) :params (.params ps) :muts (.muts ps)))))
        ;; An everywhere function's walk into the children only calls itself.
        (gr/KEverywhereFn []
          (let [ps (params-of (kid d 1))]
            (push! (mut (.funs info))
                   (Fun :name (.text (kid d 0)) :body (kid d 3) :params (.params ps) :muts (.muts ps)))))
        (gr/KFn []
          (let [ps (params-of (kid d 1))]
            (push! (mut (.funs info))
                   (Fun :name (.text (kid d 0)) :body (kid d 3) :params (.params ps) :muts (.muts ps)))))
        (_ 0)))
    ;; Its `run` does what its `on` blocks and rewrites do.
    (when (= (.kind tree) (gr/KAttrsFile))
      (let [(mut rules) (gr/new-kids)]
        (for d (.kids (kid tree 2))
          (when (or (= (.kind d) (gr/KOn)) (= (.kind d) (gr/KRewrite))) (push! (mut rules) d)))
        (push! (mut (.funs info))
               (Fun :name "run" :body (gr/mk (gr/KList) rules 0 0) :params (texts)
                    :muts (ArrayList::new [bool] (malloc-allocator))))))
    info))

;; ---------------------------------------------------------------- effects

;;; A write to shared state: which, and the function that does it.
(defstruct Write [(what (slice u8)) (where (slice u8))])

(defstruct Effect
  [(writes (ArrayList Write))
   (muts (ArrayList i64))                 ; parameters of this function it changes
   (hooks (ArrayList (slice u8)))])       ; function values it calls

(defn effect-new [] (-> Effect)
  (Effect :writes (ArrayList::new [Write] (malloc-allocator))
          :muts (ArrayList::new [i64] (malloc-allocator))
          :hooks (texts)))

(defstruct Checker
  [(entries (ArrayList Entry))
   (infos (ArrayList Info))
   (memo-keys (ArrayList (slice u8)))
   (memo (ArrayList Effect))
   (visiting (ArrayList (slice u8)))
   (depends (ArrayList (slice u8)))])

(defn info-index [(c (mut Checker)) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.infos c)))
      (when (= (.name (get (.infos c) i)) name) (set! at i)))
    at))

(defn file-of [(c (mut Checker)) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for e (.entries c) (when (= (.name e) name) (set! out (Some (.file e)))))
    out))

(defn info-of [(c (mut Checker)) (name (slice u8))] (-> Info)
  (let [at (info-index (mut c) name)]
    (if (>= at 0)
        (get (.infos c) at)
        (let [info (match (file-of (mut c) name)
                     (None [] (info-new name (KindPure)))
                     (Some [path]
                       (add-unique! (mut (.depends c)) path)
                       (cond
                         (or (rt/ends-with path ".rules") (rt/ends-with path ".attrs")) (rules-info name (rt/read-all path) path)
                         (rt/ends-with path ".facts")
                           (let [(mut i) (info-new name (KindMutating))] (set! (.facts i) true) i)
                         (rt/ends-with path ".scopes") (info-new name (KindMutating))
                         :else (info-new name (KindPure)))))]
          (push! (mut (.infos c)) info)
          info))))

(defn add-write! [(e (mut Effect)) (what (slice u8)) (where (slice u8))] (-> void)
  (let [(mut seen) false]
    (for w (.writes e) (when (= (.what w) what) (set! seen true)))
    (unless seen (push! (mut (.writes e)) (Write :what what :where where)))))

;;; What an expression is a part of, for a write to it.
(defsum Root (RNone) (RParam [(i i64)]) (RState [(what (slice u8)) (shared bool)]))

(defn param-index [(f Fun) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.params f)))
      (when (= (get (.params f) i) name) (set! at i)))
    at))

(defn state-root [(info Info) (name (slice u8))] (-> Root)
  (cond
    (has? (.shared info) name) (RState (dsl/join3 (.name info) "." name) true)
    (has? (.task info) name) (RState (dsl/join3 (.name info) "." name) false)
    :else (RNone)))

(defn root-of [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (e gr/Node)] (-> Root)
  (match (.kind e)
    (gr/KName []
      (let [n (.text e)
            p (param-index f n)]
        (cond
          (>= p 0) (RParam p)
          (has? locals n) (RNone)
          :else (state-root info n))))
    (gr/KFieldE []
      (let [base (kid e 0)]
        (match (if (= (.kind base) (gr/KName)) (alias-of info (.text base)) (None [(slice u8)]))
          (Some [module]
            (if (or (has? locals (.text base)) (>= (param-index f (.text base)) 0))
                (root-of (mut c) info f locals base)
                (state-root (info-of (mut c) module) (.text (kid e 1)))))
          (None [] (root-of (mut c) info f locals base)))))
    (gr/KIndex [] (root-of (mut c) info f locals (kid e 0)))
    (gr/KSlice [] (root-of (mut c) info f locals (kid e 0)))
    (gr/KGroup [] (root-of (mut c) info f locals (kid e 0)))
    (_ (RNone))))

(defn write-root! [(out (mut Effect)) (f Fun) (r Root) (where (slice u8))] (-> void)
  (match r
    (RState [what shared] (when shared (add-write! (mut out) what where)))
    (RParam [i] (when (get (.muts f) i) (push! (mut (.muts out)) i)))
    (RNone [] 0)))

(defn arg-expr [(a gr/Node)] (-> gr/Node)
  (if (= (.kind a) (gr/KNamed)) (kid a 1) a))

;;; A callee's effects, as they land on this call's arguments.
(defn merge-call! [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (out (mut Effect))
                   (callee Effect) (args (ArrayList gr/Node)) (where (slice u8))] (-> void)
  (for w (.writes callee) (add-write! (mut out) (.what w) (.where w)))
  (for h (.hooks callee) (add-unique! (mut (.hooks out)) h))
  (for i (.muts callee)
    (when (< i (len args))
      (write-root! (mut out) f (root-of (mut c) info f locals (arg-expr (get args i))) where))))

(defn foreign-mut-writes! [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (out (mut Effect))
                           (target Fun) (args (ArrayList gr/Node)) (where (slice u8))] (-> void)
  (for i (range 0 (len args))
    (when (and (< i (len (.muts target))) (get (.muts target) i))
      (write-root! (mut out) f (root-of (mut c) info f locals (arg-expr (get args i))) where))))

(defn foreign-fun [(c (mut Checker)) (module (slice u8)) (name (slice u8))] (-> (Option Fun))
  (let [(mut out) (None [Fun])]
    (for info (foreign-infos)
      (when (= (.name info) module)
        (set! out (fun-of info name))))
    out))

(defn call! [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (out (mut Effect)) (n gr/Node)] (-> void)
  (let [callee (kid n 0)
        args (.kids (kid n 1))
        where (dsl/join3 (.name info) "/" (.name f))]
    ;; A function named as a value, as `parallel-map(xs, f, n)` takes one, may be called.
    (for a args
      (let [e (arg-expr a)]
        (when (and (= (.kind e) (gr/KName)) (not (has? locals (.text e))) (< (param-index f (.text e)) 0))
          (match (fun-of info (.text e))
            (Some [_] (merge-call! (mut c) info f locals (mut out) (fun-effect (mut c) (.name info) (.text e)) args where))
            (None [] 0)))))
    (match (.kind callee)
      (gr/KName []
        (let [name (.text callee)]
          (cond
            (or (has? locals name) (>= (param-index f name) 0) (has? (.shared info) name) (has? (.task info) name))
              (add-unique! (mut (.hooks out)) (dsl/join3 where " calls " name))
            (= name "forget-memos!") (add-write! (mut out) (dsl/join2 (.name info) ".memos") where)
            (or (= name "clear") (= name "pop"))
              (when (> (len args) 0)
                (write-root! (mut out) f (root-of (mut c) info f locals (arg-expr (get args 0))) where))
            :else
              (match (fun-of info name)
                (Some [_] (merge-call! (mut c) info f locals (mut out) (fun-effect (mut c) (.name info) name) args where))
                (None []
                  (match (foreign-fun (mut c) "hl.rt" name)
                    (Some [t] (foreign-mut-writes! (mut c) info f locals (mut out) t args where))
                    (None [] 0)))))))
      (gr/KFieldE []
        (if (database-query? (mut c) info f locals (kid callee 0))
            0
        (let [base (kid callee 0)
              fname (.text (kid callee 1))
              module (if (and (= (.kind base) (gr/KName)) (not (has? locals (.text base)))
                              (< (param-index f (.text base)) 0))
                         (alias-of info (.text base))
                         (None [(slice u8)]))]
          (match module
            (Some [m]
              (let [target (info-of (mut c) m)]
                (match (.kind target)
                  (KindRules [] (merge-call! (mut c) info f locals (mut out) (fun-effect (mut c) m fname) args where))
                  (KindPure [] 0)
                  (KindMutating []
                    (for a args
                      (write-root! (mut out) f (root-of (mut c) info f locals (arg-expr a)) where)))
                  (KindForeign []
                    (match (foreign-fun (mut c) m fname)
                      (Some [t] (foreign-mut-writes! (mut c) info f locals (mut out) t args where))
                      (None [] 0))))))
            (None [] (add-unique! (mut (.hooks out)) (dsl/join3 where " calls a function value " fname)))))))
      ;; `module.Record(…)` builds a value.
      (gr/KMember [] 0)
      (_ (add-unique! (mut (.hooks out)) (dsl/join3 where " calls a function value: " (gr/kind-name (.kind callee))))))))

;;; `db.relation(…)` or `m.db.relation(…)`, where `db` is a state whose type a `.facts` module
;;; defines: a query, which reads. (`assert` is the write, and `link.solve!(db)` another.)
(defn database-query? [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (base gr/Node)] (-> bool)
  (let [own (and (= (.kind base) (gr/KName)) (not (has? locals (.text base))) (< (param-index f (.text base)) 0))
        other (and (= (.kind base) (gr/KFieldE)) (= (.kind (kid base 0)) (gr/KName))
                   (not (has? locals (.text (kid base 0)))) (< (param-index f (.text (kid base 0))) 0))]
    (cond
      own (facts-typed? (mut c) info (.text base))
      other (match (alias-of info (.text (kid base 0)))
              (Some [m]
                (let [holder (info-of (mut c) m)]
                  (facts-typed? (mut c) holder (.text (kid base 1)))))
              (None [] false))
      :else false)))

(defn facts-typed? [(c (mut Checker)) (info Info) (state (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for i (range 0 (len (.typed-names info)))
      (when (= (get (.typed-names info) i) state)
        (match (alias-of info (get (.typed-aliases info) i))
          (Some [m] (when (.facts (info-of (mut c) m)) (set! hit true)))
          (None [] 0))))
    hit))

(defn walk! [(c (mut Checker)) (info Info) (f Fun) (locals (ArrayList (slice u8))) (out (mut Effect)) (n gr/Node)] (-> void)
  (let [where (dsl/join3 (.name info) "/" (.name f))]
    (match (.kind n)
      (gr/KAssign [] (write-root! (mut out) f (root-of (mut c) info f locals (kid n 0)) where))
      (gr/KAppend [] (write-root! (mut out) f (root-of (mut c) info f locals (kid n 0)) where))
      (gr/KExtend [] (write-root! (mut out) f (root-of (mut c) info f locals (kid n 0)) where))
      (gr/KAssert []
        (let [e (kid n 0)]
          (when (and (= (.kind e) (gr/KCall)) (= (.kind (kid e 0)) (gr/KFieldE)))
            (write-root! (mut out) f (root-of (mut c) info f locals (kid (kid e 0) 0)) where))))
      (gr/KCall [] (call! (mut c) info f locals (mut out) n))
      (_ 0))
    (for k (.kids n) (walk! (mut c) info f locals (mut out) k))))

;;; Names a function binds for itself: these are not the module's state, whatever they are called.
(defn locals! [(n gr/Node) (out (mut (ArrayList (slice u8)))) (in-pattern bool)] (-> void)
  (match (.kind n)
    (gr/KLet [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KVar [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KRangeHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KInHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KFromHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KSort [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KPAs [] (add-unique! (mut out) (.text (kid n 1))))
    (gr/KQvar [] (add-unique! (mut out) (subslice (.text n) 1 (len (.text n)))))
    (gr/KName [] (when in-pattern (add-unique! (mut out) (.text n))))
    (_ 0))
  (match (.kind n)
    (gr/KArm [] (do (locals! (kid n 0) (mut out) true) (for i (range 1 (len (.kids n))) (locals! (kid n i) (mut out) in-pattern))))
    (gr/KIfLet [] (do (locals! (kid n 0) (mut out) true) (for i (range 1 (len (.kids n))) (locals! (kid n i) (mut out) in-pattern))))
    (gr/KIsE [] (do (locals! (kid n 0) (mut out) in-pattern) (locals! (kid n 1) (mut out) true)))
    (gr/KPatHead [] (do (locals! (kid n 0) (mut out) true) (locals! (kid n 1) (mut out) in-pattern)))
    (gr/KLetClause [] (do (locals! (kid n 0) (mut out) true) (locals! (kid n 1) (mut out) in-pattern)))
    ;; `cm.Scan(…)`: the first name is a module, not a binding.
    (gr/KPNodeQ [] (for i (range 1 (len (.kids n))) (locals! (kid n i) (mut out) in-pattern)))
    (gr/KPEnumQ [] 0)
    (_ (for k (.kids n) (locals! k (mut out) in-pattern)))))

(defn memo-index [(c (mut Checker)) (key (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.memo-keys c)))
      (when (= (get (.memo-keys c) i) key) (set! at i)))
    at))

;;; What a function, and all it calls, writes. A call back into a function still being worked out
;;; adds nothing: its effects are being gathered already.
(defn fun-effect [(c (mut Checker)) (module (slice u8)) (name (slice u8))] (-> Effect)
  (let [key (dsl/join3 module "/" name)
        at (memo-index (mut c) key)]
    (cond
      (>= at 0) (get (.memo c) at)
      (has? (.visiting c) key) (effect-new)
      :else
        (let [info (info-of (mut c) module)
              (mut out) (effect-new)]
          (push! (mut (.visiting c)) key)
          (if (= name "forget-memos!")
              (add-write! (mut out) (dsl/join2 module ".memos") key)
              (match (fun-of info name)
                (Some [f]
                  (let [(mut locals) (texts)]
                    (locals! (.body f) (mut locals) false)
                    (walk! (mut c) info f locals (mut out) (.body f))))
                (None [] (push! (mut (.hooks out)) (dsl/join2 "no function named " key)))))
          (push! (mut (.memo-keys c)) key)
          (push! (mut (.memo c)) out)
          out))))

;; ---------------------------------------------------------------- the pipeline

(defstruct Stage [(name (slice u8)) (unit (slice u8)) (functions (ArrayList (slice u8))) (tok rt/Tok)])

(defn tok-of [(src (slice u8)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col src (.lo n))]
    (rt/Tok :kind (rt/TIdent) :text (.text n) :line (.line at) :col (.col at))))

(defn split-fn [(c (mut dsl/Cur)) (t rt/Tok)] (-> (ArrayList (slice u8)))
  (let [s (.text t) (mut cut) -1 (mut out) (texts)]
    (for i (range 0 (len s)) (when (= (get s i) #\/) (set! cut i)))
    (when (< cut 0) (dsl/die (mut c) t "expected module/function"))
    (push! (mut out) (subslice s 0 cut))
    (push! (mut out) (subslice s (+ cut 1) (len s)))
    out))

(defn find-stage [(stages (ArrayList Stage)) (name (slice u8))] (-> (Option Stage))
  (let [(mut out) (None [Stage])]
    (for s stages (when (= (.name s) name) (set! out (Some s))))
    out))

;;; A count in a plan: a number, or `auto`, the machine's cores.
(defn count-code [(n g/Node)] (-> Code)
  (if (= (.kind n) (g/KAuto))
      `(rt/cores)
      `~(rt/parse-int (.text n))))

(defn check-stage! [(chk (mut Checker)) (c (mut dsl/Cur)) (src (slice u8)) (plan-name (slice u8)) (s Stage) (at g/Node)] (-> void)
  (for full (.functions s)
    (let [slash (let [(mut cut) -1] (for i (range 0 (len full)) (when (= (get full i) #\/) (set! cut i))) cut)
          module (subslice full 0 slash)
          name (subslice full (+ slash 1) (len full))
          e (fun-effect (mut chk) module name)]
      (when (or (> (len (.writes e)) 0) (> (len (.hooks e)) 0))
        (let [(mut msg) (dsl/join3 "plan " plan-name (dsl/join3 " runs " (.name s) " in parallel, but "))]
          (set! msg (dsl/join3 msg full ""))
          (for w (.writes e)
            (set! msg (dsl/join3 msg (dsl/join2 "\n  writes shared state " (.what w)) (dsl/join2 ", in " (.where w)))))
          (for h (.hooks e)
            (set! msg (dsl/join3 msg "\n  " (dsl/join2 h ", whose effects cannot be known here"))))
          (dsl/die (mut c) (tok-of src at) msg))))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree (match (g/parse-result src path 0)
               (Ok [t] t)
               (Err [e] (dsl/fail-at path (.line e) (.col e) (dsl/join2 "expected " (.want e)))))
        (mut chk) (Checker :entries (manifest-entries (meta/read-context-manifest context))
                           :infos (ArrayList::new [Info] (malloc-allocator))
                           :memo-keys (texts)
                           :memo (ArrayList::new [Effect] (malloc-allocator))
                           :visiting (texts)
                           :depends (texts))
        fills (split-fn (mut c) (tok-of src (kid-of tree 1)))
        record-module (get fills 0)
        record-name (get fills 1)
        (mut stages) (ArrayList::new [Stage] (malloc-allocator))
        (mut arms) (primitive/code-list-new)
        (mut names) (primitive/code-list-new)]
    (for d (.kids (kid-of tree 2))
      (let [(mut fns) (texts)
            per (= (.kind d) (g/KPerStage))
            fn-list (if per (kid-of d 2) (kid-of d 1))]
        (for t (.kids fn-list)
          (split-fn (mut c) (tok-of src t))
          (push! (mut fns) (.text t)))
        (push! (mut stages) (Stage :name (.text (kid-of d 0)) :unit (if per (.text (kid-of d 1)) "whole")
                                   :functions fns :tok (tok-of src d)))))
    (for p (.kids (kid-of tree 3))
      (let [plan-name (.text (kid-of p 0))
            (mut threads) `1
            (mut fields) (primitive/code-list-new)
            (mut parallel) (texts)
            (mut counts) (ArrayList::new [Code] (malloc-allocator))
            (mut parts) (ArrayList::new [Code] (malloc-allocator))]
        (for item (.kids (kid-of p 1))
          (when (= (.kind item) (g/KThreads)) (set! threads (count-code (kid-of item 0)))))
        (for item (.kids (kid-of p 1))
          (match (.kind item)
            (g/KThreads [] 0)
            (_
              (let [sname (.text (kid-of item 0))]
                (match (find-stage stages sname)
                  (None [] (dsl/die (mut c) (tok-of src (kid-of item 0)) (dsl/join2 "no stage named " sname)))
                  (Some [s]
                    (when (= (.kind item) (g/KParallel))
                      (when (= (.unit s) "whole")
                        (dsl/die (mut c) (tok-of src (kid-of item 0))
                                 (dsl/join3 sname " works on the whole program: it has no files or parts to run at once" "")))
                      (check-stage! (mut chk) (mut c) src plan-name s (kid-of item 0))
                      (push! (mut parallel) sname)
                      (push! (mut counts) (if (= (.kind (kid-of item 1)) (g/KNone)) threads (count-code (kid-of item 1))))
                      (push! (mut parts)
                             (if (= (.kind (kid-of item 2)) (g/KNone))
                                 (if (= (.kind (kid-of item 1)) (g/KNone)) threads (count-code (kid-of item 1)))
                                 (count-code (kid-of (kid-of item 2) 0)))))))))))
        ;; Every stage that works in units has a thread count; one that works in parts, a part count.
        (for s stages
          (unless (= (.unit s) "whole")
            (let [(mut at) -1]
              (for i (range 0 (len parallel)) (when (= (get parallel i) (.name s)) (set! at i)))
              (push! (mut fields) (primitive/code-symbol ":" (dsl/join2 (.name s) "-threads")))
              (push! (mut fields) (if (>= at 0) (get counts at) `1))
              (when (= (.unit s) "part")
                (push! (mut fields) (primitive/code-symbol ":" (dsl/join2 (.name s) "-parts")))
                (push! (mut fields) (if (>= at 0) (get parts at) `1))))))
        (push! (mut names) `(push! (mut out) ~plan-name))
        (push! (mut arms) `(= name ~plan-name))
        (push! (mut arms) `(~(primitive/code-symbol "plan-module/" record-name) :name ~plan-name ~@fields))))
    (let [(mut deps) (primitive/code-list-new)]
      (for d (.depends chk) (push! (mut deps) `~d))
      (dsl/render
        `(do
           (import ~record-module :as plan-module)
           (import "hl.rt" :as rt)
           (import "coil.arraylist" :use [ArrayList])
           ~(if (> (len (.depends chk)) 0) `(depends-on ~@deps) `(do))
           (defn plan [(name (slice u8))] (-> ~(primitive/code-symbol "plan-module/" record-name))
             (cond ~@arms :else (panic "no plan named {}" name)))
           (defn plan-names [] (-> (ArrayList (slice u8)))
             (let [(mut out) (ArrayList::new [(slice u8)] (rt/tree-allocator))]
               ~@names
               out)))))))

(defn kid-of [(n g/Node) (i i64)] (-> g/Node) (get (.kids n) i))

(defn read-pipeline [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
