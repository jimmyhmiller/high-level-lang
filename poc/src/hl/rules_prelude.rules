# What every `.rules` file can call without importing anything: domain-free text, files and
# tables, implemented in hl.rt and hl.symtab.
rules hl.prelude

foreign hl.rt as rt {
  type W
  type Names
  record Mark { out: Int, src: Int }
  record Rendered { text: Text, marks: [Mark], open: Bool }
  type Buf

  fn read-file = read-all(path: Text) -> Text
  fn write-file = write-output(path: Text, bytes: Text) -> Void
  fn file-exists?(path: Text) -> Bool
  fn readable-file?(path: Text) -> Bool
  fn dir-listing(path: Text) -> Text
  fn dir-of(path: Text) -> Text
  fn starts-with(s: Text, prefix: Text) -> Bool
  fn ends-with(s: Text, suffix: Text) -> Bool
  fn at?(s: Text, i: Int, what: Text) -> Bool
  fn contains-text?(s: Text, what: Text) -> Bool
  fn unquote = str-content(raw: Text) -> Text
  fn quote-text = quote-str(content: Text) -> Text
  fn int-text = num-text(v: Int) -> Text
  fn parse-int-opt = parse-num(s: Text) -> Int?
  fn parse-int(s: Text) -> Int
  fn digit-byte? = digit-i64?(c: Int) -> Bool
  fn byte-text = text-of-byte(c: Int) -> Text
  fn line-of(src: Text, at: Int) -> Int
  fn col-of(src: Text, at: Int) -> Int
  fn next-pass!() -> Int
  fn unicode-category(cp: Int) -> Text
  fn code-points-of(s: Text) -> [Int]
  fn text-of-points(points: [Int]) -> Text

  fn names-new() -> Names
  fn intern!(names: mut Names, s: Text) -> Int
  fn name-of(names: mut Names, id: Int) -> Text

  fn buf-new() -> Buf
  fn buf-add!(b: mut Buf, s: Text) -> Void
  fn buf-byte!(b: mut Buf, c: Int) -> Void
  fn buf-text(b: mut Buf) -> Text
  fn buf-len(b: mut Buf) -> Int

  fn now-ms() -> Int
  fn now-us() -> Int
  fn arg-count() -> Int
  fn arg-at(i: Int) -> Text
  fn last-parse-path() -> Text
  fn last-parse-line() -> Int
  fn last-parse-col() -> Int
  fn last-parse-want() -> Text
  fn last-parse-found() -> Text
  fn fail-last-parse() -> Never
}

foreign hl.symtab as sym {
  type Table
  record Symbol { name: Text, scope: Int, uses: Int, final: Text, pinned: Bool }
  record Scope { parent: Int, is-function: Bool, names: {Text:Int}, symbols: [Int], children: [Int], dynamic: Bool }
  fn table-new() -> Table
  fn new-scope!(t: mut Table, parent: Int, is-function: Bool) -> Int
  fn declare!(t: mut Table, scope: Int, name: Text) -> Int
  fn generated-symbol!(t: mut Table, scope: Int, name: Text) -> Int
  fn symbol-at(t: Table, s: Int) -> Symbol
  fn scope-at(t: Table, s: Int) -> Scope
  fn symbol-count(t: mut Table) -> Int
  fn set-final!(t: mut Table, s: Int, name: Text) -> Void
  fn free-names(t: mut Table) -> [Text]
  fn take-free!(t: mut Table) -> Void
  fn graft!(t: mut Table, from: mut Table, parent: Int) -> Int
  fn drop-last-child!(t: mut Table, scope: Int) -> Void
  fn has-free?(t: mut Table, name: Text) -> Bool
}
