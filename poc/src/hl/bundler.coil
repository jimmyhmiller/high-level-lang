;;; `.bundler`: the top of the tower. A spec names the languages a build is made from
;;; and describes its targets. It compiles to a program: each target is a function
;;; filling in `api/Options`, so settings cost nothing at run time, and each plugin is a
;;; direct call into a module another language generated.
;;;
;;;   bundler
;;;   use rewrite strip-debug = plugins.strip-debug
;;;   use rewrite minify = bundle.minify
;;;   use coil banner = myproject.passes/banner
;;;
;;;   target client
;;;     entry "app/main.js"
;;;     outfile "dist/client.js"
;;;     format iife
;;;     define SERVER = false
;;;     define process.env.NODE_ENV = "production"
;;;     main-fields module main
;;;     conditions import browser
;;;     minify
;;;     transform strip-debug          # each file, before linking
;;;     optimize minify                # the whole program, for --minify-syntax
;;;   end
;;;
;;; Every step named must be declared by `use`, and each setting is checked here, so a
;;; typo is a located error in this file.
(module hl.bundler)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)

(reader-provider "hl.bundler" read-bundler)

;;; A step: the module holding it, and the function to call.
(defstruct Pass [(name (slice u8)) (module (slice u8)) (function (slice u8))])

(defn split-function [(c (mut dsl/Cur)) (t rt/Tok)] (-> Pass)
  (let [s (.text t) (mut cut) -1]
    (for i (range 0 (len s)) (when (= (get s i) #\/) (set! cut i)))
    (when (< cut 0)
      (dsl/die (mut c) t "expected module/function"))
    (Pass :name "" :module (subslice s 0 cut) :function (subslice s (+ cut 1) (len s)))))

(defn alias-sym [(p Pass)] (-> Code) (primitive/code-symbol "pass-" (.name p)))
(defn call-sym [(p Pass)] (-> Code)
  (primitive/code-symbol (dsl/join3 (dsl/join2 "pass-" (.name p)) "/" (.function p))))

(defn find-pass [(passes (ArrayList Pass)) (n (slice u8))] (-> (Option Pass))
  (let [(mut out) (None [Pass])]
    (for p passes (when (= (.name p) n) (set! out (Some p))))
    out))

;;; Words up to the end of a line-ish clause: until the next clause keyword.
(defn clause-word? [(c (mut dsl/Cur))] (-> bool)
  (let [t (dsl/peek (mut c))]
    (and (= (.kind t) (rt/TIdent))
         (not (or (dsl/at? (mut c) "entry") (dsl/at? (mut c) "outfile") (dsl/at? (mut c) "format")
                  (dsl/at? (mut c) "global") (dsl/at? (mut c) "define") (dsl/at? (mut c) "main-fields")
                  (dsl/at? (mut c) "conditions") (dsl/at? (mut c) "minify") (dsl/at? (mut c) "pretty")
                  (dsl/at? (mut c) "transform") (dsl/at? (mut c) "optimize") (dsl/at? (mut c) "end"))))))

(defn read-words [(c (mut dsl/Cur))] (-> (ArrayList rt/Tok))
  (let [(mut out) (ArrayList::new [rt/Tok] (malloc-allocator))]
    (while (clause-word? (mut c)) (push! (mut out) (dsl/advance! (mut c))))
    out))

;;; A define's value, as the JavaScript text the build will parse.
(defn define-value [(c (mut dsl/Cur)) (v rt/Tok)] (-> (slice u8))
  (cond
    (= (.kind v) (rt/TStr)) (dsl/join3 "\"" (.text v) "\"")
    (= (.kind v) (rt/TNum)) (.text v)
    (= (.kind v) (rt/TIdent)) (.text v)
    :else (dsl/die (mut c) v "a define's value is a name, a number or a string")))

;;; A pass wrapper the options can hold as a function pointer: the composition of the
;;; named steps, resolved here, so a build pays one direct call per step.
(defn pipeline-fn [(name Code) (steps (ArrayList Pass))] (-> Code)
  (let [(mut body) `(load in)]
    (for p steps (set! body `(~(call-sym p) ~body)))
    `(defn ~name [(in (ptr syn/Node)) (out (ptr syn/Node))] (-> void)
       (store! out ~body))))

(defn read-steps [(c (mut dsl/Cur)) (passes (ArrayList Pass))] (-> (ArrayList Pass))
  (let [(mut out) (ArrayList::new [Pass] (malloc-allocator))]
    (for t (read-words (mut c))
      (match (find-pass passes (.text t))
        (Some [p] (push! (mut out) p))
        (None [] (dsl/die (mut c) t (dsl/join3 "no step named " (.text t) "; declare it with `use`")))))
    out))

;;; One `target … end`: its helper functions, then a function that builds it.
(defn read-target [(c (mut dsl/Cur)) (passes (ArrayList Pass)) (names (mut (ArrayList (slice u8))))] (-> Code)
  (let [start (dsl/name! (mut c) "a target name")
        name (.text start)
        (mut entry) ""
        (mut outfile) ""
        (mut sets) (primitive/code-list-new)
        (mut forms) (primitive/code-list-new)
        (mut go) true]
    (while go
      (let [t (dsl/peek (mut c))]
        (cond
          (dsl/accept! (mut c) "end") (set! go false)
          (dsl/accept! (mut c) "entry")
            (set! entry (.text (dsl/string! (mut c) "an entry path")))
          (dsl/accept! (mut c) "outfile")
            (set! outfile (.text (dsl/string! (mut c) "an output path")))
          (dsl/accept! (mut c) "format")
            (let [f (dsl/name! (mut c) "iife, esm or cjs")]
              (cond
                (= (.text f) "iife") (push! (mut sets) `(set! (.format o) (api/Iife)))
                (= (.text f) "esm") (push! (mut sets) `(set! (.format o) (api/Esm)))
                (= (.text f) "cjs") (push! (mut sets) `(set! (.format o) (api/Cjs)))
                :else (dsl/die (mut c) f "the format is iife, esm or cjs")))
          (dsl/accept! (mut c) "global")
            (let [g (dsl/string! (mut c) "a global name")]
              (push! (mut sets) `(set! (.global-name o) ~(.text g))))
          (dsl/accept! (mut c) "define")
            (let [key (dsl/name! (mut c) "a name to define")]
              (dsl/expect! (mut c) "=")
              (let [v (dsl/advance! (mut c))]
                (push! (mut sets) `(api/define! (mut o) ~(.text key) ~(define-value (mut c) v)))))
          (dsl/accept! (mut c) "main-fields")
            (let [(mut pushes) (primitive/code-list-new)]
              (for w (read-words (mut c)) (push! (mut pushes) `(push! (mut (.main-fields o)) ~(.text w))))
              (push! (mut sets) `(set! (.main-fields o) (api/clear-words)))
              (push! (mut sets) `(do ~@pushes)))
          (dsl/accept! (mut c) "conditions")
            (let [(mut pushes) (primitive/code-list-new)]
              (for w (read-words (mut c)) (push! (mut pushes) `(push! (mut (.conditions o)) ~(.text w))))
              (push! (mut sets) `(set! (.conditions o) (api/clear-words)))
              (push! (mut sets) `(do ~@pushes)))
          (dsl/accept! (mut c) "minify")
            (let [parts (read-words (mut c))]
              (if (= (len parts) 0)
                  (do
                    (push! (mut sets) `(set! (.minify-identifiers o) true))
                    (push! (mut sets) `(set! (.minify-syntax o) true)))
                  (for w parts
                    (cond
                      (= (.text w) "identifiers") (push! (mut sets) `(set! (.minify-identifiers o) true))
                      (= (.text w) "syntax") (push! (mut sets) `(set! (.minify-syntax o) true))
                      :else (dsl/die (mut c) w "minify takes identifiers and syntax, or nothing for both")))))
          (dsl/accept! (mut c) "pretty") (push! (mut sets) `(set! (.pretty o) true))
          (dsl/accept! (mut c) "transform")
            (let [fname (primitive/code-symbol (dsl/join2 name "-transform"))]
              (push! (mut forms) (pipeline-fn fname (read-steps (mut c) passes)))
              (push! (mut sets) `(set! (.transform o) (Some (fnptr-of ~fname)))))
          (dsl/accept! (mut c) "optimize")
            (let [fname (primitive/code-symbol (dsl/join2 name "-optimize"))]
              (push! (mut forms) (pipeline-fn fname (read-steps (mut c) passes)))
              (push! (mut sets) `(set! (.optimize o) (Some (fnptr-of ~fname)))))
          :else (dsl/die (mut c) t (dsl/join2 "expected a target setting, found " (.text t))))))
    (when (= (len entry) 0) (dsl/die (mut c) start (dsl/join3 "target " name " has no entry")))
    (when (= (len outfile) 0) (dsl/die (mut c) start (dsl/join3 "target " name " has no outfile")))
    (push! (mut names) name)
    `(do
       ~@forms
       (defn ~(primitive/code-symbol "build-" name) [] (-> void)
         (println "target {}" ~name)
         (let [(mut o) (api/options-new ~entry ~outfile)]
           ~@sets
           (api/build o))))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [(mut c) (dsl/cursor (dsl/source-of context) (dsl/path-of context) "=")
        (mut passes) (ArrayList::new [Pass] (malloc-allocator))
        (mut targets) (primitive/code-list-new)
        (mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut calls) (primitive/code-list-new)
        (mut imports) (primitive/code-list-new)]
    (dsl/expect! (mut c) "bundler")
    (while (dsl/accept! (mut c) "use")
      (let [sort (dsl/name! (mut c) "rewrite or coil")
            n (dsl/name! (mut c) "a step name")]
        (dsl/expect! (mut c) "=")
        (let [target (dsl/name! (mut c) "a module")
              p (cond
                  (= (.text sort) "rewrite")
                    (Pass :name (.text n) :module (.text target) :function "run")
                  (= (.text sort) "coil")
                    (let [split (split-function (mut c) target)]
                      (Pass :name (.text n) :module (.module split) :function (.function split)))
                  :else (dsl/die (mut c) sort "expected rewrite or coil"))]
          (push! (mut passes) p)
          (push! (mut imports) `(import ~(.module p) :as ~(alias-sym p))))))
    (while (dsl/accept! (mut c) "target")
      (push! (mut targets) (read-target (mut c) passes (mut names))))
    (unless (dsl/eof? (mut c))
      (dsl/die (mut c) (dsl/peek (mut c)) "expected target"))
    (for n names
      (push! (mut calls) `(~(primitive/code-symbol "build-" n))))
    (dsl/render
      `(do
         (import "bundle.js" :as syn)
         (import "bundle.api" :as api)
         ~@imports
         ~@targets
         (defn build-all [] (-> void) ~@calls)))))

(defn read-bundler [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
