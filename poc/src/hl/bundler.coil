;;; `.bundler`: the top of the tower. A spec names the languages a build is made from, defines
;;; its output formats and describes its targets. It compiles to a program: each target is a
;;; function filling in `api/Options`, so settings cost nothing at run time, and each step is a
;;; direct call into a module another language generated.
;;;
;;;   bundler
;;;   use rewrite strip-debug = plugins.strip-debug
;;;   use rewrite minify = bundle.minify
;;;   use rules virtual = myproject.plugins/virtual-files
;;;   use rules banner = myproject.passes/banner
;;;
;;;   format umd                       # a format is written here, not chosen from a list
;;;     prefix "(function(){"
;;;     suffix "})();\n"
;;;     exports "globalThis.lib = %;"  # % is the entry's namespace object
;;;   end
;;;
;;;   target client
;;;     entry "app/main.js"
;;;     outfile "dist/client.js"
;;;     format umd
;;;     define SERVER = false
;;;     alias "react" = "preact/compat"
;;;     loader ".txt" = text
;;;     banner "/* mine */"
;;;     tree-shaking off
;;;     language es2017                # the oldest JavaScript the output may need
;;;     jsx automatic                  # or transform, preserve; also jsx-factory, jsx-fragment,
;;;                                    # jsx-import-source, jsx-dev
;;;     on-resolve virtual             # called first for every import
;;;     on-load virtual-source         # may supply a file's text
;;;     transform strip-debug          # each file, before linking
;;;     optimize minify                # the whole program, for --minify-syntax
;;;   end
;;;
;;; Every step named must be declared by `use`, and each setting is checked here, so a
;;; typo is a located error in this file.
(module hl.bundler)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.grammars.bundler" :as g)

(reader-provider "hl.bundler" read-bundler)

;;; A step: the module holding it, and the function to call.
(defstruct Pass [(name (slice u8)) (module (slice u8)) (function (slice u8))])

(defn tok-of [(src (slice u8)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col src (.lo n))]
    (rt/Tok :kind (rt/TIdent) :text (.text n) :line (.line at) :col (.col at))))

(defn split-function [(c (mut dsl/Cur)) (t rt/Tok)] (-> Pass)
  (let [s (.text t) (mut cut) -1]
    (for i (range 0 (len s)) (when (= (get s i) #\/) (set! cut i)))
    (when (< cut 0)
      (dsl/die (mut c) t "expected module/function"))
    (Pass :name "" :module (subslice s 0 cut) :function (subslice s (+ cut 1) (len s)))))

(defn alias-sym [(p Pass)] (-> Code) (primitive/code-symbol "pass-" (.name p)))
(defn call-sym [(p Pass)] (-> Code)
  (primitive/code-symbol (dsl/join3 (dsl/join2 "pass-" (.name p)) "/" (.function p))))

(defn find-pass [(passes (ArrayList Pass)) (n (slice u8))] (-> (Option Pass))
  (let [(mut out) (None [Pass])]
    (for p passes (when (= (.name p) n) (set! out (Some p))))
    out))

;;; The composition of the named steps, resolved here, so a build pays one direct call per step.
(defn pipeline-fn [(name Code) (steps (ArrayList Pass))] (-> Code)
  (let [(mut body) `in]
    (for p steps (set! body `(~(call-sym p) ~body)))
    `(defn ~name [(in syn/Node)] (-> syn/Node) ~body)))

(defn steps-of [(c (mut dsl/Cur)) (src (slice u8)) (list g/Node) (passes (ArrayList Pass))] (-> (ArrayList Pass))
  (let [(mut out) (ArrayList::new [Pass] (malloc-allocator))]
    (for t (.kids list)
      (match (find-pass passes (.text t))
        (Some [p] (push! (mut out) p))
        (None [] (dsl/die (mut c) (tok-of src t) (dsl/join3 "no step named " (.text t) "; declare it with `use`")))))
    out))

;;; The Str token's content, or a Name or Num as it stands: JavaScript text for a define.
(defn define-text [(v g/Node)] (-> (slice u8)) (.text v))

(defn str-of [(n g/Node)] (-> (slice u8)) (dsl/unescape (subslice (.text n) 1 (- (len (.text n)) 1))))

(defn word-pushes [(list g/Node) (field (slice u8))] (-> Code)
  (let [(mut pushes) (primitive/code-list-new)
        access (primitive/code-symbol "." field)]
    (for w (.kids list) (push! (mut pushes) `(push! (mut (~access o)) ~(.text w))))
    `(do (set! (~access o) (api/clear-words)) ~@pushes)))

;;; One `target … end`: its helper functions, then a function that builds it.
(defn compile-target [(c (mut dsl/Cur)) (src (slice u8)) (target g/Node) (passes (ArrayList Pass)) (formats (ArrayList (slice u8))) (names (mut (ArrayList (slice u8))))] (-> Code)
  (let [start (get (.kids target) 0)
        name (.text start)
        (mut entry) ""
        (mut outfile) ""
        (mut sets) (primitive/code-list-new)
        (mut forms) (primitive/code-list-new)]
    (for s (.kids (get (.kids target) 1))
      (match (.kind s)
        (g/KEntry [] (set! entry (str-of (get (.kids s) 0))))
        (g/KOutfile [] (set! outfile (str-of (get (.kids s) 0))))
        (g/KFormat []
          (let [f (get (.kids s) 0)]
            (unless (has-format? formats (.text f))
              (dsl/die (mut c) (tok-of src f)
                       (dsl/join3 "no format named " (.text f) "; define one with `format … end`")))
            (push! (mut sets) `(set! (.format o) (~(format-sym (.text f)))))))
        (g/KGlobal [] (push! (mut sets) `(set! (.global-name o) ~(str-of (get (.kids s) 0)))))
        (g/KDefine []
          (push! (mut sets) `(api/define! (mut o) ~(.text (get (.kids s) 0)) ~(define-text (get (.kids s) 1)))))
        (g/KMainFields [] (push! (mut sets) (word-pushes (get (.kids s) 0) "main-fields")))
        (g/KConditions [] (push! (mut sets) (word-pushes (get (.kids s) 0) "conditions")))
        (g/KMinify []
          (let [parts (.kids (get (.kids s) 0))]
            (if (= (len parts) 0)
                (do
                  (push! (mut sets) `(set! (.minify-identifiers o) true))
                  (push! (mut sets) `(set! (.minify-syntax o) true)))
                (for w parts
                  (cond
                    (= (.text w) "identifiers") (push! (mut sets) `(set! (.minify-identifiers o) true))
                    (= (.text w) "syntax") (push! (mut sets) `(set! (.minify-syntax o) true))
                    :else (dsl/die (mut c) (tok-of src w) "minify takes identifiers and syntax, or nothing for both"))))))
        (g/KPretty [] (push! (mut sets) `(set! (.pretty o) true)))
        (g/KSourcemap [] (push! (mut sets) `(set! (.sourcemap o) true)))
        (g/KPlatform []
          (let [f (get (.kids s) 0)]
            (cond
              (= (.text f) "node") (push! (mut sets) `(api/platform-node! (mut o)))
              (= (.text f) "browser") 0
              :else (dsl/die (mut c) (tok-of src f) "the platform is browser or node"))))
        (g/KExternal []
          (let [(mut pushes) (primitive/code-list-new)]
            (for w (.kids (get (.kids s) 0))
              (push! (mut pushes) `(push! (mut (.external o)) ~(.text w))))
            (push! (mut sets) `(do ~@pushes))))
        (g/KAlias []
          (push! (mut sets) `(api/alias! (mut o) ~(str-of (get (.kids s) 0)) ~(str-of (get (.kids s) 1)))))
        (g/KLoader []
          (let [kind (.text (get (.kids s) 1))]
            (unless (or (= kind "js") (= kind "json") (= kind "text") (= kind "base64") (= kind "dataurl") (= kind "empty") (= kind "jsx") (= kind "ts") (= kind "tsx") (= kind "css") (= kind "file"))
              (dsl/die (mut c) (tok-of src (get (.kids s) 1)) "the loader is js, jsx, ts, tsx, css, json, text, base64, dataurl, file or empty"))
            (push! (mut sets) `(api/loader! (mut o) ~(str-of (get (.kids s) 0)) ~kind))))
        (g/KBanner [] (push! (mut sets) `(set! (.banner o) ~(str-of (get (.kids s) 0)))))
        (g/KFooter [] (push! (mut sets) `(set! (.footer o) ~(str-of (get (.kids s) 0)))))
        (g/KTreeShaking []
          (let [v (.text (get (.kids s) 0))]
            (cond
              (= v "on") 0
              (= v "off") (push! (mut sets) `(set! (.tree-shaking o) false))
              :else (dsl/die (mut c) (tok-of src (get (.kids s) 0)) "tree-shaking is on or off"))))
        (g/KJsx []
          (let [v (.text (get (.kids s) 0))]
            (unless (or (= v "transform") (= v "automatic") (= v "preserve"))
              (dsl/die (mut c) (tok-of src (get (.kids s) 0)) "jsx is transform, automatic or preserve"))
            (push! (mut sets) `(api/jsx-runtime! (mut o) ~v))))
        (g/KJsxFactory [] (push! (mut sets) `(api/jsx-factory! (mut o) ~(str-of (get (.kids s) 0)))))
        (g/KJsxFragment [] (push! (mut sets) `(api/jsx-fragment! (mut o) ~(str-of (get (.kids s) 0)))))
        (g/KJsxImportSource [] (push! (mut sets) `(api/jsx-import-source! (mut o) ~(str-of (get (.kids s) 0)))))
        (g/KJsxDev [] (push! (mut sets) `(api/jsx-dev! (mut o))))
        (g/KSyntaxTarget [] (push! (mut sets) `(api/target! (mut o) ~(.text (get (.kids s) 0)))))
        (g/KOnResolve []
          (for p (steps-of (mut c) src (get (.kids s) 0) passes)
            (push! (mut sets) `(push! (mut (.on-resolve o)) (fnptr-of ~(call-sym p))))))
        (g/KOnLoad []
          (for p (steps-of (mut c) src (get (.kids s) 0) passes)
            (push! (mut sets) `(push! (mut (.on-load o)) (fnptr-of ~(call-sym p))))))
        (g/KTransform []
          (let [fname (primitive/code-symbol (dsl/join2 name "-transform"))]
            (push! (mut forms) (pipeline-fn fname (steps-of (mut c) src (get (.kids s) 0) passes)))
            (push! (mut sets) `(set! (.transform o) (fnptr-of ~fname)))
            (push! (mut sets) `(set! (.has-transform o) true))))
        (g/KOptimize []
          (let [fname (primitive/code-symbol (dsl/join2 name "-optimize"))]
            (push! (mut forms) (pipeline-fn fname (steps-of (mut c) src (get (.kids s) 0) passes)))
            (push! (mut sets) `(set! (.optimize o) (fnptr-of ~fname)))))
        (_ (dsl/die (mut c) (tok-of src s) "this setting is not handled"))))
    (when (= (len entry) 0) (dsl/die (mut c) (tok-of src start) (dsl/join3 "target " name " has no entry")))
    (when (= (len outfile) 0) (dsl/die (mut c) (tok-of src start) (dsl/join3 "target " name " has no outfile")))
    (push! (mut names) name)
    `(do
       ~@forms
       (defn ~(primitive/code-symbol "build-" name) [] (-> void)
         (println "target {}" ~name)
         (let [(mut o) (api/options-new ~entry ~outfile)]
           ~@sets
           (api/build o))))))

(defn format-sym [(n (slice u8))] (-> Code) (primitive/code-symbol "format-" n))

(defn has-format? [(formats (ArrayList (slice u8))) (n (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for f formats (when (= f n) (set! hit true)))
    hit))

;;; `format x … end`, as a function answering the description `api/build` follows.
(defn compile-format [(c (mut dsl/Cur)) (src (slice u8)) (d g/Node)] (-> Code)
  (let [name (.text (get (.kids d) 0))
        (mut prefix) ""
        (mut suffix) ""
        (mut exports) ""
        (mut names) false
        (mut hoist) false]
    (for part (.kids (get (.kids d) 1))
      (match (.kind part)
        (g/KPrefix [] (set! prefix (str-of (get (.kids part) 0))))
        (g/KSuffix [] (set! suffix (str-of (get (.kids part) 0))))
        (g/KExportsVia [] (set! exports (str-of (get (.kids part) 0))))
        (g/KExportsNames [] (set! names true))
        (g/KHoistExternals [] (set! hoist true))
        (_ (dsl/die (mut c) (tok-of src part) "this part of a format is not handled"))))
    `(defn ~(format-sym name) [] (-> api/Format)
       (api/Format :prefix ~prefix :suffix ~suffix :exports ~exports
                   :export-names ~names :hoist-externals ~hoist))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree (match (g/parse-result src path 0)
               (Ok [t] t)
               (Err [e] (dsl/fail-at path (.line e) (.col e) (dsl/join2 "expected " (.want e)))))
        (mut passes) (ArrayList::new [Pass] (malloc-allocator))
        (mut targets) (primitive/code-list-new)
        (mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut calls) (primitive/code-list-new)
        (mut imports) (primitive/code-list-new)
        (mut format-code) `(do)]
    (for u (.kids (get (.kids tree) 0))
      (let [sort (get (.kids u) 0)
            n (get (.kids u) 1)
            target (get (.kids u) 2)
            p (cond
                (= (.text sort) "rewrite")
                  (Pass :name (.text n) :module (.text target) :function "run")
                (= (.text sort) "rules")
                  (let [split (split-function (mut c) (tok-of src target))]
                    (Pass :name (.text n) :module (.module split) :function (.function split)))
                :else (dsl/die (mut c) (tok-of src sort) "expected rewrite or rules"))]
        (push! (mut passes) p)
        (push! (mut imports) `(import ~(.module p) :as ~(alias-sym p)))))
    (let [(mut formats) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut format-forms) (primitive/code-list-new)]
      (for name ["iife" "esm" "cjs"]
        (push! (mut formats) name)
        (push! (mut format-forms)
               `(defn ~(format-sym name) [] (-> api/Format)
                  (~(primitive/code-symbol "api/" name "-format")))))
      (for d (.kids (get (.kids tree) 1))
        (push! (mut formats) (.text (get (.kids d) 0)))
        (push! (mut format-forms) (compile-format (mut c) src d)))
      (for t (.kids (get (.kids tree) 2))
        (push! (mut targets) (compile-target (mut c) src t passes formats (mut names))))
      (for n names
        (push! (mut calls) `(~(primitive/code-symbol "build-" n))))
      (set! format-code `(do ~@format-forms)))
    (dsl/render
      `(do
         (import "bundle.js" :as syn)
         (import "bundle.api" :as api)
         (import "hl.rt" :as rt)
         ~@imports
         ~format-code
         ~@targets
         (defn build-all [] (-> void) ~@calls)
         (defn bundler-worker [(arg (ptr i8))] (-> (ptr i8)) (build-all) arg)
         (defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
           (rt/args-init! argc argv)
           (rt/run-on-big-stack (fnptr-of bundler-worker))
           0)))))

(defn read-bundler [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
