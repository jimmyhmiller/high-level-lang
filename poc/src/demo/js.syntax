# The fragment of JavaScript the demo bundler handles.
syntax
comment "//"
start Program

rule Program = Stmt* -> Program ;

rule Stmt
  = "import" "{" Ident,* "}" "from" Str ";" -> Import
  | "export" Stmt -> Export
  | "const" Ident "=" Expr ";" -> Const
  | "function" Ident "(" Ident,* ")" Block -> Func
  | "return" Expr ";" -> Return
  | "if" "(" Expr ")" Block "else" Block -> If
  | "if" "(" Expr ")" Block -> IfOnly
  | Expr ";" -> ExprStmt
  | Block
  ;

rule Block = "{" Stmt* "}" -> Block ;

infix Expr over Unary
  left "||" Or
  left "&&" And
  left "===" StrictEq "!==" StrictNeq
  left "+" Add "-" Sub
  left "*" Mul "/" Div
  ;

rule Unary = "!" Unary -> Not | "-" Unary -> Neg | Postfix ;

postfix Postfix over Primary
  "(" Expr,* ")" -> Call
  | "." Ident -> Member
  ;

rule Primary
  = Num
  | Str
  | "true" -> True
  | "false" -> False
  | Ident
  | "(" Expr ")"
  ;
