# The whole build, at the top of the tower.
bundler
syntax demo.js
load demo.link/load-entry

use rewrite minify = demo.minify
use rewrite strip-debug = demo.strip-debug
use coil shake = demo.treeshake/shake

target client
  entry "app/main.js"
  define SERVER = false
  define CLIENT = true
  run define strip-debug minify shake
  emit "dist/client.js" compact
end

target server
  entry "app/main.js"
  define SERVER = true
  define CLIENT = false
  run define minify shake
  emit "dist/server.js" pretty
end
