rewrite demo.js

rule fold-add  : Add(Num(a), Num(b)) => Num(a + b) ;
rule fold-sub  : Sub(Num(a), Num(b)) => Num(a - b) ;
rule fold-mul  : Mul(Num(a), Num(b)) => Num(a * b) ;

rule not-true  : Not(True())  => False() ;
rule not-false : Not(False()) => True() ;

rule and-true  : And(True(), x)  => x ;
rule and-false : And(False(), _) => False() ;
rule or-true   : Or(True(), _)   => True() ;
rule or-false  : Or(False(), x)  => x ;

rule if-true   : If(True(), t, _)  => t ;
rule if-false  : If(False(), _, e) => e ;
rule only-true : IfOnly(True(), t) => t ;
rule only-false: IfOnly(False(), _) => Block(List()) ;
