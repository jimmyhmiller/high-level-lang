;;; The bundler the demo spec describes. Everything it does is decided by build.bundler.
(module app.main)
(import "bundle.api" :as api)
(import "app.build" :as build)

(defn worker [(arg (ptr i8))] (-> (ptr i8))
  (build/build-all)
  arg)

(defn main [] (-> i64)
  (api/run-on-big-stack (fnptr-of worker))
  0)
