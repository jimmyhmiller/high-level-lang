# The TypeScript a route tree is written in (TanStack Router's routeTree.gen.ts, as its generator
# writes it before formatting): imports, constants made of calls, member chains, arrows, objects and
# `as` casts, interfaces and a module declaration of types, and comments between statements. What
# `tanstack.pretty` prints as Prettier would; a header or footer that is not one of these is an error.
syntax
start File
space Space
word NameChar

fragment Space = [ \t\n\r]* ;
fragment NameChar = [a-zA-Z0-9_$] ;
fragment Keyword = ("import" | "from" | "const" | "export" | "interface" | "declare" | "module" | "typeof" | "as") !NameChar ;
token Name = !Keyword [a-zA-Z_$] NameChar* ;
token Str = "'" ("\\" . | [^'\\\n])* "'" | "\"" ("\\" . | [^"\\\n])* "\"" ;
token LineComment = "//" [^\n]* ;
token BlockComment = "/*" (!"*/" .)* "*/" ;

rule File = Item* -> File(items) ;
rule Item
  = LineComment
  | BlockComment
  | Statement
  ;
rule Statement
  = "import" "{" Specifier,* "}" "from" Str ";"? -> Import(specifiers, source, end)
  | "export" Declaration -> Export(declaration)
  | Declaration
  ;
rule Specifier = Name "as" Name -> Renamed(imported, local) | Name -> Same(name) ;
rule Declaration
  = "const" Name ":" Type "=" Expr ";"? -> TypedConst(name, type, value, end)
  | "const" Name "=" Expr ";"? -> Const(name, value, end)
  | "interface" Name "{" Member* "}" -> Interface(name, members)
  | "declare" "module" Str "{" Statement* "}" -> Module(name, body)
  ;
# Members of an interface or a type literal: separated by commas, semicolons or newlines.
rule Member = Key ":" Type Separator? -> Member(key, type, separator) ;
rule Separator = "," -> Comma | ";" -> Semicolon ;
rule Key = Str | Name ;

rule Type = Atom Alternative+ -> Union(first, rest) | Atom ;
rule Alternative = "|" Atom -> Alternative(type) ;
rule Atom
  = "typeof" Name -> TypeOf(name)
  | "{" Member* "}" -> TypeLiteral(members)
  | Str -> LiteralType(value)
  | Name -> TypeName(name)
  ;

rule Expr = Arrow | Chain ;
rule Arrow = "(" Name,* ")" "=>" Expr -> Arrow(params, body) ;
rule Chain = Primary Link* -> Chain(head, links) ;
rule Link
  = "." Name -> Dot(name)
  | "<" Type ">" "(" Argument,* ")" -> TypedCall(type, arguments)
  | "(" Argument,* ")" -> Call(arguments)
  ;
rule Argument = Expr "as" Type -> As(expression, type) | Expr ;
rule Primary
  = "import" "(" Str ")" -> ImportCall(source)
  | "{" Property,* ","? "}" -> Object(properties, comma)
  | Str
  | Name
  ;
rule Property = Name ":" Argument -> Property(key, value) ;
