# TanStack Router as a part of a build (`esb … --tanstack-router[=DIR]`): what TanStack's bundler
# plugin does, given the same configuration it reads. DIR (the working directory when not given) is
# the project's root, where `tsr.config.json` is, if there is one.
rules tanstack.plugin
use bundle.api as api
use bundle.package as pkg
use bundle.resolve as res
use tanstack.split as split

# What a project's tsr.config.json says, and the defaults where it says nothing.
record Config { root: Text, routes: Text, ignore: Text, target: Text, splitting: Bool, groupings: [[Text]], delete: [Text] }

fn config-of(root: Text) -> Config = match res.existing(path-normalize(root ++ "/tsr.config.json")) {
  none => config-from(root, pkg.parse("{}", "<defaults>"))
  some(file) => config-from(root, pkg.parse(read-file(file), file))
}

fn config-from(root: Text, doc: pkg.Node) -> Config =
  Config(root: root, routes: path-normalize(root ++ "/" ++ (res.text-member(doc, "routesDirectory") ?? "./src/routes")),
         ignore: res.text-member(doc, "routeFileIgnorePrefix") ?? "-",
         target: target, splitting: flag(doc, "autoCodeSplitting") ?? true,
         groupings: (first o in res.member(doc, "codeSplittingOptions") for g in res.member(o, "defaultBehavior"): groupings(g)) ?? split.default-groupings(),
         delete: (first o in res.member(doc, "codeSplittingOptions") for d in res.member(o, "deleteNodes"): texts(d, "deleteNodes")) ?? [])
  where target = match res.text-member(doc, "target") ?? "react" {
    "react" | "solid" | "vue" as t => t
    t => fail-build("tsr.config.json: target is react, solid or vue, not " ++ t)
  }

fn flag(doc: pkg.Node, key: Text) -> Bool? = match res.member(doc, key) {
  some(pkg.True()) => some(true)
  some(pkg.False()) => some(false)
  none => none
  _ => fail-build("tsr.config.json: " ++ key ++ " is true or false")
}

fn groupings(g: pkg.Node) -> [[Text]] = match g {
  pkg.Array(List(groups...)) => [texts(x, "codeSplittingOptions.defaultBehavior") for x in groups]
  _ => fail-build("tsr.config.json: codeSplittingOptions.defaultBehavior is an array of arrays of option names")
}

fn texts(a: pkg.Node, what: Text) -> [Text] = match a {
  pkg.Array(List(xs...)) => [match x { pkg.Str(raw) => unquote(raw)  _ => fail-build("tsr.config.json: " ++ what ++ " holds strings") } for x in xs]
  _ => fail-build("tsr.config.json: " ++ what ++ " is an array")
}

fn split-options(c: Config) -> split.Options =
  split.Options(routes: c.routes, ignore: c.ignore, package: "@tanstack/" ++ c.target ++ "-router", groupings: c.groupings, delete: c.delete)

# A build's options with the plugin's hooks in them. Splitting places statements apart
# (`--fragments`), which is what keeps a split option's value from loading with its route; and what
# a route's own chunk reads that the page has loaded already is read from where it is
# (`--chunk-already-loaded`), as Vite's build has it, not put in a chunk of its own. Modules
# initialize in the order they would unbundled (`--strict-execution-order`): a route whose code
# stayed with the entry would otherwise run after the chunks the entry imports.
fn with-plugin(o: api.Options, c: Config) -> api.Options = match c.splitting {
  false => o
  true => o with { on-resolve: o.on-resolve ++ [split.resolved], on-load: o.on-load ++ [split.loaded],
                   transforms: o.transforms ++ [split.split-route],
                   chunking: o.chunking with { fragments: true, already-loaded: true }, strict-execution-order: true }
}
