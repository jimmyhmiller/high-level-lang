# TanStack Router's generator configuration (router-generator's config.js): `tsr.config.json` in the
# project's root, over the defaults its schema gives. Every option means here what it means there;
# one that needs JavaScript to run (a regular expression, a virtual route configuration, plugins)
# is an error that names it, never passed over.
rules tanstack.config
use bundle.package as pkg

record Config {
  root: Text,
  target: Text,
  # Absolute paths.
  routes-dir: Text,
  tree-path: Text,
  route-file-prefix: Text,
  ignore-prefix: Text,
  single-quote: Bool,
  semicolons: Bool,
  header: [Text],
  footer: [Text],
  index-token: Text,
  route-token: Text,
  disable-types: Bool,
  # addExtensions: false, true, or the extension to write ("" for false, "*" for true).
  add-extensions: Text,
  formatting: Bool,
  absolute-imports: Bool,
  auto-code-splitting: Bool,
  route-template: Text?,
  lazy-route-template: Text?,
  # Route files left out of the tree (Start's browser tree leaves out routes only the server has).
  pruned: [Text]
}

fn default-header() -> [Text] = ["/* eslint-disable */", "// @ts-nocheck", "// noinspection JSUnusedGlobalSymbols"]

# The configuration for a project rooted at `root`: its tsr.config.json, or the defaults.
fn read(root: Text) -> Config = match refused(members, file) {
  false => checked(made(root, members, file))
  true => fail-build(file ++ ": unsupported configuration")
} where file = in-dir(root, "tsr.config.json"),
        members = if readable-file?(file) then object-members(pkg.parse(read-file(file), file), file) else {}

fn in-dir(dir: Text, name: Text) -> Text = if ends-with(dir, "/") then dir ++ name else dir ++ "/" ++ name

fn object-members(doc: pkg.Node, file: Text) -> {Text:pkg.Node} = match doc {
  pkg.Object(List(ms...)) => {json-text(m.key.text): m.value for m in ms}
  _ => fail-build(file ++ ": the configuration is not a JSON object")
}

# path.resolve(root, p): a path made absolute against the root, normalized.
fn resolved(root: Text, p: Text) -> Text = match starts-with(p, "/") {
  true => path-normalize(p)
  false => path-normalize(in-dir(root, p))
}

fn made(root: Text, ms: {Text:pkg.Node}, file: Text) -> Config =
  Config(root: root, target: target, routes-dir: resolved(root, text-of(ms, "routesDirectory", "./src/routes", file)),
         tree-path: resolved(root, tree), route-file-prefix: text-of(ms, "routeFilePrefix", "", file),
         ignore-prefix: text-of(ms, "routeFileIgnorePrefix", "-", file),
         single-quote: quote == "single", semicolons: bool-of(ms, "semicolons", false, file),
         header: texts-of(ms, "routeTreeFileHeader", default-header(), file), footer: texts-of(ms, "routeTreeFileFooter", [], file),
         index-token: token-of(ms, "indexToken", "index", file), route-token: token-of(ms, "routeToken", "route", file),
         disable-types: disable-types, add-extensions: extensions-of(ms, file),
         formatting: bool-of(ms, "enableRouteTreeFormatting", true, file),
         absolute-imports: bool-of(ms, "importRoutesUsingAbsolutePaths", false, file),
         auto-code-splitting: bool-of(ms, "autoCodeSplitting", false, file),
         route-template: scaffold-of(ms, "routeTemplate", file), lazy-route-template: scaffold-of(ms, "lazyRouteTemplate", file), pruned: [])
  where target = match text-of(ms, "target", "react", file) {
          "react" | "solid" | "vue" => text-of(ms, "target", "react", file)
          other => fail-build(file ++ ": target must be react, solid or vue, not " ++ other)
        },
        quote = match text-of(ms, "quoteStyle", "single", file) {
          "single" | "double" => text-of(ms, "quoteStyle", "single", file)
          other => fail-build(file ++ ": quoteStyle must be single or double, not " ++ other)
        },
        disable-types = bool-of(ms, "disableTypes", false, file),
        given-tree = text-of(ms, "generatedRouteTree", "./src/routeTree.gen.ts", file),
        # With types off the tree is JavaScript.
        tree = if disable-types then js-name(given-tree) else given-tree

fn js-name(p: Text) -> Text = match p {
  stem ++ ".tsx" => stem ++ ".js"
  stem ++ ".ts" => stem ++ ".js"
  _ => p
}

fn text-of(ms: {Text:pkg.Node}, key: Text, default: Text, file: Text) -> Text = match ms[key] {
  none => default
  some(pkg.Str(raw)) => json-text(raw)
  some(_) => fail-build(file ++ ": " ++ key ++ " must be a string")
}

fn bool-of(ms: {Text:pkg.Node}, key: Text, default: Bool, file: Text) -> Bool = match ms[key] {
  none => default
  some(pkg.True()) => true
  some(pkg.False()) => false
  some(_) => fail-build(file ++ ": " ++ key ++ " must be true or false")
}

fn texts-of(ms: {Text:pkg.Node}, key: Text, default: [Text], file: Text) -> [Text] = match ms[key] {
  none => default
  some(pkg.Array(List(items...))) => [match i { pkg.Str(raw) => json-text(raw)  _ => fail-build(file ++ ": " ++ key ++ " must be a list of strings") } for i in items]
  some(_) => fail-build(file ++ ": " ++ key ++ " must be a list of strings")
}

# indexToken and routeToken: a string. A regular expression would need JavaScript's.
fn token-of(ms: {Text:pkg.Node}, key: Text, default: Text, file: Text) -> Text = match ms[key] {
  none => default
  some(pkg.Str(raw)) => json-text(raw)
  some(_) => fail-build(file ++ ": " ++ key ++ " as a regular expression is not supported here (it needs JavaScript's regular expressions); give a string")
}

fn extensions-of(ms: {Text:pkg.Node}, file: Text) -> Text = match ms["addExtensions"] {
  none => ""
  some(pkg.False()) => ""
  some(pkg.True()) => "*"
  some(pkg.Str(raw)) => if starts-with(json-text(raw), ".") then json-text(raw) else "." ++ json-text(raw)
  some(_) => fail-build(file ++ ": addExtensions must be true, false or an extension")
}

fn scaffold-of(ms: {Text:pkg.Node}, key: Text, file: Text) -> Text? = match ms["customScaffolding"] {
  none => none
  some(pkg.Object(List(xs...))) => match {json-text(m.key.text): m.value for m in xs}[key] {
    none => none
    some(pkg.Str(raw)) => some(json-text(raw))
    some(_) => fail-build(file ++ ": customScaffolding." ++ key ++ " must be a string")
  }
  some(_) => fail-build(file ++ ": customScaffolding must be an object")
}

# config.js's validateConfig, and the options that would need JavaScript run.
fn checked(c: Config) -> Config = match c {
  _ if c.index-token == c.route-token => fail-build("The \"indexToken\" and \"routeToken\" options must be different.")
  _ if trim(c.ignore-prefix) == "_" => fail-build("The \"routeFileIgnorePrefix\" cannot be an underscore (\"_\"). This is a reserved character used to denote a pathless route. Please use a different prefix.")
  _ => c
}

# Options read from the file that this generator cannot honour: each an error naming it.
fn refused(ms: {Text:pkg.Node}, file: Text) -> Bool = match first k in ["routeFileIgnorePattern", "virtualRouteConfig", "plugins", "experimental"] if refusing?(ms, k): k {
  some("experimental") => fail-build("\n------\n⚠️ ⚠️ ⚠️\nERROR: The \"experimental.enableCodeSplitting\" flag has been made stable and is now \"autoCodeSplitting\". Please update your configuration file to use \"autoCodeSplitting\" instead of \"experimental.enableCodeSplitting\".\n------\n")
  some(k) => fail-build(file ++ ": " ++ k ++ " is not supported by this generator (it needs JavaScript run: "
                        ++ (if k == "routeFileIgnorePattern" then "a regular expression" else if k == "plugins" then "generator plugins" else "a virtual route configuration") ++ ")")
  none => false
}

fn refusing?(ms: {Text:pkg.Node}, key: Text) -> Bool = match ms[key] {
  none => false
  some(pkg.Object(List(xs...))) if key == "experimental" => any m in xs: json-text(m.key.text) == "enableCodeSplitting"
  some(_) => key != "experimental"
}

# A JSON string's value: its escapes read (`\uXXXX` pairs as one code point).
fn json-text(raw: Text) -> Text = decoded(raw[1..len(raw) - 1], 0)

fn decoded(s: Text, i: Int) -> Text = match i {
  _ if i >= len(s) => ""
  _ if s[i] == 92 and i + 1 < len(s) => match s[i + 1] {
    110 => "\n" ++ decoded(s, i + 2)
    116 => "\t" ++ decoded(s, i + 2)
    114 => "\r" ++ decoded(s, i + 2)
    98 => byte-text(8) ++ decoded(s, i + 2)
    102 => byte-text(12) ++ decoded(s, i + 2)
    117 => match hex-at(s, i + 2) {
      high if high >= 55296 and high <= 56319 and at?(s, i + 6, "\\u") =>
        text-of-points([65536 + (high - 55296) * 1024 + (hex-at(s, i + 8) - 56320)]) ++ decoded(s, i + 12)
      cp => text-of-points([cp]) ++ decoded(s, i + 6)
    }
    c => byte-text(c) ++ decoded(s, i + 2)
  }
  _ => s[i..i + 1 + span-not-of(s, i + 1, "\\")] ++ decoded(s, i + 1 + span-not-of(s, i + 1, "\\"))
}

fn hex-at(s: Text, i: Int) -> Int = digits-number(s[i..i + 4], 16, 4) ?? fail-build("tsr.config.json: a \\u escape needs four hex digits")
