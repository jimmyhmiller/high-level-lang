# A TanStack Start application built as its Vite plugin builds it (`esb --tanstack-start[=DIR]`):
# the route tree generated, with Start's footer; the browser's build (dist/client), the client
# entry hydrating the page the server rendered; then the server's (dist/server/server.js, whose
# default export's `fetch` answers requests), told which files the browser's build made for each
# route (Start's manifest) and where each server function is (its resolver).
#
# Each build compiles Start's factories for its side (tanstack.start-compiler) before splitting
# route files (tanstack.split): in both, components load lazily; the browser's route options lose
# `ssr`, `server` and `headers`. The server leaves packages to Node but Start's own, which the
# compiler and Start's modules (`#tanstack-start-…`) apply to.
rules tanstack.start over bundle.js
use bundle.js as js
use bundle.api as api
use bundle.modules as m
use bundle.package as pkg
use bundle.resolve as res
use bundle.minhost as host
use tanstack.split as split
use tanstack.plugin as plugin
use tanstack.config as cfg
use tanstack.routes as routes
use tanstack.start-compiler as compiler
use tanstack.dev as dev
use bundle.hmr as hmr
use vite.env as env
use vite.compat as vite

# The files a Start application is made of: its router (required), its Start options, and its two
# entries, Start's own where the application has none.
record Entries { router: Text, start: Text, client: Text, server: Text }

# What a build of the application's is told: the project, its entries, which side it is, and for the
# server, Start's manifest module.
record Build { root: Text, entries: Entries, client: Bool, manifest: Text, tree-path: Text, tree-config: cfg.Config, generated: routes.Generated }

setting build: Build

fn entries-of(root: Text) -> Entries =
  Entries(router: own(src, "router") ?? fail-build("Could not resolve entry for router entry: ./router in " ++ src),
          start: own(src, "start") ?? default-entry(root, "start.ts"),
          client: own(src, "client") ?? default-entry(root, "client.tsx"),
          server: own(src, "server") ?? default-entry(root, "server.ts"))
  where src = path-normalize(root ++ "/src")

fn own(src: Text, name: Text) -> Text? =
  first ext in [".ts", ".js", ".mts", ".mjs", ".tsx", ".jsx"] for f in [src ++ "/" ++ name ++ ext] if readable-file?(f): real-path(f)

# Start's own entry, from @tanstack/react-start as the project's node_modules has it.
fn default-entry(root: Text, name: Text) -> Text =
  (first dir in path-ancestors(real-path(root)) for f in [dir ++ "/node_modules/@tanstack/react-start/dist/plugin/default-entry/" ++ name]
   if readable-file?(f): f)
  ?? fail-build("@tanstack/react-start is not installed where " ++ root ++ " can find it")

# ---------------------------------------------------------------- what Start's modules are

const manifest-module: Text = "tanstack-start-manifest:v"
const resolver-module: Text = "tanstack-start-server-fn-resolver"

fn resolved(spec: Text, importer: Text) -> Text? = denied(spec, importer) ?? resolved-start(spec, importer)

fn resolved-start(spec: Text, importer: Text) -> Text? = match spec {
  "#tanstack-router-entry" => some(build.entries.router)
  "#tanstack-start-entry" => some(build.entries.start)
  "virtual:tanstack-start-client-entry" => some(build.entries.client)
  "virtual:tanstack-start-server-entry" => some(build.entries.server)
  "tanstack-start-manifest:v" => some(manifest-module)
  "#tanstack-start-server-fn-resolver" if not build.client => some(resolver-module)
  _ if compiler.provider?(spec) => some(spec)
  # The server leaves packages outside but Start's own.
  _ if not build.client and (starts-with(spec, "@tanstack/start") or starts-with(spec, "@tanstack/react-start")) =>
    some(m.searched-for(m.import-request(spec), importer).path)
  _ => none
}

fn loaded(path: Text) -> Text? = match path {
  "tss-denied:" ++ _ => some(mock-text(path))
  # The browser's route tree is not the one on disk (see `client-tree`).
  _ if build.client and path == build.tree-path => some(client-tree(build.tree-config, build.generated))
  _ if path == manifest-module => some(match build.client {
    true => "export const tsrStartManifest = () => ({ routes: {} });\n"
    false => build.manifest
  })
  _ if path == resolver-module => some(resolver-text(build.root))
  _ if compiler.provider?(path) => some(read-file(compiler.base-file(path)))
  _ => none
}

# ---------------------------------------------------------------- server functions

# Each server function of the project's: what the server's resolver loads it by.
record Provided { id: Text, handler: Text, file: Text }

fn provided(root: Text) -> [Provided] =
  sort p in [Provided(id: f.id, handler: f.handler, file: file)
             for file in sources(path-normalize(root ++ "/src")) if contains-text?(read-file(file), "createServerFn")
             for tree in [m.parsed-of(file).tree] for f in compiler.server-fns(tree, file, compiler.known-in(tree))] by p.id

fn sources(dir: Text) -> [Text] =
  [f for name in sort n in keys(listing) by n if not starts-with(name, ".") and name != "node_modules"
   for f in (match listing[name] ?? 0 {
     'd' => sources(dir ++ "/" ++ name)
     'f' | 'l' if path-ext(name) in [".ts", ".tsx", ".js", ".jsx", ".mts", ".mjs"] => [real-path(dir ++ "/" ++ name)]
     _ => []
   })]
  where listing = res.listing-of(dir)

# Start's resolver (`#tanstack-start-server-fn-resolver`): each function's id, the export of its
# module that is its handler, and that module, loaded once.
fn resolver-text(root: Text) -> Text =
  "const manifest = {\n" ++ join(["  " ++ host.js-string(p.id) ++ ": {\n    functionName: " ++ host.js-string(p.handler)
                                  ++ ",\n    importer: () => import(" ++ host.js-string(p.file ++ compiler.provider-query) ++ ")\n  }"
                                  for p in provided(root)], ",\n") ++ "\n}\n\n"
  ++ "export async function getServerFnById(id, access) {\n"
  ++ "  const serverFnInfo = manifest[id]\n"
  ++ "  if (!serverFnInfo) {\n    throw new Error('Server function info not found for ' + id)\n  }\n"
  ++ "  const fnModule = serverFnInfo.module ??= await serverFnInfo.importer()\n"
  ++ "  if (!fnModule) {\n    throw new Error('Server function module not resolved for ' + id)\n  }\n"
  ++ "  const action = fnModule[serverFnInfo.functionName]\n"
  ++ "  if (!action) {\n    throw new Error('Server function module export not resolved for serverFn ID: ' + id)\n  }\n"
  ++ "  return action\n}\n"

# ---------------------------------------------------------------- the manifest

# A chunk of the browser's build, as its `.vite/manifest.json` says it.
record Chunk { key: Text, file: Text, entry: Bool, imports: [Text], css: [Text] }

fn chunks-of(json: Text) -> [Chunk] = match pkg.parse(json, ".vite/manifest.json") {
  pkg.Object(List(members...)) => [chunk-of(unquote(mb.key.text), mb.value) for mb in members]
  _ => fail-build("tanstack.start: the browser build's manifest is not an object")
}

fn chunk-of(key: Text, v: pkg.Node) -> Chunk =
  Chunk(key: key, file: res.text-member(v, "file") ?? "", entry: res.member(v, "isEntry") is some(pkg.True()),
        imports: texts(res.member(v, "imports")), css: texts(res.member(v, "css")))

fn texts(n: pkg.Node?) -> [Text] = match n {
  some(pkg.Array(List(xs...))) => [unquote(x.text) for x in xs]
  _ => []
}

fn asset(file: Text) -> Text = "/" ++ file

# A chunk's static imports, all the way down, in the order a walk meets them.
fn closure(chunks: [Chunk], key: Text) -> [Text] = [k for k in walked(chunks, [key], []) if k != key]

fn walked(chunks: [Chunk], todo: [Text], seen: [Text]) -> [Text] = match todo {
  [] => seen
  [k, rest...] if k in seen => walked(chunks, rest, seen)
  [k, rest...] => walked(chunks, rest ++ ((first c in chunks if c.key == k: c.imports) ?? []), seen ++ [k])
}

fn file-of(chunks: [Chunk], key: Text) -> Text = (first c in chunks if c.key == key: c.file) ?? ""

fn preloads(chunks: [Chunk], key: Text) -> [Text] = [asset(file-of(chunks, k)) for k in [key] ++ closure(chunks, key)]

fn styles(chunks: [Chunk], key: Text) -> [Text] =
  [asset(f) for k in reversed(closure(chunks, key)) ++ [key] for c in chunks if c.key == k for f in c.css distinct f]

# What one route loads, before what its ancestors load is taken out of it.
record Assets { id: Text, file: Text, children: [Text], preloads: [Text], css: [Text], scripts: [Text] }

fn route-assets(chunks: [Chunk], r: routes.RouteInfo, root: Text) -> Assets =
  Assets(id: r.id, file: r.file, children: r.children,
         preloads: [p for k in mine for p in preloads(chunks, k) distinct p] ++ entry-preloads,
         css: [c for k in mine for c in styles(chunks, k) distinct c] ++ entry-css,
         scripts: [asset(e.file) for e in entries if r.id == "__root__"])
  where mine = [c.key for c in chunks if contains-text?(c.key, "?tsr-split=") and r.file != ""
                and real-path(path-normalize(root ++ "/" ++ text-before(c.key, "?"))) == real-path(r.file)],
        entries = [c for c in chunks if c.entry],
        entry-preloads = [p for e in entries if r.id == "__root__" for p in preloads(chunks, e.key)],
        entry-css = [c for e in entries if r.id == "__root__" for c in styles(chunks, e.key)]

# Start's manifest module: what each route loads that its ancestors do not, as `tsrStartManifest`.
fn manifest-text(chunks: [Chunk], info: [routes.RouteInfo], root: Text) -> Text =
  "export const tsrStartManifest = () => ({ routes: {\n" ++ join([route-text(a) for a in deduped if non-empty?(a)], ",\n") ++ "\n} });\n"
  where all = [route-assets(chunks, r, root) for r in info],
        deduped = [without-ancestors(a, all) for a in all]

fn non-empty?(a: Assets) -> Bool = len(a.preloads) + len(a.css) + len(a.scripts) > 0 or a.id == "__root__"

# A route's assets without what an ancestor of it loads.
fn without-ancestors(a: Assets, all: [Assets]) -> Assets =
  a with { preloads: [p for p in a.preloads if not (p in above.preloads)], css: [c for c in a.css if not (c in above.css)],
           scripts: [s for s in a.scripts if not (s in above.scripts)] }
  where above = ancestors(a.id, all)

fn ancestors(id: Text, all: [Assets]) -> Assets = match first p in all if id in p.children: p {
  some(parent) => parent with { preloads: parent.preloads ++ up.preloads, css: parent.css ++ up.css, scripts: parent.scripts ++ up.scripts }
    where up = ancestors(parent.id, all)
  none => Assets(id: "", file: "", children: [], preloads: [], css: [], scripts: [])
}

fn route-text(a: Assets) -> Text =
  "  " ++ host.js-string(a.id) ++ ": {\n    filePath: " ++ (if a.file == "" then "undefined" else host.js-string(a.file))
  ++ ",\n    children: " ++ (match a.children { [] => "undefined"  cs => "[" ++ join([host.js-string(c) for c in cs], ", ") ++ "]" })
  ++ (match a.preloads { [] => ""  ps => ",\n    preloads: [" ++ join([host.js-string(p) for p in ps], ", ") ++ "]" })
  ++ (match a.css { [] => ""  cs => ",\n    css: [" ++ join(["{ link: { rel: \"stylesheet\", href: " ++ host.js-string(c) ++ " } }" for c in cs], ", ") ++ "]" })
  ++ (match a.scripts { [] => ""  ss => ",\n    scripts: [" ++ join(["{ attrs: { type: \"module\", async: true, src: " ++ host.js-string(s) ++ " } }" for s in ss], ", ") ++ "]" })
  ++ "\n  }"

# ---------------------------------------------------------------- the two builds

# Start's defines, each as `process.env.X` and as `import.meta.env.X`. In development, as its plugin
# for a bundler that bundles in development (Rsbuild's) gives them: the dev server's, with no
# middleware for styles (the root route's stylesheets are files of the browser's build).
fn start-defines(developing: Bool) -> [api.DefineText] =
  [api.DefineText(key: prefix ++ k, value: host.js-string(v)) for kv in [["TSS_SERVER_FN_BASE", "/_serverFn/"], ["TSS_ROUTER_BASEPATH", ""]]
     ++ (if developing then [["TSS_SHELL", "false"], ["TSS_DEV_SERVER", "true"], ["TSS_DEV_SSR_STYLES_ENABLED", "false"]]
         else [["TSS_DEV_SERVER", "false"], ["TSS_DEV_SSR_STYLES_ENABLED", "true"]])
     ++ [["TSS_DEV_SSR_STYLES_BASEPATH", "/"], ["TSS_INLINE_CSS_ENABLED", "false"], ["TSS_DISABLE_CSRF_MIDDLEWARE_WARNING", "false"]]
   for k in [kv[0]] for v in [kv[1]] for prefix in ["process.env.", "import.meta.env."]]

# The route tree's footer that Start's generator adds: the router's type registered with Start.
fn footer(root: Text, c: cfg.Config, e: Entries) -> Text =
  "import type { getRouter } from '" ++ tree-import(c.tree-path, e.router) ++ "'\n"
  ++ (match own(path-normalize(root ++ "/src"), "start") {
       some(start) => "import type { startInstance } from '" ++ tree-import(c.tree-path, start) ++ "'\n"
       none => "import type { createStart } from '@tanstack/react-start'\n"
     })
  ++ "declare module '@tanstack/react-start' {\n  interface Register {\n    ssr: true\n    router: Awaited<ReturnType<typeof getRouter>>"
  ++ (if is-some(own(path-normalize(root ++ "/src"), "start")) then "\n    config: Awaited<ReturnType<typeof startInstance.getOptions>>" else "")
  ++ "\n  }\n}"

fn tree-import(tree: Text, file: Text) -> Text = match relative(dir-of(tree), file) {
  r if starts-with(r, ".") => r
  r => "./" ++ r
}

fn relative(from: Text, to: Text) -> Text = join([".." for i in common..len(a)] ++ b[common..len(b)], "/")
  where a = [s for s in split(real-path(from), "/") if s != ""], b = [s for s in split(real-path(to), "/") if s != ""],
        common = len([i for i in 0..min(len(a), len(b)) while a[i] == b[i]])

# The generator's configuration as Start gives it: its footer after the project's own.
fn generator-config(root: Text, e: Entries) -> cfg.Config = c with { footer: [footer(root, c, e)] ++ c.footer, auto-code-splitting: true }
  where c = cfg.read(root)

# ---------------------------------------------------------------- the browser's route tree

# The browser's route tree, as Start's client-tree plugin makes it in place of the file: no types,
# no formatting, no header or footer, and without each route only the server has (a route whose
# options are `server` alone, and whose children are all such routes too).
fn client-tree(c: cfg.Config, g: routes.Generated) -> Text =
  with routes.config = client-config { routes.generated-with(client-config).text }
  where client-config = c with { disable-types: true, formatting: false, header: [], footer: [], pruned: pruned-files(g.manifest) }

fn pruned-files(info: [routes.RouteInfo]) -> [Text] = [r.file for r in info if r.id != "__root__" and pruned?(r, info)]

fn pruned?(r: routes.RouteInfo, info: [routes.RouteInfo]) -> Bool =
  r.file != "" and server-only?(r.file) and (all c in r.children: (first x in info if x.id == c: pruned?(x, info)) ?? false)

# A route file whose route's options are `server` alone.
fn server-only?(file: Text) -> Bool = any s in m.parsed-of(file).tree.body.kids: option-keys(s) is some(keys) and len(keys) == 1 and keys[0] == "server"

fn option-keys(s: Node) -> [Text]? = match s {
  ExportLexical(d) => option-keys(d)
  ConstDecl(List(Declarator(_, CallExpr(CallExpr(Ident("createFileRoute"), _), Args(List(ObjectLit(List(props...)), ...)))))) =>
    some([k for p in props for k in key-of(p)])
  _ => none
}

fn key-of(p: Node) -> [Text] = match p {
  Prop(PropName(k), _) => [k]
  Prop(Str(raw), _) => [unquote(raw)]
  Shorthand(Ident(k)) => [k]
  _ => ["…"]
}

# One build's options, from what the command line gave. The browser's is minified, as Vite's is.
fn side-options(o: api.Options, root: Text, e: Entries, client: Bool) -> api.Options =
  side-analyzed(vite.compatible(start-defined(env.with-env(base, root, "production", not client), false)), if client then "client" else "server")
  where common = (if o.jsx.explicit then o else api.with-jsx-runtime(o, "automatic")) with { splitting: true, format: api.esm-format(), manifest: client, url-queries: true,
                          on-resolve: o.on-resolve ++ [resolved, split.resolved], on-load: o.on-load ++ [loaded, split.loaded],
                          transforms: o.transforms ++ [compiler.compiled, split.split-route],
                          chunking: o.chunking with { fragments: true, already-loaded: true }, strict-execution-order: true,
                          chunk-names: "assets/[name]-[hash]", public-path: "/assets/" },
        base = match client {
          true => common with { entry: e.client, entries: [e.client], outdir: out, asset-dir: out ++ "/assets", minify-identifiers: true, minify-syntax: true,
                                entry-names: "assets/index-[hash]", conditions: some(["module", "browser", "production"]) }
            where out = path-normalize(root ++ "/dist/client")
          false => server-options(common, e, path-normalize(root ++ "/dist/server"), "production")
        }

fn server-options(common: api.Options, e: Entries, out: Text, mode: Text) -> api.Options =
  api.on-node(common) with { entry: e.server, entries: [e.server], outdir: out, asset-dir: out ++ "/assets",
                             entry-names: "[name]", packages-external: true, node-loaded-only: true, minify-identifiers: false, minify-syntax: false,
                             conditions: some(["module", "node", mode]), url-assets: false }

# Each side's analysis (`--analyze=DIR`) in a directory of its own, DIR/client and DIR/server.
fn side-analyzed(o: api.Options, side: Text) -> api.Options = match o.analyze {
  "" => o
  dir => o with { analyze: dir ++ "/" ++ side }
}

# Start's defines added to a build's, where the command line gave none of the same name.
fn start-defined(o: api.Options, developing: Bool) -> api.Options =
  o with { defines: o.defines ++ [d for d in start-defines(developing) if not api.has-define?(o, d.key)] }

# The route tree generated, as Start's generator writes it, and written where it changed.
fn generated!(c: cfg.Config) -> routes.Generated = with routes.config = c { routes.written!(routes.generated-with(c)) }

fn split-options(g: routes.Generated, delete: [Text]) -> split.Options =
  split.Options(files: {real-path(f): true for f in g.routes}, ids: {real-path(g.routes[i]): g.ids[i] for i in 0..len(g.routes)},
                package: "@tanstack/react-router", groupings: split.default-groupings(), delete: delete)

fn client-build(o: api.Options, root: Text, e: Entries, g: routes.Generated, c: cfg.Config) -> [api.Written] =
  with api.context = "client" {
    with split.options = split-options(g, ["ssr", "server", "headers"]), compiler.side = compiler.Side(client: true, root: real-path(root)),
         build = Build(root: root, entries: e, client: true, manifest: "", tree-path: real-path(c.tree-path), tree-config: c, generated: g) {
      api.files(side-options(o, root, e, true))
    }
  }

fn server-build(o: api.Options, root: Text, e: Entries, g: routes.Generated, c: cfg.Config, manifest: Text) -> [api.Written] =
  with api.context = "server" {
    with split.options = split-options(g, []), compiler.side = compiler.Side(client: false, root: real-path(root)),
         build = Build(root: root, entries: e, client: false, manifest: manifest, tree-path: "", tree-config: c, generated: g) {
      api.files(side-options(o, root, e, false))
    }
  }

# Both builds' files: the browser's (its manifest read, not written; the project's public/ beside
# it), then the server's.
fn built(o: api.Options, root: Text) -> [api.Written] = client-files ++ public ++ server-files
  where e = entries-of(root),
        c = generator-config(root, e),
        g = generated!(c),
        client-all = client-build(o, root, e, g, c),
        manifest-json = (first w in client-all if ends-with(w.path, "/.vite/manifest.json"): w.text) ?? fail-build("tanstack.start: the browser's build has no manifest"),
        client-files = protected([w for w in client-all if not ends-with(w.path, "/.vite/manifest.json")], root, true),
        public = api.public-written(path-normalize(root ++ "/public"), path-normalize(root ++ "/dist/client")),
        server-files = protected(server-build(o, root, e, g, c, manifest-text(chunks-of(manifest-json), g.manifest, root)), root, false)

# ---------------------------------------------------------------- import protection

# What Start keeps each side from importing (its import protection): in the browser, Start's server
# entry (`@tanstack/react-start/server`) and the project's `*.server.*` files; on the server, its
# `*.client.*` files; and on either, a file marked for the other side (by importing
# `@tanstack/react-start/server-only` or `/client-only`). An import of one is a mock module that
# throws if it is used; and if the mock is still in what the build writes (what Start's compiler
# and tree shaking left reads it), the build fails, saying which import of which file it was.
const denied-mark: Text = "__TSS_IMPORT_DENIED__"

fn denied-specifier?(spec: Text) -> Bool =
  build.client and spec in ["@tanstack/react-start/server", "@tanstack/solid-start/server", "@tanstack/vue-start/server"]

# Why a file may not be imported on this side, if it may not.
fn denied-file(file: Text) -> Text? = match file {
  _ if contains-text?(file, "/node_modules/") or contains-text?(file, "?") => none
  _ if build.client and contains-text?(path-base(file), ".server.") => some("Denied by file pattern: **/*.server.*")
  _ if not build.client and contains-text?(path-base(file), ".client.") => some("Denied by file pattern: **/*.client.*")
  _ if readable-file?(file) and marked?(read-file(file), if build.client then "server-only" else "client-only") =>
    some("Denied by marker: module is restricted to the opposite environment")
  _ => none
}

fn marked?(src: Text, side: Text) -> Bool =
  any p in ["@tanstack/react-start/", "@tanstack/solid-start/", "@tanstack/vue-start/"]: contains-text?(src, "\"" ++ p ++ side ++ "\"") or contains-text?(src, "'" ++ p ++ side ++ "'")

# An import of the project's (by a file of it, not a package's) that this side may not make: its
# mock, `tss-denied:` with the file, the importer, the specifier and why, by `|`.
fn denied(spec: Text, importer: Text) -> Text? = match contains-text?(importer, "/node_modules/") or starts-with(spec, "tss-denied:") {
  true => none
  false => match denied-specifier?(spec) {
    true => some(denial-id(spec, importer, spec, "Denied by specifier pattern: " ++ spec))
    false => match res.relative?(spec) or starts-with(spec, "/") {
      true => match denied-file(file) {
        some(why) => some(denial-id(file, importer, spec, why))
        none => none
      } where file = m.searched-for(m.import-request(match index-of(spec, "?") { some(at) => spec[0..at]  none => spec }), importer).path
      false => none
    }
  }
}

fn denial-id(file: Text, importer: Text, spec: Text, why: Text) -> Text = "tss-denied:" ++ join([file, importer, spec, why], "|")

record Denial { file: Text, importer: Text, spec: Text, why: Text }

fn denied-of(id: Text) -> Denial = match split(id[len("tss-denied:")..len(id)], "|") {
  [file, importer, spec, why] => Denial(file: file, importer: importer, spec: spec, why: why)
  _ => fail-build("tanstack.start: an import protection mock without its import: " ++ id)
}

# The mock: each export the denied module has, made by one function, which throws if what it made
# is used, and whose text says which import it stands for: it is in the output exactly when the
# mock is used there.
fn mock-text(id: Text) -> Text =
  "function __tssDenied() {\n"
  ++ "  const fail = () => { throw new Error(" ++ host.js-string("[import-protection] " ++ d.spec ++ " is not to be imported in the " ++ side-name()
                                                                ++ " environment " ++ denied-mark ++ id ++ denied-end) ++ "); };\n"
  ++ "  return new Proxy(function () {}, { get: fail, apply: fail, construct: fail });\n}\n"
  ++ "export default __tssDenied();\n"
  ++ join(["export const " ++ n ++ " = __tssDenied();\n" for n in exports-of(d.file) if n != "default"], "")
  where d = denied-of(id)

const denied-end: Text = "__TSS_IMPORT_DENIED_END__"

fn side-name() -> Text = if build.client then "client" else "server"

# The names a module exports, read from its tree.
fn exports-of(file: Text) -> [Text] = match readable-file?(file) {
  false => []
  true => [n for s in m.parsed-of(file).tree.body.kids for n in exported-names(s) distinct n]
}

fn exported-names(s: Node) -> [Text] = match s {
  ExportLexical(ConstDecl(List(ds...))) | ExportLexical(LetDecl(List(ds...))) | ExportVar(List(ds...)) =>
    [d.kids[0].text for d in ds if d.kids[0] is BindName(_)]
  ExportFunction(d) | ExportClass(d) => [d.kids[0].text]
  ExportNamed(List(specs...)) | ExportFrom(List(specs...), _, _) => [exported-as(sp) for sp in specs]
  ExportDefault(_) | ExportDefaultDecl(_) => ["default"]
  _ => []
}

fn exported-as(sp: Node) -> Text = match sp {
  ExportAs(_, out) => unquote-name(out.text)
  _ => unquote-name(sp.text)
}

fn unquote-name(t: Text) -> Text = if starts-with(t, "\"") or starts-with(t, "'") then unquote(t) else t

# A build's files, or the build fails, as Start's does, for each mock still in what it writes.
fn protected(ws: [api.Written], root: Text, client: Bool) -> [api.Written] =
  match [id for w in ws if ends-with(w.path, ".js") for at in occurrences(w.text, [denied-mark]) for id in [denial-at(w.text, at)] distinct id] {
    [] => ws
    ids => fail-build(join([violation(denied-of(id), root, client) for id in ids], "\n\n"))
  }

fn denial-at(text: Text, at: Int) -> Text = match index-of(text[start..len(text)], denied-end) {
  some(n) => text[start..start + n]
  none => ""
} where start = at + len(denied-mark)

fn violation(d: Denial, root: Text, client: Bool) -> Text =
  "[import-protection] Import denied in " ++ (if client then "client" else "server") ++ " environment\n\n"
  ++ "  " ++ d.why ++ "\n  Importer: " ++ relative(root, d.importer) ++ "\n  Import: " ++ host.js-string(d.spec)
  ++ "\n  Resolved: " ++ (if starts-with(d.file, "/") then relative(root, d.file) else d.file) ++ "\n\n  Suggestions:\n"
  ++ join(["    - " ++ x ++ "\n" for x in (match client {
       true => ["Use createServerFn().handler(() => ...) to keep the logic on the server and call it from the client via an RPC bridge",
                "Use createServerOnlyFn(() => ...) to mark it as server-only (it will throw if accidentally called from the client)",
                "Use createIsomorphicFn().client(() => ...).server(() => ...) to provide separate client and server implementations",
                "Move the server-only import out of this file into a separate .server.ts module that is not imported by any client code"]
       false => ["Use createClientOnlyFn(() => ...) to mark it as client-only (it will throw if accidentally called from the server)",
                 "Use createIsomorphicFn().client(() => ...).server(() => ...) to provide separate client and server implementations",
                 "Move the client-only import out of this file into a separate .client.ts module that is not imported by any server code"]
     })], "")

# ---------------------------------------------------------------- development

# Start in development (`esb --tanstack-start --hmr`), as its plugin for a bundler that bundles in
# development makes it: the browser's code one development bundle (`/assets/index.js`), its modules
# replaced as they change (React Fast Refresh and the router's own route updates, as with Router's
# plugin); the server's built again for each change, which the server's process (dev_host.mjs)
# imports again before it next answers. Neither build is split, and the server's manifest is the
# one Start gives in development: the root route loads the bundle. Both are written under
# node_modules/.esb/start, not dist.

fn dev-dir(root: Text) -> Text = path-normalize(real-path(root) ++ "/node_modules/.esb/start")

fn dev-client-dir(root: Text) -> Text = dev-dir(root) ++ "/client"

fn dev-server-dir(root: Text) -> Text = dev-dir(root) ++ "/server"

const dev-bundle: Text = "/assets/index.js"

fn dev-manifest-text() -> Text =
  "export const tsrStartManifest = () => ({\n  routes: {\n    __root__: {\n      preloads: [" ++ host.js-string(dev-bundle)
  ++ "],\n      scripts: [{ attrs: { type: 'module', async: true, src: " ++ host.js-string(dev-bundle) ++ " } }],\n    },\n  },\n})\n"

# What both development builds share: Start's modules and its compiler, React's JSX, no splitting.
fn dev-common(o: api.Options) -> api.Options =
  (if o.jsx.explicit then o else api.with-jsx-runtime(o, "automatic")) with {
    splitting: false, format: api.esm-format(), url-queries: true, chunk-names: "assets/[name]-[hash]", public-path: "/assets/",
    on-resolve: o.on-resolve ++ [resolved], on-load: o.on-load ++ [loaded], transforms: o.transforms ++ [compiler.compiled] }

# The browser's development bundle, its route modules taking their own updates (tanstack.dev) and
# its components refreshed.
fn dev-client-options(o: api.Options, root: Text, e: Entries) -> api.Options =
  plugin.refreshed(api.dev-options(vite.compatible(start-defined(env.with-env(base, root, "development", false), true))))
  where c = dev-common(o),
        out = dev-client-dir(root),
        base = c with { entry: e.client, entries: [e.client], outfile: out ++ dev-bundle, outdir: out, asset-dir: out ++ "/assets",
                        conditions: some(["module", "browser", "development"]), transforms: c.transforms ++ [dev.hot-route] }

# The server's, split only where Start's resolver imports a server function's module, and a
# development build, so the stylesheets it names are where the browser's are.
fn dev-server-options(o: api.Options, root: Text, e: Entries) -> api.Options =
  vite.compatible(start-defined(env.with-env(server-options(dev-common(o) with { splitting: true, dev: true }, e, dev-server-dir(root), "development"),
                                             root, "development", true), true))

# What a development build of either side is told: Start's side, and the build's setting, with the
# route tree as generated. In development an import a side may not make is the mock alone, which
# throws where it is used, as Start's import protection does in development.
fn dev-build(root: Text, e: Entries, g: routes.Generated, c: cfg.Config, client: Bool) -> Build =
  Build(root: root, entries: e, client: client, manifest: dev-manifest-text(), tree-path: if client then real-path(c.tree-path) else "",
        tree-config: c, generated: g)

# One development step: the browser's bundle and what changed since `before`.
fn dev-client-step(o: api.Options, root: Text, e: Entries, g: routes.Generated, c: cfg.Config, before: hmr.Dev, events: Text) -> api.DevStep =
  with api.context = "client" {
    with split.options = split-options(g, []), compiler.side = compiler.Side(client: true, root: real-path(root)),
         build = dev-build(root, e, g, c, true) {
      api.dev-step-of(dev-client-options(o, root, e), before, events)
    }
  }

fn dev-server-files(o: api.Options, root: Text, e: Entries, g: routes.Generated, c: cfg.Config) -> [api.Written] =
  with api.context = "server" {
    with split.options = split-options(g, []), compiler.side = compiler.Side(client: false, root: real-path(root)),
         build = dev-build(root, e, g, c, false) {
      api.files(dev-server-options(o, root, e))
    }
  }

fn dev-bundle-file(root: Text) -> Text = dev-client-dir(root) ++ dev-bundle

# Written last of each development build's files: the build's number, which tells the server's
# process the server's build is whole and new.
fn dev-stamp(root: Text, builds: Int) -> api.Written = api.Written(path: dev-server-dir(root) ++ "/build", text: int-text(builds), said: "")

# The server's process (dev_host.mjs, run by Node), started once the first build is written: it
# serves the browser's files and the project's public/, and answers every other request with the
# server build's `fetch`, imported again after each build.
fn dev-host-started!(root: Text, port: Int) -> Void {
  let host = dev-dir(root) ++ "/host.mjs"
  write-files!([host], [include-text("dev_host.mjs")], [""])
  match spawn-process!(["node", host, dev-server-dir(root), dev-client-dir(root), path-normalize(real-path(root) ++ "/public"), int-text(port)]) {
    pid if pid < 0 => fail-build("tanstack.start: could not start node, which runs the server in development")
    _ => {}
  }
}
