# Dense directed graphs. Iterative Kosaraju: linear space/time, including deep graphs, without
# materializing transitive closure or using the native stack for graph depth.
rules hl.graph

fn components(edges: [[Int]]) -> [Int] {
  let n = len(edges)
  var reverse: [[Int]] = [[] for i in 0..n]
  for from in 0..n {
    for to in edges[from] {
      if to < 0 or to >= n { panic "graph edge {} -> {} is out of bounds", from, to }
      reverse[to] ++= [from]
    }
  }
  var seen: [Bool] = [false for i in 0..n]
  var next: [Int] = [0 for i in 0..n]
  var stack: [Int] = [0 for i in 0..n]
  var order: [Int] = []
  for start in 0..n {
    if not seen[start] {
      var top = 0
      stack[0] = start
      seen[start] = true
      while top >= 0 {
        let at = stack[top]
        if next[at] < len(edges[at]) {
          let to = edges[at][next[at]]
          next[at] = next[at] + 1
          if not seen[to] {
            seen[to] = true
            top = top + 1
            stack[top] = to
          }
        } else {
          order ++= [at]
          top = top - 1
        }
      }
    }
  }
  var answer: [Int] = [-1 for i in 0..n]
  for i in 0..n {
    let start = order[n - i - 1]
    if answer[start] < 0 {
      var count = 1
      var members: [Int] = []
      var representative = start
      stack[0] = start
      answer[start] = start
      while count > 0 {
        count = count - 1
        let at = stack[count]
        members ++= [at]
        representative = min(representative, at)
        for to in reverse[at] {
          if answer[to] < 0 {
            answer[to] = start
            stack[count] = to
            count = count + 1
          }
        }
      }
      for at in members { answer[at] = representative }
    }
  }
  answer
}

fn adjacency(size: Int, from: [Int], to: [Int]) -> [[Int]] {
  if len(from) != len(to) { panic "graph edge columns have different lengths" }
  var edges: [[Int]] = [[] for i in 0..size]
  for i in 0..len(from) { edges[from[i]] ++= [to[i]] }
  edges
}

# A vertex is safe only when it and everything it depends on are safe. Propagate each change
# backwards once, rather than repeatedly scanning the graph to a fixpoint.
fn closed-safe(edges: [[Int]], eligible: [Bool]) -> [Bool] {
  let n = len(edges)
  if len(eligible) != n { panic "graph eligibility has the wrong length" }
  let from = [to for xs in edges for to in xs]
  let to = [i for i in 0..n for child in edges[i]]
  let reverse = adjacency(n, from, to)
  var safe = eligible
  var queue = [i for i in 0..n if not safe[i]]
  var cursor = 0
  while cursor < len(queue) {
    let at = queue[cursor]
    cursor = cursor + 1
    for parent in reverse[at] {
      if safe[parent] {
        safe[parent] = false
        queue ++= [parent]
      }
    }
  }
  safe
}

fn buckets(labels: [Int]) -> [[Int]] {
  var groups: [[Int]] = [[] for i in 0..len(labels)]
  for i in 0..len(labels) { groups[labels[i]] ++= [i] }
  [xs for xs in groups if len(xs) > 0]
}

# Propagate consumer labels along dependencies. Each (vertex,label) enters the queue once;
# sparse per-vertex sets avoid allocating vertices * all possible labels for sparse demand.
fn propagated(edges: [[Int]], seeds: [[Int]]) -> [[Int]] {
  if len(edges) != len(seeds) { panic "graph demand has the wrong length" }
  var seen: [{Int:Bool}] = [{} for xs in edges]
  var answer: [[Int]] = [[] for xs in edges]
  var vertices: [Int] = []
  var labels: [Int] = []
  for i in 0..len(seeds) {
    for label in seeds[i] {
      if not (label in seen[i]) {
        seen[i][label] = true
        answer[i] ++= [label]
        vertices ++= [i]
        labels ++= [label]
      }
    }
  }
  var cursor = 0
  while cursor < len(vertices) {
    let at = vertices[cursor]
    let label = labels[cursor]
    cursor = cursor + 1
    for to in edges[at] {
      if to < 0 or to >= len(edges) { panic "graph edge {} -> {} is out of bounds", at, to }
      if not (label in seen[to]) {
        seen[to][label] = true
        answer[to] ++= [label]
        vertices ++= [to]
        labels ++= [label]
      }
    }
  }
  [sort label in xs by label for xs in answer]
}
