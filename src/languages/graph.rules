# Dense directed graphs. Iterative Kosaraju: linear space/time, including deep graphs, without
# materializing transitive closure or using the native stack for graph depth.
rules hl.graph

fn components(edges: [[Int]]) -> [Int] {
  let n = len(edges)
  var reverse: [[Int]] = [[] for i in 0..n]
  for from in 0..n {
    for to in edges[from] {
      if to < 0 or to >= n { panic "graph edge {} -> {} is out of bounds", from, to }
      reverse[to] ++= [from]
    }
  }
  var seen: [Bool] = [false for i in 0..n]
  var next: [Int] = [0 for i in 0..n]
  var stack: [Int] = [0 for i in 0..n]
  var order: [Int] = []
  for start in 0..n {
    if not seen[start] {
      var top = 0
      stack[0] = start
      seen[start] = true
      while top >= 0 {
        let at = stack[top]
        if next[at] < len(edges[at]) {
          let to = edges[at][next[at]]
          next[at] = next[at] + 1
          if not seen[to] {
            seen[to] = true
            top = top + 1
            stack[top] = to
          }
        } else {
          order ++= [at]
          top = top - 1
        }
      }
    }
  }
  var answer: [Int] = [-1 for i in 0..n]
  for i in 0..n {
    let start = order[n - i - 1]
    if answer[start] < 0 {
      var count = 1
      var members: [Int] = []
      var representative = start
      stack[0] = start
      answer[start] = start
      while count > 0 {
        count = count - 1
        let at = stack[count]
        members ++= [at]
        representative = min(representative, at)
        for to in reverse[at] {
          if answer[to] < 0 {
            answer[to] = start
            stack[count] = to
            count = count + 1
          }
        }
      }
      for at in members { answer[at] = representative }
    }
  }
  answer
}

fn adjacency(size: Int, from: [Int], to: [Int]) -> [[Int]] {
  if len(from) != len(to) { panic "graph edge columns have different lengths" }
  var edges: [[Int]] = [[] for i in 0..size]
  for i in 0..len(from) { edges[from[i]] ++= [to[i]] }
  edges
}

# A vertex is safe only when it and everything it depends on are safe. Propagate each change
# backwards once, rather than repeatedly scanning the graph to a fixpoint.
fn closed-safe(edges: [[Int]], eligible: [Bool]) -> [Bool] {
  let n = len(edges)
  if len(eligible) != n { panic "graph eligibility has the wrong length" }
  let from = [to for xs in edges for to in xs]
  let to = [i for i in 0..n for child in edges[i]]
  let reverse = adjacency(n, from, to)
  var safe = eligible
  var queue = [i for i in 0..n if not safe[i]]
  var cursor = 0
  while cursor < len(queue) {
    let at = queue[cursor]
    cursor = cursor + 1
    for parent in reverse[at] {
      if safe[parent] {
        safe[parent] = false
        queue ++= [parent]
      }
    }
  }
  safe
}

fn buckets(labels: [Int]) -> [[Int]] {
  var groups: [[Int]] = [[] for i in 0..len(labels)]
  for i in 0..len(labels) { groups[labels[i]] ++= [i] }
  [xs for xs in groups if len(xs) > 0]
}

# Propagate consumer labels along dependencies. Each (vertex,label) enters the queue once;
# sparse per-vertex sets avoid allocating vertices * all possible labels for sparse demand.
fn propagated(edges: [[Int]], seeds: [[Int]]) -> [[Int]] {
  if len(edges) != len(seeds) { panic "graph demand has the wrong length" }
  var seen: [{Int:Bool}] = [{} for xs in edges]
  var answer: [[Int]] = [[] for xs in edges]
  var vertices: [Int] = []
  var labels: [Int] = []
  for i in 0..len(seeds) {
    for label in seeds[i] {
      if not (label in seen[i]) {
        seen[i][label] = true
        answer[i] ++= [label]
        vertices ++= [i]
        labels ++= [label]
      }
    }
  }
  var cursor = 0
  while cursor < len(vertices) {
    let at = vertices[cursor]
    let label = labels[cursor]
    cursor = cursor + 1
    for to in edges[at] {
      if to < 0 or to >= len(edges) { panic "graph edge {} -> {} is out of bounds", at, to }
      if not (label in seen[to]) {
        seen[to][label] = true
        answer[to] ++= [label]
        vertices ++= [to]
        labels ++= [label]
      }
    }
  }
  [sort label in xs by label for xs in answer]
}

# For each vertex, the least of `values` over every vertex it reaches, itself included. Iterative
# Tarjan: a component is finished only after every component it reaches, so each takes its
# successors' answers once, whatever the depth of the graph.
fn reached-min(edges: [[Int]], values: [Int]) -> [Int] {
  let n = len(edges)
  if len(values) != n { panic "graph values have the wrong length" }
  var index: [Int] = [-1 for i in 0..n]
  var low: [Int] = [0 for i in 0..n]
  var open: [Bool] = [false for i in 0..n]
  var next: [Int] = [0 for i in 0..n]
  var calls: [Int] = [0 for i in 0..n]
  var held: [Int] = [0 for i in 0..n]
  var answer = values
  var counter = 0
  var held-top = 0
  for start in 0..n {
    if index[start] < 0 {
      var top = 0
      calls[0] = start
      index[start] = counter
      low[start] = counter
      counter = counter + 1
      held[held-top] = start
      held-top = held-top + 1
      open[start] = true
      while top >= 0 {
        let at = calls[top]
        if next[at] < len(edges[at]) {
          let to = edges[at][next[at]]
          next[at] = next[at] + 1
          if to < 0 or to >= n { panic "graph edge {} -> {} is out of bounds", at, to }
          if index[to] < 0 {
            index[to] = counter
            low[to] = counter
            counter = counter + 1
            held[held-top] = to
            held-top = held-top + 1
            open[to] = true
            top = top + 1
            calls[top] = to
          } else {
            if open[to] { low[at] = min(low[at], index[to]) }
            answer[at] = min(answer[at], answer[to])
          }
        } else {
          if low[at] == index[at] {
            var least = answer[at]
            var k = held-top - 1
            while held[k] != at {
              least = min(least, answer[held[k]])
              k = k - 1
            }
            for j in k..held-top {
              answer[held[j]] = least
              open[held[j]] = false
            }
            held-top = k
          }
          top = top - 1
          if top >= 0 {
            let parent = calls[top]
            low[parent] = min(low[parent], low[at])
            answer[parent] = min(answer[parent], answer[at])
          }
        }
      }
    }
  }
  answer
}

# Sets of small numbers as bits, 62 to a word (a word's sign is never one of them).
const bit-values: [Int] = [fold p = 1 for k in 0..i: p * 2 for i in 0..62]

fn bit-words(width: Int) -> Int = (width + 61) / 62

fn bits-of(xs: [Int], words: Int) -> [Int] =
  [fold w = 0 for x in xs if x / 62 == i: bit-or(w, bit-values[x % 62]) for i in 0..words]

fn bits-has?(bits: [Int], x: Int) -> Bool = bit-and(bits[x / 62], bit-values[x % 62]) != 0

fn bits-list(bits: [Int]) -> [Int] =
  [w * 62 + b for w in 0..len(bits) if bits[w] != 0 for b in 0..62 if bit-and(bits[w], bit-values[b]) != 0]

fn bits-or(a: [Int], b: [Int]) -> [Int] = [bit-or(a[i], b[i]) for i in 0..len(a)]

# For each vertex, every label of every vertex it reaches, itself included, as bits (`bits`, each
# vertex's own, all of one width). As `reached-min`: a component is finished only after every
# component it reaches, so each takes its successors' labels once, a word at a time.
fn reached-bits(edges: [[Int]], bits: [[Int]]) -> [[Int]] {
  let n = len(edges)
  if len(bits) != n { panic "graph labels have the wrong length" }
  var answer = bits
  var index: [Int] = [-1 for i in 0..n]
  var low: [Int] = [0 for i in 0..n]
  var open: [Bool] = [false for i in 0..n]
  var next: [Int] = [0 for i in 0..n]
  var calls: [Int] = [0 for i in 0..n]
  var held: [Int] = [0 for i in 0..n]
  var counter = 0
  var held-top = 0
  for start in 0..n {
    if index[start] < 0 {
      var top = 0
      calls[0] = start
      index[start] = counter
      low[start] = counter
      counter = counter + 1
      held[held-top] = start
      held-top = held-top + 1
      open[start] = true
      while top >= 0 {
        let at = calls[top]
        if next[at] < len(edges[at]) {
          let to = edges[at][next[at]]
          next[at] = next[at] + 1
          if to < 0 or to >= n { panic "graph edge {} -> {} is out of bounds", at, to }
          if index[to] < 0 {
            index[to] = counter
            low[to] = counter
            counter = counter + 1
            held[held-top] = to
            held-top = held-top + 1
            open[to] = true
            top = top + 1
            calls[top] = to
          } else {
            if open[to] { low[at] = min(low[at], index[to]) }
            answer[at] = bits-or(answer[at], answer[to])
          }
        } else {
          if low[at] == index[at] {
            var joined = answer[at]
            var k = held-top - 1
            while held[k] != at {
              joined = bits-or(joined, answer[held[k]])
              k = k - 1
            }
            for j in k..held-top {
              answer[held[j]] = joined
              open[held[j]] = false
            }
            held-top = k
          }
          top = top - 1
          if top >= 0 {
            let parent = calls[top]
            low[parent] = min(low[parent], low[at])
            answer[parent] = bits-or(answer[parent], answer[at])
          }
        }
      }
    }
  }
  answer
}
