# The `.facts` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-.] ;
token Name = [a-zA-Z_] NameChar* ;

rule File = "facts" Item* -> File ;
rule Item
  = "relation" Name "(" Name,* ")" -> Relation
  | Head ":-" BodyAtom,+ ";" -> Clause
  ;
# A head's column may aggregate the body's answers over each group of its other columns.
rule Head = Name "(" HeadArg,* ")" -> HeadAtom ;
rule HeadArg = "count" Name -> Count | "sum" Name -> Sum | "min" Name -> Min | "max" Name -> Max | Name ;
rule Atom = Name "(" Name,* ")" -> Atom ;
rule BodyAtom = "!" Atom -> Negated | Name "!=" Name -> Differs | Atom ;
