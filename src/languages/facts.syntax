# The `.facts` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-.] ;
token Name = [a-zA-Z_] NameChar* ;

rule File = "facts" Item* -> File ;
rule Item
  = "relation" Name "(" Name,* ")" -> Relation
  | Atom ":-" BodyAtom,+ ";" -> Clause
  ;
rule Atom = Name "(" Name,* ")" -> Atom ;
rule BodyAtom = "!" Atom -> Negated | Atom ;
