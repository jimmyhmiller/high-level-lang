# The `.pipeline` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-./?!] ;
fragment Keyword = ("pipeline" | "fills" | "stage" | "plan" | "end" | "threads" | "per" | "whole" | "parallel"
                  | "serial" | "parts" | "auto" | "keep" | "makes" | "strategy" | "from" | "tracks"
                  | "default" | "watching" | "persists" | "mechanism" | "store" | "memory" | "disk"
                  | "check" | "reads" | "any-change" | "never" | "cutoff" | "equal" | "none" | "evict"
                  | "least-recently-used" | "uses" | "with" | "trust" | "recheck" | "by") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;
token Num = [0-9]+ ;
token Str = "\"" [^"\n]* "\"" ;

rule File = "pipeline" Name "fills" Name Mechanism* Strategy* Stage* Plan* -> File ;
# A mechanism: how a kept function's answers are kept. Each item is a policy of its own; `from M`
# starts from M's. A strategy says which functions each mechanism keeps.
#   store memory          answers are kept while the program runs
#   store memory disk     and saved with the cache, when the strategy persists
#   check reads           a kept answer is used again once everything it read is shown unchanged
#   check any-change      used again unless any input at all changed since it was made: nothing it
#                         reads is noted, so keeping it costs least
#   check never           used again for as long as it is kept, whatever changes
#   check by F            once any input changed, used again if F, a function of the same module
#                         that takes what the kept one takes and answers Text, gives what it gave
#                         when the answer was made (a version, such as a hash of what a file holds)
#   cutoff equal          an answer made again the same as the last changes nothing that read it
#   cutoff none           an answer made again changes what read it: no comparing
#   evict least-recently-used N   at most N answers kept, the one asked for longest ago let go
#   evict none            every answer kept
rule Mechanism = "mechanism" Name MechanismItem* "end" -> Mechanism ;
rule MechanismItem
  = "from" Name -> From
  | "store" StoreWhere+ -> Store
  | "check" CheckHow -> Check
  | "cutoff" CutoffHow -> Cutoff
  | "evict" EvictHow -> Evict
  ;
rule StoreWhere = "memory" -> Memory | "disk" -> Disk ;
rule CheckHow = "reads" -> Reads | "any-change" -> AnyChange | "never" -> Never | "by" Name -> CheckBy ;
rule CutoffHow = "equal" -> Equal | "none" -> NoCutoff ;
rule EvictHow = "least-recently-used" Num -> Lru | "none" -> NoEvict ;
# A strategy: which functions have their answers kept, by their arguments, while what they are made
# of stays the same. A run uses one: `--strategy=NAME`, or else the one marked `watching` while
# watching or with the cache, and the one marked `default` for anything else.
#   from S     everything S keeps, besides its own; and S's tracking and persisting
#   tracks     what each answer was made from is known, so answers are checked and kept from one
#              build to the next
#   persists   what it keeps is saved on disk after each build, and a run with the cache starts from
#              it (it must track: an answer is checked by what it was made from)
#   uses M     what it keeps, M keeps (unless a `keep with` says otherwise); without it, the
#              mechanism `store memory disk`, `check reads`, `cutoff equal`, `evict none`
#   keep with M NAMES   these, by mechanism M
#   trust "P"  files whose paths match P (`*` within a directory, `**` across them) are read as they
#              are: never what an answer is made from, never looked at again
#   recheck "P"  files matching P are compared by what they hold, never by size and time alone
rule Strategy = "strategy" Name StrategyItem* "end" -> Strategy ;
rule StrategyItem
  = "from" Name -> From
  | "tracks" -> Tracks
  | "default" -> Default
  | "watching" -> Watching
  | "persists" -> Persists
  | "uses" Name -> Uses
  | "keep" "with" Name Name+ -> KeepWith
  | "keep" Name+ -> Keep
  | "trust" Str -> Trust
  | "recheck" Str -> Recheck
  ;
rule Stage
  = "stage" Name "per" Name Name+ Makes? -> PerStage
  | "stage" Name "whole" Name* Makes? -> WholeStage
  ;
# What a stage makes: functions whose answers it computes, which the stages after it only read. They
# are kept, whatever else is.
rule Makes = "makes" Name+ -> Makes ;
rule Plan = "plan" Name PlanItem* "end" -> Plan ;
rule PlanItem
  = "threads" Count -> Threads
  | Name "serial" -> Serial
  | Name "parallel" Count? PartCount? -> Parallel
  ;
rule Count = Num | "auto" -> Auto ;
rule PartCount = "parts" Count -> Parts ;
