# The `.pipeline` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-./?!] ;
fragment Keyword = ("pipeline" | "fills" | "stage" | "plan" | "end" | "threads" | "per" | "whole" | "parallel"
                  | "serial" | "parts" | "auto" | "keep" | "makes") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;
token Num = [0-9]+ ;

rule File = "pipeline" Name "fills" Name Keep* Stage* Plan* -> File ;
# Functions whose answers a build keeps, by their arguments, while what they are made of stays the
# same: from one build to the next, and from one run to the next.
rule Keep = "keep" Name+ -> Keep ;
rule Stage
  = "stage" Name "per" Name Name+ Makes? -> PerStage
  | "stage" Name "whole" Name* Makes? -> WholeStage
  ;
# What a stage makes: functions whose answers it computes, which the stages after it only read.
rule Makes = "makes" Name+ -> Makes ;
rule Plan = "plan" Name PlanItem* "end" -> Plan ;
rule PlanItem
  = "threads" Count -> Threads
  | Name "serial" -> Serial
  | Name "parallel" Count? PartCount? -> Parallel
  ;
rule Count = Num | "auto" -> Auto ;
rule PartCount = "parts" Count -> Parts ;
