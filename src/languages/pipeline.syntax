# The `.pipeline` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-./?!] ;
fragment Keyword = ("pipeline" | "stage" | "plan" | "end" | "threads" | "per" | "whole" | "parallel"
                  | "serial" | "auto" | "keep" | "makes" | "strategy" | "from" | "tracks"
                  | "default" | "watching" | "persists" | "mechanism" | "store" | "memory" | "disk"
                  | "check" | "reads" | "any-change" | "never" | "cutoff" | "equal" | "none" | "evict"
                  | "least-recently-used" | "uses" | "with" | "trust" | "recheck" | "by" | "update" | "apart"
                  | "gives" | "settings" | "names") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;
token Num = [0-9]+ ;
token Str = "\"" [^"\n]* "\"" ;

rule File = "pipeline" Name Mechanism* Strategy* Stage* Plan* -> File ;
# A mechanism: how a kept function's answers are kept. Each item is a policy of its own; `from M`
# starts from M's. A strategy says which functions each mechanism keeps.
#   store memory          answers are kept while the program runs
#   store memory disk     and saved with the cache, when the strategy persists
#   store memory disk by F   saved only where F, given what the kept function takes, answers true
#   check reads           a kept answer is used again once everything it read is shown unchanged
#   check any-change      used again unless any input at all changed since it was made: nothing it
#                         reads is noted, so keeping it costs least
#   check never           used again for as long as it is kept, whatever changes
#   check by F            once any input changed, used again if F gives what it gave when the
#                         answer was made: F takes what the kept function takes and answers Text,
#                         a version (such as a hash of what a file holds)
#   cutoff equal          an answer made again the same as the last changes nothing that read it
#   cutoff none           an answer made again changes what read it: no comparing
#   cutoff by F           an answer made again changes nothing that read it where F(old, new),
#                         given the last answer and the new one, answers true
#   evict least-recently-used N   at most N answers kept, the one asked for longest ago let go
#   evict by F            after each build, each answer let go where F(idle, kept) answers true:
#                         idle, how many builds since it was last asked for (0: this one); kept,
#                         how many answers the function keeps
#   evict none            every answer kept
#   update by F           an answer made again, or for new arguments, is made by F from those
#                         arguments and the last answer the function made, when there is one:
#                         F takes what the kept function takes, then what it answers, and answers
#                         that (an update, such as a solved database brought up to date)
# Each F of `by` is a function of any module (a strategy's, say).
rule Mechanism = "mechanism" Name MechanismItem* "end" -> Mechanism ;
rule MechanismItem
  = "from" Name -> From
  | "store" StoreWhere+ "by" Name -> StoreBy
  | "store" StoreWhere+ -> Store
  | "check" CheckHow -> Check
  | "cutoff" CutoffHow -> Cutoff
  | "evict" EvictHow -> Evict
  | "update" "by" Name -> UpdateBy
  ;
rule StoreWhere = "memory" -> Memory | "disk" -> Disk ;
rule CheckHow = "reads" -> Reads | "any-change" -> AnyChange | "never" -> Never | "by" Name -> CheckBy ;
rule CutoffHow = "equal" -> Equal | "none" -> NoCutoff | "by" Name -> CutoffBy ;
rule EvictHow = "least-recently-used" Num -> Lru | "none" -> NoEvict | "by" Name -> EvictBy ;
# A strategy: which functions have their answers kept, by their arguments, while what they are made
# of stays the same. A run uses one: `--strategy=NAME`, or else the one marked `watching` while
# watching or with the cache, and the one marked `default` for anything else.
#   from S     everything S keeps, besides its own; and S's tracking and persisting
#   tracks     what each answer was made from is known, so answers are checked and kept from one
#              build to the next
#   persists   what it keeps is saved on disk after each build, and a run with the cache starts from
#              it (it must track: an answer is checked by what it was made from)
#   uses M     what it keeps, M keeps (unless a `keep with` says otherwise); without it, the
#              mechanism `store memory disk`, `check reads`, `cutoff equal`, `evict none`
#   keep with M NAMES   these, by mechanism M
#   trust "P"  files whose paths match P (`*` within a directory, `**` across them) are read as they
#              are: never what an answer is made from, never looked at again
#   recheck "P"  files matching P are compared by what they hold, never by size and time alone
#   apart NAMES  each of these works in storage of its own: its answer is copied out and whatever
#              else it made on the way is let go as it answers. For a strategy that keeps nothing
#              from one build to the next (it may not track, and no strategy takes it over with
#              `from`): there an answer is all that is wanted of the work. Such a function takes
#              nothing by reference and answers a value.
rule Strategy = "strategy" Name StrategyItem* "end" -> Strategy ;
rule StrategyItem
  = "from" Name -> From
  | "tracks" -> Tracks
  | "default" -> Default
  | "watching" -> Watching
  | "persists" -> Persists
  | "uses" Name -> Uses
  | "keep" "with" Name Name+ -> KeepWith
  | "keep" Name+ -> Keep
  | "trust" Str -> Trust
  | "recheck" Str -> Recheck
  | "apart" Name+ -> Apart
  ;
# A stage: work done once for each of its units (a file, a module, a chunk), by the functions it
# names, or once for the whole program. Where the rules make a list of one of a `per` stage's
# functions' answers, `[f(x, a) for x in xs]`, that list is the stage's work: a plan that runs the
# stage in parallel has it made on many threads, the answers in the list's order. The rules say
# nothing of threads; a function a stage names whose answers no list is made of is an error.
#   gives settings   its functions give settings by `with`: while what answers are made from is
#                    tracked, one runs at a time, since a kept answer says nothing of whose
#                    settings it was made under
#   names by F       its functions meet names that get ids in the order they are met: the list is
#                    made once only to say which names it needs, F (a Text to its Int) is given
#                    those in the list's order, as one thread would have met them, and the list is
#                    made again, every name known
#   per N units      its units are small: a thread takes N at a time, and a list of N or fewer is
#                    made by whoever asks for it, alone
rule Stage
  = "stage" Name "per" Run? Name Name+ Makes? Gives? Namer? -> PerStage
  | "stage" Name "whole" Name* Makes? -> WholeStage
  ;
# What a stage makes: functions whose answers it computes, which the stages after it only read. They
# are kept, whatever else is.
rule Makes = "makes" Name+ -> Makes ;
rule Run = Num -> Run ;
rule Gives = "gives" "settings" -> Gives ;
rule Namer = "names" "by" Name -> Namer ;
# A plan: which stages run on many threads, and how many (`threads N` for those that do not say;
# `auto`, the machine's cores). A stage it does not name runs on one. A run uses one plan
# (`use-plan!`), or one count for every stage (`use-threads!`).
rule Plan = "plan" Name PlanItem* "end" -> Plan ;
rule PlanItem
  = "threads" Count -> Threads
  | Name "serial" -> Serial
  | Name "parallel" Count? -> Parallel
  ;
rule Count = Num | "auto" -> Auto ;
