# What every `.rules` file can call without importing anything: domain-free text, files and
# tables, implemented in hl.rt and hl.symtab.
rules hl.prelude

foreign hl.rt as rt {
  type W
  type Names
  type Places
  type Ranks
  record Mark { out: Int, src: Int }
  record Rendered { text: Text, marks: [Mark], open: Bool }
  type Buf
  record Walk { pre: [Text], post: [Int], parent: [Int], slot: [Int], targets: [[Int]] }

  fn read-file = read-all(path: Text) -> Text
  fn write-file = write-output(path: Text, bytes: Text) -> Void
  fn write-files!(paths: [Text], texts: [Text], said: [Text]) -> Void
  fn make-dirs!(dir: Text) -> Void
  fn write-standard-output!(bytes: Text) -> Void
  fn working-dir() -> Text
  fn real-path(path: Text) -> Text
  fn file-exists?(path: Text) -> Bool
  fn readable-file?(path: Text) -> Bool
  fn dir-listing(path: Text) -> Text
  fn dir-of(path: Text) -> Text
  fn index-of(s: Text, what: Text) -> Int?
  fn index-of-any(s: Text, whats: [Text]) -> Int?
  fn last-index-of(s: Text, what: Text) -> Int?
  fn text-before(s: Text, sep: Text) -> Text
  fn text-after(s: Text, sep: Text) -> Text
  fn split(s: Text, sep: Text) -> [Text]
  fn occurrences(s: Text, whats: [Text]) -> [Int]
  fn join = joined(xs: [Text], sep: Text) -> Text
  fn replace-all(s: Text, what: Text, by: Text) -> Text
  fn replace-many(s: Text, whats: [Text], bys: [Text]) -> Text
  fn trim(s: Text) -> Text
  fn trim-bytes(s: Text, chars: Text) -> Text
  fn span-of(s: Text, from: Int, chars: Text) -> Int
  fn span-not-of(s: Text, from: Int, chars: Text) -> Int
  fn span-back-of(s: Text, chars: Text) -> Int
  fn ascii-lower(s: Text) -> Text
  fn path-base(p: Text) -> Text
  fn path-ext(p: Text) -> Text
  fn path-stem(p: Text) -> Text
  fn path-segments(p: Text) -> [Text]
  fn path-normalize(p: Text) -> Text
  fn path-ancestors(dir: Text) -> [Text]
  fn starts-with(s: Text, prefix: Text) -> Bool
  fn ends-with(s: Text, suffix: Text) -> Bool
  fn at?(s: Text, i: Int, what: Text) -> Bool
  fn contains-text?(s: Text, what: Text) -> Bool
  fn has-byte?(s: Text, b: Int) -> Bool
  fn ascii-text?(s: Text) -> Bool
  fn blanked(s: Text, from: Int, to: Int) -> Text
  fn line-starts(s: Text) -> [Int]
  fn line-indents(s: Text, starts: [Int]) -> [Int]
  fn count-byte(s: Text, from: Int, to: Int, b: Int) -> Int
  fn repeated(s: Text, n: Int) -> Text
  fn byte-counts(s: Text) -> [Int]
  fn summed-lists(lists: [[Int]]) -> [Int]
  fn arrive!(key: Text, total: Int) -> Bool
  fn arrivals-reset!() -> Void
  fn unquote = str-content(raw: Text) -> Text
  fn quote-text = quote-str(content: Text) -> Text
  fn int-text = num-text(v: Int) -> Text
  fn bisect(xs: [Int], x: Int) -> Int
  fn digit-value(c: Int, base: Int) -> Int?
  fn digits-number(s: Text, base: Int, limit: Int) -> Int?
  fn bit-and(a: Int, b: Int) -> Int
  fn bit-or(a: Int, b: Int) -> Int
  fn bit-xor(a: Int, b: Int) -> Int
  fn parse-int-opt = parse-num(s: Text) -> Int?
  fn parse-int(s: Text) -> Int
  fn digit-byte? = digit-i64?(c: Int) -> Bool
  fn byte-text = text-of-byte(c: Int) -> Text
  fn line-of(src: Text, at: Int) -> Int
  fn col-of(src: Text, at: Int) -> Int
  fn next-pass!() -> Int
  fn unicode-category(cp: Int) -> Text
  fn code-points-of(s: Text) -> [Int]
  fn text-of-points(points: [Int]) -> Text
  fn text-of-bytes(bytes: [Int]) -> Text

  fn depth-first(roots: [Text], children: Fn(Text)->[Text]) -> Walk

  # What memos were made from (see the dependencies in hl.rt): tracked from here on, which must come
  # before any memo computes; how many answers have been computed,
  # how many inputs memos have read, and a wait until one of those says something else, which marks
  # what it changed.
  fn track-dependencies! = dep-track!() -> Void
  fn memo-computed = dep-computed() -> Int
  fn inputs-watched = dep-inputs() -> Int
  fn wait-for-changes!(ms: Int) -> [Text]
  # With HL_MEMO_AUDIT set: what functions some strategy keeps, but this run's does not, were asked
  # again with the same arguments, and what that cost (see the memo audit in hl.rt).
  fn memo-audit-report!() -> Void
  # The instructions and cycles the process has retired, all threads (-1 where not counted).
  fn instructions-retired() -> Int
  fn cycles-elapsed() -> Int
  # Time on the CPU in user code and in the kernel (microseconds), page faults, and how often a
  # thread gave up the CPU waiting, and was made to give it up.
  fn cpu-user-us() -> Int
  fn cpu-system-us() -> Int
  fn page-faults() -> Int
  fn switches-waiting() -> Int
  fn switches-forced() -> Int

  # The cache on disk (see the cache in hl.rt): everything tracked builds computed, written whole to
  # a path; and loaded from one before anything is computed, true when there was one this build of
  # the program wrote, with every input checked since.
  fn cache-save!(path: Text) -> Void
  fn cache-save-later!(path: Text, timing: Bool) -> Void
  fn cache-load!(path: Text) -> Bool
  fn hash-text = print-of(bytes: Text) -> Text

  # A development server (see serving in hl.rt): a directory over HTTP on a port, 0 for any, with
  # a page for `/`, answering the port; events at the caller's path, and how many listen there.
  fn serve!(port: Int, dir: Text, page: Text, events-path: Text) -> Int
  fn broadcast!(event: Text, text: Text) -> Void
  fn listeners() -> Int

  fn names-new() -> Names
  fn names-copy(names: Names) -> Names
  fn name-count(names: Names) -> Int
  fn intern!(names: mut Names, s: Text) -> Int changes known-name(names, s), name-count(names)
  fn name-of(names: Names, id: Int) -> Text
  fn known-name(names: Names, s: Text) -> Int
  # Whether two interners hold the same names with the same ids: how `Names` values compare.
  fn same-Names? = names-same?(a: Names, b: Names) -> Bool
  # Blocks of numbers by key, kept from one build to the next while big enough (see Places in hl.rt).
  fn places-new() -> Places
  fn place!(places: mut Places, key: Text, size: Int) -> Int changes place-of(places, key), places-end(places)
  fn place-of(places: Places, key: Text) -> Int
  fn places-end(places: Places) -> Int
  fn same-Places? = places-same?(a: Places, b: Places) -> Bool
  # Ranks that keep keys in order, kept from one order to the next (see Ranks in hl.rt).
  fn ranks-new() -> Ranks
  fn rank!(ranks: mut Ranks, keys: [Text]) -> [Int] changes ranks-version(ranks)
  fn rank-of(ranks: Ranks, key: Text) -> Int
  fn ranks-version(ranks: Ranks) -> Int
  fn same-Ranks? = ranks-same?(a: Ranks, b: Ranks) -> Bool

  fn buf-new() -> Buf
  fn buf-add!(b: mut Buf, s: Text) -> Void
  fn buf-byte!(b: mut Buf, c: Int) -> Void
  fn buf-text(b: mut Buf) -> Text
  fn buf-len(b: mut Buf) -> Int

  fn now-ms() -> Int
  fn now-us() -> Int
  fn max-rss() -> Int
  fn arg-count() -> Int
  fn arg-at(i: Int) -> Text
  fn last-parse-path() -> Text
  fn last-parse-line() -> Int
  fn last-parse-col() -> Int
  fn last-parse-want() -> Text
  fn last-parse-found() -> Text
  fn fail-last-parse() -> Never
  fn fail-build(message: Text) -> Never
}

foreign hl.symtab as sym {
  type Table
  type Block
  record Symbol { name: Text, scope: Int, uses: Int, final: Text, pinned: Bool }
  record Scope { parent: Int, names: {Text:Int}, symbols: [Int], children: [Int], dynamic: Bool, enclosed: [Int] }
  record Analysis { table: Table, root: Int, bindings: {Int:Int}, free: [Text] }
  record Layout { scope-shifts: [Int], symbol-shifts: [Int], symbols: Int }
  fn table-new() -> Table
  fn new-scope!(t: mut Table, parent: Int) -> Int
  fn declare!(t: mut Table, scope: Int, name: Text) -> Int
  fn generated-symbol!(t: mut Table, scope: Int, name: Text) -> Int
  fn table-under(t: Table, scope: Int) -> Table
  fn table-copy(t: Table) -> Table
  fn symbol-at(t: Table, s: Int) -> Symbol
  fn scope-at(t: Table, s: Int) -> Scope
  fn symbol-count(t: Table) -> Int
  fn set-final!(t: mut Table, s: Int, name: Text) -> Void
  fn free-names(t: Table) -> [Text]
  fn graft!(t: mut Table, from: Table, parent: Int) -> Int
  fn grafted(t: Table, parts: [Table], parent: Int) -> Table
  fn layout(parts: [Table]) -> Layout
  fn joined(parts: [Table], scopes: [Int], names: [Text]) -> Table
  fn scope-count(t: Table) -> Int
  fn placed(t: Table, scope-shift: Int, symbol-shift: Int) -> Block
  fn joined-from(blocks: [Block], scopes: Int, symbols: Int, ids: [Int], made-scopes: [Int], names: [Text]) -> Table
  fn changes-Table(a: Table, b: Table, accessor: Text) -> [Int]
  fn no-block() -> Block
  fn renamed(b: Block, names: {Int:Text}) -> Block
  fn block-has?(b: Block, s: Int) -> Bool
  fn named-from(t: Table, blocks: [Block], made: {Int:Text}) -> Table
  fn renamed-all(t: Table, finals: [Text]) -> Table
  fn final-names(t: Table) -> [Text]
  fn has-free?(t: Table, name: Text) -> Bool
}
