# The `.scopes` language, in the grammar language.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-.] ;
fragment Keyword = ("scopes" | "in" | "of" | "through") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;

rule File = "scopes" Name Table* -> File ;
rule Table
  = "ref" Name+ ";" -> Refs(nodes)
  | "bind" Name+ ";" -> Binds(nodes)
  | "scope" Name Name+ ";" -> Opens(kind, nodes)
  | "program" Name ";" -> Program(kind)
  | "names" Name+ "in" Name+ ";" -> Beneath(nodes, kinds)
  | "name" Name+ "in" Name+ ";" -> First(nodes, kinds)
  | "outside" Name+ "of" Name+ ";" -> Outside(children, nodes)
  | "sequential" Name+ ";" -> Sequential(nodes)
  | "dynamic-name" Name+ "in" Name+ "through" Name+ ";" -> DynamicCall(names, nodes, through)
  | "dynamic-name" Name+ ";" -> DynamicName(names)
  | "dynamic" Name+ ";" -> Dynamic(nodes)
  ;
