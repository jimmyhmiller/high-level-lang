# The module graph: load files, normalise what makes modules awkward, analyse scopes.
rules bundle.modules over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.link as link
use bundle.coarse as co
use bundle.resolve as res
use bundle.dce as dce
use bundle.early as early
use bundle.calls as calls
use bundle.comments as cm
use bundle.minhost as host
use bundle.jsx as jsx
use bundle.ts as ts
use bundle.cssbundle as cssb
use bundle.legal as legal
use bundle.tsconfig as tsc

# Resolution requests preserve their kind, including when one module imports and requires the
# same spelling. Keys are a serialization for maps and work items, never module identities.
record Request { spec: Text, kind: res.Kind }

fn import-request(spec: Text) -> Request = Request(spec: spec, kind: res.Import)
fn require-request(spec: Text) -> Request = Request(spec: spec, kind: res.Require)
fn request-key(r: Request) -> Text = match r.kind { res.Import => "import:" res.Require => "require:" } ++ r.spec
fn request-of(key: Text) -> Request = match key {
  "import:" ++ spec => import-request(spec)
  "require:" ++ spec => require-request(spec)
  _ => panic "invalid resolution request {}", key
}
fn requests-in(tree: Node, required: [Text], dynamic: [Text]) -> [Request] =
  [import-request(s) for s in imported-specs(tree)] ++ [require-request(s) for s in required]
  ++ [import-request(s) for s in dynamic]
fn requests-of(p: Parsed) -> [Request] = match p.analysed {
  true => requests-in(p.tree, p.required, p.imports)
  false => requests-in(p.tree, p.requires, p.imports)
}

# `External` is an import left for the runtime: it has no source and no statements.
enum ModuleKind { Esm, Cjs, Runtime, External }

# A module as the program's graph has it: what the whole program's steps need of it. What it is made
# of, its tree and the rest, is its `Body`, which only what works on this module reads, so a step
# over every module never holds every tree.
boxed record Module {
  id: Int,
  path: Text,
  kind: ModuleKind,
  root: Int,
  side-effects: Bool,
  deps: [Int],
  dep-ids: {Text:Int},  # imports and import() by specifier
  require-ids: {Text:Int}, # require() has its own conditions and may resolve the same name differently
  symbol-shift: Int,    # how far those symbols moved when its table joined the shared one
  base: Text,
  free: [Text],
  legal: [Text],
  helpers: [Text],      # runtime helpers lowered code names, which are no global names
  # Whether its tree may `require` or `import()` anything: false when loading found no such call.
  calls: Bool,
  # A script nothing requires or imports whole: it exports nothing, and a name imported from it is
  # undefined, as esbuild has it.
  script: Bool
}

record TextPair { key: Text, value: Text }

# `define process.env.NODE_ENV = "production"`: a dotted name and its replacement.
record Define { key: Text, value: Node }

# The program's modules, by id, and the ids of the files and outside imports, by path; the order
# they run in; the entries (`graph` makes them); and the table of every symbol they declare and
# linking makes, joined once linking is known.
setting modules: [Module]
setting by-path: {Text:Int}
setting order: [Int]
setting entry: Int
setting entries: [Int]
setting table: sym.Table
# Each module's own table at its place, by module: what the shared table is joined from.
setting blocks: {Int:sym.Block}
# Each module's rank in the order the program runs in: modules in that order, by numbers that stay
# while the order around a module does (see `order-ranks`).
setting ranks: {Int:Int}

# The scope around every module's top level: the table's first.
const bundle-scope: Int = 0

# The facts linking states, solved; and the names they use, interned as linking meets them. A
# name keeps its id for as long as the program runs.
setting db: link.Db
setting names: rt.Names = names-new()


# How the build loads, given before it does.
boxed record Loading {
  defines: [Define],
  # A spec's transform runs before scopes are analysed; it is a function value, so while there is
  # one the analysis stays on the thread that links.
  transform: Fn(Node)->Node,
  has-transform: Bool,
  aliases: [TextPair],
  loaders: [TextPair],
  on-resolve: [Fn(Text,Text)->Text?],
  on-load: [Fn(Text)->Text?],
  jsx-options: jsx.Options,
  # Where the output goes, for the paths the file loader writes into modules.
  out-dir: Text,
  packages-external: Bool,
  public-path: Text
}

setting loading: Loading

fn name-id(s: Text) -> Int = intern!(names, s)

# A name's stem: the name without the digits it ends in. Every name renaming tries in place of a
# name, `x`, `x2`, `x3`…, has the name's stem, so only names of one stem can take each other's.
fn stem-of(name: Text) -> Text = name[0..len(name) - span-back-of(name, "0123456789")]

# `node_modules/lodash-es/_root.js` -> `root`, as esbuild names things.
fn base-name(path: Text) -> Text = match text-of-bytes([name-byte(c) for c in raw[start..len(raw)]]) {
  "" => "module"
  out => out
} where raw = match path-stem(path) {
          "index" if dir-of(path) != "." => base-name(dir-of(path))
          stem => stem
        },
        # What can start a name starts it; past that, what cannot be in one becomes `_`.
        start = (first i in 0..len(raw) if name-start?(raw[i]): i) ?? len(raw)

fn name-byte(c: Int) -> Int = match c {
  _ if host.name-byte?(c) => c
  _ => '_'
}

fn name-start?(c: Int) -> Bool = host.name-byte?(c) and c != '_' and not digit-byte?(c)

# A ModuleName is a PropName, or a Str naming an export.
fn module-name(n: Node) -> Text = match n {
  Str(raw) => unquote(raw)
  _ => n.text
}

fn module-of-str(n: Node) -> Text = unquote(n.text)

fn at-source(n: Node, from: Node) -> Node = n with { lo: from.lo, hi: from.hi }

# ---------------------------------------------------------------- normalising

# `export default …` becomes declarations with a real name, so everything after this treats it
# like any other export. Synthetic names get offset -1.
fn default-binding(base: Text) -> Node = BindName(base ++ "_default") with { lo: -1, hi: -1 }

fn var-of(name: Node, init: Node) -> Node = VarDecl(List(Declarator(name, init) with { lo: name.lo, hi: init.hi }))

fn normalize-stmt(s: Node, base: Text) -> Node = match s {
  ExportDefault(e) => var-of(default-binding(base), e)
  ExportDefaultDecl(d) => match d {
    FuncExpr(_, ps, b) => at-source(FuncDecl(bound, ps, b), d)
    GenExpr(_, ps, b) => at-source(GenDecl(bound, ps, b), d)
    AsyncFuncExpr(_, ps, b) => at-source(AsyncFuncDecl(bound, ps, b), d)
    AsyncGenExpr(_, ps, b) => at-source(AsyncGenDecl(bound, ps, b), d)
    ClassExpr(_, h, b) => at-source(ClassDecl(bound, h, b), d)
    _ => panic "unexpected export default declaration: {}", js.kind-name(d.kind)
  } where bound = match d.name {
      None() => default-binding(base)
      name => name
    }
  _ => s
}

fn default-of(s: Node) -> Text? = match s {
  ExportDefault(_) => some("")
  ExportDefaultDecl(d) => some(match d.name {
    None() => ""
    name => name.text
  })
  _ => none
}

# Offsets of the tokens that `/* @__PURE__ */` or `/* #__PURE__ */` comments precede. A match inside
# a string only records an offset no call starts at, unless one really does follow: esbuild makes
# the same call about annotations being advice.
fn pure-annotations(src: Text) -> {Int:Bool} = match src {
  _ if not contains-text?(src, "__PURE__") => {}
  _ => match cm.parse(src, "<comments>") {
    cm.Scan(List(parts...)) =>
      {annotated-token(parts, i + 1, parts[i].hi): true
       for i in 0..len(parts) if parts[i] is cm.Comment(_) and ("@__PURE__" in parts[i].text or "#__PURE__" in parts[i].text)}
  }
}

# Past space and further comments, to the token an annotation applies to.
fn annotated-token(parts: [cm.Node], from: Int, end: Int) -> Int =
  (first j in from..len(parts): token-start(parts[j])) ?? (last p in parts[min(from, len(parts))..len(parts)]: p.hi) ?? end

# Where a piece of the scan has the next token, if it has one. The pieces cover the source.
fn token-start(p: cm.Node) -> Int? = match p {
  cm.Comment(_) => none
  cm.Gap(t) => first lead in [span-of(t, 0, " \n\t\r")] if lead < len(t): p.lo + lead
  _ => some(p.lo)
}

fn mentions-name?(n: Node, name: Text) -> Bool = match n {
  Ident(x) => x == name
  _ => any k in n.kids: mentions-name?(k, name)
}

# A class has a binding of its own name inside it, which is there before the `var` around it is
# assigned: `static x = new A()` needs that. A second, inner name is only worth it if something
# in the class says the name.
# Inside the class its name means the inner binding, which esbuild calls `_Name`. That is what
# `this.constructor.name` says, so it is part of what the program does.
everywhere fn renamed-inside(n: Node, from: Text, to: Text) -> Node = match n {
  Ident(x) if x == from => Ident(to) with { lo: n.lo, hi: n.hi }
  Ident(_) => n
  Shorthand(Ident(x)) if x == from => Prop(PropName(x), Ident(to)) with { lo: n.lo, hi: n.hi }
  _ if len(n.kids) > 0 and from in ts.shadowed-by(n) => n
}

fn declarator-of-class(c: Node) -> Node = match c {
  ClassDecl(name, h, b) => Declarator(name, init) with { lo: name.lo, hi: init.hi }
    where own = name.text,
          inner-name = "_" ++ own,
          init = match mentions-name?(h, own) or mentions-name?(b, own) {
            true => at-source(ClassExpr(BindName(inner-name) with { lo: c.lo, hi: c.lo },
                                        renamed-inside(h, own, inner-name), renamed-inside(b, own, inner-name)), c)
            false => at-source(ClassExpr(None(), h, b), c)
          }
  _ => panic "expected a class declaration"
}

fn split-decl(n: Node, exported: Bool) -> [Node] =
  [at-source(match exported {
     true => ExportVar(List(d))
     false => VarDecl(List(d))
   }, d) for d in n.declarators.kids]

# One declarator per statement, so each can be tree-shaken on its own. A bundle's top level has no
# TDZ worth paying for, so `let`, `const` and classes become `var`.
fn normalized-tree(tree: Node, base: Text) -> Node =
  Program(tree.hashbang, List([normalized(normalize-stmt(s, base))... for s in tree.body.kids]...))

fn normalized(n: Node) -> [Node] = match n {
  VarDecl(_) | LetDecl(_) | ConstDecl(_) => split-decl(n, false)
  ExportVar(_) => split-decl(n, true)
  ExportLexical(LetDecl(_) | ConstDecl(_) as inner) => split-decl(inner, true)
  Empty() => []
  ClassDecl(...) => [at-source(VarDecl(List(declarator-of-class(n))), n)]
  ExportClass(c) => [at-source(ExportVar(List(declarator-of-class(c))), n)]
  _ => [n]
}

# ---------------------------------------------------------------- dependencies

# What a final tree loads at run time: its `require`s, then its `import()`s, in source order.
fn loads-of(tree: Node) -> Checked = Checked(tree: tree, requires: found.requires, imports: found.imports)
  where found = calls.run(tree)

# ---------------------------------------------------------------- defines

# A Member chain rooted at a free identifier, as dotted text: `process.env.NODE_ENV`.
fn dotted-name(n: Node, b: {Int:Int}) -> Text? = match n {
  Ident(x) if n.lo in b => none
  Ident(x) => some(x)
  Member(o, p) => first base in dotted-name(o, b): base ++ "." ++ p.text
  _ => none
}

# Does this source mention the first name of any define? Most files do not, and they need no
# substitution or second analysis.
fn mentions-define?(src: Text) -> Bool = any d in loading.defines: contains-text?(src, text-before(d.key, "."))

# Whether `substitute` would replace anything here: a free name, or a chain from one, that a define
# names. A file can mention a define's name, in a comment or as a property, and use none.
fn defines-apply?(n: Node, b: {Int:Int}) -> Bool = is-some(defined(n, b)) or (any k in n.kids: defines-apply?(k, b))

fn define-of(key: Text) -> Node? = last d in loading.defines if d.key == key: d.value

# What a define replaces this node with: a free name, or a chain from one, that a define names.
fn defined(n: Node, b: {Int:Int}) -> Node? = match n {
  Ident(_) | Member(...) => first key in dotted-name(n, b): define-of(key)
  _ => none
}

# Replace defined names. This needs the scope analysis, because a local with the same name is not
# the define.
fn substitute(n: Node, b: {Int:Int}) -> Node = match defined(n, b) {
  some(v) => v
  none if len(n.kids) == 0 => n
  none => n with { kids: [substitute(k, b) for k in n.kids] }
}

# ---------------------------------------------------------------- loading

# A parsed and checked file, and the `require`s and `import()`s the check's traversal found.
boxed record Checked { tree: Node, requires: [Text], imports: [Text] }

# Parse and check a file. A file with import or export syntax is a module; anything else may be
# CommonJS, whose top level is a function body.
fn parse-file(src: Text, path: Text) -> Checked = match found.problem {
  none => Checked(tree: tree, requires: found.requires, imports: found.imports)
  some(p) => panic "{}:{}:{}: {}", path, line-of(src, p.at), col-of(src, p.at), p.message
} where loader = loader-of(path),
        syntax = sum flag in [x for x in ["jsx"] if loader == "jsx" or loader == "tsx"]
                             ++ [x for x in ["ts"] if loader == "ts" or loader == "tsx"]: js.flag-bit(flag),
        tree = js.parse-tries(src, path, syntax, js.flag-bit("await")),
        is-module = early.program-has-module-syntax?(tree),
        found = early.run(tree, is-module, not is-module, loader == "ts" or loader == "tsx", false, false, [])

# Lowering JSX or TypeScript makes another tree of a file's.
fn lowered-loader?(loader: Text) -> Bool = loader == "jsx" or loader == "tsx" or loader == "ts"

# A project's JSX settings, unless the build gave its own.
fn configured-jsx(o: jsx.Options, c: tsc.Config) -> jsx.Options = match o.explicit {
  true => o
  false => o with { runtime: runtime, dev: o.dev or c.jsx == "react-jsxdev", factory: or-else(c.jsx-factory, o.factory),
                    fragment: or-else(c.jsx-fragment, o.fragment), import-source: or-else(c.jsx-import-source, o.import-source) }
    where runtime = match c.jsx {
      "react" => jsx.Classic
      "react-jsx" | "react-jsxdev" => jsx.Automatic
      "preserve" | "react-native" => jsx.Preserve
      _ => o.runtime
    }
}

fn or-else(given: Text, otherwise: Text) -> Text = match given {
  "" => otherwise
  _ => given
}

# Is this file in node compatibility mode: `.mjs`, or under "type": "module"?
fn node-mode?(path: Text) -> Bool = ends-with(path, ".mjs") or res.package-type-module?(path)

fn blank-module(id: Int, path: Text, kind: ModuleKind, root: Int) -> Module =
  Module(id: id, path: path, kind: kind, root: root, side-effects: true,
         deps: [], dep-ids: {}, require-ids: {}, symbol-shift: 0, base: base-name(path), free: [],
         legal: [], helpers: [], calls: true, script: false)

# What a module is made of: its tree; the symbol each name leaf is, by where it starts, as its own
# table numbers them; its statements as written; its source; and where it marks calls pure.
boxed record Body { tree: Node, bindings: {Int:Int}, source: [Node], text: Text, pure-at: {Int:Bool}, pure-calls: {Int:Int} }

fn empty-body() -> Body = Body(tree: None(), bindings: {}, source: [], text: "", pure-at: {}, pure-calls: {})

# Module `id`'s body.
fn body-of(id: Int) -> Body = body-made(modules[id])

fn body-made(mo: Module) -> Body = match mo.kind {
  Runtime => Body(tree: rt.tree, bindings: rt.analysis.bindings, source: [], text: text, pure-at: {}, pure-calls: {})
    where text = include-text("runtime.js"),
          rt = runtime-parsed(text)
  External => empty-body()
  _ => file-body(loaded(mo.path))
}

fn file-body(l: Loaded) -> Body =
  Body(tree: l.analysis.tree, bindings: l.analysis.bindings, source: l.tree0.body.kids, text: l.parsed.src,
       pure-at: l.parsed.pure-at, pure-calls: l.parsed.pure-calls)

# An alias replaces a package name, and carries any subpath along.
fn aliased(spec: Text) -> Text = (first a in loading.aliases: alias-of(a, spec)) ?? spec

# What an alias makes of a specifier: the package it names, and any subpath along with it.
fn alias-of(a: TextPair, spec: Text) -> Text? = match spec {
  _ if spec == a.key => some(a.value)
  _ if starts-with(spec, a.key ++ "/") => some(a.value ++ spec[len(a.key)..len(spec)])
  _ => none
}

# What a resolve hook says about this import, asked once.
fn hook-path(spec: Text, importer: Text) -> Text? = match loading.on-resolve {
  [] => none
  hooks => hook-answer(spec, importer)
}

fn hook-answer(spec: Text, importer: Text) -> Text? = first hook in loading.on-resolve: hook(spec, importer)

# Is this import left for the runtime? A hook's answer overrides that, as an alias does, and with
# `--packages=external` so is every package.
fn stays-external?(spec: Text, importer: Text) -> Bool =
  is-none(hook-path(aliased(spec), importer)) and unhooked-external?(spec, importer)

# The same, of a build with no resolve hooks to ask.
fn unhooked-external?(spec: Text, importer: Text) -> Bool =
  res.external?(aliased(spec)) or (loading.packages-external and package-spec?(aliased(spec), importer))

fn package-spec?(spec: Text, importer: Text) -> Bool =
  not (res.relative?(spec) or starts-with(spec, "/") or starts-with(spec, "#")) and is-none(configured-path(spec, importer))

# A project's `paths` and `baseUrl` come before node_modules, for a bare specifier.
fn configured-path(spec: Text, importer: Text) -> Text? = match spec {
  _ if res.relative?(spec) or starts-with(spec, "/") => none
  _ => (first candidate in tsc.path-candidates(c, spec): res.try-path(candidate))
       ?? (first base in [c.base-url] if base != "": res.try-path(base ++ "/" ++ spec))
    where c = tsc.for-file(importer)
}

# Where an import leads: resolve hooks first, then the project's paths, then the search. A worker
# that parsed the importer ahead may have found the answer already.
fn resolve-import(spec: Text, importer: Text) -> res.Resolved = resolved-now(import-request(spec), importer)

fn resolved-now(request: Request, importer: Text) -> res.Resolved = match hook-path(aliased(request.spec), importer) {
  some(p) => res.Resolved(path: p, side-effects: true)
  none => unhooked-resolved(request, importer)
}

# Where an import leads when no hook says: the project's paths, then the search.
fn unhooked-resolved(request: Request, importer: Text) -> res.Resolved = match configured-path(wanted, importer) {
  some(p) => res.Resolved(path: p, side-effects: res.side-effects-of(p))
  # A relative alias is relative to where the build runs, not to the importing file.
  none => res.resolve-kind(wanted, match wanted != spec and res.relative?(wanted) {
    true => "alias"
    false => importer
  }, request.kind)
} where spec = request.spec, wanted = aliased(spec)

fn loader-of(path: Text) -> Text = (first l in loading.loaders if ends-with(path, l.key): l.value) ?? default-loader(path)

fn default-loader(path: Text) -> Text = match path {
  _ ++ ".json" => "json"
  _ ++ ".jsx" => "jsx"
  _ ++ ".tsx" => "tsx"
  _ ++ ".css" => "css"
  _ ++ ".ts" | _ ++ ".mts" | _ ++ ".cts" => "ts"
  _ => "js"
}

# A file's text as a module, by what its loader says it is.
fn as-module(text: Text, path: Text) -> Text = match loader-of(path) {
  "file" => "export default " ++ host.js-string(cssb.file-url(path)) ++ ";"
  _ => module-text(text, path)
}

# A load hook may supply a file's text, or the file does.
fn source-of(path: Text) -> Text = (first hook in loading.on-load: hook(path)) ?? unhooked-source(path)

fn unhooked-source(path: Text) -> Text = match path {
  "disabled:" ++ _ => "module.exports = {};"
  _ => read-file(path)
}

# The specifier a statement imports from, or nothing.
fn import-spec-of(s: Node) -> Text? = match s {
  Import(_, from) | ExportAllAs(_, from) | ExportFrom(_, from) => some(module-of-str(from))
  ImportBare(from) | ExportAll(from) => some(module-of-str(from))
  _ => none
}

# Load a file and, first, everything it imports: `order` is post-order, so a module's dependencies
# come before it, as they do in esbuild's output.
# ---------------------------------------------------------------- the per-file stage

# A file to parse: its text when that has been read already, which a load hook or the file loader
# does on the thread that owns them.
record Pending { path: Text, text: Text, ready: Bool }

# Everything one file says by itself, before anything links it to another.
boxed record Parsed {
  path: Text,
  src: Text,
  parsed: Node,
  tree: Node,
  pure-calls: {Int:Int},
  helpers: [Text],
  jsx-imports: Bool,
  pure-at: {Int:Bool},
  legal: [Text],
  specs: [Text],
  targets: {Text:Text}, # where each specifier led, when it was resolved ahead
  analysed: Bool,       # whether `scopes` and `analysis` hold its scope analysis already
  scopes: sym.Table,
  analysis: Analysis,
  calls: [Text],        # with the analysis: what its final tree `require`s, then `import()`s
  required: [Text],     # with the analysis: what its final tree `require`s
  requires: [Text],     # what the tree as parsed `require`s, and `import()`s, when `found`
  imports: [Text],
  found: Bool
}

# A file's scope analysis: its tree once defines are applied, its root scope, which symbol each name
# leaf is, the names it leaves free, and whether it is CommonJS.
# `shift`: how far the symbols `bindings` names moved when the file's own table joined the shared
# one, which the bindings themselves catch up with once loading is done.
# `defined`: whether a define changed the tree.
# `script`: no module syntax, and no `module` or `exports`; `wrapped`: analysed inside CommonJS's
# wrapper, as a script must be to become CommonJS.
boxed record Analysis { tree: Node, root: Int, bindings: {Int:Int}, free: [Text], cjs: Bool, script: Bool, wrapped: Bool, shift: Int,
                  defined: Bool }

fn no-analysis() -> Analysis =
  Analysis(tree: None(), root: -1, bindings: {}, free: [], cjs: false, script: false, wrapped: false, shift: 0, defined: false)

# A file's scopes, and the table they are in.
boxed record Analysed { analysis: Analysis, scopes: sym.Table }

# What a file declares and uses, in a table of its own. Defines are substituted and the branches
# they decide removed, then the result is analysed again, so what they kill is never seen by tree
# shaking. A file with no module syntax is analysed inside CommonJS's (exports, module) wrapper:
# it is CommonJS when it names `module` or `exports`, and otherwise a script, which becomes
# CommonJS only if it is required, or its default or namespace imported, as esbuild has it; which
# the graph knows once every file is loaded. Not when a define is about `module` or `exports`,
# which the wrapper would hide; such a script is analysed again inside it if it names them after
# all. A name free in any of the analyses is free.
fn analysis-of(tree0: Node, parsed: Node, src: Text, path: Text, base: Text, jsx-imports: Bool, helpers: [Text]) -> Analysed =
  Analysed(analysis: Analysis(tree: final-tree, root: final.root, bindings: final.bindings, free: real-free, cjs: cjs,
                              script: not esm and not cjs, wrapped: wrapped or cjs, shift: 0, defined: defined),
           scopes: final.table)
  where esm = early.program-has-module-syntax?(tree0) or module-extension?(path),
        tree = normalized-tree(tree0, base),
        wrapped = wrapper-wanted?(esm),
        first = sc.analysis(tree, [x for x in ["exports", "module"] if wrapped]),
        # Whether it names `module` or `exports` without declaring them.
        cjs = commonjs-extension?(path) or (match wrapped {
          true => wrapper-names-module?(first)
          false => not esm and ("module" in first.free or "exports" in first.free)
        }),
        defined = mentions-define?(src) and defines-apply?(tree, first.bindings),
        final-tree = match defined {
          true => dce.run(substitute(tree, first.bindings))
          false => tree
        },
        final = match defined or (cjs and not wrapped) {
          true => sc.analysis(final-tree, [x for x in ["exports", "module"] if wrapped or cjs])
          false => first
        },
        real-free = [f for f in first.free ++ [f for f in final.free if not (f in first.free)]
                     if not ((cjs and (f == "exports" or f == "module")) or f in helpers)]

# The automatic JSX runtime of a file that is CommonJS (no module syntax of its own, and it names
# `module` or `exports`), required rather than imported, which would make it an ES module.
fn commonjs-runtime(l: jsx.Lowered, parsed: Node, src: Text) -> jsx.Lowered = match l.imports and not early.program-has-module-syntax?(parsed) {
  true if wrapper-names-module?(sc.analysis(l.tree, ["exports", "module"])) => l with { tree: jsx.runtime-required(l.tree, src) }
  _ => l
}

# A `.mjs` file is an ES module and a `.cjs` file CommonJS, whatever they hold, as esbuild has them.
fn module-extension?(path: Text) -> Bool = ends-with(path, ".mjs") or ends-with(path, ".mts")
fn commonjs-extension?(path: Text) -> Bool = ends-with(path, ".cjs") or ends-with(path, ".cts")

# A file with no module syntax is analysed inside CommonJS's wrapper, unless a define is about
# `module` or `exports`, which the wrapper would hide.
fn wrapper-wanted?(esm: Bool) -> Bool = not esm and not (any d in loading.defines: text-before(d.key, ".") in ["module", "exports"])

# Whether code in CommonJS's wrapper reads `module` or `exports`.
fn wrapper-names-module?(w: sym.Analysis) -> Bool =
  wrapper-used?(w.table, wrapper-of(w), "module") or wrapper-used?(w.table, wrapper-of(w), "exports")

# The wrapper scope of an analysis made inside CommonJS's wrapper: the root's parent.
fn wrapper-of(s: sym.Analysis) -> Int = sym.scope-at(s.table, s.root).parent

# The symbol the name leaf starting at `lo` is, in the shared table's numbering.
fn symbol-of(mo: Module, lo: Int) -> Int? = symbol-in(body-of(mo.id), mo, lo)

# The same, with the module's body in hand: what reads every name of a module asks this.
fn symbol-in(b: Body, mo: Module, lo: Int) -> Int? = first s in b.bindings[lo]: s + mo.symbol-shift

# The text a module of this loader stands for. Not the file loader's: that writes an asset, so it
# is made by `as-module`, on the thread that links.
fn module-text(text: Text, path: Text) -> Text = match loader-of(path) {
  "js" | "jsx" | "ts" | "tsx" => text
  "json" => "module.exports = " ++ text
  "text" => "export default " ++ host.js-string(text) ++ ";"
  "base64" => "export default \"" ++ host.base64(text) ++ "\";"
  "dataurl" => "export default \"" ++ host.data-url-of(text, host.mime-of(path)) ++ "\";"
  "empty" | "css" => ""
  "file" => panic "{}: the file loader's text is made by the linking stage", path
  other => panic "{}: no loader named {}", path, other
}

# What one file's own text says: parsed, checked, its JSX and TypeScript lowered, its comments read,
# and every specifier it might import. Touches only task state, so any number can run at once.
fn parsed-file(item: Pending) -> Parsed = parsed-with(item.path, src, checked.tree, none, some(checked))
  where src = match item.ready {
          true => item.text
          false => module-text(unhooked-source(item.path), item.path)
        },
        checked = parse-file(src, item.path)

# Everything after parsing, for a file parsed whole or put together from its pieces: with the
# specifiers its imports name when they are known already, and what checking it found.
fn parsed-with(path: Text, src: Text, parsed: Node, known: [Text]?, checked: Checked?) -> Parsed =
  Parsed(path: path, src: src, parsed: parsed, tree: typed.tree, pure-calls: pure-calls,
         helpers: typed.helpers, jsx-imports: lowered.imports, pure-at: pure-annotations(src),
         legal: legal.of-file(src, parsed), specs: specs, targets: {}, requires: found.requires, imports: found.imports,
         found: is-none(known),
         analysed: false, scopes: sym.table-new(), analysis: no-analysis(), calls: [], required: [])
  where loader = loader-of(path),
        config = tsc.for-file(path),
        file-jsx = configured-jsx(loading.jsx-options, config),
        lowered = match loader {
          "jsx" | "tsx" => commonjs-runtime(jsx.lower(parsed, src, path, file-jsx), parsed, src)
          _ => jsx.Lowered(tree: parsed, pure-calls: {}, imports: false)
        },
        typed = match loader {
          "ts" | "tsx" => ts.lower(lowered.tree, src, jsx.kept-names(src, path, file-jsx), tsc.define-fields?(config),
                                   config.verbatim, config.decorators)
          _ => ts.Lowered(tree: lowered.tree, pure-calls: {}, helpers: [])
        },
        pure-calls = {k: v for m in [lowered.pure-calls, typed.pure-calls] for k in keys(m) if let some(v) = m[k]},
        # Every `require` and `import()`, even in code a define will remove: looking ahead may read
        # a file the build never uses, but never misses one it does. The check found them already, in
        # the tree a plain JavaScript file keeps. A file put together from pieces knows its specifiers.
        found = match known, checked {
          some(_), _ => Checked(tree: typed.tree, requires: [], imports: [])
          none, some(c) if not lowered-loader?(loader) => c
          _, _ => loads-of(typed.tree)
        },
        specs = known ?? (imported-specs(typed.tree) ++ found.requires ++ found.imports)

# The same, with scopes analysed too, in a table of the file's own. Not while a spec's transform
# has to see the tree first.
fn analysed-file(p: Parsed) -> Parsed = match loading.has-transform {
  true => p
  false => p with { analysed: true, scopes: a.scopes, analysis: a.analysis, calls: calls, required: found.requires, imports: found.imports, specs: specs }
    where a = analysis-of(p.tree, p.parsed, p.src, p.path, base-name(p.path), p.jsx-imports, p.helpers),
          # The calls are the parsed tree's unless a define changed it, and those were found already.
          found = match p.found and not a.analysis.defined {
            true => Checked(tree: p.tree, requires: p.requires, imports: p.imports)
            false => loads-of(a.analysis.tree)
          },
          calls = found.requires ++ found.imports,
          # Once defines have removed code, what it loads is what is left: `require`s a define
          # removed, as of a development build, are not read ahead.
          specs = match a.analysis.defined {
            true => imported-specs(p.tree) ++ calls
            false => p.specs
          }
}

fn imported-specs(tree: Node) -> [Text] = [spec for s in tree.body.kids if let some(spec) = import-spec-of(s)]

# A file as a build with no hooks parses it: its text parsed and analysed and its imports resolved;
# a big file put together from its pieces.
fn parsed-plain(path: Text) -> Parsed = match len(sp.starts) {
  n if n > 1 => finished-file(path)
  _ => targets-of(analysed-file(parsed-file(Pending(path: path, text: sp.src, ready: true))))
} where sp = split-source(path)

# Where each of a file's imports leads, by what it asks for.
fn targets-of(p: Parsed) -> Parsed =
  p with { targets: {request-key(requests[i]): t for i in 0..len(requests) if let some(t) = found[i]} }
  where requests = requests-of(p),
        found = [unhooked-target(r, p.path) for r in requests]

# What a file leads to, for the walk that parses every file before the graph is made. Whoever
# parses a file works out its place in the graph too, when it can (see `plain?`).
fn led-ahead(path: Text) -> [Text] = match plain?(path) {
  true => ahead-targets(loaded-plain(path).parsed)
  false => ahead-targets(parsed-plain(path))
}

fn ahead-targets(p: Parsed) -> [Text] = [t for t in values-of(p.targets) if ahead?(t)]

# The file the walk reads for a name: its own path; nothing for a module left empty.
fn file-read(item: Text) -> Text = match item {
  "disabled:" ++ _ => ""
  path => path
}

# ---------------------------------------------------------------- big files, in pieces

# A big file of plain JavaScript is parsed in pieces, on several threads. A piece starts on a line
# that begins a declaration, outside every bracket, string, template, comment and regular
# expression, as the coarse grammar (coarse.syntax) reads them. It can be wrong only one way that
# matters: a piece before a wrong start is no program by itself, and then the file is parsed whole.
const piece-bytes: Int = 8192

# A file's text and where its pieces start. A library inside one function is cut inside that
# function's body, from `open`, its `{`, up to `close`, its `}`; -1 when the file is cut at its
# own top level.
record Parts { src: Text, starts: [Int], open: Int, close: Int }

# At 0 alone unless it is big plain JavaScript.
fn split-source(path: Text) -> Parts = match src {
  _ if loading.has-transform or loader-of(path) != "js" or len(src) < 2 * piece-bytes => Parts(src: src, starts: [0], open: -1, close: -1)
  _ => parts-of-source(src)
} where src = module-text(unhooked-source(path), path)

fn parts-of-source(src: Text) -> Parts = match top-cuts {
  [_, ...] => whole with { starts: [0] ++ top-cuts }
  [] => (first b in body-span(src, lines) for inner in [body-cuts(src, lines, b)] if len(inner) > 0:
           Parts(src: src, starts: [b.open + 1] ++ inner, open: b.open, close: b.close))
        ?? whole
    where starts = line-starts(src),
          lines = Lines(starts: starts, indents: line-indents(src, starts))
} where whole = Parts(src: src, starts: [0], open: -1, close: -1),
        # A file with no declaration at the start of a line has nowhere to cut at its top level.
        top-cuts = match index-of-any(src, ["\n" ++ k for k in declaration-words]) {
          some(_) => piece-starts(src)
          none => []
        }

record Span { open: Int, close: Int }

# A library inside one function is cut by how its code is laid out, which is how it was written:
# the function's body is the lines inside it, the body's statements start at its indentation, and
# a block in it runs from a line there that ends with `{` to the next there that starts with `}`.
# A wrong guess is no function body, or a piece that is no program, and the file is parsed whole.

# Where each line starts, and how far it is indented (-1 when it is blank).
record Lines { starts: [Int], indents: [Int] }

# The body of a function that is nearly all of the file: from the first line to end with `{` to
# the last line to start with `}`. Then, as long as one block in it holds most of it, as a
# library's own function inside the wrapper does, that block's.
fn body-span(src: Text, lines: Lines) -> Span? =
  first open in index-of(src, "{\n") for nl in last-index-of(src, "\n}") if nl > open and (nl + 1 - open) * 10 >= len(src) * 9:
    innermost(src, lines, Span(open: open, close: nl + 1))

fn innermost(src: Text, lines: Lines, s: Span) -> Span = match dominant-block(src, lines, s) {
  some(inner) => innermost(src, lines, inner)
  none => s
}

# The lines of a body at its own indentation, and that indentation.
record Level { depth: Int, starts: [Int] }

fn level-of(lines: Lines, s: Span) -> Level = Level(depth: depth, starts: [lines.starts[i] for i in from..to if lines.indents[i] == depth])
  where from = bisect(lines.starts, s.open),
        to = bisect(lines.starts, s.close - 1),
        depth = (first i in from..to if lines.indents[i] >= 0: lines.indents[i]) ?? 0

# The biggest block at a body's own indentation, when it is at least half the body.
fn dominant-block(src: Text, lines: Lines, s: Span) -> Span? = match level-of(lines, s) {
  level if level.depth <= 0 => none
  level => first b in blocks if biggest * 2 >= s.close - s.open and b.close - b.open == biggest: b
    where ls = level.starts,
          blocks = [Span(open: end - 1, close: c + level.depth)
                    for i in 0..len(ls) if let some(end) = line-end(lines, ls[i]) if at?(src, end - 1, "{")
                    if let some(c) = (first j in i + 1..len(ls) if at?(src, ls[j] + level.depth, "}"): ls[j])],
          biggest = fold best = -1 for b in blocks: max(best, b.close - b.open)
}

# Where the line starting at `at` ends: its line break.
fn line-end(lines: Lines, at: Int) -> Int? =
  first next in [bisect(lines.starts, at)] if next < len(lines.starts): lines.starts[next] - 1

const declaration-words: [Text] = ["function ", "function*", "async function", "class ", "var ", "let ", "const "]

# The body's statements that start a declaration, as cuts a piece's size apart.
fn body-cuts(src: Text, lines: Lines, b: Span) -> [Int] = match level-of(lines, b) {
  level if level.depth <= 0 => []
  level => fold cuts = [] for l in level.starts if (any k in declaration-words: at?(src, l + level.depth, k))
                          if b.close - (l + level.depth) >= piece-bytes:
    cuts ++ [at for at in [l + level.depth] if at - ((last c in cuts: c) ?? b.open + 1) >= piece-bytes]
}

# Where piece `k` ends.
fn piece-end(sp: Parts, k: Int) -> Int = match k + 1 {
  next if next < len(sp.starts) => sp.starts[next]
  _ if sp.open >= 0 => sp.close
  _ => len(sp.src)
}

# A function's body put together from its pieces: the file parsed with only the body's line breaks
# left of it, what follows moved back where it was, and the pieces' statements in the body. Nothing
# when that is not exactly one empty function body, or a piece has import or export syntax, which
# a function body cannot.
fn assembled(sp: Parts, path: Text, pieces: [Node]) -> Node? = match pieces {
  _ if any t in pieces: early.program-has-module-syntax?(t) => none
  _ => first parsed in js.parse-opt(outer-src, path, 0) for outer in [moved(parsed, tail, sp.close - tail)]
             if body-count(outer, sp.open, sp.close + 1) == 1:
         filled-body(outer, sp.open, sp.close + 1, [s for t in pieces for s in t.body.kids], pieces)
    where breaks = count-byte(sp.src, sp.open + 1, sp.close, '\n'),
          tail = sp.open + 1 + breaks,
          outer-src = sp.src[0..sp.open + 1] ++ repeated("\n", breaks) ++ sp.src[sp.close..len(sp.src)]
}

# Everything from `from` on moved `by`.
fn moved(n: Node, from: Int, by: Int) -> Node = match n {
  _ if n.hi < from => n
  _ => n with { lo: match n.lo {
                  lo if lo >= from => lo + by
                  lo => lo
                },
                hi: n.hi + by, kids: [moved(k, from, by) for k in n.kids] }
}

# How many empty function bodies span exactly `lo` to `hi`.
fn body-count(n: Node, lo: Int, hi: Int) -> Int = match n {
  FuncBody(List()) if n.lo == lo and n.hi == hi => 1
  _ => sum k in n.kids if k.lo <= lo and hi <= k.hi: body-count(k, lo, hi)
}

fn filled-body(n: Node, lo: Int, hi: Int, stmts: [Node], pieces: [Node]) -> Node = match n {
  FuncBody(List()) if n.lo == lo and n.hi == hi => n with { stmts: n.stmts with { kids: stmts, lo: pieces[0].body.lo, hi: last(pieces).body.hi } }
  _ if n.lo <= lo and hi <= n.hi and len(n.kids) > 0 => n with { kids: [filled-body(k, lo, hi, stmts, pieces) for k in n.kids] }
  _ => n
}

boxed record PieceTree { tree: Node?, specs: [Text], targets: {Text:Text} }

# One piece: its statements, parsed as a program of their own, and where what they import leads.
fn piece-of(path: Text, k: Int) -> PieceTree = match js.parse-piece(sp.src[0..piece-end(sp, k)], path, 0, sp.starts[k]) {
  none => PieceTree(tree: none, specs: [], targets: {})
  some(tree) => PieceTree(tree: some(tree), specs: specs, targets: {request-key(r): t for r in requests-in(tree, found.requires, found.imports) if let some(t) = unhooked-target(r, path)})
    where found = calls.run(tree),
          specs = [spec for s in tree.body.kids if let some(spec) = import-spec-of(s)] ++ found.requires ++ found.imports
} where sp = split-source(path)

# A big file's pieces, each its own work.
fn pieces-of(path: Text) -> [PieceTree] = [piece-of(path, k) for k in 0..len(split-source(path).starts)]

# A big file put together from its pieces, ready for its parts to be analysed at once: the program as
# parsed, the program as analysed (its top level normalised one piece at a time), and a table that
# holds the program's own names. Not `whole` when a piece is no program by itself, or when a
# statement at the top level is sequential: its scope holds the parts after it, which a walk of
# their own would not be in.
# `raw`: each piece's statements as parsed, which early errors are checked on.
# `wrapper`: the scope of CommonJS's (exports, module) wrapper the program was declared under, when
# a script names them and so is probably CommonJS; -1 when it was not.
boxed record Prepared { whole: Bool, tree0: Node, tree: Node, parts: [[Node]], raw: [[Node]], scopes: sym.Table, root: Int,
                  esm: Bool, mentions: Bool, exportable: [Text], wrapper: Int }

fn prepared-of(path: Text) -> Prepared = match pieces {
  # A function's body is put together and analysed whole.
  _ if sp.open >= 0 or (any t in pieces: is-none(t))
       or (any t in [t for some(t) in pieces]: any s in t.body.kids: sc.sequential?(s.kind)) =>
    Prepared(whole: false, tree0: None(), tree: None(), parts: [], raw: [], scopes: sym.table-new(), root: -1,
             esm: false, mentions: false, exportable: [], wrapper: -1)
  _ => Prepared(whole: true, tree0: tree0, tree: tree, parts: parts, raw: [t.body.kids for t in trees], scopes: own.table, root: own.root,
                esm: esm, mentions: mentions-define?(sp.src), exportable: early.exportable-of(tree0),
                wrapper: match wrapped {
                  true => sym.scope-at(own.table, own.root).parent
                  false => -1
                })
    where trees = [t for some(t) in pieces],
          head = trees[0],
          tree0 = head with { body: head.body with { kids: [s for t in trees for s in t.body.kids], hi: last(trees).body.hi },
                              hi: last(trees).hi },
          parts = [normalized-tree(t, base-name(path)).body.kids for t in trees],
          tree = Program(tree0.hashbang, List([s for part in parts for s in part]...)),
          esm = early.program-has-module-syntax?(tree0) or module-extension?(path),
          wrapped = wrapper-wanted?(esm),
          own = sc.declarations(tree, [x for x in ["exports", "module"] if wrapped])
} where sp = split-source(path),
        pieces = [pc.tree for pc in pieces-of(path)]

# One part's walk, in a table of its own under the program's scope.
# `defined`: whether a define applies in the part, which only its own bindings can tell. Its
# `require`s and `import()`s too, which the whole file's are made of.
boxed record Walked { scopes: sym.Table, bindings: {Int:Int}, defined: Bool, requires: [Text], imports: [Text],
                problem: early.Problem? }

fn walked-of(path: Text, k: Int) -> Walked =
  Walked(scopes: own.table, bindings: own.bindings, defined: pr.mentions and (any s in pr.parts[k]: defines-apply?(s, own.bindings)),
         requires: found.requires, imports: found.imports, problem: found.problem)
  where pr = prepared-of(path),
        own = sc.part-analysis(pr.scopes, pr.root, [pr.tree.hashbang for x in [k] if x == 0] ++ pr.parts[k]),
        # Checking the part finds what it loads, in its statements as parsed: normalising them
        # keeps every call, in order.
        found = early.part-found(pr.tree0, pr.esm, not pr.esm, false, pr.exportable, pr.raw[k])

# What parsing a file whole checks of its statements together, at once with the parts' walks,
# which check each part's.
fn early-of(path: Text) -> early.Problem? = early.check-head(pr.tree0, pr.esm, not pr.esm, false) where pr = prepared-of(path)

fn from-of(path: Text) -> Parsed =
  parsed-with(path, split-source(path).src, prepared-of(path).tree0,
              some([s for pc in pieces-of(path) for s in pc.specs]), none)

# The big file, analysed: its parts' tables grafted in order, as one walk would have filled the
# table, ids and all. CommonJS, and code a define changes, are analysed again whole, as
# `analysis-of` does.
# A library inside one function, its body parsed in pieces and put together, then checked as the
# whole file would be.
fn nested-file(path: Text) -> Parsed? = match sp.open {
  open if open < 0 => none
  _ => first pieces in [[pc.tree for pc in pieces-of(path)]]
             if all t in pieces: is-some(t)
             for tree in assembled(sp, path, [t for some(t) in pieces]):
         nested-checked(path, sp.src, tree)
} where sp = split-source(path)

fn nested-checked(path: Text, src: Text, tree: Node) -> Parsed = match found.problem {
  none => parsed-with(path, src, tree, none, some(Checked(tree: tree, requires: found.requires, imports: found.imports)))
  some(p) => panic "{}:{}:{}: {}", path, line-of(src, p.at), col-of(src, p.at), p.message
} where found = early.run(tree, false, true, false, false, false, [])

fn finished-file(path: Text) -> Parsed = match prepared-of(path) {
  pr if not pr.whole =>
    targets-of(analysed-file(nested-file(path) ?? parsed-file(Pending(path: path, text: split-source(path).src, ready: true))))
  pr => joined-file(path, pr)
}

# A big file from its parts, as one walk would have made it. CommonJS names `module`, `exports` or
# `require` without declaring them: free, or under the wrapper, the wrapper's. A file prepared for
# the wrapper that turns out not to be CommonJS, or one prepared without it that is, is analysed
# again whole, as is code a define changes.
fn joined-file(path: Text, pr: Prepared) -> Parsed =
  match early-of(path) ?? (first w in walks: w.problem), (cjs and pr.wrapper < 0) or p.jsx-imports or (any w in walks: w.defined) {
    some(at), _ => panic "{}:{}:{}: {}", path, line-of(sp.src, at.at), col-of(sp.src, at.at), at.message
    none, true => targets-of(analysed-file(p))
    none, false => p with { analysed: true, scopes: own, analysis: a, calls: calls, required: [r for w in walks for r in w.requires], imports: [r for w in walks for r in w.imports],
                            targets: targets }
  }
  where sp = split-source(path),
        p = from-of(path),
        found = [pc.targets for pc in pieces-of(path)],
        targets = {spec: t for pt in found for spec in keys(pt) if let some(t) = pt[spec]},
        walks = [walked-of(path, k) for k in 0..len(pr.parts)],
        # A part's symbols move by how many the table holds before it is grafted.
        ends = scan n = sym.symbol-count(pr.scopes) for w in walks: n + sym.symbol-count(w.scopes),
        bindings = {key: rebound(v, ends[k] - sym.symbol-count(walks[k].scopes))
                    for k in 0..len(walks) for key in keys(walks[k].bindings) if let some(v) = walks[k].bindings[key]},
        own = sym.grafted(pr.scopes, [w.scopes for w in walks], pr.root),
        cjs = commonjs-extension?(path) or (not pr.esm and names-module?(own, pr.wrapper)),
        a = Analysis(tree: pr.tree, root: pr.root, bindings: bindings, free: [f for f in sym.free-names(own) if not (f in p.helpers)],
                     cjs: cjs, script: not pr.esm and not cjs, wrapped: pr.wrapper >= 0, shift: 0, defined: false),
        calls = [r for w in walks for r in w.requires] ++ [r for w in walks for r in w.imports]

# A part's binding: a symbol of the part, moved by where the part lands, or one of the table it was
# made under, as -(id + 1).
fn rebound(v: Int, shift: Int) -> Int = match v {
  _ if v < 0 => -1 - v
  _ => v + shift
}

# Whether code reads `module` or `exports`: under the wrapper when there is one, else as free names.
fn names-module?(own: sym.Table, wrapper: Int) -> Bool = match wrapper {
  _ if wrapper >= 0 => wrapper-used?(own, wrapper, "module") or wrapper-used?(own, wrapper, "exports")
  _ => sym.has-free?(own, "module") or sym.has-free?(own, "exports")
}

fn wrapper-used?(t: sym.Table, wrapper: Int, name: Text) -> Bool = any s in sym.scope-at(t, wrapper).names[name]: sym.symbol-at(t, s).uses > 0

# Early errors, which `parse-file` checks of a file parsed whole.
fn checked-early(tree: Node, src: Text, path: Text) -> Node = match early.check(tree, is-module, not is-module, false) {
  none => tree
  some(p) => panic "{}:{}:{}: {}", path, line-of(src, p.at), col-of(src, p.at), p.message
} where is-module = early.program-has-module-syntax?(tree)

# Where a large file is cut: where the coarse grammar finds a declaration starting a line at the
# top level, at least a piece's size from the last cut and from the end. A file the coarse grammar
# cannot read is not cut.
fn piece-starts(src: Text) -> [Int] = match co.parse-opt(src, "<coarse>", 0) {
  some(co.Coarse(List(items...))) =>
    fold cuts = [] for co.Cut(_) as line in items if len(src) - line.hi >= piece-bytes:
      cuts ++ [at for at in [line.hi] if at - ((last c in cuts: c) ?? 0) >= piece-bytes]
  _ => []
}

fn values-of(m: {Text:Text}) -> [Text] = [m[k] ?? k for k in keys(m)]

# `ahead-target` without hooks, which only the thread that owns them may call.
fn unhooked-target(request: Request, importer: Text) -> Text? = match wanted {
  _ if res.external?(wanted) or (loading.packages-external and package-spec?(wanted, importer)) => none
  _ => configured-path(wanted, importer) ?? searched(request, wanted, importer)
} where spec = request.spec, wanted = aliased(spec)

# Where the search finds it. A relative alias is relative to where the build runs.
fn searched(request: Request, wanted: Text, importer: Text) -> Text? =
  first r in res.resolve-opt-kind(wanted, match wanted != request.spec and res.relative?(wanted) {
    true => "alias"
    false => importer
  }, request.kind): r.path

fn ahead?(path: Text) -> Bool = loader-of(path) != "file"

# Where an import would lead, or nothing if it leads nowhere or stays outside the bundle.
fn ahead-target(request: Request, importer: Text) -> Text? = match request.spec {
  _ if stays-external?(request.spec, importer) => none
  _ => hook-path(wanted, importer) ?? configured-path(wanted, importer) ?? searched(request, wanted, importer)
    where spec = request.spec, wanted = aliased(spec)
}

# Every file the entries can reach, parsed before the graph is made, into memos the graph then
# finds them in; how many. Without hooks, whoever parsed a file resolves what it imports: a walk.
# With them, a wave at a time: a wave's texts are asked of the hooks, its files parsed, and their
# imports are the next wave.
fn parsed-ahead(paths: [Text]) -> Int = match hooked?() {
  false => reach(roots, led-ahead)
  true => len(parsed-waves(roots, {p: true for p in roots}))
} where roots = [real-path(p) for p in paths if ahead?(p) distinct real-path(p)]

# With hooks, which only this thread may call: a wave's texts are asked for here, its files parsed
# at once, and the files their imports lead to that none has led to before are the next wave.
fn parsed-waves(wave: [Text], seen: {Text:Bool}) -> [Parsed] = match wave {
  [] => []
  _ => done ++ parsed-waves(next, {p: true for ps in [keys(seen), next] for p in ps})
    where texts = [hooked-text(p) for p in wave],
          done = match len(texts) { _ => [parsed-hooked(p) for p in wave] },
          next = [t for d in done for request in requests-of(d) if let some(t) = ahead-target(request, d.path) if ahead?(t) and not (t in seen) distinct t]
}

# ---------------------------------------------------------------- the graph

# A program's modules, as the settings above hold them.
# Its blocks are the modules' own tables, each at its place among the build's, which the shared
# one is joined from; it holds `symbols` symbols before linking makes more.
boxed record Graph { modules: [Module], by-path: {Text:Int}, order: [Int], ranks: {Int:Int}, entries: [Int], blocks: [sym.Block],
               module-blocks: {Int:sym.Block}, symbols: Int, scopes: Int, scope-shifts: [Int], symbol-shifts: [Int] }

# Where each module's symbols, scopes and statements are numbered in the build's one table and its
# facts: a block of each, kept from one build to the next while it is big enough, so a module that
# grows, or appears, renumbers nothing but itself (see `place!`). The symbols linking makes have
# places of their own among the symbols, by what they are for. A first build numbers everything in
# turn, as one table after another; numbers a later build no longer uses stay empty.
setting symbol-places: rt.Places = places-new()
setting scope-places: rt.Places = places-new()
setting part-places: rt.Places = places-new()
setting module-places: rt.Places = places-new()

# Each module's rank in the order the program runs in, by what it is: kept from one build to the
# next while it stays in order with the modules around it, so a module added, or moved, ranks again
# alone and the others keep theirs.
setting order-ranks: rt.Ranks = ranks-new()

# Each module's id, by what it is (a path, or an outside import): kept from one build to the next,
# the runtime's 0 and the rest from 1 on, in the order the walk first reaches them. An id no module
# has this build holds an empty one.
fn module-ids(keys: [Text]) -> [Int] = [place!(module-places, k, 1) + 1 for k in keys]

# Where the modules' own tables land, by path, `keys[i]` for `tables[i]`: each one's place, then
# where all of them end.
record Placement { scope-shifts: [Int], symbol-shifts: [Int], symbols: Int, scopes: Int }

fn placement(keys: [Text], sizes: [TableSize]) -> Placement =
  Placement(symbol-shifts: [place!(symbol-places, keys[i], sizes[i].symbols) for i in 0..len(keys)],
            scope-shifts: [place!(scope-places, keys[i], sizes[i].scopes - 1) for i in 0..len(keys)],
            symbols: places-end(symbol-places), scopes: places-end(scope-places))

# The symbols linking makes, by what each is for.
fn made-ids(keys: [Text]) -> [Int] = [place!(symbol-places, "made " ++ k, 1) for k in keys]

# Where each module's statements start among the facts' parts, by path.
fn part-starts(keys: [Text], sizes: [Int]) -> [Int] = [place!(part-places, keys[i], sizes[i]) for i in 0..len(keys)]

# Where an import leads: a file, or an import left for the runtime, named as a node of the graph;
# and whether what it leads to may have side effects.
record Lead { key: Text, effects: Bool }

# A file as loading finds it, before it joins the others: what it says, its tree before and after
# defines, its scopes in a table of its own, what it imports and loads at run time, and where each
# leads, in the order it names them.
boxed record Loaded { path: Text, parsed: Parsed, tree0: Node, analysis: Analysis, scopes: sym.Table, specs: [Text], calls: [Text],
                requests: [Request], leads: [Lead], whole: [Text] }

fn loaded(path: Text) -> Loaded = match plain?(path) {
  true => loaded-plain(path)
  false => loaded-here(path)
}

# Whether a file's place in the graph is worked out with nothing to ask a hook or a spec's
# transform, which only the thread that links may call: then whoever parses it works it out too
# (see `led-ahead`).
fn plain?(path: Text) -> Bool = ahead?(path) and not hooked?() and parsed-plain(path).analysed

fn loaded-plain(path: Text) -> Loaded =
  Loaded(path: path, parsed: p, tree0: p.tree, analysis: p.analysis, scopes: p.scopes, specs: specs, calls: p.calls,
         requests: requests, leads: [unhooked-lead(request, path) for request in requests],
         whole: [unhooked-lead(r, path).key for r in [require-request(s) for s in p.required]
                   ++ [import-request(x) for st in p.tree.body.kids for x in wholly-imported(st)]])
  where p = match parsed-plain(path) {
          q if q.analysed => q
          _ => panic "{} is not analysed where it is parsed: its place in the graph is worked out with the graph", path
        },
        specs = [spec for s in p.tree.body.kids if let some(spec) = import-spec-of(s)] ++ p.calls,
        requests = requests-in(p.tree, p.required, [s for s in p.calls[len(p.required)..len(p.calls)]])

fn loaded-here(path: Text) -> Loaded =
  Loaded(path: path, parsed: p, tree0: tree0, analysis: a.analysis, scopes: a.scopes, specs: specs, calls: calls,
         requests: requests, leads: [lead-request(request, path) for request in requests],
         whole: [lead-request(r, path).key for r in [require-request(s) for s in required]
                   ++ [import-request(x) for st in tree0.body.kids for x in wholly-imported(st)]])
  where p = parsed-for-graph(path),
        tree0 = match p.analysed {
          true => p.tree
          false => transformed(p.tree)
        },
        a = match p.analysed {
          true => Analysed(analysis: p.analysis, scopes: p.scopes)
          false => analysis-of(tree0, p.parsed, p.src, path, base-name(path), p.jsx-imports, p.helpers)
        },
        # Imports in source order, then what it loads at run time. Statements `define` removed import nothing.
        found = match p.analysed {
          true => Checked(tree: p.tree, requires: p.required, imports: [])
          false => loads-of(a.analysis.tree)
        },
        calls = match p.analysed {
          true => p.calls
          false => found.requires ++ found.imports
        },
        required = found.requires,
        specs = [spec for s in tree0.body.kids if let some(spec) = import-spec-of(s)] ++ calls,
        requests = requests-in(tree0, required, [s for s in calls[len(required)..len(calls)]])

# What loading made of a file, before the graph joins it to the others: what the walk ahead made of
# it; with load hooks, the wave's parse of the text a hook gave; for a file the walk does not
# reach, a parse here.
fn parsed-for-graph(path: Text) -> Parsed = match ahead?(path), hooked?() {
  true, false => parsed-plain(path)
  true, true => parsed-hooked(path)
  false, _ => parsed-alone(path)
}

fn hooked?() -> Bool = len(loading.on-load) + len(loading.on-resolve) > 0

# A file nothing parsed ahead, parsed and analysed on the thread that links, once for as long as
# its text stays the same.
fn parsed-alone(path: Text) -> Parsed =
  analysed-file(parsed-file(Pending(path: path, text: as-module(source-of(path), path), ready: true)))

# With load hooks, which only the thread that links may call: the text a hook gives a file, asked
# there, and its parse, which any thread may then make.
fn hooked-text(path: Text) -> Text = module-text(source-of(path), path)

fn parsed-hooked(path: Text) -> Parsed = parsed-file(Pending(path: path, text: hooked-text(path), ready: true))

fn transformed(tree: Node) -> Node = transform(tree) where transform = loading.transform

# What a statement imports as a whole, its default or namespace: what a script must be CommonJS for.
fn wholly-imported(s: Node) -> [Text] = match s {
  Import(clause, from) if whole-clause?(clause) => [module-of-str(from)]
  ExportAllAs(_, from) => [module-of-str(from)]
  ExportFrom(List(specs...), from) if any x in specs: (x is ExportName(...) or x is ExportAs(...)) and module-name(x.local) == "default" =>
    [module-of-str(from)]
  _ => []
}

fn whole-clause?(c: Node) -> Bool = match c {
  ImportDefault(_) | ImportNamespace(_) | ImportDefaultAnd(...) => true
  ImportNamed(List(specs...)) => any x in specs: x is ImportAs(...) and module-name(x.imported) == "default"
  _ => false
}

fn lead(spec: Text, importer: Text) -> Lead = lead-request(import-request(spec), importer)

fn lead-request(request: Request, importer: Text) -> Lead = match stays-external?(request.spec, importer) {
  true => Lead(key: "external:" ++ aliased(request.spec), effects: false)
  false => Lead(key: r.path, effects: r.side-effects) where r = resolved-now(request, importer)
}

# The same, of a build with no resolve hooks to ask.
fn unhooked-lead(request: Request, importer: Text) -> Lead = match unhooked-external?(request.spec, importer) {
  true => Lead(key: "external:" ++ aliased(request.spec), effects: false)
  false => Lead(key: r.path, effects: r.side-effects) where r = unhooked-resolved(request, importer)
}

# What a node of the graph leads to: an outside import, nothing.
fn led-to(key: Text) -> [Text] = match key {
  "external:" ++ _ => []
  path => [l.key for l in leads-of(path)]
}

fn external?(key: Text) -> Bool = key is "external:" ++ _

# The program's modules: the runtime, id 0, then every file and outside import the entries lead to,
# numbered in the order a walk from each entry in turn first reaches them; and that walk's order,
# each module after what it imports, as it runs in esbuild's output. Every module's symbols will join
# one table in the order of their ids, and each module knows how far its own move.
fn graph(runtime: Text, paths: [Text]) -> Graph =
  Graph(modules: updated([runtime-module(rt, lay)] ++ [blank-module(id, "", External, bundle-scope) for id in 1..top],
                         {numbers[i]: made[i] for i in 0..len(w.pre)}),
        by-path: ids, order: [0] ++ [numbers[i] for i in post], ranks: {order-ids[k]: ranked[k] for k in 0..len(order-ids)},
        entries: [ids[p] ?? (panic "{} was not loaded", p) for p in paths],
        blocks: blocks, module-blocks: {0: blocks[0]} ++ {ids[files[k]] ?? (panic "{} has no id", files[k]): blocks[k + 1] for k in 0..len(files)},
        symbols: lay.symbols,
        scopes: lay.scopes, scope-shifts: lay.scope-shifts, symbol-shifts: lay.symbol-shifts)
  where roots = [real-path(p) for p in paths],
        w = depth-first(roots, led-to),
        numbers = module-ids(w.pre),
        post = [i for i in w.post if not external?(w.pre[i])],
        order-ids = [0] ++ [numbers[i] for i in post],
        ranked = rank!(order-ranks, ["<runtime>"] ++ [w.pre[i] for i in post]),
        # Every node's id by its key, and every entry's by the path it was given as: one map, each
        # key put in once.
        root-ids = {w.pre[j]: numbers[j] for j in 0..len(w.pre) if w.parent[j] < 0},
        keys = w.pre ++ paths,
        key-ids = numbers ++ [root-ids[roots[i]] ?? -1 for i in 0..len(paths)],
        ids = {keys[i]: key-ids[i] for i in 0..len(keys)},
        top = (fold t = 1 for n in numbers: max(t, n + 1)),
        # Which of the walk's nodes are files, and which file each node is, counted from one.
        file-at = [i for i in 0..len(w.pre) if not external?(w.pre[i])],
        files = [w.pre[i] for i in file-at],
        part-at = updated([0 for key in w.pre], {file-at[k]: k + 1 for k in 0..len(file-at)}),
        # The files something requires, or imports the default or namespace of.
        wholes = {key: true for whole in [whole-of(path) for path in files] for key in whole},
        rt = runtime-parsed(runtime).analysis,
        lay = placement(["<runtime>"] ++ files, [size-of(rt.table)] ++ [table-size(path) for path in files]),
        # Each module, and each file's table at its place, is its own work.
        made = [module-at(w, i, numbers, lay, part-at, wholes) for i in 0..len(w.pre)],
        blocks = [runtime-block(runtime, lay.scope-shifts[0], lay.symbol-shifts[0])]
                 ++ [file-block(files[k], lay.scope-shifts[k + 1], lay.symbol-shifts[k + 1]) for k in 0..len(files)]

# A module's own table at its place among the build's, made once for as long as the table and the
# place stay the same: the blocks the build's one table is joined from (see `an.linked-table`), so an
# edit to a module places that module's table again and no other.
fn file-block(path: Text, scope-shift: Int, symbol-shift: Int) -> sym.Block =
  sym.placed(scopes-of(path), scope-shift, symbol-shift)

fn runtime-block(runtime: Text, scope-shift: Int, symbol-shift: Int) -> sym.Block =
  sym.placed(runtime-parsed(runtime).analysis.table, scope-shift, symbol-shift)

# The runtime parsed and analysed, once for as long as its text is the same.
boxed record RuntimeParsed { tree: Node, analysis: sym.Analysis }

fn runtime-parsed(text: Text) -> RuntimeParsed = RuntimeParsed(tree: t, analysis: sc.analysis(t, [])) where t = js.parse(text, "<runtime>")

# The runtime is an ordinary module that nothing makes live unless a part mentions one of its helpers.
fn runtime-module(rt: sym.Analysis, lay: Placement) -> Module =
  blank-module(0, "<runtime>", Runtime, rt.root + lay.scope-shifts[0]) with {
    symbol-shift: lay.symbol-shifts[0], side-effects: false, base: "runtime", free: rt.free
  }

# What the graph reads of a loaded file, each kept by itself: what it leads to, what it imports whole
# or requires, and its scopes. While one file is edited the others' are read from what was kept,
# not made again from all that loading them made.
fn leads-of(path: Text) -> [Lead] = loaded(path).leads
fn whole-of(path: Text) -> [Text] = loaded(path).whole
fn scopes-of(path: Text) -> sym.Table = loaded(path).scopes

# How many scopes and symbols a file's own table has: all that placing it needs, kept by itself so
# a build that finds the file unchanged reads two numbers and not the table.
record TableSize { scopes: Int, symbols: Int }

fn table-size(path: Text) -> TableSize = size-of(scopes-of(path))

fn size-of(t: sym.Table) -> TableSize = TableSize(scopes: sym.scope-count(t), symbols: sym.symbol-count(t))

# The module the walk reached `i`th: an outside import, or a file, with side effects as the import
# that first reached it says, or as an entry has them.
# `numbers`: each of the walk's nodes' ids; `part-at`: where each file's scopes are among the parts
# the table is made of, after the runtime's. What a module leads to is where the walk found each
# of its leads (`w.targets`), by number.
fn module-at(w: Walk, i: Int, numbers: [Int], lay: Placement, part-at: [Int], wholes: {Text:Bool}) -> Module = match w.pre[i] {
  "external:" ++ spec => blank-module(numbers[i], spec, External, bundle-scope)
  path => module-of(path, numbers[i], effects, lay.scope-shifts[part], lay.symbol-shifts[part], path in wholes,
                    [numbers[t] for t in w.targets[i]])
    where part = part-at[i],
          effects = match w.parent[i] {
            p if p < 0 => true
            p => leads-of(w.pre[p])[w.slot[i]].effects
          }
}

# A file's module, by everything it is made of: the same one while those stay the same.
fn module-of(path: Text, id: Int, effects: Bool, scope-shift: Int, symbol-shift: Int, whole: Bool, deps: [Int]) -> Module =
  file-module(id, loaded(path), effects, scope-shift, symbol-shift, deps, whole)

# `deps`: the id each of its leads leads to, in order.
fn file-module(id: Int, l: Loaded, effects: Bool, scope-shift: Int, symbol-shift: Int, deps: [Int], whole: Bool) -> Module =
  blank-module(id, l.path, kind, l.analysis.root + scope-shift) with {
    symbol-shift: symbol-shift, side-effects: effects,
    free: l.analysis.free,
    legal: l.parsed.legal, helpers: l.parsed.helpers, deps: deps,
    dep-ids: {l.requests[k].spec: deps[k] for k in 0..len(l.requests) if l.requests[k].kind == res.Import},
    require-ids: {l.requests[k].spec: deps[k] for k in 0..len(l.requests) if l.requests[k].kind == res.Require}, calls: len(l.calls) > 0,
    script: l.analysis.script and kind == Esm
  } where kind = match l.analysis.cjs, l.analysis.script and whole {
    true, _ => Cjs
    false, true if not l.analysis.wrapped =>
      panic "{}: a script that is required, while a define is about `module` or `exports`, is not implemented yet", l.path
    false, true => Cjs
    false, false => Esm
  }

# ---------------------------------------------------------------- paths as the output shows them

# A path from the root, as esbuild's resolver has it: links resolved where something is there.
fn full-path(path: Text) -> Text = res.canonical(from-root(path))

# A path from the root, as written: from the working directory when it is relative.
fn from-root(path: Text) -> Text = match path {
  "/" ++ _ => path-normalize(path)
  _ => path-normalize(working-dir() ++ "/" ++ path)
}

# `to` as a path from the directory `from`, both from the root.
fn relative-path(from: Text, to: Text) -> Text = match join([".." for i in common..len(a)] ++ b[common..len(b)], "/") {
  "" => "."
  p => p
} where a = path-segments(from),
        b = path-segments(to),
        common = len([i for i in 0..min(len(a), len(b)) while a[i] == b[i]])

# A module's path as the output shows it: from the working directory, as a relative path already is.
fn shown-path(path: Text) -> Text = match path {
  "/" ++ _ => relative-path(full-path("."), full-path(path))
  _ => path
}

fn public-url(local: Text) -> Text = match loading.public-path {
  "" => local
  _ ++ "/" => loading.public-path ++ local[2..len(local)]
  base => base ++ "/" ++ local[2..len(local)]
}

# Stylesheets the program imports, in the order its modules run.
fn css-imports() -> [Text] = [modules[id].path for id in order if loader-of(modules[id].path) == "css"]

# CSS belongs to an evaluation root's static import closure. Dynamic imports start a separate
# closure. The shared graph walk supplies cycle-safe postorder; no chunk policy decides cascade.
fn static-dependencies(id: Int) -> [Text] = [int-text(target)
  for statement in body-of(id).tree.body.kids for spec in import-spec-of(statement)
  for target in modules[id].dep-ids[spec] if modules[target].kind != External distinct int-text(target)]

fn static-style-children(key: Text) -> [Text] = static-dependencies(parse-int(key))

fn stylesheets(root: Int) -> [Text] = match styled?() {
  false => []
  true => [modules[parse-int(w.pre[i])].path for i in w.post if loader-of(modules[parse-int(w.pre[i])].path) == "css"]
    where w = depth-first([int-text(root)], static-style-children)
}

# Does the program have a stylesheet at all? Without one no root's closure is walked to find its own.
fn styled?() -> Bool = any mo in modules: loader-of(mo.path) == "css"
