# The module graph: load files, normalise what makes modules awkward, analyse scopes.
rules bundle.modules over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.link as link
use bundle.scoped as scope
use bundle.coarse as co
use bundle.resolve as res
use bundle.dce as dce
use bundle.early as early
use bundle.calls as calls
use bundle.comments as cm
use bundle.minhost as host
use bundle.jsx as jsx
use bundle.ts as ts
use bundle.cssbundle as cssb
use bundle.legal as legal
use bundle.tsconfig as tsc

# `External` is an import left for the runtime: it has no source and no statements.
enum ModuleKind { Esm, Cjs, Runtime, External }

record Module {
  id: Int,
  path: Text,
  kind: ModuleKind,
  tree: Node,
  root: Int,
  bindings: {Int:Int},
  side-effects: Bool,
  deps: [Int],
  dep-ids: {Text:Int},  # the module each specifier it imports or requires led to
  symbol-shift: Int,    # while loading: how far `bindings` must move to the shared table's numbering
  base: Text,
  require-sym: Int,
  source: [Node],
  free: [Text],
  text: Text,
  ns-sym: Int,
  init-sym: Int,
  wrapped: Bool,
  pure-at: {Int:Bool},
  pure-calls: {Int:Int},
  legal: [Text],
  helpers: [Text],      # runtime helpers lowered code names, which are no global names
  # Whether its tree may `require` or `import()` anything: false when loading found no such call.
  calls: Bool
}

record TextPair { key: Text, value: Text }

# `define process.env.NODE_ENV = "production"`: a dotted name and its replacement.
record Define { key: Text, value: Node }

state table: sym.Table = sym.table-new()
state bundle-scope: Int = sym.new-scope!(table, -1, true)
state modules: [Module] = []
state by-path: {Text:Int} = {}
state order: [Int] = []
state db: link.Db = link.new-db()
state names: rt.Names = names-new()
state entry: Int = -1
state entries: [Int] = []
state hook-answers: {Text:Text} = {}
# Files parsed ahead of the walk that links them, by path.
state parsed-ahead: {Text:Parsed} = {}

# How the build loads, set once before it does.
record Loading {
  defines: [Define],
  # A spec's transform runs before scopes are analysed; it is a function value, so while there is
  # one the analysis stays on the thread that links.
  transform: Fn(Node)->Node,
  has-transform: Bool,
  aliases: [TextPair],
  loaders: [TextPair],
  on-resolve: [Fn(Text,Text)->Text?],
  on-load: [Fn(Text)->Text?],
  jsx-options: jsx.Options,
  # Where the output goes, for the paths the file loader writes into modules.
  out-dir: Text,
  # How many threads parse ahead.
  load-threads: Int,
  packages-external: Bool,
  public-path: Text
}

state loading: Loading = Loading(defines: [], transform: keep-as-is, has-transform: false, aliases: [], loaders: [],
                                 on-resolve: [], on-load: [], jsx-options: jsx.options-new(), out-dir: ".",
                                 load-threads: 1, packages-external: false, public-path: "")

fn keep-as-is(n: Node) -> Node = n

fn name-id(s: Text) -> Int {
  let id = intern!(names, s)
  if s != "default" { assert db.not-default(id) }
  id
}

# `node_modules/lodash-es/_root.js` -> `root`, as esbuild names things.
fn base-name(path: Text) -> Text {
  let stem = path-stem(path)
  let raw = if stem == "index" and dir-of(path) != "." then base-name(dir-of(path)) else stem
  # What can start a name starts it; past that, what cannot be in one becomes `_`.
  let start = (first i in 0..len(raw): if name-start?(raw[i]) then some(i) else none) ?? len(raw)
  let out = text-of-bytes([if host.name-byte?(c) then c else '_' for c in raw[start..len(raw)]])
  if len(out) == 0 then "module" else out
}

fn name-start?(c: Int) -> Bool = host.name-byte?(c) and c != '_' and not digit-byte?(c)

# A ModuleName is a PropName, or a Str naming an export.
fn module-name(n: Node) -> Text = match n {
  Str(raw) => unquote(raw)
  _ => n.text
}

fn module-of-str(n: Node) -> Text = unquote(n.text)

fn at-source(n: Node, from: Node) -> Node = n with { lo: from.lo, hi: from.hi }

# ---------------------------------------------------------------- normalising

# `export default …` becomes declarations with a real name, so everything after this treats it
# like any other export. Synthetic names get offset -1.
fn default-binding(base: Text) -> Node = BindName(base ++ "_default") with { lo: -1, hi: -1 }

fn var-of(name: Node, init: Node) -> Node = VarDecl(List(Declarator(name, init) with { lo: name.lo, hi: init.hi }))

fn normalize-stmt(s: Node, base: Text) -> Node = match s {
  ExportDefault(e) => var-of(default-binding(base), e)
  ExportDefaultDecl(d) => {
    let name = d.name
    let bound = if name is None() then default-binding(base) else name
    match d {
      FuncExpr(_, ps, b) => at-source(FuncDecl(bound, ps, b), d)
      GenExpr(_, ps, b) => at-source(GenDecl(bound, ps, b), d)
      AsyncFuncExpr(_, ps, b) => at-source(AsyncFuncDecl(bound, ps, b), d)
      AsyncGenExpr(_, ps, b) => at-source(AsyncGenDecl(bound, ps, b), d)
      ClassExpr(_, h, b) => at-source(ClassDecl(bound, h, b), d)
      _ => panic "unexpected export default declaration: {}", js.kind-name(d.kind)
    }
  }
  _ => s
}

fn default-of(s: Node) -> Text? = match s {
  ExportDefault(_) => some("")
  ExportDefaultDecl(d) => some(if d.name is None() then "" else d.name.text)
  _ => none
}

# Offsets of the tokens that `/* @__PURE__ */` or `/* #__PURE__ */` comments precede. A match inside
# a string only records an offset no call starts at, unless one really does follow: esbuild makes
# the same call about annotations being advice.
fn pure-annotations(src: Text) -> {Int:Bool} {
  if not contains-text?(src, "__PURE__") { return {} }
  let parts = match cm.parse(src, "<comments>") {
    cm.Scan(List(ps...)) => ps
    _ => panic "a source scans to pieces"
  }
  {annotated-token(parts, i + 1, parts[i].hi): true
   for i in 0..len(parts) if parts[i] is cm.Comment(_) and ("@__PURE__" in parts[i].text or "#__PURE__" in parts[i].text)}
}

# Past space and further comments, to the token an annotation applies to.
fn annotated-token(parts: [cm.Node], from: Int, end: Int) -> Int =
  (first j in from..len(parts): token-start(parts[j])) ?? (if from < len(parts) then parts[len(parts) - 1].hi else end)

# Where a piece of the scan has the next token, if it has one. The pieces cover the source.
fn token-start(p: cm.Node) -> Int? = match p {
  cm.Comment(_) => none
  cm.Gap(t) => if span-of(t, 0, " \n\t\r") < len(t) then some(p.lo + span-of(t, 0, " \n\t\r")) else none
  _ => some(p.lo)
}

fn mentions-name?(n: Node, name: Text) -> Bool = match n {
  Ident(x) => x == name
  _ => any k in n.kids: mentions-name?(k, name)
}

# A class has a binding of its own name inside it, which is there before the `var` around it is
# assigned: `static x = new A()` needs that. A second, inner name is only worth it if something
# in the class says the name.
# Inside the class its name means the inner binding, which esbuild calls `_Name`. That is what
# `this.constructor.name` says, so it is part of what the program does.
everywhere fn renamed-inside(n: Node, from: Text, to: Text) -> Node = match n {
  Ident(x) => if x == from then Ident(to) with { lo: n.lo, hi: n.hi } else n
  Shorthand(Ident(x)) => if x == from then Prop(PropName(x), Ident(to)) with { lo: n.lo, hi: n.hi } else n
  _ if len(n.kids) > 0 and from in ts.shadowed-by(n) => n
}

fn declarator-of-class(c: Node) -> Node = match c {
  ClassDecl(name, h, b) => {
    let own = name.text
    let says = mentions-name?(h, own) or mentions-name?(b, own)
    let inner-name = "_" ++ own
    let inner = if says then BindName(inner-name) with { lo: c.lo, hi: c.lo } else None()
    let heritage = if says then renamed-inside(h, own, inner-name) else h
    let body = if says then renamed-inside(b, own, inner-name) else b
    let init = at-source(ClassExpr(inner, heritage, body), c)
    Declarator(name, init) with { lo: name.lo, hi: init.hi }
  }
  _ => panic "expected a class declaration"
}

fn split-decl(n: Node, exported: Bool) -> [Node] =
  [at-source(if exported then ExportVar(List(d)) else VarDecl(List(d)), d) for d in n.declarators.kids]

# One declarator per statement, so each can be tree-shaken on its own. A bundle's top level has no
# TDZ worth paying for, so `let`, `const` and classes become `var`.
fn normalized-tree(tree: Node, base: Text) -> Node =
  Program(tree.hashbang, List([normalized(normalize-stmt(s, base))... for s in tree.body.kids]...))

fn normalized(n: Node) -> [Node] = match n {
  VarDecl(_) | LetDecl(_) | ConstDecl(_) => split-decl(n, false)
  ExportVar(_) => split-decl(n, true)
  ExportLexical(inner) => if inner is LetDecl(_) | ConstDecl(_) then split-decl(inner, true) else [n]
  Empty() => []
  ClassDecl(...) => [at-source(VarDecl(List(declarator-of-class(n))), n)]
  ExportClass(c) => [at-source(ExportVar(List(declarator-of-class(c))), n)]
  _ => [n]
}

# ---------------------------------------------------------------- dependencies

# What a final tree loads at run time: its `require`s, then its `import()`s, in source order.
fn calls-in(tree: Node) -> [Text] {
  let found = calls.run(tree)
  found.requires ++ found.imports
}

fn loads-of(tree: Node) -> Checked {
  let found = calls.run(tree)
  Checked(tree: tree, requires: found.requires, imports: found.imports)
}

# ---------------------------------------------------------------- defines

# A Member chain rooted at a free identifier, as dotted text: `process.env.NODE_ENV`.
fn dotted-name(n: Node, b: {Int:Int}) -> Text? = match n {
  Ident(x) => if n.lo in b then none else some(x)
  Member(o, p) => match dotted-name(o, b) {
    some(base) => some(base ++ "." ++ p.text)
    none => none
  }
  _ => none
}

# Does this source mention the first name of any define? Most files do not, and they need no
# substitution or second analysis.
fn mentions-define?(src: Text) -> Bool = any d in loading.defines: contains-text?(src, text-before(d.key, "."))

# Whether `substitute` would replace anything here: a free name, or a chain from one, that a define
# names. A file can mention a define's name, in a comment or as a property, and use none.
fn defines-apply?(n: Node, b: {Int:Int}) -> Bool {
  if n is Ident(_) | Member(...) {
    if let some(key) = dotted-name(n, b) {
      if is-some(define-of(key)) { return true }
    }
  }
  any k in n.kids: defines-apply?(k, b)
}

fn define-of(key: Text) -> Node? = last d in loading.defines: if d.key == key then some(d.value) else none

# Replace defined names. This needs the scope analysis, because a local with the same name is not
# the define.
fn substitute(n: Node, b: {Int:Int}) -> Node {
  let replaced: Node? =
    if n is Ident(_) | Member(...) {
      match dotted-name(n, b) {
        some(key) => define-of(key)
        none => none
      }
    } else { none }
  match replaced {
    some(v) => v
    none => if len(n.kids) == 0 then n else n with { kids: [substitute(k, b) for k in n.kids] }
  }
}

# ---------------------------------------------------------------- loading

# A parsed and checked file, and the `require`s and `import()`s the check's traversal found.
record Checked { tree: Node, requires: [Text], imports: [Text] }

# Parse and check a file. A file with import or export syntax is a module; anything else may be
# CommonJS, whose top level is a function body.
fn parse-file(src: Text, path: Text) -> Checked {
  let loader = loader-of(path)
  let syntax = (if loader == "jsx" or loader == "tsx" then js.flag-bit("jsx") else 0)
             + (if loader == "ts" or loader == "tsx" then js.flag-bit("ts") else 0)
  let tree = js.parse-tries(src, path, syntax, js.flag-bit("await"))
  let is-module = early.program-has-module-syntax?(tree)
  let found = early.run(tree, is-module, not is-module, loader == "ts" or loader == "tsx", false, false, [])
  match found.problem {
    none => Checked(tree: tree, requires: found.requires, imports: found.imports)
    some(p) => panic "{}:{}:{}: {}", path, line-of(src, p.at), col-of(src, p.at), p.message
  }
}

# Lowering JSX or TypeScript makes another tree of a file's.
fn lowered-loader?(loader: Text) -> Bool = loader == "jsx" or loader == "tsx" or loader == "ts"

# A project's JSX settings, unless the build gave its own.
fn configured-jsx(o: jsx.Options, c: tsc.Config) -> jsx.Options {
  if o.explicit { return o }
  let runtime = match c.jsx {
    "react" => jsx.Classic
    "react-jsx" | "react-jsxdev" => jsx.Automatic
    "preserve" | "react-native" => jsx.Preserve
    _ => o.runtime
  }
  o with { runtime: runtime, dev: o.dev or c.jsx == "react-jsxdev", factory: or-else(c.jsx-factory, o.factory),
           fragment: or-else(c.jsx-fragment, o.fragment), import-source: or-else(c.jsx-import-source, o.import-source) }
}

fn or-else(given: Text, otherwise: Text) -> Text = if len(given) > 0 then given else otherwise

# Is this file in node compatibility mode: `.mjs`, or under "type": "module"?
fn node-mode?(path: Text) -> Bool = ends-with(path, ".mjs") or res.package-type-module?(path)

fn blank-module(id: Int, path: Text, kind: ModuleKind, tree: Node, root: Int) -> Module =
  Module(id: id, path: path, kind: kind, tree: tree, root: root, bindings: {}, side-effects: true,
         deps: [], dep-ids: {}, symbol-shift: 0, base: base-name(path), require-sym: -1, source: [], free: [], text: "",
         ns-sym: -1, init-sym: -1, wrapped: false, pure-at: {}, pure-calls: {}, legal: [], helpers: [], calls: true)

# The stand-in module for an external import, one per specifier.
fn external-module(spec: Text) -> Int {
  let key = "external:" ++ spec
  if let some(id) = by-path[key] { return id }
  let id = len(modules)
  modules += blank-module(id, spec, External, None(), bundle-scope)
  by-path[key] = id
  id
}

# An alias replaces a package name, and carries any subpath along.
fn aliased(spec: Text) -> Text {
  for a in loading.aliases {
    if spec == a.key { return a.value }
    if starts-with(spec, a.key ++ "/") { return a.value ++ spec[len(a.key)..len(spec)] }
  }
  spec
}

# What a resolve hook says about this import. Asked once per place it could appear from.
fn hook-path(spec: Text, importer: Text) -> Text? {
  if len(loading.on-resolve) == 0 { return none }
  let key = dir-of(importer) ++ "\n" ++ spec
  if let some(p) = hook-answers[key] { return if len(p) == 0 then none else some(p) }
  let answer = first hook in loading.on-resolve: hook(spec, importer)
  hook-answers[key] = answer ?? ""
  answer
}

# Is this import left for the runtime? A hook's answer overrides that, as an alias does, and with
# `--packages=external` so is every package.
fn stays-external?(spec: Text, importer: Text) -> Bool =
  is-none(hook-path(aliased(spec), importer))
  and (res.external?(aliased(spec)) or (loading.packages-external and package-spec?(aliased(spec), importer)))

fn package-spec?(spec: Text, importer: Text) -> Bool =
  not (res.relative?(spec) or starts-with(spec, "/") or starts-with(spec, "#")) and is-none(configured-path(spec, importer))

# A project's `paths` and `baseUrl` come before node_modules, for a bare specifier.
fn configured-path(spec: Text, importer: Text) -> Text? {
  if res.relative?(spec) or starts-with(spec, "/") { return none }
  let c = tsc.for-file(importer)
  for candidate in tsc.path-candidates(c, spec) {
    if let some(p) = res.try-path(candidate) { return some(p) }
  }
  if len(c.base-url) > 0 { return res.try-path(c.base-url ++ "/" ++ spec) }
  none
}

# Where an import leads: resolve hooks first, then the project's paths, then the search. A worker
# that parsed the importer ahead may have found the answer already.
fn resolve-import(spec: Text, importer: Text) -> res.Resolved {
  if let some(ahead) = parsed-ahead[importer] {
    if let some(t) = ahead.targets[spec] { return res.Resolved(path: t, side-effects: res.side-effects-of(t)) }
  }
  let wanted = aliased(spec)
  match hook-path(wanted, importer) {
    some(p) => res.Resolved(path: p, side-effects: true)
    none if is-some(configured-path(wanted, importer)) => {
      let p = configured-path(wanted, importer) ?? panic "lost a configured path"
      res.Resolved(path: p, side-effects: res.side-effects-of(p))
    }
    # A relative alias is relative to where the build runs, not to the importing file.
    none => res.resolve(wanted, if wanted != spec and res.relative?(wanted) then "alias" else importer)
  }
}

fn dep-add(m: Int, spec: Text, path: Text) -> Int {
  let d = if stays-external?(spec, path) then external-module(aliased(spec)) else {
    let r = resolve-import(spec, path)
    load-file(r.path, r.side-effects)
  }
  modules[m].deps += d
  d
}

fn loader-of(path: Text) -> Text {
  for l in loading.loaders {
    if ends-with(path, l.key) { return l.value }
  }
  default-loader(path)
}

fn default-loader(path: Text) -> Text =
  if ends-with(path, ".json") then "json"
  else if ends-with(path, ".jsx") then "jsx"
  else if ends-with(path, ".tsx") then "tsx"
  else if ends-with(path, ".css") then "css"
  else if ends-with(path, ".ts") or ends-with(path, ".mts") or ends-with(path, ".cts") then "ts"
  else "js"


# A file's text as a module, by what its loader says it is.
fn as-module(text: Text, path: Text) -> Text =
  if loader-of(path) == "file" then "export default " ++ host.js-string(public-url(cssb.file-url(path))) ++ ";"
  else module-text(text, path)

# A load hook may supply a file's text, or the file does.
fn source-of(path: Text) -> Text = (first hook in loading.on-load: hook(path)) ?? read-file(path)

# The specifier a statement imports from, or nothing.
fn import-spec-of(s: Node) -> Text? = match s {
  Import(_, from) | ExportAllAs(_, from) | ExportFrom(_, from) => some(module-of-str(from))
  ImportBare(from) | ExportAll(from) => some(module-of-str(from))
  _ => none
}

# Load a file and, first, everything it imports: `order` is post-order, so a module's dependencies
# come before it, as they do in esbuild's output.
# ---------------------------------------------------------------- the per-file stage

# A file to parse: its text when that has been read already, which a load hook or the file loader
# does on the thread that owns them.
record Pending { path: Text, text: Text, ready: Bool }

# Everything one file says by itself, before anything links it to another.
record Parsed {
  path: Text,
  src: Text,
  parsed: Node,
  tree: Node,
  pure-calls: {Int:Int},
  helpers: [Text],
  jsx-imports: Bool,
  pure-at: {Int:Bool},
  legal: [Text],
  specs: [Text],
  targets: {Text:Text}, # where each specifier led, when it was resolved ahead
  analysed: Bool,       # whether `scopes` and `analysis` hold its scope analysis already
  scopes: sym.Table,
  analysis: Analysis,
  calls: [Text],        # with the analysis: what its final tree `require`s, then `import()`s
  requires: [Text],     # what the tree as parsed `require`s, and `import()`s, when `found`
  imports: [Text],
  found: Bool,
  role: Role,           # in the walk: a whole file, a big file's pieces to come, a piece, or the
  pieces: Int           # resolution of one of its imports
}

enum Role { Whole, Split, Piece, Resolved, Prepare }

# A file's scope analysis: its tree once defines are applied, its root scope, which symbol each name
# leaf is, the names it leaves free, and whether it is CommonJS.
# `shift`: how far the symbols `bindings` names moved when the file's own table joined the shared
# one, which the bindings themselves catch up with once loading is done.
# `defined`: whether a define changed the tree.
record Analysis { tree: Node, root: Int, bindings: {Int:Int}, free: [Text], cjs: Bool, shift: Int, defined: Bool }

fn no-analysis() -> Analysis = Analysis(tree: None(), root: -1, bindings: {}, free: [], cjs: false, shift: 0, defined: false)

# A file's scopes, and the table they are in.
record Analysed { analysis: Analysis, scopes: sym.Table }

# What a file declares and uses, in a table of its own. Defines are substituted and the branches
# they decide removed, then the result is analysed again, so what they kill is never seen by tree
# shaking; CommonJS is analysed inside its (exports, module) wrapper. A script that names those is
# analysed inside the wrapper at once, and again without it only if it is not CommonJS after all
# (or a define is about `module` or `exports`, which the wrapper would hide). A name free in any of
# the analyses is free.
fn analysis-of(tree0: Node, parsed: Node, src: Text, path: Text, base: Text, jsx-imports: Bool, helpers: [Text]) -> Analysed {
  let esm = early.program-has-module-syntax?(tree0)
  let tree = normalized-tree(tree0, base)
  let maybe-cjs = not esm and (any name in cjs-names: contains-text?(src, name))
                  and not (any d in loading.defines: text-before(d.key, ".") in ["module", "exports"])
  let wrapped: scope.Scoped? = if maybe-cjs then some(scope.scoped(tree, ["exports", "module"])) else none
  let wrapped-cjs = match wrapped {
    some(w) => "require" in w.free or wrapper-used?(w.table, wrapper-of(w), "module") or wrapper-used?(w.table, wrapper-of(w), "exports")
    none => false
  }
  let first = if wrapped-cjs then wrapped ?? panic "lost the wrapped analysis" else scope.scoped(tree, [])
  let cjs = wrapped-cjs or (not esm and (any f in cjs-names: f in first.free))
  # Whether it names `module` or `exports` without declaring them.
  let names-module = if wrapped-cjs then wrapper-used?(first.table, wrapper-of(first), "module") or wrapper-used?(first.table, wrapper-of(first), "exports")
                     else "module" in first.free or "exports" in first.free
  if jsx-imports and not early.program-has-module-syntax?(parsed) and names-module {
    panic "{}: the automatic JSX runtime in a CommonJS module is not implemented yet", path
  }
  let defined = mentions-define?(src) and defines-apply?(tree, first.bindings)
  let final-tree = if defined then dce.run(substitute(tree, first.bindings)) else tree
  let final = if defined or (cjs and not wrapped-cjs) then scope.scoped(final-tree, if cjs then ["exports", "module"] else []) else first
  let free = first.free ++ [f for f in final.free if not (f in first.free)]
  let real-free = [f for f in free if not ((cjs and (f == "exports" or f == "module")) or f in helpers)]
  Analysed(analysis: Analysis(tree: final-tree, root: final.root, bindings: final.bindings, free: real-free, cjs: cjs,
                              shift: 0, defined: defined),
           scopes: final.table)
}

const cjs-names: [Text] = ["module", "exports", "require"]

# The wrapper scope of an analysis made inside CommonJS's wrapper: the root's parent.
fn wrapper-of(s: scope.Scoped) -> Int = sym.scope-at(s.table, s.root).parent

# A file analysed on its own, moved into the shared table: its ids move by where it lands.
fn grafted(p: Parsed) -> Analysis = grafted-analysis(Analysed(analysis: p.analysis, scopes: p.scopes))

fn grafted-analysis(a: Analysed) -> Analysis {
  let symbol-shift = sym.symbol-count(table)
  let scope-shift = sym.graft!(table, a.scopes, bundle-scope)
  a.analysis with { root: a.analysis.root + scope-shift, shift: symbol-shift }
}

# A module's bindings in the shared table's numbering. Every module is moved at once, when all
# are loaded.
fn rebased-bindings(id: Int) -> {Int:Int} {
  let mo = modules[id]
  if mo.symbol-shift == 0 { return mo.bindings }
  {k: s + mo.symbol-shift for k in keys(mo.bindings) if let some(s) = mo.bindings[k]}
}

fn rebase-all!() -> Void {
  let moved = parallel-map(order, rebased-bindings, loading.load-threads)
  for i in 0..len(order) {
    let id = order[i]
    modules[id].bindings = moved[i]
    modules[id].symbol-shift = 0
  }
}

# The text a module of this loader stands for. Not the file loader's: that writes an asset, so it
# is made by `as-module`, on the thread that links.
fn module-text(text: Text, path: Text) -> Text = match loader-of(path) {
  "js" | "jsx" | "ts" | "tsx" => text
  "json" => "module.exports = " ++ text
  "text" => "export default " ++ host.js-string(text) ++ ";"
  "base64" => "export default \"" ++ host.base64(text) ++ "\";"
  "dataurl" => "export default \"" ++ host.data-url-of(text, host.mime-of(path)) ++ "\";"
  "empty" | "css" => ""
  "file" => panic "{}: the file loader's text is made by the linking stage", path
  other => panic "{}: no loader named {}", path, other
}

# What one file's own text says: parsed, checked, its JSX and TypeScript lowered, its comments read,
# and every specifier it might import. Touches only task state, so any number can run at once.
fn parsed-file(item: Pending) -> Parsed {
  let path = item.path
  let src = if item.ready then item.text else module-text(read-file(path), path)
  let checked = parse-file(src, path)
  parsed-with(path, src, checked.tree, none, some(checked))
}

# Everything after parsing, for a file parsed whole or put together from its pieces: with the
# specifiers its imports name when they are known already, and what checking it found.
fn parsed-with(path: Text, src: Text, parsed: Node, known: [Text]?, checked: Checked?) -> Parsed {
  let loader = loader-of(path)
  let config = tsc.for-file(path)
  let file-jsx = configured-jsx(loading.jsx-options, config)
  let lowered = if loader == "jsx" or loader == "tsx" then jsx.lower(parsed, src, path, file-jsx)
                else jsx.Lowered(tree: parsed, pure-calls: {}, imports: false)
  let typed = if loader == "ts" or loader == "tsx"
              then ts.lower(lowered.tree, src, jsx.kept-names(src, path, file-jsx), tsc.define-fields?(config), config.verbatim, config.decorators)
              else ts.Lowered(tree: lowered.tree, pure-calls: {}, helpers: [])
  let pure-calls = {k: v for m in [lowered.pure-calls, typed.pure-calls] for k in keys(m) if let some(v) = m[k]}
  # Every `require` and `import()`, even in code a define will remove: looking ahead may read a
  # file the build never uses, but never misses one it does. The check found them already, in the
  # tree a plain JavaScript file keeps. A file put together from pieces knows its specifiers.
  let found = if is-some(known) then Checked(tree: typed.tree, requires: [], imports: []) else match checked {
    some(c) if not lowered-loader?(loader) => c
    _ => loads-of(typed.tree)
  }
  let specs = known ?? (imported-specs(typed.tree) ++ found.requires ++ found.imports)
  Parsed(path: path, src: src, parsed: parsed, tree: typed.tree, pure-calls: pure-calls,
         helpers: typed.helpers, jsx-imports: lowered.imports, pure-at: pure-annotations(src),
         legal: legal.of-file(src, parsed), specs: specs, targets: {}, requires: found.requires, imports: found.imports,
         found: is-none(known),
         analysed: false, scopes: sym.table-new(), analysis: no-analysis(), calls: [], role: Whole, pieces: 1)
}

# The same, with scopes analysed too, in a table of the file's own. Not while a spec's transform
# has to see the tree first.
fn analysed-file(p: Parsed) -> Parsed {
  if loading.has-transform { return p }
  let a = analysis-of(p.tree, p.parsed, p.src, p.path, base-name(p.path), p.jsx-imports, p.helpers)
  # The calls are the parsed tree's unless a define changed it, and those were found already.
  let calls = if p.found and not a.analysis.defined then p.requires ++ p.imports else calls-in(a.analysis.tree)
  # Once defines have removed code, what it loads is what is left: `require`s a define removed, as
  # of a development build, are not read ahead.
  let specs = if a.analysis.defined then imported-specs(p.tree) ++ calls else p.specs
  p with { analysed: true, scopes: a.scopes, analysis: a.analysis, calls: calls, specs: specs }
}

fn imported-specs(tree: Node) -> [Text] = [spec for s in tree.body.kids if let some(spec) = import-spec-of(s)]

# A file found by walking: parsed, and its imports resolved, all on one worker.
# What the walk does with one item: a file, one piece of a big file, or a big file put together.
fn visit-file(item: Text) -> Parsed {
  if contains-text?(item, "\n") {
    let path = text-before(item, "\n")
    let what = text-after(item, "\n")
    # The rest of a big file's work, at once; the last of it to finish puts the file together.
    if what == "early" or what == "from" or starts-with(what, "w") {
      if what == "early" { early-of(path) }
      if what == "from" { from-of(path) }
      if starts-with(what, "w") { walked-of(item) }
      if arrive!(path ++ "\nrest", len(prepared-of(path).parts) + 2) { return finished-file(path) }
      return blank-parsed(item) with { role: Piece }
    }
    if starts-with(what, "?") {
      let spec = what[1..len(what)]
      return blank-parsed(path) with { role: Resolved, targets: {spec: t for some(t) in [unhooked-target(spec, path)]} }
    }
    # A piece. The last of a file's pieces to be parsed prepares the file.
    let pc = piece-of(item)
    if arrive!(path ++ "\npieces", len(split-source(path).starts)) {
      let pr = prepared-of(path)
      if not pr.whole { return finished-file(path) with { targets: pc.targets } }
      return blank-parsed(path) with { role: Prepare, pieces: len(pr.parts), targets: pc.targets }
    }
    return blank-parsed(item) with { role: Piece, targets: pc.targets }
  }
  let sp = split-source(item)
  if len(sp.starts) > 1 { return blank-parsed(item) with { role: Split, pieces: len(sp.starts) } }
  let p = analysed-file(parsed-file(Pending(path: item, text: sp.src, ready: true)))
  # Many imports are resolved as items of their own, at once.
  if len(p.specs) > resolve-alone { return p }
  targets-of(p)
}

const resolve-alone: Int = 16

fn targets-of(p: Parsed) -> Parsed =
  p with { targets: {spec: t for spec in p.specs if let some(t) = unhooked-target(spec, p.path)} }

# The files what a result imports lead to, visited after what waits already.
fn next-files(p: Parsed) -> [Text] = match p.role {
  Split => []
  _ => [t for t in values-of(p.targets) if ahead?(t)]
}

# What carries on with an item's own work, ahead of everything waiting: a big file's pieces, each
# taken by whoever comes first, and then the whole, which waits for any still being parsed; or
# the resolution of each of a file's many imports.
fn first-files(p: Parsed) -> [Text] = match p.role {
  Split => [p.path ++ "\n" ++ int-text(k) for k in 0..p.pieces]
  # Then its parts' walks, its early errors and the rest, at once.
  Prepare => [p.path ++ "\nw" ++ int-text(k) for k in 0..p.pieces] ++ [p.path ++ "\nearly", p.path ++ "\nfrom"]
  Whole => if len(p.specs) > resolve-alone and len(keys(p.targets)) == 0
           then [p.path ++ "\n?" ++ s for s in p.specs] else []
  _ => []
}

fn blank-parsed(path: Text) -> Parsed =
  Parsed(path: path, src: "", parsed: None(), tree: None(), pure-calls: {}, helpers: [], jsx-imports: false,
         pure-at: {}, legal: [], specs: [], targets: {}, analysed: false, scopes: sym.table-new(),
         analysis: no-analysis(), calls: [], requires: [], imports: [], found: false, role: Whole, pieces: 1)

# ---------------------------------------------------------------- big files, in pieces

# A big file of plain JavaScript is parsed in pieces, on several threads. A piece starts on a line
# that begins a declaration, outside every bracket, string, template, comment and regular
# expression, as the coarse grammar (coarse.syntax) reads them. It can be wrong only one way that
# matters: a piece before a wrong start is no program by itself, and then the file is parsed whole.
const piece-bytes: Int = 8192

# A file's text and where its pieces start. A library inside one function is cut inside that
# function's body, from `open`, its `{`, up to `close`, its `}`; -1 when the file is cut at its
# own top level.
record Parts { src: Text, starts: [Int], open: Int, close: Int }

# At 0 alone unless it is big plain JavaScript.
memo fn split-source(path: Text) -> Parts {
  let src = module-text(read-file(path), path)
  if loading.has-transform or loader-of(path) != "js" or len(src) < 2 * piece-bytes { return Parts(src: src, starts: [0], open: -1, close: -1) }
  parts-of-source(src)
}

fn parts-of-source(src: Text) -> Parts {
  let whole = Parts(src: src, starts: [0], open: -1, close: -1)
  # A file with no declaration at the start of a line has nowhere to cut at its top level.
  let cuts = if is-some(index-of-any(src, ["\n" ++ k for k in declaration-words])) then piece-starts(src) else []
  if len(cuts) > 0 { return whole with { starts: [0] ++ cuts } }
  let starts = line-starts(src)
  let lines = Lines(starts: starts, indents: line-indents(src, starts))
  match body-span(src, lines) {
    some(b) => {
      let inner = body-cuts(src, lines, b)
      if len(inner) == 0 then whole else Parts(src: src, starts: [b.open + 1] ++ inner, open: b.open, close: b.close)
    }
    none => whole
  }
}

record Span { open: Int, close: Int }

# A library inside one function is cut by how its code is laid out, which is how it was written:
# the function's body is the lines inside it, the body's statements start at its indentation, and
# a block in it runs from a line there that ends with `{` to the next there that starts with `}`.
# A wrong guess is no function body, or a piece that is no program, and the file is parsed whole.

# Where each line starts, and how far it is indented (-1 when it is blank).
record Lines { starts: [Int], indents: [Int] }

# The body of a function that is nearly all of the file: from the first line to end with `{` to
# the last line to start with `}`. Then, as long as one block in it holds most of it, as a
# library's own function inside the wrapper does, that block's.
fn body-span(src: Text, lines: Lines) -> Span? = match index-of(src, "{\n") {
  some(open) => match last-index-of(src, "\n}") {
    some(nl) => if nl > open and (nl + 1 - open) * 10 >= len(src) * 9 then some(innermost(src, lines, Span(open: open, close: nl + 1))) else none
    none => none
  }
  none => none
}

fn innermost(src: Text, lines: Lines, s: Span) -> Span = match dominant-block(src, lines, s) {
  some(inner) => innermost(src, lines, inner)
  none => s
}

# The lines of a body at its own indentation, and that indentation.
record Level { depth: Int, starts: [Int] }

fn level-of(lines: Lines, s: Span) -> Level {
  let from = bisect(lines.starts, s.open)
  let to = bisect(lines.starts, s.close - 1)
  let depth = (first i in from..to: if lines.indents[i] >= 0 then some(lines.indents[i]) else none) ?? 0
  Level(depth: depth, starts: [lines.starts[i] for i in from..to if lines.indents[i] == depth])
}

# The biggest block at a body's own indentation, when it is at least half the body.
fn dominant-block(src: Text, lines: Lines, s: Span) -> Span? {
  let level = level-of(lines, s)
  if level.depth <= 0 { return none }
  let ls = level.starts
  let blocks = [Span(open: end - 1, close: c + level.depth)
                for i in 0..len(ls) if let some(end) = line-end(lines, ls[i]) if at?(src, end - 1, "{")
                if let some(c) = (first j in i + 1..len(ls): if at?(src, ls[j] + level.depth, "}") then some(ls[j]) else none)]
  let biggest = fold best = -1 for b in blocks: max(best, b.close - b.open)
  if biggest * 2 < s.close - s.open { return none }
  first b in blocks: if b.close - b.open == biggest then some(b) else none
}

# Where the line starting at `at` ends: its line break.
fn line-end(lines: Lines, at: Int) -> Int? {
  let next = bisect(lines.starts, at)
  if next < len(lines.starts) then some(lines.starts[next] - 1) else none
}

const declaration-words: [Text] = ["function ", "function*", "async function", "class ", "var ", "let ", "const "]

# The body's statements that start a declaration, as cuts a piece's size apart.
fn body-cuts(src: Text, lines: Lines, b: Span) -> [Int] {
  let level = level-of(lines, b)
  if level.depth <= 0 { return [] }
  fold cuts = [] for l in level.starts if (any k in declaration-words: at?(src, l + level.depth, k)) if b.close - (l + level.depth) >= piece-bytes:
    if l + level.depth - (if len(cuts) == 0 then b.open + 1 else last(cuts)) >= piece-bytes then cuts ++ [l + level.depth] else cuts
}

# Where piece `k` ends.
fn piece-end(sp: Parts, k: Int) -> Int =
  if k + 1 < len(sp.starts) then sp.starts[k + 1] else if sp.open >= 0 then sp.close else len(sp.src)

# A function's body put together from its pieces: the file parsed with only the body's line breaks
# left of it, what follows moved back where it was, and the pieces' statements in the body. Nothing
# when that is not exactly one empty function body, or a piece has import or export syntax, which
# a function body cannot.
fn assembled(sp: Parts, path: Text, pieces: [Node]) -> Node? {
  if any t in pieces: early.program-has-module-syntax?(t) { return none }
  let stmts = [s for t in pieces for s in t.body.kids]
  let breaks = count-byte(sp.src, sp.open + 1, sp.close, '\n')
  let tail = sp.open + 1 + breaks
  let outer-src = sp.src[0..sp.open + 1] ++ repeated("\n", breaks) ++ sp.src[sp.close..len(sp.src)]
  match js.parse-opt(outer-src, path, 0) {
    some(parsed) => {
      let outer = moved(parsed, tail, sp.close - tail)
      if body-count(outer, sp.open, sp.close + 1) == 1 then some(filled-body(outer, sp.open, sp.close + 1, stmts, pieces)) else none
    }
    none => none
  }
}

# Everything from `from` on moved `by`.
fn moved(n: Node, from: Int, by: Int) -> Node =
  if n.hi < from then n
  else n with { lo: if n.lo >= from then n.lo + by else n.lo, hi: n.hi + by, kids: [moved(k, from, by) for k in n.kids] }

# How many empty function bodies span exactly `lo` to `hi`.
fn body-count(n: Node, lo: Int, hi: Int) -> Int =
  if n is FuncBody(List()) and n.lo == lo and n.hi == hi then 1
  else sum k in n.kids: if k.lo <= lo and hi <= k.hi then body-count(k, lo, hi) else 0

fn filled-body(n: Node, lo: Int, hi: Int, stmts: [Node], pieces: [Node]) -> Node =
  if n is FuncBody(List()) and n.lo == lo and n.hi == hi
  then n with { stmts: n.stmts with { kids: stmts, lo: pieces[0].body.lo, hi: last(pieces).body.hi } }
  else if n.lo <= lo and hi <= n.hi and len(n.kids) > 0 then n with { kids: [filled-body(k, lo, hi, stmts, pieces) for k in n.kids] }
  else n

record PieceTree { tree: Node?, specs: [Text], targets: {Text:Text} }

# One piece: its statements, parsed as a program of their own, and where what they import leads.
memo fn piece-of(item: Text) -> PieceTree {
  let path = text-before(item, "\n")
  let k = parse-int(text-after(item, "\n"))
  let sp = split-source(path)
  match js.parse-piece(sp.src[0..piece-end(sp, k)], path, 0, sp.starts[k]) {
    none => PieceTree(tree: none, specs: [], targets: {})
    some(tree) => {
      let imported = [spec for s in tree.body.kids if let some(spec) = import-spec-of(s)]
      let found = calls.run(tree)
      let specs = imported ++ found.requires ++ found.imports
      PieceTree(tree: some(tree), specs: specs, targets: {spec: t for spec in specs if let some(t) = unhooked-target(spec, path)})
    }
  }
}

# A big file put together from its pieces, ready for its parts to be analysed at once: the program as
# parsed, the program as analysed (its top level normalised one piece at a time), and a table that
# holds the program's own names. Not `whole` when a piece is no program by itself.
# `raw`: each piece's statements as parsed, which early errors are checked on.
# `wrapper`: the scope of CommonJS's (exports, module) wrapper the program was declared under, when
# a script names them and so is probably CommonJS; -1 when it was not.
record Prepared { whole: Bool, tree0: Node, tree: Node, parts: [[Node]], raw: [[Node]], scopes: sym.Table, root: Int,
                  esm: Bool, mentions: Bool, exportable: [Text], wrapper: Int }

memo fn prepared-of(path: Text) -> Prepared {
  let sp = split-source(path)
  let pieces = [piece-of(path ++ "\n" ++ int-text(k)).tree for k in 0..len(sp.starts)]
  # A function's body is put together and analysed whole.
  if sp.open >= 0 or (any t in pieces: is-none(t)) {
    return Prepared(whole: false, tree0: None(), tree: None(), parts: [], raw: [], scopes: sym.table-new(), root: -1,
                    esm: false, mentions: false, exportable: [], wrapper: -1)
  }
  let trees = [t for some(t) in pieces]
  let stmts = [s for t in trees for s in t.body.kids]
  let first = trees[0]
  let final = trees[len(trees) - 1]
  let tree0 = first with { body: first.body with { kids: stmts, hi: final.body.hi }, hi: final.hi }
  let base = base-name(path)
  let raw = [t.body.kids for t in trees]
  let parts = [normalized-tree(t, base).body.kids for t in trees]
  let tree = Program(tree0.hashbang, List([s for part in parts for s in part]...))
  let esm = early.program-has-module-syntax?(tree0)
  let wrapped = not esm and (any name in ["module", "exports", "require"]: contains-text?(sp.src, name))
  let own = scope.declared(tree, if wrapped then ["exports", "module"] else [])
  Prepared(whole: true, tree0: tree0, tree: tree, parts: parts, raw: raw, scopes: own.table, root: own.root,
           esm: esm, mentions: mentions-define?(sp.src), exportable: early.exportable-of(tree0),
           wrapper: if wrapped then sym.scope-at(own.table, own.root).parent else -1)
}

# One part's walk, in a table of its own under the program's scope.
# `defined`: whether a define applies in the part, which only its own bindings can tell. Its
# `require`s and `import()`s too, which the whole file's are made of.
record Walked { scopes: sym.Table, bindings: {Int:Int}, defined: Bool, requires: [Text], imports: [Text],
                problem: early.Problem? }

memo fn walked-of(item: Text) -> Walked {
  let path = text-before(item, "\n")
  let what = text-after(item, "\n")
  let k = parse-int(what[1..len(what)])
  let pr = prepared-of(path)
  let own = scope.walked-under(pr.scopes, pr.root, (if k == 0 then [pr.tree.hashbang] else []) ++ pr.parts[k])
  let defined = pr.mentions and (any s in pr.parts[k]: defines-apply?(s, own.bindings))
  # Checking the part finds what it loads, in its statements as parsed: normalising them keeps
  # every call, in order.
  let found = early.part-found(pr.tree0, pr.esm, not pr.esm, false, pr.exportable, pr.raw[k])
  Walked(scopes: own.table, bindings: own.bindings, defined: defined, requires: found.requires, imports: found.imports,
         problem: found.problem)
}

# What parsing a file whole checks of its statements together, at once with the parts' walks,
# which check each part's.
memo fn early-of(path: Text) -> early.Problem? {
  let pr = prepared-of(path)
  early.check-head(pr.tree0, pr.esm, not pr.esm, false)
}

memo fn from-of(path: Text) -> Parsed {
  let specs = [s for k in 0..len(split-source(path).starts) for s in piece-of(path ++ "\n" ++ int-text(k)).specs]
  parsed-with(path, split-source(path).src, prepared-of(path).tree0, some(specs), none)
}

# The big file, analysed: its parts' tables grafted in order, as one walk would have filled the
# table, ids and all. CommonJS, and code a define changes, are analysed again whole, as
# `analysis-of` does.
# A library inside one function, its body parsed in pieces and put together, then checked as the
# whole file would be.
fn nested-file(path: Text) -> Parsed? {
  let sp = split-source(path)
  if sp.open < 0 { return none }
  let pieces = [piece-of(path ++ "\n" ++ int-text(k)).tree for k in 0..len(sp.starts)]
  if any t in pieces: is-none(t) { return none }
  match assembled(sp, path, [t for some(t) in pieces]) {
    some(tree) => {
      let found = early.run(tree, false, true, false, false, false, [])
      match found.problem {
        none => some(parsed-with(path, sp.src, tree, none, some(Checked(tree: tree, requires: found.requires, imports: found.imports))))
        some(p) => panic "{}:{}:{}: {}", path, line-of(sp.src, p.at), col-of(sp.src, p.at), p.message
      }
    }
    none => none
  }
}

fn finished-file(path: Text) -> Parsed {
  let pr = prepared-of(path)
  let sp = split-source(path)
  if not pr.whole { return targets-of(analysed-file(nested-file(path) ?? parsed-file(Pending(path: path, text: sp.src, ready: true)))) }
  let p = from-of(path)
  let found = [piece-of(path ++ "\n" ++ int-text(k)).targets for k in 0..len(sp.starts)]
  let targets = {spec: t for pt in found for spec in keys(pt) if let some(t) = pt[spec]}
  let walks = [walked-of(path ++ "\nw" ++ int-text(k)) for k in 0..len(pr.parts)]
  # A part's symbols move by how many the table holds before it is grafted.
  let ends = scan n = sym.symbol-count(pr.scopes) for w in walks: n + sym.symbol-count(w.scopes)
  let bindings = {key: if v < 0 then -1 - v else v + ends[k] - sym.symbol-count(walks[k].scopes)
                  for k in 0..len(walks) for key in keys(walks[k].bindings) if let some(v) = walks[k].bindings[key]}
  let own = sym.grafted(pr.scopes, [w.scopes for w in walks], pr.root)
  let head = early-of(path)
  let problem = if is-some(head) then head else first w in walks: w.problem
  if let some(at) = problem {
    panic "{}:{}:{}: {}", path, line-of(sp.src, at.at), col-of(sp.src, at.at), at.message
  }
  # CommonJS names `module`, `exports` or `require` without declaring them: free, or under the
  # wrapper, the wrapper's. A file prepared for the wrapper that turns out not to be CommonJS, or one
  # prepared without it that is, is analysed again whole, as is code a define changes.
  let cjs = not pr.esm and (sym.has-free?(own, "require")
                            or (if pr.wrapper >= 0 then wrapper-used?(own, pr.wrapper, "module") or wrapper-used?(own, pr.wrapper, "exports")
                                else sym.has-free?(own, "module") or sym.has-free?(own, "exports")))
  if cjs != (pr.wrapper >= 0) or p.jsx-imports or (any w in walks: w.defined) {
    let q = analysed-file(p)
    return q with { targets: {spec: t for spec in q.specs if let some(t) = targets[spec]} }
  }
  let real-free = [f for f in sym.free-names(own) if not (f in p.helpers)]
  let a = Analysis(tree: pr.tree, root: pr.root, bindings: bindings, free: real-free, cjs: cjs, shift: 0, defined: false)
  let calls = [r for w in walks for r in w.requires] ++ [r for w in walks for r in w.imports]
  p with { analysed: true, scopes: own, analysis: a, calls: calls, targets: targets }
}

fn wrapper-used?(t: sym.Table, wrapper: Int, name: Text) -> Bool = match sym.scope-at(t, wrapper).names[name] {
  some(s) => sym.symbol-at(t, s).uses > 0
  none => false
}

# Early errors, which `parse-file` checks of a file parsed whole.
fn checked-early(tree: Node, src: Text, path: Text) -> Node {
  let is-module = early.program-has-module-syntax?(tree)
  match early.check(tree, is-module, not is-module, false) {
    none => tree
    some(p) => panic "{}:{}:{}: {}", path, line-of(src, p.at), col-of(src, p.at), p.message
  }
}

# Where a large file is cut: where the coarse grammar finds a declaration starting a line at the
# top level, at least a piece's size from the last cut and from the end. A file the coarse grammar
# cannot read is not cut.
fn piece-starts(src: Text) -> [Int] = match co.parse-opt(src, "<coarse>", 0) {
  some(co.Coarse(List(items...))) =>
    fold cuts = [] for co.Cut(_) as line in items if len(src) - line.hi >= piece-bytes:
      if line.hi - (if len(cuts) == 0 then 0 else last(cuts)) >= piece-bytes then cuts ++ [line.hi] else cuts
  _ => []
}

fn values-of(m: {Text:Text}) -> [Text] = [m[k] ?? k for k in keys(m)]

# `ahead-target` without hooks, which only the thread that owns them may call.
fn unhooked-target(spec: Text, importer: Text) -> Text? {
  if res.external?(aliased(spec)) or (loading.packages-external and package-spec?(aliased(spec), importer)) { return none }
  let wanted = aliased(spec)
  if let some(p) = configured-path(wanted, importer) { return some(p) }
  let from = if wanted != spec and res.relative?(wanted) then "alias" else importer
  match res.resolve-opt(wanted, from) {
    some(r) => some(r.path)
    none => none
  }
}

fn ahead?(path: Text) -> Bool = loader-of(path) != "file"

# Where an import would lead, or nothing if it leads nowhere or stays outside the bundle.
fn ahead-target(spec: Text, importer: Text) -> Text? {
  if stays-external?(spec, importer) { return none }
  let wanted = aliased(spec)
  if let some(p) = hook-path(wanted, importer) { return some(p) }
  if let some(p) = configured-path(wanted, importer) { return some(p) }
  let from = if wanted != spec and res.relative?(wanted) then "alias" else importer
  match res.resolve-opt(wanted, from) {
    some(r) => some(r.path)
    none => none
  }
}

# Parse every file the entries can reach, a wave at a time: each wave's files are parsed at once,
# and their imports are the next wave.
fn parse-ahead!(paths: [Text]) -> Void {
  if loading.load-threads <= 1 { return }
  let roots = [p for p in paths if ahead?(p) distinct p]
  # Without hooks, a worker can resolve what it parsed: a walk that never waits for a wave.
  parsed-ahead = if len(loading.on-load) == 0 and len(loading.on-resolve) == 0 then walked-ahead(roots)
                 else {d.path: d for d in parsed-waves(roots, {p: true for p in roots})}
}

fn walked-ahead(roots: [Text]) -> {Text:Parsed} {
  let walked = parallel-walk(roots, visit-file, next-files, first-files, loading.load-threads)
  let resolved = {r.path ++ "\n" ++ s: t for r in walked if r.role is Resolved for s in keys(r.targets) if let some(t) = r.targets[s]}
  {d.path: with-resolved(d, resolved) for d in walked if d.role is Whole}
}

# A file's targets, once those of its imports resolved as items of their own (see `first-files`) join it.
fn with-resolved(p: Parsed, resolved: {Text:Text}) -> Parsed =
  if len(keys(p.targets)) > 0 or len(p.specs) <= resolve-alone then p
  else p with { targets: {s: t for s in p.specs if let some(t) = resolved[p.path ++ "\n" ++ s]} }

# With hooks, which only this thread may call: a wave's files are parsed at once, and the files
# their imports lead to that none has led to before are the next wave.
fn parsed-waves(wave: [Text], seen: {Text:Bool}) -> [Parsed] {
  if len(wave) == 0 { return [] }
  let hooked = len(loading.on-load) > 0
  let items = [Pending(path: p, text: if hooked then module-text(source-of(p), p) else "", ready: hooked) for p in wave]
  let done = parallel-map(items, parsed-file, loading.load-threads)
  let next = [t for d in done for spec in d.specs if let some(t) = ahead-target(spec, d.path) if ahead?(t) and not (t in seen) distinct t]
  done ++ parsed-waves(next, {p: true for ps in [keys(seen), next] for p in ps})
}

fn load-file(path: Text, effects: Bool) -> Int {
  if let some(id) = by-path[path] { return id }
  let ahead = parsed-ahead[path] ?? parsed-file(Pending(path: path, text: as-module(source-of(path), path), ready: true))
  let src = ahead.src
  let parsed = ahead.parsed
  let transform = loading.transform
  let tree0 = if ahead.analysed then ahead.tree else transform(ahead.tree)
  let base = base-name(path)
  let id = len(modules)
  let a = if ahead.analysed then grafted(ahead)
          else grafted-analysis(analysis-of(tree0, parsed, src, path, base, ahead.jsx-imports, ahead.helpers))
  let final-tree = a.tree
  let cjs = a.cjs
  modules += blank-module(id, path, if cjs then Cjs else Esm, final-tree, a.root) with {
    bindings: a.bindings, symbol-shift: a.shift, side-effects: effects, base: base, source: tree0.body.kids,
    free: a.free, text: src, pure-at: ahead.pure-at, pure-calls: ahead.pure-calls,
    legal: ahead.legal, helpers: ahead.helpers
  }
  by-path[path] = id
  # Imports in source order, then what it loads at run time. Statements `define` removed import nothing.
  let reqs = if ahead.analysed then ahead.calls else calls-in(final-tree)
  let specs = [spec for s in tree0.body.kids if let some(spec) = import-spec-of(s)] ++ reqs
  # Loading them adds modules, so the map is made before it is stored.
  let ids = {spec: dep-add(id, spec, path) for spec in specs}
  modules[id].dep-ids = ids
  modules[id].calls = len(reqs) > 0
  order += id
  id
}

# The runtime is an ordinary module, id 0, that nothing makes live unless a part mentions one of
# its helpers.
fn load-runtime(text: Text) -> Void {
  let tree = js.parse(text, "<runtime>")
  let s = scope.scoped(tree, [])
  let a = grafted-analysis(Analysed(analysis: no-analysis() with { root: s.root, bindings: s.bindings }, scopes: s.table))
  modules += blank-module(0, "<runtime>", Runtime, tree, a.root) with {
    bindings: a.bindings, symbol-shift: a.shift, side-effects: false, base: "runtime", free: s.free, text: text
  }
  order += 0
}

fn public-url(local: Text) -> Text =
  if len(loading.public-path) == 0 then local
  else loading.public-path ++ (if ends-with(loading.public-path, "/") then "" else "/") ++ local[2..len(local)]

# Stylesheets the program imports, in the order its modules run.
fn css-imports() -> [Text] = [modules[id].path for id in order if loader-of(modules[id].path) == "css"]

fn load-tree(entry-path: Text) -> Void {
  entry = load-file(entry-path, true)
  entries = [entry]
  rebase-all!()
}

# Several entries, for code splitting. `entry` stays the first, for what only one of them can be.
fn load-trees(paths: [Text]) -> Void {
  parse-ahead!(paths)
  entries = [load-file(p, true) for p in paths]
  entry = entries[0]
  rebase-all!()
}
