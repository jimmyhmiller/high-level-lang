# What esbuild makes a literal of as it parses even without --minify (bundle.jsvalue): a string
# joined with a primitive, `+` and `-` of a primitive, `!`, `void` and `typeof` of one; and a string
# joined to the string ending a `+` before it (`x + "a" + "b"` as `x + "ab"`).
rewrite bundle.js
host bundle.minhost
leaves Str Num ;

rule fold-add    : Add(_, _) as n when @folds-always(n) => @folded-always(n) ;
rule join-nested : Add(_, _) as n when @joins-nested(n) => @joined-nested(n) ;
rule fold-neg    : Neg(_) as n when @folds-always(n) => @folded-always(n) ;
rule fold-pos    : Pos(_) as n when @folds-always(n) => @folded-always(n) ;
rule fold-not    : Not(_) as n when @folds-always(n) => @folded-always(n) ;
rule fold-void   : Void(_) as n when @folds-always(n) => @folded-always(n) ;
rule fold-typeof : TypeOf(_) as n when @folds-always(n) => @folded-always(n) ;
