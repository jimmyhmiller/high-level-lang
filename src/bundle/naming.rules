# Every symbol's name in the output, as esbuild's number renamer gives them: reserved words and the
# free names of the output's modules first, then each top-level claim in the program's order, the
# first of `x`, `x2`, `x3`… that nothing has; then each nested scope's symbols, clear of the top
# level's names and of the scopes around them. What the build chose, emitting reads: `finals` names
# every symbol.
#
# The top level is named stem by stem (see `m.stem-of`): every name renaming tries for a claim has
# the claim's stem, so one stem's names are decided by the claims and the reserved names of that
# stem alone. Which modules in the output may claim, or reserve, names of a stem, a database of its
# own says (bundle.stems), brought up to date as linking's is. Each module's part
# is its own: the names it reserves, the claims its statements make, and its nested scopes' names,
# which read of the top level only whether each name they try is taken, stem by stem. So an edit
# names again the stems its module's claims are of, and the modules those stems name, and no more.
rules bundle.naming over bundle.js
use bundle.modules as m
use bundle.analysis as an
use bundle.stems as st

# Every symbol, named as the output names it: the build's table with each module's block named.
setting finals: sym.Table

# Whether every global the runtime refers to is kept from the program's names: when any of the
# runtime is in the output, or lowering may add its helpers. Otherwise only those the bundle writes.
setting runtime-kept: Bool

# What each module in the output claims, by stem, and the names each keeps from everything else:
# what naming a stem reads of the modules. Given as settings, which are compared module by module,
# so a module whose claims an edit left as they were changes nothing that names a stem.
# Which modules in the output may claim, or reserve, names of each stem (see `stems-db`).
setting stems: st.Db

setting claims-of: {Int:{Text:[Claim]}}
setting reserved-of: {Int:[Text]}

# The top level's names, stem by stem, for every stem a module claims or reserves names of: what a
# module's names read of the top level. A setting, compared stem by stem, so a stem whose names an
# edit left as they were changes nothing that reads it, though the edit named it again.
setting top-names: {Text:StemNames}

fn final-of(s: Int) -> Text = sym.symbol-at(finals, s).final

const keywords: [Text] = ["arguments", "await", "break", "case", "catch", "class", "const", "continue",
  "debugger", "default", "delete", "do", "else", "enum", "eval", "export", "extends", "false", "finally",
  "for", "function", "if", "implements", "import", "in", "instanceof", "interface", "let", "new", "null",
  "package", "private", "protected", "public", "return", "static", "super", "switch", "this", "throw",
  "true", "try", "typeof", "var", "void", "while", "with", "yield"]

# The globals esbuild's runtime refers to, which no name may take when any of the runtime is in the
# output, as esbuild has it; lowering's helpers are the runtime's too. `require` and `Promise` never
# may: the bundle itself writes them.
const runtime-globals: [Text] = ["Object", "Symbol", "Reflect", "TypeError", "Math", "Proxy", "require", "Error", "Promise",
  "WeakSet", "SuppressedError", "Buffer", "Map", "URL", "document"]
const bundle-globals: [Text] = ["require", "Promise"]

fn included?(id: Int) -> Bool = m.db.active-module(id)
fn live?(p: Int) -> Bool = m.db.active-part(p)
fn parts-of(id: Int) -> [Int] = [p for m.db.part-of(?p, id)]
fn import-symbol?(s: Int) -> Bool = m.db.import-of(s, _, _) or m.db.ns-import(s, _)

# Names nothing may take: reserved words, and the free names of the modules in the output, the
# runtime's being `runtime-globals`: what minifying, which names the whole program at once, keeps.
fn reserved(extra: [Text]) -> {Text:Int} =
  {w: -1 for w in keywords ++ extra ++ [f for id in m.order if id != 0 and included?(id) for f in an.module-reserved(id)]}

# A name a statement takes at the top level: a symbol's, or one only kept from use, as -1.
record Claim { symbol: Int, name: Text }

# A module's claims, in its statements' order.
fn module-claims(id: Int) -> [Claim] =
  [c for p in parts-of(id) if live?(p)
     for c in cjs-claims(an.stmt-of(id, p), m.modules[id])
              ++ [Claim(symbol: s, name: sym.symbol-at(m.table, s).name) for m.db.declares(p, ?s) if not import-symbol?(s) and not sym.scope-at(m.table, sym.symbol-at(m.table, s).scope).dynamic]]

fn cjs-claims(s: Node, mo: m.Module) -> [Claim] = match s {
  BindName(x) => [Claim(symbol: -1, name: x) for symbol in m.symbol-of(mo, s.lo) if symbol in an.linked.cjs-imports]
  Import(...) | ImportDefault(...) | ImportDefaultAnd(...) | ImportNamespace(...) | ImportNamed(...)
    | ImportAs(...) | ImportName(...) | List(...) => [c for k in s.kids for c in cjs-claims(k, mo)]
  _ => []
}

# A module's claims, by their names' stems.
fn module-stem-claims(id: Int) -> {Text:[Claim]} =
  fold g = {} for c in module-claims(id): g ++ {m.stem-of(c.name): (g[m.stem-of(c.name)] ?? []) ++ [c]}

# The names of one stem taken at the top level, and which symbol took each (-1: reserved); and the
# name each claim of the stem was given, by its symbol.
record StemNames { taken: {Text:Int}, names: {Int:Text} }

# Naming a stem, as far as it has come: the names taken, each claim's name, and, for each name
# claimed, the number its last claim stopped at, where its next starts trying, since what was taken
# then is taken still.
record Naming { taken: {Text:Int}, names: {Int:Text}, tries: {Text:Int} }

# One stem's names: its reserved names first, then each claim of the stem, in the program's order.
fn stem-named(stem: Text) -> StemNames = StemNames(taken: done.taken, names: done.names)
  where sid = known-name(m.names, stem),
        # A stem no name of any module's has: nothing claims or reserves it.
        reserving = [id for x in [sid] if x >= 0 for stems.reserves-stem(?id, x) if id != 0],
        reserved = {w: -1 for w in (fixed-by-stem(runtime-kept)[stem] ?? []) ++ [n for id in reserving for n in reserved-of[id] ?? []
                                                                                if m.stem-of(n) == stem]},
        claimers = sort id in [id for x in [sid] if x >= 0 for stems.claims-stem(?id, x)] by m.ranks[id] ?? -1,
        claims = [c for id in claimers for c in (claims-of[id] ?? {})[stem] ?? []],
        done = fold t = Naming(taken: reserved, names: {}, tries: {}) for c in claims:
          (t with { taken: t.taken ++ {name: c.symbol}, names: t.names ++ {c.symbol: name}, tries: t.tries ++ {c.name: i} }
           where i = first j in (t.tries[c.name] ?? 1).. if not (spelled(c.name, j) in t.taken): j,
                 name = spelled(c.name, i))

# Whether the top level took a name. Of a stem no module claims or reserves, only a reserved word or
# a global can be taken.
fn top-taken?(name: Text) -> Bool = match top-names[m.stem-of(name)] {
  some(x) => name in x.taken
  none => name in keywords or name in globals()
}

fn globals() -> [Text] = match runtime-kept {
  true => runtime-globals
  false => bundle-globals
}

# The reserved words and the globals kept, by stem.
fn fixed-by-stem(runtime: Bool) -> {Text:[Text]} =
  fold g = {} for w in keywords ++ (match runtime { true => runtime-globals  false => bundle-globals }):
    g ++ {m.stem-of(w): (g[m.stem-of(w)] ?? []) ++ [w]}

# `name`, or `name2`, `name3`… the first not taken: at the top level, in a scope around, or before
# it in its own scope.
fn unique(name: Text, frames: [{Text:Int}], frame: {Text:Int}) -> Text =
  first i in 1.. if free?(spelled(name, i), frames, frame): spelled(name, i)

fn spelled(name: Text, i: Int) -> Text = match i {
  1 => name
  _ => name ++ int-text(i)
}

fn free?(c: Text, frames: [{Text:Int}], frame: {Text:Int}) -> Bool =
  not (c in frame) and not (any f in frames: c in f) and not top-taken?(c)

# A symbol and the name it has.
record Named { symbol: Int, name: Text }

# A scope's names, chosen in order: what they are, and which symbol has each.
record Frame { taken: {Text:Int}, named: [Named] }

# A scope code can reach by name at run time keeps its names.
fn scope-frame(now: sym.Scope, frames: [{Text:Int}]) -> Frame = match now.dynamic {
  true => Frame(taken: {sym.symbol-at(m.table, s).name: s for s in now.symbols}, named: [])
  false => fold f = Frame(taken: {}, named: []) for s in now.symbols:
    (f with { taken: f.taken ++ {name: s}, named: f.named ++ [Named(symbol: s, name: name)] }
     where name = unique(sym.symbol-at(m.table, s).name, frames, f.taken))
}

# A scope's names and those of every scope inside it, each clear of the scopes around it. A scope
# that declares nothing adds nothing for those inside it to stay clear of.
fn nested(scope: Int, frames: [{Text:Int}]) -> [Named] = match now.symbols {
  [] => [nested(child, frames)... for child in now.children]
  _ => frame.named ++ [nested(child, inside)... for child in now.children]
    where frame = scope-frame(now, frames),
          inside = frames ++ [frame.taken]
} where now = sym.scope-at(m.table, scope)

# A module's nested scopes: CommonJS's start with its wrapper's own (exports, module) scope.
fn module-nested(mo: m.Module) -> [Named] = match mo.kind {
  m.Cjs => nested(sym.scope-at(m.table, mo.root).parent, [])
  _ => [nested(child, [])... for child in sym.scope-at(m.table, mo.root).children]
}

# A module's nested scopes' names, clear of the names the top level took.
fn module-named(id: Int) -> [Named] = module-nested(m.modules[id])

# A module's symbols as the output names them: its block, each claim's name from its stem and its
# nested scopes' names in it; and the names of the symbols linking made that its statements claim.
record ModuleNames { block: sym.Block, made: [Named] }

fn module-names(id: Int) -> ModuleNames =
  ModuleNames(block: sym.renamed(block-of(id), {x.symbol: x.name for x in top ++ module-named(id)}),
              made: [x for x in top if not sym.block-has?(block-of(id), x.symbol)])
  where top = [Named(symbol: c.symbol, name: (top-names[m.stem-of(c.name)] ?? (panic "no module claims names of {}", c.name)).names[c.symbol] ?? c.name)
               for g in [module-stem-claims(id)] for s in keys(g) if let some(cs) = g[s] for c in cs if c.symbol >= 0]

fn block-of(id: Int) -> sym.Block = m.blocks[id] ?? (panic "module {} has no block", id)

# A module's block as the output names it: one not in the output keeps every name its own, as its
# block already says.
fn output-block(id: Int) -> ModuleNames = match included?(id) {
  true => module-names(id)
  false => ModuleNames(block: block-of(id), made: [])
}

# esbuild's names for every symbol. `lowering`: whether lowering may add the runtime's helpers once
# the names are given.
fn esbuild-names(lowering: Bool) -> sym.Table = with stems = stems-db() { names-by-stems(lowering) }

# The same, once `stems` says which modules claim and reserve each stem: that much meets names
# new to the build's table (a stem is a name), and the rest only reads it.
fn names-by-stems(lowering: Bool) -> sym.Table =
  with runtime-kept = lowering or included?(0), claims-of = claims-now(), reserved-of = reserved-now() {
    with top-names = top-names-now() {
      named(m.table, [output-block(id) for id in m.order])
    }
  }

# Where renaming will look for a module in the output: the stems of the top-level names its
# statements claim, and of the names it keeps from everything else.
fn stem-facts-at(id: Int) -> [st.Fact] =
  [st.fact-claims-stem(id, m.name-id(s)) for s in keys(module-stem-claims(id))]
  ++ [st.fact-reserves-stem(id, m.name-id(s)) for s in reserved distinct s]
  ++ [st.fact-stem-bucket(sid, bucket-of(sid)) for s in keys(module-stem-claims(id)) ++ reserved distinct s for sid in [m.name-id(s)]]
  where reserved = [m.stem-of(n) for n in an.module-reserved(id)]

# The stem facts of the modules in the output, a block for each.
fn stem-blocks() -> [[st.Fact]] = [stem-facts-at(id) for id in m.order if included?(id)]

fn stems-db() -> st.Db = st.solved-blocks(stem-blocks())

# The settings naming reads, each made by a function of its own: an edit that leaves every module's
# claims as they were leaves each the answer it was, which the setting given it finds the same at once.
fn claims-now() -> {Int:{Text:[Claim]}} = {ids[i]: claims[i] for i in 0..len(ids)}
  where ids = [id for id in m.order if included?(id)],
        claims = [module-stem-claims(id) for id in ids]
fn reserved-now() -> {Int:[Text]} = {ids[i]: reserved[i] for i in 0..len(ids)}
  where ids = [id for id in m.order if id != 0 and included?(id)],
        reserved = [an.module-reserved(id) for id in ids]
fn top-names-now() -> {Text:StemNames} = {s: x for g in named for s in keys(g) if let some(x) = g[s]}
  where named = [bucket-named(b) for b in 0..buckets]

# Stems are named a bucket at a time, by their names' ids: an answer for each bucket, not for each
# stem, and an edit names again the buckets of the stems it changed.
const buckets: Int

fn bucket-of(sid: Int) -> Int = sid % buckets

fn bucket-named(b: Int) -> {Text:StemNames} = {s: stem-named(s) for sid in [x for stems.stem-bucket(?x, b)] for s in [name-of(m.names, sid)]}

fn named(t: sym.Table, all: [ModuleNames]) -> sym.Table =
  sym.named-from(t, [x.block for x in all], {n.symbol: n.name for x in all for n in x.made})

# Each symbol's own name.
fn own-names() -> [Text] = [sym.symbol-at(m.table, s).name for s in 0..sym.symbol-count(m.table)]

# A name for each symbol: the last one given it, or its own.
fn named-table(named: [Named]) -> [Text] = updated(own-names(), {x.symbol: x.name for x in named})
