# JavaScript's binding structure.
scopes bundle.js

ref Ident ;
bind BindName ;

# Functions, and the blocks inside them.
scope function
  FuncDecl GenDecl AsyncFuncDecl AsyncGenDecl
  FuncExpr GenExpr AsyncFuncExpr AsyncGenExpr
  Arrow AsyncArrow
  Method GenMethod AsyncMethod AsyncGenMethod Getter Setter
  StaticBlock ;
scope block Block TryBlock For ForIn ForOf Switch Catch ClassBody ClassExpr ;

# A script or a module is a function's body.
program function ;

# `var`s and parameters land in the function, through any blocks; `let`, `const`, `catch` and
# imports in the nearest block.
names VarDecl VarInit VarLeft VarLeftInit ExportVar Params in function ;
names LetDecl ConstDecl LetInit ConstInit LetLeft ConstLeft CatchHead Import in block function ;

# A function declaration's name is the function's around it; a class declaration's, the block's.
# A function or class expression's, and an arrow's lone parameter, are its own.
name FuncDecl GenDecl AsyncFuncDecl AsyncGenDecl in function ;
name ClassDecl in block function ;
name FuncExpr GenExpr AsyncFuncExpr AsyncGenExpr ClassExpr Arrow AsyncArrow in own ;

# A declaration's own name, and a method's key, are read in the scope around them.
outside name of FuncDecl GenDecl AsyncFuncDecl AsyncGenDecl ;
outside key of Method GenMethod AsyncMethod AsyncGenMethod Getter Setter ;

# `with`, and a direct `eval`: a call of the name itself, in parentheses or not. `eval` read any
# other way is the global function, which sees only the global scope, as esbuild has it.
dynamic With ;
dynamic-name eval in CallExpr through Paren ;
