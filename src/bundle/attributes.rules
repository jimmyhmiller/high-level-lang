# Import attributes: what an import statement's `with { … }`, or `import()`'s options, ask of the
# module, and what of that the build honours.
rules bundle.attributes over bundle.js
use bundle.minhost as host

# An import attribute as its source gives it, key and value resolved, and where it is.
record Attribute { key: Text, value: Text, at: Int }

# Why the build cannot do what an import asks, and where.
record Unhonoured { message: Text, at: Int }

fn attributes-of(s: Node) -> Node = match s {
  Import(_, _, a) | ImportBare(_, a) | ExportAll(_, a) | ExportAllAs(_, _, a) | ExportFrom(_, _, a) => a
  _ => panic "{}: no import statement", s.text
}

fn statement-attributes(a: Node) -> [Attribute] = match a {
  None() => []
  Attributes(List(es...)) => [Attribute(key: key-value(e.key), value: host.string-value(e.value.text), at: e.lo) for e in es]
}

fn key-value(k: Node) -> Text = match k {
  Str(raw) => host.string-value(raw)
  _ => host.escaped-value(k.text)
}

# `import()`'s attributes, when its options are written out as an object whose only property is
# `with`, an object of strings (the last of a key wins, as reading the object finds it). What else
# options may be, or do when evaluated, the build cannot know, and a call with them is an error.
fn call-attributes(options: Node) -> [Attribute]? = match options {
  None() => some([])
  ObjectLit(List(props...)) if all p in props: with-prop?(p) => match last p in props: p.value {
    none => some([])
    some(ObjectLit(List(ps...))) if all p in ps: string-prop?(p) =>
      some([x for i in 0..len(xs) for x in [xs[i]] if not (any later in xs[(i + 1)..len(xs)]: later.key == x.key)])
      where xs = [Attribute(key: key-value(p.key), value: host.string-value(p.value.text), at: p.lo) for p in ps]
    some(_) => none
  }
  _ => none
}

fn with-prop?(p: Node) -> Bool = match p {
  Prop(key, _) if plain-key?(key) => key-value(key) == "with"
  _ => false
}

fn string-prop?(p: Node) -> Bool = match p {
  Prop(key, Str(_)) => plain-key?(key)
  _ => false
}

fn plain-key?(k: Node) -> Bool = k is PropName(_) or k is Str(_)

fn json?(attributes: [Attribute]) -> Bool = any a in attributes: a.key == "type" and a.value == "json"

fn call-problem(n: Node, options: Node) -> Unhonoured? = match call-attributes(options) {
  some(a) => attributes-problem(a)
  none => some(Unhonoured(message: "import()'s options must be an object literal with only a `with` property, an object of strings, for the build to know what it imports", at: options.lo))
}

# The build honours `type: "json"`, as browsers and Node do, and no other attribute.
fn attributes-problem(attributes: [Attribute]) -> Unhonoured? =
  (first a in attributes if a.key != "type": Unhonoured(message: "importing with the \"" ++ a.key ++ "\" attribute is not supported", at: a.at))
  ?? (first a in attributes if a.value != "json": Unhonoured(message: "importing with a type attribute of \"" ++ a.value ++ "\" is not supported", at: a.at))
