# What a file loads at run time: its `require("x")` and `import("x")` calls, in source order,
# gathered in one traversal; and the first import attribute the build cannot honour.
attrs bundle.calls over bundle.js
use bundle.attributes as at

collect requires: [Text]
collect imports: [Text]
# `import("x", { with: { type: "json" } })`: a JSON module, not the file as its loader has it.
collect json-imports: [Text]
collect unhonoured: at.Unhonoured?

on CallExpr(Ident("require"), Args(List(Str(raw)))) { requires += unquote(raw) }
on ImportCall(Str(raw), options, _) if at.call-attributes(options) is some(a) and not at.json?(a) { imports += unquote(raw) }
on ImportCall(Str(raw), options, _) if at.call-attributes(options) is some(a) and at.json?(a) { json-imports += unquote(raw) }
on ImportCall(Str(_), options, _) as n { unhonoured += at.call-problem(n, options) }
on Import(...) | ImportBare(...) | ExportAll(...) | ExportAllAs(...) | ExportFrom(...) as n {
  unhonoured += at.attributes-problem(at.statement-attributes(at.attributes-of(n)))
}
