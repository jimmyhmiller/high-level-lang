# What a hot update runs again, and what it patches in place.
#
# A module whose code changed is patched when every statement of it that changed declares names
# and runs nothing as it is defined (a function, an inert value, a class's methods): the patch gives
# those names their new values in the module's scope, and the module keeps its state. It runs again
# instead when the rules found a change no patch can take (`blocked`: a statement that ran changed,
# its imports changed, it accepts its own updates, it is CommonJS), or when a statement that ran as
# a module loaded read a name the patch changes, or ran code that does: what that statement made is
# still there, made from the old value. A module that runs again makes each module that imports it
# run again, unless it accepts its own updates; an entry run again that does not accept means
# nothing can take the update, and the page reloads.
facts

relation changed(module)
relation imports(module, target)
relation accepts(module)
relation entry(module)
# A changed module no patch can take, and why: the reason's number.
relation blocked(module, reason)
# CommonJS, whose code is not looked into: what it read of what it requires may be anything.
relation opaque(module)

# A name of a module's top level the patch gives a new value. A class's method is a name of its own,
# `C#m` (or `C.m`, static), for what calls it.
relation swapped(module, name)

# Exports: a module's own (`home` is the module), what it passes on from another, and `export *`.
relation exported(module, export, home, name)
relation reexport(module, export, target, target-export)
relation star(module, target)
relation default-name(export)

# What an export of a module is, wherever it is declared.
relation provides(module, export, home, name)
provides(M, E, H, X) :- exported(M, E, H, X) ;
provides(M, E, H, X) :- reexport(M, E, A, F), provides(A, F, H, X) ;
provides(M, E, H, X) :- star(M, A), provides(A, E, H, X), !default-name(E) ;

# The code of a module's top-level names: what running it reads, calls or constructs (of the
# module's own names, or of an import), and the properties it reads or calls by name (`x.m`, which
# may run a method or accessor of that name). A method `m` of a class is `member-of` that name.
relation code-reads(module, name, read)
relation code-reads-import(module, name, target, export)
relation code-calls(module, name, callee)
relation code-calls-import(module, name, target, export)
relation code-member(module, name, member)
relation member-of(module, name, member)

# What a statement read, called and used by name as its module ran: each statement a number.
relation stmt-of(stmt, module)
relation ran-reads(stmt, name)
relation ran-reads-import(stmt, target, export)
relation ran-calls(stmt, name)
relation ran-calls-import(stmt, target, export)
relation ran-member(stmt, member)

# A name whose code, run now, would read or run what the patch changes: the patch's own names,
# and what reads them or calls what does.
relation spoiled(module, name)
spoiled(H, X) :- swapped(H, X) ;
spoiled(H, X) :- code-reads(H, X, Y), swapped(H, Y) ;
spoiled(H, X) :- code-reads-import(H, X, A, E), provides(A, E, G, Y), swapped(G, Y) ;
spoiled(H, X) :- code-calls(H, X, Y), spoiled(H, Y) ;
spoiled(H, X) :- code-calls-import(H, X, A, E), provides(A, E, G, Y), spoiled(G, Y) ;
spoiled(H, X) :- code-member(H, X, N), member-of(G, Y, N), spoiled(G, Y) ;

# A statement that ran with what the patch changes: it read a name the patch gives a new value, or
# ran code that reads or runs one. What it made was made from the old.
relation stale(stmt, home, name)
stale(R, M, X) :- ran-reads(R, X), stmt-of(R, M), swapped(M, X) ;
stale(R, H, X) :- ran-reads-import(R, A, E), provides(A, E, H, X), swapped(H, X) ;
stale(R, M, X) :- ran-calls(R, X), stmt-of(R, M), spoiled(M, X) ;
stale(R, H, X) :- ran-calls-import(R, A, E), provides(A, E, H, X), spoiled(H, X) ;
stale(R, H, X) :- ran-member(R, N), member-of(H, X, N), spoiled(H, X) ;

relation rerun(module)
rerun(M) :- blocked(M, R) ;
rerun(M) :- stale(R, H, X), stmt-of(R, M) ;
rerun(I) :- opaque(I), imports(I, M), swapped(M, X) ;

relation dirty(module)
dirty(M) :- rerun(M) ;
dirty(I) :- dirty(M), imports(I, M), !accepts(M) ;

relation boundary(module)
boundary(M) :- dirty(M), accepts(M) ;

relation unaccepted(module)
unaccepted(E) :- dirty(E), entry(E), !accepts(E) ;

relation patched(module)
patched(M) :- changed(M), !dirty(M) ;
