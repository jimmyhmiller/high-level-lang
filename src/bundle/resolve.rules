# Node-style module resolution: a search over the filesystem, whose knobs come from the build.
rules bundle.resolve
use bundle.package as pkg
use bundle.package-targets as targets

enum Kind { Import, Require }

fn conditions-for(kind: Kind) -> [Text] =
  [c for c in options.conditions if c != "import" and c != "require"] ++ [match kind { Import => "import" Require => "require" }]

record Options {
  main-fields: [Text],
  conditions: [Text],
  extensions: [Text],
  external: [Text],
  node-builtins: Bool
}

record Resolved { path: Text, side-effects: Bool }

# How the build looks names up. Every answer below is a memo, worked out once for all workers, and
# a build that is given other options starts them over.
setting options: Options

# What a directory holds, by name: 'f' a file, 'd' a directory, 'l' a link. Read once, as esbuild does,
# so each candidate a resolution tries costs a lookup and not a system call.
fn listing-of(dir: Text) -> {Text:Int} =
  {line[1..len(line)]: line[0] for line in split(dir-listing(dir), "\n") if line != ""}

fn file?(path: Text) -> Bool = match listing-of(dir-of(path))[path-base(path)] {
  # A link is the one case the listing cannot answer.
  some('l') => readable-file?(path)
  some('f') => true
  _ => false
}

# The file at `path`, if there is one.
fn existing(path: Text) -> Text? = first p in [path] if file?(p): p

fn doc-of(path: Text) -> pkg.Node = pkg.parse(read-file(path), path)

# The package.json in a directory, read.
fn package-doc(dir: Text) -> pkg.Node? = first pj in existing(dir ++ "/package.json"): doc-of(pj)

fn member(object: pkg.Node, key: Text) -> pkg.Node? = match object {
  pkg.Object(List(ms...)) => last m in ms if unquote(m.key.text) == key: m.value
  _ => none
}

fn text-member(object: pkg.Node, key: Text) -> Text? = match member(object, key) {
  some(pkg.Str(raw)) => some(unquote(raw))
  _ => none
}

# A file: the name as written, with each extension the build tries, then what TypeScript meant.
# The name as written is tried before any other spelling is made: most imports say the file's name.
fn try-file(base: Text) -> Text? = existing(base) ?? other-spelling(base)

fn other-spelling(base: Text) -> Text? =
  first path in [base ++ ext for ext in options.extensions] ++ typescript-instead(base) if file?(path): path

# TypeScript writes `./x.js` and means `./x.ts`: what it will be called once compiled.
fn typescript-instead(base: Text) -> [Text] = match base {
  stem ++ ".js" | stem ++ ".jsx" => [stem ++ ".ts", stem ++ ".tsx"]
  stem ++ ".mjs" => [stem ++ ".mts"]
  stem ++ ".cjs" => [stem ++ ".cts"]
  _ => []
}

# A directory: the first of its package.json's main fields that leads somewhere, then its index.
fn try-dir(dir: Text) -> Text? =
  (first doc in package-doc(dir) for field-name in options.main-fields if let some(target) = text-member(doc, field-name):
     try-path(path-normalize(dir ++ "/" ++ target)))
  ?? try-file(dir ++ "/index")

fn try-path(base: Text) -> Text? = try-file(base) ?? try-dir(base)

# The package.json governing a directory: the nearest one at or above it.
fn package-json-for(start: Text) -> Text? = first dir in path-ancestors(start) while path-base(dir) != "node_modules"
    for path in [in-dir(dir, "package.json")] if readable-file?(path): path

fn in-dir(dir: Text, name: Text) -> Text = match dir {
  "." => name
  "/" => "/" ++ name
  _ => dir ++ "/" ++ name
}

# Is the package.json governing a file `"type": "module"`?
fn package-type-module?(path: Text) -> Bool = type-module-dir?(dir-of(path))

fn type-module-dir?(dir: Text) -> Bool = match package-json-for(dir) {
  none => false
  some(pj) => (text-member(doc-of(pj), "type") ?? "") == "module"
}

# `"sideEffects"` in the package.json governing a file: `false`, or the files that have them. No
# list at all is every file, written as the empty pattern.
fn effect-patterns(dir: Text) -> [Text] = match package-json-for(dir) {
  none => [""]
  some(pj) => match member(doc-of(pj), "sideEffects") {
    some(pkg.False()) => []
    some(pkg.Array(List(items...))) => [package-pattern(dir-of(pj), unquote(item.text)) for item in items if item is pkg.Str(_)]
    _ => [""]
  }
}

# A pattern with no slash may be anywhere in the package.
fn package-pattern(root: Text, pattern: Text) -> Text = match pattern {
  _ if has-byte?(pattern, '/') => path-normalize(root ++ "/" ++ pattern)
  _ => path-normalize(root ++ "/**/" ++ pattern)
}

fn side-effects-of(path: Text) -> Bool = any p in effect-patterns(dir-of(path)): p == "" or glob?(p, path)

# esbuild's globs: `**/` is any number of directories, `**` anything else, `*` anything but a slash,
# and `?` any one byte.
fn glob?(p: Text, s: Text) -> Bool = match p {
  "" => s == ""
  "**/" ++ rest => glob?(rest, s) or glob?(rest, "") or (any i in 0..len(s) if s[i] == '/': glob?(rest, s[i + 1..len(s)]))
  "**" ++ rest => any i in 0..len(s) + 1: glob?(rest, s[i..len(s)])
  "*" ++ rest => any i in 0..segment-end(s) + 1: glob?(rest, s[i..len(s)])
  "?" ++ rest => s != "" and glob?(rest, s[1..len(s)])
  _ => s != "" and p[0] == s[0] and glob?(p[1..len(p)], s[1..len(s)])
}

# Where the text's first path segment ends.
fn segment-end(s: Text) -> Int = (first i in 0..len(s) if s[i] == '/': i) ?? len(s)

# A bare name: the package's own directory in the nearest node_modules that has one, and the part
# of the name after the package's, `@scope/name` being two parts.
fn resolve-bare(spec: Text, from-dir: Text) -> Text? = bare-target(spec, from-dir, Import, [])

fn package-name(spec: Text) -> Text = join(parts[0..cut], "/")
  where parts = split(spec, "/"), cut = min(len(parts), match spec { "@" ++ _ => 2 _ => 1 })

fn package-subpath(spec: Text) -> Text = "." ++ spec[len(package-name(spec))..len(spec)]

fn bare-target(spec: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match own-package(spec, from-dir) {
  some(pdir) => package-target-kind(pdir, package-subpath(spec), kind, seen)
  none => first dir in path-ancestors(from-dir)
    for pdir in [in-dir(dir, "node_modules/" ++ package-name(spec))]
    if is-some(package-doc(pdir)) or is-some(try-file(pdir ++ "/index")):
      package-target-kind(pdir, package-subpath(spec), kind, seen)
}

fn own-package(spec: Text, from-dir: Text) -> Text? = first pj in package-json-for(from-dir)
  for doc in [doc-of(pj)] if (text-member(doc, "name") ?? "") == package-name(spec) and is-some(member(doc, "exports")): dir-of(pj)

fn package-target(pdir: Text, sub: Text) -> Text? = package-target-kind(pdir, sub, Import, [])

fn package-target-kind(pdir: Text, sub: Text, kind: Kind, seen: [Text]) -> Text? = match package-doc(pdir) {
  some(doc) => match member(doc, "exports") {
    some(value) => resolved-target(targets.exports(value, sub, conditions-for(kind)), pdir, sub, kind, seen)
    none => match sub { "." => try-dir(pdir) _ => try-path(path-normalize(pdir ++ "/" ++ sub)) }
  }
  none => try-path(path-normalize(pdir ++ "/" ++ sub))
}

fn imports-target(spec: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match spec {
  "#" | "#/" ++ _ => panic "invalid package import {}", spec
  _ => match package-json-for(from-dir) {
    some(pj) => match member(doc-of(pj), "imports") {
      some(value) => resolved-target(targets.imports(value, spec, conditions-for(kind)), dir-of(pj), spec, kind, seen)
      none => panic "{}: package import {} is not defined", pj, spec
    }
    none => panic "package import {} has no package scope", spec
  }
}

fn resolved-target(target: targets.Target, dir: Text, spec: Text, kind: Kind, seen: [Text]) -> Text? = match target {
  targets.Target(kind: targets.Path, value: path) => first decoded in targets.decoded(path): existing(path-normalize(dir ++ "/" ++ decoded))
  targets.Target(kind: targets.Redirect, value: name) => match dir ++ ":" ++ spec in seen {
    true => panic "{}: cyclic package import {}", dir, spec
    false => target-kind(name, dir, kind, seen ++ [dir ++ ":" ++ spec])
  }
  targets.Target(kind: targets.Bad, value: reason) => panic "{}: invalid package target for {}: {}", dir, spec, reason
  targets.Target(kind: targets.Denied, ...) | targets.Target(kind: targets.Unmatched, ...) => panic "{}: package path {} is not exported or is blocked", dir, spec
}

const node-builtin-names: [Text] = ["assert", "async_hooks", "buffer", "child_process", "cluster",
  "console", "constants", "crypto", "dgram", "diagnostics_channel", "dns", "domain", "events", "fs",
  "fs/promises", "http", "http2", "https", "inspector", "module", "net", "os", "path", "perf_hooks",
  "process", "punycode", "querystring", "readline", "repl", "stream", "stream/promises",
  "string_decoder", "timers", "tls", "tty", "url", "util", "v8", "vm", "wasi", "worker_threads", "zlib"]

fn node-builtin?(spec: Text) -> Bool = match spec {
  "node:" ++ _ => true
  _ => spec in node-builtin-names
}

# Is this import left for the runtime to resolve? As esbuild reads `--external`: the name itself, a
# package's subpaths with it, and a pattern with one `*` standing for anything.
fn external?(spec: Text) -> Bool =
  (options.node-builtins and node-builtin?(spec)) or any x in options.external: external-match?(x, spec)

fn external-match?(pattern: Text, spec: Text) -> Bool = match pattern {
  before ++ "*" ++ after if has-byte?(after, '*') => panic "the external path {} has more than one * wildcard", pattern
  before ++ "*" ++ after => len(spec) >= len(before) + len(after) and starts-with(spec, before) and ends-with(spec, after)
  _ => spec == pattern or (not relative?(pattern) and starts-with(spec, pattern ++ "/"))
}

fn relative?(spec: Text) -> Bool = match spec {
  "./" ++ _ | "../" ++ _ | "/" ++ _ | "." | ".." => true
  _ => false
}

fn target-of(spec: Text, from-dir: Text) -> Text? = target-kind(spec, from-dir, Import, [])

# Browser maps apply both to a package's dependency spellings and to files resolved inside it.
# Disabled modules have an explicit virtual identity; they are not filesystem paths or externals.
fn browser-entry(doc: pkg.Node, key: Text) -> pkg.Node? = match member(doc, "browser") {
  some(pkg.Object(...) as map) => member(map, key)
  _ => none
}

fn browser-specifier(spec: Text, from-dir: Text) -> Text? = first pj in package-json-for(from-dir)
  for doc in [doc-of(pj)] for value in browser-entry(doc, spec): browser-value(value, dir-of(pj), spec)

fn browser-file(path: Text) -> Text? = first pj in package-json-for(dir-of(path))
  for doc in [doc-of(pj)] for key in ["./" ++ below-package(dir-of(pj), path)]
  for value in browser-entry(doc, key): browser-value(value, dir-of(pj), key)

fn below-package(dir: Text, path: Text) -> Text = match dir {
  "." => path
  _ => path[len(dir) + 1..len(path)]
}

fn browser-value(value: pkg.Node, dir: Text, key: Text) -> Text = match value {
  pkg.False() => "disabled:" ++ real-path(dir) ++ "/" ++ key
  pkg.Str(raw) => match unquote(raw) {
    "./" ++ path => path-normalize(real-path(dir) ++ "/" ++ path)
    target => target
  }
  _ => panic "{}: browser mapping for {} must be a string or false", dir, key
}

fn mapped-browser-target(target: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match target {
  "disabled:" ++ _ => some(target)
  _ => target-kind(target, from-dir, kind, seen)
}

fn target-kind(spec: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match options.node-builtins {
  true => basic-target(spec, from-dir, kind, seen)
  false => browser-target(spec, from-dir, kind, seen)
}

fn browser-target(spec: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match key in seen {
  true => panic "cyclic browser mapping for {} from {}", spec, from-dir
  false => match browser-specifier(spec, from-dir) {
    some(target) if target != spec => mapped-browser-target(target, from-dir, kind, seen ++ [key])
    _ => first path in basic-target(spec, from-dir, kind, seen) : match browser-file(path) {
      some(target) if target != path => mapped-browser-target(target, from-dir, kind, seen ++ [key])
      _ => some(path)
    }
  }
} where key = "browser:" ++ from-dir ++ ":" ++ spec

fn basic-target(spec: Text, from-dir: Text, kind: Kind, seen: [Text]) -> Text? = match spec {
  _ if options.node-builtins and node-builtin?(spec) => some("external:" ++ spec)
  "/" ++ _ => try-path(path-normalize(spec))
  "#" ++ _ => imports-target(spec, from-dir, kind, seen)
  _ if relative?(spec) => try-path(path-normalize(from-dir ++ "/" ++ spec))
  _ => bare-target(spec, from-dir, kind, seen)
}

fn resolution(dir: Text, spec: Text) -> Text? = resolution-kind(dir, spec, Import)

# Canonical identity follows symlinks. What its directory lists as a plain file is not a link itself,
# so only the directory is asked of the file system, once for all the files in it.
fn canonical(path: Text) -> Text = match listing-of(dir-of(path))[path-base(path)] {
  some('f') => in-dir(canonical-dir(dir-of(path)), path-base(path))
  _ => real-path(path)
}

fn canonical-dir(dir: Text) -> Text = real-path(dir)

fn resolution-kind(dir: Text, spec: Text, kind: Kind) -> Text? =
  first p in target-kind(spec, dir, kind, []): canonical(p)

fn resolve-opt(spec: Text, importer: Text) -> Resolved? = resolve-opt-kind(spec, importer, Import)

fn resolve-opt-kind(spec: Text, importer: Text, kind: Kind) -> Resolved? =
  first path in resolution-kind(dir-of(importer), spec, kind): Resolved(path: path, side-effects: side-effects-of(path))

fn resolve(spec: Text, importer: Text) -> Resolved = resolve-kind(spec, importer, Import)

fn resolve-kind(spec: Text, importer: Text, kind: Kind) -> Resolved =
  resolve-opt-kind(spec, importer, kind) ?? panic "{}: could not resolve {}", importer, spec
