# Early errors: programs the grammar accepts, but which the language forbids because of what
# surrounds them or what else is declared. An attribute grammar: what the code around a node
# permits is inherited, and the problems are collected, the first in tree order winning.
attrs bundle.early over bundle.js
# What a file loads is gathered in the same traversal.
include bundle.calls
use bundle.js as js
use bundle.scopes as sc
use bundle.minhost as host
use bundle.literal as lit

record Problem { message: Text, at: Int }
collect problem: Problem?

# What the program is: an ES module, or CommonJS, whose top level is a function's body.
input module: Bool
input allow-top-return: Bool
# `export { T }` of a type names nothing once the types have gone, and that is fine.
input types-erased: Bool
# A part of a big program, checked on its own: the program's own checks were made already, and
# these are its strictness and what it declares.
input part: Bool
input program-strict: Bool
input program-exportable: [Text]

# What the code around a node permits.
inh strict: Bool = false
inh in-function: Bool = false
inh in-generator: Bool = false
inh in-async: Bool = false
inh in-loop: Bool = false
inh in-switch: Bool = false
inh allow-new-target: Bool = false
inh allow-super-prop: Bool = false
inh allow-super-call: Bool = false
inh top-level: Bool = false
inh labels: [Text] = []
inh loop-labels: [Text] = []
inh exportable: [Text] = []
# A class with a heritage, whose constructor may call super().
inh in-derived: Bool = false
# Where the language checks nothing: a tagged template's raw text, the names an import lists.
inh checking: Bool = true

# How a node's parent uses it, which decides what it may be.
enum Role {
  Plain, Target, PatTarget, PatElem, ArrSlots, ArrSlot, RestSlot, ObjPatProps, ObjPatProp,
  ObjProps, ObjProp, ClassMembers, Member, StaticMember, Substmt, SubstmtFn, TaggedTpl, TaggedParts,
  TaggedPart
}
given role: Role = Plain

# A rule a node breaks when `bad`: the problem, where the language is checked. Rules joined with
# `??` give the first one broken.
fn rule(bad: Bool, message: Text, at: Node) -> Problem? = match bad and checking {
  true => some(Problem(message: message, at: at.lo))
  false => none
}

# A problem found otherwise, where the language is checked.
fn checked(p: Problem?) -> Problem? = match checking {
  true => p
  false => none
}

# ---------------------------------------------------------------- names

const strict-reserved: [Text] = ["implements", "interface", "let", "package", "private",
                                 "protected", "public", "static", "yield"]
const reserved-words: [Text] = ["break", "case", "catch", "class", "const", "continue", "debugger",
  "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for",
  "function", "if", "import", "in", "instanceof", "new", "null", "return", "super", "switch",
  "this", "throw", "true", "try", "typeof", "var", "void", "while", "with"]

fn restricted?(s: Text) -> Bool = s == "eval" or s == "arguments"

# The value of a run of hex digits, or past the largest code point, one more than it.
fn hex-value(digits: Text) -> Int = digits-number(digits, 16, 1114111) ?? 1114112

# A name's code points: UTF-8 decoded, `\u0061` and `\u{61}` resolved.
fn code-points(s: Text) -> [Int] = [piece-points(p)... for p in host.pieces(s)]

fn piece-points(p: lit.Node) -> [Int] = match p {
  lit.Plain(t) => code-points-of(t)
  lit.EscUni(t) => [hex-value(t[2..len(t)])]
  lit.EscBrace(t) => [hex-value(t[3..len(t) - 1])]
  _ => [-1]
}

# `\u0061` in a name means `a`, and an escaped keyword is still a keyword.
fn unescaped(s: Text) -> Text = match s {
  _ if has-byte?(s, '\\') => text-of-points([cp for cp in code-points(s) if cp >= 0])
  _ => s
}

const id-start-categories: [Text] = ["Lu", "Ll", "Lt", "Lm", "Lo", "Nl"]
const id-part-categories: [Text] = ["Mn", "Mc", "Nd", "Pc"]
const other-id-start: [Int] = [4256, 8472, 8494, 12443, 12444]
const other-id-continue: [Int] = [183, 903, 6618]

# ID_Start and ID_Continue, by general category, plus what the language adds.
fn id-part?(cp: Int, first: Bool) -> Bool = match cp {
  _ if cp < 0 or cp > 1114111 or (cp >= 55296 and cp <= 57343) => false
  36 | 95 => true
  8204 | 8205 if not first => true
  _ => cat in id-start-categories or cp in other-id-start
         or (not first and (cat in id-part-categories or cp in other-id-continue or (cp >= 4969 and cp <= 4977)))
    where cat = unicode-category(cp)
}

fn valid-name?(s: Text) -> Bool = match s {
  _ if all c in s: c != '\\' and c < 128 => true
  _ => len(points) > 0 and (all i in 0..len(points): id-part?(points[i], i == 0)) where points = code-points(s)
}

fn name-problem(n: Node) -> Problem? =
  rule(not valid-name?(n.text), "this is not a valid identifier", n)
  ?? rule(name != n.text and name in reserved-words, "a keyword cannot contain an escape", n)
  ?? rule(strict and name in strict-reserved, "this name is reserved in strict mode", n)
  ?? rule(in-generator and name == "yield", "yield is reserved in a generator", n)
  ?? rule((in-async or module) and name == "await", "await is reserved here", n)
  where name = unescaped(n.text)

fn binding-problem(n: Node) -> Problem? =
  name-problem(n) ?? rule(strict and restricted?(unescaped(n.text)), "eval and arguments cannot be bound in strict mode", n)

# ---------------------------------------------------------------- declarations

# Bindings of a declaration or pattern, in order.
everywhere fn bound-names(n: Node) -> [Text] = match n {
  BindName(x) => [unescaped(x)]
  _ if sc.opens?(n.kind) => []
}

fn duplicates?(xs: [Text]) -> Bool =
  any i in 0..len(xs): any j in 0..i: xs[i] == xs[j]

# `var` names hoisting through a statement list, not entering nested functions.
everywhere fn var-names(n: Node) -> [Text] = match n {
  _ if sc.names-in(n.kind) == "function" => bound-names(n)
  _ if sc.scope-kind(n.kind) == "function" => []
}

# Names a statement declares lexically, but for plain functions in a block.
fn lexical-names(s: Node, function-top: Bool) -> [Text] = match s {
  LetDecl(...) | ConstDecl(...) | Import(...) => bound-names(s)
  ClassDecl(name, ...) => [unescaped(name.text)]
  GenDecl(name, ...) | AsyncFuncDecl(name, ...) | AsyncGenDecl(name, ...) => [unescaped(name.text) for x in [name] if not function-top]
  ExportFunction(d) => lexical-names(d, function-top)
  ExportDefaultDecl(d) => match d.name {
    BindName(x) => [unescaped(x)]
    _ => []
  }
  ExportLexical(d) | ExportClass(d) => lexical-names(d, false)
  Labeled(_, body) => lexical-names(body, function-top)
  _ => []
}

# Plain function declarations in a block, which sloppy code may declare twice.
fn block-functions(s: Node, function-top: Bool) -> [Text] = match s {
  FuncDecl(name, ...) => [unescaped(name.text) for x in [name] if not function-top]
  ExportFunction(d) => block-functions(d, function-top)
  ExportLexical(d) | ExportClass(d) => block-functions(d, false)
  Labeled(_, body) => block-functions(body, function-top)
  _ => []
}

# The first problem with what a statement list declares, under strictness `now-strict`.
fn declaration-problem(stmts: [Node], function-top: Bool, params: [Text], at: Node, now-strict: Bool) -> Problem? =
  (first p in [Problem(message: "this name is declared twice in one block", at: at.lo)]
     if duplicates?(names) or (any f in functions: f in names or f in vars): p)
  ?? (first p in [Problem(message: "this function is declared twice in one block", at: at.lo)] if now-strict and duplicates?(functions): p)
  ?? (first n in names if n in vars or n in params:
        Problem(message: match n in vars {
                  true => "a let or const collides with a var"
                  false => "a let or const collides with a parameter"
                }, at: at.lo))
  where names = [lexical-names(s, function-top)... for s in stmts],
        functions = [block-functions(s, function-top)... for s in stmts],
        vars = [var-names(s)... for s in stmts]

fn declarations-problem(stmts: [Node], function-top: Bool, params: [Text], at: Node, now-strict: Bool) -> Problem? =
  checked(declaration-problem(stmts, function-top, params, at, now-strict))

# ---------------------------------------------------------------- functions

# Does the statement list begin with a `"use strict"` directive?
fn has-use-strict?(stmts: [Node]) -> Bool =
  any ExprStmt(Str(raw)) in [s for s in stmts while s is ExprStmt(Str(_))]: unquote(raw) == "use strict"

fn simple-params?(params: Node) -> Bool = match params {
  Params(List(ps...)) => all p in ps: p is Param(BindName(_), None())
  _ => false
}

fn contains-kind?(n: Node, yield-form: Bool) -> Bool = match n {
  Yield(...) | YieldStar(...) if yield-form => true
  Await(...) if not yield-form => true
  _ => sc.scope-kind(n.kind) != "function" and (any k in n.kids: contains-kind?(k, yield-form))
}

record FnKind { gen: Bool, async: Bool, arrow: Bool, method: Bool, super-call: Bool }

fn plain-fn(gen: Bool, async: Bool) -> FnKind =
  FnKind(gen: gen, async: async, arrow: false, method: false, super-call: false)
fn arrow-fn(async: Bool) -> FnKind =
  FnKind(gen: false, async: async, arrow: true, method: false, super-call: false)
fn method-fn(gen: Bool, async: Bool, super-call: Bool) -> FnKind =
  FnKind(gen: gen, async: async, arrow: false, method: true, super-call: super-call)


fn body-stmts(body: Node) -> [Node] = match body {
  FuncBody(List(ss...)) => ss
  _ => []
}

fn expression-fn?(n: Node) -> Bool = n is FuncExpr(...) | GenExpr(...) | AsyncFuncExpr(...) | AsyncGenExpr(...)

# What kind of function a node is, and where it is: a class's constructor may call super().
fn fn-kind(n: Node) -> FnKind = match n {
  FuncDecl(...) | FuncExpr(...) => plain-fn(false, false)
  GenDecl(...) | GenExpr(...) => plain-fn(true, false)
  AsyncFuncDecl(...) | AsyncFuncExpr(...) => plain-fn(false, true)
  AsyncGenDecl(...) | AsyncGenExpr(...) => plain-fn(true, true)
  Arrow(...) => arrow-fn(false)
  AsyncArrow(...) => arrow-fn(true)
  Method(key, ...) => method-fn(false, false, role == Member and prop-is?(key, "constructor") and in-derived)
  GenMethod(...) => method-fn(true, false, false)
  AsyncMethod(...) => method-fn(false, true, false)
  AsyncGenMethod(...) => method-fn(true, true, false)
  Getter(...) | Setter(...) => method-fn(false, false, false)
  _ => panic "fn-kind of a node that is no function"
}

# A function's own rules: its parameters, and what its body declares.
fn function-problem(params: Node, body: Node, f: FnKind) -> Problem? =
  params-problem(params, param-names, own-strict, strict or own-strict, f)
  ?? match body {
    FuncBody(...) => declarations-problem(stmts, true, param-names, body, strict or own-strict)
    _ => none
  }
  where stmts = body-stmts(body),
        own-strict = has-use-strict?(stmts),
        param-names = match params {
          Params(...) => bound-names(params)
          BindName(x) => [unescaped(x)]
          _ => []
        }

fn params-problem(params: Node, names: [Text], own-strict: Bool, now-strict: Bool, f: FnKind) -> Problem? = match params {
  Params(...) =>
    rule(f.arrow and in-generator and "yield" in names, "yield is reserved in a generator", params)
    ?? rule(own-strict and not simple-params?(params), "use strict needs simple parameters", params)
    ?? rule(duplicates?(names) and (now-strict or f.arrow or f.method or not simple-params?(params)), "a parameter is named twice", params)
    ?? rule(((f.gen or (f.arrow and in-generator)) and contains-kind?(params, true))
            or ((f.async or (f.arrow and in-async)) and contains-kind?(params, false)),
            "yield and await expressions cannot be parameter defaults here", params)
  _ => none
}

# What a method's name and parameters may be, in a class or an object.
fn member-problem(n: Node, key: Node, params: Node) -> Problem? = match n {
  Method(...) => rule(role == StaticMember and prop-is?(key, "prototype"), "a static method cannot be named prototype", key)
  GenMethod(...) | AsyncMethod(...) | AsyncGenMethod(...) => special-key-problem(key)
  Getter(...) => accessor-problem(params, 0) ?? special-key-problem(key)
  Setter(...) => accessor-problem(params, 1) ?? special-key-problem(key)
  _ => none
}

# ---------------------------------------------------------------- assignment targets

fn target-role?(r: Role) -> Bool = r == Target or r == PatTarget or r == PatElem
fn pattern-role?(r: Role) -> Bool = r == PatTarget or r == PatElem

# Can this be assigned to? A pattern allows the destructuring forms, and a pattern's element a
# default too.
fn target-problem(t: Node) -> Problem? = match t {
  Ident(x) => rule(strict and restricted?(unescaped(x)), "eval and arguments cannot be assigned in strict mode", t)
  Member(...) | Index(...) => none
  Paren(inner) => rule(not (inner is Ident(_) | Paren(_) | Member(...) | Index(...)), "invalid assignment target", t)
  ArrayLit(...) | ObjectLit(...) => rule(not pattern-role?(role), "invalid assignment target", t)
  Assignment(_, AssignOp("="), _) => rule(role != PatElem, "invalid assignment target", t)
  _ => rule(true, "invalid assignment target", t)
}

# A name the code around it assigns to.
fn target-name-problem(n: Node) -> Problem? = match role {
  Target | PatTarget | PatElem => target-problem(n)
  _ => none
}

# What the code around a node makes of it: an assignment target, a substatement, a pattern's property.
fn role-problem(n: Node) -> Problem? = match role {
  Target | PatTarget | PatElem => match n {
    Ident(_) => none
    _ => target-problem(n)
  }
  Substmt => substatement-problem(n, false)
  SubstmtFn => substatement-problem(n, true)
  ObjPatProp => rule(not (n is Shorthand(_) | CoverInit(...) | Prop(...) | SpreadProp(_)), "this cannot be destructured into", n)
  _ => none
}

fn array-pattern-problem(t: Node) -> Problem? = first i in 0..len(slots): slot-problem(slots, i)
  where slots = t.slots.kids

fn slot-problem(slots: [Node], i: Int) -> Problem? = match slots[i] {
  Hole() => none
  s => match s.value {
    Spread(inner) => rule(not (i == len(slots) - 1 and s is ElemLast(_)), "a rest element must come last, with no comma after it", s)
                     ?? rule(inner is Assignment(...), "a rest element cannot have a default", s)
    _ => none
  }
}

fn object-pattern-problem(t: Node) -> Problem? = first i in 0..len(props): property-problem(props, i)
  where props = t.props.kids

fn property-problem(props: [Node], i: Int) -> Problem? = match props[i] {
  SpreadProp(inner) as p => rule(i != len(props) - 1, "a rest property must come last", p)
                            ?? rule(not (inner is Ident(_) | Member(...) | Index(...)), "a rest property must be a simple target", p)
  _ => none
}

# ---------------------------------------------------------------- statements

fn substatement-problem(s: Node, allow-function: Bool) -> Problem? = match s {
  LetDecl(...) | ConstDecl(...) => rule(true, "a lexical declaration needs a block here", s)
  ClassDecl(...) => rule(true, "a class declaration needs a block here", s)
  GenDecl(...) => rule(true, "a generator declaration needs a block here", s)
  AsyncFuncDecl(...) => rule(true, "an async function declaration needs a block here", s)
  AsyncGenDecl(...) => rule(true, "an async generator declaration needs a block here", s)
  FuncDecl(...) => rule(not (allow-function and not strict), "a function declaration needs a block here", s)
  Labeled(_, body) => substatement-problem(body, false)
  _ => none
}

# A declaration's names must be initialised where the form requires it.
fn decl-list-problem(list: Node, need-init: Bool, lexical: Bool) -> Problem? =
  first d in list.kids: declarator-problem(d, need-init, lexical)

fn declarator-problem(d: Node, need-init: Bool, lexical: Bool) -> Problem? = match d {
  Declarator(target, init) =>
    rule(init is None() and (need-init or not (target is BindName(_))), "this declaration needs an initial value", d)
    ?? rule(lexical and "let" in names, "let cannot be the name of a lexical binding", d)
    ?? rule(lexical and duplicates?(names), "a name is bound twice in one pattern", d)
    where names = match lexical {
      true => bound-names(target)
      false => []
    }
  _ => panic "a declaration list holds declarators"
}

fn loop-head-problem(head: Node, body: Node) -> Problem? =
  rule(duplicates?(names), "a name is bound twice in one pattern", head)
  ?? (first n in names if n in vars or n == "let":
        rule(true, match n in vars {
               true => "a var in the body collides with the loop's binding"
               false => "let cannot be the name of a lexical binding"
             }, head))
  where names = bound-names(head),
        vars = var-names(body)

fn for-head?(left: Node) -> Bool = left is VarLeft(...) | VarLeftInit(...) | LetLeft(...) | ConstLeft(...)

fn for-left-problem(left: Node, body: Node, is-in: Bool) -> Problem? = match left {
  VarLeftInit(target, _) => rule(strict or not is-in or not (target is BindName(_)), "this for-in head cannot have an initial value", left)
  LetLeft(...) | ConstLeft(...) => loop-head-problem(left, body)
  _ => none
}

fn for-init-problem(init: Node, body: Node) -> Problem? = match init {
  VarInit(list) => decl-list-problem(list, false, false)
  LetInit(list) => decl-list-problem(list, false, true) ?? loop-head-problem(init, body)
  ConstInit(list) => decl-list-problem(list, true, true) ?? loop-head-problem(init, body)
  _ => none
}

fn module-item-problem(n: Node) -> Problem? =
  rule(not top-level, "import and export are only valid at the top level", n)
  ?? rule(not module, "import and export are only valid in a module", n)

fn is-loop-through-labels?(s: Node) -> Bool = match s {
  For(...) | ForIn(...) | ForOf(...) | While(...) | DoWhile(...) => true
  Labeled(_, body) => is-loop-through-labels?(body)
  _ => false
}

# ---------------------------------------------------------------- classes

fn prop-is?(key: Node, name: Text) -> Bool = match key {
  PropName(x) => x == name
  Str(raw) => unquote(raw) == name
  _ => false
}

# The name a class member declares, if it is one that has a name.
fn member-key(m: Node) -> Node? = match m {
  Method(k, ...) | GenMethod(k, ...) | AsyncMethod(k, ...) | AsyncGenMethod(k, ...) | Getter(k, ...) | Setter(k, ...)
    | Field(k, _) | StaticField(k, _) => some(k)
  _ => none
}

# A member declaring a private name: the member without `static`, and the name.
record Private { member: Node, name: Text }

fn private-of(m: Node) -> Private? = match member-key(inner) {
  some(PrivateName(name)) => some(Private(member: inner, name: name))
  _ => none
} where inner = match m {
  StaticMethod(x) => x
  _ => m
}

fn special-key-problem(key: Node) -> Problem? =
  rule(role == Member and prop-is?(key, "constructor"), "a constructor cannot be a generator, async, or an accessor", key)
  ?? rule(role == StaticMember and prop-is?(key, "prototype"), "a static method cannot be named prototype", key)

fn accessor-problem(params: Node, wanted: Int) -> Problem? =
  rule(len(list) != wanted, "a getter takes no parameters and a setter takes one", params)
  ?? rule(wanted == 1 and len(list) == 1 and list[0] is RestParam(_), "a setter's parameter cannot be a rest", params)
  where list = params.items.kids

# A class's members together: private names, and constructors.
fn class-problem(class: Node, body: Node) -> Problem? =
  (first i in 0..len(privates): private-problem(privates, i))
  ?? rule((count m in members: m is Method(...) and prop-is?(m.key, "constructor")) > 1, "a class has one constructor", class)
  where members = body.members.kids,
        privates = [p for m in members if let some(p) = private-of(m)]

fn private-problem(privates: [Private], i: Int) -> Problem? =
  rule(p.name == "#constructor", "#constructor is not a valid private name", p.member)
  ?? rule(not (p.member is Getter(...) | Setter(...)) and (any j in 0..i: privates[j].name == p.name), "a private name is declared twice", p.member)
  where p = privates[i]
# ---------------------------------------------------------------- literals

fn octal-escape?(s: Text) -> Bool = any p in host.pieces(s): p is lit.EscOctal(_)

# `\x` and `\u` must be complete, in strings and in untagged templates alike.
fn bad-escape?(s: Text) -> Bool = any p in host.pieces(s): match p {
  lit.EscOther("\\x") | lit.EscOther("\\u") => true
  lit.EscBrace(t) => hex-value(t[3..len(t) - 1]) > 1114111
  _ => false
}

fn regex-flags-bad?(text: Text) -> Bool =
  any i in 0..len(flags): not has-byte?("dgimsuvy", flags[i]) or (any j in 0..i: flags[j] == flags[i])
  where flags = text[(last-index-of(text, "/") ?? 0) + 1..len(text)]

fn legacy-octal?(t: Text) -> Bool = len(t) > 1 and t[0] == '0' and digit-byte?(t[1])

fn template-problem(n: Node) -> Problem? = rule(bad-escape?(n.text) or octal-escape?(n.text), "an invalid escape in a template", n)

# The name at the start of a member chain, or "".
fn spine-root(n: Node) -> Text = match n {
  Ident(x) => x
  Member(o, _) | Index(o, _) => spine-root(o)
  _ => ""
}

fn unparen(n: Node) -> Node = match n {
  Paren(x) => unparen(x)
  _ => n
}

fn optional-spine?(n: Node) -> Bool = match n {
  OptMember(...) | OptIndex(...) | OptCall(...) => true
  Member(o, _) | Index(o, _) | CallExpr(o, _) => optional-spine?(o)
  _ => false
}

# ---------------------------------------------------------------- modules

fn spec-text(n: Node) -> Text = match n {
  Str(raw) => unquote(raw)
  _ => unescaped(n.text)
}

# The names a module exports, for spotting one exported twice.
fn exported-names(s: Node) -> [Text] = match s {
  ExportNamed(List(specs...)) | ExportFrom(List(specs...), _) =>
    [exported-name(spec) for spec in specs if not (spec is TsErased())]
  ExportAllAs(name, _) => [spec-text(name)]
  ExportDefault(...) | ExportDefaultDecl(...) => ["default"]
  ExportVar(...) => bound-names(s)
  ExportLexical(d) => bound-names(d)
  ExportFunction(d) | ExportClass(d) => [d.name.text]
  _ => []
}

fn exported-name(spec: Node) -> Text = match spec {
  ExportAs(_, to) => spec-text(to)
  _ => spec-text(spec.local)
}

fn module-statement?(s: Node) -> Bool =
  s is Import(...) | ImportBare(...) | ExportAll(...) | ExportAllAs(...) | ExportFrom(...)
     | ExportNamed(...) | ExportDefault(...) | ExportDefaultDecl(...) | ExportVar(...)
     | ExportLexical(...) | ExportFunction(...) | ExportClass(...)
     | TsExportAssign(...) | TsExportEnum(...) | TsExportNamespace(...) | TsExportImport(...)
     | TsDecoratedExport(...) | TsExportDecorated(...) | TsDecoratedDefault(...) | TsDefaultDecorated(...)

fn program-has-module-syntax?(tree: Node) -> Bool = any s in tree.body.kids: module-statement?(s)

fn top-declared(s: Node) -> [Text] = match s {
  Import(...) => bound-names(s)
  FuncDecl(name, ...) => [name.text]
  ExportFunction(d) => [d.name.text]
  _ => []
}

# Every name a module declares at its top level.
fn module-names(stmts: [Node]) -> [Text] =
  [(lexical-names(s, false) ++ var-names(s) ++ top-declared(s))... for s in stmts] ++ [block-functions(s, false)... for s in stmts]


# ---------------------------------------------------------------- equations

# Names.
on Ident(x) | LabelName(x) as n { problem += name-problem(n) ?? target-name-problem(n) }
on BindName(_) as n { problem += binding-problem(n) }

# Whatever a node is, what its parent's use of it allows.
on n if role != Plain { problem += role-problem(n) }

# A list's elements are what its owner makes them.
on List(...) {
  kids.role = match role {
    ArrSlots => ArrSlot
    ObjPatProps => ObjPatProp
    ObjProps => ObjProp
    ClassMembers => Member
    TaggedParts => TaggedPart
    _ => Plain
  }
}

# ---- literals
on TsNamespaceBlock(List(ss...)) {
  # A namespace's body is its own module, as far as what it may export.
  kids.exportable = module-names(ss)
  kids.top-level = true
}
on JsxElement(open, _, JsxClose(_, close)) {
  problem += rule(js.render(open, false) != js.render(close, false), "this closing tag does not match its opening tag", close)
}
on Num(t) as n {
  problem += rule(strict and legacy-octal?(t), "a legacy octal literal is not allowed in strict mode", n)
             ?? rule(legacy-octal?(t) and has-byte?(t, '_'), "a legacy octal literal cannot contain _", n)
}
on Str(raw) as n {
  problem += rule(bad-escape?(unquote(raw)), "an incomplete escape sequence", n)
             ?? rule(strict and octal-escape?(unquote(raw)), "an octal escape is not allowed in strict mode", n)
}
on TemplateFull(_) | TemplateHead(_) | TemplateMiddle(_) | TemplateTail(_) as n { problem += template-problem(n) }
# A tagged template may have any escapes, and is not an optional chain's.
on Tagged(tag, tpl) as n {
  problem += rule(optional-spine?(tag), "a tagged template cannot be in an optional chain", n)
  tpl.role = TaggedTpl
  tpl.checking = checking and tpl is Template(...)
}
on Template(head, _, rest, tail) if role == TaggedTpl {
  head.checking = false
  tail.checking = false
  rest.role = TaggedParts
}
on TemplatePart(chunk, _) if role == TaggedPart { chunk.checking = false }
on Regex(t) as n { problem += rule(regex-flags-bad?(t), "invalid regular expression flags", n) }

# ---- assignment, update and patterns
on Assignment(target, AssignOp(op), _) {
  target.role = match op {
    "=" => PatTarget
    _ => Target
  }
}
on PreInc(t) | PreDec(t) | PostInc(t) | PostDec(t) { t.role = Target }
on Paren(inner) if target-role?(role) and (inner is Ident(_) | Paren(_)) { inner.role = Target }
on Delete(operand) as n {
  problem += rule(strict and unparen(operand) is Ident(_), "delete of a name is not allowed in strict mode", n)
             ?? rule(unparen(operand) is Member(_, PrivateName(_)) | OptMember(_, PrivateName(_)), "a private member cannot be deleted", n)
}
on ArrayLit(slots) as n if pattern-role?(role) {
  problem += array-pattern-problem(n)
  slots.role = ArrSlots
}
on Elem(e) | ElemLast(e) if role == ArrSlot {
  e.role = match e {
    Spread(_) => RestSlot
    _ => PatElem
  }
}
on Spread(inner) if role == RestSlot { inner.role = PatTarget }
on ObjectLit(props) as n if pattern-role?(role) {
  problem += object-pattern-problem(n)
  props.role = ObjPatProps
}
on ObjectLit(props) as n {
  problem += rule((count p in props.kids: p is Prop(...) and prop-is?(p.key, "__proto__")) > 1, "__proto__ is set twice", n)
  props.role = ObjProps
}
on Shorthand(x) if role == ObjPatProp { x.role = Target }
on CoverInit(...) as n if role != ObjPatProp { problem += rule(true, "`=` here is only allowed when destructuring", n) }
on CoverInit(x, _) if role == ObjPatProp { x.role = Target }
on Prop(_, v) if role == ObjPatProp { v.role = PatElem }
on SpreadProp(inner) if role == ObjPatProp { inner.role = Target }

# ---- classes
on ClassDecl(name, heritage, body) | ClassExpr(name, heritage, body) as n {
  problem += class-problem(n, body)
  name.strict = true
  heritage.strict = true
  heritage.top-level = false
  body.strict = true
  body.top-level = false
  body.in-derived = not (heritage is None())
}
on ClassBody(members) { members.role = ClassMembers }
on StaticMethod(m) if role == Member { m.role = StaticMember }
on Field(key, value) | StaticField(key, value) as n {
  problem += rule(prop-is?(key, "constructor"), "a field cannot be named constructor", key)
             ?? rule(n is StaticField(...) and prop-is?(key, "prototype"), "a field cannot be named prototype", key)
  value.in-function = true
  value.allow-new-target = true
  value.allow-super-prop = true
  value.allow-super-call = false
  value.in-async = false
  value.in-generator = false
}
on StaticBlock(...) {
  kids.in-function = false
  kids.in-async = false
  kids.in-generator = false
  kids.allow-new-target = true
  kids.allow-super-prop = true
  kids.allow-super-call = false
  kids.labels = []
  kids.loop-labels = []
  kids.in-loop = false
  kids.in-switch = false
}
# What the language does not check in a class: decorated members, and the types.
on TsDecoratedMember(...) | TsErased(...) { kids.checking = false }
on Super() as n { problem += rule(true, "super is only valid in a method", n) }
on CallExpr(Super() as callee, _) as n {
  problem += rule(not allow-super-call, "super() is only valid in a derived constructor", n)
  callee.checking = false
}
on Member(Super() as object, _) | Index(Super() as object, _) as n {
  problem += rule(not allow-super-prop, "super is only valid in a method", n)
  object.checking = false
}
on NewTarget() as n { problem += rule(not allow-new-target, "new.target is only valid in a function", n) }
on NewExpr(callee, _) as n {
  problem += rule(callee is ImportCall(...), "import() cannot be used with new", n)
             ?? rule(optional-spine?(callee), "new cannot have an optional chain", n)
}
on ImportMeta() as n { problem += rule(not module, "import.meta is only valid in a module", n) }

# ---- functions
# A declaration's name belongs to the code around it, under the body's strictness; an
# expression's is checked as its own. A method's name is the code around it.
on FuncDecl(name, params, body) | GenDecl(name, params, body) | AsyncFuncDecl(name, params, body)
   | AsyncGenDecl(name, params, body) | FuncExpr(name, params, body) | GenExpr(name, params, body)
   | AsyncFuncExpr(name, params, body) | AsyncGenExpr(name, params, body)
   | Method(name, params, body) | GenMethod(name, params, body) | AsyncMethod(name, params, body)
   | AsyncGenMethod(name, params, body) | Getter(name, params, body) | Setter(name, params, body) as n {
  problem += member-problem(n, name, params) ?? function-problem(params, body, f)
  name.strict = match f.method {
    true => strict
    false => now
  }
  name.in-generator = match f.method or not expression-fn?(n) {
    true => in-generator
    false => f.gen
  }
  name.in-async = match f.method or not expression-fn?(n) {
    true => in-async
    false => f.async
  }
  params.strict = now
  params.in-function = true
  params.in-loop = false
  params.in-switch = false
  params.labels = []
  params.loop-labels = []
  params.top-level = false
  params.in-generator = f.gen
  params.in-async = f.async
  params.allow-new-target = true
  params.allow-super-prop = f.method
  params.allow-super-call = f.super-call
  body.strict = now
  body.in-function = true
  body.in-loop = false
  body.in-switch = false
  body.labels = []
  body.loop-labels = []
  body.top-level = false
  body.in-generator = f.gen
  body.in-async = f.async
  body.allow-new-target = true
  body.allow-super-prop = f.method
  body.allow-super-call = f.super-call
} where f = fn-kind(n),
        now = strict or has-use-strict?(body-stmts(body))
# An arrow resets `yield`, only ever adds `await`, and keeps the rest of the code around it.
on Arrow(params, body) | AsyncArrow(params, body) as n {
  problem += function-problem(params, body, f)
  params.strict = now
  params.in-function = true
  params.in-loop = false
  params.in-switch = false
  params.labels = []
  params.loop-labels = []
  params.top-level = false
  params.in-generator = false
  params.in-async = in-async or f.async
  body.strict = now
  body.in-function = true
  body.in-loop = false
  body.in-switch = false
  body.labels = []
  body.loop-labels = []
  body.top-level = false
  body.in-generator = false
  body.in-async = in-async or f.async
} where f = fn-kind(n),
        now = strict or has-use-strict?(body-stmts(body))

# ---- statements
on Program(_, List(stmts...)) as n {
  problem += match part {
    true => none
    false => checked(head-problem(n, module, now))
  }
  kids.strict = now
  kids.in-async = module
  kids.top-level = true
  kids.exportable = match part {
    true => program-exportable
    false => module-names(stmts)
  }
} where now = match part {
          true => program-strict
          false => module or has-use-strict?(stmts)
        }
on Block(List(stmts...)) | TryBlock(List(stmts...)) as n {
  problem += declarations-problem(stmts, false, [], n, strict)
  kids.top-level = false
}
on Return(...) as n { problem += rule(not (in-function or allow-top-return), "return is only valid in a function", n) }
on With(_, body) as n {
  problem += rule(strict, "with is not allowed in strict mode", n)
  body.role = Substmt
}
on If(_, t, e) {
  t.top-level = false
  t.role = SubstmtFn
  e.top-level = false
  e.role = SubstmtFn
}
on While(_, body) {
  body.in-loop = true
  body.top-level = false
  body.role = Substmt
}
on DoWhile(body, ...) {
  body.in-loop = true
  body.top-level = false
  body.role = Substmt
}
# A `for` head's declarations: their names must not collide with the body's.
on For(init, _, _, body) {
  problem += for-init-problem(init, body)
  body.in-loop = true
  body.top-level = false
  body.role = Substmt
}
on ForIn(left, _, body) {
  problem += for-left-problem(left, body, true)
  left.role = match for-head?(left) {
    true => Plain
    false => PatTarget
  }
  body.in-loop = true
  body.top-level = false
  body.role = Substmt
}
on ForOf(wait, left, _, body) as n {
  problem += for-left-problem(left, body, false)
             ?? rule(spine-root(left) == "let", "for (let of …) is not allowed", left)
             ?? rule(left is Ident("async") and wait is None(), "for (async of …) is not allowed", left)
             ?? rule(not (wait is None()) and not (in-async or (module and not in-function)), "for await is only valid in an async function", n)
  left.role = match for-head?(left) {
    true => Plain
    false => PatTarget
  }
  body.in-loop = true
  body.top-level = false
  body.role = Substmt
}
on Switch(_, List(cases...) as list) as n {
  problem += rule((count c in cases: c is Default(_)) > 1, "a switch has one default", n)
             ?? declarations-problem([s for Case(_, List(ss...)) | Default(List(ss...)) in cases for s in ss], false, [], n, strict)
  list.in-switch = true
  list.top-level = false
}
on Break(None()) as n { problem += rule(not (in-loop or in-switch), "break is only valid in a loop or switch", n) }
on Break(l) as n {
  problem += rule(not (l is None()) and not (l.text in labels), "break to an unknown label", n)
  kids.checking = false
}
on Continue(l) as n {
  problem += rule(not in-loop, "continue is only valid in a loop", n)
             ?? rule(not (l is None()) and not (l.text in loop-labels), "continue to a label that is not a loop", n)
  kids.checking = false
}
on Labeled(label, body) {
  problem += rule(label.text in labels, "this label is already in use", label)
  body.labels = labels ++ [label.text]
  body.loop-labels = match is-loop-through-labels?(body) {
    true => loop-labels ++ [label.text]
    false => loop-labels
  }
  body.top-level = false
  body.role = SubstmtFn
}
on Try(_, handler, finisher) as n { problem += rule(handler is None() and finisher is None(), "try needs catch or finally", n) }
on VarDecl(list) { problem += decl-list-problem(list, false, false) }
on ExportVar(list) as n { problem += module-item-problem(n) ?? decl-list-problem(list, false, false) }
on LetDecl(list) { problem += decl-list-problem(list, false, true) }
on ConstDecl(list) { problem += decl-list-problem(list, true, true) }
on Catch(head, body) {
  problem += catch-problem(head, body)
  kids.top-level = false
}

# ---- modules
# What an import or re-export lists names nothing here to check.
on Import(...) | ImportBare(...) | ExportAll(...) | ExportAllAs(...) | ExportFrom(...) as n {
  problem += module-item-problem(n)
  kids.checking = false
}
on ExportNamed(List(specs...)) as n {
  problem += module-item-problem(n) ?? (first spec in specs if not (spec is TsErased()): export-spec-problem(spec.local))
  kids.checking = false
}
on ExportDefault(...) | ExportDefaultDecl(...) | ExportLexical(...) | ExportFunction(...) | ExportClass(...) as n {
  problem += module-item-problem(n)
}

# A catch's parameters: bound once, and not declared again in its block.
fn catch-problem(head: Node, body: Node) -> Problem? =
  rule(duplicates?(names), "a catch parameter is bound twice", head)
  ?? (first l in [lexical-names(s, false)... for s in stmts] ++ [block-functions(s, false)... for s in stmts] if l in names:
        rule(true, "this name collides with the catch parameter", body))
  ?? match head {
    None() => none
    _ if head.target is BindName(_) => none
    _ => first v in [var-names(s)... for s in stmts] if v in names: rule(true, "a var collides with a destructured catch parameter", body)
  }
  where stmts = body.stmts.kids,
        names = match head {
          None() => []
          _ => bound-names(head)
        }

# What an export statement names must be declared here.
fn export-spec-problem(local: Node) -> Problem? =
  rule(local is Str(_) or local.text in reserved-words, "this export names no local binding", local)
  ?? rule(not types-erased and not (unescaped(local.text) in exportable), "this export names nothing declared in the module", local)

# ---------------------------------------------------------------- the checks

# What concerns a program's statements together: names exported twice, and what its top level
# declares. `now-strict` is the program's strictness.
fn head-problem(tree: Node, is-module: Bool, now-strict: Bool) -> Problem? =
  (first p in [Problem(message: "a name is exported twice", at: tree.lo)] if is-module and duplicates?([exported-names(s)... for s in stmts]): p)
  ?? declaration-problem(stmts, not is-module, [], tree, now-strict)
  where stmts = tree.body.kids

# The first early error in a program. `is-module` is whether it is an ES module, which the
# bundler decides from its syntax. `top-return` is for CommonJS, whose top level is a function.
fn check(tree: Node, is-module: Bool, top-return: Bool, typed: Bool) -> Problem? =
  run(tree, is-module, top-return, typed, false, false, []).problem

# A big program checked in parts at once: first what concerns its statements together, then each
# part's statements, in the program's context.
fn check-head(tree: Node, is-module: Bool, top-return: Bool, typed: Bool) -> Problem? =
  head-problem(tree, is-module, is-module or has-use-strict?(tree.body.kids))

# What a program's statements may export, which each part's check needs.
fn exportable-of(tree: Node) -> [Text] = module-names(tree.body.kids)

fn check-part(tree: Node, is-module: Bool, top-return: Bool, typed: Bool, exportable: [Text], part: [Node]) -> Problem? =
  part-found(tree, is-module, top-return, typed, exportable, part).problem

# The same, with what the part loads.
fn part-found(tree: Node, is-module: Bool, top-return: Bool, typed: Bool, exportable: [Text], part: [Node]) -> Attrs =
  run(Program(tree.hashbang, List(part...)), is-module, top-return, typed, true,
      is-module or has-use-strict?(tree.body.kids), exportable)


