# Text as runs of ASCII and runs of what is past it. `--charset=ascii` escapes the second's
# characters and leaves the first as it is.
syntax
start Chars
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
token Ascii = [\x00-\x7f]+ ;
token Wide = [\x80-\xff]+ ;

rule Chars = Run* -> Chars ;
rule Run = Ascii | Wide ;
