# A tree's scope analysis as a value: the table it fills, the root scope, which symbol each name
# means, and the names no scope declares. The one place a table is filled by analysing a tree.
rules bundle.scoped over bundle.js
use bundle.scopes as sc

record Scoped { table: sym.Table, root: Int, bindings: {Int:Int}, free: [Text] }

# In a fresh table, under a function's scope; with `wrapper` names, under one more function scope
# inside it that declares them, as CommonJS's (exports, module) wrapper does.
fn scoped(tree: Node, wrapper: [Text]) -> Scoped {
  var t = sym.table-new()
  let top = sym.new-scope!(t, -1, true)
  let scope = if len(wrapper) == 0 then top else wrapper-scope!(t, top, wrapper)
  var bindings: {Int:Int} = {}
  let root = sc.analyze(tree, t, scope, bindings)
  Scoped(table: t, root: root, bindings: bindings, free: sym.free-names(t))
}

fn wrapper-scope!(t: mut sym.Table, top: Int, names: [Text]) -> Int {
  let wrapper = sym.new-scope!(t, top, true)
  for n in names { sym.declare!(t, wrapper, n) }
  wrapper
}
