# What a build says of itself, for `--analyze=DIR`: each output and what of each module it holds;
# what each root (an entry, or what an `import()` names) loads; and each module: what it imports,
# who uses what it declares, and the statements it keeps for what they do. As JSON, and as one
# record a line for scripts. Everything here is read from what the build
# made: the outputs' texts and where each passes from one source to the next, the modules, and
# linking's database.
rules bundle.analyze over bundle.js
use bundle.js as js
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.sourcemap as map
use bundle.report as rep

# One file the build wrote: its text, and where (from `base` on) it passes to each source's code;
# the root it runs, if any (-1: none); the outputs it imports, and those it loads with `import()`.
record Output { path: Text, kind: Text, text: Text, base: Int, marks: [Mark], root: Int, imports: [Int], dynamic: [Int] }

record Span { module: Int, bytes: Int }

# A module's share of an output: from each place the output passes to its code, to the next. What
# comes before the first is the output's own: its imports and exports.
fn spans(o: Output) -> [Span] =
  [Span(module: map.mark-module(o.marks[i]), bytes: end - start)
   for i in 0..len(o.marks) for start in [o.base + o.marks[i].out]
   for end in [if i + 1 < len(o.marks) then o.base + o.marks[i + 1].out else len(o.text)]]

fn package-of(path: Text) -> Text = match last-index-of(path, "node_modules/") {
  none => ""
  some(at) => match split(path[at + 13..len(path)], "/") {
    [scope, name, ...] if starts-with(scope, "@") => scope ++ "/" ++ name
    [name, ...] => name
    _ => ""
  }
}

# ---------------------------------------------------------------- the facts

# What the report's rules work from: the outputs, and what linking knows of the parts.
fn facts-of(outputs: [Output]) -> [rep.Fact] =
  [rep.fact-output-bytes(i, len(outputs[i].text)) for i in 0..len(outputs)]
  ++ [rep.fact-output-import(i, j) for i in 0..len(outputs) for j in outputs[i].imports]
  ++ [rep.fact-root(outputs[i].root, i) for i in 0..len(outputs) if outputs[i].root >= 0]
  ++ [rep.fact-span(i, found[n].module, n, found[n].bytes) for i in 0..len(outputs) for found in [spans(outputs[i])] for n in 0..len(found)]
  ++ [rep.fact-part-of(p, id) for id in m.order for p in e.parts-of(id)]
  ++ [rep.fact-live(p) for id in m.order for p in e.parts-of(id) if e.live?(p)]
  ++ [rep.fact-declares(p, s) for m.db.declares(?p, ?s)]
  ++ [rep.fact-mentions(p, s) for m.db.mentions(?p, ?s)]
  ++ [rep.fact-uses(p, s) for m.db.uses(?p, ?s)]
  ++ [rep.fact-effect(p) for m.db.effect(?p)]
  ++ [rep.fact-imports(a, b) for m.db.imports(?a, ?b)]

# ---------------------------------------------------------------- the report

# What is written: each a record, as JSON its type says (`json`). `about` names each kind in the file
# of one record a line.
record Held { module: Int, bytes: Int }
record Within { output: Int, bytes: Int }
record OutputReport { about: Text, path: Text, kind: Text, bytes: Int, own: Int, root: Int?, imports: [Int], dynamic: [Int], modules: [Held] }
record RootReport { about: Text, module: Int, path: Text, kind: Text, output: Int, loads: [Int], bytes: Int }
record UsedBy { module: Int, names: [Text] }
record KeptFor { line: Int, text: Text }
# How a root reaches a module: the modules from the root to it, each importing the next.
record Chain { root: Int, modules: [Int] }
record ModuleReport {
  about: Text, path: Text, package: Text, kind: Text, source: Int, statements: Int, kept: Int, outputs: [Within],
  imports: [Int], dynamic: [Int], used-by: [UsedBy], kept-for: [KeptFor], chains: [Chain]
}
record Analysis { version: Int, outputs: [OutputReport], roots: [RootReport], modules: [ModuleReport] }

record Report { analysis: Analysis, json: Text, lines: Text }

fn report(outputs: [Output], roots: [Int]) -> Report =
  Report(analysis: analysis, json: json(analysis) ++ "\n",
         lines: join([json(x) for x in output-reports] ++ [json(x) for x in root-reports] ++ [json(x) for x in module-reports], "\n") ++ "\n")
  where analysis = Analysis(version: 2, outputs: output-reports, roots: root-reports, modules: module-reports),
        db = rep.solved(facts-of(outputs)),
        # The modules the outputs hold, numbered in the program's order.
        modules = [id for id in m.order if db.shown(id)],
        index = {modules[i]: i for i in 0..len(modules)},
        output-reports = [output-report(db, i, outputs[i], index) for i in 0..len(outputs)],
        root-reports = [root-report(db, r, index) for r in roots if is-some(first db.root(r, ?o): o)],
        module-reports = [module-report(db, id, index) for id in modules]

fn output-report(db: rep.Db, i: Int, o: Output, index: {Int:Int}) -> OutputReport =
  OutputReport(about: "output", path: o.path, kind: o.kind, bytes: len(o.text),
               own: len(o.text) - ((first db.modules-held(i, ?b): b) ?? 0),
               root: first r in [o.root] if r >= 0 for at in index[r]: at, imports: o.imports, dynamic: o.dynamic,
               modules: [Held(module: at, bytes: b) for db.held(i, ?mo, ?b) for at in index[mo]])

fn root-report(db: rep.Db, r: Int, index: {Int:Int}) -> RootReport =
  RootReport(about: "root", module: index[r] ?? -1, path: m.shown-path(m.modules[r].path),
             kind: if r in m.entries then "entry" else "import()", output: (first db.root(r, ?o): o) ?? -1,
             loads: sort o in [o for db.loads(r, ?o)] by o, bytes: (first db.root-bytes(r, ?b): b) ?? 0)

fn module-report(db: rep.Db, id: Int, index: {Int:Int}) -> ModuleReport =
  ModuleReport(about: "module", path: m.shown-path(mo.path), package: package-of(mo.path), kind: kind-name(mo), source: len(text),
               statements: (first db.statements(id, ?n): n) ?? 0, kept: (first db.kept(id, ?n): n) ?? 0,
               outputs: [Within(output: o, bytes: b) for db.held(?o, id, ?b)],
               imports: [i for d in imported for i in index[d]], dynamic: [i for d in dynamic for i in index[d]],
               used-by: [UsedBy(module: i, names: [sym.symbol-at(m.table, s).name for db.used-by(id, r, ?s)])
                         for r in [r for db.used-by(id, ?r, _) distinct r] for i in index[r]],
               kept-for: [KeptFor(line: map.line-at(starts, at) + 1, text: snippet(text, at)) for at in kept-for if at < len(text)],
               chains: [Chain(root: at, modules: [i for d in [r] ++ reversed([w.b for w in rep.why-reached(db, r, id) if w.relation == "imports"]) for i in index[d]])
                        for r in [r for db.reached(?r, id)] if is-some(first db.root(r, ?o): o) for at in index[r]])
  where mo = m.modules[id],
        text = source-text(mo),
        imported = [d for db.imports(id, ?d) distinct d],
        dynamic = [d for r in an.linked.dynamic-roots for d in [r] if d != id and (any k in keys(mo.dep-ids): (mo.dep-ids[k] ?? -1) == d)
                   and not (d in imported)],
        kept-for = [offset(an.stmt-of(id, p)) for db.kept-for(id, ?p)],
        # Lines found once for the file, and only for a file with statements to show.
        starts = if len(kept-for) > 0 then map.line-starts(text) else []

fn kind-name(mo: m.Module) -> Text = match mo.kind {
  m.Esm => "esm"
  m.Cjs => "commonjs"
  m.Runtime => "runtime"
  _ => "other"
}

fn source-text(mo: m.Module) -> Text = match mo.kind {
  m.External => ""
  _ => m.body-of(mo.id).text
}

# Where a statement starts in its file's text: a position may carry its file's number above 2^32.
fn offset(n: Node) -> Int = n.lo % map.module-unit

fn snippet(text: Text, at: Int) -> Text = trim(text[at..end])
  where line-end = (first i in index-of(text[at..len(text)], "\n"): at + i) ?? len(text),
        end = min(line-end, at + 120)
