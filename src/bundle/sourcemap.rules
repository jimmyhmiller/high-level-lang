# Source map v3 from the printer's marks: where each leaf token landed in the output, and which
# module and byte it came from. A mark's source is (module+1)<<32 | offset.
rules bundle.sourcemap
use bundle.modules as m

const base64: Text = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const module-unit: Int = 4294967296

# A number as base-64 digits of five bits, the lowest first, the sign in the lowest bit.
fn vlq(value: Int) -> Text = match value {
  _ if value < 0 => vlq-digits((0 - value) * 2 + 1)
  _ => vlq-digits(value * 2)
}

fn vlq-digits(v: Int) -> Text = match v {
  _ if v < 32 => byte-text(base64[v])
  _ => byte-text(base64[v % 32 + 32]) ++ vlq-digits(v / 32)
}

# JSON text, quoted: quotes, backslashes and control bytes escaped.
fn json-quoted(s: Text) -> Text =
  "\"" ++ replace-many(s, [byte-text(c) for c in json-escaped], [json-escape(c) for c in json-escaped]) ++ "\""

# The common ones first, as they are looked for in that order.
const json-escaped: [Int] = ['\n', '"', '\\', '\t', '\r'] ++ [c for c in 0..32 if not (c == '\n' or c == '\t' or c == '\r')]

fn json-escape(c: Int) -> Text = match c {
  '"' => "\\\""
  '\\' => "\\\\"
  '\n' => "\\n"
  '\r' => "\\r"
  '\t' => "\\t"
  _ => "\\u00" ++ byte-text("0123456789abcdef"[c / 16]) ++ byte-text("0123456789abcdef"[c % 16])
}

# UTF-16 code units a UTF-8 lead byte stands for, 0 for a continuation byte.
fn utf16-width(c: Int) -> Int = match c {
  _ if c < 128 => 1
  _ if c < 192 => 0
  _ if c < 240 => 1
  _ => 2
}

# Line starts of a source, for offset -> line lookups.
fn line-starts(src: Text) -> [Int] = [0] ++ [i + 1 for i in occurrences(src, ["\n"])]

fn line-at(starts: [Int], offset: Int) -> Int = max(0, bisect(starts, offset) - 1)

fn column-in(src: Text, from: Int, to: Int) -> Int = sum i in from..to: utf16-width(src[i])

# `../` for each directory of the output file, so paths resolve from the map.
# A module's path as the map names it: from the directory of the file the map is for, as esbuild
# has it, which resolves the module's links but not the directory's.
fn source-path(outfile: Text, path: Text) -> Text = m.relative-path(m.from-root(dir-of(outfile)), m.full-path(path))

# Where the printer is, each time it reaches a mark: how many line breaks it passed since the last,
# and its column, in UTF-16 units as source maps count them.
record Place { at: Int, breaks: Int, col: Int }

fn advanced(text: Text, p: Place, to: Int) -> Place = match count j in p.at..at: text[j] == '\n' {
  0 => Place(at: at, breaks: 0, col: p.col + column-in(text, p.at, at))
  breaks => Place(at: at, breaks: breaks, col: column-in(text, line-after-last(text, p.at, at), at))
} where at = max(p.at, to)

# Where the line of `at` starts, a break being between `from` and it.
fn line-after-last(text: Text, from: Int, at: Int) -> Int =
  from + (last-index-of(text[from..at], "\n") ?? panic "a break counted and not found") + 1

# Where a mark came from: which of the map's sources, and the line and column there.
record Origin { source: Int, line: Int, col: Int }

fn mark-module(k: Mark) -> Int = k.src / module-unit - 1

# Before each segment of `mappings`: `;` for each line passed, or `,` after a segment on this line.
fn lead(places: [Place], i: Int) -> Text = match places[i].breaks, i {
  0, 0 => ""
  0, _ => ","
  breaks, _ => join([";" for j in 0..breaks], "")
}

# Each number of a segment is the change from the one before; a new line starts its columns over.
fn column-change(places: [Place], i: Int) -> Int = match places[i].breaks, i {
  0, _ if i > 0 => places[i].col - places[i - 1].col
  _, _ => places[i].col
}

fn origin-before(origins: [Origin], i: Int) -> Origin = match i {
  0 => Origin(source: 0, line: 0, col: 0)
  _ => origins[i - 1]
}

# The map as JSON. `marks` are in output order, and `base` is where the printed body starts in `text`.
fn build-map(text: Text, base: Int, marks: [Mark], outfile: Text) -> Text =
  "{\"version\":3,\"sources\":[" ++ join([json-quoted(source-path(outfile, m.modules[s].path)) for s in sources], ",")
  ++ "],\"sourcesContent\":[" ++ join([json-quoted(m.modules[s].text) for s in sources], ",")
  ++ "],\"mappings\":"
  ++ json-quoted(join([lead(places, i) ++ vlq(column-change(places, i))
                       ++ vlq(origins[i].source - origin-before(origins, i).source)
                       ++ vlq(origins[i].line - origin-before(origins, i).line)
                       ++ vlq(origins[i].col - origin-before(origins, i).col) for i in 0..len(mapped)], ""))
  ++ ",\"names\":[]}\n"
  # The runtime is no source: esbuild's maps leave it out.
  where mapped = [k for k in marks if mark-module(k) > 0],
        sources = [mark-module(k) for k in mapped distinct mark-module(k)],
        index-of = {sources[i]: i for i in 0..len(sources)},
        tables = [line-starts(m.modules[s].text) for s in sources],
        places = scan p = Place(at: 0, breaks: 0, col: 0) for k in mapped: advanced(text, p, base + k.out),
        origins = [origin(k, (index-of[mark-module(k)] ?? panic "a mark from a module not among the sources"), tables)
                   for k in mapped]

fn origin(k: Mark, source: Int, tables: [[Int]]) -> Origin =
  Origin(source: source, line: line, col: column-in(m.modules[mark-module(k)].text, tables[source][line], offset))
  where offset = k.src % module-unit,
        line = line-at(tables[source], offset)
