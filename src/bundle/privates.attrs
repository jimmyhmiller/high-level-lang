# Private names minified, as esbuild's `--minify-identifiers` makes them. A private name means
# what the class body that declares it says, there and in the classes inside it, and nothing
# outside a class can name it: so each class's own names, the most used first, take the shortest
# names after those of the classes around it (which its body can still read), and classes side by
# side take the same ones. `#x in o` and `o.#x` read the name in scope.
attrs bundle.privates over bundle.js

# What each private name in scope is called now, and the first name a class inside may take.
inh names: {Text:Text} = {}
inh next: Int = 0

on ClassBody(List(members...)) as b {
  kids.names = names ++ {order[i]: short-name(next + i) for i in 0..len(order)}
  kids.next = next + len(order)
} where order = by-use([x for m in members for x in declared(m) distinct x], uses-in(b))

rewrite PrivateName(x) as n if x in names => PrivateName(names[x] ?? x) with { lo: n.lo, hi: n.hi }

# A statement with its private names minified.
fn renamed(n: Node) -> Node = run(n).tree

# The private name a class member declares.
fn declared(m: Node) -> [Text] = match m {
  Field(PrivateName(x), _) | StaticField(PrivateName(x), _) => [x]
  Method(PrivateName(x), ...) | GenMethod(PrivateName(x), ...) | AsyncMethod(PrivateName(x), ...)
    | AsyncGenMethod(PrivateName(x), ...) | Getter(PrivateName(x), ...) | Setter(PrivateName(x), ...) => [x]
  StaticMethod(inner) | TsDecoratedMember(_, inner) => declared(inner)
  _ => []
}

# Every private name read or declared inside a class body.
everywhere fn uses-in(n: Node) -> [Text] = match n { PrivateName(x) => [x] }

# Names by how often they are used, the commonest first; ties keep the order they are declared in.
fn by-use(names: [Text], uses: [Text]) -> [Text] = sort x in names by counts[x] ?? 0 desc
  where counts = {x: len([u for u in uses if u == x]) for x in names}

# The `i`th private name: a first character, then characters that may follow, as digits from the
# lowest.
fn short-name(i: Int) -> Text = "#" ++ byte-text(head[i % len(head)]) ++ rest(i / len(head))
  where head = [c for c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$"]

fn rest(i: Int) -> Text = match i {
  0 => ""
  _ => byte-text(tail[(i - 1) % len(tail)]) ++ rest((i - 1) / len(tail))
} where tail = [c for c in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789"]
