# What follows minifying, in one traversal: the shortest spellings (`final.rewrite`), strings as
# templates where that is shorter, and, with `--charset=ascii`, ASCII. Each changes only leaves, so
# one traversal does what three passes did, leaf by leaf in the same order; what each leaves alone
# is a subtree, said by an inherited attribute. Nothing is copied where nothing changes.
attrs bundle.finish over bundle.js
use bundle.js as js
use bundle.final as final
use bundle.minhost as host
use bundle.ascii as ascii

input ascii-wanted: Bool
# Off, nothing is respelled and no string becomes a template: only ASCII is made.
input respelling: Bool
# Whether strings here may become templates, and whether text here is made ASCII.
inh templates: Bool = true
inh ascii-on: Bool = false

on Program(...) { kids.ascii-on = ascii-wanted }

# A directive stays a string, and so does a key.
on ExprStmt(Str(_) as s) { s.templates = false }
on Prop(key, ...) | Method(key, ...) | GenMethod(key, ...) | AsyncMethod(key, ...) | AsyncGenMethod(key, ...)
   | Getter(key, ...) | Setter(key, ...) | Field(key, ...) | StaticField(key, ...) | PatProp(key, ...) {
  key.templates = false
}

# A regular expression's text and JSX's own stay as written, as do the names kept JSX gives its tags
# and attributes, where an escape is not allowed, and a tagged template's text.
on Regex(_) | JsxText(_) | JsxStr(_) | JsxTagText(_) | JsxName(_) { kids.ascii-on = false }
on JsxElement(tag, ...) { tag.ascii-on = false }
on JsxAttr(name, ...) { name.ascii-on = false }
on JsxClose(_, tag) { tag.ascii-on = false }
on Tagged(_, template) { template.ascii-on = false }

rewrite True() | False() | Num(_) | Str(_) as n if respelling => leaf-finished(n, templates, ascii-on) ?? n
rewrite _ as n if ascii-on and len(n.kids) == 0 => ascii.ascii-opt(n) ?? n

# The finished program; `ascii` when the output is to be ASCII.
fn finished(n: Node, ascii: Bool) -> Node = run(n, ascii, true).tree

# The program in ASCII, and nothing else changed.
fn ascii-only(n: Node) -> Node = run(n, true, false).tree

# A leaf: its shortest spelling, then a template, then ASCII, as the three passes made it.
fn leaf-finished(n: Node, templates: Bool, ascii-on: Bool) -> Node? = match out {
  _ if unchanged-leaf?(out, n) => none
  _ => some(out)
} where short = final.run(n),
        tpl = match short, templates {
          Str(_), true => host.templated(short) ?? short
          _, _ => short
        },
        out = match ascii-on {
          true => ascii.ascii-opt(tpl) ?? tpl
          false => tpl
        }

# The same leaf, whatever pass stamped it.
fn unchanged-leaf?(a: Node, b: Node) -> Bool =
  len(a.kids) == 0 and a.kind == b.kind and a.text == b.text and a.lo == b.lo and a.hi == b.hi
