# A JSON file as a JavaScript value: what the json loader's CommonJS module exports, and what a
# module imported `with { type: "json" }` has as its default. The file must be JSON, as esbuild's
# loader and the browser's both have it.
rules bundle.jsonmodule over bundle.json
use bundle.json as json
use bundle.minhost as host

# A file that is not JSON stops the build with file:line:col, as any syntax error does.
fn js-of(text: Text, path: Text) -> Text = value-text(json.parse(text, path))

# JSON is JavaScript, with one difference: in an object literal a `__proto__` key sets the
# prototype, where JSON.parse makes an own property, as a computed key does.
fn value-text(n: Node) -> Text = match n {
  Object(List(ms...)) => "{" ++ join([member-text(m) for m in ms], ",") ++ "}"
  Array(List(xs...)) => "[" ++ join([value-text(x) for x in xs], ",") ++ "]"
  EmptyObject() => "{}"
  EmptyArray() => "[]"
  True() => "true"
  False() => "false"
  Null() => "null"
  Str(raw) | Num(raw) => raw
}

# A key's value, its escapes resolved (JSON's are JavaScript's, meaning the same).
fn member-text(m: Node) -> Text = match host.string-value(m.key.text) {
  "__proto__" => "[" ++ m.key.text ++ "]:" ++ value-text(m.value)
  _ => m.key.text ++ ":" ++ value-text(m.value)
}
