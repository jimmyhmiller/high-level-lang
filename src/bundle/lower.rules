# Modern syntax as an older target can run it. This works on the final program, once names are final
# and the minifier is done, so nothing turns `a != null ? a : b` back into `??`.
rules bundle.lower over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.minhost as host

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

const no-lowering: Int = 9999

state target: Int = 9999
state short-names: Bool = false
state taken: {Text:Bool} = {}
state next-temp: Int = 0

# The variables the function being lowered needs declared, and the helpers the program needs.
context temps: [Text] = []
context helpers: [Text] = []

record Private {
  holder: Text,   # the WeakMap or WeakSet
  method: Text,   # the function, for a private method
  getter: Text,
  setter: Text
}

context privates: {Text:Private} = {}

fn before?(year: Int) -> Bool = target < year

# ---------------------------------------------------------------- names

const temp-letters: Text = "abcdefghijklmnopqrstuvwxyz"

# The `n`th name: `_a` to `_z`, then `_a1` and on.
fn spelled(prefix: Text, n: Int) -> Text =
  prefix ++ byte-text(temp-letters[n % 26]) ++ (if n >= 26 then int-text(n / 26) else "")

fn fresh-name(prefix: Text) -> Text {
  let n = first i in next-temp..: if spelled(prefix, i) in taken then none else some(i)
  next-temp = n + 1
  taken[spelled(prefix, n)] = true
  spelled(prefix, n)
}

# A variable of the function being lowered.
fn temp() -> Text {
  let name = fresh-name("_")
  temps += name
  name
}

fn helper(name: Text) -> Text {
  if not (name in helpers) { helpers += name }
  name
}

fn list-of(xs: [Node]) -> Node = List(xs...)
fn helper-call(name: Text, args: [Node]) -> Node = CallExpr(Ident(helper(name)), Args(List(args...)))
fn assign(t: Node, v: Node) -> Node = Assignment(t, AssignOp("="), v)
fn undefined-value() -> Node = Void(Num("0"))
fn string-of(s: Text) -> Node = Str(host.js-string(s))

fn seq(xs: [Node]) -> Node = fold out = xs[0] for i in 1..len(xs): Seq(out, xs[i])

# Can this be read twice without running anything twice?
fn repeatable?(n: Node) -> Bool = n is Ident(_) | This() | Str(_) | Num(_)

# ---------------------------------------------------------------- ?? and ?.

fn coalesced(a: Node, b: Node) -> Node {
  if repeatable?(a) { return Cond(Ne(a, Null()), a, b) }
  let t = temp()
  let held = Ident(t)
  Cond(Ne(assign(held, a), Null()), held, b)
}

fn spine-optional?(n: Node) -> Bool = match n {
  OptMember(...) | OptIndex(...) | OptCall(...) => true
  Member(o, _) | Index(o, _) | CallExpr(o, _) | Tagged(o, _) => spine-optional?(o)
  _ => false
}

fn spine-private?(n: Node) -> Bool = match n {
  Member(_, PrivateName(_)) | OptMember(_, PrivateName(_)) => true
  Member(o, _) | Index(o, _) | CallExpr(o, _) | Tagged(o, _) | OptMember(o, _) | OptIndex(o, _) | OptCall(o, _) => spine-private?(o)
  _ => false
}

# Does this chain have to come apart? Below ES2020 always, and below ES2022 if a private name is in it.
fn chain-lowers?(n: Node) -> Bool =
  spine-optional?(n) and (before?(2020) or (before?(2022) and spine-private?(n)))

fn tested(value: Node) -> Node = Eq(value, Null())

enum LinkKind { ByName, ByIndex, Called, TaggedBy }

record Link { kind: LinkKind, optional: Bool, part: Node }

# What a link of a chain hangs from.
fn chain-base(n: Node) -> Node = match n {
  Member(o, _) | OptMember(o, _) | Index(o, _) | OptIndex(o, _) | CallExpr(o, _) | OptCall(o, _) | Tagged(o, _) => o
  _ => panic "not a link of a chain: {}", js.kind-name(n.kind)
}

fn link-of(n: Node) -> Link? = match n {
  Member(_, p) => some(Link(kind: ByName, optional: false, part: p))
  OptMember(_, p) => some(Link(kind: ByName, optional: true, part: p))
  Index(_, e) => some(Link(kind: ByIndex, optional: false, part: e))
  OptIndex(_, e) => some(Link(kind: ByIndex, optional: true, part: e))
  CallExpr(_, Args(list)) => some(Link(kind: Called, optional: false, part: list))
  OptCall(_, list) => some(Link(kind: Called, optional: true, part: list))
  Tagged(_, t) => some(Link(kind: TaggedBy, optional: false, part: t))
  _ => none
}

# A chain's links from its root upward, and the root.
fn links-of(n: Node) -> [Link] = match link-of(n) {
  some(l) => links-of(chain-base(n)) ++ [l]
  none => []
}

fn chain-root(n: Node) -> Node = if is-some(link-of(n)) then chain-root(chain-base(n)) else n

fn read-link(base: Node, l: Link) -> Node = match l.kind {
  ByIndex => Index(base, lowered(l.part))
  _ => match l.part {
    PrivateName(x) => if before?(2022) then private-get(base, x) else Member(base, l.part)
    _ => Member(base, l.part)
  }
}

# `a?.b.c?.()` becomes `a == null ? void 0 : (_x = a.b.c) == null ? void 0 : _x.call(a.b)`. Walking up
# the chain, each `?.` adds a test and leaves the value in hand somewhere it can be read twice. A
# call that needs its `this` by hand has the object kept from the link before.
fn chain(n: Node, miss: Node, deleting: Bool) -> Node {
  let links = links-of(n)
  let root = chain-root(n)
  let start = Walk(value: if root is Super() then root else lowered(root), self: none, tests: [])
  let w = fold w = start for i in 0..len(links): link-walked(w, links, i)
  fold out = (if deleting then Delete(w.value) else w.value) for t in reversed(w.tests): Cond(t, miss, out)
}

# Where a chain's lowering is, link by link: the value so far, the object a call through it needs as
# `this`, and the `== null` tests met on the way, outermost first.
record Walk { value: Node, self: Node?, tests: [Node] }

fn link-walked(w: Walk, links: [Link], i: Int) -> Walk = match links[i].kind {
  Called => called(w, links[i])
  TaggedBy => Walk(value: Tagged(w.value, lowered(links[i].part)), self: none, tests: w.tests)
  _ => read(w, links, i)
}

# An optional link tests its value for `== null`, holding it in a temporary first unless it can be
# read twice.
fn tested-once(w: Walk) -> Walk {
  if repeatable?(w.value) { return Walk(value: w.value, self: w.self, tests: w.tests ++ [tested(w.value)]) }
  let held = Ident(temp())
  Walk(value: held, self: w.self, tests: w.tests ++ [tested(assign(held, w.value))])
}

# A call: through `.call` with the object kept from the link before, when there is one.
fn called(w: Walk, l: Link) -> Walk {
  let args = [lowered(a) for a in l.part.kids]
  match w.self {
    some(s) => {
      if not l.optional {
        return Walk(value: CallExpr(Member(w.value, PropName("call")), Args(List(([s] ++ args)...))), self: none, tests: w.tests)
      }
      let f = Ident(temp())
      Walk(value: CallExpr(Member(f, PropName("call")), Args(List(([s] ++ args)...))), self: none,
           tests: w.tests ++ [tested(assign(f, w.value))])
    }
    none => {
      let g = if l.optional then tested-once(w) else w
      Walk(value: CallExpr(g.value, Args(List(args...))), self: none, tests: g.tests)
    }
  }
}

# A member read. When a call that needs its `this` by hand comes next, the object is kept.
fn read(w0: Walk, links: [Link], i: Int) -> Walk {
  let l = links[i]
  let w = if l.optional then tested-once(w0) else w0
  let private-link = l.part is PrivateName(_) and before?(2022)
  let next-called = i + 1 < len(links) and links[i + 1].kind == Called
  if not (next-called and (links[i + 1].optional or private-link)) {
    return Walk(value: read-link(w.value, l), self: none, tests: w.tests)
  }
  if w.value is Super() { return Walk(value: read-link(w.value, l), self: some(This()), tests: w.tests) }
  if repeatable?(w.value) { return Walk(value: read-link(w.value, l), self: some(w.value), tests: w.tests) }
  let held = Ident(temp())
  Walk(value: read-link(assign(held, w.value), l), self: some(held), tests: w.tests)
}

# ---------------------------------------------------------------- assignment operators

record Target { read: Node, write: Node }

# A target read and then written, evaluating what it is made of once.
fn captured(t: Node) -> Target = match t {
  Member(o, name) => {
    let inner = lowered(o)
    if repeatable?(inner) {
      let same = Member(inner, name)
      Target(read: same, write: same)
    } else {
      let held = Ident(temp())
      Target(read: Member(assign(held, inner), name), write: Member(held, name))
    }
  }
  Index(o, key) => {
    let inner = lowered(o)
    let k = lowered(key)
    let self = if repeatable?(inner) then inner else Ident(temp())
    let first-self = if repeatable?(inner) then inner else assign(self, inner)
    let index = if repeatable?(k) then k else Ident(temp())
    let first-index = if repeatable?(k) then k else assign(index, k)
    Target(read: Index(first-self, first-index), write: Index(self, index))
  }
  _ => Target(read: t, write: t)
}

fn pattern-with-rest?(n: Node) -> Bool = match n {
  SpreadProp(_) => true
  ObjectLit(...) | ArrayLit(...) | Elem(_) | ElemLast(_) | Prop(...) | List(...) => any k in n.kids: pattern-with-rest?(k)
  _ => false
}

fn assignment(n: Node, t: Node, op: Text, v: Node) -> Node {
  if t is Member(_, PrivateName(_)) and before?(2022) { return private-assignment(t, op, v) }
  if (t is ObjectLit(...) | ArrayLit(...)) and before?(2018) and pattern-with-rest?(t) {
    panic "object rest in an assignment is not implemented for this target; use a declaration"
  }
  match op {
    "||=" | "&&=" | "??=" => if before?(2021) {
      let parts = captured(t)
      let set-it = assign(parts.write, lowered(v))
      return match op {
        "||=" => Or(parts.read, set-it)
        "&&=" => And(parts.read, set-it)
        _ => if before?(2020) then coalesced(parts.read, set-it) else Coalesce(parts.read, set-it)
      }
    }
    "**=" => if before?(2016) {
      let parts = captured(t)
      return assign(parts.write, CallExpr(Ident(helper("__pow")), Args(List(parts.read, lowered(v)))))
    }
    _ => {}
  }
  n with { target: if t is ObjectLit(...) | ArrayLit(...) then lowered-pattern-target(t) else lowered(t), value: lowered(v) }
}

# A destructuring target's spreads are rest elements, already refused above.
fn lowered-pattern-target(t: Node) -> Node = match t {
  ObjectLit(List(xs...)) => t with { props: list-of([lowered(x) for x in xs]) with { lo: t.props.lo, hi: t.props.hi } }
  _ => lowered(t)
}

# ---------------------------------------------------------------- object spread and rest

# What an object literal is so far: the object its spreads have made, and the plain properties
# since the last of them.
record Spreading { base: Node?, plain: [Node] }

fn object-spread(items: [Node]) -> Node {
  let s = fold s = Spreading(base: none, plain: []) for x in items: spread-step(s, x)
  if len(s.plain) == 0 { return s.base ?? ObjectLit(List()) }
  match s.base {
    some(b) => helper-call("__spreadProps", [b, ObjectLit(List(s.plain...))])
    none => ObjectLit(List(s.plain...))
  }
}

fn spread-step(s: Spreading, x: Node) -> Spreading = match x {
  SpreadProp(e) => Spreading(base: some(helper-call("__spreadValues", [spread-base(s.base, s.plain), lowered(e)])), plain: [])
  _ => s with { plain: s.plain ++ [lowered(x)] }
}

fn spread-base(base: Node?, plain: [Node]) -> Node = match base {
  some(b) => if len(plain) == 0 then b else helper-call("__spreadProps", [b, ObjectLit(List(plain...))])
  none => ObjectLit(List(plain...))
}

fn top-rest?(p: Node) -> Bool = match p {
  ObjectPattern(List(props...)) => any x in props: x is PatPropRest(_)
  _ => false
}

fn nested-rest?(n: Node) -> Bool = match n {
  PatPropRest(_) => true
  ObjectPattern(...) | ArrayPattern(...) | List(...) | PatItem(_) | PatLast(_) | PatProp(...) | BindElement(...) | PatRest(_) =>
    any k in n.kids: nested-rest?(k)
  _ => false
}

fn excluded-key(p: Node) -> Node = match p {
  PatProp(PropName(x), _) => string-of(x)
  PatProp(Str(raw), _) => Str(raw)
  PatProp(Num(t), _) => string-of(t)
  PatShort(BindName(x), _) => string-of(x)
  _ => panic "object rest with a computed key is not implemented for this target"
}

# `const { a, ...r } = o` is `const _a = o, { a } = _a, r = __objRest(_a, ["a"])`.
fn rest-declarators(pattern: Node, init: Node, at: Node) -> [Node] {
  let props = pattern.props.kids
  let plain = [p for p in props if not (p is PatPropRest(_))]
  if any p in plain: nested-rest?(p) { panic "object rest inside another pattern is not implemented for this target" }
  let keys = [excluded-key(p) for p in plain]
  let rest = last PatPropRest(t) in props: some(t)
  let holder = fresh-name("_")
  let slots = [if i == len(keys) - 1 then ElemLast(keys[i]) else Elem(keys[i]) for i in 0..len(keys)]
  let excluded = ArrayLit(List(slots...))
  let rebuilt: [Node] = if len(plain) == 0 then [] else [Declarator(lowered(ObjectPattern(List(plain...))), Ident(holder))]
  [Declarator(BindName(holder), init)] ++ rebuilt
  ++ [Declarator(rest ?? None(), helper-call("__objRest", [Ident(holder), excluded]))]
}

# ---------------------------------------------------------------- functions

fn with-temps(stmts: [Node], temps: [Text]) -> [Node] {
  if len(temps) == 0 { return stmts }
  let decls = [Declarator(BindName(t), None()) for t in temps]
  let at = directive-count(stmts)
  stmts[0..at] ++ [VarDecl(List(decls...))] ++ stmts[at..len(stmts)]
}

fn mentions-this?(n: Node) -> Bool = match n {
  This() => true
  _ => if sc.function?(n.kind) and not (n is Arrow(...) | AsyncArrow(...)) then false
       else any k in n.kids: mentions-this?(k)
}

fn mentions-arguments?(n: Node) -> Bool = match n {
  Ident("arguments") => true
  _ => if sc.function?(n.kind) and not (n is Arrow(...) | AsyncArrow(...)) then false
       else any k in n.kids: mentions-arguments?(k)
}

fn mentions-super?(n: Node) -> Bool = match n {
  Super() => true
  _ => if sc.function?(n.kind) and not (n is Arrow(...) | AsyncArrow(...)) then false
       else any k in n.kids: mentions-super?(k)
}

fn simple-parameters?(params: Node) -> Bool = match params {
  BindName(_) => true
  Params(List(ps...)) => all p in ps: p is Param(BindName(_), None())
  _ => false
}

everywhere fn replaced-await(n: Node) -> Node = match n {
  Await(x) => Yield(replaced-await(x))
  _ if sc.function?(n.kind) => n
}

# Inside an async generator, `await x` yields a marker the driver waits on, and `yield* x` delegates.
everywhere fn replaced-await-in-generator(n: Node) -> Node = match n {
  Await(x) => Yield(NewExpr(Ident(helper("__await")), Args(List(replaced-await-in-generator(x)))))
  YieldStar(x) => YieldStar(helper-call("__yieldStar", [replaced-await-in-generator(x)]))
  _ if sc.function?(n.kind) => n
}

record Wrapped { params: Node, body: Node }

fn body-statements(body: Node) -> [Node] = match body {
  FuncBody(List(ss...)) => ss
  ExprBody(e) => [Return(e)]
  _ => panic "unexpected function body"
}

fn params-node(params: Node) -> Node = match params {
  BindName(_) => Params(List(Param(params, None())))
  _ => params
}

fn outer-parameter-count(params: Node) -> Int = len([p for p in params.items.kids while p is Param(_, None())])

# `function f(x) { await x; }` is `function f(x) { return __async(this, null, function* () { yield x; }); }`.
# Parameters that run code must run inside, so that they reject the promise.
fn wrapped-in-generator(params: Node, body: Node, self: Node, driver: Text, generator: Bool) -> Wrapped {
  if mentions-super?(body) { panic "`super` in an async function is not implemented for this target" }
  let stmts = [if generator then replaced-await-in-generator(s) else replaced-await(s) for s in body-statements(body)]
  let simple = simple-parameters?(params)
  let inner-params = if simple then Params(List()) else params-node(params)
  let outer-params = if simple then params-node(params) else {
    let names = [Param(BindName(fresh-name("_")), None()) for i in 0..outer-parameter-count(params)]
    Params(List(names...))
  }
  let pass = if not simple or mentions-arguments?(body) then Ident("arguments") else Null()
  let inner = GenExpr(None(), inner-params, FuncBody(List(stmts...)))
  let driven = helper-call(driver, [self, pass, inner])
  Wrapped(params: outer-params, body: FuncBody(List(Return(driven))))
}

fn arrow-self(body: Node) -> Node = if mentions-this?(body) then This() else Null()

fn rest-prologue(params: Node) -> Wrapped {
  match params {
    Params(List(ps...)) => {
      var out: [Node] = []
      var decls: [Node] = []
      for p in ps {
        match p {
          Param(t, init) => {
            if top-rest?(t) {
              let name = fresh-name("_")
              out += Param(BindName(name), init) with { lo: p.lo, hi: p.hi }
              decls ++= rest-declarators(t, Ident(name), p)
            } else {
              out += p
            }
          }
          _ => { out += p }
        }
      }
      let stmts: [Node] = if len(decls) > 0 then [VarDecl(List(decls...))] else []
      Wrapped(params: Params(List(out...)) with { lo: params.lo, hi: params.hi }, body: FuncBody(List(stmts...)))
    }
    _ => Wrapped(params: params, body: FuncBody(List()))
  }
}

fn arrow?(n: Node) -> Bool = n is Arrow(...) | AsyncArrow(...)

# Lower a function: its parameters belong to the function around it, its body to itself.
fn function-node(n: Node) -> Node {
  let split = first k in n.kids:
    if k is Params(_) then some(if before?(2018) then rest-prologue(k) else Wrapped(params: k, body: FuncBody(List()))) else none
  let params = match split {
    some(s) => generic(s.params)
    none => (first k in n.kids: if k is BindName(_) and arrow?(n) then some(k) else none) ?? None()
  }
  let prologue = match split {
    some(s) => s.body.stmts.kids
    none => []
  }
  let body = (first k in n.kids: if k is FuncBody(_) | ExprBody(_) then some(k) else none) ?? None()
  rebuilt-function(n, params, lowered-body(body, prologue))
}

# A function's body lowered, with the temporaries it needs declared at its top. Its parameters
# were lowered already: what they need belongs to the function around it.
fn lowered-body(body: Node, prologue: [Node]) -> Node {
  with temps = [] {
    match body {
      FuncBody(List(ss...)) => body with { kids: [list-of(with-temps(lowered-list(prologue ++ ss), temps))] }
      ExprBody(e) =>
        if len(prologue) > 0 then FuncBody(list-of(with-temps(lowered-list(prologue ++ [Return(e)]), temps)))
        else {
          let x = lowered(e)
          if len(temps) == 0 then body with { kids: [x] } else FuncBody(list-of(with-temps([Return(x)], temps)))
        }
      _ => body with { kids: [list-of(with-temps([], temps))] }
    }
  }
}

fn function-part(k: Node, params: Node, body: Node) -> Node = match k {
  Params(_) => params
  FuncBody(_) | ExprBody(_) => body
  BindName(_) => k
  _ => lowered(k)
}

fn rebuilt-function(n: Node, params: Node, body: Node) -> Node {
  let same = n with { kids: [function-part(k, params, body) for k in n.kids] }
  let old = before?(2017)
  let old-generators = before?(2018)
  match same {
    AsyncFuncDecl(name, p, b) => if not old then same else {
      let w = wrapped-in-generator(p, b, This(), "__async", false)
      FuncDecl(name, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    AsyncFuncExpr(name, p, b) => if not old then same else {
      let w = wrapped-in-generator(p, b, This(), "__async", false)
      FuncExpr(name, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    AsyncArrow(p, b) => if not old then same else {
      let w = wrapped-in-generator(p, b, arrow-self(b), "__async", false)
      Arrow(w.params, ExprBody(w.body.stmts.kids[0].value)) with { lo: n.lo, hi: n.hi }
    }
    AsyncMethod(key, p, b) => if not old then same else {
      let w = wrapped-in-generator(p, b, This(), "__async", false)
      Method(key, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    AsyncGenDecl(name, p, b) => if not old-generators then same else {
      let w = wrapped-in-generator(p, b, This(), "__asyncGenerator", true)
      FuncDecl(name, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    AsyncGenExpr(name, p, b) => if not old-generators then same else {
      let w = wrapped-in-generator(p, b, This(), "__asyncGenerator", true)
      FuncExpr(name, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    AsyncGenMethod(key, p, b) => if not old-generators then same else {
      let w = wrapped-in-generator(p, b, This(), "__asyncGenerator", true)
      Method(key, w.params, w.body) with { lo: n.lo, hi: n.hi }
    }
    _ => same
  }
}

# ---------------------------------------------------------------- for await

# The loop esbuild writes: drive the iterator by hand, and close it however the body ends.
fn for-await(n: Node) -> Node = match n {
  ForOf(_, left, right, body) => {
    let iter = temp()
    let more = temp()
    let cell = temp()
    let failed = temp()
    let source = lowered(right)
    let inner = lowered(body)
    let bound: Node = match left {
      VarLeft(t) => stmt`var $t = $cell.value;`
      LetLeft(t) => stmt`let $t = $cell.value;`
      ConstLeft(t) => stmt`const $t = $cell.value;`
      _ => {
        let target = lowered(left)
        stmt`$target = $cell.value;`
      }
    }
    let start = helper-call("__forAwait", [source])
    let stmts = [bound, inner]
    # `await` is not a word a template can parse: templates are scripts.
    let stepped = Await(exp`$iter.next()`)
    let closed = Await(exp`$cell.call($iter)`)
    stmt`try {
      for ($iter = $start, $more = false, $failed = false; $more = !($cell = $stepped).done; $more = false) {
        $$stmts
      }
    } catch ($cell) {
      $failed = [$cell];
    } finally {
      try {
        $more && ($cell = $iter.return) && $closed;
      } finally {
        if ($failed) throw $failed[0];
      }
    }`
  }
  _ => panic "expected a for-of loop"
}

# ---------------------------------------------------------------- classes

fn class-needs-lowering?(body: Node) -> Bool = any m in body.members.kids:
  m is Field(...) | StaticField(...) | StaticBlock(...) or private-member?(m)

fn inner-member(m: Node) -> Node = match m {
  StaticMethod(x) => x
  _ => m
}

fn private-key(m: Node) -> Text? = match inner-member(m) {
  Field(PrivateName(x), _) | StaticField(PrivateName(x), _) => some(x)
  Method(PrivateName(x), ...) | GenMethod(PrivateName(x), ...) | AsyncMethod(PrivateName(x), ...)
    | AsyncGenMethod(PrivateName(x), ...) | Getter(PrivateName(x), ...) | Setter(PrivateName(x), ...) => some(x)
  _ => none
}

fn private-member?(m: Node) -> Bool = is-some(private-key(m))

fn private-get(o: Node, name: Text) -> Node {
  let p = privates[name] ?? panic "no private name {} in scope", name
  if len(p.getter) > 0 then helper-call("__privateGet", [o, Ident(p.holder), Ident(p.getter)])
  else if len(p.method) > 0 then helper-call("__privateMethod", [o, Ident(p.holder), Ident(p.method)])
  else helper-call("__privateGet", [o, Ident(p.holder)])
}

fn private-set(o: Node, name: Text, value: Node) -> Node {
  let p = privates[name] ?? panic "no private name {} in scope", name
  if len(p.setter) > 0 then helper-call("__privateSet", [o, Ident(p.holder), value, Ident(p.setter)])
  else helper-call("__privateSet", [o, Ident(p.holder), value])
}

fn private-assignment(t: Node, op: Text, v: Node) -> Node = match t {
  Member(o, PrivateName(x)) => {
    let inner = lowered(o)
    let value = lowered(v)
    if op == "=" { return private-set(inner, x, value) }
    let self = if repeatable?(inner) then inner else Ident(temp())
    let first = if repeatable?(inner) then inner else assign(self, inner)
    let read = private-get(first, x)
    match op {
      "||=" => Or(read, private-set(self, x, value))
      "&&=" => And(read, private-set(self, x, value))
      "??=" => coalesced(read, private-set(self, x, value))
      _ => private-set(self, x, compound-value(op, read, value))
    }
  }
  _ => panic "expected a private member"
}

fn compound-value(op: Text, a: Node, b: Node) -> Node = match op {
  "+=" => Add(a, b)
  "-=" => Sub(a, b)
  "*=" => Mul(a, b)
  "/=" => Div(a, b)
  "%=" => Mod(a, b)
  "**=" => if before?(2016) then helper-call("__pow", [a, b]) else Pow(a, b)
  "<<=" => Shl(a, b)
  ">>=" => Shr(a, b)
  ">>>=" => Ushr(a, b)
  "&=" => BitAnd(a, b)
  "|=" => BitOr(a, b)
  "^=" => BitXor(a, b)
  other => panic "unexpected assignment operator {}", other
}

# `this` in a static initializer is the class, and so is the class's own inner name.
fn as-class(n: Node, ref: Node, inner-name: Text) -> Node = as-class-name(this-is(n, ref), ref, inner-name)

everywhere fn this-is(n: Node, ref: Node) -> Node = match n {
  This() => ref
  _ if own-this?(n) => n
}

# A function, arrows aside, has a `this` of its own.
fn own-this?(n: Node) -> Bool = sc.function?(n.kind) and not (n is Arrow(...) | AsyncArrow(...))

# A field's name is evaluated once, when the class is. So a computed one goes in a variable first.
fn field-key(k: Node, setup: mut [Node]) -> Node = match k {
  PropName(x) => string-of(x)
  Str(_) | Num(_) => k
  Computed(e) => {
    let held = Ident(temp())
    setup += assign(held, lowered(e))
    held
  }
  _ => panic "unexpected field name"
}

fn field-init(v: Node) -> Node = if v is None() then undefined-value() else v

record ClassParts { body: Node, before: [Node], after: [Node], statics: [Node] }

fn function-expr-of(m: Node) -> Node = match m {
  Method(_, p, b) | Getter(_, p, b) | Setter(_, p, b) => FuncExpr(None(), p, b)
  GenMethod(_, p, b) => GenExpr(None(), p, b)
  AsyncMethod(_, p, b) => AsyncFuncExpr(None(), p, b)
  AsyncGenMethod(_, p, b) => AsyncGenExpr(None(), p, b)
  _ => panic "expected a method"
}

fn scan-privates(members: [Node], outer: {Text:Private}, setup: mut [Node]) -> {Text:Private} {
  var out: {Text:Private} = {}
  for k in keys(outer) { out[k] = outer[k] ?? panic "lost a private name" }
  var instances = ""
  var static-set = ""
  for m in members {
    if let some(name) = private-key(m) {
      let plain = name[1..len(name)]
      let is-static = m is StaticMethod(_) | StaticField(...)
      match inner-member(m) {
        Field(...) | StaticField(...) => {
          let holder = temp()
          let map-new = NewExpr(Ident("WeakMap"), Args(List()))
          setup += assign(Ident(holder), map-new)
          out[name] = Private(holder: holder, method: "", getter: "", setter: "")
        }
        _ => {
          let set-name = if is-static then static-set else instances
          let holder = if len(set-name) > 0 then set-name else {
            let h = temp()
            let set-new = NewExpr(Ident("WeakSet"), Args(List()))
            setup += assign(Ident(h), set-new)
            h
          }
          if is-static { static-set = holder } else { instances = holder }
          let f = temp()
          let known = out[name] ?? Private(holder: holder, method: "", getter: "", setter: "")
          out[name] = match inner-member(m) {
            Getter(...) => known with { getter: f }
            Setter(...) => known with { setter: f }
            _ => known with { method: f }
          }
        }
      }
    }
  }
  out
}

fn set-holders(members: [Node], table: {Text:Private}, want-static: Bool) -> [Text] {
  [(table[name] ?? panic "lost a private name").holder
   for m in members if let some(name) = private-key(m)
   if not (inner-member(m) is Field(...) | StaticField(...)) and (m is StaticMethod(_)) == want-static
   distinct (table[name] ?? panic "lost a private name").holder]
}

fn lowered-class(body: Node, derived: Bool, inner-name: Text, ref: Node) -> ClassParts {
  let members = body.members.kids
  var setup: [Node] = []
  let table = scan-privates(members, privates, setup)
  var after: [Node] = []
  var statics: [Node] = []
  var fields: [Node] = []
  var kept: [Node] = []
  var constructor: Node? = none
  with privates = table {
    for h in set-holders(members, table, false) {
      fields += ExprStmt(helper-call("__privateAdd", [This(), Ident(h)]))
    }
    for h in set-holders(members, table, true) {
      statics += ExprStmt(helper-call("__privateAdd", [ref, Ident(h)]))
    }
    for m in members {
      match m {
        ClassEmpty() => {}
        Field(PrivateName(x), v) => {
          let p = table[x] ?? panic "lost a private name"
          fields += ExprStmt(helper-call("__privateAdd", [This(), Ident(p.holder), field-init(lowered(v))]))
        }
        Field(key, v) => {
          fields += ExprStmt(helper-call("__publicField", [This(), field-key(key, setup), field-init(lowered(v))]))
        }
        StaticField(PrivateName(x), v) => {
          let p = table[x] ?? panic "lost a private name"
          statics += ExprStmt(helper-call("__privateAdd", [ref, Ident(p.holder), as-class(field-init(lowered(v)), ref, inner-name)]))
        }
        StaticField(key, v) => {
          statics += ExprStmt(helper-call("__publicField", [ref, field-key(key, setup), as-class(field-init(lowered(v)), ref, inner-name)]))
        }
        StaticBlock(b) => {
          let f = Arrow(Params(List()), lowered-function-body(b))
          statics += ExprStmt(CallExpr(as-class(f, ref, inner-name), Args(List())))
        }
        _ => {
          if constructor-method?(m) {
            constructor = some(lowered(m))
          } else if let some(name) = private-key(m) {
            let p = table[name] ?? panic "lost a private name"
            let inner = lowered(inner-member(m))
            let slot = match inner-member(m) {
              Getter(...) => p.getter
              Setter(...) => p.setter
              _ => p.method
            }
            after += as-class-name(ExprStmt(assign(Ident(slot), function-expr-of(inner))), ref, inner-name)
          } else {
            kept += lowered(m)
          }
        }
      }
    }
  }
  var out: [Node] = []
  if len(fields) > 0 or is-some(constructor) {
    out += constructor-with-fields(constructor, fields, derived)
  }
  let whole = out ++ kept
  ClassParts(body: body with { kids: [List(whole...)] }, before: setup, after: after, statics: statics)
}

everywhere fn as-class-name(n: Node, ref: Node, inner-name: Text) -> Node = match n {
  Ident(x) => if len(inner-name) > 0 and x == inner-name then ref else n
}

fn lowered-function-body(b: Node) -> Node {
  with temps = [] { FuncBody(list-of(with-temps(lowered-list(b.stmts.kids), temps))) }
}

fn constructor-method?(m: Node) -> Bool = m is Method(PropName("constructor"), _, _)

fn directive-count(stmts: [Node]) -> Int = len([s for s in stmts while s is ExprStmt(Str(_))])

fn plain-super-at(stmts: [Node]) -> Int? {
  for i in 0..len(stmts) {
    if stmts[i] is ExprStmt(CallExpr(Super(), _)) { return some(i) }
  }
  none
}

everywhere fn calls-super?(n: Node) -> Bool = match n {
  CallExpr(Super(), _) => true
  _ if own-this?(n) => false
}

everywhere fn super-through(n: Node, name: Text) -> Node = match n {
  CallExpr(Super(), args) => CallExpr(Ident(name), super-through(args, name))
  _ if own-this?(n) => n
}

# Fields are set the moment `super()` returns. When that call is a statement of its own they follow
# it. Anywhere else, as in `if (a) super()` or what the minifier made of it, every such call goes
# through an arrow that does both.
fn constructor-with-fields(existing: Node?, fields: [Node], derived: Bool) -> Node = match existing {
  some(Method(key, params, FuncBody(List(ss...)))) => {
    if len(fields) == 0 { return Method(key, params, FuncBody(List(ss...))) }
    if let some(i) = plain-super-at(ss) {
      return Method(key, params, FuncBody(list-of(ss[0..i + 1] ++ fields ++ ss[i + 1..len(ss)])))
    }
    let at = directive-count(ss)
    if not (any x in ss: calls-super?(x)) {
      return Method(key, params, FuncBody(list-of(ss[0..at] ++ fields ++ ss[at..len(ss)])))
    }
    let name = fresh-name("__super")
    let passed = fresh-name("_")
    let inner = [ExprStmt(CallExpr(Super(), Args(List(Spread(Ident(passed))))))] ++ fields ++ [Return(This())]
    let through = Arrow(Params(List(RestParam(BindName(passed)))), FuncBody(list-of(inner)))
    let holder = VarDecl(List(Declarator(BindName(name), through)))
    let rest = [super-through(x, name) for x in ss[at..len(ss)]]
    Method(key, params, FuncBody(list-of(ss[0..at] ++ [holder] ++ rest)))
  }
  none => {
    let calls: [Node] = if derived then [stmt`super(...arguments);`] else []
    let stmts = calls ++ fields
    Method(PropName("constructor"), Params(List()), FuncBody(List(stmts...)))
  }
  _ => panic "expected a constructor"
}

fn class-statements(n: Node) -> [Node] = match n {
  ClassDecl(name, heritage, body) => {
    if not class-needs-lowering?(body) { return [lowered(n)] }
    let parts = lowered-class(body, not (heritage is None()), "", Ident(name.text))
    [ExprStmt(b) for b in parts.before] ++ [ClassDecl(name, lowered(heritage), parts.body) with { lo: n.lo, hi: n.hi }]
    ++ parts.after ++ parts.statics
  }
  _ => panic "expected a class declaration"
}

# `(_a = class { … }, __publicField(_a, "x", 1), _a)`
fn class-expression(n: Node) -> Node = match n {
  ClassExpr(name, heritage, body) => {
    if not class-needs-lowering?(body) { return n with { heritage: lowered(heritage), body: lowered(body) } }
    let holder = Ident(temp())
    let inner-name = if name is BindName(_) then name.text else ""
    let parts = lowered-class(body, not (heritage is None()), inner-name, holder)
    let plain = ClassExpr(name, lowered(heritage), parts.body) with { lo: n.lo, hi: n.hi }
    if len(parts.before) == 0 and len(parts.after) == 0 and len(parts.statics) == 0 { return plain }
    seq(parts.before ++ [assign(holder, plain)] ++ [s.expr for s in parts.after ++ parts.statics] ++ [holder])
  }
  _ => panic "expected a class expression"
}

# ---------------------------------------------------------------- the walk

# A statement list, lowered: one statement may become several.
fn lowered-list(xs: [Node]) -> [Node] = [lowered-item(x)... for x in xs]

fn lowered-item(x: Node) -> [Node] = match x {
  ClassDecl(...) => if before?(2022) then class-statements(x) else [lowered(x)]
  Declarator(t, init) => if before?(2018) and top-rest?(t) then rest-declarators(t, lowered(init), x) else [lowered(x)]
  _ => [lowered(x)]
}

fn check-number(n: Node, t: Text) -> Node {
  if before?(2020) and ends-with(t, "n") {
    panic "big integer literals are not available in the configured target"
  }
  if before?(2021) and contains-text?(t, "_") then Num(replace-all(t, "_", "")) with { lo: n.lo, hi: n.hi } else n
}

fn lowered(n: Node) -> Node = match n {
  Num(t) => check-number(n, t)
  Coalesce(a, b) => if before?(2020) then coalesced(lowered(a), lowered(b)) else generic(n)
  Pow(a, b) => if before?(2016) then helper-call("__pow", [lowered(a), lowered(b)]) else generic(n)
  OptMember(...) | OptIndex(...) | OptCall(...) => if chain-lowers?(n) then chain(n, undefined-value(), false) else generic(n)
  Member(o, PrivateName(x)) => if not before?(2022) then generic(n)
    else if chain-lowers?(n) then chain(n, undefined-value(), false)
    else private-get(lowered(o), x)
  Member(...) | Index(...) | Tagged(...) => if chain-lowers?(n) then chain(n, undefined-value(), false) else generic(n)
  CallExpr(Paren(inner), _) => {
    if chain-lowers?(inner) {
      panic "a parenthesized optional chain being called is not implemented for this target"
    }
    generic(n)
  }
  CallExpr(Member(o, PrivateName(x)), Args(List(args...))) => {
    if not before?(2022) { return generic(n) }
    if chain-lowers?(n) { return chain(n, undefined-value(), false) }
    let inner = lowered(o)
    let self = if repeatable?(inner) then inner else Ident(temp())
    let first = if repeatable?(inner) then inner else assign(self, inner)
    let f = Member(private-get(first, x), PropName("call"))
    let passed = [self] ++ [lowered(a) for a in args]
    CallExpr(f, Args(List(passed...))) with { lo: n.lo, hi: n.hi }
  }
  CallExpr(...) => if chain-lowers?(n) then chain(n, undefined-value(), false) else generic(n)
  Delete(x) => if chain-lowers?(x) then chain(x, True(), true) else generic(n)
  Assignment(t, AssignOp(op), v) => assignment(n, t, op, v)
  In(PrivateName(x), o) => {
    if not before?(2022) { return generic(n) }
    let p = privates[x] ?? panic "no private name {} in scope", x
    helper-call("__privateIn", [Ident(p.holder), lowered(o)])
  }
  PreInc(Member(o, PrivateName(x))) | PreDec(Member(o, PrivateName(x))) | PostInc(Member(o, PrivateName(x))) | PostDec(Member(o, PrivateName(x))) => {
    if not before?(2022) { return generic(n) }
    let p = privates[x] ?? panic "no private name {} in scope", x
    let wrap = helper-call("__privateWrapper", [lowered(o), Ident(p.holder)] ++
                    (if len(p.setter) > 0 or len(p.getter) > 0
                     then [if len(p.setter) > 0 then Ident(p.setter) else undefined-value(),
                           if len(p.getter) > 0 then Ident(p.getter) else undefined-value()]
                     else []))
    n with { kids: [Member(wrap, PropName("_"))] }
  }
  ObjectLit(List(xs...)) => if before?(2018) and (any x in xs: x is SpreadProp(_)) then object-spread(xs) else generic(n)
  Catch(None(), block) => if before?(2019) then Catch(CatchHead(BindName(fresh-name("_"))), lowered(block)) with { lo: n.lo, hi: n.hi } else generic(n)
  ForOf(flag, ...) => if flag is Flag() and before?(2018) then for-await(n) else generic(n)
  ClassExpr(...) => if before?(2022) then class-expression(n) else generic(n)
  List(xs...) => n with { kids: lowered-list(xs) }
  _ => if sc.function?(n.kind) then function-node(n) else generic(n)
}

fn generic(n: Node) -> Node = if len(n.kids) == 0 then n else n with { kids: [lowered(k) for k in n.kids] }

# ---------------------------------------------------------------- helpers

fn helper-definitions() -> [Node] {
  if len(helpers) == 0 { return [] }
  let all-stmts = js.parse(include-text("lower_runtime.js"), "<lower runtime>").body.kids
  let wanted = needed(helpers, {helper-name-of(s): s for s in all-stmts})
  [s for s in all-stmts if helper-name-of(s) in wanted]
}

# These helpers, and those they mention, until none mentions one more.
fn needed(names: [Text], definitions: {Text:Node}) -> [Text] {
  let more = [x for n in names if let some(d) = definitions[n] for x in idents(d)
              if starts-with(x, "__") and not (x in names) distinct x]
  if len(more) == 0 then names else needed(names ++ more, definitions)
}

everywhere fn idents(n: Node) -> [Text] = match n {
  Ident(x) => [x]
}

# Under --minify the helpers get short names like everything else.
everywhere fn shortened(n: Node, short: {Text:Text}) -> Node = match n {
  Ident(x) | BindName(x) => match short[x] {
    some(y) => n with { text: y }
    none => n
  }
  Shorthand(Ident(x)) => match short[x] {
    some(y) => Prop(PropName(x), Ident(y))
    none => n
  }
}

fn helper-name-of(s: Node) -> Text = s.declarators.kids[0].target.text

# A program for an older target. `names` is every name already in use.
fn run(program: Node, year: Int, names: [Text], minify: Bool) -> Node {
  if year >= no-lowering { return program }
  if year < 2015 { panic "the configured target is older than esbuild supports: es{}", year }
  target = year
  taken = {x: true for x in names}
  next-temp = 0
  with temps = [], helpers = [] {
    let stmts = lowered-list(program.body.kids)
    let defs = helper-definitions()
    let plain = Program(program.hashbang, List((defs ++ with-temps(stmts, temps))...))
    if not minify then plain else shortened(plain, {helper-name-of(d): fresh-name("$") for d in defs})
  }
}
