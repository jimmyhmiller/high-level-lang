# JSON as RFC 8259 has it, and nothing more: what a module imported `with { type: "json" }` must
# be. (bundle.package reads package.json and tsconfig.json, which allow comments and trailing commas.)
syntax
start Doc
space Space
word WordChar

# A byte order mark may start the file: the browser's decoding drops it before parsing.
fragment Space = "﻿"? [ \t\n\r]* ;
fragment WordChar = [a-z] ;
fragment Hex = [0-9a-fA-F] ;
token Str = "\"" ("\\" ["\\/bfnrt] | "\\u" Hex Hex Hex Hex | [^"\\\x00-\x1f])* "\"" ;
token Num = "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+\-]? [0-9]+)? ;

rule Doc = Value ;
rule Value
  = Str | Num
  | "true" -> True
  | "false" -> False
  | "null" -> Null
  # No trailing comma: `X,+` takes none, and an empty array or object is a form of its own.
  | "[" "]" -> EmptyArray
  | "[" Value,+ "]" -> Array(items)
  | "{" "}" -> EmptyObject
  | "{" Member,+ "}" -> Object(members)
  ;
rule Member = Str ":" Value -> Member(key, value) ;
