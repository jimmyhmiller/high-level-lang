# What a build gives lint rules (bundle.lint): its own relations, by name, as text. A statement is
# known as the ledger knows it (bundle.ledger: its module and what it declares), a module by its
# path, a route by its root's path; numbers are written out. What each relation holds is read
# from what the build made: the ledger's routes and bytes, and linking's database, which says what
# each statement needs and why it is kept. And `code`: JavaScript patterns, read by js.syntax and
# matched against every statement of every module.
rules bundle.shipped over bundle.js
use bundle.js as js
use bundle.made as mk
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.link as link
use bundle.ledger as l
use bundle.analyze as analyze
use bundle.sourcemap as map
use bundle.resolve as res
use bundle.package as pkg

# A relation the build gives: its name, its columns, and what a row says.
record Relation { name: Text, columns: [Text], about: Text }

fn relations() -> [Relation] = [
  Relation(name: "route", columns: ["root"], about: "an entry, or what an `import()` names, which loads files of its own"),
  Relation(name: "entry", columns: ["root"], about: "a route that is an entry"),
  Relation(name: "lazy", columns: ["root"], about: "a route an `import()` starts"),
  Relation(name: "route-bytes", columns: ["root", "bytes"], about: "how many bytes a route loads before it runs"),
  Relation(name: "ships", columns: ["root", "statement"], about: "a route loads the statement's code"),
  Relation(name: "bytes", columns: ["root", "statement", "bytes"], about: "how many of a route's bytes are the statement's"),
  Relation(name: "reaches", columns: ["root", "statement"], about: "the route needs the statement: from its root, by what statements read (not what was only packed with it)"),
  Relation(name: "live", columns: ["statement"], about: "the statement is in the output"),
  Relation(name: "effect", columns: ["statement"], about: "the statement stays for what it does as its module loads"),
  Relation(name: "statement", columns: ["statement", "module", "line"], about: "a statement of a module, and the line it starts on (0: what the bundler wrote for the module)"),
  Relation(name: "needs", columns: ["statement", "other", "name"], about: "the statement reads a name the other declares, in its module or through an import"),
  Relation(name: "reads", columns: ["statement", "module", "name"], about: "the statement reads an export of a module by name"),
  Relation(name: "reads-whole", columns: ["statement", "module"], about: "the statement reads a module's namespace object, which holds all its exports"),
  Relation(name: "exports", columns: ["module", "name"], about: "a module exports a name"),
  Relation(name: "module", columns: ["module"], about: "a module of the build"),
  Relation(name: "kind", columns: ["module", "kind"], about: "esm, commonjs, runtime or other"),
  Relation(name: "size", columns: ["module", "bytes"], about: "the module's source, in bytes"),
  Relation(name: "package", columns: ["module", "package", "dir"], about: "a module of an installed package, and the directory of the copy it is in"),
  Relation(name: "imports", columns: ["module", "target"], about: "a module imports (or requires) another"),
  Relation(name: "loads", columns: ["module", "target"], about: "a module loads another with `import()`"),
  Relation(name: "dependency", columns: ["package"], about: "a package ./package.json lists under dependencies"),
  Relation(name: "dev-dependency", columns: ["package"], about: "a package ./package.json lists under devDependencies"),
  Relation(name: "platform", columns: ["platform"], about: "browser or node"),
  Relation(name: "object", columns: ["statement"], about: "a statement that gives a name an object literal whose properties nothing reads may go"),
  Relation(name: "object-read-whole", columns: ["reader", "statement"], about: "a live statement reads an object (`object`) other than by a property's name, so all of it stays"),
  Relation(name: "prop-kept", columns: ["statement", "name"], about: "an object's property that may go, and stays: something reads it, or the object whole"),
  Relation(name: "code", columns: ["statement", "pattern"], about: "a statement holds code the JavaScript pattern matches; each `$X` binds X, `$_` matches anything, `$$X` any number of list items")
]

# What the build is: its ledger, and whether it runs on node.
record Build { ledger: l.Ledger, node: Bool, fix: Bool }

fn module-key(id: Int) -> Text = l.module-key(id)

fn rows-of(name: Text, b: Build) -> [[Text]] = match name {
  "route" => [[r.root] for r in x.routes]
  "entry" => [[module-key(id)] for id in m.entries]
  "lazy" => [[r.root] for r in x.routes if not (r.root in entries)] where entries = [module-key(id) for id in m.entries]
  "route-bytes" => [[r.root, int-text(r.bytes)] for r in x.routes]
  "ships" => [[r.root, x.parts[k].key] for r in x.routes for k in r.parts]
  "bytes" => [[r.root, x.parts[r.parts[i]].key, int-text(r.bytes-of[i])] for r in x.routes for i in 0..len(r.parts)]
  "reaches" => match an.linking.splitting {
    true => [[module-key(r), parts[p] ?? ""] for m.db.reaches(?r, ?p) if p in parts]
    false => [[module-key(m.entry), parts[p] ?? ""] for m.db.active-part(?p) if p in parts]
  }
  "live" => [[parts[p] ?? ""] for m.db.active-part(?p) if p in parts]
  "effect" => [[parts[p] ?? ""] for m.db.effect(?p) if p in parts]
  "statement" => [[p.key, p.module, int-text(p.line)] for p in x.parts]
  "needs" => [[parts[p] ?? "", parts[q] ?? "", sym.symbol-at(m.table, s).name] for row in reading() for p in [row.part] for s in [row.symbol]
              for q in declarers(s) if p in parts and q in parts distinct int-text(p) ++ " " ++ int-text(q) ++ " " ++ int-text(s)]
  "reads" => [[parts[p] ?? "", module-key(d), name-of(m.names, n)] for m.db.via(?p, ?d, ?n) if p in parts]
  "reads-whole" => [[parts[p] ?? "", module-key(mo)] for m.db.ns-symbol(?mo, ?s) for row in reading() if row.symbol == s for p in [row.part] if p in parts
                    distinct int-text(p) ++ " " ++ int-text(mo)]
  "exports" => [[module-key(mo), name-of(m.names, n)] for m.db.exported(?mo, ?n) distinct int-text(mo) ++ " " ++ int-text(n)]
  "module" => [[module-key(id)] for id in m.order]
  "kind" => [[module-key(id), analyze.kind-name(m.modules[id])] for id in m.order]
  "size" => [[module-key(id), int-text(len(l.source-of(id)))] for id in m.order]
  "package" => [[module-key(id), name, dir] for id in m.order for path in [module-key(id)] for at in [last-index-of(path, "node_modules/")]
                if let some(i) = at for name in [analyze.package-of(path)] if name != "" for dir in [path[0..i + 13] ++ name]]
  "imports" => [[module-key(a), module-key(d)] for m.db.imports(?a, ?d) distinct int-text(a) ++ " " ++ int-text(d)]
  "loads" => [[module-key(id), module-key(x.target)] for id in m.order for x in an.module-link(id).loads if x.by-import
              distinct int-text(id) ++ " " ++ int-text(x.target)]
  "dependency" => [[k] for k in package-keys("dependencies")]
  "dev-dependency" => [[k] for k in package-keys("devDependencies")]
  "platform" => [[if b.node then "node" else "browser"]]
  "object" => [[parts[p] ?? ""] for m.db.object-literal(_, ?p) if p in parts distinct p]
  "object-read-whole" => [[parts[q] ?? "", parts[p] ?? ""] for m.db.whole-path(?q, ?o) if m.db.live(q) for m.db.object-literal(o, ?p)
                          if q in parts and p in parts distinct int-text(q) ++ " " ++ int-text(p)]
  "prop-kept" => [[parts[p] ?? "", name-of(m.names, k)] for m.db.kept-prop(?o, ?k) for m.db.object-literal(o, ?p) if p in parts]
  _ => panic "shipped: no relation {}", name
} where x = b.ledger,
        parts = l.part-keys()

# Every statement's read of a symbol: what it mentions, and what reading an import resolves to.
record Reading { part: Int, symbol: Int }

fn reading() -> [Reading] =
  [Reading(part: p, symbol: s) for m.db.mentions(?p, ?s)] ++ [Reading(part: p, symbol: s) for m.db.uses(?p, ?s)]
  ++ [Reading(part: p, symbol: s) for m.db.prop-reads(?p, ?s)]

# The statements that declare a symbol, or hold it (an import variable of CommonJS's).
fn declarers(s: Int) -> [Int] = [q for m.db.declares(?q, s)] ++ [q for m.db.cjs-binding(s, ?q)]

# The names a member of ./package.json lists.
fn package-keys(member: Text) -> [Text] = match res.package-doc(".") {
  none => []
  some(doc) => match res.member(doc, member) {
    some(pkg.Object(List(ms...))) => [unquote(x.key.text) for x in ms]
    _ => []
  }
}

# ---------------------------------------------------------------- code

# A pattern's variables, in the order they come: `$X` is X; `$_`, and `$$X` in a list, bind nothing.
fn pattern-variables(pattern: Text, label: Text) -> [Text] = [v for v in metas(pattern-node(pattern, label)) distinct v]

everywhere fn metas(n: Node) -> [Text] = match n {
  _ if len(n.kids) == 0 and starts-with(n.text, "$") and not starts-with(n.text, "$$") and n.text != "$_" => [n.text[1..len(n.text)]]
}

# A pattern, read by js.syntax: the expression a statement of one expression holds, or else the statement.
fn pattern-node(pattern: Text, label: Text) -> Node = match js.parse(pattern ++ ";", label).body.kids {
  [ExprStmt(x)] => x
  [s] => s
  _ => fail-build(label ++ ": a pattern is one expression or one statement")
}

# Each statement of each module, every place in it the pattern matches: the statement, the place
# (`path:line`), and the value of each of the pattern's variables, in `pattern-variables` order.
fn code-rows(pattern: Text, label: Text) -> [[Text]] =
  [[parts[p] ?? "", module-key(id) ++ ":" ++ int-text(line-of(hit.node, lines))] ++ [value-of(hit.bound, v) for v in names]
   for id in m.order if m.modules[id].kind == m.Esm or m.modules[id].kind == m.Cjs
   for text in [l.source-of(id)] for lines in [map.line-starts(text)]
   for p in e.parts-of(id) if p in parts for s in [an.stmt-of(id, p)] if not (s is None() or s is Flag())
   for hit in hits(s, pat, text)]
  where pat = pattern-node(pattern, label),
        names = pattern-variables(pattern, label),
        parts = l.part-keys()

# What a pattern's variable is: its value as rules read it (a name, a string's value, else the code
# as written), and the nodes it matched: one for `$X`, the rest of a list for `$$X`.
record Bound { name: Text, value: Text, nodes: [Node], rest: Bool }
record Hit { node: Node, bound: [Bound] }

fn value-of(bound: [Bound], name: Text) -> Text = (first b in bound if b.name == name: b.value) ?? panic "code: {} is bound by no match", name

# Everywhere in `n` the pattern matches, outermost first.
fn hits(n: Node, pat: Node, text: Text) -> [Hit] =
  [Hit(node: n, bound: b) for found in [unified(pat, n, text, [])] if let some(b) = found]
  ++ [h for k in n.kids for h in hits(k, pat, text)]

fn at(lo: Int) -> Int = lo % map.module-unit

# The line a node is on; 0 for one a transform made, which is on none.
fn line-of(n: Node, lines: [Int]) -> Int = if mk.made?(n) then 0 else map.line-at(lines, at(n.lo)) + 1

# The bindings under which the pattern `p` is the node `t`, if any: a variable is anything (the same
# each time it comes), and else the two have the same kind, the same text and children alike.
fn unified(p: Node, t: Node, text: Text, b: [Bound]) -> [Bound]? = match meta?(p) {
  true if p.text == "$_" => some(b)
  true => match first x in b if x.name == name: x.value {
    some(v) if v == found => some(b)
    some(_) => none
    none => some(b ++ [Bound(name: name, value: found, nodes: [t], rest: false)])
  } where name = p.text[1..len(p.text)],
          found = shown(t, text)
  false if p.kind != t.kind or p.text != t.text => none
  false => kids-unified(p.kids, t.kids, text, b)
}

fn meta?(p: Node) -> Bool = len(p.kids) == 0 and starts-with(p.text, "$") and not starts-with(p.text, "$$")

fn rest?(p: Node) -> Bool = len(p.kids) == 0 and starts-with(p.text, "$$")

# Children alike, in order; `$$X` last in a pattern's list is all the rest, however many.
fn kids-unified(ps: [Node], ts: [Node], text: Text, b: [Bound]) -> [Bound]? = match ps, ts {
  [], [] => some(b)
  [r], _ if rest?(r) => some(b ++ [Bound(name: r.text[2..len(r.text)], value: span-text(ts, text), nodes: ts, rest: true) for x in [0] if r.text != "$$_"])
  [p, more...], [t, rest...] => match unified(p, t, text, b) {
    some(next) => kids-unified(more, rest, text, next)
    none => none
  }
  _, _ => none
}

# The code nodes cover, as written: from the first's start to the last's end.
fn span-text(ns: [Node], text: Text) -> Text = match ns {
  [] => ""
  _ if any n in ns: mk.made?(n) => join([mk.code(n) for n in ns], ", ")
  _ => text[from..max(from, min(at(last(ns).hi), len(text)))] where from = min(at(ns[0].lo), len(text))
}

# What a variable is bound to: a string's value, a name, or else the code as written.
fn shown(t: Node, text: Text) -> Text = match t {
  Str(_) => unquote(t.text)
  _ if len(t.kids) == 0 and len(t.text) > 0 => t.text
  _ if mk.made?(t) => mk.code(t)
  _ => trim(text[from..max(from, min(at(t.hi), len(text)))]) where from = min(at(t.lo), len(text))
}

# ---------------------------------------------------------------- rewrites and fixes

# A pattern's variables of either kind, `$X` and `$$X`: what a template may put in.
fn bindable(pattern: Text, label: Text) -> [Text] = [v for v in all-metas(pattern-node(pattern, label)) distinct v]

everywhere fn all-metas(n: Node) -> [Text] = match n {
  _ if len(n.kids) == 0 and starts-with(n.text, "$$") and n.text != "$$_" => [n.text[2..len(n.text)]]
  _ if len(n.kids) == 0 and starts-with(n.text, "$") and n.text != "$_" => [n.text[1..len(n.text)]]
}

# Whether a pattern matches anywhere in a tree.
fn anywhere?(n: Node, pat: Node, text: Text) -> Bool = is-some(unified(pat, n, text, [])) or (any k in n.kids: anywhere?(k, pat, text))

# A template with its variables put in: `$X` the node X matched, `$$X` in a list the nodes it
# matched there. Every node the template itself makes is placed where the code it replaces was, so
# a source map, and what each statement holds, still say where it came from.
fn instantiated(t: Node, bound: [Bound], at-node: Node) -> Node = match meta?(t) {
  true => (first b in bound if b.name == t.text[1..len(t.text)] and not b.rest: b.nodes[0]) ?? panic "rewrite: the template's {} is bound by nothing", t.text
  false => t with { kids: [k for c in t.kids for k in spliced(c, bound, at-node)], lo: at-node.lo, hi: at-node.hi }
}

fn spliced(c: Node, bound: [Bound], at-node: Node) -> [Node] = match rest?(c) {
  true => (first b in bound if b.name == c.text[2..len(c.text)] and b.rest: b.nodes) ?? panic "rewrite: the template's {} is bound by nothing", c.text
  false => [instantiated(c, bound, at-node)]
}

# An edit to a file's text: what is from `from` to `to` becomes `text`.
record Edit { path: Text, from: Int, to: Int, text: Text }

# The edits a fix makes to a statement (a part's key): each place in it the pattern matches becomes
# the template, its variables put in as their code is written. An empty template takes the code out:
# a statement, or the statement an expression is all of, with its line when it is all the line has.
# A package's files are not the project's to fix.
fn fix-edits(part: Text, pattern: Text, template: Text, label: Text) -> [Edit] = match ids[part] {
  none => []
  some(p) => [e for id in [mo for m.db.part-of(p, ?mo)] if not contains-text?(m.modules[id].path, "node_modules/")
              for text in [l.source-of(id)] for s in [an.stmt-of(id, p)] if not (s is None() or s is Flag())
              for hit in fix-hits(s, pat, text, empty)
              for e in [edit-of(m.modules[id].path, text, hit, template, empty)]]
} where ids = {k: i for i in keys(l.part-keys()) for k in [l.part-keys()[i] ?? ""]},
        pat = pattern-node(pattern, label),
        empty = trim(template) == ""

# Where a fix's pattern matches: outermost first, and an expression statement as a whole when the
# template takes the expression out.
fn fix-hits(n: Node, pat: Node, text: Text, empty: Bool) -> [Hit] = match n, empty {
  ExprStmt(x), true if is-some(unified(pat, x, text, [])) => [Hit(node: n, bound: unified(pat, x, text, []) ?? [])]
  _, _ => match unified(pat, n, text, []) {
    some(b) => [Hit(node: n, bound: b)]
    none => [h for k in n.kids for h in fix-hits(k, pat, text, empty)]
  }
}

fn edit-of(path: Text, text: Text, hit: Hit, template: Text, empty: Bool) -> Edit = match empty {
  _ if mk.made?(hit.node) => fail-build("fix: the pattern matches code a transform made in " ++ path ++ " (" ++ mk.code(hit.node) ++ "), which is not in the file to edit")
  true => Edit(path: path, from: whole.from, to: whole.to, text: "") where whole = line-span(text, at(hit.node.lo), at(hit.node.hi))
  false => Edit(path: path, from: at(hit.node.lo), to: at(hit.node.hi), text: filled-template(template, hit.bound, text))
}

record Cut { from: Int, to: Int }

# What taking out from `from` to `to` takes: its line too, when nothing else is on it.
fn line-span(text: Text, from: Int, to: Int) -> Cut = match blank?(text[start..from]) and blank?(text[to..end]) {
  true => Cut(from: start, to: min(end + 1, len(text)))
  false => Cut(from: from, to: to)
} where start = (last-index-of(text[0..from], "\n") ?? -1) + 1,
        end = to + ((index-of(text[to..len(text)], "\n")) ?? (len(text) - to))

fn blank?(t: Text) -> Bool = trim(t) == "" or trim(t) == ";"

# A template's text with each variable's code as written: `$$X` first, then the longer names first,
# so `$X` is not taken out of `$XY`.
fn filled-template(template: Text, bound: [Bound], text: Text) -> Text = replace-many(template, [w for w in whats], [b for b in bys])
  where ordered = sort b in bound by 0 - len(b.name) - (if b.rest then 1000 else 0),
        whats = [(if b.rest then "$$" else "$") ++ b.name for b in ordered],
        bys = [span-text(b.nodes, text) for b in ordered]

# Edits made to each file, last first, those that would overlap one made already left out.
record Fixed { path: Text, text: Text, made: Int }

fn fixed-files(edits: [Edit]) -> [Fixed] =
  [Fixed(path: path, text: applied-edits(read-file(path), chosen), made: len(chosen))
   for path in [e.path for e in edits distinct e.path]
   for chosen in [kept-edits(sort e in [e for e in edits if e.path == path distinct int-text(e.from) ++ " " ++ int-text(e.to)] by 0 - e.from)]]

fn kept-edits(es: [Edit]) -> [Edit] = fold kept = [] for e in es: if (any k in kept: e.to > k.from) then kept else kept ++ [e]

fn applied-edits(text: Text, es: [Edit]) -> Text = fold t = text for e in es: t[0..e.from] ++ e.text ++ t[e.to..len(t)]
