# Code a transform makes, put among a module's own: parsed from text, and each node of it given an
# offset of its own, below every offset the module's nodes have, so scope analysis (which knows a
# name by its offset) tells every made name from every other.
rules bundle.made over bundle.js
use bundle.js as js

# A statement made, every node of it not yet given a place.
fn made(text: Text) -> Node = unplaced-all(js.parse(text, "<made>").body.kids[0])

# An expression made, likewise.
fn made-expression(text: Text) -> Node = match made(text ++ ";") {
  ExprStmt(e) => e
  _ => panic "bundle.made: {} is not an expression", text
}

fn unplaced-all(n: Node) -> Node = n with { lo: unplaced, hi: unplaced, kids: [unplaced-all(k) for k in n.kids] }

const unplaced: Int = -1999999999

# Whether a transform made the node: its offset is below every offset a file's nodes have, so it is
# at no place in its file's text, and what it says is its printing (`code`).
fn made?(n: Node) -> Bool = n.lo < 0

fn code(n: Node) -> Text = js.render-tracked(n, false, false).text

# The lowest offset the tree has: made nodes go below it, where no other node is.
fn lowest(n: Node) -> Int = fold low = min(n.lo, -500000000) for k in n.kids: min(low, lowest(k))

# Scope analysis knows a name by its offset, so every node made here takes an offset of its own,
# counting down from `next` in the order a walk meets them; the nodes the module had keep theirs.
record Placed { node: Node, next: Int }
record Placing { nodes: [Node], next: Int }

# A program with what was made in it placed.
fn placed-program(tree: Node) -> Node = placed(tree, lowest(tree) - 1).node

fn placed(n: Node, next: Int) -> Placed = match n.lo == unplaced {
  true => kids-placed(n with { lo: next, hi: next }, next - 1)
  false => kids-placed(n, next)
}

fn kids-placed(n: Node, next: Int) -> Placed = match n.kids {
  [] => Placed(node: n, next: next)
  kids => Placed(node: n with { kids: all.nodes }, next: all.next)
    where all = fold a = Placing(nodes: [], next: next) for k in kids:
                  (a with { nodes: a.nodes ++ [q.node], next: q.next } where q = placed(k, a.next))
}
