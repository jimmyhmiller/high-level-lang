# tsconfig.json and jsconfig.json: the settings a TypeScript project gives its files. Comments and
# trailing commas are allowed, and `extends` builds one on another.
rules bundle.tsconfig over bundle.package
use bundle.package as pkg
use bundle.resolve as res

record PathRule { pattern: Text, targets: [Text], base: Text }

record Config {
  path: Text,
  jsx: Text,
  jsx-factory: Text,
  jsx-fragment: Text,
  jsx-import-source: Text,
  define-fields: Text,   # "true", "false", or "" for what `target` implies
  target: Text,
  base-url: Text,        # already joined to its file's directory
  paths: [PathRule],
  paths-base: Text,
  verbatim: Bool,
  decorators: Bool
}

fn none-config() -> Config =
  Config(path: "", jsx: "", jsx-factory: "", jsx-fragment: "", jsx-import-source: "", define-fields: "",
         target: "", base-url: "", paths: [], paths-base: "", verbatim: false, decorators: false)

# A config named on the command line, which then governs every file; empty when there is none.
setting forced: Text

fn member(object: pkg.Node, key: Text) -> pkg.Node? = match object {
  pkg.Object(List(ms...)) => first m in ms if unquote(m.key.text) == key: m.value
  _ => none
}

fn text-of(v: pkg.Node?) -> Text = match v {
  some(pkg.Str(raw)) => unquote(raw)
  _ => ""
}

fn flag-of(v: pkg.Node?) -> Text = match v {
  some(pkg.True()) => "true"
  some(pkg.False()) => "false"
  _ => ""
}

fn joined(dir: Text, rel: Text) -> Text = match rel {
  "/" ++ _ => rel
  _ => path-normalize(dir ++ "/" ++ rel)
}

# What `extends` names: a file beside this one, or one in a package.
fn extended-path(spec: Text, from: Text) -> Text =
  extended(spec, dir-of(from)) ?? panic "{}: cannot find the tsconfig it extends, {}", from, spec

# Beside this file, as written or with `.json`; or in the nearest package that has it, as a file
# and not a package's own directory.
fn extended(spec: Text, dir: Text) -> Text? = match spec {
  "./" ++ _ | "../" ++ _ | "/" ++ _ => first c in [joined(dir, spec), joined(dir, spec) ++ ".json"] if file-exists?(c): c
  _ => first d in path-ancestors(dir) for c in package-config-candidates(res.in-dir(d, "node_modules/" ++ spec))
         if file-exists?(c) and not file-exists?(c ++ "/package.json"): c
}

fn package-config-candidates(c: Text) -> [Text] = [c, c ++ ".json", c ++ "/tsconfig.json"]

fn either(a: Text, b: Text) -> Text = match a {
  "" => b
  _ => a
}

fn path-targets(value: pkg.Node) -> [Text] = match value {
  pkg.Array(List(ts...)) => [unquote(t.text) for t in ts if t is pkg.Str(_)]
  _ => []
}

# The file's settings over those of what it extends.
fn config-at(path: Text) -> Config = layered(extended-base(doc, path), own-config(path, opts))
  where doc = pkg.parse(read-file(path), path),
        opts = member(doc, "compilerOptions") ?? pkg.Object(List())

# What `extends` names: one config, or several, each over the one before.
fn extended-base(doc: pkg.Node, path: Text) -> Config = match member(doc, "extends") {
  some(pkg.Str(raw)) => config-at(extended-path(unquote(raw), path))
  some(pkg.Array(List(items...))) =>
    fold b = none-config() for item in items if item is pkg.Str(_): layered(b, config-at(extended-path(unquote(item.text), path)))
  _ => none-config()
}

fn own-config(path: Text, opts: pkg.Node) -> Config =
  Config(path: path,
    jsx: text-of(member(opts, "jsx")),
    jsx-factory: text-of(member(opts, "jsxFactory")),
    jsx-fragment: text-of(member(opts, "jsxFragmentFactory")),
    jsx-import-source: text-of(member(opts, "jsxImportSource")),
    define-fields: flag-of(member(opts, "useDefineForClassFields")),
    target: text-of(member(opts, "target")),
    base-url: match text-of(member(opts, "baseUrl")) { "" => ""  raw => joined(dir-of(path), raw) },
    paths: rules,
    paths-base: match rules { [] => ""  _ => dir-of(path) },
    verbatim: flag-of(member(opts, "verbatimModuleSyntax")) == "true"
              or flag-of(member(opts, "preserveValueImports")) == "true"
              or text-of(member(opts, "importsNotUsedAsValues")) == "preserve",
    decorators: flag-of(member(opts, "experimentalDecorators")) == "true")
  where rules = match member(opts, "paths") {
    some(pkg.Object(List(entries...))) => [PathRule(pattern: unquote(e.key.text), targets: path-targets(e.value), base: "") for e in entries]
    _ => []
  }

# Each setting the file gives, or else what it extends gives.
fn layered(base: Config, mine: Config) -> Config =
  Config(path: either(mine.path, base.path),
         jsx: either(mine.jsx, base.jsx),
         jsx-factory: either(mine.jsx-factory, base.jsx-factory),
         jsx-fragment: either(mine.jsx-fragment, base.jsx-fragment),
         jsx-import-source: either(mine.jsx-import-source, base.jsx-import-source),
         define-fields: either(mine.define-fields, base.define-fields),
         target: either(mine.target, base.target),
         base-url: either(mine.base-url, base.base-url),
         paths: paths-from.paths,
         paths-base: paths-from.paths-base,
         verbatim: mine.verbatim or base.verbatim,
         decorators: mine.decorators or base.decorators)
  where paths-from = match mine.paths { [] => base  _ => mine }

fn inside-packages?(path: Text) -> Bool = contains-text?(path, "node_modules/")

# The config governing a file: the nearest tsconfig.json or jsconfig.json above it. A package's own
# files are not the project's to configure.
fn for-file(path: Text) -> Config = match forced {
  "" if inside-packages?(path) => none-config()
  "" => config-of-dir(dir-of(path))
  _ => config-of-file(forced)
}

fn config-of-file(path: Text) -> Config = config-at(path)

fn config-of-dir(dir: Text) -> Config =
  (first f in [res.in-dir(dir, "tsconfig.json"), res.in-dir(dir, "jsconfig.json")] if file-exists?(f): config-at(f))
  ?? match dir {
    "." | "/" | "" => none-config()
    _ => config-of-dir(dir-of(dir))
  }

const older-targets: [Text] = ["es3", "es5", "es6", "es2015", "es2016", "es2017", "es2018", "es2019", "es2020", "es2021"]

# Class fields have define semantics unless the config turns them off, or targets an older JavaScript.
fn define-fields?(c: Config) -> Bool = match c.define-fields, c.target {
  "true", _ => true
  "false", _ => false
  _, "" => true
  _, t => not (ascii-lower(t) in older-targets)
}

# `paths`: the pattern with the longest prefix before its `*` wins, the first of those, and its
# targets are tried in order.
fn path-candidates(c: Config, spec: Text) -> [Text] =
  [joined(either(c.base-url, c.paths-base), replace-all(t, "*", pm.star)) for pm in best for t in c.paths[pm.at].targets]
  where matches = [pm for i in 0..len(c.paths) if let some(pm) = path-match(c.paths[i].pattern, i, spec)],
        longest = fold top = -1 for pm in matches: max(top, pm.prefix),
        best = first pm in matches if pm.prefix == longest: pm

# A pattern that matches: which it is, how long its part before any `*` is, and what the `*` stands for.
record PathMatch { at: Int, prefix: Int, star: Text }

fn path-match(p: Text, at: Int, spec: Text) -> PathMatch? = match last-index-of(p, "*") {
  none if p == spec => some(PathMatch(at: at, prefix: len(p), star: ""))
  some(cut) if starts-with(spec, p[0..cut]) and ends-with(spec, p[cut + 1..len(p)]) and len(spec) >= len(p) - 1 =>
    some(PathMatch(at: at, prefix: cut, star: spec[cut..len(spec) - (len(p) - cut - 1)]))
  _ => none
}
