# Code splitting: which chunk each file is in, what chunks import from each other, and the
# file each one ends up as. The statements each root reaches come from link.facts.
rules bundle.chunks over bundle.js
use bundle.js as js
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.minhost as host
use bundle.fragments as fragments
use bundle.chunking as packing
use hl.graph as graph

boxed record Chunk {
  id: Int,
  key: Text,
  root: Int,          # the module this chunk is the entry for, or -1 for a shared chunk
  roots: [Int],       # every root that needs it
  parts: {Int:Bool},
  initializers: {Int:Bool},
  needs: {Int:[Text]} # from which other chunk, which names
}

fn key-of(roots: [Int]) -> Text = join([int-text(r) ++ "," for r in roots], "")

fn root-at(roots: [Int], i: Int) -> Int = match i {
  _ if i < len(roots) => roots[i]
  _ => -1
}

# All policies use the same placement engine. Whole modules and semantic fragments differ only
# in the units supplied to the selected function; policy names have no semantic role here.
fn configured(roots: [Int], options: packing.Options) -> [Chunk] =
  planned(roots, fragments.model(options.fragments), options)

fn planned(roots: [Int], model: fragments.Model, options: packing.Options) -> [Chunk] =
  finalized(roots, model, stable-groups(checked-groups(model.units, proposed), model))
  where pack = options.pack, proposed = pack(model.units, options.limits)

# A policy proposes ownership, not new semantics. Every unit has exactly one home and an
# effectful unit cannot gain consumers (which would execute it before the program requested it).
fn checked-groups(units: [fragments.Unit], groups: [packing.Group]) -> [packing.Group] {
  var assigned = [false for u in units]
  var names: {Text:Bool} = {}
  for g in groups {
    if len(g.units) == 0 { panic "chunk policy returned an empty group {}", g.key }
    if g.key in names { panic "chunk policy returned duplicate group key {}", g.key }
    names[g.key] = true
    for id in g.units {
      if id < 0 or id >= len(units) { panic "chunk policy returned unknown unit {}", id }
      if assigned[id] { panic "chunk policy placed unit {} more than once", id }
      assigned[id] = true
    }
    let consumers = packing.consumers(packing.roots(g, units))
    for id in g.units {
      if not units[id].portable and packing.consumers(units[id].roots) != consumers {
        panic "chunk policy would eagerly evaluate {} for a new consumer", units[id].path
      }
    }
  }
  if not (all found in assigned: found) { panic "chunk policy left a unit without a home" }
  groups
}

# Regrouping can introduce cycles even when the original unit graph is acyclic. Collapse those
# groups, preserve original statement order, and check the resulting evaluation demand again.
fn stable-groups(groups: [packing.Group], model: fragments.Model) -> [packing.Group] =
  checked-groups(model.units, [merged-group([groups[i] for i in bucket], model.units)
                              for bucket in graph.buckets(graph.components(edges))])
  where owner = {id: i for i in 0..len(groups) for id in groups[i].units},
        edges = [[to for id in groups[i].units for dep in model.edges[id] for to in owner[dep]
                     if to != i distinct to] for i in 0..len(groups)]

# What a chunk needs from the others is its own work: every chunk's is found at once.
record Needing { chunk: Chunk, group: packing.Group?, edges: [[Int]], unit-homes: {Int:Int}, homes: {Int:Int} }

fn with-needs(n: Needing) -> Chunk =
  n.chunk with { needs: evaluation-needs(n.chunk.id, n.group, n.edges, n.unit-homes) ++ needs-of(n.chunk, n.homes) }

fn merged-group(groups: [packing.Group], units: [fragments.Unit]) -> packing.Group =
  packing.Group(key: key, units: sort id in [id for g in groups for id in g.units] by id)
  where combined = packing.Group(key: "", units: [id for g in groups for id in g.units]),
        own = packing.consumers(packing.roots(combined, units)),
        key = if any g in groups: g.key == own then own else groups[0].key

# An entry file is an evaluation facade. It may also contain its implementation only when no
# other implementation chunk imports that group. Otherwise importing all of the entry's pieces
# would introduce a facade cycle and run consumers before its var-based definitions exist.
fn finalized(roots: [Int], model: fragments.Model, groups: [packing.Group]) -> [Chunk] =
  parallel-map([Needing(chunk: c, group: by-key[c.key], edges: model.edges, unit-homes: unit-homes, homes: homes) for c in placed],
               with-needs, an.linking.facts-threads)
  where own = {key-of([r]): true for r in roots},
        unit-groups = {id: g.key for g in groups for id in g.units},
        imported = {unit-groups[dep] ?? "": true for u in model.units for dep in model.edges[u.id]
                    if (unit-groups[dep] ?? "") != (unit-groups[u.id] ?? "")},
        detached = {g.key: true for g in groups if g.key in own and g.key in imported},
        group-keys = [if key-of([r]) in detached then "entry:" ++ key-of([r]) else key-of([r]) for r in roots]
                     ++ [g.key for g in groups if not (g.key in own) or g.key in detached],
        by-key = {g.key: g for g in groups},
        placed = [placed-group(i, group-keys[i], root-at(roots, i), model.units, by-key[group-keys[i]]) for i in 0..len(group-keys)],
        homes = {p: c.id for c in placed for p in keys(c.parts)},
        chunk-ids = {c.key: c.id for c in placed},
        unit-homes = {id: chunk-ids[g.key] ?? -1 for g in groups for id in g.units}

fn evaluation-needs(self: Int, group: packing.Group?, edges: [[Int]], homes: {Int:Int}) -> {Int:[Text]} =
  {home: [] for g in group for id in g.units for dep in edges[id] for home in homes[dep] if home != self}

fn placed-group(id: Int, key: Text, root: Int, units: [fragments.Unit], group: packing.Group?) -> Chunk = match group {
  none => Chunk(id: id, key: key, root: root, roots: [root], parts: {}, initializers: {}, needs: {})
  some(g) => Chunk(id: id, key: key, root: root, roots: packing.roots(g, units),
                   parts: {p: true for at in g.units for p in units[at].parts},
                   initializers: {p: true for at in g.units if units[at].evaluation for p in units[at].parts}, needs: {})
}

# A name a chunk reads, and the chunk it lives in.
record Need { home: Int, name: Text }

# From which other chunk, which names: whatever its statements mention or use, and for a root, what
# it exports, each as the chunk reads it.
fn needs-of(c: Chunk, homes: {Int:Int}) -> {Int:[Text]} =
  {h: [n.name for n in needed if n.home == h distinct n.name] for h in [n.home for n in needed distinct n.home]}
  where needed = [Need(home: h, name: e.final-of(t))
                  for s in read-symbols(c) for t in [read-as(s)] for h in home-of(t, homes) if h != c.id]

fn read-symbols(c: Chunk) -> [Int] =
  [s for p in keys(c.parts) for s in [x for m.db.mentions(p, ?x)] ++ [x for m.db.uses(p, ?x)]]
  ++ [an.init-sym(m.modules[r]) for r in [c.root] if r >= 0 and an.wrapped?(m.modules[r])]
  ++ [best for r in [c.root] if r >= 0 for m.db.resolved(r, ?n, ?x) if let some(best) = e.resolved-export(r, n)]

# A symbol as a chunk reads it: what an import resolves to, and the variable of a CommonJS import.
fn read-as(s: Int) -> Int = (first ci in an.linked.cjs-imports[t]: ci.import-var) ?? t
  where t = e.target-of(s)

# The chunk of the live statement declaring a symbol.
fn home-of(s: Int, homes: {Int:Int}) -> Int? = first m.db.declares(?p, s): homes[p]

fn import-names(names: [Text], from: Text) -> Node =
  Import(ImportNamed(List([ImportName(BindName(n)) for n in sort n in names by n]...)), Str(quote-text(from)))

# What this chunk says at its top. A root imports every chunk it needs, for its effects if nothing
# else; a shared chunk imports only what it reads.
fn imports-of(ch: Chunk, all: [Chunk]) -> [Node] = [x for other in all if other.id != ch.id if let some(x) = import-from(ch, other)]

fn import-from(ch: Chunk, other: Chunk) -> Node? = match ch.needs[other.id] {
  some(names) => some(import-names(names, placeholder(other.id)))
  none if ch.root >= 0 and ch.root in other.roots => some(ImportBare(Str(quote-text(placeholder(other.id)))))
  none => none
}

# Names other chunks read from this one.
fn exports-of(ch: Chunk, all: [Chunk]) -> [Node] =
  match sort n in [n for other in all if let some(ns) = other.needs[ch.id] for n in ns distinct n] by n {
    [] => []
    sorted => [ExportNamed(List([ExportName(PropName(n)) for n in sorted]...))]
  }

# ---------------------------------------------------------------- file names

# A chunk's name is not known until its text is, and its text mentions other chunks' names. So the
# text holds these until the end.
const mark: Text = "__ESB_CHUNK_"

fn placeholder(id: Int) -> Text = "./" ++ mark ++ int-text(id) ++ "__"

# Each occurrence: where it starts, how long it is, and which chunk it names.
record Hole { at: Int, size: Int, chunk: Int }

fn holes-in(text: Text) -> [Hole] = [hole-at(text, i) for i in occurrences(text, ["./" ++ mark])]

# `./__ESB_CHUNK_12__`: the chunk's number, and the two bytes after it.
fn hole-at(text: Text, i: Int) -> Hole = Hole(at: i, size: 2 + len(mark) + n + 2, chunk: parse-int(text[digits..digits + n]))
  where digits = i + 2 + len(mark),
        n = span-of(text, digits, "0123456789")


# A file's hash covers everything it loads, so that a change anywhere renames all who depend on it.
# These chunks, and those their texts name, until none names one more.
fn reached(found: [Int], holes: [[Hole]]) -> [Int] = match [h.chunk for c in found for h in holes[c] if not (h.chunk in found) distinct h.chunk] {
  [] => found
  more => reached(found ++ more, holes)
}

# A chunk's hash covers what it imports, so a change anywhere it reaches renames it.
record Hashing { id: Int, texts: [Text], holes: [[Hole]] }

fn hashed(h: Hashing) -> Text = content-hash(h.id, h.texts, h.holes)

fn content-hash(id: Int, texts: [Text], holes: [[Hole]]) -> Text =
  host.hash-name(fold h = host.hash-more(host.hash-start(), texts[id]) for other in 0..len(texts)
                 if other != id and other in seen: host.hash-more(h, texts[other]))
  where seen = reached([id], holes)

# `[dir]/[name]-[hash]`, with an empty directory and the slash after it gone.
fn pattern-path(pattern: Text, dir: Text, name: Text, hash: Text) -> Text =
  without-leading-slashes(replace-all(replace-all(replace-all(pattern, "[name]", name), "[hash]", hash), "[dir]", dir))

fn without-leading-slashes(p: Text) -> Text = match p {
  "./" ++ rest | "/" ++ rest => without-leading-slashes(rest)
  _ => p
}

# `to` as an import written in the file `from`.
fn relative-import(from: Text, to: Text) -> Text =
  here ++ join(["../" for i in common..len(a)], "") ++ join(b[common..len(b)], "/")
  where a = path-segments(dir-of(from)),
        b = path-segments(to),
        common = len([i for i in 0..min(len(a), len(b) - 1) while a[i] == b[i]]),
        here = match common {
          _ if common == len(a) => "./"
          _ => ""
        }

# The text with every placeholder replaced, and where it put what used to follow each one.
record Filled { text: Text, marks: [Mark] }

# A mark moves by how much the placeholders before it grew or shrank.
fn filled(text: Text, base: Int, marks: [Mark], holes: [Hole], self-path: Text, paths: [Text]) -> Filled =
  Filled(text: join([text[hole-end(holes, i)..holes[i].at] ++ replacements[i] for i in 0..len(holes)], "")
               ++ text[hole-end(holes, len(holes))..len(text)],
         marks: [Mark(out: k.out + shift-before(grown, bisect(ats, k.out + base - 1)), src: k.src) for k in marks])
  where replacements = [relative-import(self-path, paths[h.chunk]) for h in holes],
        grown = scan d = 0 for i in 0..len(holes): d + len(replacements[i]) - holes[i].size,
        ats = [h.at for h in holes]

# Where the text after the hole before `i` starts.
fn hole-end(holes: [Hole], i: Int) -> Int = match i {
  0 => 0
  _ => holes[i - 1].at + holes[i - 1].size
}

fn shift-before(grown: [Int], passed: Int) -> Int = match passed {
  0 => 0
  _ => grown[passed - 1]
}
