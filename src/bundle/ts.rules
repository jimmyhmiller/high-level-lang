# TypeScript's run-time parts become JavaScript, before anything else looks at the program. The
# grammar has already thrown the types away, so what is left here is what has a meaning when it
# runs: enums, namespaces, parameter properties, `import x = …`, `export =`, and imports that turn
# out to have named only types.
rules bundle.ts over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.scoped as scope
use bundle.early as early
use bundle.minhost as host

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# `helpers`: runtime helpers the lowered code calls by name, for the linker to supply.
record Lowered { tree: Node, pure-calls: {Int:Int}, helpers: [Text] }

task state src: Text = ""
task state next-offset: Int = -1000
task state pure: {Int:Int} = {}
task state aliases: {Int:Bool} = {}
task state namespace-exports: {Text:[Text]} = {}
# `useDefineForClassFields: false`: fields are assignments in the constructor, as TypeScript once did.
task state assign-fields: Bool = false
# `verbatimModuleSyntax`: an import is kept unless it says it is a type.
task state keeping-imports: Bool = false
task state experimental-decorators: Bool = false
task state helpers-used: [Text] = []
context namespace-path: Text = ""
# What the statement list being lowered declares already, so a namespace there need not.
context declared: [Text] = []

# Scope analysis finds a name's symbol by offset. Real offsets are not negative.
fn fresh-offset() -> Int {
  next-offset = next-offset - 1
  next-offset
}

fn ident(name: Text) -> Node {
  let at = fresh-offset()
  Ident(name) with { lo: at, hi: at }
}

fn bind(name: Text) -> Node {
  let at = fresh-offset()
  BindName(name) with { lo: at, hi: at }
}

# A name no code in this file can mean, for the parameter of an enum's or namespace's function.
fn fresh-name(base: Text) -> Text = first n in 2..: if contains-text?(src, base ++ int-text(n)) then none else some(base ++ int-text(n))

fn string-node(text: Text) -> Node = Str(host.js-string(text))

# ---------------------------------------------------------------- 32-bit arithmetic

const two-32: Int = 4294967296
const two-31: Int = 2147483648

fn to-u32(v: Int) -> Int = ((v % two-32) + two-32) % two-32
fn to-i32(v: Int) -> Int {
  let u = to-u32(v)
  if u >= two-31 then u - two-32 else u
}

fn power-of-two(k: Int) -> Int = fold out = 1 for i in 0..k: out * 2

# `kind` is 0 for and, 1 for or, 2 for xor, of the two as unsigned 32-bit numbers.
fn bits(a: Int, b: Int, kind: Int) -> Int =
  to-i32(if kind == 0 then bit-and(to-u32(a), to-u32(b)) else if kind == 1 then bit-or(to-u32(a), to-u32(b))
         else bit-xor(to-u32(a), to-u32(b)))

fn shift-left(a: Int, b: Int) -> Int = to-i32(to-i32(a) * power-of-two(to-u32(b) % 32))
fn shift-right(a: Int, b: Int) -> Int {
  let v = to-i32(a)
  let d = power-of-two(to-u32(b) % 32)
  if v >= 0 then v / d else (v - d + 1) / d
}
fn shift-right-unsigned(a: Int, b: Int) -> Int = to-u32(a) / power-of-two(to-u32(b) % 32)

# ---------------------------------------------------------------- enums

# A member's value, when it can be known here: the next member counts on from a number.
record Value { is-text: Bool, num: Int, node: Node }

fn number-value(v: Int) -> Value = Value(is-text: false, num: v, node: None())
fn text-value(n: Node) -> Value = Value(is-text: true, num: 0, node: n)

fn digits-value(s: Text, base: Int) -> Int? {
  if len(s) == 0 { return none }
  let digits = replace-all(s, "_", "")
  if len(digits) == 0 then some(0) else digits-number(digits, base, 9007199254740992)
}

fn number-literal(t: Text) -> Int? {
  if len(t) > 2 and t[0] == '0' {
    let rest = t[2..len(t)]
    match t[1] {
      'x' | 'X' => return digits-value(rest, 16)
      'b' | 'B' => return digits-value(rest, 2)
      'o' | 'O' => return digits-value(rest, 8)
      _ => {}
    }
  }
  digits-value(t, 10)
}

fn int-of(v: Value?) -> Int? = match v {
  some(x) => if x.is-text then none else some(x.num)
  none => none
}

fn fold-unary(e: Node, known: {Text:Value}, self: Text, kind: Int) -> Value? {
  if let some(v) = int-of(evaluated(e, known, self)) {
    return some(number-value(if kind == 0 then 0 - v else if kind == 1 then v else -1 - to-i32(v)))
  }
  none
}

# `kind` numbers the operators, in the order `fold-binary`'s callers use them.
fn fold-binary(a: Node, b: Node, known: {Text:Value}, self: Text, kind: Int) -> Value? {
  let x = int-of(evaluated(a, known, self))
  let y = int-of(evaluated(b, known, self))
  if let some(p) = x {
    if let some(q) = y {
      let result: Int? = match kind {
        _ if kind == 0 => some(p + q)
        _ if kind == 1 => some(p - q)
        _ if kind == 2 => some(p * q)
        _ if kind == 3 => if q != 0 and p % q == 0 then some(p / q) else none
        _ if kind == 4 => if q != 0 then some(p % q) else none
        _ if kind == 5 => some(shift-left(p, q))
        _ if kind == 6 => some(shift-right(p, q))
        _ if kind == 7 => some(shift-right-unsigned(p, q))
        _ if kind == 8 => some(bits(p, q, 0))
        _ if kind == 9 => some(bits(p, q, 1))
        _ => some(bits(p, q, 2))
      }
      if let some(r) = result {
        if r > -9007199254740992 and r < 9007199254740992 { return some(number-value(r)) }
      }
    }
  }
  none
}

fn evaluated(e: Node, known: {Text:Value}, self: Text) -> Value? = match e {
  Num(t) => match number-literal(t) {
    some(v) => some(number-value(v))
    none => none
  }
  Str(_) | TemplateFull(_) => some(text-value(e))
  Paren(x) => evaluated(x, known, self)
  Neg(x) => fold-unary(x, known, self, 0)
  Pos(x) => fold-unary(x, known, self, 1)
  BitNot(x) => fold-unary(x, known, self, 2)
  Add(a, b) => match evaluated(a, known, self) {
    some(x) => match evaluated(b, known, self) {
      some(y) => if x.is-text and y.is-text and x.node is Str(_) and y.node is Str(_)
                 then some(text-value(host.concat(x.node.text, y.node.text)))
                 else fold-binary(a, b, known, self, 0)
      none => none
    }
    none => none
  }
  Sub(a, b) => fold-binary(a, b, known, self, 1)
  Mul(a, b) => fold-binary(a, b, known, self, 2)
  Div(a, b) => fold-binary(a, b, known, self, 3)
  Mod(a, b) => fold-binary(a, b, known, self, 4)
  Shl(a, b) => fold-binary(a, b, known, self, 5)
  Shr(a, b) => fold-binary(a, b, known, self, 6)
  Ushr(a, b) => fold-binary(a, b, known, self, 7)
  BitAnd(a, b) => fold-binary(a, b, known, self, 8)
  BitOr(a, b) => fold-binary(a, b, known, self, 9)
  BitXor(a, b) => fold-binary(a, b, known, self, 10)
  Ident(x) => known[x]
  Member(Ident(s), p) => if s == self then known[p.text] else none
  _ => none
}

fn number-node(v: Int) -> Node = if v < 0 then Neg(Num(int-text(0 - v))) else Num(int-text(v))

fn member-key(k: Node) -> Text = match k {
  Str(raw) => unquote(raw)
  _ => k.text
}

# Inside an initializer, an earlier member's bare name means that member.
everywhere fn with-members(e: Node, names: [Text], param: Text) -> Node = match e {
  Ident(x) => if x in names then Member(ident(param), PropName(x)) else e
}

# The function that fills an enum in, called on what `outer` evaluates to.
fn enum-call(n: Node, outer: Node) -> Node = match n {
  TsEnum(name, List(members...)) => {
    let param = fresh-name(name.text)
    let p = bind(param)
    let a = ident(param)
    var known: {Text:Value} = {}
    var names: [Text] = []
    var next: Int? = some(0)
    var constant = true
    var body: [Node] = []
    for m in members {
      let k = member-key(m.key)
      let key = string-node(k)
      let init = m.init
      let value: Value? = if init is None() then none else evaluated(lowered(init), known, name.text)
      if init is None() {
        match next {
          some(v) => {
            let number = number-node(v)
            body += stmt`$a[$a[$key] = $number] = $key;`
            known[k] = number-value(v)
            next = some(v + 1)
          }
          none => panic "enum member {} needs an initializer: the one before it is not a number known here", k
        }
      } else {
        match value {
          some(v) => {
            if v.is-text {
              let text = v.node
              body += stmt`$a[$key] = $text;`
              next = none
            } else {
              let number = number-node(v.num)
              body += stmt`$a[$a[$key] = $number] = $key;`
              next = some(v.num + 1)
            }
            known[k] = v
          }
          none => {
            constant = false
            let computed = with-members(lowered(init), names, param)
            body += stmt`$a[$a[$key] = $computed] = $key;`
            next = none
          }
        }
      }
      names += k
    }
    body += stmt`return $a;`
    let call = exp`(($p) => { $$body })($outer)`
    let at = fresh-offset()
    if constant { pure[at] = at }
    call with { lo: at, hi: at }
  }
  _ => panic "expected an enum"
}

fn enum-name(n: Node) -> Text = n.name.text

# `var E = ((E2) => { … })(E || {});`
fn enum-declarator(n: Node) -> Node {
  let name = n.name
  let again = ident(name.text)
  let empty = ObjectLit(List())
  let call = enum-call(n, Or(again, empty))
  Declarator(name, call) with { lo: n.lo, hi: n.hi }
}

# ---------------------------------------------------------------- namespaces

# Which names an inner scope takes for itself, so the namespace's do not reach in.
fn shadowed-by(n: Node) -> [Text] {
  if sc.function?(n.kind) { return [function-shadows(k)... for k in n.kids] }
  match n {
    Block(List(ss...)) | TryBlock(List(ss...)) => block-shadows(ss)
    Switch(_, List(cases...)) => [block-shadows(c.stmts.kids)... for c in cases]
    For(LetInit(_) | ConstInit(_), ...) => early.bound-names(n.init)
    ForIn(LetLeft(_) | ConstLeft(_), ...) => early.bound-names(n.left)
    ForOf(_, LetLeft(_) | ConstLeft(_), ...) => early.bound-names(n.left)
    Catch(CatchHead(_), ...) => early.bound-names(n.param)
    _ => []
  }
}

fn function-shadows(k: Node) -> [Text] = match k {
  Params(_) | BindName(_) => early.bound-names(k)
  FuncBody(List(ss...)) => [(early.var-names(s) ++ early.lexical-names(s, true))... for s in ss]
  _ => []
}

fn block-shadows(ss: [Node]) -> [Text] = [(early.lexical-names(s, false) ++ early.block-functions(s, false))... for s in ss]

# References to a namespace's exported variables read and write its object, wherever they are.
fn through-namespace(n: Node, names: [Text], param: Text) -> Node {
  if len(names) == 0 { return n }
  match n {
    Ident(x) => return if x in names then Member(ident(param), PropName(x)) with { lo: n.lo, hi: n.hi } else n
    Shorthand(Ident(x)) =>
      if x in names { return Prop(PropName(x), Member(ident(param), PropName(x))) with { lo: n.lo, hi: n.hi } }
    _ => {}
  }
  if len(n.kids) == 0 { return n }
  let hidden = shadowed-by(n)
  let inner = if len(hidden) == 0 then names else [x for x in names if not (x in hidden)]
  n with { kids: [through-namespace(k, inner, param) for k in n.kids] }
}

# The variables a namespace's body exports.
fn exported-variables(stmts: [Node]) -> [Text] = [declarator-name(d) for s in stmts for d in exported-declarators(s)]

fn exported-declarators(s: Node) -> [Node] = match s {
  ExportVar(List(ds...)) => ds
  ExportLexical(d) => d.declarators.kids
  _ => []
}

fn declarator-name(d: Node) -> Text = match d {
  Declarator(BindName(x), _) => x
  _ => panic "destructuring in `export` inside a namespace is not implemented yet"
}

fn assign-out(param: Text, name: Text, value: Node) -> Node {
  let ns = ident(param)
  stmt`$ns.$name = $value;`
}

# One statement of a namespace's body, with its `export` turned into an assignment.
fn namespace-statement(s: Node, param: Text) -> [Node] = match s {
  ExportVar(List(ds...)) => export-declarators(ds, param)
  ExportLexical(d) => export-declarators(d.declarators.kids, param)
  ExportFunction(f) => lowered-statements([f]) ++ [assign-out(param, f.name.text, ident(f.name.text))]
  ExportClass(c) => lowered-statements([c]) ++ [assign-out(param, c.name.text, ident(c.name.text))]
  TsExportEnum(e) => {
    let name = enum-name(e)
    let holder = bind(name)
    let ns1 = ident(param)
    let ns2 = ident(param)
    let local = ident(name)
    let outer = exp`$local = $ns1.$name || ($ns2.$name = {})`
    let call = enum-call(e, outer)
    pure-off(call)
    [stmt`let $holder;`, ExprStmt(call)]
  }
  TsExportNamespace(TsNamespace(name, body)) => nested-namespace(name.text, body, param)
  TsExportImport(TsImportAlias(name, target)) => [assign-out(param, name.text, target)]
  TsExportImport(TsImportRequire(name, from)) => {
    let req = ident("require")
    let required = exp`$req($from)`
    [assign-out(param, name.text, required)]
  }
  ExportNamed(List(specs...)) =>
    [assign-out(param, (if spec is ExportAs(...) then spec.exported else spec.local).text, ident(spec.local.text))
     for spec in specs if spec is ExportName(_) | ExportAs(_, _)]
  _ => lowered-statements([s])
}

fn pure-off(n: Node) -> Void {
  if let some(hi) = pure[n.lo] {
    if hi == n.hi { pure[n.lo] = n.hi + 1 }
  }
}

fn export-declarators(ds: [Node], param: Text) -> [Node] {
  if any d in ds: not (d is Declarator(BindName(_), _)) {
    panic "destructuring in `export` inside a namespace is not implemented yet"
  }
  [assign-out(param, x, lowered(init)) for Declarator(BindName(x), init) in ds if not (init is None())]
}

# The function a namespace's body becomes, or nothing if the body held only types.
fn namespace-call(name: Text, body: Node, outer: Node) -> Node? {
  let param = fresh-name(name)
  let stmts = namespace-body(namespace-path ++ "." ++ name, body, param)
  if len(stmts) == 0 { return none }
  let p = bind(param)
  some(exp`(($p) => { $$stmts })($outer)`)
}

# What the namespace at `path` holds, as statements of the function its body becomes. Every body of
# one namespace exports into the same object: what earlier ones exported is read through it.
fn namespace-body(path: Text, body: Node, param: Text) -> [Node] {
  with namespace-path = path {
    match body {
      TsNamespaceNested(inner, rest) => nested-namespace(inner.text, rest, param)
      TsNamespaceBlock(List(ss...)) => {
        let exported = (namespace-exports[path] ?? []) ++ exported-variables(ss)
        namespace-exports[path] = exported
        [through-namespace(s, exported, param) for s in [namespace-statement(s, param)... for s in ss]]
      }
      _ => panic "unexpected namespace body"
    }
  }
}

# `let M; ((M2) => { … })(M = N2.M || (N2.M = {}));`
fn nested-namespace(name: Text, body: Node, param: Text) -> [Node] {
  let ns1 = ident(param)
  let ns2 = ident(param)
  let local = ident(name)
  let outer = exp`$local = $ns1.$name || ($ns2.$name = {})`
  match namespace-call(name, body, outer) {
    some(call) => {
      let holder = bind(name)
      [stmt`let $holder;`, ExprStmt(call)]
    }
    none => []
  }
}

# `var N; ((N2) => { … })(N || (N = {}));`, without the `var` if something already declares N.
fn namespace-statements(n: Node, exported: Bool) -> [Node] = match n {
  TsNamespace(name, body) => {
    let again1 = ident(name.text)
    let again2 = ident(name.text)
    let outer = exp`$again1 || ($again2 = {})`
    match namespace-call(name.text, body, outer) {
      none => []
      some(call) => {
        if name.text in declared { return [ExprStmt(call)] }
        declared += name.text
        let holder = Declarator(name, None()) with { lo: n.lo, hi: n.hi }
        [if exported then ExportVar(List(holder)) else VarDecl(List(holder)), ExprStmt(call)]
      }
    }
  }
  _ => panic "expected a namespace"
}

# ---------------------------------------------------------------- classes

fn param-of(p: Node) -> Node = match p {
  TsParamProp(target, init) => Param(lowered(target), lowered(init)) with { lo: p.lo, hi: p.hi }
  _ => lowered(p)
}

# Directives stay first, and in a derived class `this` is only there after `super()`.
fn assignments-at(stmts: [Node]) -> Int {
  match first i in 0..len(stmts): if stmts[i] is ExprStmt(CallExpr(Super(), _)) then some(i + 1) else none {
    some(at) => at
    none => len([s for s in stmts while s is ExprStmt(Str(_))])
  }
}

# The constructor, with what it now sets right after `super()`: parameter properties, then fields.
fn constructor-with-assignments(m: Node, assigns: [Node]) -> Node = match m {
  Method(key, Params(List(ps...)), FuncBody(List(ss...))) => {
    let body = lowered-statements(ss)
    let at = assignments-at(body)
    let out = body[0..at] ++ assigns ++ body[at..len(body)]
    let params = [param-of(p) for p in ps]
    m with { params: Params(List(params...)) with { lo: m.params.lo, hi: m.params.hi },
             body: FuncBody(List(out...)) with { lo: m.body.lo, hi: m.body.hi } }
  }
  _ => panic "expected a constructor"
}

fn constructor?(m: Node) -> Bool = m is Method(PropName("constructor"), _, _)

fn parameter-properties(m: Node) -> [Node] = match m {
  Method(_, Params(List(ps...)), _) => [p for p in ps if p is TsParamProp(...)]
  _ => []
}

# `this.x = v`, `this["a b"] = v`, `this.#x = v`.
fn assigned(target: Node, key: Node, value: Node) -> Node {
  let place = match key {
    PropName(_) | PrivateName(_) => Member(target, key)
    Str(_) | Num(_) => Index(target, key)
    _ => panic "a computed field name with useDefineForClassFields false is not implemented yet"
  }
  ExprStmt(Assignment(place, AssignOp("="), value))
}

fn synthesized-constructor(derived: Bool) -> Node {
  let calls: [Node] = if derived then [stmt`super(...arguments);`] else []
  Method(PropName("constructor"), Params(List()), FuncBody(List(calls...)))
}

# A parameter property is a field, declared ahead of the others, set by the constructor. Without
# define semantics a field is an assignment there too, and a static one an assignment in a static
# block where it stood. A private field stays declared, since only the class can declare it.
fn class-body(n: Node, derived: Bool) -> Node = match n {
  ClassBody(List(members...)) => {
    let props = [parameter-properties(m)... for m in members if constructor?(m)]
    let has-fields = any m in members: m is Field(...) | StaticField(...)
    if len(props) == 0 and not (assign-fields and has-fields) { return n with { members: lowered(n.members) } }
    var assigns: [Node] = []
    for p in props {
      let name = p.target.text
      let value = ident(name)
      assigns += stmt`this.$name = $value;`
    }
    var rest: [Node] = []
    for m in members {
      match m {
        Field(key, init) => if not assign-fields { rest += lowered(m) } else {
          if key is PrivateName(_) { rest += Field(key, None()) with { lo: m.lo, hi: m.hi } }
          if not (init is None()) { assigns += assigned(This(), key, lowered(init)) }
        }
        StaticField(key, init) => if not assign-fields { rest += lowered(m) } else {
          if key is PrivateName(_) { rest += StaticField(key, None()) with { lo: m.lo, hi: m.hi } }
          if not (init is None()) {
            rest += StaticBlock(FuncBody(List(assigned(This(), key, lowered(init))))) with { lo: m.lo, hi: m.hi }
          }
        }
        TsErased() => {}
        _ => if not constructor?(m) { rest += lowered(m) }
      }
    }
    var out: [Node] = []
    let existing = first m in members: if constructor?(m) then some(m) else none
    let needs-constructor = len(assigns) > 0 or is-some(existing)
    if needs-constructor {
      out += constructor-with-assignments(existing ?? synthesized-constructor(derived), assigns)
    }
    for p in props {
      let key = PropName(p.target.text) with { lo: p.target.lo, hi: p.target.hi }
      if not assign-fields { out += Field(key, None()) with { lo: p.lo, hi: p.hi } }
    }
    out ++= rest
    n with { members: List(out...) with { lo: n.members.lo, hi: n.members.hi } }
  }
  _ => panic "expected a class body"
}

# ---------------------------------------------------------------- decorators

fn helper-ref(name: Text) -> Node {
  if not (name in helpers-used) { helpers-used += name }
  ident(name)
}

fn decorators-of(list: Node) -> [Node] = [lowered(d.expr) for d in list.kids]

fn member-core(m: Node) -> Node = match m {
  TsDecoratedMember(_, inner) => inner
  _ => m
}

fn static-member?(m: Node) -> Bool = member-core(m) is StaticMethod(_) | StaticField(...)

fn member-inner(m: Node) -> Node = match member-core(m) {
  StaticMethod(x) => x
  other => other
}

# esbuild's kinds: 1 for a method or accessor, 2 for a field.
fn member-kind(m: Node) -> Int = if member-inner(m) is Field(...) | StaticField(...) then 2 else 1

fn decorated-key(m: Node) -> Node = match member-inner(m).key {
  PropName(x) => string-node(x)
  Str(raw) => Str(raw)
  Num(t) => string-node(t)
  PrivateName(_) => panic "a decorator on a private member is not allowed"
  _ => panic "a decorator on a member with a computed name is not implemented yet"
}

fn params-of-member(m: Node) -> [Node] = match member-inner(m) {
  Method(_, Params(List(ps...)), _) | GenMethod(_, Params(List(ps...)), _) | AsyncMethod(_, Params(List(ps...)), _)
    | AsyncGenMethod(_, Params(List(ps...)), _) | Setter(_, Params(List(ps...)), _) => ps
  _ => []
}

# `__decorateParam(i, d)` for each decorated parameter.
fn param-decorators(ps: [Node]) -> [Node] =
  [decorate-param(i, d) for i in 0..len(ps) if let TsDecoratedParam(List(ds...), _) = ps[i] for d in ds]

fn decorate-param(i: Int, d: Node) -> Node {
  let index = Num(int-text(i))
  let f = helper-ref("__decorateParam")
  let dec = lowered(d.expr)
  exp`$f($index, $dec)`
}

# The class without its decorators: they become calls after it.
everywhere fn undecorated(n: Node) -> Node = match n {
  TsDecoratedMember(_, inner) => undecorated(inner)
  TsDecoratedParam(_, inner) => inner
}

everywhere fn decorated-anything?(n: Node) -> Bool = match n {
  TsDecoratedMember(...) | TsDecoratedParam(...) => true
}

fn decorate-call(decorators: [Node], target: Node, key: Node?, kind: Int) -> Node {
  let f = helper-ref("__decorateClass")
  let slots = [if i == len(decorators) - 1 then ElemLast(decorators[i]) else Elem(decorators[i]) for i in 0..len(decorators)]
  let list = ArrayLit(List(slots...))
  match key {
    some(k) => {
      let kind-node = Num(int-text(kind))
      exp`$f($list, $target, $k, $kind_node)`
    }
    none => exp`$f($list, $target)`
  }
}

# `class A { @d m() {} }` and `@c class A {}`, as TypeScript's experimentalDecorators runs them:
# members first, instance before static, then the class, which the decorators may replace.
fn decorated-class(class-decorators: [Node], cls: Node, exported: Bool) -> [Node] {
  if not experimental-decorators {
    panic "JavaScript decorators are not implemented yet; set \"experimentalDecorators\": true in tsconfig.json for TypeScript's"
  }
  let name = cls.name.text
  let members = cls.body.members.kids
  var after: [Node] = []
  var constructor-params: [Node] = []
  for pass in [false, true] {
    for m in members {
      let core = member-core(m)
      if not (core is ClassEmpty() | TsErased()) and static-member?(m) == pass {
        if core is Method(PropName("constructor"), ...) {
          constructor-params = param-decorators(params-of-member(m))
        } else {
          let own: [Node] = match m {
            TsDecoratedMember(List(ds...), _) => [lowered(d.expr) for d in ds]
            _ => []
          }
          let all-decorators = own ++ param-decorators(params-of-member(m))
          if len(all-decorators) > 0 {
            let holder = ident(name)
            let target = if pass then holder else Member(holder, PropName("prototype"))
            after += ExprStmt(decorate-call(all-decorators, target, some(decorated-key(m)), member-kind(m)))
          }
        }
      }
    }
  }
  let whole = class-decorators ++ constructor-params
  if len(whole) > 0 {
    let holder = ident(name)
    let value = decorate-call(whole, ident(name), none, 0)
    after += stmt`$holder = $value;`
  }
  let plain = lowered(undecorated(cls))
  [if exported then ExportClass(plain) with { lo: cls.lo, hi: cls.hi } else plain] ++ after
}

# ---------------------------------------------------------------- the walk

# Names the statements in one list declare by way of a function or a class, which a namespace or
# an enum of the same name extends rather than declares again.
fn declared-names(stmts: [Node]) -> [Text] =
  [declared-name(s)... for s in stmts]

fn declared-name(s: Node) -> [Text] = match s {
  FuncDecl(name, ...) | GenDecl(name, ...) | AsyncFuncDecl(name, ...) | AsyncGenDecl(name, ...)
    | ClassDecl(name, ...) => [name.text]
  ExportFunction(d) | ExportClass(d) => [d.name.text]
  _ => []
}

fn lowered-statements(xs: [Node]) -> [Node] {
  with declared = declared-names(xs) { [statement-lowered(x)... for x in xs] }
}

fn statement-lowered(x: Node) -> [Node] = match x {
  TsErased() => []
  TsDecoratedClass(List(ds...), cls) => decorated-class([lowered(d.expr) for d in ds], cls, false)
  TsDecoratedExport(List(ds...), cls) | TsExportDecorated(List(ds...), cls) =>
    decorated-class([lowered(d.expr) for d in ds], cls, true)
  TsDecoratedDefault(...) | TsDefaultDecorated(...) => panic "a decorated `export default class` is not implemented yet; name the class and export it"
  ClassDecl(...) => if decorated-anything?(x) then decorated-class([], x, false) else [lowered(x)]
  ExportClass(c) => if decorated-anything?(c) then decorated-class([], c, true) else [lowered(x)]
  TsEnum(...) => [VarDecl(List(enum-declarator(x))) with { lo: x.lo, hi: x.hi }]
  TsExportEnum(e) => [ExportVar(List(enum-declarator(e))) with { lo: x.lo, hi: x.hi }]
  TsNamespace(...) => namespace-statements(x, false)
  TsExportNamespace(n) => namespace-statements(n, true)
  TsImportRequire(name, from) | TsExportImport(TsImportRequire(name, from)) => {
    let req = ident("require")
    let required = exp`$req($from)`
    let d = List(Declarator(name, required) with { lo: x.lo, hi: x.hi })
    [if x is TsExportImport(_) then ExportLexical(ConstDecl(d)) else ConstDecl(d)]
  }
  TsImportAlias(name, target) => {
    aliases[name.lo] = true
    [ConstDecl(List(Declarator(name, target) with { lo: x.lo, hi: x.hi })) with { lo: x.lo, hi: x.hi }]
  }
  TsExportImport(TsImportAlias(name, target)) =>
    [ExportLexical(ConstDecl(List(Declarator(name, target) with { lo: x.lo, hi: x.hi }))) with { lo: x.lo, hi: x.hi }]
  TsExportAssign(e) => {
    let value = lowered(e)
    let holder = ident("module")
    [stmt`$holder.exports = $value;`]
  }
  # `import {type A} from "x"` and its like are gone once their specifiers are.
  Import(ImportNamed(List(specs...)), _) | ExportNamed(List(specs...)) | ExportFrom(List(specs...), _) =>
    if len(specs) == 0 or (any s in specs: not (s is TsErased())) then [lowered(x)] else []
  _ => [lowered(x)]
}

fn lowered(n: Node) -> Node = match n {
  List(xs...) => n with { kids: lowered-statements(xs) }
  TsDecoratedClassExpr(...) => panic "a decorated class expression is not implemented yet; declare the class"
  TsDecoratedMember(...) | TsDecoratedParam(...) => panic "decorators in a class expression are not implemented yet; declare the class"

  ClassDecl(name, heritage, body) | ClassExpr(name, heritage, body) =>
    n with { kids: [lowered(name), lowered(heritage), class-body(body, not (heritage is None()))] }
  ClassBody(...) => class-body(n, false)
  TsParamProp(...) => panic "a parameter property is only allowed in a constructor"
  _ => if len(n.kids) == 0 then n else n with { kids: [lowered(k) for k in n.kids] }
}

# ---------------------------------------------------------------- imports that named only types

# Is this symbol's name mentioned as a value? `export { A }` counts: a value, as far as one file
# can tell.
everywhere fn value-mentions(n: Node, b: {Int:Int}) -> [Int] = match n {
  Ident(_) => [s if let some(s) = b[n.lo]]
  ExportNamed(...) => []
}

everywhere fn export-mentions(n: Node) -> [Text] = match n {
  ExportNamed(List(specs...)) => [x.text for ExportName(x) | ExportAs(x, _) in specs]
}

fn keep-binding?(bound: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text]) -> Bool {
  if bound.text in keep or bound.text in exported { return true }
  match b[bound.lo] {
    some(s) => s in used
    none => true
  }
}

fn pruned-clause(c: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text]) -> Node? = match c {
  ImportDefault(x) | ImportNamespace(x) => if keep-binding?(x, b, used, exported, keep) then some(c) else none
  ImportNamed(List(specs...)) => {
    let left = [s for s in specs if keep-binding?(s.name, b, used, exported, keep)]
    if len(left) == 0 then none else some(c with { specs: List(left...) with { lo: c.specs.lo, hi: c.specs.hi } })
  }
  ImportDefaultAnd(x, rest) => {
    let first = keep-binding?(x, b, used, exported, keep)
    match pruned-clause(rest, b, used, exported, keep) {
      some(r) => some(if first then c with { kids: [x, r] } else r)
      none => if first then some(ImportDefault(x) with { lo: c.lo, hi: c.hi }) else none
    }
  }
  _ => some(c)
}

fn alias-unused?(s: Node, b: {Int:Int}, used: {Int:Bool}) -> Bool = match s {
  ConstDecl(List(Declarator(name, _))) => name.lo in aliases and not (b[name.lo] is some(_) and (b[name.lo] ?? -1) in used)
  _ => false
}

# Drop aliases nothing uses, at any depth: what they point at may be a type.
everywhere fn without-aliases(n: Node, b: {Int:Int}, used: {Int:Bool}) -> Node = match n {
  List(xs...) => n with { kids: [without-aliases(x, b, used) for x in xs if not alias-unused?(x, b, used)] }
}

fn pruned(tree: Node, keep: [Text]) -> Node {
  let bindings = scope.scoped(tree, []).bindings
  let used = {s: true for s in value-mentions(tree, bindings)}
  let exported = {x: true for x in export-mentions(tree)}
  let plain = without-aliases(tree.body, bindings, used)
  let declared = early.module-names(tree.body.kids)
  Program(tree.hashbang, List([pruned-statement(s, bindings, used, exported, keep, declared)... for s in plain.kids]...))
}

fn pruned-statement(s: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text], declared: [Text]) -> [Node] = match s {
  Import(clause, from) =>
    if keeping-imports then [s] else [s with { kids: [c, from] } if let some(c) = pruned-clause(clause, b, used, exported, keep)]
  # What is exported but not declared was a type.
  ExportNamed(List(specs...)) => {
    let left = [x for x in specs if x.local.text in declared]
    if len(left) > 0 or len(specs) == 0 then [s with { specs: List(left...) with { lo: s.specs.lo, hi: s.specs.hi } }] else []
  }
  _ => [s]
}

# ---------------------------------------------------------------- the whole file

fn lower(tree: Node, source: Text, keep: [Text], define-fields: Bool, keep-imports: Bool, decorators: Bool) -> Lowered {
  src = source
  experimental-decorators = decorators
  helpers-used = []
  assign-fields = not define-fields
  keeping-imports = keep-imports
  next-offset = -1000
  pure = {}
  aliases = {}
  namespace-exports = {}
  let stmts = lowered-statements(tree.body.kids)
  let whole = Program(tree.hashbang, List(stmts...))
  Lowered(tree: pruned(whole, keep), pure-calls: pure, helpers: helpers-used)
}
