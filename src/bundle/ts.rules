# TypeScript's run-time parts become JavaScript, before anything else looks at the program. The
# grammar has already thrown the types away, so what is left here is what has a meaning when it
# runs: enums, namespaces, parameter properties, `import x = …`, `export =`, and imports that turn
# out to have named only types.
rules bundle.ts over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.early as early
use bundle.minhost as host

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# `helpers`: runtime helpers the lowered code calls by name, for the linker to supply.
record Lowered { tree: Node, pure-calls: {Int:Int}, helpers: [Text] }

# What one file's lowering is told: its source, and its project's settings.
# `assign-fields`: `useDefineForClassFields: false`, so fields are assignments in the constructor, as
# TypeScript once did. `keeping-imports`: `verbatimModuleSyntax`, so an import is kept unless it says
# it is a type. `decorators`: `experimentalDecorators`.
record Settings { src: Text, assign-fields: Bool, keeping-imports: Bool, decorators: Bool }
context settings: Settings = Settings(src: "", assign-fields: false, keeping-imports: false, decorators: false)
# Each namespace body's exports, by where it is: its own, after those of the bodies before it of
# the same namespace.
context namespace-exports: {Int:[Text]} = {}
context namespace-path: Text = ""

# A name lowering makes has no place in the source. It is made unplaced, and once the file is
# lowered takes an offset of its own (see `placed`): scope analysis finds a name's symbol by
# offset, and real offsets are not negative. A call that may go if nothing uses its value ends at
# `unplaced-pure` until then.
const unplaced: Int = -1000
const unplaced-pure: Int = -999

fn ident(name: Text) -> Node = Ident(name) with { lo: unplaced, hi: unplaced }

fn bind(name: Text) -> Node = BindName(name) with { lo: unplaced, hi: unplaced }

# A name no code in this file can mean, for the parameter of an enum's or namespace's function.
fn fresh-name(base: Text) -> Text = first n in 2.. if not contains-text?(settings.src, base ++ int-text(n)): base ++ int-text(n)

fn string-node(text: Text) -> Node = Str(host.js-string(text))

# ---------------------------------------------------------------- 32-bit arithmetic

const two-32: Int = 4294967296
const two-31: Int = 2147483648

fn to-u32(v: Int) -> Int = ((v % two-32) + two-32) % two-32
fn to-i32(v: Int) -> Int = match to-u32(v) {
  u if u >= two-31 => u - two-32
  u => u
}

fn power-of-two(k: Int) -> Int = fold out = 1 for i in 0..k: out * 2

# `kind` is 0 for and, 1 for or, 2 for xor, of the two as unsigned 32-bit numbers.
fn bits(a: Int, b: Int, kind: Int) -> Int = to-i32(match kind {
  0 => bit-and(to-u32(a), to-u32(b))
  1 => bit-or(to-u32(a), to-u32(b))
  _ => bit-xor(to-u32(a), to-u32(b))
})

fn shift-left(a: Int, b: Int) -> Int = to-i32(to-i32(a) * power-of-two(to-u32(b) % 32))
fn shift-right(a: Int, b: Int) -> Int = match to-i32(a) {
  v if v >= 0 => v / d
  v => (v - d + 1) / d
} where d = power-of-two(to-u32(b) % 32)
fn shift-right-unsigned(a: Int, b: Int) -> Int = to-u32(a) / power-of-two(to-u32(b) % 32)

# ---------------------------------------------------------------- enums

# A member's value, when it can be known here: the next member counts on from a number.
record Value { is-text: Bool, num: Int, node: Node }

fn number-value(v: Int) -> Value = Value(is-text: false, num: v, node: None())
fn text-value(n: Node) -> Value = Value(is-text: true, num: 0, node: n)

fn digits-value(s: Text, base: Int) -> Int? = match s, replace-all(s, "_", "") {
  "", _ => none
  _, "" => some(0)
  _, digits => digits-number(digits, base, 9007199254740992)
}

fn number-literal(t: Text) -> Int? = match ascii-lower(t) {
  "0x" ++ d if d != "" => digits-value(t[2..len(t)], 16)
  "0b" ++ d if d != "" => digits-value(t[2..len(t)], 2)
  "0o" ++ d if d != "" => digits-value(t[2..len(t)], 8)
  _ => digits-value(t, 10)
}

fn int-of(v: Value?) -> Int? = first x in v if not x.is-text: x.num

fn fold-unary(e: Node, known: [Settled], self: Text, kind: Int) -> Value? =
  first v in int-of(evaluated(e, known, self)):
    number-value(match kind {
      0 => 0 - v
      1 => v
      _ => -1 - to-i32(v)
    })

# `kind` numbers the operators, in the order `fold-binary`'s callers use them.
fn fold-binary(a: Node, b: Node, known: [Settled], self: Text, kind: Int) -> Value? =
  first p in int-of(evaluated(a, known, self)) for q in int-of(evaluated(b, known, self))
        for r in folded-int(p, q, kind) if r > -9007199254740992 and r < 9007199254740992:
    number-value(r)

fn folded-int(p: Int, q: Int, kind: Int) -> Int? = match kind {
  0 => some(p + q)
  1 => some(p - q)
  2 => some(p * q)
  3 if q != 0 and p % q == 0 => some(p / q)
  3 => none
  4 if q != 0 => some(p % q)
  4 => none
  5 => some(shift-left(p, q))
  6 => some(shift-right(p, q))
  7 => some(shift-right-unsigned(p, q))
  8 => some(bits(p, q, 0))
  9 => some(bits(p, q, 1))
  _ => some(bits(p, q, 2))
}

fn evaluated(e: Node, known: [Settled], self: Text) -> Value? = match e {
  Num(t) => first v in number-literal(t): number-value(v)
  Str(_) | TemplateFull(_) => some(text-value(e))
  Paren(x) => evaluated(x, known, self)
  Neg(x) => fold-unary(x, known, self, 0)
  Pos(x) => fold-unary(x, known, self, 1)
  BitNot(x) => fold-unary(x, known, self, 2)
  Add(a, b) => match evaluated(a, known, self), evaluated(b, known, self) {
    some(x), some(y) if x.is-text and y.is-text and x.node is Str(_) and y.node is Str(_) =>
      some(text-value(host.concat(x.node.text, y.node.text)))
    some(_), some(_) => fold-binary(a, b, known, self, 0)
    _, _ => none
  }
  Sub(a, b) => fold-binary(a, b, known, self, 1)
  Mul(a, b) => fold-binary(a, b, known, self, 2)
  Div(a, b) => fold-binary(a, b, known, self, 3)
  Mod(a, b) => fold-binary(a, b, known, self, 4)
  Shl(a, b) => fold-binary(a, b, known, self, 5)
  Shr(a, b) => fold-binary(a, b, known, self, 6)
  Ushr(a, b) => fold-binary(a, b, known, self, 7)
  BitAnd(a, b) => fold-binary(a, b, known, self, 8)
  BitOr(a, b) => fold-binary(a, b, known, self, 9)
  BitXor(a, b) => fold-binary(a, b, known, self, 10)
  Ident(x) => value-named(known, x)
  Member(Ident(s), p) if s == self => value-named(known, p.text)
  _ => none
}

fn number-node(v: Int) -> Node = match v {
  _ if v < 0 => Neg(Num(int-text(0 - v)))
  _ => Num(int-text(v))
}

fn member-key(k: Node) -> Text = match k {
  Str(raw) => unquote(raw)
  _ => k.text
}

# Inside an initializer, an earlier member's bare name means that member.
everywhere fn with-members(e: Node, names: [Text], param: Text) -> Node = match e {
  Ident(x) if x in names => Member(ident(param), PropName(x))
  Ident(_) => e
}

# One member settled: its name, its value when it is known here, and the statement that sets it.
record Settled { key: Text, value: Value?, set: Node }

fn nothing-settled() -> [Settled] = []

fn value-named(known: [Settled], x: Text) -> Value? = last s in known if s.key == x: s.value

# The function that fills an enum in, called on what `outer` evaluates to. Pure when every value
# is known here.
fn enum-call(n: Node, outer: Node) -> Node = match n {
  TsEnum(name, List(members...)) => marked-pure(call, all s in settled: is-some(s.value))
    where param = fresh-name(name.text),
          p = bind(param),
          a = ident(param),
          settled = fold done = nothing-settled() for m in members: done ++ [member-settled(done, m, name.text, param, a)],
          body = [s.set for s in settled] ++ [stmt`return $a;`],
          call = exp`(($p) => { $$body })($outer)`
  _ => panic "expected an enum"
}

# A member without an initializer counts on from a number before it; one whose initializer is not
# known here is computed when the enum is made, where earlier members' bare names mean them.
fn member-settled(done: [Settled], m: Node, self: Text, param: Text, a: Node) -> Settled = match m.init {
  None() => Settled(key: k, value: some(number-value(v)), set: stmt`$a[$a[$key] = $number] = $key;`)
    where v = (following(done) ?? panic "enum member {} needs an initializer: the one before it is not a number known here", k),
          number = number-node(v)
  init => match evaluated(lowered(init), done, self) {
    some(v) if v.is-text => Settled(key: k, value: some(v), set: stmt`$a[$key] = $text;`) where text = v.node
    some(v) => Settled(key: k, value: some(v), set: stmt`$a[$a[$key] = $number] = $key;`) where number = number-node(v.num)
    none => Settled(key: k, value: none, set: stmt`$a[$a[$key] = $computed] = $key;`)
      where computed = with-members(lowered(init), [s.key for s in done], param)
  }
} where k = member-key(m.key),
        key = string-node(k)

# The number after the last member's, if that was a number known here.
fn following(done: [Settled]) -> Int? = match done {
  [] => some(0)
  [..., d] => first v in d.value if not v.is-text: v.num + 1
}

fn enum-name(n: Node) -> Text = n.name.text

# `var E = ((E2) => { … })(E || {});`
fn enum-declarator(n: Node) -> Node = Declarator(n.name, enum-call(n, Or(ident(n.name.text), ObjectLit(List())))) with { lo: n.lo, hi: n.hi }

# ---------------------------------------------------------------- namespaces

# Which names an inner scope takes for itself, so the namespace's do not reach in.
fn shadowed-by(n: Node) -> [Text] = match n {
    _ if sc.scope-kind(n.kind) == "function" => [function-shadows(k)... for k in n.kids]
    Block(List(ss...)) | TryBlock(List(ss...)) => block-shadows(ss)
    Switch(_, List(cases...)) => [block-shadows(c.stmts.kids)... for c in cases]
    For(LetInit(_) | ConstInit(_), ...) => early.bound-names(n.init)
    ForIn(LetLeft(_) | ConstLeft(_), ...) => early.bound-names(n.left)
    ForOf(_, LetLeft(_) | ConstLeft(_), ...) => early.bound-names(n.left)
    Catch(CatchHead(_), ...) => early.bound-names(n.param)
    _ => []
}

fn function-shadows(k: Node) -> [Text] = match k {
  Params(_) | BindName(_) => early.bound-names(k)
  FuncBody(List(ss...)) => [(early.var-names(s) ++ early.lexical-names(s, true))... for s in ss]
  _ => []
}

fn block-shadows(ss: [Node]) -> [Text] = [(early.lexical-names(s, false) ++ early.block-functions(s, false))... for s in ss]

# References to a namespace's exported variables read and write its object, wherever they are.
fn through-namespace(n: Node, names: [Text], param: Text) -> Node = match n {
  _ if len(names) == 0 => n
  Ident(x) if x in names => Member(ident(param), PropName(x)) with { lo: n.lo, hi: n.hi }
  Shorthand(Ident(x)) if x in names => Prop(PropName(x), Member(ident(param), PropName(x))) with { lo: n.lo, hi: n.hi }
  _ if len(n.kids) == 0 => n
  _ => n with { kids: [through-namespace(k, inner, param) for k in n.kids] }
    where inner = match shadowed-by(n) {
      [] => names
      hidden => [x for x in names if not (x in hidden)]
    }
}

# The variables a namespace's body exports.
fn exported-variables(stmts: [Node]) -> [Text] = [declarator-name(d) for s in stmts for d in exported-declarators(s)]

fn exported-declarators(s: Node) -> [Node] = match s {
  ExportVar(List(ds...)) => ds
  ExportLexical(d) => d.declarators.kids
  _ => []
}

fn declarator-name(d: Node) -> Text = match d {
  Declarator(BindName(x), _) => x
  _ => panic "destructuring in `export` inside a namespace is not implemented yet"
}

fn assign-out(param: Text, name: Text, value: Node) -> Node = stmt`$ns.$name = $value;` where ns = ident(param)

# One statement of a namespace's body, with its `export` turned into an assignment.
fn namespace-statement(s: Node, param: Text) -> [Node] = match s {
  ExportVar(List(ds...)) => export-declarators(ds, param)
  ExportLexical(d) => export-declarators(d.declarators.kids, param)
  ExportFunction(f) => lowered-statements([f]) ++ [assign-out(param, f.name.text, ident(f.name.text))]
  ExportClass(c) => lowered-statements([c]) ++ [assign-out(param, c.name.text, ident(c.name.text))]
  TsExportEnum(e) => [stmt`let $holder;`, ExprStmt(pure-off(enum-call(e, outer)))]
    where name = enum-name(e),
          holder = bind(name),
          ns1 = ident(param),
          ns2 = ident(param),
          local = ident(name),
          outer = exp`$local = $ns1.$name || ($ns2.$name = {})`
  TsExportNamespace(TsNamespace(name, body)) => nested-namespace(name.text, body, param)
  TsExportImport(TsImportAlias(name, target)) => [assign-out(param, name.text, target)]
  TsExportImport(TsImportRequire(name, from)) => [assign-out(param, name.text, exp`$req($from)`)] where req = ident("require")
  ExportNamed(List(specs...)) =>
    [assign-out(param, exported-as(spec).text, ident(spec.local.text)) for spec in specs if spec is ExportName(_) | ExportAs(_, _)]
  _ => lowered-statements([s])
}

fn exported-as(spec: Node) -> Node = match spec {
  ExportAs(_, to) => to
  _ => spec.local
}

# A call lowering makes, and whether it may go if nothing uses its value.
fn marked-pure(call: Node, pure-call: Bool) -> Node = match pure-call {
  true => call with { lo: unplaced, hi: unplaced-pure }
  false => call with { lo: unplaced, hi: unplaced }
}

# An enum exported from a namespace is stored where its value is read: not a call that may go.
fn pure-off(n: Node) -> Node = match n.hi {
  hi if hi == unplaced-pure => n with { hi: unplaced }
  _ => n
}

# ---------------------------------------------------------------- placing what lowering made

# Each unplaced node takes an offset, -1001 and down in the order a walk of the tree meets them;
# those that ended at `unplaced-pure` are the calls that may go.
record Numbered { node: Node, next: Int, pure: [Int] }
record Numbering { nodes: [Node], next: Int, pure: [Int] }

# A program's statements placed in turn. A statement with nothing unplaced in it stays as it is.
fn placed-program(program: Node) -> Numbered = match program {
  Program(hashbang, List(stmts...)) =>
    Numbered(node: Program(hashbang, List(all.nodes...)) with { lo: program.lo, hi: program.hi }, next: all.next, pure: all.pure)
    where all = fold a = Numbering(nodes: [], next: unplaced - 1, pure: []) for s in stmts:
                  (a with { nodes: a.nodes ++ [q.node], next: q.next, pure: q.pure }
                   where q = match unplaced-in?(s) {
                     true => node-placed(s, a.next, a.pure)
                     false => Numbered(node: s, next: a.next, pure: a.pure)
                   })
}

fn unplaced-in?(n: Node) -> Bool = n.lo == unplaced or (any k in n.kids: unplaced-in?(k))

# A node placed, if it is unplaced, then its children in order.
fn node-placed(n: Node, next: Int, pure: [Int]) -> Numbered = match n.lo == unplaced {
  true => kids-placed(n with { lo: next, hi: next }, next - 1, pure ++ [next for hi in [n.hi] if hi == unplaced-pure])
  false => kids-placed(n, next, pure)
}

fn kids-placed(n: Node, next: Int, pure: [Int]) -> Numbered = match n.kids {
  [] => Numbered(node: n, next: next, pure: pure)
  kids => Numbered(node: n with { kids: all.nodes }, next: all.next, pure: all.pure)
    where all = fold a = Numbering(nodes: [], next: next, pure: pure) for k in kids:
                  (a with { nodes: a.nodes ++ [q.node], next: q.next, pure: q.pure } where q = node-placed(k, a.next, a.pure))
}

fn export-declarators(ds: [Node], param: Text) -> [Node] = match ds {
  _ if any d in ds: not (d is Declarator(BindName(_), _)) => panic "destructuring in `export` inside a namespace is not implemented yet"
  _ => [assign-out(param, x, lowered(init)) for Declarator(BindName(x), init) in ds if not (init is None())]
}

# The function a namespace's body becomes, or nothing if the body held only types.
fn namespace-call(name: Text, body: Node, outer: Node) -> Node? = match namespace-body(namespace-path ++ "." ++ name, body, param) {
  [] => none
  stmts => some(exp`(($p) => { $$stmts })($outer)`) where p = bind(param)
} where param = fresh-name(name)

# What the namespace at `path` holds, as statements of the function its body becomes. Every body of
# one namespace exports into the same object: what earlier ones exported is read through it.
fn namespace-body(path: Text, body: Node, param: Text) -> [Node] = with namespace-path = path {
  match body {
    TsNamespaceNested(inner, rest) => nested-namespace(inner.text, rest, param)
    TsNamespaceBlock(List(ss...)) => [through-namespace(s, exported, param) for s in [namespace-statement(s, param)... for s in ss]]
      where exported = namespace-exports[body.lo] ?? panic "a namespace body that was not found ahead"
    _ => panic "unexpected namespace body"
  }
}

# A namespace body: where it is, the namespace's path, and what it exports itself.
record Body { at: Int, path: Text, own: [Text] }

# Every namespace body in a tree, in the order lowering meets them: a body before what is in it.
fn namespace-bodies(n: Node, path: Text) -> [Body] = match n {
  TsNamespace(name, body) => namespace-chain(body, path ++ "." ++ name.text)
  _ => [b for k in n.kids for b in namespace-bodies(k, path)]
}

fn namespace-chain(body: Node, path: Text) -> [Body] = match body {
  TsNamespaceNested(inner, rest) => namespace-chain(rest, path ++ "." ++ inner.text)
  TsNamespaceBlock(List(ss...)) => [Body(at: body.lo, path: path, own: exported-variables(ss))] ++ [b for s in ss for b in namespace-bodies(s, path)]
  _ => []
}

# What each namespace has exported so far, and so each body's exports.
record Exports { by-path: {Text:[Text]}, at: {Int:[Text]} }

fn exports-at(tree: Node) -> {Int:[Text]} =
  (fold e = Exports(by-path: {}, at: {}) for b in namespace-bodies(tree, ""):
     (e with { by-path: e.by-path ++ {b.path: all}, at: e.at ++ {b.at: all} } where all = (e.by-path[b.path] ?? []) ++ b.own)).at

# `let M; ((M2) => { … })(M = N2.M || (N2.M = {}));`
fn nested-namespace(name: Text, body: Node, param: Text) -> [Node] = match namespace-call(name, body, outer) {
  some(call) => [stmt`let $holder;`, ExprStmt(call)] where holder = bind(name)
  none => []
} where ns1 = ident(param),
        ns2 = ident(param),
        local = ident(name),
        outer = exp`$local = $ns1.$name || ($ns2.$name = {})`

# What lowering a statement of a list made, and the name it declared for the statements after it.
record Step { nodes: [Node], declares: [Text] }

# `var N; ((N2) => { … })(N || (N = {}));`, without the `var` if something already declares N.
fn namespace-step(n: Node, exported: Bool, declared: [Text]) -> Step = match n {
  TsNamespace(name, body) => match namespace-call(name.text, body, outer) {
    none => Step(nodes: [], declares: [])
    some(call) if name.text in declared => Step(nodes: [ExprStmt(call)], declares: [])
    some(call) => Step(nodes: [match exported {
                                  true => ExportVar(List(holder))
                                  false => VarDecl(List(holder))
                                }, ExprStmt(call)],
                       declares: [name.text])
      where holder = Declarator(name, None()) with { lo: n.lo, hi: n.hi }
  } where again1 = ident(name.text),
          again2 = ident(name.text),
          outer = exp`$again1 || ($again2 = {})`
  _ => panic "expected a namespace"
}

# ---------------------------------------------------------------- classes

fn param-of(p: Node) -> Node = match p {
  TsParamProp(target, init) => Param(lowered(target), lowered(init)) with { lo: p.lo, hi: p.hi }
  _ => lowered(p)
}

# Directives stay first, and in a derived class `this` is only there after `super()`.
fn assignments-at(stmts: [Node]) -> Int =
  (first i in 0..len(stmts) if stmts[i] is ExprStmt(CallExpr(Super(), _)): i + 1) ?? len([s for s in stmts while s is ExprStmt(Str(_))])

# The constructor, with what it now sets right after `super()`: parameter properties, then fields.
fn constructor-with-assignments(m: Node, assigns: [Node]) -> Node = match m {
  Method(key, Params(List(ps...)), FuncBody(List(ss...))) =>
    m with { params: Params(List([param-of(p) for p in ps]...)) with { lo: m.params.lo, hi: m.params.hi },
             body: FuncBody(List((body[0..at] ++ assigns ++ body[at..len(body)])...)) with { lo: m.body.lo, hi: m.body.hi } }
    where body = lowered-statements(ss),
          at = assignments-at(body)
  _ => panic "expected a constructor"
}

fn constructor?(m: Node) -> Bool = m is Method(PropName("constructor"), _, _)

fn parameter-properties(m: Node) -> [Node] = match m {
  Method(_, Params(List(ps...)), _) => [p for p in ps if p is TsParamProp(...)]
  _ => []
}

# `this.x = v`, `this["a b"] = v`, `this.#x = v`.
fn assigned(target: Node, key: Node, value: Node) -> Node = ExprStmt(Assignment(place, AssignOp("="), value))
  where place = match key {
    PropName(_) | PrivateName(_) => Member(target, key)
    Str(_) | Num(_) => Index(target, key)
    _ => panic "a computed field name with useDefineForClassFields false is not implemented yet"
  }

fn prop-assignment(p: Node) -> Node = stmt`this.$name = $value;`
  where name = p.target.text,
        value = ident(name)

# Where a member goes: kept in the class, or set by the constructor.
record Placed { kept: [Node], assigns: [Node] }

fn member-placed(m: Node) -> Placed = match m {
  Field(key, init) if settings.assign-fields =>
    Placed(kept: [Field(key, None()) with { lo: m.lo, hi: m.hi } if key is PrivateName(_)],
           assigns: [assigned(This(), key, lowered(init)) if not (init is None())])
  StaticField(key, init) if settings.assign-fields =>
    Placed(kept: [StaticField(key, None()) with { lo: m.lo, hi: m.hi } if key is PrivateName(_)]
                 ++ [StaticBlock(FuncBody(List(assigned(This(), key, lowered(init))))) with { lo: m.lo, hi: m.hi }
                     if not (init is None())],
           assigns: [])
  TsErased() => Placed(kept: [], assigns: [])
  _ => Placed(kept: [lowered(m) if not constructor?(m)], assigns: [])
}

fn synthesized-constructor(derived: Bool) -> Node = Method(PropName("constructor"), Params(List()), FuncBody(List(calls...)))
  where calls = [stmt`super(...arguments);` for d in [derived] if d]

# A parameter property is a field, declared ahead of the others, set by the constructor. Without
# define semantics a field is an assignment there too, and a static one an assignment in a static
# block where it stood. A private field stays declared, since only the class can declare it.
fn class-body(n: Node, derived: Bool) -> Node = match n {
  ClassBody(List(members...)) => match props {
    [] if not (settings.assign-fields and (any m in members: m is Field(...) | StaticField(...))) => n with { members: lowered(n.members) }
    _ => n with { members: List((made ++ declared ++ [k for c in each for k in c.kept])...) with { lo: n.members.lo, hi: n.members.hi } }
      where from-props = [prop-assignment(p) for p in props],
            each = [member-placed(m) for m in members],
            assigns = from-props ++ [s for c in each for s in c.assigns],
            existing = first m in members if constructor?(m): m,
            made = [constructor-with-assignments(existing ?? synthesized-constructor(derived), assigns)
                    for x in [assigns] if len(x) > 0 or is-some(existing)],
            declared = [Field(PropName(p.target.text) with { lo: p.target.lo, hi: p.target.hi }, None()) with { lo: p.lo, hi: p.hi }
                        for p in props if not settings.assign-fields]
  } where props = [parameter-properties(m)... for m in members if constructor?(m)]
  _ => panic "expected a class body"
}

# ---------------------------------------------------------------- decorators

fn helper-ref(name: Text) -> Node = ident(name)

# The runtime helpers the lowered program calls: names this file made, not names it was written with.
everywhere fn helpers-called(n: Node) -> [Text] = match n {
  Ident(x) if n.lo < 0 and starts-with(x, "__decorate") => [x]
}

fn decorators-of(list: Node) -> [Node] = [lowered(d.expr) for d in list.kids]

fn member-core(m: Node) -> Node = match m {
  TsDecoratedMember(_, inner) => inner
  _ => m
}

fn static-member?(m: Node) -> Bool = member-core(m) is StaticMethod(_) | StaticField(...)

fn member-inner(m: Node) -> Node = match member-core(m) {
  StaticMethod(x) => x
  other => other
}

# esbuild's kinds: 1 for a method or accessor, 2 for a field.
fn member-kind(m: Node) -> Int = match member-inner(m) {
  Field(...) | StaticField(...) => 2
  _ => 1
}

fn decorated-key(m: Node) -> Node = match member-inner(m).key {
  PropName(x) => string-node(x)
  Str(raw) => Str(raw)
  Num(t) => string-node(t)
  PrivateName(_) => panic "a decorator on a private member is not allowed"
  _ => panic "a decorator on a member with a computed name is not implemented yet"
}

fn params-of-member(m: Node) -> [Node] = match member-inner(m) {
  Method(_, Params(List(ps...)), _) | GenMethod(_, Params(List(ps...)), _) | AsyncMethod(_, Params(List(ps...)), _)
    | AsyncGenMethod(_, Params(List(ps...)), _) | Setter(_, Params(List(ps...)), _) => ps
  _ => []
}

# `__decorateParam(i, d)` for each decorated parameter.
fn param-decorators(ps: [Node]) -> [Node] =
  [decorate-param(i, d) for i in 0..len(ps) if let TsDecoratedParam(List(ds...), _) = ps[i] for d in ds]

fn decorate-param(i: Int, d: Node) -> Node = exp`$f($index, $dec)`
  where index = Num(int-text(i)),
        f = helper-ref("__decorateParam"),
        dec = lowered(d.expr)

# The class without its decorators: they become calls after it.
everywhere fn undecorated(n: Node) -> Node = match n {
  TsDecoratedMember(_, inner) => undecorated(inner)
  TsDecoratedParam(_, inner) => inner
}

everywhere fn decorated-anything?(n: Node) -> Bool = match n {
  TsDecoratedMember(...) | TsDecoratedParam(...) => true
}

fn decorate-call(decorators: [Node], target: Node, key: Node?, kind: Int) -> Node = match key {
  some(k) => exp`$f($list, $target, $k, $kind_node)` where kind-node = Num(int-text(kind))
  none => exp`$f($list, $target)`
} where f = helper-ref("__decorateClass"),
        list = match decorators {
          [init..., x] => ArrayLit(List(([Elem(d) for d in init] ++ [ElemLast(x)])...))
          [] => ArrayLit(List())
        }

# `class A { @d m() {} }` and `@c class A {}`, as TypeScript's experimentalDecorators runs them:
# members first, instance before static, then the class, which the decorators may replace.
fn decorated-class(class-decorators: [Node], cls: Node, exported: Bool) -> [Node] = match settings.decorators {
  false => panic "JavaScript decorators are not implemented yet; set \"experimentalDecorators\": true in tsconfig.json for TypeScript's"
  true => [match exported {
             true => ExportClass(plain) with { lo: cls.lo, hi: cls.hi }
             false => plain
           }] ++ after
    where name = cls.name.text,
          each = [member-decorating(m, name, pass) for pass in [false, true] for m in cls.body.members.kids
                  if not (member-core(m) is ClassEmpty() | TsErased()) and static-member?(m) == pass],
          whole = class-decorators ++ ((last d in each: d.constructor) ?? []),
          after = [s for d in each for s in d.after] ++ class-decorating(whole, name),
          plain = lowered(undecorated(cls))
}

# What a member's decorators become: for the constructor, the decorators of its parameters, which
# decorate the class; for any other, a call after the class.
record Decorating { constructor: [Node]?, after: [Node] }

fn member-decorating(m: Node, name: Text, static: Bool) -> Decorating = match member-core(m) {
  Method(PropName("constructor"), ...) => Decorating(constructor: some(param-decorators(params-of-member(m))), after: [])
  _ => match own-decorators(m) ++ param-decorators(params-of-member(m)) {
    [] => Decorating(constructor: none, after: [])
    all-decorators => Decorating(constructor: none, after: [ExprStmt(decorate-call(all-decorators, target, some(decorated-key(m)), member-kind(m)))])
      where holder = ident(name),
            target = match static {
              true => holder
              false => Member(holder, PropName("prototype"))
            }
  }
}

fn own-decorators(m: Node) -> [Node] = match m {
  TsDecoratedMember(List(ds...), _) => [lowered(d.expr) for d in ds]
  _ => []
}

# `C = __decorateClass([…], C)`, when anything decorates the class itself.
fn class-decorating(decorators: [Node], name: Text) -> [Node] = match decorators {
  [] => []
  _ => [stmt`$holder = $value;`]
    where holder = ident(name),
          value = decorate-call(decorators, ident(name), none, 0)
}

# ---------------------------------------------------------------- the walk

# Names the statements in one list declare by way of a function or a class, which a namespace or
# an enum of the same name extends rather than declares again.
fn declared-names(stmts: [Node]) -> [Text] =
  [declared-name(s)... for s in stmts]

fn declared-name(s: Node) -> [Text] = match s {
  FuncDecl(name, ...) | GenDecl(name, ...) | AsyncFuncDecl(name, ...) | AsyncGenDecl(name, ...)
    | ClassDecl(name, ...) => [name.text]
  ExportFunction(d) | ExportClass(d) => [d.name.text]
  _ => []
}

# A statement list lowered, one statement after another: a namespace that one of them declares, those
# after it do not declare again.
record Listed { out: [Node], declared: [Text] }

fn lowered-statements(xs: [Node]) -> [Node] =
  (fold l = Listed(out: [], declared: declared-names(xs)) for x in xs:
     (l with { out: l.out ++ step.nodes, declared: l.declared ++ step.declares } where step = statement-step(x, l.declared))).out

fn statement-step(x: Node, declared: [Text]) -> Step = match x {
  TsNamespace(...) => namespace-step(x, false, declared)
  TsExportNamespace(n) => namespace-step(n, true, declared)
  _ => Step(nodes: statement-lowered(x), declares: [])
}

fn statement-lowered(x: Node) -> [Node] = match x {
  TsErased() => []
  TsDecoratedClass(List(ds...), cls) => decorated-class([lowered(d.expr) for d in ds], cls, false)
  TsDecoratedExport(List(ds...), cls) | TsExportDecorated(List(ds...), cls) =>
    decorated-class([lowered(d.expr) for d in ds], cls, true)
  TsDecoratedDefault(...) | TsDefaultDecorated(...) => panic "a decorated `export default class` is not implemented yet; name the class and export it"
  ClassDecl(...) if decorated-anything?(x) => decorated-class([], x, false)
  ExportClass(c) if decorated-anything?(c) => decorated-class([], c, true)
  TsEnum(...) => [VarDecl(List(enum-declarator(x))) with { lo: x.lo, hi: x.hi }]
  TsExportEnum(e) => [ExportVar(List(enum-declarator(e))) with { lo: x.lo, hi: x.hi }]
  TsNamespace(...) | TsExportNamespace(_) => (statement-step(x, []).nodes)
  TsImportRequire(name, from) | TsExportImport(TsImportRequire(name, from)) => [match x {
      TsExportImport(_) => ExportLexical(ConstDecl(d))
      _ => ConstDecl(d)
    }] where req = ident("require"),
             required = exp`$req($from)`,
             d = List(Declarator(name, required) with { lo: x.lo, hi: x.hi })
  TsImportAlias(name, target) =>
    [ConstDecl(List(Declarator(name, target) with { lo: x.lo, hi: x.hi })) with { lo: x.lo, hi: x.hi }]
  TsExportImport(TsImportAlias(name, target)) =>
    [ExportLexical(ConstDecl(List(Declarator(name, target) with { lo: x.lo, hi: x.hi }))) with { lo: x.lo, hi: x.hi }]
  TsExportAssign(e) => [stmt`$holder.exports = $value;`]
    where value = lowered(e),
          holder = ident("module")
  # `import {type A} from "x"` and its like are gone once their specifiers are.
  Import(ImportNamed(List(specs...)), _, _) | ExportNamed(List(specs...)) | ExportFrom(List(specs...), _, _)
    if len(specs) > 0 and (all s in specs: s is TsErased()) => []
  _ => [lowered(x)]
}

fn lowered(n: Node) -> Node = match n {
  List(xs...) => n with { kids: lowered-statements(xs) }
  TsDecoratedClassExpr(...) => panic "a decorated class expression is not implemented yet; declare the class"
  TsDecoratedMember(...) | TsDecoratedParam(...) => panic "decorators in a class expression are not implemented yet; declare the class"

  ClassDecl(name, heritage, body) | ClassExpr(name, heritage, body) =>
    n with { kids: [lowered(name), lowered(heritage), class-body(body, not (heritage is None()))] }
  ClassBody(...) => class-body(n, false)
  TsParamProp(...) => panic "a parameter property is only allowed in a constructor"
  _ if len(n.kids) == 0 => n
  _ => n with { kids: [lowered(k) for k in n.kids] }
}

# ---------------------------------------------------------------- imports that named only types

# Is this symbol's name mentioned as a value? `export { A }` counts: a value, as far as one file
# can tell.
everywhere fn value-mentions(n: Node, b: {Int:Int}) -> [Int] = match n {
  Ident(_) => [s if let some(s) = b[n.lo]]
  ExportNamed(...) => []
}

everywhere fn export-mentions(n: Node) -> [Text] = match n {
  ExportNamed(List(specs...)) => [x.text for ExportName(x) | ExportAs(x, _) in specs]
}

fn keep-binding?(bound: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text]) -> Bool =
  bound.text in keep or bound.text in exported or (all s in b[bound.lo]: s in used)

fn pruned-clause(c: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text]) -> Node? = match c {
  ImportDefault(x) | ImportNamespace(x) => first y in [c] if keep-binding?(x, b, used, exported, keep): y
  ImportNamed(List(specs...)) => match [s for s in specs if keep-binding?(s.name, b, used, exported, keep)] {
    [] => none
    left => some(c with { specs: List(left...) with { lo: c.specs.lo, hi: c.specs.hi } })
  }
  ImportDefaultAnd(x, rest) => match keep-binding?(x, b, used, exported, keep), pruned-clause(rest, b, used, exported, keep) {
    true, some(r) => some(c with { kids: [x, r] })
    false, some(r) => some(r)
    true, none => some(ImportDefault(x) with { lo: c.lo, hi: c.hi })
    false, none => none
  }
  _ => some(c)
}

# `import x = a.b` not exported, by where its name is: it is dropped when nothing uses it.
everywhere fn alias-names(n: Node) -> [Int] = match n {
  TsImportAlias(name, _) => [name.lo]
  TsExportImport(_) => []
}

fn alias-unused?(s: Node, b: {Int:Int}, used: {Int:Bool}, aliases: {Int:Bool}) -> Bool = match s {
  ConstDecl(List(Declarator(name, _))) => name.lo in aliases and not (b[name.lo] is some(_) and (b[name.lo] ?? -1) in used)
  _ => false
}

# Drop aliases nothing uses, at any depth: what they point at may be a type.
everywhere fn without-aliases(n: Node, b: {Int:Int}, used: {Int:Bool}, aliases: {Int:Bool}) -> Node = match n {
  List(xs...) => n with { kids: [without-aliases(x, b, used, aliases) for x in xs if not alias-unused?(x, b, used, aliases)] }
}

fn pruned(tree: Node, keep: [Text], aliases: {Int:Bool}) -> Node =
  Program(tree.hashbang, List([pruned-statement(s, bindings, used, exported, keep, names)... for s in plain.kids]...))
  where bindings = sc.analysis(tree, []).bindings,
        used = {s: true for s in value-mentions(tree, bindings)},
        exported = {x: true for x in export-mentions(tree)},
        plain = without-aliases(tree.body, bindings, used, aliases),
        names = early.module-names(tree.body.kids)

fn pruned-statement(s: Node, b: {Int:Int}, used: {Int:Bool}, exported: {Text:Bool}, keep: [Text], declared: [Text]) -> [Node] = match s {
  Import(_, _, _) if settings.keeping-imports => [s]
  Import(clause, from, attributes) => [s with { kids: [c, from, attributes] } if let some(c) = pruned-clause(clause, b, used, exported, keep)]
  # What is exported but not declared was a type.
  ExportNamed(List(specs...)) => match [x for x in specs if x.local.text in declared] {
    [] if len(specs) > 0 => []
    left => [s with { specs: List(left...) with { lo: s.specs.lo, hi: s.specs.hi } }]
  }
  _ => [s]
}

# ---------------------------------------------------------------- the whole file

fn lowered-file(whole: Node, keep: [Text], decorators: Bool, tree: Node) -> Lowered =
  Lowered(tree: pruned(p.node, keep, {lo: true for lo in alias-names(tree)}), pure-calls: {at: at for at in p.pure},
          helpers: [h for h in helpers-called(p.node) if decorators distinct h])
  where p = placed-program(whole)

fn lower(tree: Node, source: Text, keep: [Text], define-fields: Bool, keep-imports: Bool, decorators: Bool) -> Lowered =
  with settings = Settings(src: source, assign-fields: not define-fields, keeping-imports: keep-imports, decorators: decorators),
       namespace-exports = exports-at(tree) {
    lowered-file(Program(tree.hashbang, List(lowered-statements(tree.body.kids)...)), keep, decorators, tree)
  }
