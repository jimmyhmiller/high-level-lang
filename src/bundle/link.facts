# ES module linking and tree shaking, as Datalog. Everything is an interned id.
facts

# Module structure, extracted by bundle.graph.
relation local-export(module, name, symbol)
relation reexport(module, name, target, target-name)
relation star(module, target)
# The name `default`, which `export *` never passes on.
relation default-name(name)

# What the import statements bound.
relation import-of(symbol, target, name)

# Where each import, and each name an `export … from` takes, is written: the module and offset.
relation import-at(symbol, module, at)
relation reexport-at(module, name, at)
# A script, which exports nothing; TypeScript, whose imports may name types, which have no export.
relation script(module)
relation typescript(module)

# Statement ("part") structure.
relation part-of(part, module)
relation declares(part, symbol)
relation mentions(part, symbol)
relation effect(part)
relation imports(module, target)
relation module-effects(module)
relation entry(module)
relation wrapped(module)
relation root-part(part)

# What a name exported from a module means. A module's own exports beat `export *`.
relation own-export(module, name)
own-export(M, N) :- local-export(M, N, S) ;
own-export(M, N) :- reexport(M, N, T, TN) ;

relation resolved(module, name, symbol)
resolved(M, N, S) :- local-export(M, N, S) ;
resolved(M, N, T) :- local-export(M, N, S), import-of(S, D, DN), resolved(D, DN, T) ;
resolved(M, N, S) :- reexport(M, N, T, TN), resolved(T, TN, S) ;
resolved(M, N, S) :- star(M, T), !default-name(N), resolved(T, N, S), !own-export(M, N) ;

# What a part reads besides the symbols it mentions, which it reads too: whatever a mention of an
# import resolves to. Rules that follow what a part reads follow `mentions` and `uses` both.
relation uses(part, symbol)
# A part mentions a name it imports from a module. Found from the imports, which are fewer.
relation via(part, module, name)
via(P, D, N) :- import-of(S, D, N), mentions(P, S) ;
via(P, D, N) :- prop-reads(P, S), import-of(S, D, N) ;
uses(P, T) :- via(P, D, N), resolved(D, N, T), !ambiguous(D, N) ;

# Namespace objects. A namespace part reads every export of its module. `ns.name`
# with a known name is treated as the export itself, so it does not pull in the object.
relation ns-part(part, module)
relation ns-symbol(module, symbol)
relation ns-import(symbol, module)
relation ns-member(part, module, name)

# A name two `export *` give as two bindings, neither an import: as esbuild has it, nothing exports
# it (bundle.emit's `resolved-export` reads it as `undefined`), so reading it reads neither.
relation import-symbol(symbol)
import-symbol(S) :- import-of(S, D, N) ;
import-symbol(S) :- ns-import(S, D) ;
relation ambiguous(module, name)
ambiguous(M, N) :- resolved(M, N, S), resolved(M, N, T), S != T, !import-symbol(S), !import-symbol(T) ;

resolved(M, N, T) :- local-export(M, N, S), ns-import(S, D), ns-symbol(D, T) ;
uses(P, S) :- ns-part(P, M), resolved(M, N, S) ;
uses(P, T) :- ns-import(S, M), mentions(P, S), ns-symbol(M, T) ;
uses(P, T) :- prop-reads(P, S), ns-import(S, M), ns-symbol(M, T) ;
uses(P, T) :- ns-member(P, M, N), resolved(M, N, T), !ambiguous(M, N) ;

# `export *` from CommonJS: names only known at run time, read from the namespace object.
# `z.x` of a named import `z` (`import { z } from "zod"`). When `z` is a module's namespace object
# (`export * as z`, or `import * as z; export { z }`), the read uses that module's `x` and nothing
# else, as for `import * as ns`: the namespace object and what it does not use stay out. Otherwise
# it reads `z`.
relation import-member(part, symbol, name)
relation namespace-of-import(symbol, module)
relation namespace-import(symbol)
namespace-import(S) :- namespace-of-import(S, M) ;
via(P, D, DN) :- import-member(P, S, N), import-of(S, D, DN), !namespace-import(S) ;
# It reads `x` of that module: what it resolves to, and what reading a module's name brings with
# it (that module's evaluation, for one, top-level `await` included).
via(P, M, N) :- import-member(P, S, N), namespace-of-import(S, M) ;

# A `const` that is another name's value (`const api = ns`), and `api.x` read in a part. Where the
# name is a namespace object, through any `const`s, imports and re-exports, so is the `const`, and
# reading `api.x` is reading that module's `x`, as `ns.x` is; else it reads `api`, as before.
relation const-alias(symbol, aliased)
# A name its module assigns or writes through: no alias of a namespace, and an object read whole.
relation written(symbol)
relation alias-member(part, symbol, name)
relation namespace-symbol(symbol, module)
relation aliased-namespace(symbol)
namespace-symbol(S, M) :- ns-import(S, M) ;
namespace-symbol(X, M) :- ns-symbol(M, X) ;
namespace-symbol(S, M) :- namespace-of-import(S, M) ;
namespace-symbol(A, M) :- const-alias(A, R), namespace-symbol(R, M), !written(A) ;
namespace-of-import(S, M) :- import-of(S, D, N), resolved(D, N, X), namespace-symbol(X, M) ;
aliased-namespace(A) :- namespace-symbol(A, M) ;
via(P, M, N) :- alias-member(P, A, N), namespace-symbol(A, M) ;
uses(P, A) :- alias-member(P, A, N), !aliased-namespace(A) ;
# What a `const` is the value of, through `const`s: reading a member of it passes through what that
# name passes through, as reading the member of the name would.
relation alias-root(symbol, of)
alias-root(A, R) :- const-alias(A, R) ;
alias-root(A, S) :- alias-root(A, R), const-alias(R, S) ;

# Object literals whose properties may go (`const O = { … }`): the part that declares O, each
# property that may go, and the symbols each reads. A property stays when the object is read whole
# (named as a value, here or through an import; read as a namespace's export; exported from an
# entry; or anything else that reads it besides a member by name), or when a live part reads it by
# name (`O.k`, here or through an import). What a property that stays reads is read by the part.
relation object-literal(symbol, part)
relation shakeable-prop(symbol, name)
relation prop-mentions(part, name, symbol)
relation object-symbol(symbol, object)
object-symbol(O, O) :- object-literal(O, P) ;
object-symbol(S, O) :- object-symbol(X, O), resolved(D, N, X), import-of(S, D, N) ;
relation member-path(part, object)
member-path(Q, O) :- object-symbol(A, O), alias-member(Q, A, K) ;
member-path(Q, O) :- object-symbol(S, O), import-member(Q, S, K) ;
relation whole-path(part, object)
whole-path(Q, O) :- object-symbol(S, O), mentions(Q, S) ;
whole-path(Q, O) :- object-symbol(S, O), prop-reads(Q, S) ;
whole-path(Q, O) :- object-literal(O, P), resolved(M, N, O), ns-member(Q, M, N) ;
whole-path(Q, O) :- object-literal(O, P), resolved(M, N, O), import-member(Q, S, N), namespace-of-import(S, M) ;
whole-path(Q, O) :- object-literal(O, P), resolved(M, N, O), alias-member(Q, A, N), namespace-symbol(A, M) ;
whole-path(Q, O) :- object-literal(O, P), uses(Q, O), !member-path(Q, O) ;
relation member-read(object, name)
member-read(O, K) :- object-symbol(A, O), alias-member(Q, A, K), live(Q) ;
member-read(O, K) :- object-symbol(S, O), import-member(Q, S, K), live(Q) ;
relation whole-read(object)
whole-read(O) :- whole-path(Q, O), live(Q) ;
whole-read(O) :- object-literal(O, P), resolved(M, N, O), keep-exports(M) ;
whole-read(O) :- object-literal(O, P), written(O) ;
relation kept-prop(object, name)
kept-prop(O, K) :- shakeable-prop(O, K), whole-read(O) ;
kept-prop(O, K) :- shakeable-prop(O, K), member-read(O, K) ;
relation prop-reads(part, symbol)
prop-reads(P, S) :- object-literal(O, P), kept-prop(O, K), prop-mentions(P, K, S) ;

relation dyn-star(module, target)
relation dynamic(module)
dynamic(M) :- dyn-star(M, T) ;
dynamic(M) :- star(M, T), dynamic(T) ;
uses(P, T) :- via(P, D, N), dynamic(D), ns-symbol(D, T) ;
uses(P, T) :- ns-member(P, M, N), dynamic(M), ns-symbol(M, T) ;

# A name imported or re-exported from a module held in an import variable reads the variable its
# statement declares; a CommonJS statement's own names are its statement's too.
relation cjs-binding(symbol, part)
live(P) :- live(Q), mentions(Q, S), cjs-binding(S, P) ;
live(P) :- prop-reads(Q, S), live(Q), cjs-binding(S, P) ;
live(P) :- live(Q), uses(Q, S), cjs-binding(S, P) ;
live(P) :- keep-exports(M), resolved(M, N, S), cjs-binding(S, P) ;

# Whatever an entry exports stays, when the output format exposes it.
relation keep-exports(module)
live(P) :- keep-exports(M), resolved(M, N, S), declares(P, S) ;

# Tree shaking. A module is included if it is an entry, if a live statement is in it,
# or if an included module imports it and it may have side effects.
relation included(module)
relation live(part)
included(M) :- entry(M) ;
included(M) :- live(P), part-of(P, M) ;
included(D) :- included(M), imports(M, D), module-effects(D) ;
# Following a name through a module's own re-export uses that module, even one with no side effects
# of its own to justify it. Passing through its `export *` does not.
# Only a module that passes names on is ever asked what was visited in it, so only its visits are kept.
relation forwards(module)
forwards(M) :- reexport(M, N, T, TN) ;
forwards(M) :- local-export(M, N, S), import-of(S, D, DN) ;
forwards(M) :- local-export(M, N, S), ns-import(S, D) ;
forwards(M) :- local-export(M, N, S), ns-symbol(D, S) ;
forwards(M) :- star(M, T) ;
relation visits(module, name)
visits(D, N) :- live(P), via(P, D, N), forwards(D) ;
# `z.x` of an import that is a namespace still passes through what forwards `z` to it, as reading
# `z` would: that module is visited (and so initialized, before what reads it), though its
# namespace object is not used.
visits(D, DN) :- live(P), import-member(P, S, N), import-of(S, D, DN), forwards(D) ;
visits(M, N) :- live(P), ns-member(P, M, N), forwards(M) ;
visits(D, DN) :- alias-member(P, A, N), live(P), alias-root(A, S), import-of(S, D, DN), forwards(D) ;
visits(M, N) :- alias-member(P, A, N), live(P), alias-root(A, S), ns-import(S, M), aliased-namespace(A), forwards(M) ;
visits(M, N) :- live(P), ns-part(P, M), forwards(M), resolved(M, N, S) ;
visits(M, N) :- keep-exports(M), forwards(M), resolved(M, N, S) ;
visits(T, TN) :- visits(M, N), reexport(M, N, T, TN), forwards(T) ;
visits(D, DN) :- visits(M, N), local-export(M, N, S), import-of(S, D, DN), forwards(D) ;
visits(T, N) :- visits(M, N), star(M, T), forwards(T), !default-name(N), !own-export(M, N) ;
included(M) :- visits(M, N), reexport(M, N, T, TN) ;
included(M) :- visits(M, N), local-export(M, N, S), import-of(S, D, DN) ;
live(P) :- root-part(P) ;
live(P) :- included(M), part-of(P, M), effect(P) ;
# An import of a wrapped module calls its initialiser where it stands, once that module is in the
# output for whatever brought it in: a module with no side effects, nothing reads, is not. A module
# wrapped to run when first loaded (`delayed`: by `require`, or `import()` without splitting) that a
# name read passes through is in the output, though nothing of its own is read: its initialiser runs
# the one the name comes from.
relation inits(part, module)
relation delayed(module)
live(P) :- included(M), part-of(P, M), inits(P, T), included(T) ;
included(M) :- visits(M, N), delayed(M) ;
live(P) :- live(Q), mentions(Q, S), declares(P, S) ;
live(P) :- prop-reads(Q, S), live(Q), declares(P, S) ;
live(P) :- live(Q), uses(Q, S), declares(P, S) ;

# Code splitting. Each root (an entry, or what `import()` names) reaches statements exactly as the
# whole program does above. A chunk is then the files with the same set of roots.
relation chunk-root(module)
relation entered(root, module)
relation reaches(root, part)
relation root-visits(root, module, name)
entered(R, R) :- chunk-root(R) ;
# A root needs every live file its files import, whether or not it uses what that file holds;
# unless the file's package says it has no side effects, when only what the root uses of it, as
# below, brings it in.
entered(R, D) :- entered(R, M), imports(M, D), included(D), module-effects(D) ;
entered(R, M) :- reaches(R, P), part-of(P, M) ;
reaches(R, P) :- entered(R, M), part-of(P, M), effect(P) ;
reaches(R, P) :- entered(R, M), part-of(P, M), inits(P, T), entered(R, T) ;
reaches(R, P) :- reaches(R, Q), mentions(Q, S), declares(P, S) ;
reaches(R, P) :- prop-reads(Q, S), reaches(R, Q), declares(P, S) ;
reaches(R, P) :- reaches(R, Q), uses(Q, S), declares(P, S) ;
reaches(R, P) :- reaches(R, Q), mentions(Q, S), cjs-binding(S, P) ;
reaches(R, P) :- prop-reads(Q, S), reaches(R, Q), cjs-binding(S, P) ;
reaches(R, P) :- reaches(R, Q), uses(Q, S), cjs-binding(S, P) ;
reaches(R, P) :- chunk-root(R), keep-exports(R), resolved(R, N, S), declares(P, S) ;
reaches(R, P) :- chunk-root(R), keep-exports(R), resolved(R, N, S), cjs-binding(S, P) ;
root-visits(R, D, N) :- reaches(R, P), via(P, D, N) ;
root-visits(R, D, DN) :- reaches(R, P), import-member(P, S, N), import-of(S, D, DN) ;
root-visits(R, M, N) :- reaches(R, P), ns-member(P, M, N) ;
root-visits(R, D, DN) :- alias-member(P, A, N), reaches(R, P), alias-root(A, S), import-of(S, D, DN) ;
root-visits(R, M, N) :- alias-member(P, A, N), reaches(R, P), alias-root(A, S), ns-import(S, M), aliased-namespace(A) ;
root-visits(R, M, N) :- reaches(R, P), ns-part(P, M), resolved(M, N, S) ;
root-visits(R, R, N) :- chunk-root(R), keep-exports(R), resolved(R, N, S) ;
root-visits(R, T, TN) :- root-visits(R, M, N), reexport(M, N, T, TN) ;
root-visits(R, D, DN) :- root-visits(R, M, N), local-export(M, N, S), import-of(S, D, DN) ;
root-visits(R, T, N) :- root-visits(R, M, N), star(M, T), !default-name(N), !own-export(M, N) ;
entered(R, M) :- root-visits(R, M, N), reexport(M, N, T, TN) ;
entered(R, M) :- root-visits(R, M, N), delayed(M) ;
entered(R, M) :- root-visits(R, M, N), local-export(M, N, S), import-of(S, D, DN) ;

# Whole-module placement executes all live parts of an entered module, including namespace
# construction that only one root explicitly reads. Its dependencies must be available to every
# consumer of that module, rather than residing in an entry that imports the shared module.
relation module-consumer(root, module)
module-consumer(R, M) :- entered(R, M) ;
module-consumer(R, D) :- module-consumer(R, M), part-of(P, M), active-part(P), mentions(P, S), declares(Q, S), part-of(Q, D) ;
module-consumer(R, D) :- prop-reads(P, S), part-of(P, M), module-consumer(R, M), active-part(P), declares(Q, S), part-of(Q, D) ;
module-consumer(R, D) :- module-consumer(R, M), part-of(P, M), active-part(P), uses(P, S), declares(Q, S), part-of(Q, D) ;

# Fragment demand starts at observable entry exports. Initialization islands seed their own
# consumers in the placement model; reusing reaches() would also seed conservative effect facts
# for allocations the fragment analysis has proved inert (for example objects with getters).
relation fragment-export(root, part)
fragment-export(R, P) :- chunk-root(R), keep-exports(R), resolved(R, N, S), declares(P, S) ;
fragment-export(R, P) :- chunk-root(R), keep-exports(R), resolved(R, N, S), cjs-binding(S, P) ;

# Definition/initializer liveness is separate from source-code liveness. Retaining a guarded
# export-star barrel must not turn it into an included source module and thereby retain every
# side-effectful package it reexports. Its initializer only follows retained export paths.
relation initializes(part, module)
relation init-part(part, module)
relation init-needed(module)
relation init-live(part)
relation active-part(part)
relation active-module(module)
init-needed(M) :- init-part(P, M), included(M) ;
init-needed(M) :- init-part(P, M), visits(M, N), resolved(M, N, S) ;
init-live(P) :- init-part(P, M), init-needed(M) ;
init-live(P) :- included(M), part-of(P, M), initializes(P, D), init-needed(D) ;
init-live(P) :- init-needed(M), part-of(P, M), initializes(P, D), init-needed(D) ;
init-live(P) :- init-live(Q), mentions(Q, S), declares(P, S) ;
init-live(P) :- prop-reads(Q, S), init-live(Q), declares(P, S) ;
init-live(P) :- init-live(Q), uses(Q, S), declares(P, S) ;
init-live(P) :- init-live(Q), mentions(Q, S), cjs-binding(S, P) ;
init-live(P) :- prop-reads(Q, S), init-live(Q), cjs-binding(S, P) ;
init-live(P) :- init-live(Q), uses(Q, S), cjs-binding(S, P) ;
active-part(P) :- live(P) ;
active-part(P) :- init-live(P) ;
active-module(M) :- included(M) ;
active-module(M) :- init-live(P), part-of(P, M) ;
entered(R, D) :- entered(R, M), imports(M, D), init-needed(D) ;
reaches(R, P) :- entered(R, M), init-part(P, M), init-needed(M) ;
reaches(R, P) :- entered(R, M), part-of(P, M), initializes(P, D), init-needed(D) ;

# What is asked of a module that it does not export, as esbuild reports it: an import's name, or a
# name an `export … from` takes, whether or not anything uses it. A module whose exports are known
# only as it runs (CommonJS, `export *` from it) is never asked wrongly; a script exports nothing,
# and an import of it reads `undefined`; an import in TypeScript may be of a type. A name passed on
# by an `export … from` that is itself missing is reported where it is passed on.
relation exported(module, name)
exported(M, N) :- resolved(M, N, S) ;
relation missing-import(module, at, target, name)
missing-import(M, At, D, N) :- import-of(S, D, N), import-at(S, M, At), !typescript(M), !exported(D, N), !own-export(D, N), !dynamic(D), !script(D) ;
relation missing-reexport(module, at, target, name)
missing-reexport(M, At, T, TN) :- reexport(M, N, T, TN), reexport-at(M, N, At), !typescript(M), !exported(T, TN), !own-export(T, TN), !dynamic(T), !script(T) ;
