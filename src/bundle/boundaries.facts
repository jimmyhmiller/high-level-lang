# Execution environments and their import boundaries. A server walk stops at a client entry;
# a browser walk includes that entry's dependencies, even when they have no directive themselves.
facts
relation server-root(module)
relation client-root(module)
relation server-edge(module, target)
relation client-edge(module, target)
relation client-entry(module)
relation server-only(module)
relation client-only(module)

relation server(module)
relation client(module)
relation reference(module)
relation invalid-client(module)
relation invalid-server(module)

server(M) :- server-root(M) ;
server(T) :- server(M), server-edge(M, T), !client-entry(M) ;
client(M) :- client-root(M) ;
client(T) :- client(M), client-edge(M, T) ;
reference(M) :- server(M), client-entry(M) ;
invalid-client(M) :- client(M), server-only(M) ;
invalid-server(M) :- server(M), client-only(M), !client-entry(M) ;
