# `--charset=ascii`, esbuild's default: output that means the same whatever encoding it is read in.
# Strings and identifiers spell anything past ASCII as an escape; a tagged template's raw text and a
# regular expression keep theirs, since an escape there would change what they mean.
rules bundle.ascii over bundle.js
use bundle.js as js
use bundle.chars as chars

const hex-digits: Text = "0123456789ABCDEF"

# Whether an escape may be `\u{…}`: from ES2015 on. Before, a pair of escapes stands for one.
setting braces: Bool

fn plain?(t: Text) -> Bool = ascii-text?(t)

# `v` in hex, in `width` digits at least.
fn hex(v: Int, width: Int) -> Text = join(["0" for i in len(digits)..width], "") ++ digits
  where digits = hex-of(v)

fn hex-of(v: Int) -> Text = match v {
  _ if v < 16 => byte-text(hex-digits[v])
  _ => hex-of(v / 16) ++ byte-text(hex-digits[v % 16])
}

# One code point past ASCII. Strings may use `\xE9`; identifiers may not; past the first 65536, a
# pair of surrogates where there is no `\u{…}`.
fn escape(cp: Int, in-string: Bool) -> Text = match cp {
  _ if in-string and cp < 256 => "\\x" ++ hex(cp, 2)
  _ if cp < 65536 => "\\u" ++ hex(cp, 4)
  _ if braces => "\\u{" ++ hex(cp, 1) ++ "}"
  _ => "\\u" ++ hex(55296 + (cp - 65536) / 1024, 4) ++ "\\u" ++ hex(56320 + (cp - 65536) % 1024, 4)
}

# Each run of ASCII as it is, and each code point past it escaped.
fn escaped(t: Text, in-string: Bool) -> Text = match chars.parse(t, "<text>") {
  chars.Chars(List(runs...)) => join([escaped-run(r, in-string) for r in runs], "")
}

fn escaped-run(r: chars.Node, in-string: Bool) -> Text = match r {
  chars.Wide(w) => join([escape(cp, in-string) for cp in code-points-of(w)], "")
  _ => r.text
}

# A leaf in ASCII, or nothing when it already was: most of a program is, and need not be rebuilt.
# Where text must stay as written, in JSX's own syntax, regular expressions and tagged templates,
# is said in `finish.attrs`, which applies this to each leaf.
fn ascii-opt(n: Node) -> Node? = match n {
  Str(t) | TemplateFull(t) | TemplateHead(t) | TemplateMiddle(t) | TemplateTail(t) if not plain?(t) =>
    some(n with { text: escaped(t, true) })
  Ident(t) | BindName(t) | PropName(t) | PrivateName(t) | LabelName(t) if not plain?(t) =>
    some(n with { text: escaped(t, false) })
  _ => none
}
