# `--charset=ascii`, esbuild's default: output that means the same whatever encoding it is read in.
# Strings and identifiers spell anything past ASCII as an escape; a tagged template's raw text and a
# regular expression keep theirs, since an escape there would change what they mean.
rules bundle.ascii over bundle.js
use bundle.js as js

const hex-digits: Text = "0123456789ABCDEF"

state braces: Bool = true

fn plain?(t: Text) -> Bool = all c in t: c < 128

# `v` in hex, in `width` digits at least.
fn hex(v: Int, width: Int) -> Text {
  let digits = hex-of(v)
  join(["0" for i in len(digits)..width], "") ++ digits
}

fn hex-of(v: Int) -> Text = if v < 16 then byte-text(hex-digits[v]) else hex-of(v / 16) ++ byte-text(hex-digits[v % 16])

# One code point past ASCII. Strings may use `\xE9`; identifiers may not.
fn escape(cp: Int, in-string: Bool) -> Text =
  if in-string and cp < 256 then "\\x" ++ hex(cp, 2)
  else if cp < 65536 then "\\u" ++ hex(cp, 4)
  else if braces then "\\u{" ++ hex(cp, 1) ++ "}"
  else "\\u" ++ hex(55296 + (cp - 65536) / 1024, 4) ++ "\\u" ++ hex(56320 + (cp - 65536) % 1024, 4)

# Written into one buffer: this runs on every string with anything past ASCII in it, and a long
# one is mostly ASCII.
fn escaped(t: Text, in-string: Bool) -> Text {
  var b = buf-new()
  for cp in code-points-of(t) {
    if cp < 128 { buf-byte!(b, cp) } else { buf-add!(b, escape(cp, in-string)) }
  }
  buf-text(b)
}

# A leaf in ASCII, or nothing when it already was: most of a program is, and need not be rebuilt.
# Where text must stay as written, in JSX's own syntax, regular expressions and tagged templates,
# is said in `finish.attrs`, which applies this to each leaf.
fn ascii-opt(n: Node) -> Node? = match n {
  Str(t) | TemplateFull(t) | TemplateHead(t) | TemplateMiddle(t) | TemplateTail(t) =>
    if plain?(t) then none else some(n with { text: escaped(t, true) })
  Ident(t) | BindName(t) | PropName(t) | PrivateName(t) | LabelName(t) =>
    if plain?(t) then none else some(n with { text: escaped(t, false) })
  _ => none
}

# Before ES2015 there is no `\u{…}`, so a pair of escapes stands for one.
fn prepare!(target: Int) -> Void { braces = target >= 2015 }
