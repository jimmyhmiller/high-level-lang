# What a define decides: branches that can no longer run. Kept when they might hoist.
rewrite bundle.js
host bundle.minhost
leaves Str Num ;

rule paren-true  : Paren(True()) => True() ;
rule paren-false : Paren(False()) => False() ;
rule not-true    : Not(True()) => False() ;
rule not-false   : Not(False()) => True() ;
rule and-true    : And(True(), x) => x ;
rule and-false   : And(False(), _) => False() ;
rule or-true     : Or(True(), _) => True() ;
rule or-false    : Or(False(), x) => x ;
# `??` gives its left side unless that is `null` or `undefined`.
rule nc-true     : Coalesce(True(), _) => True() ;
rule nc-false    : Coalesce(False(), _) => False() ;
rule nc-str      : Coalesce(Str(a), _) => Str(a) ;
rule nc-num      : Coalesce(Num(a), _) => Num(a) ;
rule nc-null     : Coalesce(Null(), x) => x ;
rule nc-undef    : Coalesce(Void(Num("0")), x) => x ;
rule cond-true   : Cond(True(), a, _) => a ;
rule cond-false  : Cond(False(), _, b) => b ;
rule if-true     : If(True(), t, e) when @no-hoist(e) => t ;
rule if-false-0  : If(False(), t, None()) when @no-hoist(t) => Empty() ;
rule if-false-e  : If(False(), t, e) when @no-hoist(t) => e ;
rule if-true-v   : If(True(), t, e) when !@no-hoist(e), !@hoists-functions(e), !@bare-vars(e) => If(True(), t, @hoisted-vars(e)) ;
rule if-false-0v : If(False(), t, None()) when !@no-hoist(t), !@hoists-functions(t) => @hoisted-vars(t) ;
rule if-false-ev : If(False(), t, e) when !@no-hoist(t), !@hoists-functions(t), !@bare-vars(t), @present(e) => If(False(), @hoisted-vars(t), e) ;
rule str-eq      : StrictEq(Str(a), Str(b)) when @same-text(a, b) => True() ;
rule str-ne      : StrictEq(Str(a), Str(b)) when @different-text(a, b) => False() ;
rule str-eq2     : Eq(Str(a), Str(b)) when @same-text(a, b) => True() ;
rule str-ne2     : Eq(Str(a), Str(b)) when @different-text(a, b) => False() ;
rule str-sne     : StrictNe(Str(a), Str(b)) when @same-text(a, b) => False() ;
rule str-sne2    : StrictNe(Str(a), Str(b)) when @different-text(a, b) => True() ;
# A string is never `undefined` or `null`, strictly or loosely: a define compared with what it would
# be were it not given (`process.env.X === void 0`).
rule str-undef   : StrictEq(Str(_), Void(Num("0"))) => False() ;
rule undef-str   : StrictEq(Void(Num("0")), Str(_)) => False() ;
rule str-null    : StrictEq(Str(_), Null()) => False() ;
rule null-str    : StrictEq(Null(), Str(_)) => False() ;
rule str-undef2  : Eq(Str(_), Void(Num("0"))) => False() ;
rule undef-str2  : Eq(Void(Num("0")), Str(_)) => False() ;
rule str-null2   : Eq(Str(_), Null()) => False() ;
rule null-str2   : Eq(Null(), Str(_)) => False() ;
rule str-nundef  : StrictNe(Str(_), Void(Num("0"))) => True() ;
rule nundef-str  : StrictNe(Void(Num("0")), Str(_)) => True() ;
rule str-nnull   : StrictNe(Str(_), Null()) => True() ;
rule nnull-str   : StrictNe(Null(), Str(_)) => True() ;
rule str-nundef2 : Ne(Str(_), Void(Num("0"))) => True() ;
rule nundef-str2 : Ne(Void(Num("0")), Str(_)) => True() ;
rule str-nnull2  : Ne(Str(_), Null()) => True() ;
rule nnull-str2  : Ne(Null(), Str(_)) => True() ;
