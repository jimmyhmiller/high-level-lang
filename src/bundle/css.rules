# CSS bundling: `@import` expanded in place, `url()` through the loaders, and whitespace minified
# where CSS allows it.
rules bundle.cssbundle over bundle.css
use bundle.css as css
use bundle.resolve as res
use bundle.minhost as host
use bundle.legal as legal
use bundle.comments as cm

# A file's place in the output, under the media queries of the imports that brought it in; `entry`
# when the build loads it itself (a module or the page imports it), not through another's `@import`.
record Placed { path: Text, media: [Node], entry: Bool }

# A copied file: where it came from, and where it went.
record Asset { from: Text, to: Text }

# How each kind of file a stylesheet names is loaded, by extension.
setting loaders: {Text:Text}
setting public-path: Text = ""
setting asset-directory: Text = ""

# What a framework's plugins make of a stylesheet the build loads itself (Vite's transforms, which
# do not see what an `@import` brings in), given whether the build is a production one: the first
# hook's text that is some, else the file's own.
setting load-hooks: [Fn(Text,Bool)->Text?] = []
# How a framework finds what an `@import` names (Vite's CSS resolver), given whether the build is a
# production one; esbuild's relative URL otherwise.
setting resolve-hooks: [Fn(Text,Text,Bool)->Text?] = []
setting production: Bool = true

# A stylesheet's tree, as the build loads it.
fn sheet-tree(path: Text, entry: Bool) -> Node = match entry {
  true => match hooked(path) {
    some(text) => css.parse(text, path)
    none => tree-of(path)
  }
  false => tree-of(path)
}

fn hooked(path: Text) -> Text? = first h in load-hooks for text in h(path, production): text

fn tree-of(path: Text) -> Node = css.parse(read-file(path), path)

fn items-of(sheet: Node) -> [Node] = sheet.items.kids

fn space?(n: Node) -> Bool = n is Ws(_)

fn list-of(xs: [Node]) -> Node = List(xs...)

fn without-space(xs: [Node]) -> [Node] = [x for x in xs if not space?(x)]

# `@import "x" media;`: the path, and the media query after it.
record Import { spec: Text, media: [Node] }

fn import-of(rule: Node) -> Import? = match rule {
  AtRule(AtName("@import"), List(parts...), AtSemi()) => match without-space(parts) {
    [head, ...] as comps => first s in import-spec(head): import-at(s, parts, comps)
    _ => none
  }
  _ => none
}

fn import-spec(n: Node) -> Text? = match n {
  Str(raw) => some(unquote(raw))
  Url(raw) => some(url-text(raw))
  Func(FuncName(f), List(inner...)) => url-arg(f, inner)
  _ => none
}

# `url("x")`: what it names.
fn url-arg(f: Text, inner: [Node]) -> Text? = match f, without-space(inner) {
  "url(" | "URL(", [Str(raw)] => some(unquote(raw))
  _, _ => none
}

# The import, and the media query after what it names. One with a layer or a condition is not done yet.
fn import-at(spec: Text, parts: [Node], comps: [Node]) -> Import = match comps {
  _ if any Func(FuncName("layer("), ...) | Func(FuncName("supports("), ...) | Ident("layer") in comps: true =>
    panic "@import with layer() or supports() is not implemented yet"
  [head, ...] => Import(spec: spec, media: trimmed([p for p in parts if p.lo > head.lo]))
}

fn trimmed(xs: [Node]) -> [Node] = xs[from..max(from, len(xs) - len([x for x in reversed(xs) while space?(x)]))]
  where from = len([x for x in xs while space?(x)])

# `url(  a.png )`: what it names.
fn url-text(raw: Text) -> Text = trim-bytes(raw[4..len(raw) - 1], " \t\n")

fn charset-rule?(n: Node) -> Bool = n is AtRule(AtName("@charset"), ...)

# The `@import`s at the start of a file. Any later one is not an import, and stays as written.
fn leading-imports(sheet: Node) -> [Node] =
  [item for item in items-of(sheet)
        while is-some(import-of(item)) or space?(item) or charset-rule?(item) or item is Cdo() | Cdc()
        if is-some(import-of(item))]

fn css-spec(spec: Text) -> Text = match spec {
  "./" ++ _ | "../" ++ _ | "/" ++ _ => spec
  _ => "./" ++ spec
}

# Every file in the order its rules apply: a stylesheet after what it imports, those after theirs.
fn visit(path: Text, media: [Node]) -> [Placed] = visit-in(real-path(path), media, [], true)

fn visit-in(path: Text, media: [Node], ancestors: [Text], entry: Bool) -> [Placed] = match path in ancestors {
  true => []
  false => [imported(path, media, imp, ancestors ++ [path])... for item in leading-imports(sheet-tree(path, entry))
            if let some(imp) = import-of(item) if not external-url?(imp.spec)] ++ [Placed(path: path, media: media, entry: entry)]
}

fn imported(path: Text, media: [Node], imp: Import, ancestors: [Text]) -> [Placed] =
  visit-in(import-target(imp.spec, path), inner-media(path, media, imp.media), ancestors, false)

fn import-target(spec: Text, importer: Text) -> Text = match resolve-hooks {
  [] => res.resolve(css-spec(spec), importer).path
  hooks => (first h in hooks for path in h(spec, importer, production): path) ?? fail-build(importer ++ ": could not resolve " ++ spec)
}

fn inner-media(path: Text, outer: [Node], inner: [Node]) -> [Node] = match inner, outer {
  [], _ => outer
  _, [] => inner
  _, _ => panic "{}: an import with a media query inside another is not implemented yet", path
}

# Keep each stylesheet/media pair at its last occurrence. A later unconditional copy also
# subsumes earlier conditional copies; different media conditions do not subsume one another.
fn placement-key(p: Placed) -> Text = (if p.entry then "loaded " else "imported ") ++ quote-text(p.path) ++ quote-text(css.render(AtRule(AtName("@media"), List(p.media...), AtSemi()), false))

fn order-of(entries: [Text]) -> [Placed] =
  [placements[i] for i in 0..len(placements) if (last-at[placement-key(placements[i])] ?? -1) == i
          and (unconditional[placements[i].path] ?? i) <= i]
  where placements = [visit(e, [])... for e in entries],
        last-at = {placement-key(placements[i]): i for i in 0..len(placements)},
        unconditional = {placements[i].path: i for i in 0..len(placements) if len(placements[i].media) == 0}

fn external-url?(s: Text) -> Bool = match s {
  "data:" ++ _ | "http:" ++ _ | "https:" ++ _ | "//" ++ _ | "#" ++ _ => true
  _ => false
}

# ---------------------------------------------------------------- url()

fn loader-for(path: Text) -> Text = loaders[path-ext(path)] ?? ""

# A file that a stylesheet or a module names, put where the output can reach it.
fn asset-url(path: Text, out-dir: Text, from-file: Text) -> Text = match loader-for(path) {
  "dataurl" => host.data-url-of(read-file(path), host.mime-of(path))
  "file" => file-url(path)
  "" => panic "{}: no loader is configured for \"{}\" files", from-file, path-ext(path)
  other => panic "{}: the {} loader cannot be used from CSS", from-file, other
}

# A file copied beside the output, named for what is in it.
fn asset-name(path: Text) -> Text = path-stem(path) ++ "-" ++ host.content-hash(read-file(path)) ++ path-ext(path)

fn file-url(path: Text) -> Text = asset-prefix() ++ asset-name(path)

fn asset-prefix() -> Text = match public-path {
  "" => "./"
  p if ends-with(p, "/") => p
  p => p ++ "/"
}

fn asset-of(path: Text, out-dir: Text) -> Asset = Asset(from: path, to: (if public-path != "" and asset-directory != "" then asset-directory else out-dir) ++ "/" ++ asset-name(path))

everywhere fn rewritten-urls(n: Node, file: Text, out-dir: Text) -> Node = match n {
  Url(raw) => url-rewritten(n, url-text(raw), file, out-dir)
  Func(FuncName(f), List(inner...)) => match url-arg(f, inner) {
    some(target) => url-rewritten(n, target, file, out-dir)
    none => n with { args: rewritten-urls(n.args, file, out-dir) }
  }
}

fn url-rewritten(n: Node, target: Text, file: Text, out-dir: Text) -> Node = match local-url(target, file) {
  [path] => url-func(asset-url(path, out-dir, file))
  _ => n
}

# Where a url names a file of the build's: beside the stylesheet, unless it is elsewhere.
fn local-url(target: Text, file: Text) -> [Text] = match target {
  _ if external-url?(target) => []
  _ => [path-normalize(dir-of(file) ++ "/" ++ target)]
}

# The files a stylesheet's urls name.
everywhere fn urls-in(n: Node, file: Text) -> [Text] = match n {
  Url(raw) => local-url(url-text(raw), file)
  Func(FuncName(f), List(inner...)) => match url-arg(f, inner) {
    some(target) => local-url(target, file)
    none => urls-in(n.args, file)
  }
}

fn url-func(target: Text) -> Node = Func(FuncName("url("), List(Str(quote-text(target))))

# ---------------------------------------------------------------- minifying space

# Tokens space can go beside in a selector: the combinators. Not `:`, because `a :hover` is a
# descendant and `a:hover` is not.
fn tight?(n: Node) -> Bool = match n {
  Comma() => true
  Delim(d) => d == ">" or d == "+" or d == "~"
  _ => false
}

# Space in a list of tokens: none at either end, one byte where it is kept, and none beside a comma,
# or beside a combinator in a selector. Inside `calc()` a `+` needs its spaces.
fn squeezed(xs: [Node], selector: Bool) -> [Node] = fold out = [] for i in 0..len(ts): out ++ squeezed-at(ts, i, out, selector)
  where ts = trimmed(xs)

fn squeezed-at(ts: [Node], i: Int, out: [Node], selector: Bool) -> [Node] = match ts[i] {
  t if not space?(t) => [minified(t, false)]
  _ if space-kept?(last(out), ts[i + 1], selector) => [Ws(" ")]
  _ => []
}

fn space-kept?(before: Node, after: Node, selector: Bool) -> Bool =
  not (space?(before) or before is Comma() or after is Comma() or after is Delim("!")
       or (selector and (tight?(before) or tight?(after))))

fn minified(n: Node, selector: Bool) -> Node = match n {
  Sheet(List(xs...)) => Sheet(list-of(block-items(xs)))
  Block(List(xs...)) => Block(list-of(block-items(xs)))
  Rule(List(sel...), b) => Rule(list-of(squeezed(sel, true)), minified(b, false))
  AtRule(name, List(parts...), end) => AtRule(name, list-of(squeezed(parts, false)), minified(end, false))
  Decl(name, _, List(parts...)) => Decl(name, None(), list-of(squeezed(parts, false)))
  CustomDecl(name, _, List(parts...)) => CustomDecl(name, None(), List(parts...))
  Func(f, List(xs...)) => Func(f, list-of(squeezed(xs, false)))
  Parens(List(xs...)) => Parens(list-of(squeezed(xs, false)))
  Brackets(List(xs...)) => Brackets(list-of(squeezed(xs, false)))
  Num(t) | Dimension(t) | Percentage(t) => n with { text: host.css-number(t) }
  _ => n
}

# A block's items: no space, no empty rule, and no `;` the `}` makes unneeded.
fn block-items(xs: [Node]) -> [Node] = [separated(out, i)... for i in 0..len(out)]
  where out = [minified(x, x is Rule(_, Block(_))) for x in xs if kept-in-block?(x)]

# Declarations are separated by `;`, put back between items that need them.
fn separated(out: [Node], i: Int) -> [Node] = match out[i] {
  Decl(...) | CustomDecl(...) if i + 1 < len(out) => [out[i], Semi()]
  x => [x]
}

fn kept-in-block?(x: Node) -> Bool = match x {
  Ws(_) | Semi() => false
  Rule(_, Block(List(inner...))) => any y in inner: not (space?(y) or y is Semi())
  _ => true
}

# ---------------------------------------------------------------- the bundle

fn wrapped-in-media(items: [Node], media: [Node]) -> [Node] = match media {
  [] => items
  _ => [AtRule(AtName("@media"), list-of([Ws(" ")] ++ media ++ [Ws(" ")]), Block(List(items...)))]
}

fn body-items(p: Placed) -> [Node] =
  [x for x in items-of(sheet-tree(p.path, p.entry)) if not (charset-rule?(x) or (any l in leading: l.lo == x.lo and l is AtRule(...)))]
  where leading = leading-imports(sheet-tree(p.path, p.entry))

# What bundling stylesheets makes: the text, the legal comments' own file when they have one, and
# the files its urls name, copied beside it.
record Bundled { text: Text, legal: Text, assets: [Asset] }

# The stylesheet for these entry files, written to `outfile`.
fn bundle(entries: [Text], outfile: Text, minify: Bool, pretty: Bool, legal-mode: Text) -> Bundled =
  Bundled(text: head ++ css.render(sheet, pretty and not minify) ++ "\n" ++ placement.tail,
          legal: placement.file,
          assets: [asset-of(u, out-dir) for p in order for x in body-items(p) for u in urls-in(x, p.path)
                   if loader-for(u) == "file"])
  where out-dir = dir-of(outfile),
        order = order-of(entries),
        items = [i for p in order
                   for i in wrapped-in-media([without-notes(rewritten-urls(x, p.path, out-dir)) for x in body-items(p)], p.media)],
        notes = [t for p in order for x in body-items(p) for t in notes-in(x)],
        sheet = match minify {
          true => minified(Sheet(List(items...)), false)
          false => Sheet(List(items...))
        },
        charset = any p in order: any item in items-of(sheet-tree(p.path, p.entry)): charset-rule?(item),
        head = match charset, minify {
          true, true => "@charset \"UTF-8\";"
          true, false => "@charset \"UTF-8\";\n"
          false, _ => ""
        },
        kept = match minify {
          true => legal.once-last(notes)
          false => legal.once(notes)
        },
        placement = legal.placed(legal-mode, legal.notes-of(kept), outfile)

# Whitespace as comments and what is between them.
fn spaced(t: Text) -> [cm.Node] = match cm.parse(t, "<comments>") {
  cm.Scan(List(pieces...)) => pieces
}

fn legal-note?(p: cm.Node) -> Bool = p is cm.Comment(_) and legal.legal?(p.text)

# Legal comments leave the space they were in, for the end of the file.
everywhere fn without-notes(n: Node) -> Node = match n {
  Ws(t) if legal.worth-looking?(t) => Ws(match join([p.text for p in spaced(t) if not legal-note?(p)], "") {
    "" => " "
    rest => rest
  }) with { lo: n.lo, hi: n.hi }
}

everywhere fn notes-in(n: Node) -> [Text] = match n {
  Ws(t) if legal.worth-looking?(t) => [p.text for p in spaced(t) if legal-note?(p)]
}
