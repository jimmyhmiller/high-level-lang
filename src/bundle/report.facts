# What a build says of itself (`--analyze=DIR`), as relations: what each output holds of each module,
# what each root loads, and what is used of each module and what is kept for its effects. Given the
# outputs (their bytes, what they import, and the spans of each module's code in them) and what
# linking knows of the parts.
facts

# The outputs: bytes, what each imports, the root each runs, and each stretch of a module's code
# in it (numbered, as two stretches may be alike).
relation output-bytes(output, bytes)
relation output-import(output, other)
relation root(module, output)
relation span(output, module, number, bytes)

# What linking knows of the parts.
relation part-of(part, module)
relation declares(part, symbol)
relation mentions(part, symbol)
relation uses(part, symbol)
relation live(part)
relation effect(part)
relation imports(module, target)

# What each output holds of each module, and what all its modules hold: the rest is its own.
relation held(output, module, bytes)
relation modules-held(output, bytes)
held(O, M, sum B) :- span(O, M, N, B) ;
modules-held(O, sum B) :- span(O, M, N, B) ;

# What each root loads before it runs, and how much.
relation loads(module, output)
relation root-bytes(module, bytes)
loads(R, O) :- root(R, O) ;
loads(R, P) :- loads(R, O), output-import(O, P) ;
root-bytes(R, sum B) :- loads(R, O), output-bytes(O, B) ;

# Each module held: its statements, those kept, those kept for what they do as it loads, and the
# other modules whose kept statements read what it declares.
relation shown(module)
relation statements(module, n)
relation kept(module, n)
relation kept-for(module, part)
relation reads(part, symbol)
relation used-by(module, reader, symbol)
shown(M) :- held(O, M, B) ;
statements(M, count P) :- shown(M), part-of(P, M) ;
kept(M, count P) :- shown(M), part-of(P, M), live(P) ;
kept-for(M, P) :- shown(M), part-of(P, M), live(P), effect(P) ;
reads(P, S) :- mentions(P, S) ;
reads(P, S) :- uses(P, S) ;
used-by(M, R, S) :- shown(M), part-of(P, M), live(P), declares(P, S), reads(Q, S), live(Q), part-of(Q, R), M != R ;

# What each root reaches through imports, from itself: explained (`why-reached`), the chain of imports
# that brings a module in, from the module back to the root. The import is written first: explaining
# a module, what imports it is found by an index, not by going through all the root reaches.
relation reached(root, module)
reached(R, R) :- root(R, O) ;
reached(R, D) :- imports(M, D), reached(R, M) ;
