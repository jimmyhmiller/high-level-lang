# What a build says of itself (`--analyze=DIR`), as relations: what each output holds of each module,
# what each root loads, and what is used of each module and what is kept for its effects. Given the
# outputs (their bytes, what they import, and the spans of each module's code in them) and what
# linking knows of the parts.
facts

# The outputs: bytes, what each imports, the root each runs, and each stretch of a module's code
# in it (numbered, as two stretches may be alike).
relation output-bytes(output, bytes)
relation output-import(output, other)
relation root(module, output)
relation span(output, module, number, bytes)
# The stretches that are what the bundler wrote for a module: its wrapper, its namespace object.
relation written(output, module, number, bytes)

# What linking knows of the parts.
relation part-of(part, module)
relation declares(part, symbol)
relation mentions(part, symbol)
relation uses(part, symbol)
relation live(part)
relation effect(part)
relation imports(module, target)
relation via(part, module, name)
relation resolved(module, name, symbol)
relation local-export(module, name, symbol)
relation import-of(symbol, target, name)
relation reexport(module, name, target, target-name)
relation star(module, target)
relation own-export(module, name)
relation default-name(name)

# What each output holds of each module, and what all its modules hold: the rest is its own.
relation held(output, module, bytes)
relation modules-held(output, bytes)
relation held-written(output, module, bytes)
held(O, M, sum B) :- span(O, M, N, B) ;
held-written(O, M, sum B) :- written(O, M, N, B) ;
modules-held(O, sum B) :- span(O, M, N, B) ;

# What each root loads before it runs, and how much; and how much of each module that is.
relation loads(module, output)
relation root-bytes(module, bytes)
relation route-held(root, module, bytes)
loads(R, O) :- root(R, O) ;
loads(R, P) :- loads(R, O), output-import(O, P) ;
root-bytes(R, sum B) :- loads(R, O), output-bytes(O, B) ;
route-held(R, M, sum B) :- loads(R, O), held(O, M, B) ;

# The names each module passes on to live code that reads them through it: by `export … from`, by
# `export *`, or by exporting what it imports. A module may hold no code and still be how the code
# that is held is reached.
relation passes(module, name)
passes(D, N) :- via(P, D, N), live(P) ;
passes(T, TN) :- passes(M, N), reexport(M, N, T, TN) ;
passes(T, N) :- passes(M, N), star(M, T), !default-name(N), !own-export(M, N), resolved(T, N, S) ;
passes(D, DN) :- passes(M, N), local-export(M, N, S), import-of(S, D, DN) ;
relation passes-on(module, name)
relation declared-in(module, name)
declared-in(M, N) :- local-export(M, N, S), declares(P, S), part-of(P, M) ;
passes-on(M, N) :- passes(M, N), !declared-in(M, N) ;

# Each module held: its statements, those kept, those kept for what they do as it loads, and the
# other modules whose kept statements read what it declares.
relation shown(module)
relation statements(module, n)
relation kept(module, n)
relation kept-for(module, part)
relation reads(part, symbol)
relation used-by(module, reader, symbol)
shown(M) :- held(O, M, B) ;
shown(M) :- passes-on(M, N) ;
statements(M, count P) :- shown(M), part-of(P, M) ;
kept(M, count P) :- shown(M), part-of(P, M), live(P) ;
kept-for(M, P) :- shown(M), part-of(P, M), live(P), effect(P) ;
reads(P, S) :- mentions(P, S) ;
reads(P, S) :- uses(P, S) ;
used-by(M, R, S) :- shown(M), part-of(P, M), live(P), declares(P, S), reads(Q, S), live(Q), part-of(Q, R), M != R ;

# What each root reaches through the imports of modules shown, from itself: explained
# (`why-reached`), the chain of imports that brings a module in, from the module back to the root.
# The import is written first: explaining a module, what imports it is found by an index, not by
# going through all the root reaches.
relation reached(root, module)
relation step(module, target)
step(M, D) :- imports(M, D), shown(M), shown(D) ;
reached(R, R) :- root(R, O) ;
reached(R, D) :- step(M, D), reached(R, M) ;
