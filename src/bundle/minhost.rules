# What the minifier's rules ask about nodes and text.
rules bundle.minhost over bundle.js
use bundle.js as js
use bundle.literal as lit

fn opaque(n: Node) -> Bool = js.opaque-spine?(n)
fn present(n: Node) -> Bool = not (n is None())

# A string expression statement might be a directive, which must stay one.
fn directive(n: Node) -> Bool = n is Str(_)

# Declarations a block scopes to itself.
fn not-lexical(n: Node) -> Bool = match n {
  LetDecl(...) | ConstDecl(...) | ClassDecl(...)
    | FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) => false
  _ => true
}

fn all-plain(xs: [Node]) -> Bool = all x in xs: not-lexical(x)

# Would this statement grab a following `else` if it lost its braces?
fn trailing-if?(n: Node) -> Bool = match n {
  If(_, _, e) => e is None() or trailing-if?(e)
  For(_, _, _, b) | ForOf(_, _, _, b) => trailing-if?(b)
  ForIn(_, _, b) => trailing-if?(b)
  While(_, b) | With(_, b) | Labeled(_, b) => trailing-if?(b)
  _ => false
}

fn no-dangling(n: Node) -> Bool = not trailing-if?(n)

# Does control never fall out of this statement?
fn jumps(n: Node) -> Bool = n is Return(_) | Throw(_) | Break(_) | Continue(_)

# Removing dead code must keep what hoists out of it. Nested functions have their own scope.
fn no-hoist(n: Node) -> Bool = match n {
  VarDecl(...) | VarInit(...) | VarLeft(...) | VarLeftInit(...)
    | FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) => false
  FuncExpr(...) | Arrow(...) | Method(...) => true
  _ => all k in n.kids: no-hoist(k)
}

fn name-start-byte?(c: Int) -> Bool =
  (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c == '$'
fn name-byte?(c: Int) -> Bool = name-start-byte?(c) or digit-byte?(c)

fn name-text?(s: Text) -> Bool =
  len(s) > 0 and name-start-byte?(s[0]) and (all c in s: name-byte?(c))

fn plain-key(raw: Text) -> Bool = name-text?(unquote(raw))
fn dot(o: Node, raw: Text) -> Node = Member(o, PropName(unquote(raw)))
fn plain-prop(raw: Text, v: Node) -> Node = Prop(PropName(unquote(raw)), v)

# ---------------------------------------------------------------- numbers

# JavaScript numbers are doubles, so folding is exact only below 2^53. Outside that nothing folds.
const safe-limit: Int = 9007199254740992

# A leading zero is a legacy octal literal in sloppy JavaScript, so `010` is 8 there. Those answer
# nothing and stay unfolded rather than folding as decimal.
fn safe-int(s: Text) -> Int? = match s {
  "0" ++ more if more != "" => none
  _ => digits-number(s, 10, safe-limit - 1)
}

fn safe(v: Int) -> Int? = first x in [v] if x >= 0 and x < safe-limit: x

fn added(a: Text, b: Text) -> Int? = match safe-int(a), safe-int(b) {
  some(x), some(y) => safe(x + y)
  _, _ => none
}

fn subtracted(a: Text, b: Text) -> Int? = match safe-int(a), safe-int(b) {
  some(x), some(y) => safe(x - y)
  _, _ => none
}

fn multiplied(a: Text, b: Text) -> Int? = match safe-int(a), safe-int(b) {
  some(x), some(y) if x > 0 and y > (safe-limit - 1) / x => none
  some(x), some(y) => safe(x * y)
  _, _ => none
}

fn add-fits(a: Text, b: Text) -> Bool = is-some(added(a, b))
fn sub-fits(a: Text, b: Text) -> Bool = is-some(subtracted(a, b))
fn mul-fits(a: Text, b: Text) -> Bool = is-some(multiplied(a, b))
fn add-num(a: Text, b: Text) -> Node = Num(int-text(added(a, b) ?? 0))
fn sub-num(a: Text, b: Text) -> Node = Num(int-text(subtracted(a, b) ?? 0))
fn mul-num(a: Text, b: Text) -> Node = Num(int-text(multiplied(a, b) ?? 0))

# Nonnegative safe integers have the same remainder in JavaScript and the host.
# Zero divisors, signed zero, legacy octal, fractions and unsafe integers stay unfolded.
fn remainder(a: Text, b: Text) -> Int? = match safe-int(a), safe-int(b) {
  some(x), some(y) if y > 0 => some(x % y)
  _, _ => none
}
fn mod-fits(a: Text, b: Text) -> Bool = is-some(remainder(a, b))
fn mod-num(a: Text, b: Text) -> Node = Num(int-text(remainder(a, b) ?? 0))

fn hex-value(s: Text) -> Int? = match s {
  "0x" ++ digits | "0X" ++ digits if digits != "" and len(s) < 16 => digits-number(digits, 16, safe-limit)
  _ => none
}

# An integer's shortest decimal spelling: 1000 as 1e3.
fn int-spelling(v: Int) -> Text = match min(span-back-of(text, "0"), len(text) - 1) {
  zeros if zeros >= 3 => text[0..len(text) - zeros] ++ "e" ++ int-text(zeros)
  _ => text
} where text = int-text(v)

# `0.5` as `.5`, `1.50` as `1.5`, `2.0` as `2`, `1e+21` as `1e21`.
fn float-spelling(s: Text) -> Text = match ascii-lower(s) {
  m ++ "e+" ++ x => mantissa(m) ++ "e" ++ x
  m ++ "e" ++ x => mantissa(m) ++ "e" ++ x
  m => mantissa(m)
}

# `1.50` is `1.5`, `2.0` is `2` and `0.5` is `.5`.
fn mantissa(m: Text) -> Text = match m {
  w ++ "." ++ f => match w, f[0..len(f) - span-back-of(f, "0")] {
    _, "" => w
    "0", g => "." ++ g
    _, g => w ++ "." ++ g
  }
  _ => m
}

fn number-byte?(c: Int) -> Bool =
  digit-byte?(c) or c == '.' or c == 'e' or c == 'E' or c == '+' or c == '-'

# A leading zero with more digits is legacy octal.
fn plain-number?(s: Text) -> Bool =
  len(s) > 0 and (all c in s: number-byte?(c))
    and not (len(s) > 1 and s[0] == '0' and digit-byte?(s[1]))

fn best-number(s: Text) -> Text =
  (first v in safe-int(s): int-spelling(v))
  ?? (first v in hex-value(s): shorter(int-spelling(v), s))
  ?? match s {
    _ if plain-number?(s) => float-spelling(s)
    _ => s
  }

# The first unless the second is shorter.
fn shorter(a: Text, b: Text) -> Text = match a {
  _ if len(b) < len(a) => b
  _ => a
}

fn num-shorter(n: Node) -> Bool = len(best-number(n.text)) < len(n.text)
fn num-short(n: Node) -> Node = Num(best-number(n.text)) with { lo: n.lo, hi: n.hi }

# ---------------------------------------------------------------- strings

# String content as text and escapes. Most strings have no escape to look at.
fn pieces(s: Text) -> [lit.Node] = match s {
  _ if not has-byte?(s, '\\') => [lit.Plain(s)]
  _ => match lit.parse(s, "<string>") { lit.Content(List(ps...)) => ps }
}

# The character an escape names, for one that stands for itself.
fn escaped(p: lit.Node) -> Int = p.text[1]

# Content rewritten for double quotes: a `\'` loses its slash, a bare `"` gains one.
fn to-double-quoted(raw: Text) -> Text = match raw {
  "'" ++ _ => join([double-quoted(p) for p in pieces(unquote(raw))], "")
  _ => unquote(raw)
}

fn double-quoted(p: lit.Node) -> Text = match p {
  lit.Plain(t) => replace-all(t, "\"", "\\\"")
  _ if escaped(p) == '\'' => "'"
  _ => p.text
}

# Two string tokens as one.
fn concat(a: Text, b: Text) -> Node = Str("\"" ++ to-double-quoted(a) ++ to-double-quoted(b) ++ "\"")

fn quote-byte?(c: Int) -> Bool = c == '"' or c == '\''

# The same string in the given quote, with its escapes adjusted.
fn requote(raw: Text, quote: Int) -> Text = q ++ requoted(unquote(raw), q, quote) ++ q
  where q = byte-text(quote)

# Most strings have no escape: only the quote itself needs one.
fn requoted(content: Text, q: Text, quote: Int) -> Text = match content {
  _ if escape-free?(content) => replace-all(content, q, "\\" ++ q)
  _ => join([match p {
               lit.Plain(t) => replace-all(t, q, "\\" ++ q)
               _ if quote-byte?(escaped(p)) and escaped(p) != quote => byte-text(escaped(p))
               _ => p.text
             } for p in pieces(content)], "")
}

# Double quotes, unless single quotes are shorter.
fn best-string(raw: Text) -> Text = shorter(requote(raw, '"'), requote(raw, '\''))

fn str-better(n: Node) -> Bool = best-string(n.text) != n.text
fn str-best(n: Node) -> Node = Str(best-string(n.text)) with { lo: n.lo, hi: n.hi }

# Same string contents? Without an escape on either side the spelling is the value. With one,
# neither question is answered, so nothing folds.
fn escape-free?(s: Text) -> Bool = all c in s: c != '\\'

fn same-text(a: Text, b: Text) -> Bool =
  escape-free?(a) and escape-free?(b) and unquote(a) == unquote(b)
fn different-text(a: Text, b: Text) -> Bool =
  escape-free?(a) and escape-free?(b) and unquote(a) != unquote(b)

# Two reads of the same plain variable: safe to merge, reading one has no effect.
fn same-ref(a: Node, b: Node) -> Bool = match a, b {
  Ident(x), Ident(y) => x == y
  _, _ => false
}

# ---------------------------------------------------------------- template literals


# A string with raw newlines is shorter as a template: `\n` is two bytes, a line break one.
# Each escape of a quote or a line break is a byte less, and each backquote and `${` one more.
fn template-gain(raw: Text) -> Int =
  sum p in pieces(unquote(raw)): match p {
    lit.Plain(t) => 0 - (count i in 0..len(t): at?(t, i, "`") or at?(t, i, "${"))
    _ if escaped(p) == 'n' or quote-byte?(escaped(p)) => 1
    _ => 0
  }

# A string's content as a template token.
fn as-template(raw: Text) -> Text =
  "`" ++ join([match p {
                 lit.Plain(t) => replace-many(t, ["`", "${"], ["\\`", "\\${"])
                 _ if escaped(p) == 'n' => "\n"
                 _ if quote-byte?(escaped(p)) => byte-text(escaped(p))
                 _ => p.text
               } for p in pieces(unquote(raw))], "") ++ "`"

# A string as a template, when that is shorter. Where a string may not be one, a key or a
# directive, is said in `finish.attrs`.
fn templated(n: Node) -> Node? = match n {
  Str(raw) if template-gain(raw) > 0 => some(TemplateFull(as-template(raw)) with { lo: n.lo, hi: n.hi })
  _ => none
}

# ---------------------------------------------------------------- text as a literal

# Any text as a double-quoted string.
fn js-string(s: Text) -> Text =
  "\"" ++ replace-many(s, ["\"", "\\", "\n", "\r", "\t"], ["\\\"", "\\\\", "\\n", "\\r", "\\t"]) ++ "\""

const base64-digits: Text = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn base64(s: Text) -> Text = text-of-bytes([d for i in 0..(len(s) + 2) / 3 for d in base64-group(s, 3 * i)])

# Three bytes as four digits; a short last group ends in `=`.
fn base64-group(s: Text, i: Int) -> [Int] =
  [base64-digits[(n / shift) % 64] for shift in [262144, 4096, 64, 1][0..len(group) + 1]] ++ ['=' for j in len(group)..3]
  where group = s[i..min(i + 3, len(s))],
        n = sum j in 0..len(group): group[j] * [65536, 256, 1][j]

# A data URL, spelled out when the text can stand in one as it is. esbuild also percent-escapes
# what it can to find the shortest form; this answers base64 for anything else.
fn url-safe-byte?(c: Int) -> Bool = c >= 32 and c < 127 and not (c in url-unsafe-bytes)
const url-unsafe-bytes: [Int] = ['%', '#', '&', '+', '?', '"', '\\', ' ']

fn data-url(text: Text) -> Text = data-url-of(text, "text/plain;charset=utf-8")

fn data-url-of(text: Text, mime: Text) -> Text = match text {
  _ if all c in text: url-safe-byte?(c) => "data:" ++ mime ++ "," ++ text
  _ => "data:" ++ mime ++ ";base64," ++ base64(text)
}

# What esbuild says a file is, by its extension.
const mime-types: {Text:Text} = {".css": "text/css;charset=utf-8", ".gif": "image/gif", ".htm": "text/html;charset=utf-8",
  ".html": "text/html;charset=utf-8", ".jpeg": "image/jpeg", ".jpg": "image/jpeg", ".js": "text/javascript;charset=utf-8",
  ".json": "application/json;charset=utf-8", ".mjs": "text/javascript;charset=utf-8", ".pdf": "application/pdf",
  ".png": "image/png", ".svg": "image/svg+xml", ".txt": "text/plain;charset=utf-8", ".wasm": "application/wasm",
  ".webp": "image/webp", ".xml": "text/xml;charset=utf-8", ".avif": "image/avif", ".woff": "font/woff",
  ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf"}

fn mime-of(path: Text) -> Text =
  (first at in last-index-of(path-base(path), "."): mime-types[path-base(path)[at..len(path-base(path))]] ?? none)
  ?? "text/plain;charset=utf-8"


const hash-letters: Text = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

# Two running sums over bytes, for telling versions of a text apart. Not for security.
record Hash { a: Int, b: Int }

fn hash-start() -> Hash = Hash(a: 17, b: 31)

fn hash-more(h: Hash, text: Text) -> Hash =
  Hash(a: fold a = h.a for c in text: (a * 131 + c + 7) % 2147483647,
       b: fold b = h.b for c in text: (b * 65599 + c + 11) % 2147483629)

# Eight letters, the two sums' base-32 digits from the lowest, in turn.
fn hash-name(h: Hash) -> Text =
  text-of-bytes([hash-letters[digit32(x, i)] for i in 0..4 for x in [h.a, h.b]])

fn digit32(x: Int, i: Int) -> Int = match i {
  0 => x % 32
  _ => digit32(x / 32, i - 1)
}

fn content-hash(text: Text) -> Text = hash-name(hash-more(hash-start(), text))

# `0.50` is `.5`, and `-0.5px` is `-.5px`.
fn css-number(t: Text) -> Text = match t {
  "-0." ++ rest => "-." ++ rest
  "+0." ++ rest => "+." ++ rest
  "0." ++ rest => "." ++ rest
  _ => t
}
