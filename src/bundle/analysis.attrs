# Each module's import/export structure and statements, as facts for link.facts.
attrs bundle.analysis over bundle.js
use bundle.js as js
use bundle.jsvalue as jv
use bundle.link as link
use bundle.scopes as sc
use bundle.resolve as res
use bundle.modules as m
use bundle.evaluation as ev
use hl.graph as graph

# An import from a CommonJS module, which turns into a property read.
record CjsImport { importer: Int, import-var: Int, name: Text, namespace: Bool }

# How the build links, given before it does.
record Linking {
  entry-namespace: Bool,
  tree-shaking: Bool,
  # Code splitting: `import()` loads a chunk, so what it names runs when loaded, and needs no wrapper.
  splitting: Bool,
  # With splitting, modules evaluate in native order: each that may be observed gets an initializer
  # its importers call (`scheduling`). Otherwise a shared module runs as its chunk loads.
  strict-order: Bool,
  # ES module output, where an import of an external module stays an import statement.
  esm-output: Bool,
  # Output whose runner has `require`; otherwise an external module is loaded with `__require`, or,
  # in ES module output Node runs, with Node's own (`__nodeRequire`).
  native-require: Bool,
  node-require: Bool,
  # Wrappers with no names for a profiler to show, as esbuild's are when it minifies identifiers.
  compact: Bool,
  # `--pure:NAME`: calls of these free names may go when nothing uses their value.
  pure-names: [Text],
  # What an object or a namespace object holds, read by name, leaving what nothing reads: object
  # literals' properties, and namespaces read through `const`s and destructuring (`objects-of`,
  # `aliases-of`). Off, every object is read whole as soon as it is read.
  shake-properties: Bool,
  # With `--minify-syntax`, esbuild folds more of an expression as it parses, before tree shaking
  # (bundle.jsvalue): `1 - 2` is -1 then, which has no effect.
  minify-syntax: Bool
}

setting linking: Linking

# What a symbol linking makes is for: a module's `require_x`, `x_exports` or `init_x`; the variable a
# module holds a module it imports opaquely in; or a name it re-exports from one.
enum Purpose { Require, Exports, Init, ImportVar, ReexportName }

# A symbol linking makes, which no source names: what it is for, and whose it is (a module, or for an
# import variable, the importer and what it imports as one number, `import-key`); the name a
# re-export exports; and the scope it is in, and its name.
record Made { purpose: Purpose, owner: Int, exported: Text, scope: Int, name: Text }

# What linking works out, for the facts and for naming and emitting after them: the modules that are
# `__esm` wrapped; those `import()` makes the roots of chunks; the symbols it makes, numbered from
# `first-made`, by what each is for and whose it is; the imports that become property reads, and
# those of ES namespaces; and whether any module re-exports names only known at run time, or
# re-exports from CommonJS. A part's statement is its module's (`stmt-of`).
boxed record Linked {
  wrapped: {Int:Bool},
  scheduled: {Int:Bool},
  init-owners: {Int:Int},
  asynchronous: {Int:Bool},
  awaiting: {Int:Bool},
  dynamic-roots: [Int],
  made: [Made],
  first-made: Int,
  made-ids: [Int],
  part-starts: {Int:Int},
  requires: {Int:Int},
  namespaces: {Int:Int},
  inits: {Int:Int},
  import-vars: {Int:Int},
  reexports: {Text:Int},
  cjs-imports: {Int:CjsImport},
  ns-imports: {Int:Int},
  # Named imports of ES modules, by symbol: what `z.object` may read a member of, if `z` turns out
  # to be a module's namespace object (`export * as z`, or `import * as z; export { z }`).
  named-imports: {Int:Bool},
  # Top-level `const`s that are another name's value, by symbol (see `AliasOf`).
  aliases: {Int:Int},
  # Top-level names holding an object literal that may lose properties (see `objects-of`).
  objects: {Int:Bool},
  any-dynamic: Bool,
  any-reexport: Bool
}

setting linked: Linked

# The module the current analysis is looking at.
context here: m.Module = m.blank-module(-1, "", m.External, -1)
# The body of the module `here` is: what it is made of.
context body: m.Body = m.empty-body()

fn root-sym(mo: m.Module, name: Text) -> Int? = sym.scope-at(m.table, mo.root).names[name]

# A symbol of the runtime module, by name.
fn helper(name: Text) -> Int = root-sym(m.modules[0], name) ?? panic "the runtime has no helper named {}", name

# The module an import statement, or an `import()` with a literal path, led to when its module
# was loaded: by its specifier, and whether it asks for a JSON module.
fn known-dep(mo: m.Module, n: Node) -> Int = match m.request-at(n) {
  some(r) => m.request-target(mo, r) ?? panic "{}: {} was not loaded", mo.path, r.spec
  none => panic "{}: a statement that imports nothing, at {}", mo.path, n.lo
}

fn known-required(mo: m.Module, from: Node) -> Int =
  mo.require-ids[m.module-of-str(from)] ?? panic "{}: require {} was not loaded", mo.path, from.text

# Imported as an opaque object at run time, rather than linked by name.
fn opaque?(t: m.Module) -> Bool = t.kind == Cjs or t.kind == External

# The helper that wraps a module: `__commonJS` or `__esm`, or their compact forms.
fn wrapper-helper(name: Text) -> Text = match linking.compact {
  true => name ++ "Min"
  false => name
}

# In ES module output, an `import` of an external module, or an `export … from` one other than
# `export *`, stays a statement that binds its own names, as esbuild leaves it: the runtime links it.
fn kept?(t: m.Module) -> Bool = linking.esm-output and t.kind == External

# Held in an import variable, made an ES module with `__toESM`: an opaque module not kept.
fn held?(t: m.Module) -> Bool = opaque?(t) and not kept?(t)

fn bound?(n: Node) -> Bool = n.lo in body.bindings

# The symbols linking made: a module's `require_x`, `x_exports` and `init_x`, its import variable
# for a module it imports opaquely, and a name it re-exports from one.
fn symbol-in(symbols: {Int:Int}, key: Int) -> Int = symbols[key] ?? panic "linking made no symbol for {}", key
# Each reads one entry of what linking made, so what reads it is made from that entry only.
fn require-sym(mo: m.Module) -> Int = linked.requires[mo.id] ?? panic "linking made no symbol for {}", mo.id
fn ns-sym(mo: m.Module) -> Int = linked.namespaces[mo.id] ?? panic "linking made no symbol for {}", mo.id
fn init-owner(mo: m.Module) -> Int = linked.init-owners[mo.id] ?? mo.id
fn forwarded-init?(mo: m.Module) -> Bool = init-owner(mo) != mo.id
fn init-sym(mo: m.Module) -> Int = linked.inits[init-owner(mo)] ?? panic "linking made no symbol for {}", mo.id
fn known-import-var(mo: m.Module, target: Int) -> Int =
  linked.import-vars[key] ?? panic "linking made no symbol for {}", key where key = import-key(mo, target)
fn import-key(mo: m.Module, target: Int) -> Int = mo.id * 100000 + target
fn reexport-key(owner: Int, exported: Text) -> Text = int-text(owner) ++ " " ++ exported
fn reexport-sym(mo: m.Module, exported: Text) -> Int = reexport-in(linked.reexports, mo, exported)
fn reexport-in(reexports: {Text:Int}, mo: m.Module, exported: Text) -> Int =
  reexports[reexport-key(mo.id, exported)] ?? panic "linking made no symbol for {}'s re-export {}", mo.path, exported
fn wrapped?(mo: m.Module) -> Bool = mo.id in linked.wrapped
fn scheduled?(mo: m.Module) -> Bool = mo.id in linked.scheduled
fn asynchronous?(mo: m.Module) -> Bool = mo.id in linked.asynchronous
fn own-await?(mo: m.Module) -> Bool = mo.id in linked.awaiting
fn init-helper(mo: m.Module) -> Text = if asynchronous?(mo) then "__esmAsync" else wrapper-helper("__esm")

# ---------------------------------------------------------------- what statements say

# What one statement says, found by walking it. The walk is most of what facts cost, and it reads
# only its module and what is known already, so modules are walked at once; the facts are then
# asserted from these, in the order the walk met them.
enum Reach { Symbol, Member, ImportedMember, AliasMember, Required, Whole, Chunk }

# A symbol named; `ns.x` of an `import * as ns` (the module, and `x`); `z.x` of a named import `z`
# (its symbol, and `x`), which linking finds a member of a namespace or a read of `z`; `a.x` of a
# `const a = …` that is another name's value (its symbol, and `x`), which linking finds a member of
# a namespace when that name is one, else a read of `a`; a module
# `require`d, or loaded whole by `import()`; a chunk `import()` loads.
record Mention { reach: Reach, id: Int, name: Text }

# `pure`: whether the statement can go when nothing uses it, which is a walk of it too.
# `objects`: what the statement's object literals that may lose properties hold (`ObjectOf`).
record Summary { declares: [Int], mentions: [Mention], pure: Bool, objects: [ObjectSummary] }

# An object literal a `const` holds, and each property that may go when nothing reads it: its key,
# and the symbols its value names, which it alone reads.
record ObjectSummary { symbol: Int, props: [PropSummary] }
record PropSummary { key: Text, mentions: [Int] }

fn no-summary() -> Summary = Summary(declares: [], mentions: [], pure: false, objects: [])

# One traversal of a statement finds both. A top-level statement declares only its own names:
# not those inside a function or a block, nor a function's other than its own name. What a
# namespace read, a `require` or an `import()` stands for is one mention, not its pieces'.
input declaring: Bool
collect declares: [Int]
collect mentions: [Mention]
inh top: Bool = true
inh counting: Bool = true

on FuncDecl(name, ...) | GenDecl(name, ...) | AsyncFuncDecl(name, ...) | AsyncGenDecl(name, ...) {
  kids.top = false
  name.top = top
}
on BindName(x) as n if declaring and top and (m.symbol-in(body, here, n.lo) ?? panic "{}: no symbol for binding {}", here.path, x) is s
                       and sym.symbol-at(m.table, s).scope == here.root {
  declares += s
}
on Ident(x) as n if counting and name-mention(n, x) is some(found) { mentions += found }
on Member(object, property) if counting and namespace-of(body, here, object) is some(target) {
  mentions += Mention(reach: Member, id: target, name: property.text)
  object.counting = false
}
# `z.x` of a named import, or `a.x` of an alias or an object literal's name: one look at which
# symbol the name is says which.
on Member(Ident(_) as object, PropName(_) as property) if counting and member-of(body, here, object) is some(found) and not reflective?(property.text) {
  mentions += found with { name: property.text }
  object.counting = false
}
# `const { a, b: c } = ns`, of what may be a namespace object: a read of each name, as `ns.a` is.
on Declarator(ObjectPattern(List(props...)), Ident(_) as init) if counting and linking.shake-properties and (all x in props: simple-prop?(x))
                                                             and destructured(body, here, init) is some(found) {
  mentions ++= keyed(found, props)
  init.counting = false
}
# `import()` of an outside module stays as it is, and needs nothing of the bundle.
on ImportCall(...) as n if counting and imported-str(n) is some(_) and m.modules[known-dep(here, n)].kind != External {
  mentions += mentioned(match linking.splitting {
                          true => Chunk
                          false => Whole
                        }, known-dep(here, n))
  kids.counting = false
}
# A direct eval in a retained declaration can read any visible module binding. Scope analysis
# already preserves their spellings; liveness must retain their declarations as well.
on CallExpr(callee, _) if counting and direct-eval?(callee) and sym.scope-at(m.table, here.root).dynamic {
  mentions ++= [mentioned(Symbol, s) for s in sym.scope-at(m.table, here.root).symbols]
}
on CallExpr(...) as n if counting and required-str(body, n) is some(from) {
  mentions += mentioned(Required, known-required(here, from))
  kids.counting = false
}

# Any other scope: its names are its own. Last, so the blocks above own the nodes they match.
on _ as n if sc.opens?(n.kind) { kids.top = false }

fn mentioned(reach: Reach, id: Int) -> Mention = Mention(reach: reach, id: id, name: "")

# What a direct eval calls: the name `eval` itself, in parentheses or not (js.scopes).
fn direct-eval?(callee: Node) -> Bool = match callee {
  Ident("eval") => true
  Paren(x) => direct-eval?(x)
  _ => false
}

# What a name mentions: its symbol, or a runtime helper it names freely.
fn name-mention(n: Node, x: Text) -> Mention? = match m.symbol-in(body, here, n.lo) {
  some(s) => some(mentioned(Symbol, s))
  none if x in here.helpers => some(mentioned(Symbol, helper(x)))
  none => none
}

fn summary-of(n: Node, declares: Bool) -> Summary =
  Summary(declares: a.declares, mentions: once-each-symbol(a.mentions),
          pure: declares and linking.tree-shaking and pure-stmt?(n), objects: [])
  where a = run(n, declares)

# A statement that holds object literals whose properties may go: its summary is of the statement
# without those properties, and each such property's of itself. A property may go when it can go
# unread (`pure?`) and all it reads is symbols by name, which its own facts then say; any other
# property stays as long as the statement does.
fn object-summary(s: Node, objects: [Node]) -> Summary = match [o for o in found if len(o.props) > 0] {
  [] => summary-of(s, true)
  kept => summary-of(without-props(s, {p.at: true for o in kept for p in o.props}), true) with { objects: [o.summary for o in kept] }
} where found = [Found(summary: ObjectSummary(symbol: symbol-of-declarator(x), props: [p.summary for p in ps]), props: ps)
                 for x in objects for ps in [shakeable-props(x)]]

record Found { summary: ObjectSummary, props: [Shakeable] }
record Shakeable { at: Int, summary: PropSummary }

fn symbol-of-declarator(d: Node) -> Int = m.symbol-in(body, here, d.target.lo) ?? panic "{}: an object's const has no symbol", here.path

# The properties of an object literal that may go: those that can go unread and read only symbols.
fn shakeable-props(d: Node) -> [Shakeable] = match d.init {
  ObjectLit(List(props...)) => [Shakeable(at: p.lo, summary: PropSummary(key: object-key(p), mentions: [x.id for x in once-each-symbol(ms)]))
                                for p in props if may-go?(p) for ms in [run(p, false).mentions] if all x in ms: x.reach == Symbol]
  _ => []
}

# A property that may go unread: one named as written (not computed), a value that does nothing, or
# a plain method. Not a getter, a setter, or a method of another kind, though defining one does
# nothing too (`pure?`): what they are is not a property's value read by name.
fn may-go?(p: Node) -> Bool = match p {
  Shorthand(x) => pure?(x)
  Prop(Computed(_), _) | Method(Computed(_), ...) => false
  Prop(_, v) => pure?(v)
  Method(...) => true
  _ => false
}

# A property's key, as a name: `a`, `"a"`, a number as written, a shorthand's name.
fn object-key(p: Node) -> Text = match p {
  Shorthand(x) => x.text
  Prop(Str(_) as k, _) => unquote(k.text)
  Prop(k, _) => k.text
  Method(Str(_) as k, ...) => unquote(k.text)
  Method(k, ...) => k.text
  _ => panic "object-key of a property that cannot go"
}

# A property's key when it has one that may go, else none (`""`): what emit asks of every property.
fn object-key-of(p: Node) -> Text = match p {
  Shorthand(_) | Prop(PropName(_), _) | Prop(Str(_), _) | Prop(Num(_), _) | Method(PropName(_), ...) | Method(Str(_), ...) => object-key(p)
  _ => ""
}

# A statement without some of its object literals' properties (by where each starts).
everywhere fn without-props(n: Node, gone: {Int:Bool}) -> Node = match n {
  ObjectLit(List(ps...)) => ObjectLit(List([without-props(p, gone) for p in ps if not (p.lo in gone)]...)) with { lo: n.lo, hi: n.hi }
}

# A symbol mentioned once is mentioned: the first mention of each stays, and the others go.
fn once-each-symbol(ms: [Mention]) -> [Mention] =
  [x for x in ms distinct (if x.reach == Symbol then some(x.id) else none)]

# A module's summaries: one for each top-level statement, empty for an ES module's that get their
# facts from what they import and export.
fn summaries-of(id: Int) -> [Summary] = with here = m.modules[id], body = m.body-of(id) {
  match here.kind {
    Cjs => [summary-of(s, true) for s in body.tree.body.kids]
    _ => [statement-summary(s) for s in body.tree.body.kids]
  }
}

fn statement-summary(s: Node) -> Summary = match walked?(s), len(linked.objects) > 0 {
  false, _ => no-summary()
  true, false => summary-of(s, true)
  true, true => match [d for d in object-declarators(s) if symbol-of-declarator(d) in linked.objects] {
    [] => summary-of(s, true)
    ds => object-summary(s, ds)
  }
}

# The declarators of a top-level statement that give a name an object literal.
fn object-declarators(s: Node) -> [Node] = [d for d in statement-declarators(s) if d.target is BindName(_) and d.init is ObjectLit(...)]

fn statement-declarators(s: Node) -> [Node] = match s {
  VarDecl(List(ds...)) | LetDecl(List(ds...)) | ConstDecl(List(ds...)) | ExportVar(List(ds...)) => ds
  ExportLexical(d) => statement-declarators(d)
  _ => []
}

fn walked?(s: Node) -> Bool = match s {
  Import(...) | ImportBare(...) | ExportAll(...) | ExportAllAs(...) | ExportFrom(...) | ExportNamed(_) => false
  _ => true
}

# The symbol of a named import of an ES module an identifier reads.
fn imported-name(b: m.Body, mo: m.Module, n: Node) -> Int? = first s in m.symbol-in(b, mo, n.lo) if s in linked.named-imports: s

# What reading by name tells of more than that name: which properties an object has, or how they
# are defined. Read so, an object is read whole.
fn reflective?(name: Text) -> Bool = name in ["hasOwnProperty", "propertyIsEnumerable", "__lookupGetter__", "__lookupSetter__",
                                              "__defineGetter__", "__defineSetter__", "__proto__", "toJSON"]

# What a member read of a name is a read of by name: a named import's, or an alias's or an object
# literal's name's; none for any other name.
fn member-of(b: m.Body, mo: m.Module, n: Node) -> Mention? = match m.symbol-in(b, mo, n.lo) {
  some(s) if s in linked.named-imports => some(Mention(reach: ImportedMember, id: s, name: ""))
  some(s) if s in linked.aliases or s in linked.objects => some(Mention(reach: AliasMember, id: s, name: ""))
  _ => none
}

# A `const` that is another name's value (`linked.aliases`).
fn alias-name(b: m.Body, mo: m.Module, n: Node) -> Int? = first s in m.symbol-in(b, mo, n.lo) if s in linked.aliases or s in linked.objects: s

# What a destructuring's value may be a namespace object as: `import * as`, a named import, or an
# alias; else nothing, and it is read as any value is.
fn destructured(b: m.Body, mo: m.Module, n: Node) -> Mention? = match namespace-of(b, mo, n), imported-name(b, mo, n), alias-name(b, mo, n) {
  some(t), _, _ => some(Mention(reach: Member, id: t, name: ""))
  _, some(s), _ => some(Mention(reach: ImportedMember, id: s, name: ""))
  _, _, some(s) => some(Mention(reach: AliasMember, id: s, name: ""))
  _, _, _ => none
}

fn keyed(found: Mention, props: [Node]) -> [Mention] = [found with { name: prop-key(x) } for x in props]

# A property of a destructuring that is only a name taken: `a`, `b: c`, `"b": c`; no default, no
# rest, nothing nested, no computed key.
fn simple-prop?(x: Node) -> Bool = match x {
  PatShort(_, None()) => true
  PatProp(PropName(_), BindElement(BindName(_), None())) => true
  PatProp(Str(_), BindElement(BindName(_), None())) => true
  _ => false
}

fn prop-key(x: Node) -> Text = match x {
  PatShort(name, _) => name.text
  PatProp(Str(_) as k, _) => unquote(k.text)
  PatProp(k, _) => k.text
  _ => panic "prop-key of a property that is not simple"
}

# The module an identifier names when it is `import * as` of an ES module.
fn namespace-of(b: m.Body, mo: m.Module, n: Node) -> Int? = match n {
  Ident(_) => match m.symbol-in(b, mo, n.lo) {
    some(s) => linked.ns-imports[s]
    none => none
  }
  _ => none
}

# `import("x")` with a literal path: the path.
fn imported-str(n: Node) -> Node? = match n {
  ImportCall(Str(_) as from, ...) => some(from)
  _ => none
}

# `require("x")` with a literal path and a free `require`: the path.
fn required-str(b: m.Body, n: Node) -> Node? = match n {
  CallExpr(Ident("require") as callee, Args(List(Str(_) as from))) if not (callee.lo in b.bindings) => some(from)
  _ => none
}

# The modules those name, once everything is resolved: these only look up, so many threads may ask.
fn known-import-call-target(mo: m.Module, n: Node) -> Int? = first from in imported-str(n): known-dep(mo, n)

fn known-require-target(b: m.Body, mo: m.Module, n: Node) -> Int? = first from in required-str(b, n): known-required(mo, from)

# ---------------------------------------------------------------- what can be removed

# Global names, and properties of them, that reading cannot run anyone's code: those esbuild
# knows, as far as they have been measured against it (an unused `var v = X;` it removes).
const known-globals: [Text] = [
  "Array", "Boolean", "Function", "Math", "Number", "Object", "RegExp", "String", "Symbol", "Reflect", "JSON",
  "Intl", "Promise", "Proxy", "Map", "Set", "WeakMap", "WeakSet", "WeakRef", "FinalizationRegistry",
  "ArrayBuffer", "SharedArrayBuffer", "DataView", "Date", "Error", "EvalError", "RangeError",
  "ReferenceError", "SyntaxError", "TypeError", "URIError", "AggregateError", "Int8Array", "Uint8Array",
  "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array", "Uint32Array", "Float32Array",
  "Float64Array", "BigInt64Array", "BigUint64Array", "Float16Array", "BigInt", "Atomics", "WebAssembly",
  "globalThis", "console", "isNaN", "isFinite", "parseFloat", "parseInt", "decodeURI", "decodeURIComponent",
  "encodeURI", "encodeURIComponent", "escape", "unescape", "setTimeout", "clearTimeout", "setInterval",
  "clearInterval", "queueMicrotask", "fetch", "AbortController", "AbortSignal", "Event", "EventTarget",
  "MessageChannel", "MessageEvent", "MessagePort", "TextDecoder", "TextEncoder", "URL", "URLSearchParams",
  "Blob", "File", "FormData", "Headers", "Request", "Response", "ReadableStream", "window", "document",
  "navigator", "location", "self", "require", "performance", "history", "screen", "Node", "Element",
  "HTMLElement", "HTMLDivElement", "Document", "DocumentFragment", "Text", "Comment", "CustomEvent",
  "KeyboardEvent", "MouseEvent", "DOMParser", "XMLHttpRequest", "WebSocket", "Worker", "Image", "Audio",
  "CSSStyleSheet", "CSSRule", "CSSStyleDeclaration", "MutationObserver", "ResizeObserver",
  "IntersectionObserver", "requestAnimationFrame", "cancelAnimationFrame", "getComputedStyle", "matchMedia",
  "alert", "NaN", "Infinity", "undefined", "Iterator"]
const known-global-properties: [Text] = [
  "Object.assign", "Object.create", "Object.defineProperties", "Object.defineProperty", "Object.entries",
  "Object.freeze", "Object.fromEntries", "Object.getOwnPropertyDescriptor",
  "Object.getOwnPropertyDescriptors", "Object.getOwnPropertyNames", "Object.getOwnPropertySymbols",
  "Object.getPrototypeOf", "Object.is", "Object.isExtensible", "Object.isFrozen", "Object.isSealed",
  "Object.keys", "Object.preventExtensions", "Object.seal", "Object.setPrototypeOf", "Object.values",
  "Math.E", "Math.LN10", "Math.LN2", "Math.LOG10E", "Math.LOG2E", "Math.PI", "Math.SQRT1_2", "Math.SQRT2",
  "Math.abs", "Math.acos", "Math.acosh", "Math.asin", "Math.asinh", "Math.atan", "Math.atan2", "Math.atanh",
  "Math.cbrt", "Math.ceil", "Math.clz32", "Math.cos", "Math.cosh", "Math.exp", "Math.expm1", "Math.floor",
  "Math.fround", "Math.hypot", "Math.imul", "Math.log", "Math.log10", "Math.log1p", "Math.log2", "Math.max",
  "Math.min", "Math.pow", "Math.random", "Math.round", "Math.sign", "Math.sin", "Math.sinh", "Math.sqrt",
  "Math.tan", "Math.tanh", "Math.trunc", "Reflect.apply", "Reflect.construct", "Reflect.defineProperty",
  "Reflect.deleteProperty", "Reflect.get", "Reflect.getOwnPropertyDescriptor", "Reflect.getPrototypeOf",
  "Reflect.has", "Reflect.isExtensible", "Reflect.ownKeys", "Reflect.preventExtensions", "Reflect.set",
  "Reflect.setPrototypeOf", "Symbol.asyncDispose", "Symbol.asyncIterator", "Symbol.dispose",
  "Symbol.hasInstance", "Symbol.isConcatSpreadable", "Symbol.iterator", "Symbol.match", "Symbol.matchAll",
  "Symbol.replace", "Symbol.search", "Symbol.species", "Symbol.split", "Symbol.toPrimitive",
  "Symbol.toStringTag", "Symbol.unscopables", "JSON.parse", "JSON.stringify", "console.assert",
  "console.clear", "console.count", "console.countReset", "console.debug", "console.dir", "console.dirxml",
  "console.error", "console.group", "console.groupCollapsed", "console.groupEnd", "console.info",
  "console.log", "console.table", "console.time", "console.timeEnd", "console.timeLog", "console.trace",
  "console.warn", "Array.isArray", "Array.from", "Array.of", "Object.prototype.__defineGetter__",
  "Object.prototype.__defineSetter__", "Object.prototype.__lookupGetter__",
  "Object.prototype.__lookupSetter__", "Object.prototype.hasOwnProperty", "Object.prototype.isPrototypeOf",
  "Object.prototype.propertyIsEnumerable", "Object.prototype.toLocaleString", "Object.prototype.toString",
  "Object.prototype.unwatch", "Object.prototype.valueOf", "Object.prototype.watch"]
const known-collections: [Text] = ["Map", "Set", "WeakMap", "WeakSet"]

fn annotated?(n: Node) -> Bool = m.pure-annotated?(body, n)
fn namespace-import?(n: Node) -> Bool =
  any s in m.symbol-in(body, here, n.lo): s in linked.ns-imports or (any c in linked.cjs-imports[s]: c.namespace)
fn free-ident?(n: Node) -> Bool = n is Ident(_) and not bound?(n)
fn known-collection?(callee: Node) -> Bool = free-ident?(callee) and callee.text in known-collections
fn all-pure?(xs: [Node]) -> Bool = all x in xs: pure?(x)

fn listed-pure?(callee: Node) -> Bool =
  len(linking.pure-names) > 0 and (match m.dotted-name(callee, body.bindings) {
    some(name) => name in linking.pure-names
    none => false
  })

# An annotated call goes if nothing it was given has an effect.
fn pure-call?(n: Node) -> Bool = (annotated?(n) or listed-pure?(n.callee)) and all-pure?(n.args.items.kids)

# `new Map()` and friends cannot run anyone's code when given nothing.
fn pure-new?(n: Node) -> Bool = known-collection?(n.callee) and len(n.args.items.kids) == 0

# Can this be removed when nothing uses its value? Mirrors esbuild's rules: an unbound name might
# throw, and a property read might run a getter.
fn pure?(n: Node) -> Bool = match n {
  Num(_) | Str(_) | True() | False() | Null() | Regex(_) | TemplateFull(_) | This() | None() | Hole() => true
  FuncExpr(...) | GenExpr(...) | AsyncFuncExpr(...) | AsyncGenExpr(...) | Arrow(...) | AsyncArrow(...) => true
  Ident(x) => bound?(n) or x in known-globals
  Paren(x) | Not(x) | Void(x) | Shorthand(x) => pure?(x)
  TypeOf(x) => x is Ident(_) or pure?(x)
  # A negative number literal, which esbuild reads as one number.
  Neg(Num(_)) => true
  Cond(test, yes, no) => pure?(test) and (guarded-read?(yes, test, true) or pure?(yes)) and (guarded-read?(no, test, false) or pure?(no))
  # Comparing two primitives calls no `valueOf`.
  Lt(a, b) | Gt(a, b) | Le(a, b) | Ge(a, b) | Eq(a, b) | Ne(a, b) => primitive?(a) and primitive?(b) and pure?(a) and pure?(b)
  Or(...) | And(...) | Coalesce(...) | Seq(...) | StrictEq(...) | StrictNe(...)
    | Elem(...) | ElemLast(...) => all-pure?(n.kids)
  ArrayLit(List(xs...)) | ObjectLit(List(xs...)) => all-pure?(xs)
  # A key is a name, a literal or a well-known symbol (`pure-key?`), as esbuild has it; defining a
  # method runs nothing, whatever kind it is.
  Prop(key, v) => pure-key?(key) and pure?(v)
  Method(key, ...) | GenMethod(key, ...) | AsyncMethod(key, ...) | AsyncGenMethod(key, ...) | Getter(key, ...) | Setter(key, ...) =>
    pure-key?(key)
  ClassExpr(...) => pure-class?(n)
  CallExpr(...) => pure-call?(n)
  NewExpr(...) => pure-call?(n) or pure-new?(n)
  NewNoArgs(callee) => annotated?(n) or known-collection?(callee)
  # A template with no tag whose parts are primitives with no effect: making it text runs nothing.
  Template(_, e, List(ps...), _) => known-primitive?(e) and (all p in ps: known-primitive?(p.expr))
  # `ns.x` of `import * as ns` reads an import, as esbuild has it, whether the module is linked by
  # name or held in an import variable.
  Member(Ident(_) as o, PropName(_)) if namespace-import?(o) => true
  Member(...) => match m.dotted-name(n, body.bindings) {
    some(name) => name in known-global-properties
    none => false
  }
  # What esbuild folds to a literal as it parses is one by tree shaking: `"a" + 1`, `-(1)`, and with
  # `--minify-syntax` `1 - 2` (bundle.jsvalue).
  _ if is-some(jv.value-of(n, jv.Folding(minify: linking.minify-syntax, all: false))) => true
  _ => false
}

# Has no effect, and is a primitive: a template's part that becomes text calling nothing.
fn known-primitive?(n: Node) -> Bool = pure?(n) and (match n {
  Paren(x) => known-primitive?(x)
  Not(_) | Void(_) | TypeOf(_) | TemplateFull(_) | Template(...) => true
  Eq(...) | Ne(...) | StrictEq(...) | StrictNe(...) | Lt(...) | Gt(...) | Le(...) | Ge(...) => true
  _ => is-some(jv.value-of(n, jv.Folding(minify: linking.minify-syntax, all: false)))
})

# A value known to be a primitive, whatever it is.
fn primitive?(n: Node) -> Bool = match n {
  Str(_) | Num(_) | True() | False() | Null() | TypeOf(_) | Void(_) | TemplateFull(_) => true
  Neg(Num(_)) => true
  _ => false
}

# A free name read where a `typeof` test has found it is there, as esbuild allows:
# `typeof x !== "undefined" ? x : …`, `typeof x === "function" ? x : …`, `typeof x < "u" ? x : …`.
fn guarded-read?(value: Node, test: Node, yes: Bool) -> Bool = free-ident?(value) and (match test {
  StrictEq(a, b) | Eq(a, b) => compared?(value.text, a, b, yes, false)
  StrictNe(a, b) | Ne(a, b) => compared?(value.text, a, b, yes, true)
  Lt(a, b) | Le(a, b) => ordered?(value.text, a, b, yes, true)
  Gt(a, b) | Ge(a, b) => ordered?(value.text, a, b, yes, false)
  _ => false
})

# `typeof x` against a string: `x` is there in the branch where the type is not "undefined".
fn compared?(x: Text, a: Node, b: Node, yes: Bool, negated: Bool) -> Bool = match typeof-against(x, a, b) {
  some(t) => ((t == "undefined") == yes) == negated
  none => false
}

fn typeof-against(x: Text, a: Node, b: Node) -> Text? = match a, b {
  TypeOf(Ident(y)), Str(s) if y == x => some(unquote(s))
  Str(s), TypeOf(Ident(y)) if y == x => some(unquote(s))
  _, _ => none
}

# `typeof x < "u"`, as minified code writes it: below "undefined", so there.
fn ordered?(x: Text, a: Node, b: Node, yes: Bool, below: Bool) -> Bool = match a, b {
  TypeOf(Ident(y)), Str(s) if y == x and unquote(s) == "u" => yes == below
  Str(s), TypeOf(Ident(y)) if y == x and unquote(s) == "u" => yes != below
  _, _ => false
}

# A computed key (a class's or an object literal's) runs `ToPropertyKey`, so only a literal or a
# well-known symbol is known to do nothing.
fn pure-key?(key: Node) -> Bool = match key {
  Computed(e) => match e {
    Str(_) | Num(_) => true
    Member(o, _) => free-ident?(o) and o.text == "Symbol"
    _ => false
  }
  _ => true
}

fn pure-member?(member: Node) -> Bool = match member {
  ClassEmpty() => true
  Method(key, ...) | GenMethod(key, ...) | AsyncMethod(key, ...) | AsyncGenMethod(key, ...)
    | Getter(key, ...) | Setter(key, ...) | Field(key, _) => pure-key?(key)
  StaticMethod(inner) => pure-member?(inner)
  StaticField(key, v) => pure-key?(key) and pure?(v)
  _ => false
}

# A class with no heritage, computed keys or initialisers runs nothing. `extends` a pure expression
# runs nothing either.
fn pure-class?(n: Node) -> Bool =
  (n.heritage is None() or pure?(n.heritage.superclass)) and (all x in n.body.members.kids: pure-member?(x))

fn pure-declarators?(list: Node) -> Bool =
  all d in list.kids: d.target is BindName(_) and pure?(d.init)

fn pure-stmt?(s: Node) -> Bool = match s {
  FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) | Empty() | ExportFunction(_) => true
  VarDecl(list) | LetDecl(list) | ConstDecl(list) | ExportVar(list) => pure-declarators?(list)
  ExportLexical(d) | ExportClass(d) => pure-stmt?(d)
  ClassDecl(...) => pure-class?(s)
  ExprStmt(e) => pure?(e)
  _ => false
}

# ---------------------------------------------------------------- what linking works out

# What an `import()` or a `require` loads, and which of the two it is.
record Load { target: Int, by-import: Bool }

fn loads-of(mo: m.Module, n: Node) -> [Load] = match n {
  ImportCall(...) => [Load(target: known-dep(mo, n), by-import: true) for from in imported-str(n)]
  CallExpr(...) => [Load(target: known-required(mo, from), by-import: false) for from in required-str(body, n)]
  _ => []
}

# Every `require("x")` and `import("x")` in a module, in the order a walk meets them. Finding
# them is a walk of every tree, so modules are searched at once.
fn on-demand-calls(id: Int) -> [Node] = match m.modules[id] {
  # What a module's tree calls was found when it was loaded: one with none has nothing to walk.
  mo if mo.kind != Runtime and mo.calls => on-demand-calls-under(b.tree, b) where b = m.body-of(id)
  _ => []
}

# Calls inside these calls count too, after them.
everywhere fn on-demand-calls-under(n: Node, b: m.Body) -> [Node] = match n {
  ImportCall(...) if imported-str(n) is some(_) => [n] ++ [on-demand-calls-under(k, b)... for k in n.kids]
  CallExpr(...) if required-str(b, n) is some(_) => [n] ++ [on-demand-calls-under(k, b)... for k in n.kids]
}

# Which ES modules are `__esm` wrapped: anything loaded on demand runs when it is, and so must
# whatever it imports.
fn wrapping(id: Int, wrapped: {Int:Bool}) -> {Int:Bool} = match m.modules[id] {
  mo if mo.kind == Esm and not (id in wrapped) => fold w = wrapped ++ {id: true} for d in mo.deps: wrapping(d, w)
  _ => wrapped
}

fn none-wrapped() -> {Int:Bool} = {}

# A name an import statement binds: its symbol, the module it is from, and its name there.
# `importer`: the module the import is in; `at`: where in it the name it imports is written.
record Bound { symbol: Int, target: Int, name: Text, namespace: Bool, importer: Int, at: Int }

# Of the module `here` and its `body`.
fn import-bindings(mo: m.Module) -> [Bound] = match mo.kind {
  Esm => [b for s in body.tree.body.kids for b in statement-bindings(mo, s)]
  _ => []
}

fn statement-bindings(mo: m.Module, s: Node) -> [Bound] = match s {
  Import(clause, _, _) => clause-bindings(mo, known-dep(mo, s), clause)
  _ => []
}

fn clause-bindings(mo: m.Module, t: Int, spec: Node) -> [Bound] = match spec {
  ImportDefault(b) => [bound(mo, t, "default", b, false, b.lo)]
  ImportAs(name, b) => [bound(mo, t, m.module-name(name), b, false, name.lo)]
  ImportName(b) => [bound(mo, t, b.text, b, false, b.lo)]
  ImportNamespace(b) => [bound(mo, t, "*", b, true, b.lo)]
  ImportDefaultAnd(b, rest) => [bound(mo, t, "default", b, false, b.lo)] ++ clause-bindings(mo, t, rest)
  ImportNamed(List(specs...)) => [x for s in specs for x in clause-bindings(mo, t, s)]
  _ => panic "{}: unexpected import form {}", mo.path, js.kind-name(spec.kind)
}

fn bound(mo: m.Module, t: Int, name: Text, b: Node, namespace: Bool, at: Int) -> Bound =
  Bound(symbol: m.symbol-in(body, mo, b.lo) ?? (panic "{}: no symbol for import {}", mo.path, b.text), target: t, name: name, namespace: namespace,
        importer: mo.id, at: at % 4294967296)

# A name a module re-exports from CommonJS: a property of its import variable.
record Reexport { target: Int, name: Text, namespace: Bool, exported: Text }

fn statement-reexports(mo: m.Module, s: Node) -> [Reexport] = match s {
  ExportAllAs(name, _, _) => [Reexport(target: t, name: "*", namespace: true, exported: m.module-name(name))
                              for t in [known-dep(mo, s)] if opaque?(m.modules[t])]
  ExportFrom(List(specs...), _, _) =>
    [Reexport(target: t, name: m.module-name(spec.local), namespace: false, exported: export-spec-names(spec))
     for t in [known-dep(mo, s)] if opaque?(m.modules[t]) for spec in specs]
  _ => []
}

fn export-spec-names(spec: Node) -> Text = match spec {
  ExportAs(_, to) => m.module-name(to)
  _ => m.module-name(spec.local)
}

# The statements of a module that are not CommonJS, whose import statements stand for themselves: of
# the module `here` and its `body`.
fn linked-statements(mo: m.Module) -> [Node] = match mo.kind {
  Cjs => []
  _ => body.tree.body.kids
}

# The symbols a module needs made for it: CommonJS's `require_x`, an ES module's `x_exports`, and a
# wrapped one's `init_x`.
fn module-made(mo: m.Module, wrapped: {Int:Bool}) -> [Made] = match mo.kind {
  Cjs => [made-of(Require, mo, "require_" ++ mo.base)]
  Esm => [made-of(Exports, mo, mo.base ++ "_exports")] ++ [made-of(Init, mo, "init_" ++ mo.base) for id in [mo.id] if id in wrapped]
  _ => []
}

fn made-of(purpose: Purpose, mo: m.Module, name: Text) -> Made =
  Made(purpose: purpose, owner: mo.id, exported: "", scope: m.bundle-scope, name: name)

# What `export *` from an opaque module holds it in: an outside module kept as an ES import is
# `y_star`, as esbuild names it.
fn star-made(mo: m.Module, t: Int) -> Made = match kept?(m.modules[t]) {
  true => import-made(mo, t) with { name: m.modules[t].base ++ "_star" }
  false => import-made(mo, t)
}

fn import-made(mo: m.Module, t: Int) -> Made =
  Made(purpose: ImportVar, owner: import-key(mo, t), exported: "", scope: mo.root, name: "import_" ++ m.modules[t].base)

# Each import variable is made once.
fn made-once(x: Made) -> Int? = match x.purpose {
  ImportVar => some(x.owner)
  _ => none
}

# The symbols made for one purpose, by whose they are.
fn made-for(made: [Made], ids: [Int], purpose: Purpose) -> {Int:Int} =
  {made[i].owner: ids[i] for i in 0..len(made) if made[i].purpose == purpose}

# What a made symbol is, the same from one build to the next while it is made at all.
fn made-key(x: Made) -> Text = int-text(match x.purpose { Require => 0  Exports => 1  Init => 2  ImportVar => 3  ReexportName => 4 })
  ++ " " ++ int-text(x.owner) ++ " " ++ x.exported

# What a statement needs made: the variable an opaque import is held in, and the names re-exported
# from it.
fn statement-made(mo: m.Module, s: Node) -> [Made] = match s {
  Import(...) | ImportBare(...) => [import-made(mo, t) for t in [known-dep(mo, s)] if held?(m.modules[t])]
  ExportAll(...) => [star-made(mo, t) for t in [known-dep(mo, s)] if opaque?(m.modules[t]) and not kept-star?(mo, m.modules[t])]
  ExportAllAs(...) | ExportFrom(...) => [import-made(mo, t) for t in [known-dep(mo, s)] if held?(m.modules[t])]
    ++ [Made(purpose: ReexportName, owner: mo.id, exported: r.exported, scope: mo.root, name: reexport-name(r))
        for r in statement-reexports(mo, s)]
  _ => []
}

# A kept re-export's name is what it imports, as esbuild's is; one through an import variable says
# what it exports.
fn reexport-name(r: Reexport) -> Text = match kept?(m.modules[r.target]), r.namespace {
  true, true => r.exported
  true, false => r.name
  false, _ => "reexport_" ++ r.exported
}

# A module's parts, each standing for a statement. CommonJS's first is `Flag`, its wrapper's
# `require_x`; an ES module's are `None`, its namespace object, and `Flag`, the `__esm` wrapper's
# `init_x`, which brings the whole module with it. How many, for `statements` statements.
fn part-count(mo: m.Module, wrapped: {Int:Bool}, statements: Int) -> Int = match mo.kind {
  Cjs => 1 + statements
  _ => len(synthetic(mo, wrapped)) + statements
}

# Part `p`'s statement, of module `id`; with its body in hand, `stmt-in`.
fn stmt-of(id: Int, p: Int) -> Node = stmt-in(m.body-of(id), m.modules[id], p)

fn stmt-in(b: m.Body, mo: m.Module, p: Int) -> Node = match mo.kind {
  Cjs => match local {
    0 => Flag()
    _ => b.tree.body.kids[local - 1]
  }
  # The parts with no statement come first (see `synthetic`): the namespace, and a wrapper's flag.
  Esm => match local, mo.id in linked.wrapped {
    0, _ => None()
    1, true => Flag()
    _, true => b.tree.body.kids[local - 2]
    _, false => b.tree.body.kids[local - 1]
  }
  _ => b.tree.body.kids[local]
} where local = p - (linked.part-starts[mo.id] ?? panic "{} has no parts", mo.path)

fn synthetic(mo: m.Module, wrapped: {Int:Bool}) -> [Node] = match mo.kind, mo.id in wrapped {
  Esm, true => [None(), Flag()]
  Esm, false => [None()]
  _, _ => []
}

# `export * from` CommonJS: names only known at run time.
fn dynamic-star?(mo: m.Module, s: Node) -> Bool = match s {
  ExportAll(...) => opaque?(t) and not kept-star?(mo, t) where t = m.modules[known-dep(mo, s)]
  _ => false
}

# `export * from` an outside module, in an entry of ES module output, stays as it is, as esbuild
# leaves it: the runtime links the names, which the bundle cannot know.
fn kept-star?(mo: m.Module, t: m.Module) -> Bool = kept?(t) and mo.id in m.entries

# What linking works out, from each module's `import()` and `require` calls, before any fact. What a
# module loads on demand is wrapped, or with splitting, the root of a chunk of its own. The symbols
# linking makes are numbered from `first`: the modules' own, then the import statements' variables,
# then what the other statements need, each import variable made once.
# What linking needs of one module, kept while what it is made of stays the same: what it loads on
# demand, the names its imports bind, what it re-exports from CommonJS, the symbols its statements
# need made, whether it re-exports names only known at run time, and how many statements it has.
boxed record ModuleLink { loads: [Load], bindings: [Bound], reexports: [Reexport], made: [Made], dynamic: Bool, statements: Int, initializes: Bool, forwarding: Bool, imports: [Int], awaits: Bool, aliases: [AliasOf], objects: [Int] }

# A top-level `const` whose value is another name's (`const api = ns`): linking finds whether that
# name is a namespace object, and the `const` never written through (`api.x = …`, `delete api.x`),
# and then what is read of `api` by name is read of that module by name.
record AliasOf { alias: Int, of: Int }

# The top-level names of an ES module that hold an object literal some of whose properties may go
# when nothing reads them: declared once, their literal with no spread, no computed key, no
# `__proto__`, no key twice, and no `this` or `super` in it, which could be the object read whole.
# One the module assigns again or writes through is read whole (link.facts' `written`).
fn object-candidates(mo: m.Module, b: m.Body) -> [Int] = match mo.kind == Esm and linking.shake-properties {
  true => [s for st in b.tree.body.kids for d in object-declarators(st) if closed-object?(d.init) for s in m.symbol-in(b, mo, d.target.lo)]
  false => []
}

fn objects-of(candidates: [Int]) -> [Int] = [x for x in candidates if (count y in candidates: y == x) == 1]

fn closed-object?(o: Node) -> Bool = match o {
  ObjectLit(List(ps...)) => (all p in ps: plain-prop?(p)) and not mentions-this?(o)
                            and len([k for p in ps for k in [object-key-of(p)] distinct k]) == len(ps)
  _ => false
}

fn plain-prop?(p: Node) -> Bool = match p {
  Shorthand(_) => true
  Prop(PropName(k), _) => k != "__proto__"
  Prop(Str(_) as k, _) => unquote(k.text) != "__proto__"
  Prop(Num(_), _) => true
  Method(PropName(_), ...) | Method(Str(_), ...) | Getter(PropName(_), ...) | Setter(PropName(_), ...) => true
  _ => false
}

everywhere fn mentions-this?(n: Node) -> Bool = match n {
  This() | Super() => true
}

fn alias-candidates(mo: m.Module, b: m.Body) -> [AliasOf] = match mo.kind == Esm and linking.shake-properties {
  true => [x for st in b.source for d in const-declarators(st) for found in [alias-pair(b, mo, d)] if let some(x) = found]
  false => []
}

fn const-declarators(st: Node) -> [Node] = match st {
  ConstDecl(List(ds...)) => ds
  ExportLexical(ConstDecl(List(ds...))) => ds
  _ => []
}

fn alias-pair(b: m.Body, mo: m.Module, d: Node) -> AliasOf? = match d {
  Declarator(BindName(_) as name, Ident(_) as init) => match m.symbol-in(b, mo, name.lo), m.symbol-in(b, mo, init.lo) {
    some(a), some(r) => some(AliasOf(alias: a, of: r))
    _, _ => none
  }
  _ => none
}


fn module-link(id: Int) -> ModuleLink = with here = m.modules[id], body = m.body-of(id) {
  module-link-of(id, alias-candidates(here, body), object-candidates(here, body))
}

fn module-link-of(id: Int, aliases: [AliasOf], objects: [Int]) -> ModuleLink = {
  ModuleLink(loads: [loads-of(here, n)... for n in on-demand-calls(id)], bindings: import-bindings(here),
             reexports: [r for s in linked-statements(here) for r in statement-reexports(here, s)],
             made: [x for s in linked-statements(here) for x in statement-made(here, s)],
             dynamic: any s in linked-statements(here): dynamic-star?(here, s),
             statements: len(body.tree.body.kids),
             awaits: linking.splitting and ev.top-await?(body.tree),
             initializes: linking.splitting and not ev.module-inert?(body.tree),
             forwarding: linking.splitting and (all s in body.tree.body.kids: ev.inert-stmt(s)),
             imports: [target for s in body.tree.body.kids if linking.splitting for r in m.statement-request(s) for target in m.request-target(here, r) distinct target],
             aliases: aliases, objects: objects-of(objects))
}

fn linked-of(links: [ModuleLink], first: Int) -> Linked =
  Linked(wrapped: wrapped, scheduled: scheduled, init-owners: owners, asynchronous: asynchronous,
         awaiting: {m.order[i]: true for i in 0..len(links) if links[i].awaits}, dynamic-roots: roots, made: made, first-made: first, made-ids: ids, requires: made-for(made, ids, Require),
         namespaces: made-for(made, ids, Exports), inits: made-for(made, ids, Init), import-vars: import-vars,
         reexports: reexports,
         cjs-imports: {b.symbol: CjsImport(importer: id, import-var: symbol-in(import-vars, import-key(m.modules[id], b.target)),
                                           name: b.name, namespace: b.namespace)
                       for i in 0..len(m.order) for id in [m.order[i]] for b in bindings[i] if held?(m.modules[b.target])}
                      ++ {reexport-in(reexports, mo, r.exported):
                            CjsImport(importer: mo.id, import-var: symbol-in(import-vars, import-key(mo, r.target)), name: r.name,
                                      namespace: r.namespace)
                          for i in 0..len(m.order) for mo in [m.modules[m.order[i]]] for r in links[i].reexports
                          if held?(m.modules[r.target])},
         ns-imports: {b.symbol: b.target for bs in bindings for b in bs if b.namespace and not opaque?(m.modules[b.target])},
         named-imports: {b.symbol: true for bs in bindings for b in bs if not b.namespace and not opaque?(m.modules[b.target])},
         aliases: {x.alias: x.of for l in links for x in l.aliases},
         objects: {x: true for l in links for x in l.objects},
         part-starts: {m.order[k]: starts[k] for k in 0..len(m.order)},
         any-dynamic: any l in links: l.dynamic,
         any-reexport: any x in made: x.purpose == ReexportName)
  where loads = [x for l in links for x in l.loads],
        roots = [l.target for l in loads if linking.splitting and l.by-import and m.modules[l.target].kind != External distinct l.target],
        seeds = [l.target for l in loads if not (linking.splitting and l.by-import)],
        delayed = fold w = none-wrapped() for t in seeds: wrapping(t, w),
        asynchronous = if linking.splitting then checked-async(links, async-modules(links)) else {},
        scheduled = if linking.strict-order then scheduling(links, roots, asynchronous) else {},
        wrapped = delayed ++ scheduled,
        owners = initializer-owners(links, wrapped, scheduled, delayed, asynchronous),
        defining = {id: true for id in keys(wrapped) if (owners[id] ?? id) == id},
        bindings = [l.bindings for l in links],
        made = [x for x in [x for id in m.order for x in module-made(m.modules[id], defining)]
                           ++ [import-made(m.modules[m.order[i]], b.target) for i in 0..len(m.order) for b in bindings[i]
                               if held?(m.modules[b.target])]
                           ++ [x for l in links for x in l.made]
                distinct made-once(x)],
        ids = m.made-ids([made-key(x) for x in made]),
        import-vars = made-for(made, ids, ImportVar),
        reexports = {reexport-key(made[i].owner, made[i].exported): ids[i] for i in 0..len(made) if made[i].purpose == ReexportName},
        starts = m.part-starts([m.modules[id].path for id in m.order],
                                [part-count(m.modules[m.order[k]], wrapped, links[k].statements) for k in 0..len(m.order)])

# An inert module whose only guarded dependency is one initializer has exactly that
# initializer's evaluation behavior. Share its symbol rather than allocating another guard.
# Dependency-first proof excludes cycles, asynchronous evaluation, opaque dependencies and
# require-driven wrappers. Inert declarations remain ordinary module definitions.
fn initializer-owners(links: [ModuleLink], wrapped: {Int:Bool}, scheduled: {Int:Bool}, delayed: {Int:Bool}, asynchronous: {Int:Bool}) -> {Int:Int} =
  fold owners = {} for k in 0..len(m.order) for id in [m.order[k]] for l in [links[k]]
    if id in scheduled and not (id in delayed) and l.forwarding and not (id in asynchronous)
    if (all dep in l.imports: (positions[dep] ?? len(m.order)) < k and m.modules[dep].kind == Esm)
    for targets in [[owners[dep] ?? dep for dep in l.imports if dep in wrapped distinct owners[dep] ?? dep]]
    if len(targets) == 1: owners ++ {id: targets[0]}
  where positions = {m.order[i]: i for i in 0..len(m.order)}

# A module with observable evaluation, or a static dependency with such evaluation, receives
# a once-only initializer. Loading chunk definitions cannot execute it; importers call it in
# source import order. Pure leaves remain ordinary declarations with no wrapper overhead.
# Unimported entry/lazy roots with synchronous dependencies use host ESM evaluation directly;
# no other bundled module can bypass that host boundary to read their definitions early.
fn scheduling(links: [ModuleLink], dynamic-roots: [Int], asynchronous: {Int:Bool}) -> {Int:Bool} =
  {mo.id: true for mo in m.modules if mo.kind == Esm and not safe[mo.id]
    if not (mo.id in roots and not (mo.id in imported) and not (mo.id in required)
            and not (any dep in edges[mo.id]: dep in asynchronous))}
  where roots = {r: true for r in m.entries ++ dynamic-roots},
        imported = {dep: true for l in links for dep in l.imports},
        required = {load.target: true for l in links for load in l.loads if not load.by-import},
        by-id = {m.order[i]: links[i] for i in 0..len(m.order)},
        edges = [(first l in by-id[mo.id]: l.imports) ?? [] for mo in m.modules],
        inert = [mo.kind == Runtime or (mo.kind == Esm and ((first l in by-id[mo.id]: inert-link?(mo, l)) ?? false)) for mo in m.modules],
        safe = graph.closed-safe(edges, inert)

# A module whose evaluation nobody can observe: it has none, or its package says it has no side
# effects (`"sideEffects": false`) and it awaits nothing. Such a module's definitions run as its chunk
# loads, before anything that imports it reads them, as esbuild has it; only what a root uses of it
# is loaded for that root.
fn inert-link?(mo: m.Module, l: ModuleLink) -> Bool = not l.initializes or (not mo.side-effects and not l.awaits)

fn async-modules(links: [ModuleLink]) -> {Int:Bool} =
  {mo.id: true for mo in m.modules if mo.kind == Esm and not safe[mo.id]}
  where by-id = {m.order[i]: links[i] for i in 0..len(m.order)},
        edges = [(first l in by-id[mo.id]: l.imports) ?? [] for mo in m.modules],
        synchronous = [not ((first l in by-id[mo.id]: l.awaits) ?? false) for mo in m.modules],
        safe = graph.closed-safe(edges, synchronous)

# A synchronous require cannot wait for an async module graph. Reject that unsupported
# interoperation explicitly instead of exposing uninitialized bindings or emitting invalid JS.
fn checked-async(links: [ModuleLink], asynchronous: {Int:Bool}) -> {Int:Bool} {
  for l in links {
    for load in l.loads {
      if not load.by-import and load.target in asynchronous {
        panic "cannot require async ES module {}; use import() instead", m.modules[load.target].path
      }
    }
  }
  asynchronous
}

# ---------------------------------------------------------------- the facts

# Every fact linking states, in blocks: the entries', then each module's import bindings' and each
# module's own, then the name `default`'s. Each relation's rows are in the order the walk of the
# modules meets them. A block a module's edit leaves alone is the very block it was (a memo's
# answer), so what the database is brought up to date by is what the edit changed.
# Each module's facts are its own work. The names they use get their ids in the order of the
# blocks: every binding's, module by module, then every statement's.
fn fact-blocks() -> [[link.Fact]] =
  [entry-facts()] ++ [binding-facts-at(id) for id in m.order] ++ [module-facts-at(id) for id in m.order] ++ [default-facts()]

# The names a module keeps from everything else: its free names, and its nested scopes' that `eval`
# can reach.
fn module-reserved(id: Int) -> [Text] = m.modules[id].free ++ eval-kept(m.modules[id])

# The names of a module's nested scopes that `eval` can reach: they keep them, and nothing else may
# take them, as esbuild has it.
fn eval-kept(mo: m.Module) -> [Text] = match mo.kind {
  m.Cjs => kept-below(root.parent)
  _ => kept-below(mo.root)
} where root = sym.scope-at(m.table, mo.root)

fn kept-below(scope: Int) -> [Text] = match now.dynamic {
  true => [sym.symbol-at(m.table, s).name for s in now.symbols] ++ [kept-below(child)... for child in now.children]
  false => []
} where now = sym.scope-at(m.table, scope)

# `default`, once any fact names it: the name `export *` never passes on. Last, since the facts
# intern the names they use as they are made.
fn default-facts() -> [link.Fact] = [link.fact-default-name(id) for id in [known-name(m.names, "default")] if id >= 0]

# A module's facts, and the facts its import bindings state. The names they intern keep their ids
# from one build to the next (see `m.names`), so facts kept from an earlier build still say what
# they said.
fn module-facts-at(id: Int) -> [link.Fact] = with here = m.modules[id], body = m.body-of(id) {
  facts-of(id, summaries-of(id), linked.part-starts[id] ?? panic "{} has no parts", m.modules[id].path)
}

fn binding-facts-at(id: Int) -> [link.Fact] =
  [binding-facts(b)... for b in module-link(id).bindings] ++ [link.fact-const-alias(x.alias, x.of) for x in module-link(id).aliases]

fn entry-facts() -> [link.Fact] = match linking.splitting {
  true => [chunk-root(r)... for r in m.entries ++ linked.dynamic-roots]
  false => [link.fact-entry(m.entry), link.fact-keep-exports(m.entry)]
}

# An entry's exports stay whatever the format, as esbuild keeps them: they are what it is for.
fn chunk-root(r: Int) -> [link.Fact] = [link.fact-entry(r), link.fact-chunk-root(r), link.fact-keep-exports(r)]

# An import binding of an ES module: the name it imports, or the namespace.
fn binding-facts(b: Bound) -> [link.Fact] = match opaque?(m.modules[b.target]), b.namespace {
  true, _ => []
  false, true => [link.fact-ns-import(b.symbol, b.target)]
  false, false => [link.fact-import-of(b.symbol, b.target, m.name-id(b.name)), link.fact-import-at(b.symbol, b.importer, b.at)]
}

fn facts-of(id: Int, summaries: [Summary], start: Int) -> [link.Fact] = module-facts(m.modules[id], summaries, start)

# Facts for one module, its parts numbered from `start`. CommonJS is one opaque part with effects,
# whose only symbol is its `require_x`; its dependencies are whatever it `require`s.
fn module-facts(mo: m.Module, summaries: [Summary], start: Int) -> [link.Fact] =
  [link.fact-module-effects(id) for id in [mo.id] if mo.side-effects]
  ++ [link.fact-written(g) for s in mo.written for g in [s + mo.symbol-shift] if g in linked.aliases or g in linked.objects]
  ++ [link.fact-script(id) for id in [mo.id] if mo.script]
  ++ [link.fact-typescript(id) for id in [mo.id] if m.loader-of(mo.path) == "ts" or m.loader-of(mo.path) == "tsx"]
  ++ [link.fact-wrapped(mo.id) for id in [mo.id] if wrapped?(mo)]
  ++ [link.fact-delayed(mo.id) for id in [mo.id] if wrapped?(mo) and not scheduled?(mo)] ++ parts-facts(mo, summaries, start)

fn parts-facts(mo: m.Module, summaries: [Summary], start: Int) -> [link.Fact] = match mo.kind {
  Cjs => [link.fact-part-of(start, mo.id), link.fact-effect(start), link.fact-declares(start, require-sym(mo)),
          link.fact-mentions(start, helper(wrapper-helper("__commonJS")))]
         ++ [cjs-statement-facts(mo, summaries[i], start + 1 + i, i < directives)... for i in 0..len(summaries)]
    where directives = len([s for s in body.tree.body.kids while s is ExprStmt(Str(_))])
  _ => synthetic-facts(mo, start) ++ [part-facts(mo, stmts[i], summaries[i], first + i)... for i in 0..len(stmts)]
       ++ [export-local(mo, "default", default-name(mo, name)) for s in body.source if let some(name) = m.default-of(s)]
    where stmts = body.tree.body.kids,
          first = start + len(synthetic(mo, linked.wrapped))
}

fn default-name(mo: m.Module, name: Text) -> Text = match name {
  "" => mo.base ++ "_default"
  _ => name
}

# A statement of CommonJS: inside the wrapper, so its names are no top-level names, but a statement
# that reads one needs it, as esbuild has it. It stays for what it does, unless it does nothing; a
# directive such as "use strict" always does, and anything may be read when the module calls `eval`.
fn cjs-statement-facts(mo: m.Module, sm: Summary, part: Int, directive: Bool) -> [link.Fact] =
  [link.fact-part-of(part, mo.id)] ++ [link.fact-cjs-binding(s, part) for s in sm.declares]
  ++ [mention-facts(mo, part, x)... for x in sm.mentions]
  ++ [link.fact-effect(part) for p in [part] if directive or not sm.pure or sym.scope-at(m.table, mo.root).dynamic]

# The parts with no statement: the namespace object, which a format that exposes the entry as an
# object keeps; and the wrapper's `init_x`.
fn synthetic-facts(mo: m.Module, start: Int) -> [link.Fact] = match mo.kind, wrapped?(mo) {
  Esm, true if forwarded-init?(mo) => namespace-part(mo, start)
  Esm, true => namespace-part(mo, start) ++ [link.fact-part-of(start + 1, mo.id), link.fact-declares(start + 1, init-sym(mo)),
                                         link.fact-mentions(start + 1, helper(init-helper(mo)))]
                      ++ [link.fact-init-part(start + 1, mo.id) for id in [mo.id] if linking.splitting]
  Esm, false => namespace-part(mo, start)
  _, _ => []
}

fn namespace-part(mo: m.Module, part: Int) -> [link.Fact] =
  [link.fact-part-of(part, mo.id), link.fact-ns-part(part, mo.id), link.fact-ns-symbol(mo.id, ns-sym(mo)),
   link.fact-declares(part, ns-sym(mo))]
  ++ [link.fact-mentions(part, helper("__export")) for s in [mo] if any x in body.source: exporting?(x)]
  ++ entry-namespace(mo, part)

# A statement that exports: a module with none has an empty namespace object, and no `__export`.
# Asked of the statements as written: normalising has made `export default` a declaration.
fn exporting?(s: Node) -> Bool = starts-with(js.kind-name(s.kind), "Export")

fn entry-namespace(mo: m.Module, part: Int) -> [link.Fact] = match linking.entry-namespace and mo.id == m.entry {
  true => [link.fact-root-part(part), link.fact-mentions(part, helper("__toCommonJS"))]
  false => []
}

# The facts a summary stands for, in `part`.
fn summary-facts(mo: m.Module, part: Int, sm: Summary) -> [link.Fact] =
  [link.fact-declares(part, s) for s in sm.declares] ++ [mention-facts(mo, part, x)... for x in sm.mentions]

  ++ [f for o in sm.objects for f in [link.fact-object-literal(o.symbol, part)]
                                     ++ [link.fact-shakeable-prop(o.symbol, m.name-id(p.key)) for p in o.props]
                                     ++ [link.fact-prop-mentions(part, m.name-id(p.key), x) for p in o.props for x in p.mentions]]

fn mention-facts(mo: m.Module, part: Int, x: Mention) -> [link.Fact] = match x.reach {
  Symbol => [link.fact-mentions(part, x.id)]
  Member => [link.fact-ns-member(part, x.id, m.name-id(x.name))]
  ImportedMember => [link.fact-import-member(part, x.id, m.name-id(x.name))]
  AliasMember => [link.fact-alias-member(part, x.id, m.name-id(x.name))]
  Required => required-module(mo, part, m.modules[x.id])
  Whole => whole-module(mo, part, m.modules[x.id])
  # What `import()` of a chunk needs here: only the helper that makes CommonJS look like a module.
  Chunk => [link.fact-mentions(part, helper("__toESM")) for t in [m.modules[x.id]] if t.kind == Cjs]
    ++ [link.fact-mentions(part, helper("__loadCSS")) for id in [x.id] if len(m.stylesheets(id)) > 0]
}

# What `require` of a module needs: its wrapper, and an ES module made CommonJS.
fn required-module(mo: m.Module, part: Int, t: m.Module) -> [link.Fact] = match t.kind {
  External => required(part, t.id)
  Cjs => [link.fact-imports(mo.id, t.id), link.fact-mentions(part, require-sym(t))]
  _ => [link.fact-imports(mo.id, t.id), link.fact-mentions(part, init-sym(t)), link.fact-mentions(part, ns-sym(t)),
        link.fact-mentions(part, helper("__toCommonJS"))]
}

# What `import()` of a module in this bundle needs: its wrapper, and CommonJS made an ES module.
fn whole-module(mo: m.Module, part: Int, t: m.Module) -> [link.Fact] = match t.kind {
  Cjs => [link.fact-imports(mo.id, t.id), link.fact-mentions(part, require-sym(t)), link.fact-mentions(part, helper("__toESM"))]
  _ => [link.fact-imports(mo.id, t.id), link.fact-mentions(part, init-sym(t)), link.fact-mentions(part, ns-sym(t))]
}

fn export-local(mo: m.Module, exported: Text, local: Text) -> link.Fact =
  link.fact-local-export(mo.id, m.name-id(exported),
                         root-sym(mo, local) ?? panic "{}: export of {} which is not declared", mo.path, local)

# Only what a declaration binds is exported: never a name inside its value, such as a class's own.
everywhere fn exports-under(n: Node, mo: m.Module) -> [link.Fact] = match n {
  BindName(x) => [export-local(mo, x, x)]
  Declarator(target, _) => exports-under(target, mo)
  _ if sc.scope-kind(n.kind) == "function" => []
}

fn exported-by(mo: m.Module, s: Node) -> [link.Fact] = match s {
  ExportVar(...) => exports-under(s, mo)
  ExportLexical(d) => exports-under(d, mo)
  ExportFunction(d) => exports-under(d.name, mo)
  _ => []
}

# An import of a module: and of a wrapped one, its initialiser run where the import stood.
fn imported(mo: m.Module, part: Int, t: Int) -> [link.Fact] = [link.fact-imports(mo.id, t)] ++ initialised(part, m.modules[t])

fn initialised(part: Int, mo: m.Module) -> [link.Fact] = match wrapped?(mo) {
  true if scheduled?(mo) => [link.fact-mentions(part, init-sym(mo)), link.fact-initializes(part, init-owner(mo))]
  true => [link.fact-mentions(part, init-sym(mo)), link.fact-inits(part, mo.id)]
          ++ [link.fact-initializes(part, mo.id) for id in [mo.id] if linking.splitting]
  false => []
}

fn required(part: Int, t: Int) -> [link.Fact] = match m.modules[t] {
  m.Module(kind: m.Cjs, ...) as mo => [link.fact-mentions(part, require-sym(mo))]
  m.Module(kind: m.External, ...) if not linking.native-require => [link.fact-mentions(part, helper(if linking.node-require then "__nodeRequire" else "__require"))]
  _ => []
}

# A statement that re-exports from CommonJS holds the import itself.
fn reexport-import(mo: m.Module, part: Int, t: Int) -> [link.Fact] =
  [link.fact-declares(part, known-import-var(mo, t))] ++ required(part, t)
  ++ [link.fact-mentions(part, helper("__toESM")), link.fact-effect(part)]

# A name this module exports that is really a property of the import variable.
fn reexported(mo: m.Module, part: Int, exported: Text) -> [link.Fact] =
  [link.fact-local-export(mo.id, m.name-id(exported), s), link.fact-cjs-binding(s, part)]
  where s = reexport-sym(mo, exported)

# A name a kept `export … from` binds, as its import does, and exports.
fn kept-reexported(mo: m.Module, part: Int, exported: Text) -> [link.Fact] =
  reexported(mo, part, exported) ++ [link.fact-declares(part, reexport-sym(mo, exported))]

# One top-level statement of an ES module is one part.
fn part-facts(mo: m.Module, s: Node, sm: Summary, part: Int) -> [link.Fact] = [link.fact-part-of(part, mo.id)] ++ statement-facts(mo, s, sm, part)

fn statement-facts(mo: m.Module, s: Node, sm: Summary, part: Int) -> [link.Fact] = match s {
  Import(clause, _, _) => imported(mo, part, t) ++ import-facts(mo, part, t, clause, s) where t = known-dep(mo, s)
  ImportBare(...) => imported(mo, part, t) ++ held-by(mo, s, part, t, bare-import-facts(mo, part, t)) where t = known-dep(mo, s)
  ExportAll(...) => imported(mo, part, t) ++ star-facts(mo, part, t) where t = known-dep(mo, s)
  ExportAllAs(name, _, _) => imported(mo, part, t) ++ star-as-facts(mo, part, t, m.module-name(name), s) where t = known-dep(mo, s)
  ExportFrom(List(specs...), _, _) => imported(mo, part, t) ++ export-from-facts(mo, part, t, specs, s) where t = known-dep(mo, s)
  ExportNamed(List(specs...)) => [export-local(mo, export-spec-names(spec), m.module-name(spec.local)) for spec in specs]
  # The runtime's statements are only ever live through a mention. A wrapped module's are shaken as
  # any module's are, as esbuild shakes them: its initialiser runs what is left, and its imports
  # (`initialised`) still run what it imports first.
  _ => summary-facts(mo, part, sm) ++ exported-by(mo, s)
       ++ [link.fact-effect(part) for p in [part] if not (mo.kind == Runtime or sm.pure)]
}

# An import of an opaque module holds it in a variable, made an ES module. A kept one declares its
# own names, and stays for what loading the module does, as esbuild keeps it.
fn import-facts(mo: m.Module, part: Int, t: Int, clause: Node, s: Node) -> [link.Fact] = match held?(m.modules[t]), kept?(m.modules[t]) {
  true, _ => held-by(mo, s, part, t, [link.fact-declares(part, known-import-var(mo, t))] ++ required(part, t)
                                     ++ loading(part, m.modules[t]) ++ [link.fact-mentions(part, helper("__toESM"))])
             ++ [link.fact-cjs-binding(b.symbol, part) for b in clause-bindings(mo, t, clause)]
  _, true => [link.fact-declares(part, b.symbol) for b in clause-bindings(mo, t, clause)] ++ [link.fact-effect(part)]
  _, _ => []
}

# A module held in an import variable is held once: by the first statement of `mo` that imports it
# so (`holder?`), which declares the variable and loads the module. Another reads that variable, so
# what reads its names keeps the first; it writes nothing of its own.
fn held-by(mo: m.Module, s: Node, part: Int, t: Int, facts: [link.Fact]) -> [link.Fact] = match holder?(mo, s, t) {
  true => facts
  false => [link.fact-mentions(part, known-import-var(mo, t))]
}

fn holder?(mo: m.Module, s: Node, t: Int) -> Bool = ((first x in m.body-of(mo.id).tree.body.kids if holds?(mo, x, t): x.lo) ?? -1) == s.lo

# A statement that holds a module in an import variable when it is held: an import, a bare import,
# or a re-export of names from it.
fn holds?(mo: m.Module, s: Node, t: Int) -> Bool = match s {
  Import(...) | ImportBare(...) | ExportFrom(...) | ExportAllAs(...) => known-dep(mo, s) == t
  _ => false
}

# Holding a module in a variable runs it, which stays for what that does: unless its package says
# it does nothing (`"sideEffects": false`), when the statement stays only if what it holds is read,
# as esbuild drops an unused import of such a package.
fn loading(part: Int, t: m.Module) -> [link.Fact] = [link.fact-effect(part) for x in [part] if t.side-effects]

# `import "x"` of CommonJS, or of an outside module held in a variable, holds it in an import
# variable too, as esbuild writes it.
fn bare-import-facts(mo: m.Module, part: Int, t: Int) -> [link.Fact] = match held?(m.modules[t]), m.modules[t].kind {
  true, Cjs => [link.fact-declares(part, known-import-var(mo, t)), link.fact-mentions(part, helper("__toESM"))]
               ++ required(part, t) ++ loading(part, m.modules[t])
  true, _ => [link.fact-declares(part, known-import-var(mo, t))] ++ required(part, t) ++ [link.fact-effect(part)]
  # Kept as an import statement, it loads the module where it stands.
  false, _ => [link.fact-effect(part) for x in [t] if kept?(m.modules[t])]
}

# `export *`: from CommonJS, copied at run time onto the namespace object.
fn star-facts(mo: m.Module, part: Int, t: Int) -> [link.Fact] = match opaque?(m.modules[t]) {
  true if kept-star?(mo, m.modules[t]) => [link.fact-effect(part)]
  true if kept?(m.modules[t]) => [link.fact-declares(part, known-import-var(mo, t)), link.fact-effect(part), link.fact-dyn-star(mo.id, t),
                                  link.fact-mentions(part, helper("__reExport")), link.fact-mentions(part, ns-sym(mo))]
  true => reexport-import(mo, part, t) ++ [link.fact-dyn-star(mo.id, t), link.fact-mentions(part, helper("__reExport")),
                                       link.fact-mentions(part, ns-sym(mo))]
  false => [link.fact-star(mo.id, t)]
}

fn star-as-facts(mo: m.Module, part: Int, t: Int, exported: Text, s: Node) -> [link.Fact] = match held?(m.modules[t]), kept?(m.modules[t]) {
  true, _ => held-by(mo, s, part, t, reexport-import(mo, part, t)) ++ reexported(mo, part, exported)
  _, true => [link.fact-effect(part)] ++ kept-reexported(mo, part, exported)
  _, _ => [link.fact-local-export(mo.id, m.name-id(exported), ns-sym(m.modules[t]))]
}

fn export-from-facts(mo: m.Module, part: Int, t: Int, specs: [Node], s: Node) -> [link.Fact] = match held?(m.modules[t]), kept?(m.modules[t]) {
  true, _ => held-by(mo, s, part, t, reexport-import(mo, part, t)) ++ [reexported(mo, part, export-spec-names(spec))... for spec in specs]
  _, true => [link.fact-effect(part)] ++ [kept-reexported(mo, part, export-spec-names(spec))... for spec in specs]
  _, _ => [fact for spec in specs for name in [m.name-id(export-spec-names(spec))]
            for fact in [link.fact-reexport(mo.id, name, t, m.name-id(m.module-name(spec.local))),
                         link.fact-reexport-at(mo.id, name, spec.local.lo % 4294967296)]]
}

# ---------------------------------------------------------------- linking

# What linking works out, the symbols it makes numbered after the `symbols` the modules have.
fn link(symbols: Int) -> Linked = linked-of([module-link(id) for id in m.order], symbols)


# The modules' own tables joined, and the symbols linking makes after them: a table that shares each
# module's block and copies none, so what it costs is how many modules there are.
fn linked-table(g: m.Graph) -> sym.Table =
  sym.joined-from(g.blocks, g.scopes, g.symbols, linked.made-ids, [x.scope for x in linked.made], [x.name for x in linked.made])

# Every module's facts, once linking has worked out what it does, and what the rules derive from them.
fn solved-facts() -> link.Db = match [summaries-of(id) for id in m.order] { _ => checked(link.solved-blocks(fact-blocks())) }

# Linking's answers, once nothing imports what is not there and no module writes what the language
# forbids (in ES module output, what only strict code forbids too): else the build stops, saying where.
fn checked(db: link.Db) -> link.Db = match missing-exports(db) ++ forbidden-writes() {
  [] => db
  errors => fail-build(join(errors, "\n"))
}

fn forbidden-writes() -> [Text] =
  [located(id, f.at) ++ ": " ++ f.message for id in m.order for f in m.modules[id].forbidden if not f.strict or linking.esm-output]

# Each import, and each `export … from`, of a name its module does not export, in the program's
# order: where it is written, and what is missing from where.
fn missing-exports(db: link.Db) -> [Text] =
  [e.text for e in sort e in found by e.order]
  where found = [Missing(order: ((m.ranks[mo] ?? mo) * 4294967296) + at, text: missing-text(mo, at, d, n)) for db.missing-import(?mo, ?at, ?d, ?n)]
                ++ [Missing(order: ((m.ranks[mo] ?? mo) * 4294967296) + at, text: missing-text(mo, at, t, n)) for db.missing-reexport(?mo, ?at, ?t, ?n)]

record Missing { order: Int, text: Text }

fn missing-text(mo: Int, at: Int, target: Int, name: Int) -> Text =
  located(mo, at) ++ ": No matching export in \"" ++ m.shown-path(m.modules[target].path) ++ "\" for import \"" ++ name-of(m.names, name) ++ "\""

# `path:line:column` of a place in a module's source.
fn located(mo: Int, at: Int) -> Text = m.shown-path(m.modules[mo].path) ++ ":" ++ int-text(line) ++ ":" ++ int-text(at - line-start + 1)
  where text = m.body-of(mo).text,
        before = text[0..min(max(at, 0), len(text))],
        line = len(occurrences(before, ["\n"])) + 1,
        line-start = (last-index-of(before, "\n") ?? -1) + 1
