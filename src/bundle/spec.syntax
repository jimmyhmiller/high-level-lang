# A build spec (`.bundler`): output formats, and targets made of settings. Data, read when a
# program runs; `spec.rules` says what each setting means.
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-./] ;
fragment Keyword = ("bundler" | "target" | "end" | "entry" | "outfile" | "format"
                  | "global" | "define" | "main-fields" | "conditions" | "minify" | "pretty"
                  | "transform" | "optimize" | "sourcemap" | "platform" | "external"
                  | "alias" | "loader" | "banner" | "footer" | "tree-shaking" | "on-resolve"
                  | "on-load" | "prefix" | "suffix" | "exports" | "names" | "hoist-externals" | "jsx" | "jsx-factory"
                  | "jsx-fragment" | "jsx-import-source" | "jsx-dev" | "language") !NameChar ;
token Name = !Keyword [a-zA-Z_] NameChar* ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Num = [0-9]+ ;

rule File = "bundler" FormatDef* Target* -> File(formats, targets) ;

# An output format is something a spec can say, not a list the bundler knows.
rule FormatDef = "format" Name FormatPart* "end" -> FormatDef(name, parts) ;
rule FormatPart
  = "prefix" Str -> Prefix(text)
  | "suffix" Str -> Suffix(text)
  | "exports" Str -> ExportsVia(text)
  | "exports" "names" -> ExportsNames
  | "hoist-externals" -> HoistExternals
  ;

rule Target = "target" Name Setting* "end" -> Target(name, settings) ;
rule Setting
  = "entry" Str -> Entry(path)
  | "outfile" Str -> Outfile(path)
  | "format" Name -> Format(name)
  | "global" Str -> Global(name)
  | "define" Name "=" Value -> Define(key, value)
  | "main-fields" Name* -> MainFields(names)
  | "conditions" Name* -> Conditions(names)
  | "minify" Name* -> Minify(parts)
  | "pretty" -> Pretty
  | "sourcemap" -> Sourcemap
  | "platform" Name -> Platform(name)
  | "external" Name* -> External(names)
  | "alias" Str "=" Str -> Alias(from, to)
  | "loader" Str "=" Name -> Loader(extension, kind)
  | "banner" Str -> Banner(text)
  | "footer" Str -> Footer(text)
  | "tree-shaking" Name -> TreeShaking(state)
  | "jsx" Name -> Jsx(runtime)
  | "jsx-factory" Str -> JsxFactory(name)
  | "jsx-fragment" Str -> JsxFragment(name)
  | "jsx-import-source" Str -> JsxImportSource(name)
  | "jsx-dev" -> JsxDev
  | "language" Name -> SyntaxTarget(name)
  | "on-resolve" Name* -> OnResolve(steps)
  | "on-load" Name* -> OnLoad(steps)
  | "transform" Name* -> Transform(steps)
  | "optimize" Name* -> Optimize(steps)
  ;
rule Value = Str | Num | Name ;
