# One build, from options to a file. The command line and `.bundler` specs are both just ways of
# filling in `Options`.
rules bundle.api over bundle.js
use bundle.js as js
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.mangle as mangle
use bundle.resolve as res
use bundle.fold as fold
use bundle.minify as minify
use bundle.final as final
use bundle.minhost as host
use bundle.sourcemap as map
use bundle.jsx as jsx
use bundle.chunks as chunks
use bundle.naming as nm
use bundle.lower as lower
use bundle.cssbundle as cssb
use bundle.legal as legal
use bundle.tsconfig as tsc
use bundle.ascii as ascii
use bundle.finish as fin

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# An output format: text around the program, and how the entry's exports get out. `exports` is a
# statement in which `%` stands for the entry's namespace object.
record Format {
  prefix: Text,
  suffix: Text,
  exports: Text,
  export-names: Bool,
  hoist-externals: Bool
}

fn iife-format() -> Format =
  Format(prefix: "(()=>{", suffix: "})();\n", exports: "", export-names: false, hoist-externals: false)
fn cjs-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "module.exports=%;", export-names: false, hoist-externals: false)
fn esm-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "", export-names: true, hoist-externals: true)

record DefineText { key: Text, value: Text }

# How a build divides its work: how many threads load files, and into how many parts, on how many
# threads, the program is optimised and printed. All ones is the serial build.
record Plan {
  name: Text,
  load-threads: Int,
  optimize-parts: Int,
  optimize-threads: Int,
  print-parts: Int,
  print-threads: Int,
  facts-threads: Int,
  emit-threads: Int
}

fn serial-plan() -> Plan =
  Plan(name: "serial", load-threads: 1, optimize-parts: 1, optimize-threads: 1, print-parts: 1, print-threads: 1, facts-threads: 1, emit-threads: 1)

record Options {
  entry: Text,
  entries: [Text],
  outfile: Text,
  outdir: Text,
  outbase: Text,
  splitting: Bool,
  entry-names: Text,
  chunk-names: Text,
  format: Format,
  global-name: Text,
  minify-identifiers: Bool,
  minify-syntax: Bool,
  pretty: Bool,
  timing: Bool,
  sourcemap: Bool,
  defines: [DefineText],
  main-fields: [Text],
  conditions: [Text],
  extensions: [Text],
  external: [Text],
  platform-node: Bool,
  aliases: [m.TextPair],
  loaders: [m.TextPair],
  banner: Text,
  footer: Text,
  tree-shaking: Bool,
  has-transform: Bool,
  has-optimize: Bool,
  charset-ascii: Bool,
  drop-console: Bool,
  drop-debugger: Bool,
  pure: [Text],
  packages-external: Bool,
  public-path: Text,
  tsconfig: Text,
  plan: Plan,
  legal-comments: Text,
  jsx: jsx.Options,
  target: Int,
  on-resolve: [Fn(Text,Text)->Text?],
  on-load: [Fn(Text)->Text?],
  transform: Fn(Node)->Node,
  optimize: Fn(Node)->Node
}

fn keep-as-is(n: Node) -> Node = n

# What `minify syntax` means unless a build says otherwise.
fn default-optimize(n: Node) -> Node = fin.finished(minify.run(n), false)

fn options-new(entry: Text, outfile: Text) -> Options =
  Options(entry: entry, entries: [entry], outfile: outfile, outdir: "", outbase: "", splitting: false,
          entry-names: "[dir]/[name]", chunk-names: "[name]-[hash]",
          format: iife-format(), global-name: "",
          minify-identifiers: false, minify-syntax: false, pretty: false, timing: false, sourcemap: false,
          defines: [], main-fields: ["module", "main"], conditions: ["import", "browser"],
          extensions: [".tsx", ".ts", ".jsx", ".js", ".css", ".mjs", ".cjs", ".json"], external: [], platform-node: false,
          aliases: [], loaders: [], banner: "", footer: "", tree-shaking: true, has-transform: false, has-optimize: false, charset-ascii: true, drop-console: false, drop-debugger: false, pure: [],
          packages-external: false, public-path: "", tsconfig: "", plan: serial-plan(), legal-comments: "eof", jsx: jsx.options-new(), target: lower.no-lowering,
          on-resolve: [], on-load: [],
          transform: keep-as-is, optimize: default-optimize)

# Node's module system: builtins stay external, and packages resolve for node.
fn platform-node!(o: mut Options) -> Void {
  o.platform-node = true
  o.main-fields = ["main", "module"]
  o.conditions = ["node", "require"]
}

fn define!(o: mut Options, key: Text, value: Text) -> Void {
  o.defines += DefineText(key: key, value: value)
}

fn alias!(o: mut Options, from: Text, to: Text) -> Void {
  o.aliases += m.TextPair(key: from, value: to)
}

fn loader!(o: mut Options, extension: Text, kind: Text) -> Void {
  o.loaders += m.TextPair(key: extension, value: kind)
  if not (extension in o.extensions) { o.extensions += extension }
}

# How JSX is written out, by the name a command line or a spec uses for it.
fn jsx-runtime!(o: mut Options, name: Text) -> Void {
  o.jsx.explicit = true
  match name {
    "transform" => { o.jsx.runtime = jsx.Classic }
    "automatic" => { o.jsx.runtime = jsx.Automatic }
    "preserve" => { o.jsx.runtime = jsx.Preserve }
    other => panic "--jsx is transform, automatic or preserve, not {}", other
  }
}

fn jsx-factory!(o: mut Options, name: Text) -> Void {
  o.jsx.factory = name
  o.jsx.explicit = true
}
fn jsx-fragment!(o: mut Options, name: Text) -> Void {
  o.jsx.fragment = name
  o.jsx.explicit = true
}
fn jsx-import-source!(o: mut Options, name: Text) -> Void {
  o.jsx.import-source = name
  o.jsx.explicit = true
}
fn jsx-dev!(o: mut Options) -> Void {
  o.jsx.dev = true
  o.jsx.explicit = true
}

# `esnext`, or a year: `es2017`. Esbuild's browser names are not implemented.
fn target!(o: mut Options, name: Text) -> Void {
  if name == "esnext" {
    o.target = lower.no-lowering
  } else if name == "es6" {
    o.target = 2015
  } else if starts-with(name, "es") and len(name) == 6 {
    o.target = parse-int(name[2..6])
  } else {
    panic "--target={} is not implemented: use esnext, es6 or a year such as es2017", name
  }
}

# Every name a generated variable must stay clear of.
fn names-in-use() -> [Text] =
  nm.finals ++ [f for mo in m.modules for f in mo.free] ++ nm.keywords

fn for-target(o: Options, p: Node) -> Node {
  let dropped = if o.drop-console or o.drop-debugger then without-dropped(o, p) else p
  let lowered = if o.target >= lower.no-lowering then dropped else lower.run(dropped, o.target, names-in-use(), o.minify-identifiers)
  if o.charset-ascii { return in-parts(o, lowered, fin.ascii-only) }
  lowered
}

# `f` on each part of the program at once.
fn in-parts(o: Options, p: Node, f: Fn(Node)->Node) -> Node {
  if o.plan.optimize-parts <= 1 { return f(p) }
  in-pieces(p, o.plan.optimize-parts, o.plan.optimize-threads, f, false)
}

# `--drop:console` and `--drop:debugger`. Names are final here, and every free name was kept free, so
# `console` can only be the global one.
fn without-dropped(o: Options, n: Node) -> Node = match n {
  Debugger() => if o.drop-debugger then Empty() with { lo: n.lo, hi: n.hi } else n
  CallExpr(Member(Ident("console"), _), _) | OptCall(Member(Ident("console"), _), _) =>
    if o.drop-console then exp`void 0` else drop-kids(o, n)
  ExprStmt(CallExpr(Member(Ident("console"), _), _)) | ExprStmt(OptCall(Member(Ident("console"), _), _)) =>
    if o.drop-console then Empty() with { lo: n.lo, hi: n.hi } else drop-kids(o, n)
  _ => drop-kids(o, n)
}

fn drop-kids(o: Options, n: Node) -> Node = if len(n.kids) == 0 then n else n with { kids: [without-dropped(o, k) for k in n.kids] }

fn clear-words() -> [Text] = []

# ---------------------------------------------------------------- timing

state last-ms: Int = 0

fn lap(o: Options, label: Text) -> Void {
  if o.timing {
    let now = now-us()
    if last-ms > 0 {
      let us = now - last-ms
      print "{:>4}.{} ms  {}  ({} MB)", us / 1000, (us % 1000) / 100, label, max-rss() / 1048576
    }
    last-ms = now
  }
}

# ---------------------------------------------------------------- the build

# A define's value is a JavaScript expression in text: `false`, `"production"`, `1`.
fn define-value(text: Text) -> Node = js.parse(text ++ ";", "<define>").body.kids[0].expr

fn program-plus(p: Node, s: Node) -> Node = p with { body: List(p.body.kids ++ [s]...) }

# An entry that is itself wrapped only runs if something calls it.
fn run-entry(p: Node) -> Node {
  let mo = m.modules[m.entry]
  if mo.kind == m.Cjs {
    let call-me = e.final-of(mo.require-sym)
    program-plus(p, stmt`$call_me();`)
  } else if mo.wrapped {
    let call-me = e.final-of(mo.init-sym)
    program-plus(p, stmt`$call_me();`)
  } else {
    p
  }
}

fn to-common-js() -> Node {
  let to-cjs = e.helper-name("__toCommonJS")
  let ns = e.final-of(m.modules[m.entry].ns-sym)
  exp`$to_cjs($ns)`
}

# `export { a, b as c };` for the entry's names, and `var` statements for those a local name can't
# hold, which come first.
fn esm-exports() -> [Node] = exports-of-root(m.entry)

fn exports-of-root(root: Int) -> [Node] {
  if m.db.dynamic(root) {
    panic "{}: `export *` from a CommonJS or external module in the entry point of ES module output is not implemented yet", m.modules[root].path
  }
  let found = [exported(name-of(m.names, n), s) for n in e.unique-names([n for m.db.resolved(root, ?n, _)])
               if let some(s) = e.resolved-export(root, n)]
  let specs = [x.spec for x in found]
  [h for x in found for h in x.hoisted] ++ (if len(specs) == 0 then [] else [ExportNamed(List(specs...))])
}

# An export of the entry: its specifier, after a variable holding it when what it reads is no name.
record Exported { hoisted: [Node], spec: Node }

fn exported(name: Text, s: Int) -> Exported = match e.symbol-read(s) {
  Ident(local) => Exported(hoisted: [], spec: ExportAs(PropName(local), PropName(name)))
  read => {
    let hoisted = "export_" ++ name
    Exported(hoisted: [stmt`var $hoisted = $read;`], spec: ExportAs(PropName(hoisted), PropName(name)))
  }
}

# The output text: `prefix`, the printed program, `suffix`. `base` is where the program starts, for
# source map positions.
record Printed { text: Text, base: Int, marks: [Mark] }

fn printed(o: Options, p: Node, prefix: Text, suffix: Text) -> Printed {
  let r = rendered-in-parts(o, p)
  Printed(text: prefix ++ r.text ++ suffix, base: len(prefix), marks: r.marks)
}

# ---------------------------------------------------------------- work in parts

# A program's statements in `n` runs of about the same length, each a program of its own.
# Whether no rule joins this statement to the one after it: the optimiser merges a statement into
# its neighbour only when it is an expression, a `var`, `let` or `const`, or an `if`.
fn closed?(s: Node) -> Bool = match s {
  FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) | ClassDecl(...) => true
  _ => false
}

# How much work a statement is, near enough: its length in the source, or one when it was made.
fn weight(s: Node) -> Int = if s.hi > s.lo then s.hi - s.lo else 1

# The same for a node the build made around source, such as CommonJS's wrapper: its children's.
fn mass(n: Node) -> Int = if n.hi > n.lo then n.hi - n.lo else sum k in n.kids: mass(k)

# Statements cut into about `n` runs of about equal weight, each cut just after a declaration, so
# the runs optimise as the whole list would. Fewer when there are not such places enough.
fn runs-of(stmts: [Node], n: Int) -> [[Node]] {
  if n <= 1 or len(stmts) <= 1 { return [stmts] }
  # `before[j]`: the weight of the first j statements.
  let before = [0] ++ (scan w = 0 for s in stmts: w + weight(s))
  let total = last(before)
  # Each cut is the first after the last at which its share of the weight is reached, after a
  # statement that closes.
  let cuts: [Int] = fold cs = [0] for i in 1..n:
    match first j in last(cs) + 1..len(stmts): if before[j] >= total * i / n and closed?(stmts[j - 1]) then some(j) else none {
      some(j) => cs ++ [j]
      none => cs
    }
  let ends = cuts ++ [len(stmts)]
  [stmts[ends[i]..ends[i + 1]] for i in 0..len(cuts)]
}

# A program cut into runs of its statements, each a program of its own.
fn parts-of(p: Node, n: Int) -> [Node] {
  let runs = runs-of(p.body.kids, n)
  if len(runs) < 2 then [p] else [program-of(if i == 0 then p.hashbang else None(), runs[i]) for i in 0..len(runs)]
}

fn program-of(hashbang: Node, stmts: [Node]) -> Node = Program(hashbang, List(stmts...))

fn joined(p: Node, parts: [Node]) -> Node = p with { body: List([s for part in parts for s in part.body.kids]...) }

# ---------------------------------------------------------------- bodies in parts

# A CommonJS module is one statement, its wrapper, and so is a library inside one function: the
# work is in a single function body. Such a body is taken out of its statement, which keeps a hole,
# and cut into runs as a program is; the runs fill the hole again once they are done.
record Hole { at: Int, stmts: [Node] }
record Hollowed { shell: Node, holes: [Hole], total: Int }
record Taken { node: Node, stmts: [Node] }

# A hole's mark: an identifier no source can spell, which every pass leaves be and prints as it is.
fn hole-name(at: Int) -> Text = byte-text(1) ++ "hole" ++ int-text(at) ++ byte-text(1)

fn hole-mark(at: Int) -> Node = ExprStmt(Ident(hole-name(at)) with { lo: -1, hi: -1 }) with { lo: -1, hi: -1 }

# Each statement heavier than a part's share gives up the body most of it is in, when that body
# can be cut.
fn hollowed(p: Node, n: Int) -> Hollowed {
  let stmts = p.body.kids
  let weights = [max(1, mass(s)) for s in stmts]
  let total = sum w in weights: w
  let takes = [if weights[i] * n > total then cut-body(taken(stmts[i], hole-mark(i)), total, n) else none for i in 0..len(stmts)]
  let kept = [taken-or(takes[i], stmts[i]) for i in 0..len(stmts)]
  Hollowed(shell: p with { body: List(kept...) }, holes: [Hole(at: i, stmts: t.stmts) for i in 0..len(stmts) if let some(t) = takes[i]],
           total: total)
}

fn cut-body(t: Taken?, total: Int, n: Int) -> Taken? = match t {
  some(x) if len(runs-of(x.stmts, share(x.stmts, total, n))) > 1 => t
  _ => none
}

# How many parts a run of statements gets of `n` for all `total`.
fn share(stmts: [Node], total: Int, n: Int) -> Int = max(1, n * (sum s in stmts: max(1, mass(s))) / total)

fn taken-or(t: Taken?, s: Node) -> Node = match t {
  some(x) => x.node
  none => s
}

# The deepest function body holding nearly all of a node's work, swapped for `mark`.
fn taken(n: Node, mark: Node) -> Taken? = match n {
  FuncBody(List(ss...)) => match taken-below(n, mark) {
    some(t) => some(t)
    none => if len(ss) > 1 then some(Taken(node: n with { stmts: n.stmts with { kids: [mark] } }, stmts: ss)) else none
  }
  _ => taken-below(n, mark)
}

# Through the child that holds nearly all of a node's work, if one does.
fn taken-below(n: Node, mark: Node) -> Taken? {
  let whole = mass(n)
  match first i in 0..len(n.kids): if mass(n.kids[i]) * 10 >= whole * 9 then some(i) else none {
    some(i) => match taken(n.kids[i], mark) {
      some(t) => some(Taken(node: n with { kids: [if j == i then t.node else n.kids[j] for j in 0..len(n.kids)] }, stmts: t.stmts))
      none => none
    }
    none => none
  }
}

# A hole filled with its body's statements.
everywhere fn filled(n: Node, bodies: {Text:[Node]}) -> Node = match n {
  FuncBody(List(ExprStmt(Ident(x)))) if x in bodies => n with { stmts: n.stmts with { kids: bodies[x] ?? panic "lost a body" } }
}

# A body's runs, as many as its share of the work.
fn body-parts(hole: Hole, total: Int, n: Int) -> [Node] =
  [program-of(None(), r) for r in runs-of(hole.stmts, share(hole.stmts, total, n))]

# Where each body's parts start among all the parts, the shell's first; and where the last ends.
fn body-starts(shell-parts: Int, bodies: [[Node]]) -> [Int] = [shell-parts] ++ (scan at = shell-parts for b in bodies: at + len(b))

# Whether a rule for a function body's end would have changed the body these statements end: a
# `return;` last, or an `if (c) return;` with anything after it. Then the body is done whole.
record Ends { bare: Bool, early: Bool, early-last: Bool }

fn ends-of(ss: [Node]) -> Ends =
  Ends(bare: len(ss) > 0 and last(ss) is Return(None()),
       early: any s in ss[0..max(0, len(ss) - 1)]: early-return?(s),
       early-last: len(ss) > 0 and early-return?(last(ss)))

fn early-return?(s: Node) -> Bool = s is If(_, Return(None()), None())

fn end-changed?(es: [Ends]) -> Bool =
  len(es) > 0 and ((any e in es: e.early) or (any k in 0..len(es) - 1: es[k].early-last) or last(es).bare)

# `f` of each part at once, the program's runs and its bodies' runs, put back together. When `f`
# minifies and a body's end would have changed, all of it is done in top-level parts instead.
fn in-pieces(p: Node, n: Int, threads: Int, f: Fn(Node)->Node, minifying: Bool) -> Node {
  let h = hollowed(p, n)
  if len(h.holes) == 0 { return joined(p, heaviest-first(parts-of(p, n), f, threads)) }
  let shell-parts = parts-of(h.shell, n)
  let bodies = [body-parts(hole, h.total, n) for hole in h.holes]
  let done = heaviest-first(shell-parts ++ [x for b in bodies for x in b], f, threads)
  let starts = body-starts(len(shell-parts), bodies)
  let made = [[s for d in done[starts[k]..starts[k + 1]] for s in d.body.kids] for k in 0..len(bodies)]
  if minifying and (any b in made: end-changed?([ends-of(b)])) {
    return joined(p, heaviest-first(parts-of(p, n), f, threads))
  }
  filled(joined(h.shell, done[0..len(shell-parts)]), {hole-name(h.holes[k].at): made[k] for k in 0..len(made)})
}

# The optimiser on each part at once. Parts end after declarations, which nothing merges with
# what follows, so this is the program the optimiser would make of the whole. A spec's own
# optimiser is given top-level parts only: what it does to a body with a hole is its own.
fn optimized(o: Options, p: Node) -> Node {
  if o.plan.optimize-parts <= 1 { return o.optimize(p) }
  if o.has-optimize { return joined(p, heaviest-first(parts-of(p, o.plan.optimize-parts), o.optimize, o.plan.optimize-threads)) }
  in-pieces(p, o.plan.optimize-parts, o.plan.optimize-threads, o.optimize, true)
}

# ---------------------------------------------------------------- the back half at once

# When nothing between minifying and printing needs the whole program, each part is minified,
# made ASCII and printed in one go: no barrier between them, and no program put back together
# only to be cut again. The parts print as the whole would, since printing cuts anywhere.
fn fusable?(o: Options) -> Bool =
  o.minify-syntax and not o.has-optimize and o.plan.optimize-parts > 1 and o.plan.print-parts > 1
  and o.target >= lower.no-lowering and not o.drop-console and not o.drop-debugger


# A part minified, made ASCII and printed, and how its statements end.
record Piece { rendered: Rendered, ends: Ends }

fn finished-piece(p: Node) -> Piece {
  let t = fin.finished(minify.run(p), printing.ascii)
  Piece(rendered: render-part(t), ends: ends-of(t.body.kids))
}

fn printed-piece(p: Node) -> Piece = Piece(rendered: render-part(p), ends: ends-of([]))

fn finished-output(o: Options, f: Format, p: Node) -> Printed {
  let r = rendered-pieces(o, p, o.plan.optimize-parts, o.plan.optimize-threads, finished-piece, true)
  # What the format adds goes after, as it is: it was never minified.
  let exports = export-statements(f)
  let all = pieces-joined(o, [r] ++ (if len(exports) == 0 then [] else [render-part(Program(None(), List(exports...)))]))
  Printed(text: f.prefix ++ all.text ++ f.suffix, base: len(f.prefix), marks: all.marks)
}

# `f` of each part at once, the heaviest started first, so the last to finish is a light one; the
# results in the parts' order.
fn heaviest-first(parts: [Node], f: Fn(Node)->Node, threads: Int) -> [Node] {
  let order = heaviest-order(parts)
  let done = parallel-map([parts[i] for i in order], f, threads)
  let place = {order[k]: k for k in 0..len(order)}
  [done[place[i] ?? panic "a part that was not done"] for i in 0..len(parts)]
}

fn heaviest-pieces(parts: [Node], f: Fn(Node)->Piece, threads: Int) -> [Piece] {
  let order = heaviest-order(parts)
  let done = parallel-map([parts[i] for i in order], f, threads)
  let place = {order[k]: k for k in 0..len(order)}
  [done[place[i] ?? panic "a part that was not done"] for i in 0..len(parts)]
}

fn heaviest-order(parts: [Node]) -> [Int] = sort i in [i for i in 0..len(parts)] by part-weight(parts[i]) desc

fn part-weight(p: Node) -> Int = sum s in p.body.kids: weight(s)

fn folded(o: Options, p: Node) -> Node {
  if o.plan.optimize-parts <= 1 { return fold.run(p) }
  in-pieces(p, o.plan.optimize-parts, o.plan.optimize-threads, fold.run, false)
}

# How parts are printed, which the threads that print them read: set with the build's other settings.
record Printing { pretty: Bool, maps: Bool, ascii: Bool }
state printing: Printing = Printing(pretty: false, maps: false, ascii: false)

fn render-part(p: Node) -> Rendered = js.render-tracked(p, printing.pretty, printing.maps)

# Each part printed at once, the texts joined end to end, and every source map mark moved to
# where its part landed. A part that ends where the printer dropped a `;` gets it back, as the
# printer would have written it had the next part followed.
fn rendered-in-parts(o: Options, p: Node) -> Rendered {
  if o.plan.print-parts <= 1 { return js.render-tracked(p, o.pretty, o.sourcemap) }
  rendered-pieces(o, p, o.plan.print-parts, o.plan.print-threads, printed-piece, false)
}

# `f` of each part at once, printing it, and the texts put together: each body's parts joined, and
# spliced into the shell's text where its hole printed, the marks after it moved along. When `f`
# minifies and a body's end would have changed, all of it is done in top-level parts instead.
fn rendered-pieces(o: Options, p: Node, n: Int, threads: Int, f: Fn(Node)->Piece, minifying: Bool) -> Rendered {
  let h = hollowed(p, n)
  if len(h.holes) == 0 { return pieces-joined(o, [d.rendered for d in heaviest-pieces(parts-of(p, n), f, threads)]) }
  let shell-parts = parts-of(h.shell, n)
  let bodies = [body-parts(hole, h.total, n) for hole in h.holes]
  let done = heaviest-pieces(shell-parts ++ [x for b in bodies for x in b], f, threads)
  let starts = body-starts(len(shell-parts), bodies)
  let changed = minifying and (any k in 0..len(bodies): end-changed?([d.ends for d in done[starts[k]..starts[k + 1]]]))
  let shell = pieces-joined(o, [d.rendered for d in done[0..len(shell-parts)]])
  let texts = [pieces-joined(o, [d.rendered for d in done[starts[k]..starts[k + 1]]]) for k in 0..len(bodies)]
  let whole: Rendered? = if changed then none else spliced(shell, [hole-name(hole.at) for hole in h.holes], texts)
  whole ?? pieces-joined(o, [d.rendered for d in heaviest-pieces(parts-of(p, n), f, threads)])
}

# Each body where its hole printed, in one pass: the shell's text between holes and the bodies'
# texts written out in turn, and each mark moved by what the holes before it grew by. Nothing when
# the holes did not print once each, in order.
fn spliced(shell: Rendered, names: [Text], bodies: [Rendered]) -> Rendered? {
  let at = occurrences(shell.text, [byte-text(1) ++ "hole"])
  if len(at) != len(names) or not (all k in 0..len(at): at?(shell.text, at[k], names[k])) { return none }
  # `grown[k]`: how much longer the text is before hole k than the shell's; `from[k]`: where the
  # shell's text after hole k - 1 starts.
  let grown = [0] ++ (scan d = 0 for k in 0..len(at): d + len(bodies[k].text) - len(names[k]))
  let from = [0] ++ [at[k] + len(names[k]) for k in 0..len(at)]
  let upto = at ++ [len(shell.text)]
  # The shell's marks after hole k - 1 up to hole k, a mark on the hole itself being the first of
  # the body's tokens, then body k's.
  let outs = [mk.out for mk in shell.marks]
  let cut = [0] ++ [bisect(outs, a) for a in at] ++ [len(outs)]
  let marks = [mk for k in 0..len(at) + 1
                  for mk in [Mark(out: m.out + grown[k], src: m.src) for m in shell.marks[cut[k]..cut[k + 1]]]
                            ++ (if k < len(at) then [Mark(out: m.out + at[k] + grown[k], src: m.src) for m in bodies[k].marks] else [])]
  some(Rendered(text: join([shell.text[from[k]..upto[k]] ++ (if k < len(at) then bodies[k].text else "") for k in 0..len(at) + 1], ""),
                marks: marks, open: shell.open))
}

# Rendered pieces one after another, a `;` between two where the first left a statement open, and
# each piece's marks moved by where it starts.
fn pieces-joined(o: Options, pieces: [Rendered]) -> Rendered {
  let gaps = [if i > 0 and pieces[i - 1].open and len(pieces[i].text) > 0 then (if o.pretty then ";\n" else ";") else ""
              for i in 0..len(pieces)]
  let ends = scan at = 0 for i in 0..len(pieces): at + len(gaps[i]) + len(pieces[i].text)
  Rendered(text: join([gaps[i] ++ pieces[i].text for i in 0..len(pieces)], ""),
           marks: [Mark(out: mk.out + ends[i] - len(pieces[i].text), src: mk.src) for i in 0..len(pieces) for mk in pieces[i].marks],
           open: len(pieces) > 0 and last(pieces).open)
}

# Every `%` in a format's statement, as this text.
fn fill-in(template: Text, value: Text) -> Text = replace-all(template, "%", value)

# A format's statements, once the names they refer to are final.
fn export-statements(f: Format) -> [Node] {
  if f.export-names { return esm-exports() }
  if len(f.exports) == 0 { return [] }
  let ns = js.render(to-common-js(), false)
  [js.parse(fill-in(f.exports, ns), "<format>").body.kids[0]]
}

fn wrap-format(o: Options, f: Format, p: Node) -> Printed =
  printed(o, fold whole = p for x in export-statements(f): program-plus(whole, x), f.prefix, f.suffix)

# `--global-name`: an IIFE whose value is the entry's namespace.
fn named(f: Format, global-name: Text) -> Format =
  if len(global-name) == 0 then f
  else f with { prefix: "var " ++ global-name ++ "=" ++ f.prefix, exports: "return %;" }

fn has-define?(o: Options, key: Text) -> Bool = any d in o.defines: d.key == key

# A browser has no `process`, so the build decides. Node's programs decide when they run.
fn with-node-env(o: Options) -> Options =
  if has-define?(o, "process.env.NODE_ENV") or o.platform-node then o
  else o with { defines: o.defines ++ [DefineText(key: "process.env.NODE_ENV",
                                                  value: if o.minify-syntax then "\"production\"" else "\"development\"")] }

# How the build loads, links and emits, as the modules that do it are told.
fn loading-of(o: Options, out-dir: Text) -> m.Loading =
  m.Loading(defines: [m.Define(key: d.key, value: define-value(d.value)) for d in o.defines], transform: o.transform,
            has-transform: o.has-transform, aliases: o.aliases, loaders: o.loaders, on-resolve: o.on-resolve,
            on-load: o.on-load, jsx-options: o.jsx, out-dir: out-dir, load-threads: o.plan.load-threads,
            packages-external: o.packages-external, public-path: o.public-path)

fn linking-of(o: Options, entry-namespace: Bool, keep-entry-exports: Bool, splitting: Bool) -> an.Linking =
  an.Linking(entry-namespace: entry-namespace, keep-entry-exports: keep-entry-exports, tree-shaking: o.tree-shaking,
             splitting: splitting, pure-names: o.pure, facts-threads: o.plan.facts-threads)

fn emitting-of(o: Options, esm-output: Bool) -> e.Emitting =
  e.Emitting(void-undefined: o.minify-syntax, esm-output: esm-output, sourcemap: o.sourcemap, emit-threads: o.plan.emit-threads)

# A new build: every module's state as it starts, and what it was told.
fn configure!(o: Options, loading: m.Loading, linking: an.Linking, emitting: e.Emitting) -> Void {
  reset-all(o)
  m.loading = loading
  an.linking = linking
  e.emitting = emitting
  printing = Printing(pretty: o.pretty, maps: o.sourcemap, ascii: o.charset-ascii)
}

fn reset-all(o: Options) -> Void {
  m.reset-state!()
  m.forget-memos!()
  arrivals-reset!()
  an.reset-state!()
  e.reset-state!()
}

# The names esbuild gives output files: the entry's path below the entries' common directory.
fn common-dir(paths: [Text]) -> Text = fold dir = dir-of(paths[0]) for p in paths: enclosing(dir, p)

fn enclosing(dir: Text, path: Text) -> Text =
  if dir == "." or starts-with(path, dir ++ "/") then dir else enclosing(dir-of(dir), path)

fn below(dir: Text, path: Text) -> Text =
  if dir == "." then path else path[len(dir) + 1..len(path)]

fn entry-output(o: Options, entry: Text, base: Text) -> Text {
  let rel = below(base, entry)
  let dir = dir-of(rel)
  let name = chunks.pattern-path(o.entry-names, if dir == "." then "" else dir, path-stem(rel), "")
  o.outdir ++ "/" ++ name ++ ".js"
}

fn base-dir(o: Options) -> Text = if len(o.outbase) > 0 then o.outbase else common-dir(o.entries)

# One bundle, or one per entry, or one split into chunks, each name looked up as the options say.
fn build(options: Options) -> Void =
  with res.options = resolve-options(options), tsc.forced = options.tsconfig, ascii.braces = options.target >= 2015,
       cssb.loaders = loader-map(options) {
    built(options)
  }

fn built(options: Options) -> Void {
  if options.splitting {
    build-split(options)
  } else if len(options.outdir) > 0 {
    let base = base-dir(options)
    for entry in options.entries {
      build-one(options with { entry: entry, entries: [entry], outfile: entry-output(options, entry, base) })
    }
  } else if len(options.entries) > 1 {
    panic "several entry points need --outdir"
  } else {
    build-one(options)
  }
}

fn loader-map(o: Options) -> {Text:Text} = {l.key: l.value for l in o.loaders}

fn resolve-options(o: Options) -> res.Options =
  res.Options(main-fields: o.main-fields, conditions: o.conditions, extensions: o.extensions,
              external: o.external, node-builtins: o.platform-node)

fn with-extension(path: Text, ext: Text) -> Text {
  let dir = dir-of(path)
  (if dir == "." and not starts-with(path, "./") then "" else dir ++ "/") ++ path-stem(path) ++ ext
}

# A stylesheet entry: its imports and the files it names, and nothing for JavaScript to do.
fn build-css(o: Options) -> Void {
  reset-all(o)
  let b = cssb.bundle([o.entry], o.outfile, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)
  write-sheet(o.outfile, b)
  cssb.write-assets(b.assets)
}

# A bundled stylesheet, and its legal comments' file when it has one.
fn write-sheet(path: Text, b: cssb.Bundled) -> Void {
  if len(b.legal) > 0 { write-file(path ++ ".LEGAL.txt", b.legal) }
  write-file(path, b.text)
  print "{} bytes -> {}", len(b.text), path
}

# The files the program's modules stand for, copied beside it: what the file loader gives.
fn module-assets(out-dir: Text) -> [cssb.Asset] =
  [cssb.asset-of(mo.path, out-dir) for mo in m.modules if mo.kind != m.External and m.loader-of(mo.path) == "file"]

fn build-one(options: Options) -> Void {
  if ends-with(options.entry, ".css") { return build-css(options) }
  if options.pretty and options.jsx.runtime == jsx.Preserve {
    panic "pretty output would change the text of JSX that is kept: --jsx=preserve with --pretty is not implemented"
  }
  let o = with-node-env(options)
  let f = if o.format.export-names or len(o.format.exports) > 0 then o.format else named(o.format, o.global-name)
  configure!(o, loading-of(o, dir-of(o.outfile)), linking-of(o, len(f.exports) > 0, f.export-names, false),
             emitting-of(o, f.hoist-externals))
  lap(o, "startup")
  m.load-runtime(include-text("runtime.js"))
  m.parse-ahead!([o.entry])
  lap(o, "load: parse files ahead")
  m.load-tree(o.entry)
  lap(o, "load: resolve, scopes, the graph")
  an.link()
  lap(o, "link: facts and Datalog")
  with nm.finals = final-names(o) { named-build(o, f) }
}

# Each symbol's name: minified, or as esbuild's number renamer gives them.
fn final-names(o: Options) -> [Text] = match o.minify-identifiers {
  true => mangle.minified-names(o.plan.emit-threads)
  false => nm.esbuild-names()
}

# The rest of a build, once every symbol has its name.
fn named-build(o: Options, f: Format) -> Void {
  lap(o, "naming")
  let emitted = run-entry(e.program())
  lap(o, "emit: rewrite identifiers")
  let fused = fusable?(o)
  let p = if fused then emitted else for-target(o, if o.minify-syntax then optimized(o, emitted) else folded(o, emitted))
  lap(o, "minify rules")
  let out0 = if fused then finished-output(o, f, p) else wrap-format(o, f, p)
  # The banner and hoisted external imports come first, ahead of everything the map describes.
  let head = (if len(o.banner) > 0 then o.banner ++ "\n" else "") ++ join(e.external-imports, "")
  let footer = if len(o.footer) > 0 then o.footer ++ "\n" else ""
  let notes = legal.placed(o.legal-comments, legal-of-modules(none), o.outfile)
  let full = head ++ out0.text ++ footer ++ notes.tail
  let base = len(head) + out0.base
  let text = if o.sourcemap then full ++ "//# sourceMappingURL=" ++ path-base(o.outfile) ++ ".map\n" else full
  if len(notes.file) > 0 { write-file(o.outfile ++ ".LEGAL.txt", notes.file) }
  lap(o, "print")
  write-file(o.outfile, text)
  if o.sourcemap { write-file(o.outfile ++ ".map", map.build-map(full, base, out0.marks, o.outfile)) }
  print "{} bytes -> {}", len(text), o.outfile
  # Stylesheets the program imports go beside it, under its name.
  let sheets = m.css-imports()
  let css-out = with-extension(o.outfile, ".css")
  let css: [cssb.Bundled] = [cssb.bundle(sheets, css-out, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)
                             for s in [sheets] if len(s) > 0]
  for b in css { write-sheet(css-out, b) }
  cssb.write-assets([a for b in css for a in b.assets] ++ module-assets(dir-of(o.outfile)))
  lap(o, "write")
}

# ---------------------------------------------------------------- code splitting

state chunk-of-root: {Int:Int} = {}

fn path-of-root(root: Int) -> Text {
  let c = chunk-of-root[root] ?? panic "{} has no chunk", m.modules[root].path
  chunks.placeholder(c)
}

# The legal comments of the modules in the output, or in one chunk of it, in module order.
fn legal-of-modules(chunk: chunks.Chunk?) -> [legal.Note] =
  [legal.Note(path: m.modules[id].path, text: t) for id in m.order if in-output?(chunk, id) for t in m.modules[id].legal]

fn in-output?(chunk: chunks.Chunk?, id: Int) -> Bool = match chunk {
  some(c) => any p in e.parts-of(id): p in c.parts
  none => e.included?(id)
}

# What running this chunk's entry looks like at its end.
fn root-statements(root: Int) -> [Node] {
  let mo = m.modules[root]
  if mo.kind == m.Cjs {
    let call-me = e.final-of(mo.require-sym)
    return [stmt`export default $call_me();`]
  }
  if not mo.wrapped { return exports-of-root(root) }
  let call-me = e.final-of(mo.init-sym)
  [stmt`$call_me();`] ++ exports-of-root(root)
}

# The body of one chunk, as text with placeholders in it.
fn chunk-program(o: Options, c: chunks.Chunk, all: [chunks.Chunk]) -> Printed {
  e.in-chunk = true
  e.chunk-parts = c.parts
  e.external-imports = []
  let body = e.program()
  let p = for-target(o, if o.minify-syntax then o.optimize(body) else fold.run(body))
  let stmts = chunks.imports-of(c, all) ++ p.body.kids ++ (if c.root >= 0 then root-statements(c.root) else []) ++ chunks.exports-of(c, all)
  let r = js.render-tracked(Program(None(), List(stmts...)), o.pretty, o.sourcemap)
  let head = join(e.external-imports, "")
  Printed(text: head ++ r.text ++ "\n", base: len(head), marks: r.marks)
}

fn chunk-path-of(o: Options, c: chunks.Chunk, hash: Text, base: Text, static-roots: [Int]) -> Text {
  if c.root < 0 {
    return o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", "chunk", hash) ++ ".js"
  }
  let path = m.modules[c.root].path
  if c.root in static-roots { return entry-output(o, path, base) }
  o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", path-stem(path), hash) ++ ".js"
}

fn build-split(options: Options) -> Void {
  if len(options.outdir) == 0 { panic "code splitting needs --outdir" }
  if not options.format.export-names { panic "code splitting needs --format=esm" }
  let o = with-node-env(options)
  configure!(o, loading-of(o, o.outdir), linking-of(o, false, true, true), emitting-of(o, true))
  m.load-runtime(include-text("runtime.js"))
  m.load-trees(o.entries)
  if len(m.css-imports()) > 0 { panic "stylesheets with --splitting are not implemented yet" }
  an.link()
  with nm.finals = final-names(o) { named-split(o) }
}

# The rest of a split build, once every symbol has its name.
fn named-split(o: Options) -> Void {
  let roots = m.entries ++ an.dynamic-roots
  let all = chunks.chunks-of(roots)
  chunk-of-root = {c.root: c.id for c in all if c.root >= 0}
  e.chunk-paths = {}
  for root in roots { e.chunk-paths[root] = path-of-root(root) }
  let printed-chunks = [chunk-program(o, c, all) for c in all]
  let texts = [p.text for p in printed-chunks]
  let holes = [chunks.holes-in(t) for t in texts]
  let base = base-dir(o)
  let paths = [chunk-path-of(o, c, chunks.content-hash(c.id, texts, holes), base, m.entries) for c in all]
  for i in 0..len(texts) {
    let pr = printed-chunks[i]
    let done = chunks.filled(pr.text, pr.base, pr.marks, holes[i], paths[i], paths)
    let notes = legal.placed(o.legal-comments, legal-of-modules(some(all[i])), paths[i])
    let body = done.text ++ notes.tail
    if len(notes.file) > 0 { write-file(paths[i] ++ ".LEGAL.txt", notes.file) }
    let text = if o.sourcemap then body ++ "//# sourceMappingURL=" ++ path-base(paths[i]) ++ ".map\n" else body
    write-file(paths[i], text)
    if o.sourcemap { write-file(paths[i] ++ ".map", map.build-map(done.text, pr.base, done.marks, paths[i])) }
    print "{} bytes -> {}", len(text), paths[i]
  }
}
