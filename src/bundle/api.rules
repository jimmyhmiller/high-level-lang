# One build, from options to a file. The command line and `.bundler` specs are both just ways of
# filling in `Options`.
rules bundle.api over bundle.js
use bundle.js as js
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.mangle as mangle
use bundle.resolve as res
use bundle.fold as fold
use bundle.minify as minify
use bundle.final as final
use bundle.minhost as host
use bundle.sourcemap as map
use bundle.jsx as jsx
use bundle.chunks as chunks
use bundle.naming as nm
use bundle.lower as lower
use bundle.cssbundle as cssb
use bundle.legal as legal
use bundle.tsconfig as tsc
use bundle.ascii as ascii
use bundle.finish as fin

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# An output format: text around the program, and how the entry's exports get out. `exports` is a
# statement in which `%` stands for the entry's namespace object.
record Format {
  prefix: Text,
  suffix: Text,
  exports: Text,
  export-names: Bool,
  hoist-externals: Bool
}

fn iife-format() -> Format =
  Format(prefix: "(()=>{", suffix: "})();\n", exports: "", export-names: false, hoist-externals: false)
fn cjs-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "module.exports=%;", export-names: false, hoist-externals: false)
fn esm-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "", export-names: true, hoist-externals: true)

record DefineText { key: Text, value: Text }

# How a build divides its work: how many threads load files, and into how many parts, on how many
# threads, the program is optimised and printed. All ones is the serial build.
record Plan {
  name: Text,
  load-threads: Int,
  optimize-parts: Int,
  optimize-threads: Int,
  print-parts: Int,
  print-threads: Int,
  facts-threads: Int,
  emit-threads: Int
}

fn serial-plan() -> Plan =
  Plan(name: "serial", load-threads: 1, optimize-parts: 1, optimize-threads: 1, print-parts: 1, print-threads: 1, facts-threads: 1, emit-threads: 1)

record Options {
  entry: Text,
  entries: [Text],
  outfile: Text,
  outdir: Text,
  outbase: Text,
  splitting: Bool,
  entry-names: Text,
  chunk-names: Text,
  format: Format,
  global-name: Text,
  minify-identifiers: Bool,
  minify-syntax: Bool,
  pretty: Bool,
  timing: Bool,
  sourcemap: Bool,
  defines: [DefineText],
  main-fields: [Text],
  conditions: [Text],
  extensions: [Text],
  external: [Text],
  platform-node: Bool,
  aliases: [m.TextPair],
  loaders: [m.TextPair],
  banner: Text,
  footer: Text,
  tree-shaking: Bool,
  has-transform: Bool,
  has-optimize: Bool,
  charset-ascii: Bool,
  drop-console: Bool,
  drop-debugger: Bool,
  pure: [Text],
  packages-external: Bool,
  public-path: Text,
  tsconfig: Text,
  plan: Plan,
  legal-comments: Text,
  jsx: jsx.Options,
  target: Int,
  on-resolve: [Fn(Text,Text)->Text?],
  on-load: [Fn(Text)->Text?],
  transform: Fn(Node)->Node,
  optimize: Fn(Node)->Node
}

fn keep-as-is(n: Node) -> Node = n

# What `minify syntax` means unless a build says otherwise.
fn default-optimize(n: Node) -> Node = fin.finished(minify.run(n), false)

fn options-new(entry: Text, outfile: Text) -> Options =
  Options(entry: entry, entries: [entry], outfile: outfile, outdir: "", outbase: "", splitting: false,
          entry-names: "[dir]/[name]", chunk-names: "[name]-[hash]",
          format: iife-format(), global-name: "",
          minify-identifiers: false, minify-syntax: false, pretty: false, timing: false, sourcemap: false,
          defines: [], main-fields: ["module", "main"], conditions: ["import", "browser"],
          extensions: [".tsx", ".ts", ".jsx", ".js", ".css", ".mjs", ".cjs", ".json"], external: [], platform-node: false,
          aliases: [], loaders: [], banner: "", footer: "", tree-shaking: true, has-transform: false, has-optimize: false, charset-ascii: true, drop-console: false, drop-debugger: false, pure: [],
          packages-external: false, public-path: "", tsconfig: "", plan: serial-plan(), legal-comments: "eof", jsx: jsx.options-new(), target: lower.no-lowering,
          on-resolve: [], on-load: [],
          transform: keep-as-is, optimize: default-optimize)

# Node's module system: builtins stay external, and packages resolve for node.
fn on-node(o: Options) -> Options = o with { platform-node: true, main-fields: ["main", "module"], conditions: ["node", "require"] }

fn with-define(o: Options, key: Text, value: Text) -> Options = o with { defines: o.defines ++ [DefineText(key: key, value: value)] }

fn with-alias(o: Options, from: Text, to: Text) -> Options = o with { aliases: o.aliases ++ [m.TextPair(key: from, value: to)] }

# The loaders a file can be given: what `modules.rules` knows how to load.
const loader-kinds: [Text] = ["js", "jsx", "ts", "tsx", "css", "json", "text", "base64", "dataurl", "file", "empty"]

fn with-loader(o: Options, extension: Text, kind: Text) -> Options =
  o with { loaders: o.loaders ++ [m.TextPair(key: extension, value: kind)],
           extensions: o.extensions ++ [extension for x in [extension] if not (x in o.extensions)] }

# JSX as the build says it is written out, which a tsconfig.json then does not override.
fn with-jsx(o: Options, j: jsx.Options) -> Options = o with { jsx: j with { explicit: true } }

fn with-jsx-factory(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { factory: name })
fn with-jsx-fragment(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { fragment: name })
fn with-jsx-import-source(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { import-source: name })
fn with-jsx-dev(o: Options) -> Options = with-jsx(o, o.jsx with { dev: true })

# How JSX is written out, by the name a command line or a spec uses for it.
fn with-jsx-runtime(o: Options, name: Text) -> Options =
  with-jsx(o, o.jsx with { runtime: jsx-runtime(name) ?? panic "--jsx is transform, automatic or preserve, not {}", name })

fn jsx-runtime(name: Text) -> jsx.Runtime? = match name {
  "transform" => some(jsx.Classic)
  "automatic" => some(jsx.Automatic)
  "preserve" => some(jsx.Preserve)
  _ => none
}

# `esnext`, or a year: `es2017`. Esbuild's browser names are not implemented.
fn with-target(o: Options, name: Text) -> Options =
  o with { target: target-year(name) ?? panic "--target={} is not implemented: use esnext, es6 or a year such as es2017", name }

fn target-year(name: Text) -> Int? = match name {
  "esnext" => some(lower.no-lowering)
  "es6" => some(2015)
  "es" ++ year if len(year) == 4 and all c in code-points-of(year): c >= '0' and c <= '9' => some(parse-int(year))
  _ => none
}

# Every name a generated variable must stay clear of.
fn names-in-use() -> [Text] =
  nm.finals ++ [f for mo in m.modules for f in mo.free] ++ nm.keywords

fn for-target(o: Options, p: Node) -> Node = match o.charset-ascii {
  true => in-parts(o, lowered, fin.ascii-only)
  false => lowered
} where dropped = match o.drop-console or o.drop-debugger {
          true => without-dropped(o, p)
          false => p
        },
        lowered = match o.target {
          t if t >= lower.no-lowering => dropped
          t => lower.run(dropped, t, names-in-use(), o.minify-identifiers)
        }

# `f` on each part of the program at once.
fn in-parts(o: Options, p: Node, f: Fn(Node)->Node) -> Node = match o.plan.optimize-parts {
  n if n <= 1 => f(p)
  n => in-pieces(p, n, o.plan.optimize-threads, f, false)
}

# `--drop:console` and `--drop:debugger`. Names are final here, and every free name was kept free, so
# `console` can only be the global one.
fn without-dropped(o: Options, n: Node) -> Node = match n {
  Debugger() if o.drop-debugger => Empty() with { lo: n.lo, hi: n.hi }
  Debugger() => n
  CallExpr(Member(Ident("console"), _), _) | OptCall(Member(Ident("console"), _), _) if o.drop-console => exp`void 0`
  ExprStmt(CallExpr(Member(Ident("console"), _), _)) | ExprStmt(OptCall(Member(Ident("console"), _), _)) if o.drop-console =>
    Empty() with { lo: n.lo, hi: n.hi }
  _ => drop-kids(o, n)
}

fn drop-kids(o: Options, n: Node) -> Node = match n.kids {
  [] => n
  kids => n with { kids: [without-dropped(o, k) for k in kids] }
}

fn clear-words() -> [Text] = []

# ---------------------------------------------------------------- the build

# A define's value is a JavaScript expression in text: `false`, `"production"`, `1`.
fn define-value(text: Text) -> Node = js.parse(text ++ ";", "<define>").body.kids[0].expr

fn program-plus(p: Node, s: Node) -> Node = p with { body: List(p.body.kids ++ [s]...) }

# An entry that is itself wrapped only runs if something calls it. A format that exports the entry
# calls CommonJS for the value it exports.
fn run-entry(p: Node, f: Format) -> Node = match m.modules[m.entry] {
  m.Module(kind: m.Cjs, ...) if f.exports != "" => p
  m.Module(kind: m.Cjs, ...) as mo => program-plus(p, stmt`$call_me();`) where call-me = e.final-of(an.require-sym(mo))
  mo if an.wrapped?(mo) => program-plus(p, stmt`$call_me();`) where call-me = e.final-of(an.init-sym(mo))
  _ => p
}

# The entry as a format exports it: an ES module's namespace made CommonJS, or what running a
# CommonJS module gives, as esbuild has it.
fn entry-value() -> Node = match m.modules[m.entry] {
  m.Module(kind: m.Cjs, ...) as mo => exp`$call_me()` where call-me = e.final-of(an.require-sym(mo))
  mo => exp`$to_cjs($ns)` where to-cjs = e.helper-name("__toCommonJS"), ns = e.final-of(an.ns-sym(mo))
}

# `export { a, b as c };` for the entry's names, and `var` statements for those a local name can't
# hold, which come first.
fn esm-exports() -> [Node] = exports-of-root(m.entry)

fn exports-of-root(root: Int) -> [Node] = match m.db.dynamic(root) {
  true => panic "{}: `export *` from a CommonJS or external module in the entry point of ES module output is not implemented yet", m.modules[root].path
  false => [h for x in found for h in x.hoisted] ++ [ExportNamed(List([x.spec for x in found]...)) for f in [found] if len(f) > 0]
    where found = [exported(name-of(m.names, n), s) for n in [n for m.db.resolved(root, ?n, _) distinct n]
                   if let some(s) = e.resolved-export(root, n)]
}

# An export of the entry: its specifier, after a variable holding it when what it reads is no name.
record Exported { hoisted: [Node], spec: Node }

fn exported(name: Text, s: Int) -> Exported = match e.symbol-read(s) {
  Ident(local) => Exported(hoisted: [], spec: ExportAs(PropName(local), PropName(name)))
  read => Exported(hoisted: [stmt`var $hoisted = $read;`], spec: ExportAs(PropName(hoisted), PropName(name)))
    where hoisted = "export_" ++ name
}

# The output text: `prefix`, the printed program, `suffix`. `base` is where the program starts, for
# source map positions.
record Printed { text: Text, base: Int, marks: [Mark] }

fn printed(o: Options, p: Node, prefix: Text, suffix: Text) -> Printed =
  Printed(text: prefix ++ r.text ++ suffix, base: len(prefix), marks: r.marks) where r = rendered-in-parts(o, p)

# ---------------------------------------------------------------- work in parts

# A program's statements in `n` runs of about the same length, each a program of its own.
# Whether no rule joins this statement to the one after it: the optimiser merges a statement into
# its neighbour only when it is an expression, a `var`, `let` or `const`, or an `if`.
fn closed?(s: Node) -> Bool = match s {
  FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) | ClassDecl(...) => true
  _ => false
}

# How much work a statement is, near enough: its length in the source, or one when it was made.
fn weight(s: Node) -> Int = max(1, s.hi - s.lo)

# The same for a node the build made around source, such as CommonJS's wrapper: its children's.
fn mass(n: Node) -> Int = match n.hi - n.lo {
  size if size > 0 => size
  _ => sum k in n.kids: mass(k)
}

# Statements cut into about `n` runs of about equal weight, each cut just after a declaration, so
# the runs optimise as the whole list would. Fewer when there are not such places enough.
fn runs-of(stmts: [Node], n: Int) -> [[Node]] = match stmts {
  _ if n <= 1 or len(stmts) <= 1 => [stmts]
  _ => [stmts[ends[i]..ends[i + 1]] for i in 0..len(cuts)]
    where before = [0] ++ (scan w = 0 for s in stmts: w + weight(s)),
          total = last(before),
          # Each cut is the first after the last at which its share of the weight is reached, after
          # a statement that closes.
          cuts = fold cs = [0] for i in 1..n:
            cs ++ [j for j in first k in last(cs) + 1..len(stmts) if before[k] >= total * i / n and closed?(stmts[k - 1]): k],
          ends = cuts ++ [len(stmts)]
}

# A program cut into runs of its statements, each a program of its own.
fn parts-of(p: Node, n: Int) -> [Node] = match runs-of(p.body.kids, n) {
  [_] => [p]
  runs => [program-of(match i { 0 => p.hashbang  _ => None() }, runs[i]) for i in 0..len(runs)]
}

fn program-of(hashbang: Node, stmts: [Node]) -> Node = Program(hashbang, List(stmts...))

fn joined(p: Node, parts: [Node]) -> Node = p with { body: List([s for part in parts for s in part.body.kids]...) }

# ---------------------------------------------------------------- bodies in parts

# A CommonJS module is one statement, its wrapper, and so is a library inside one function: the
# work is in a single function body. Such a body is taken out of its statement, which keeps a hole,
# and cut into runs as a program is; the runs fill the hole again once they are done.
record Hole { at: Int, stmts: [Node] }
record Hollowed { shell: Node, holes: [Hole], total: Int }
record Taken { node: Node, stmts: [Node] }

# A hole's mark: an identifier no source can spell, which every pass leaves be and prints as it is.
fn hole-name(at: Int) -> Text = byte-text(1) ++ "hole" ++ int-text(at) ++ byte-text(1)

fn hole-mark(at: Int) -> Node = ExprStmt(Ident(hole-name(at)) with { lo: -1, hi: -1 }) with { lo: -1, hi: -1 }

# Each statement heavier than a part's share gives up the body most of it is in, when that body
# can be cut.
fn hollowed(p: Node, n: Int) -> Hollowed =
  Hollowed(shell: p with { body: List([taken-or(takes[i], stmts[i]) for i in 0..len(stmts)]...) },
           holes: [Hole(at: i, stmts: t.stmts) for i in 0..len(stmts) if let some(t) = takes[i]],
           total: total)
  where stmts = p.body.kids,
        weights = [max(1, mass(s)) for s in stmts],
        total = sum w in weights: w,
        takes = [heavy-taken(stmts[i], i, weights[i] * n > total, total, n) for i in 0..len(stmts)]

fn heavy-taken(s: Node, i: Int, heavy: Bool, total: Int, n: Int) -> Taken? = match heavy {
  true => cut-body(taken(s, hole-mark(i)), total, n)
  false => none
}

fn cut-body(t: Taken?, total: Int, n: Int) -> Taken? = match t {
  some(x) if len(runs-of(x.stmts, share(x.stmts, total, n))) > 1 => t
  _ => none
}

# How many parts a run of statements gets of `n` for all `total`.
fn share(stmts: [Node], total: Int, n: Int) -> Int = max(1, n * (sum s in stmts: max(1, mass(s))) / total)

fn taken-or(t: Taken?, s: Node) -> Node = match t {
  some(x) => x.node
  none => s
}

# The deepest function body holding nearly all of a node's work, swapped for `mark`.
fn taken(n: Node, mark: Node) -> Taken? = match n {
  FuncBody(List(ss...)) => match taken-below(n, mark), ss {
    some(t), _ => some(t)
    none, [_, _, ...] => some(Taken(node: n with { stmts: n.stmts with { kids: [mark] } }, stmts: ss))
    none, _ => none
  }
  _ => taken-below(n, mark)
}

# Through the child that holds nearly all of a node's work, if one does.
fn taken-below(n: Node, mark: Node) -> Taken? =
  first i in 0..len(n.kids) if mass(n.kids[i]) * 10 >= mass(n) * 9 for t in taken(n.kids[i], mark):
    Taken(node: n with { kids: [n.kids[0..i]..., t.node, n.kids[i + 1..len(n.kids)]...] }, stmts: t.stmts)

# A hole filled with its body's statements.
everywhere fn filled(n: Node, bodies: {Text:[Node]}) -> Node = match n {
  FuncBody(List(ExprStmt(Ident(x)))) if x in bodies => n with { stmts: n.stmts with { kids: bodies[x] ?? panic "lost a body" } }
}

# A body's runs, as many as its share of the work.
fn body-parts(hole: Hole, total: Int, n: Int) -> [Node] =
  [program-of(None(), r) for r in runs-of(hole.stmts, share(hole.stmts, total, n))]

# Where each body's parts start among all the parts, the shell's first; and where the last ends.
fn body-starts(shell-parts: Int, bodies: [[Node]]) -> [Int] = [shell-parts] ++ (scan at = shell-parts for b in bodies: at + len(b))

# Whether a rule for a function body's end would have changed the body these statements end: a
# `return;` last, or an `if (c) return;` with anything after it. Then the body is done whole.
record Ends { bare: Bool, early: Bool, early-last: Bool }

fn ends-of(ss: [Node]) -> Ends =
  Ends(bare: len(ss) > 0 and last(ss) is Return(None()),
       early: any s in ss[0..max(0, len(ss) - 1)]: early-return?(s),
       early-last: len(ss) > 0 and early-return?(last(ss)))

fn early-return?(s: Node) -> Bool = s is If(_, Return(None()), None())

fn end-changed?(es: [Ends]) -> Bool =
  len(es) > 0 and ((any e in es: e.early) or (any k in 0..len(es) - 1: es[k].early-last) or last(es).bare)

# `f` of each part at once, the program's runs and its bodies' runs, put back together. When `f`
# minifies and a body's end would have changed, all of it is done in top-level parts instead.
fn in-pieces(p: Node, n: Int, threads: Int, f: Fn(Node)->Node, minifying: Bool) -> Node = match hollowed(p, n) {
  h if len(h.holes) == 0 => joined(p, heaviest-first(parts-of(p, n), f, threads))
  h => match minifying and (any b in made: end-changed?([ends-of(b)])) {
    true => joined(p, heaviest-first(parts-of(p, n), f, threads))
    false => filled(joined(h.shell, done[0..len(shell-parts)]), {hole-name(h.holes[k].at): made[k] for k in 0..len(made)})
  }
    where shell-parts = parts-of(h.shell, n),
          bodies = [body-parts(hole, h.total, n) for hole in h.holes],
          done = heaviest-first(shell-parts ++ [x for b in bodies for x in b], f, threads),
          starts = body-starts(len(shell-parts), bodies),
          made = [[s for d in done[starts[k]..starts[k + 1]] for s in d.body.kids] for k in 0..len(bodies)]
}

# The optimiser on each part at once. Parts end after declarations, which nothing merges with
# what follows, so this is the program the optimiser would make of the whole. A spec's own
# optimiser is given top-level parts only: what it does to a body with a hole is its own.
fn optimized(o: Options, p: Node) -> Node = match o.plan.optimize-parts {
  n if n <= 1 => o.optimize(p)
  n if o.has-optimize => joined(p, heaviest-first(parts-of(p, n), o.optimize, o.plan.optimize-threads))
  n => in-pieces(p, n, o.plan.optimize-threads, o.optimize, true)
}

# ---------------------------------------------------------------- the back half at once

# When nothing between minifying and printing needs the whole program, each part is minified,
# made ASCII and printed in one go: no barrier between them, and no program put back together
# only to be cut again. The parts print as the whole would, since printing cuts anywhere.
fn fusable?(o: Options) -> Bool =
  o.minify-syntax and not o.has-optimize and o.plan.optimize-parts > 1 and o.plan.print-parts > 1
  and o.target >= lower.no-lowering and not o.drop-console and not o.drop-debugger


# A part minified, made ASCII and printed, and how its statements end.
record Piece { rendered: Rendered, ends: Ends }

fn finished-piece(p: Node) -> Piece = Piece(rendered: render-part(t), ends: ends-of(t.body.kids))
  where t = fin.finished(minify.run(p), printing.ascii)

fn printed-piece(p: Node) -> Piece = Piece(rendered: render-part(p), ends: ends-of([]))

fn finished-output(o: Options, f: Format, p: Node) -> Printed =
  Printed(text: f.prefix ++ all.text ++ f.suffix, base: len(f.prefix), marks: all.marks)
  where r = rendered-pieces(o, p, o.plan.optimize-parts, o.plan.optimize-threads, finished-piece, true),
        # What the format adds goes after, as it is: it was never minified.
        exports = export-statements(f),
        all = pieces-joined(o, [r] ++ [render-part(Program(None(), List(exports...))) for x in [exports] if len(x) > 0])

# `f` of each part at once, the heaviest started first, so the last to finish is a light one; the
# results in the parts' order.
fn heaviest-first(parts: [Node], f: Fn(Node)->Node, threads: Int) -> [Node] =
  [done[place[i] ?? panic "a part that was not done"] for i in 0..len(parts)]
  where order = heaviest-order(parts),
        done = parallel-map([parts[i] for i in order], f, threads),
        place = {order[k]: k for k in 0..len(order)}

fn heaviest-pieces(parts: [Node], f: Fn(Node)->Piece, threads: Int) -> [Piece] =
  [done[place[i] ?? panic "a part that was not done"] for i in 0..len(parts)]
  where order = heaviest-order(parts),
        done = parallel-map([parts[i] for i in order], f, threads),
        place = {order[k]: k for k in 0..len(order)}

fn heaviest-order(parts: [Node]) -> [Int] = sort i in [i for i in 0..len(parts)] by part-weight(parts[i]) desc

fn part-weight(p: Node) -> Int = sum s in p.body.kids: weight(s)

fn folded(o: Options, p: Node) -> Node = match o.plan.optimize-parts {
  n if n <= 1 => fold.run(p)
  n => in-pieces(p, n, o.plan.optimize-threads, fold.run, false)
}

# How parts are printed, which the threads that print them read: set with the build's other settings.
record Printing { pretty: Bool, maps: Bool, ascii: Bool }
setting printing: Printing

fn render-part(p: Node) -> Rendered = js.render-tracked(p, printing.pretty, printing.maps)

# Each part printed at once, the texts joined end to end, and every source map mark moved to
# where its part landed. A part that ends where the printer dropped a `;` gets it back, as the
# printer would have written it had the next part followed.
fn rendered-in-parts(o: Options, p: Node) -> Rendered = match o.plan.print-parts {
  n if n <= 1 => js.render-tracked(p, o.pretty, o.sourcemap)
  n => rendered-pieces(o, p, n, o.plan.print-threads, printed-piece, false)
}

# `f` of each part at once, printing it, and the texts put together: each body's parts joined, and
# spliced into the shell's text where its hole printed, the marks after it moved along. When `f`
# minifies and a body's end would have changed, all of it is done in top-level parts instead.
fn rendered-pieces(o: Options, p: Node, n: Int, threads: Int, f: Fn(Node)->Piece, minifying: Bool) -> Rendered = match hollowed(p, n) {
  h if len(h.holes) == 0 => whole-pieces(o, p, n, threads, f)
  h => match changed {
    true => none
    false => spliced(shell, [hole-name(hole.at) for hole in h.holes], texts)
  } ?? whole-pieces(o, p, n, threads, f)
    where shell-parts = parts-of(h.shell, n),
          bodies = [body-parts(hole, h.total, n) for hole in h.holes],
          done = heaviest-pieces(shell-parts ++ [x for b in bodies for x in b], f, threads),
          starts = body-starts(len(shell-parts), bodies),
          changed = minifying and (any k in 0..len(bodies): end-changed?([d.ends for d in done[starts[k]..starts[k + 1]]])),
          shell = pieces-joined(o, [d.rendered for d in done[0..len(shell-parts)]]),
          texts = [pieces-joined(o, [d.rendered for d in done[starts[k]..starts[k + 1]]]) for k in 0..len(bodies)]
}

# Only top-level parts, each printed, joined.
fn whole-pieces(o: Options, p: Node, n: Int, threads: Int, f: Fn(Node)->Piece) -> Rendered =
  pieces-joined(o, [d.rendered for d in heaviest-pieces(parts-of(p, n), f, threads)])

# Each body where its hole printed, in one pass: the shell's text between holes and the bodies'
# texts written out in turn, and each mark moved by what the holes before it grew by. Nothing when
# the holes did not print once each, in order.
fn spliced(shell: Rendered, names: [Text], bodies: [Rendered]) -> Rendered? = match at {
  _ if len(at) != len(names) or not (all k in 0..len(at): at?(shell.text, at[k], names[k])) => none
  _ => some(Rendered(text: join([shell.text[from[k]..upto[k]] ++ body-text(bodies, k) for k in 0..len(at) + 1], ""),
                     marks: marks, open: shell.open))
    where # `grown[k]`: how much longer the text is before hole k than the shell's; `from[k]`: where
          # the shell's text after hole k - 1 starts.
          grown = [0] ++ (scan d = 0 for k in 0..len(at): d + len(bodies[k].text) - len(names[k])),
          from = [0] ++ [at[k] + len(names[k]) for k in 0..len(at)],
          upto = at ++ [len(shell.text)],
          # The shell's marks after hole k - 1 up to hole k, a mark on the hole itself being the first
          # of the body's tokens, then body k's.
          outs = [mk.out for mk in shell.marks],
          cut = [0] ++ [bisect(outs, a) for a in at] ++ [len(outs)],
          marks = [mk for k in 0..len(at) + 1
                      for mk in [Mark(out: m.out + grown[k], src: m.src) for m in shell.marks[cut[k]..cut[k + 1]]]
                                ++ [Mark(out: m.out + at[k] + grown[k], src: m.src) for b in bodies[k..min(k + 1, len(bodies))] for m in b.marks]]
} where at = occurrences(shell.text, [byte-text(1) ++ "hole"])

# Body k's text, after the shell's text before hole k; nothing after the last.
fn body-text(bodies: [Rendered], k: Int) -> Text = match k {
  _ if k < len(bodies) => bodies[k].text
  _ => ""
}

# Rendered pieces one after another, a `;` between two where the first left a statement open, and
# each piece's marks moved by where it starts.
fn pieces-joined(o: Options, pieces: [Rendered]) -> Rendered =
  Rendered(text: join([gaps[i] ++ pieces[i].text for i in 0..len(pieces)], ""),
           marks: [Mark(out: mk.out + ends[i] - len(pieces[i].text), src: mk.src) for i in 0..len(pieces) for mk in pieces[i].marks],
           open: len(pieces) > 0 and last(pieces).open)
  where gaps = [gap-before(o, pieces, i) for i in 0..len(pieces)],
        ends = scan at = 0 for i in 0..len(pieces): at + len(gaps[i]) + len(pieces[i].text)

# A `;` before a piece when the one before left a statement open.
fn gap-before(o: Options, pieces: [Rendered], i: Int) -> Text = match i {
  _ if i > 0 and pieces[i - 1].open and len(pieces[i].text) > 0 => match o.pretty {
    true => ";\n"
    false => ";"
  }
  _ => ""
}

# Every `%` in a format's statement, as this text.
fn fill-in(template: Text, value: Text) -> Text = replace-all(template, "%", value)

# A format's statements, once the names they refer to are final.
fn export-statements(f: Format) -> [Node] = match f {
  Format(export-names: true, ...) => esm-exports()
  Format(exports: "", ...) => []
  _ => [js.parse(fill-in(f.exports, js.render(entry-value(), false)), "<format>").body.kids[0]]
}

fn wrap-format(o: Options, f: Format, p: Node) -> Printed =
  printed(o, fold whole = p for x in export-statements(f): program-plus(whole, x), f.prefix, f.suffix)

# `--global-name`: an IIFE whose value is the entry's namespace.
fn named(f: Format, global-name: Text) -> Format = match global-name {
  "" => f
  _ => f with { prefix: "var " ++ global-name ++ "=" ++ f.prefix, exports: "return %;" }
}

fn has-define?(o: Options, key: Text) -> Bool = any d in o.defines: d.key == key

# A browser has no `process`, so the build decides. Node's programs decide when they run.
fn with-node-env(o: Options) -> Options = match o {
  _ if has-define?(o, "process.env.NODE_ENV") or o.platform-node => o
  _ => o with { defines: o.defines ++ [DefineText(key: "process.env.NODE_ENV",
                                                  value: match o.minify-syntax {
                                                    true => "\"production\""
                                                    false => "\"development\""
                                                  })] }
}

# How the build loads, links and emits, as the modules that do it are told.
fn loading-of(o: Options, out-dir: Text) -> m.Loading =
  m.Loading(defines: [m.Define(key: d.key, value: define-value(d.value)) for d in o.defines], transform: o.transform,
            has-transform: o.has-transform, aliases: o.aliases, loaders: o.loaders, on-resolve: o.on-resolve,
            on-load: o.on-load, jsx-options: o.jsx, out-dir: out-dir, load-threads: o.plan.load-threads,
            packages-external: o.packages-external, public-path: o.public-path)

fn linking-of(o: Options, entry-namespace: Bool, keep-entry-exports: Bool, splitting: Bool, esm-output: Bool) -> an.Linking =
  an.Linking(entry-namespace: entry-namespace, keep-entry-exports: keep-entry-exports, tree-shaking: o.tree-shaking,
             splitting: splitting, esm-output: esm-output, pure-names: o.pure, facts-threads: o.plan.facts-threads)

fn emitting-of(o: Options, esm-output: Bool) -> e.Emitting =
  e.Emitting(void-undefined: o.minify-syntax, esm-output: esm-output, drop-unused-imports: o.minify-syntax, sourcemap: o.sourcemap,
             emit-threads: o.plan.emit-threads)

# The names esbuild gives output files: the entry's path below the entries' common directory.
fn common-dir(paths: [Text]) -> Text = fold dir = dir-of(paths[0]) for p in paths: enclosing(dir, p)

fn enclosing(dir: Text, path: Text) -> Text = match dir {
  "." | "/" => dir
  _ if starts-with(path, dir ++ "/") => dir
  _ => enclosing(dir-of(dir), path)
}

fn below(dir: Text, path: Text) -> Text = match dir {
  "." => path
  "/" => path[1..len(path)]
  _ => path[len(dir) + 1..len(path)]
}

fn entry-output(o: Options, entry: Text, base: Text) -> Text =
  o.outdir ++ "/" ++ chunks.pattern-path(o.entry-names, match dir-of(rel) { "." => ""  d => d }, path-stem(rel), "") ++ ".js"
  where rel = below(base, entry)

fn base-dir(o: Options) -> Text = match o.outbase {
  "" => common-dir(o.entries)
  base => base
}

# A file a build writes, and what to say once it is written, if anything.
record Written { path: Text, text: Text, said: Text }

# One bundle, or one per entry, or one split into chunks, each name looked up as the options say:
# the files they make, written; or, with nowhere to write it, the one bundle printed.
fn build(options: Options) -> Void = timed(options.timing, "write", match printing?(options) {
  true => to-standard-output(files(options))
  false => written(files(options))
})

# The files a build makes, not yet written.
fn files(options: Options) -> [Written] =
  with res.options = resolve-options(options), tsc.forced = options.tsconfig, ascii.braces = options.target >= 2015,
       cssb.loaders = loader-map(options) {
    built(printable(options))
  }

fn written(ws: [Written]) -> Void = write-files!([w.path for w in ws], [w.text for w in ws], [w.said for w in ws])

# With no output file or directory, one entry's bundle goes to standard output, as esbuild's does:
# its source map inline, and nothing that needs a file of its own.
fn printing?(o: Options) -> Bool = not o.splitting and o.outdir == "" and o.outfile == "" and len(o.entries) == 1

fn printable(o: Options) -> Options = match printing?(o), o.legal-comments {
  true, "linked" | "external" => panic "linked or external legal comments need an output path: give --outfile or --outdir"
  true, _ if "file" in [l.value for l in o.loaders] => panic "the file loader needs an output path: give --outfile or --outdir"
  _, _ => o
}

fn to-standard-output(ws: [Written]) -> Void = match ws {
  [w] => write-standard-output!(w.text)
  _ => panic "this build makes {} files, and standard output takes one: give --outfile or --outdir", len(ws)
}

fn built(options: Options) -> [Written] = match options.splitting, options.outdir, len(options.entries) {
  true, _, _ => split-built(options)
  false, "", n if n > 1 => panic "several entry points need --outdir"
  false, "", _ => one-built(options)
  false, _, _ => [one-built(options with { entry: entry, entries: [entry], outfile: entry-output(options, entry, base) })...
                  for entry in options.entries]
    where base = base-dir(options)
}

fn loader-map(o: Options) -> {Text:Text} = {l.key: l.value for l in o.loaders}

fn resolve-options(o: Options) -> res.Options =
  res.Options(main-fields: o.main-fields, conditions: o.conditions, extensions: o.extensions,
              external: o.external, node-builtins: o.platform-node)

fn with-extension(path: Text, ext: Text) -> Text = match dir-of(path) {
  "." if not starts-with(path, "./") => path-stem(path) ++ ext
  dir => dir ++ "/" ++ path-stem(path) ++ ext
}

# What a file says once written: how big it is, and where.
fn said-of(text: Text, path: Text) -> Text = int-text(len(text)) ++ " bytes -> " ++ path

# A file beside another, such as its legal comments', when it has anything in it.
fn beside(path: Text, text: Text) -> [Written] = [Written(path: path, text: t, said: "") for t in [text] if len(t) > 0]

# Output, and when there is a source map, the line that points to it and the map, of `source`, the
# part of the text the marks describe, which starts at `base`.
fn with-map(o: Options, path: Text, text: Text, source: Text, base: Int, marks: [Mark]) -> [Written] = match o.sourcemap, printing?(o) {
  true, false => [Written(path: path, text: mapped, said: said-of(mapped, path)),
                  Written(path: path ++ ".map", text: map.build-map(source, base, marks, path), said: "")]
    where mapped = text ++ "//# sourceMappingURL=" ++ path-base(path) ++ ".map\n"
  true, true => [Written(path: path, text: inline, said: "")]
    where inline = text ++ "//# sourceMappingURL=data:application/json;base64,"
                   ++ host.base64(map.build-map(source, base, marks, path)) ++ "\n"
  false, _ => [Written(path: path, text: text, said: said-of(text, path))]
}

# A stylesheet entry: its imports and the files it names, and nothing for JavaScript to do.
fn css-built(o: Options) -> [Written] = sheet-written(o.outfile, b) ++ assets-written(b.assets)
  where b = cssb.bundle([o.entry], o.outfile, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)

# A bundled stylesheet, and its legal comments' file when it has one.
fn sheet-written(path: Text, b: cssb.Bundled) -> [Written] =
  beside(path ++ ".LEGAL.txt", b.legal) ++ [Written(path: path, text: b.text, said: said-of(b.text, path))]

# Each copied file, once.
fn assets-written(assets: [cssb.Asset]) -> [Written] = [Written(path: a.to, text: read-file(a.from), said: "") for a in assets distinct a.to]

# The files the program's modules stand for, copied beside it: what the file loader gives.
fn module-assets(out-dir: Text) -> [cssb.Asset] =
  [cssb.asset-of(mo.path, out-dir) for mo in m.modules if mo.kind != m.External and m.loader-of(mo.path) == "file"]

# One bundle, as the build's settings say how to load, link, emit and print it.
fn one-built(options: Options) -> [Written] = match options.entry {
  _ ++ ".css" => css-built(options)
  _ if options.pretty and options.jsx.runtime == jsx.Preserve =>
    panic "pretty output would change the text of JSX that is kept: --jsx=preserve with --pretty is not implemented"
  _ => with m.loading = loading-of(o, dir-of(o.outfile)), an.linking = linking-of(o, len(f.exports) > 0, f.export-names, false, f.hoist-externals),
            e.emitting = emitting-of(o, f.hoist-externals), e.chunk-parts = none, printing = printing-of(o), m.names = names-new() {
         loaded-built(timed(o.timing, "startup", o), f)
       }
    where o = with-node-env(options),
          f = match o.format.export-names or len(o.format.exports) > 0 {
            true => o.format
            false => named(o.format, o.global-name)
          }
}

fn printing-of(o: Options) -> Printing = Printing(pretty: o.pretty, maps: o.sourcemap, ascii: o.charset-ascii)

# A build once it is set up: load, link, name, and the rest.
fn loaded-built(o: Options, f: Format) -> [Written] =
  with m.ahead = timed(o.timing, "load: parse files ahead", m.parsed-ahead([o.entry])) {
    graph-built(o, f, timed(o.timing, "load: resolve, scopes, the graph", m.graph(include-text("runtime.js"), [o.entry])))
  }

# A build once its modules are known.
fn graph-built(o: Options, f: Format, g: m.Graph) -> [Written] =
  with m.modules = g.modules, m.by-path = g.by-path, m.order = g.order, m.entries = g.entries, m.entry = g.entries[0] {
    linked-built(o, f, g)
  }

fn linked-built(o: Options, f: Format, g: m.Graph) -> [Written] =
  with an.linked = an.link(g.symbols), m.table = an.linked-table(g.parts),
       m.db = timed(o.timing, "link: facts and Datalog", an.solved-facts()) {
    with nm.finals = timed(o.timing, "naming", final-names(o)) { named-built(o, f) }
  }

# Each symbol's name: minified, or as esbuild's number renamer gives them.
fn final-names(o: Options) -> [Text] = match o.minify-identifiers {
  true => mangle.minified-names(o.plan.emit-threads)
  false => nm.esbuild-names()
}

# The rest of a build, once every symbol has its name: the program, its legal comments and its map;
# the stylesheets it imports, beside it under its name; and the files those and its modules name.
fn named-built(o: Options, f: Format) -> [Written] =
  beside(o.outfile ++ ".LEGAL.txt", notes.file) ++ with-map(o, o.outfile, full, full, len(head) + out0.base, out0.marks)
  ++ [sheet-written(css-out, b)... for b in css]
  ++ assets-written([a for b in css for a in b.assets] ++ module-assets(dir-of(o.outfile)))
  where emission = e.program(),
        emitted = timed(o.timing, "emit: rewrite identifiers", run-entry(emission.tree, f)),
        fused = fusable?(o),
        p = timed(o.timing, "minify rules", match fused, o.minify-syntax {
          true, _ => emitted
          false, true => for-target(o, optimized(o, emitted))
          false, false => for-target(o, folded(o, emitted))
        }),
        out0 = match fused {
          true => finished-output(o, f, p)
          false => wrap-format(o, f, p)
        },
        # The banner and hoisted external imports come first, ahead of everything the map describes.
        head = (match o.banner { "" => ""  b => b ++ "\n" }) ++ join(emission.externals, ""),
        footer = match o.footer { "" => ""  t => t ++ "\n" },
        notes = legal.placed(o.legal-comments, legal-of-modules(none), o.outfile),
        full = timed(o.timing, "print", head ++ out0.text ++ footer ++ notes.tail),
        sheets = m.css-imports(),
        css-out = with-extension(o.outfile, ".css"),
        css = [cssb.bundle(sheets, css-out, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)
               for s in [sheets] if len(s) > 0]

# ---------------------------------------------------------------- code splitting

# The legal comments of the modules in the output, or in one chunk of it, in module order.
fn legal-of-modules(chunk: chunks.Chunk?) -> [legal.Note] =
  [legal.Note(path: m.modules[id].path, text: t) for id in m.order if in-output?(chunk, id) for t in m.modules[id].legal]

fn in-output?(chunk: chunks.Chunk?, id: Int) -> Bool = match chunk {
  some(c) => any p in e.parts-of(id): p in c.parts
  none => e.included?(id)
}

# What running this chunk's entry looks like at its end.
fn root-statements(root: Int) -> [Node] = match m.modules[root] {
  m.Module(kind: m.Cjs, ...) as mo => [stmt`export default $call_me();`] where call-me = e.final-of(an.require-sym(mo))
  mo if an.wrapped?(mo) => [stmt`$call_me();`] ++ exports-of-root(root) where call-me = e.final-of(an.init-sym(mo))
  _ => exports-of-root(root)
}

fn chunk-root-statements(c: chunks.Chunk) -> [Node] = match c.root {
  r if r < 0 => []
  r => root-statements(r)
}

# The body of one chunk, as text with placeholders in it.
fn chunk-program(o: Options, c: chunks.Chunk, all: [chunks.Chunk]) -> Printed =
  Printed(text: head ++ r.text ++ "\n", base: len(head), marks: r.marks)
  where emission = with e.chunk-parts = some(c.parts) { e.program() },
        p = for-target(o, match o.minify-syntax {
          true => o.optimize(emission.tree)
          false => fold.run(emission.tree)
        }),
        stmts = chunks.imports-of(c, all) ++ p.body.kids ++ chunk-root-statements(c) ++ chunks.exports-of(c, all),
        r = js.render-tracked(Program(None(), List(stmts...)), o.pretty, o.sourcemap),
        head = join(emission.externals, "")

fn chunk-path-of(o: Options, c: chunks.Chunk, hash: Text, base: Text, static-roots: [Int]) -> Text = match c.root {
  r if r < 0 => o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", "chunk", hash) ++ ".js"
  r if r in static-roots => entry-output(o, m.modules[r].path, base)
  r => o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", path-stem(m.modules[r].path), hash) ++ ".js"
}

fn split-built(options: Options) -> [Written] = match options.outdir, options.format.export-names {
  "", _ => panic "code splitting needs --outdir"
  _, false => panic "code splitting needs --format=esm"
  _, true => with m.loading = loading-of(o, o.outdir), an.linking = linking-of(o, false, true, true, true), e.emitting = emitting-of(o, true),
                  printing = printing-of(o), m.names = names-new() {
      with m.ahead = m.parsed-ahead(o.entries) { split-graph(o, m.graph(include-text("runtime.js"), o.entries)) }
    } where o = with-node-env(options)
}

# A split build once its modules are known.
fn split-graph(o: Options, g: m.Graph) -> [Written] =
  with m.modules = g.modules, m.by-path = g.by-path, m.order = g.order, m.entries = g.entries, m.entry = g.entries[0] {
    linked-split(o, g)
  }

fn linked-split(o: Options, g: m.Graph) -> [Written] = match m.css-imports() {
  [] => with an.linked = an.link(g.symbols), m.table = an.linked-table(g.parts), m.db = an.solved-facts() {
          with nm.finals = final-names(o) { named-split(o) }
        }
  _ => panic "stylesheets with --splitting are not implemented yet"
}

# The rest of a split build, once every symbol has its name: a chunk for each root, which an import
# of it names by a placeholder until every chunk's name is known.
fn named-split(o: Options) -> [Written] =
  with e.chunk-paths = {root: chunks.placeholder(ids[root] ?? (panic "{} has no chunk", m.modules[root].path)) for root in roots} {
    chunks-written(o, all)
  } where roots = m.entries ++ an.linked.dynamic-roots,
          all = chunks.chunks-of(roots),
          ids = {c.root: c.id for c in all if c.root >= 0}

# Each chunk printed, its placeholders filled once every chunk's name is known.
fn chunks-written(o: Options, all: [chunks.Chunk]) -> [Written] =
  [chunk-written(o, all[i], printed[i], holes[i], paths[i], paths)... for i in 0..len(all)]
  where printed = [chunk-program(o, c, all) for c in all],
        texts = [p.text for p in printed],
        holes = [chunks.holes-in(t) for t in texts],
        base = base-dir(o),
        paths = [chunk-path-of(o, c, chunks.content-hash(c.id, texts, holes), base, m.entries) for c in all]

fn chunk-written(o: Options, c: chunks.Chunk, pr: Printed, holes: [chunks.Hole], path: Text, paths: [Text]) -> [Written] =
  beside(path ++ ".LEGAL.txt", notes.file) ++ with-map(o, path, done.text ++ notes.tail, done.text, pr.base, done.marks)
  where done = chunks.filled(pr.text, pr.base, pr.marks, holes, path, paths),
        notes = legal.placed(o.legal-comments, legal-of-modules(some(c)), path)
