# One build, from options to a file. The command line and `.bundler` specs are both just ways of
# filling in `Options`.
rules bundle.api over bundle.js
use bundle.js as js
use bundle.modules as m
use bundle.analysis as an
use bundle.emit as e
use bundle.mangle as mangle
use bundle.resolve as res
use bundle.fold as fold
use bundle.minify as minify
use bundle.final as final
use bundle.minhost as host
use bundle.sourcemap as map
use bundle.jsx as jsx
use bundle.fragments as fragments
use bundle.chunks as chunks
use bundle.naming as nm
use bundle.lower as lower
use bundle.cssbundle as cssb
use bundle.legal as legal
use bundle.tsconfig as tsc
use bundle.ascii as ascii
use bundle.finish as fin
use bundle.hmr as hmr
use bundle.chunking as packing
use bundle.analyze as analyze
use bundle.ledger as led
use bundle.lint as lint
use bundle.shipped as shipped
use bundle.rewrites as rw
use bundle.inline as inline
use bundle.pages as pages

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# An output format: text around the program, and how the entry's exports get out. `exports` is a
# statement in which `%` stands for the entry's namespace object.
record Format {
  prefix: Text,
  suffix: Text,
  exports: Text,
  export-names: Bool,
  # ES module output: an import of an outside module stays an import statement.
  es-module: Bool,
  # Whatever runs the output has `require`, as CommonJS does: an outside module is loaded with it
  # directly, and otherwise through esbuild's `__require`, which says what is missing.
  native-require: Bool
}

fn iife-format() -> Format =
  Format(prefix: "(()=>{", suffix: "})();\n", exports: "", export-names: false, es-module: false, native-require: false)
fn cjs-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "module.exports=%;", export-names: false, es-module: false, native-require: true)
fn esm-format() -> Format =
  Format(prefix: "", suffix: "\n", exports: "", export-names: true, es-module: true, native-require: false)

record DefineText { key: Text, value: Text }

boxed record Options {
  entry: Text,
  entries: [Text],
  # An HTML page the build is of (`esb index.html`): its module scripts are the entries, and it is
  # written again, loading what they became (bundle.pages).
  page: Text,
  # A development build (`--hmr`).
  dev: Bool,
  # `--manifest`: what each entry and `import()` became, as Vite's `.vite/manifest.json` says it.
  manifest: Bool,
  # Vite's import queries, `?url` and `?raw` (see `Loading.url-queries`); and whether the files
  # `?url` names are written (not by a build whose assets another build writes).
  url-queries: Bool,
  url-assets: Bool,
  # Where the files modules and stylesheets name are written, when not the output directory.
  asset-dir: Text,
  outfile: Text,
  outdir: Text,
  outbase: Text,
  splitting: Bool,
  entry-names: Text,
  chunk-names: Text,
  chunking: packing.Options,
  format: Format,
  global-name: Text,
  minify-identifiers: Bool,
  minify-syntax: Bool,
  pretty: Bool,
  timing: Bool,
  sourcemap: Bool,
  defines: [DefineText],
  main-fields: [Text],
  # Conditions the build names besides the platform's (`--conditions`); none if it names none.
  conditions: [Text]?,
  extensions: [Text],
  external: [Text],
  platform-node: Bool,
  aliases: [m.TextPair],
  loaders: [m.TextPair],
  banner: Text,
  footer: Text,
  tree-shaking: Bool,
  # With code splitting, modules evaluate in the order native ES modules would, each that may be
  # observed given an initializer its importers call (`--strict-execution-order`). Off by default,
  # as esbuild, Bun, Rollup and Rolldown leave it: a module shared between chunks runs as its chunk
  # loads.
  strict-execution-order: Bool,
  has-transform: Bool,
  has-optimize: Bool,
  charset-ascii: Bool,
  drop-console: Bool,
  drop-debugger: Bool,
  pure: [Text],
  packages-external: Bool,
  public-path: Text,
  tsconfig: Text,
  legal-comments: Text,
  # `--analyze=DIR`: what the build made, and why, as JSON (see bundle.analyze).
  analyze: Text,
  # `--ledger`: with the analysis, the build's ledger, which blame compares (see bundle.ledger).
  ledger: Bool,
  # `--lint=FILE`: rules over what the build ships (see bundle.lint); an error found fails the build.
  lints: [Text],
  # `--fix`: the fixes of what the lints found made to the source files, and nothing else written.
  fix: Bool,
  # `--rewrite=FILE`: rewrites of each module's code as it loads (see bundle.rewrites).
  rewrites: [Text],
  # `--property-shaking=false`: every object read whole when read (see `an.Linking`).
  property-shaking: Bool,
  # `--hmr-patch=false`: a hot update runs each changed module again, never patching it in place
  # (see `hmr.patching`).
  hmr-patch: Bool,
  jsx: jsx.Options,
  target: Int,
  on-resolve: [Fn(Text,Text)->Text?],
  on-load: [Fn(Text)->Text?],
  # A framework's transforms of each module's tree as it loads (see `Loading.transforms`).
  transforms: [Fn(Node,Text,Text)->Node],
  transform: Fn(Node)->Node,
  optimize: Fn(Node)->Node
}

fn keep-as-is(n: Node) -> Node = n

# What `minify syntax` means unless a build says otherwise.
fn default-optimize(n: Node) -> Node = fin.finished(minify.run(n), false)

# A build of an HTML page (bundle.pages): its module scripts and stylesheets are the entries, split
# into ES module chunks named, as Vite names them, under `assets/`.
fn paged(o: Options) -> Options = match o.entry {
  page ++ ".html" => match pages.entries(pages.page-of(o.entry)) {
    [] => fail-build(o.entry ++ ": the page loads no module script or stylesheet of the project's to build")
    entries => o with { page: o.entry, entry: entries[0], entries: entries, splitting: true, format: esm-format(),
                        entry-names: "assets/[name]-[hash]", chunk-names: "assets/[name]-[hash]",
                        outdir: match o.outdir { "" => fail-build("a page is built to a directory: give --outdir")  d => d } }
  }
  _ => o
}

fn options-new(entry: Text, outfile: Text) -> Options =
  Options(entry: entry, entries: [entry], page: "", dev: false, manifest: false, url-queries: false, url-assets: true, asset-dir: "", outfile: outfile, outdir: "", outbase: "", splitting: false,
          entry-names: "[dir]/[name]", chunk-names: "[name]-[hash]", chunking: packing.options(),
          format: iife-format(), global-name: "",
          minify-identifiers: false, minify-syntax: false, pretty: false, timing: false, sourcemap: false,
          defines: [], main-fields: ["browser", "module", "main"], conditions: none,
          extensions: [".tsx", ".ts", ".jsx", ".js", ".css", ".mjs", ".cjs", ".json"], external: [], platform-node: false,
          aliases: [], loaders: [], banner: "", footer: "", tree-shaking: true, strict-execution-order: false, has-transform: false, has-optimize: false, charset-ascii: true, drop-console: false, drop-debugger: false, pure: [],
          packages-external: false, public-path: "", tsconfig: "", legal-comments: "eof", analyze: "", ledger: false, lints: [], fix: false, rewrites: [], property-shaking: true, hmr-patch: true, jsx: jsx.options-new(), target: lower.no-lowering,
          on-resolve: [], on-load: [], transforms: [],
          transform: keep-as-is, optimize: default-optimize)

# Node's module system: builtins stay external, and packages resolve for node.
fn on-node(o: Options) -> Options = o with { platform-node: true, main-fields: ["main", "module"] }

fn with-define(o: Options, key: Text, value: Text) -> Options = o with { defines: o.defines ++ [DefineText(key: key, value: value)] }

fn with-alias(o: Options, from: Text, to: Text) -> Options = o with { aliases: o.aliases ++ [m.TextPair(key: from, value: to)] }

# The loaders a file can be given: what `modules.rules` knows how to load.
const loader-kinds: [Text] = ["js", "jsx", "ts", "tsx", "css", "json", "text", "base64", "dataurl", "file", "empty"]

fn with-loader(o: Options, extension: Text, kind: Text) -> Options =
  o with { loaders: o.loaders ++ [m.TextPair(key: extension, value: kind)],
           extensions: o.extensions ++ [extension for x in [extension] if not (x in o.extensions)] }

# JSX as the build says it is written out, which a tsconfig.json then does not override.
fn with-jsx(o: Options, j: jsx.Options) -> Options = o with { jsx: j with { explicit: true } }

fn with-jsx-factory(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { factory: name })
fn with-jsx-fragment(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { fragment: name })
fn with-jsx-import-source(o: Options, name: Text) -> Options = with-jsx(o, o.jsx with { import-source: name })
fn with-jsx-dev(o: Options) -> Options = with-jsx(o, o.jsx with { dev: true })

# How JSX is written out, by the name a command line or a spec uses for it.
fn with-jsx-runtime(o: Options, name: Text) -> Options =
  with-jsx(o, o.jsx with { runtime: jsx-runtime(name) ?? panic "--jsx is transform, automatic or preserve, not {}", name })

fn jsx-runtime(name: Text) -> jsx.Runtime? = match name {
  "transform" => some(jsx.Classic)
  "automatic" => some(jsx.Automatic)
  "preserve" => some(jsx.Preserve)
  _ => none
}

# `esnext`, or a year: `es2017`. Esbuild's browser names are not implemented.
fn with-target(o: Options, name: Text) -> Options =
  o with { target: target-year(name) ?? panic "--target={} is not implemented: use esnext, es6 or a year such as es2017", name }

fn target-year(name: Text) -> Int? = match name {
  "esnext" => some(lower.no-lowering)
  "es6" => some(2015)
  "es" ++ year if len(year) == 4 and all c in code-points-of(year): c >= '0' and c <= '9' => some(parse-int(year))
  _ => none
}

# Every name a generated variable must stay clear of.
fn names-in-use() -> [Text] =
  sym.final-names(nm.finals) ++ [f for mo in m.modules for f in mo.free] ++ nm.keywords

# What is dropped dropped, lowered for the target, and made ASCII: what code splitting does to each
# chunk's program, whole.
fn for-target(o: Options, p: Node) -> Node = ascii-of(o, lowered-of(o, dropped-of(o, p)))

fn dropped-of(o: Options, p: Node) -> Node = match o.drop-console or o.drop-debugger {
  true => without-dropped(o, p)
  false => p
}

fn lowered-of(o: Options, p: Node) -> Node = match o.target {
  t if t >= lower.no-lowering => p
  t => lower.run(p, t, names-in-use(), o.minify-identifiers)
}

fn ascii-of(o: Options, p: Node) -> Node = match o.charset-ascii {
  true => fin.ascii-only(p)
  false => p
}

# `--drop:console` and `--drop:debugger`. Names are final here, and every free name was kept free, so
# `console` can only be the global one.
fn without-dropped(o: Options, n: Node) -> Node = match n {
  Debugger() if o.drop-debugger => Empty() with { lo: n.lo, hi: n.hi }
  Debugger() => n
  CallExpr(Member(Ident("console"), _), _) | OptCall(Member(Ident("console"), _), _) if o.drop-console => exp`void 0`
  ExprStmt(CallExpr(Member(Ident("console"), _), _)) | ExprStmt(OptCall(Member(Ident("console"), _), _)) if o.drop-console =>
    Empty() with { lo: n.lo, hi: n.hi }
  _ => drop-kids(o, n)
}

fn drop-kids(o: Options, n: Node) -> Node = match n.kids {
  [] => n
  kids => n with { kids: [without-dropped(o, k) for k in kids] }
}

fn clear-words() -> [Text] = []

# ---------------------------------------------------------------- the build

# A define's value is a JavaScript expression in text: `false`, `"production"`, `1`.
fn define-value(text: Text) -> Node = js.parse(text ++ ";", "<define>").body.kids[0].expr

# The call that runs the entry, when it must be called: its own group, after the modules'.
fn entry-calls(f: Format) -> [Node] = match m.modules[m.entry] {
  m.Module(kind: m.Cjs, ...) if f.exports != "" => []
  m.Module(kind: m.Cjs, ...) as mo => [stmt`$call_me();`] where call-me = e.final-of(an.require-sym(mo))
  mo if an.wrapped?(mo) => [stmt`$call_me();`] where call-me = e.final-of(an.init-sym(mo))
  _ => []
}

# The entry as a format exports it: an ES module's namespace made CommonJS, or what running a
# CommonJS module gives, as esbuild has it.
fn entry-value() -> Node = match m.modules[m.entry] {
  m.Module(kind: m.Cjs, ...) as mo => exp`$call_me()` where call-me = e.final-of(an.require-sym(mo))
  mo => exp`$to_cjs($ns)` where to-cjs = e.helper-name("__toCommonJS"), ns = e.final-of(an.ns-sym(mo))
}

# `export { a, b as c };` for the entry's names, and `var` statements for those a local name can't
# hold, which come first.
fn esm-exports() -> [Node] = exports-of-root(m.entry)

# The entry's names, as ES module exports, sorted by name as esbuild sorts them. Those `export *`
# from CommonJS adds are only known at run time, so only the namespace object has them, as esbuild
# has it.
fn exports-of-root(root: Int) -> [Node] =
  [h for x in found for h in x.hoisted] ++ [ExportNamed(List([x.spec for x in found]...)) for f in [found] if len(f) > 0]
  where found = [exported(name-of(m.names, n), s, prefix)
                 for n in sort n in [n for m.db.resolved(root, ?n, _) distinct n] by name-of(m.names, n)
                 if let some(s) = e.resolved-export(root, n)],
        prefix = export-prefix()

# What a variable made to hold an export starts with: clear of every name in use, so the same for
# every root.
fn export-prefix() -> Text = first i in 0.. for p in ["__entry_export_" ++ int-text(i) ++ "_"]
                 if all name in names-in-use(): not starts-with(name, p): p

# An export of the entry: its specifier, after a variable holding it when what it reads is no name.
record Exported { hoisted: [Node], spec: Node }

fn exported(name: Text, s: Int, prefix: Text) -> Exported = match e.symbol-read(s) {
  Ident(local) => Exported(hoisted: [], spec: ExportAs(PropName(local), PropName(name)))
  read => Exported(hoisted: [stmt`var $hoisted = $read;`], spec: ExportAs(PropName(hoisted), PropName(name)))
    where hoisted = prefix ++ int-text(m.name-id(name))
}

# The output text: `prefix`, the printed program, `suffix`. `base` is where the program starts, for
# source map positions.
record Printed { text: Text, base: Int, marks: [Mark] }


# ---------------------------------------------------------------- work in runs

# Whether no rule joins this statement to the one after it: the optimiser merges a statement into
# its neighbour only when it is an expression, a `var`, `let` or `const`, or an `if`.
fn closed?(s: Node) -> Bool = match s {
  FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) | ClassDecl(...) => true
  # Where one group of the output ends: nothing joins across it (see `e.groups`).
  Flag() => true
  _ => false
}

# A program's statements in runs, each ending after a statement that closes (see `closed?`): what
# is done to a run is what would be done to it in the whole, and the runs are done at once.
fn stable-runs(stmts: [Node]) -> [[Node]] = [stmts[ends[i]..ends[i + 1]] for i in 0..len(ends) - 1]
  where ends = [0] ++ [k + 1 for k in 0..len(stmts) if closed?(stmts[k]) and k + 1 < len(stmts)] ++ [len(stmts)]

fn program-of(hashbang: Node, stmts: [Node]) -> Node = Program(hashbang, List(stmts...))

# How parts are printed, which the threads that print them read: set with the build's other settings.
record Printing { pretty: Bool, maps: Bool, ascii: Bool, files: Bool }
setting printing: Printing

fn render-part(p: Node) -> Rendered = printed(p, printing.pretty, printing.maps, printing.files)

# Printed, with where each leaf landed for a source map; or, for an analysis, only where the text
# passes from one module's code to another's.
fn printed(p: Node, pretty: Bool, maps: Bool, files: Bool) -> Rendered = match maps, files {
  true, _ => js.render-tracked(p, pretty, true)
  false, true => js.render-files(p, pretty)
  false, false => js.render-tracked(p, pretty, false)
}

# Texts printed apart, joined end to end, and every source map mark moved to where its text landed.
# A text that ends where the printer dropped a `;` gets it back, as the printer would have written it
# had the next text followed.
fn pieces-joined(o: Options, all: [Rendered]) -> Rendered = some-pieces-joined(o, [p for p in all if len(p.text) > 0])

fn some-pieces-joined(o: Options, pieces: [Rendered]) -> Rendered =
  Rendered(text: join([gaps[i] ++ pieces[i].text for i in 0..len(pieces)], ""),
           marks: [Mark(out: mk.out + ends[i] - len(pieces[i].text), src: mk.src) for i in 0..len(pieces) for mk in pieces[i].marks],
           open: len(pieces) > 0 and last(pieces).open)
  where gaps = [gap-before(o, pieces, i) for i in 0..len(pieces)],
        ends = scan at = 0 for i in 0..len(pieces): at + len(gaps[i]) + len(pieces[i].text)

# A `;` before a piece when the one before left a statement open.
fn gap-before(o: Options, pieces: [Rendered], i: Int) -> Text = match i {
  _ if i > 0 and pieces[i - 1].open and len(pieces[i].text) > 0 => match o.pretty {
    true => ";\n"
    false => ";"
  }
  _ => ""
}

# Every `%` in a format's statement, as this text.
fn fill-in(template: Text, value: Text) -> Text = replace-all(template, "%", value)

# A format's statements, once the names they refer to are final.
fn export-statements(f: Format) -> [Node] = match f {
  Format(export-names: true, ...) => esm-exports()
  Format(exports: "", ...) => []
  _ => [js.parse(fill-in(f.exports, js.render(entry-value(), false)), "<format>").body.kids[0]]
}


# `--global-name`: an IIFE whose value is the entry's namespace.
fn named(f: Format, global-name: Text) -> Format = match global-name {
  "" => f
  _ => f with { prefix: "var " ++ global-name ++ "=" ++ f.prefix, exports: "return %;" }
}

fn has-define?(o: Options, key: Text) -> Bool = any d in o.defines: d.key == key

# A browser has no `process`, so the build decides. Node's programs decide when they run.
fn with-node-env(o: Options) -> Options = match o {
  _ if has-define?(o, "process.env.NODE_ENV") or o.platform-node => o
  _ => o with { defines: o.defines ++ [DefineText(key: "process.env.NODE_ENV",
                                                  value: match o.minify-syntax {
                                                    true => "\"production\""
                                                    false => "\"development\""
                                                  })] }
}

# How the build loads, links and emits, as the modules that do it are told.
fn loading-of(o: Options, out-dir: Text) -> m.Loading =
  m.Loading(defines: [m.Define(key: d.key, value: define-value(d.value)) for d in o.defines], transform: o.transform,
            has-transform: o.has-transform or len(o.rewrites) > 0 or len(o.transforms) > 0, rewrites: o.rewrites, rewrite: rw.rewritten,
            transforms: o.transforms, aliases: o.aliases, loaders: o.loaders, on-resolve: o.on-resolve,
            on-load: o.on-load, jsx-options: o.jsx, out-dir: out-dir,
            packages-external: o.packages-external, public-path: o.public-path, inline-constants: o.minify-syntax,
            dev-styles: o.dev, url-queries: o.url-queries)

fn linking-of(o: Options, entry-namespace: Bool, splitting: Bool, f: Format) -> an.Linking =
  an.Linking(entry-namespace: entry-namespace, tree-shaking: o.tree-shaking,
             splitting: splitting, strict-order: splitting and o.strict-execution-order, esm-output: f.es-module, native-require: f.native-require, compact: o.minify-identifiers,
             pure-names: o.pure, shake-properties: o.property-shaking)

fn emitting-of(o: Options, f: Format) -> e.Emitting =
  e.Emitting(void-undefined: o.minify-syntax, native-require: f.native-require,
             drop-unused-imports: o.minify-syntax, sourcemap: o.sourcemap, files: analyzed?(o),
             # Lowered, a private name is a variable lowering names.
             private-names: o.minify-identifiers and o.target >= 2022,
             drop-unused-names: o.minify-identifiers)

# The names esbuild gives output files: the entry's path below the entries' common directory.
fn common-dir(paths: [Text]) -> Text = fold dir = dir-of(paths[0]) for p in paths: enclosing(dir, p)

fn enclosing(dir: Text, path: Text) -> Text = match dir {
  "." | "/" => dir
  _ if starts-with(path, dir ++ "/") => dir
  _ => enclosing(dir-of(dir), path)
}

fn below(dir: Text, path: Text) -> Text = match dir {
  "." => path
  "/" => path[1..len(path)]
  _ => path[len(dir) + 1..len(path)]
}

fn entry-output(o: Options, entry: Text, base: Text) -> Text = entry-output-hashed(o, entry, base, "")

fn entry-output-hashed(o: Options, entry: Text, base: Text, hash: Text) -> Text =
  o.outdir ++ "/" ++ chunks.pattern-path(o.entry-names, match dir-of(rel) { "." => ""  d => d }, path-stem(rel), hash) ++ ".js"
  where rel = below(base, entry)

fn base-dir(o: Options) -> Text = match o.outbase {
  "" => common-dir(o.entries)
  base => base
}

# A file a build writes, and what to say once it is written, if anything.
record Written { path: Text, text: Text, said: Text }

# One bundle, or one per entry, or one split into chunks, each name looked up as the options say:
# the files they make, written; or, with nowhere to write it, the one bundle printed.
fn delivered(o: Options, ws: [Written]) -> Void = match printing?(o) {
  true => to-standard-output(ws)
  false => written(ws)
}

# The files a build makes, not yet written, given what every build of these options reads: each
# build gives its own, and what reads a part of one is made again only when that part is something
# else (a `with` compares what it gives with what the last gave).
fn files(options: Options) -> [Written] =
  with res.options = resolve-options(options), tsc.forced = options.tsconfig, ascii.braces = options.target >= 2015,
       cssb.loaders = loader-map(options), cssb.public-path = options.public-path,
       cssb.asset-directory = (if options.asset-dir != "" then options.asset-dir else if options.outdir != "" then options.outdir else dir-of(options.outfile)) {
    checked-files(built(printable(options with { chunking: packing.checked(options.chunking) })))
  }

# All artifacts are validated together before the first write. Equal shared assets are emitted
# once; two different contents may never silently occupy the same normalized output path.
fn checked-files(files: [Written]) -> [Written] = match first w in files
  if (contents[m.from-root(w.path)] ?? "") != w.text: w.path {
  some(path) => panic "different outputs collide at {}; use distinct entry and chunk names", path
  none => [w for w in files distinct m.from-root(w.path)]
} where contents = {m.from-root(w.path): w.text for w in files}

fn written(ws: [Written]) -> Void = write-files!([if message?(w) then "" else w.path for w in ws], [w.text for w in ws], [w.said for w in ws])

# What lints found is said where files are, and written nowhere: its path is none a file has.
const message-path: Text = "<lint>"
fn message?(w: Written) -> Bool = w.path == message-path

# With no output file or directory, one entry's bundle goes to standard output, as esbuild's does:
# its source map inline, and nothing that needs a file of its own.
fn printing?(o: Options) -> Bool = not o.splitting and o.outdir == "" and o.outfile == "" and len(o.entries) == 1

fn printable(o: Options) -> Options = match printing?(o), o.legal-comments {
  true, _ if len(o.lints) > 0 => panic "what lints find is said beside the files a build writes: give --outfile or --outdir"
  true, "linked" | "external" => panic "linked or external legal comments need an output path: give --outfile or --outdir"
  true, _ if "file" in [l.value for l in o.loaders] => panic "the file loader needs an output path: give --outfile or --outdir"
  _, _ => o
}

fn to-standard-output(ws: [Written]) -> Void = match ws {
  [w] => write-standard-output!(w.text)
  _ => panic "this build makes {} files, and standard output takes one: give --outfile or --outdir", len(ws)
}

fn built(options: Options) -> [Written] = match options.splitting, options.outdir, len(options.entries) {
  true, _, _ => split-built(options)
  false, "", n if n > 1 => panic "several entry points need --outdir"
  false, "", _ => one-built(options)
  false, _, _ => [one-built(options with { entry: entry, entries: [entry], outfile: entry-output(options, entry, base) })...
                  for entry in options.entries]
    where base = base-dir(options)
}

fn loader-map(o: Options) -> {Text:Text} = {l.key: l.value for l in o.loaders}

fn resolve-options(o: Options) -> res.Options =
  res.Options(main-fields: o.main-fields, conditions: resolution-conditions(o), extensions: o.extensions,
              external: o.external, node-builtins: o.platform-node)

# The conditions a package's `exports` and `imports` are read with, as esbuild has them: the
# platform's, and the build's own, or `module` (the ES module a CommonJS package offers to bundlers)
# when it names none. `default` always holds, and `import` or `require` as the request is.
fn resolution-conditions(o: Options) -> [Text] =
  [if o.platform-node then "node" else "browser"] ++ (o.conditions ?? ["module"])

fn with-extension(path: Text, ext: Text) -> Text = match dir-of(path) {
  "." if not starts-with(path, "./") => path-stem(path) ++ ext
  dir => dir ++ "/" ++ path-stem(path) ++ ext
}

# What a file says once written: how big it is, and where.
fn said-of(text: Text, path: Text) -> Text = int-text(len(text)) ++ " bytes -> " ++ path

# A file beside another, such as its legal comments', when it has anything in it.
fn beside(path: Text, text: Text) -> [Written] = [Written(path: path, text: t, said: "") for t in [text] if len(t) > 0]

# Output, and when there is a source map, the line that points to it and the map, of `source`, the
# part of the text the marks describe, which starts at `base`.
fn with-map(o: Options, path: Text, text: Text, source: Text, base: Int, marks: [Mark]) -> [Written] = match o.sourcemap, printing?(o) {
  true, false => [Written(path: path, text: mapped, said: said-of(mapped, path)),
                  Written(path: path ++ ".map", text: map.build-map(source, base, marks, path), said: "")]
    where mapped = text ++ "//# sourceMappingURL=" ++ path-base(path) ++ ".map\n"
  true, true => [Written(path: path, text: inline, said: "")]
    where inline = text ++ "//# sourceMappingURL=data:application/json;base64,"
                   ++ host.base64(map.build-map(source, base, marks, path)) ++ "\n"
  false, _ => [Written(path: path, text: text, said: said-of(text, path))]
}

# A stylesheet entry: its imports and the files it names, and nothing for JavaScript to do.
fn css-built(o: Options) -> [Written] = sheet-written(o.outfile, b) ++ assets-written(b.assets)
  where b = cssb.bundle([o.entry], o.outfile, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)

# A bundled stylesheet, and its legal comments' file when it has one.
fn sheet-written(path: Text, b: cssb.Bundled) -> [Written] =
  beside(path ++ ".LEGAL.txt", b.legal) ++ [Written(path: path, text: b.text, said: said-of(b.text, path))]

# Each copied file, once.
fn assets-written(assets: [cssb.Asset]) -> [Written] = [Written(path: a.to, text: read-file(a.from), said: "") for a in assets distinct a.to]

# The files the program's modules stand for, copied beside it: what the file loader gives.
fn module-assets(out-dir: Text) -> [cssb.Asset] =
  [cssb.asset-of(mo.path, out-dir) for mo in m.modules if mo.kind != m.External and m.loader-of(mo.path) == "file"]

fn url-assets-of(o: Options, out-dir: Text) -> [Written] = match o.url-assets {
  true => url-assets(out-dir)
  false => []
}

# The files `?url` imports name, written as assets: a stylesheet bundled, with the files it names,
# any other file as it is.
fn url-assets(out-dir: Text) -> [Written] =
  [w for mo in m.modules if mo.kind != m.External and m.loader-of(mo.path) == "url" for w in url-asset(m.queried-file(mo.path), out-dir) distinct w.path]

fn url-asset(file: Text, out-dir: Text) -> [Written] = match path-ext(file) {
  ".css" => [Written(path: dir-of(cssb.asset-of(file, out-dir).to) ++ "/" ++ m.css-asset-name(file), text: sheet.text, said: "")]
            ++ assets-written(sheet.assets)
    where sheet = m.url-sheet(file)
  _ => assets-written([cssb.asset-of(file, out-dir)])
}

# One bundle, as the build's settings say how to load, link, emit and print it.
fn one-built(options: Options) -> [Written] = match options.entry {
  _ ++ ".css" => css-built(options)
  _ if options.pretty and options.jsx.runtime == jsx.Preserve =>
    panic "pretty output would change the text of JSX that is kept: --jsx=preserve with --pretty is not implemented"
  _ => bundled(with-node-env(options))
}

# One bundle's build, given what it reads.
fn bundled(o: Options) -> [Written] =
  with m.loading = loading-of(o, dir-of(o.outfile)), an.linking = linking-of(o, len(f.exports) > 0, false, f),
       e.emitting = emitting-of(o, f), e.chunk-parts = none, printing = printing-of(o), building = Building(options: o, format: f) {
    match timed(o.timing, "settings", 0) { _ => bundle() }
  } where f = format-of(o)

# The format a build's output takes, with its global name.
fn format-of(o: Options) -> Format = match o.format.export-names or len(o.format.exports) > 0 {
  true => o.format
  false => named(o.format, o.global-name)
}

# The options hot module replacement's builds are made with.
fn dev-options(options: Options) -> Options = with-node-env(dev-paged(options)) with { dev: true }

# A page in development: its one module script is built, as one development bundle in the output
# directory, which the page served loads (`dev-page`).
fn dev-paged(o: Options) -> Options = match o.page {
  "" => o
  page => match [l for l in pages.page-of(page).loads if l.script] {
    [l] => o with { entry: l.source, entries: [l.source], splitting: false, outfile: o.outdir ++ "/" ++ path-stem(l.source) ++ ".js" }
    [] => fail-build(page ++ ": the page loads no module script of the project's to build")
    _ => fail-build(page ++ ": a page with more than one module script is built for development one script at a time; give the scripts one entry")
  }
}

# The page a development server serves for `o` (`dev-options`), or none when the build is not of one.
fn dev-page(o: Options) -> Text? = match o.page {
  "" => none
  page => some(pages.dev-written(pages.page-of(page), path-base(o.outfile)))
}

# How one build is made: its options, and the format its output takes.
boxed record Building { options: Options, format: Format }

setting building: Building

# Everything one build writes.
fn bundle() -> [Written] = loaded-built(building.options, building.format)

# One development build, as hot module replacement makes them, given what it reads (as `files` and
# `bundled` give it), with the session's persistent name interner.
fn dev-step-of(o: Options, before: hmr.Dev, events: Text) -> DevStep =
  with res.options = resolve-options(o), tsc.forced = o.tsconfig, ascii.braces = o.target >= 2015, cssb.loaders = loader-map(o),
       m.loading = loading-of(o, dir-of(o.outfile)), an.linking = linking-of(o, len(f.exports) > 0, false, f),
       e.emitting = emitting-of(o, f), e.chunk-parts = none, printing = printing-of(o), building = Building(options: o, format: f),
       hmr.patching = o.hmr-patch {
    dev-built(o, before, events)
  } where f = format-of(o)

# One development build, and what to send for it after `before`.
record DevStep { dev: hmr.Dev, sent: hmr.Sent? }

fn dev-built(o: Options, before: hmr.Dev, events: Text) -> DevStep =
  match m.parsed-ahead([o.entry]) { _ => dev-graph-built(before, events, m.graph(include-text("runtime.js"), [o.entry])) }

fn dev-graph-built(before: hmr.Dev, events: Text, g: m.Graph) -> DevStep =
  with m.modules = g.modules, m.by-path = g.by-path, m.order = g.order, m.ranks = g.ranks, m.blocks = g.module-blocks, m.entries = g.entries, m.entry = g.entries[0] {
    dev-step(before, hmr.dev-build(g.entries[0], events), g.entries)
  }

fn dev-step(before: hmr.Dev, now: hmr.Dev, entries: [Int]) -> DevStep = DevStep(dev: now, sent: hmr.update(before, now, entries))

fn printing-of(o: Options) -> Printing = Printing(pretty: o.pretty, maps: tracked?(o), ascii: o.charset-ascii, files: analyzed?(o))

# Whether the printer marks where each leaf landed: for a source map, and for a ledger, which says
# what of each statement each output holds (see bundle.ledger).
fn tracked?(o: Options) -> Bool = o.sourcemap or o.ledger or len(o.lints) > 0

# Whether what is emitted says which module each statement is of: for an analysis, and for lints,
# which read what of each statement each route loads.
fn analyzed?(o: Options) -> Bool = len(o.analyze) > 0 or len(o.lints) > 0

# A build once it is set up: load, link, name, and the rest.
fn loaded-built(o: Options, f: Format) -> [Written] =
  match timed(o.timing, "load: parse files ahead", m.parsed-ahead([o.entry])) { _ =>
    graph-built(o, f, timed(o.timing, "load: resolve, scopes, the graph", m.graph(include-text("runtime.js"), [o.entry])))
  }

# A build once its modules are known. Each stage's result is given to what follows as a setting's
# value, which the next build's compares with part by part, so what reads a part that stayed the
# same stays as it was.
fn graph-built(o: Options, f: Format, g: m.Graph) -> [Written] =
  with m.modules = g.modules, m.by-path = g.by-path, m.order = g.order, m.ranks = g.ranks, m.blocks = g.module-blocks, m.entries = g.entries, m.entry = g.entries[0] {
    linked-built(o, f, g)
  }

fn linked-built(o: Options, f: Format, g: m.Graph) -> [Written] =
  with an.linked = timed(o.timing, "link: modules", an.link(0)), m.table = timed(o.timing, "link: table", an.linked-table(g)),
       m.db = timed(o.timing, "link: facts and Datalog", an.solved-facts()),
       e.units = e.units-of-order(), nm.finals = timed(o.timing, "naming", final-names(o)) {
    with e.singles = singles-of(o) { named-built(o, f) }
  }

# The functions a minified build writes in where they are read once (see `e.singles`); none else.
fn singles-of(o: Options) -> {Text:e.Single} = match o.minify-syntax and o.minify-identifiers {
  true => e.single-use-functions()
  false => {}
}

# Each symbol's name: minified, or as esbuild's number renamer gives them.
fn final-names(o: Options) -> sym.Table = match o.minify-identifiers {
  true => sym.renamed-all(m.table, mangle.minified-names())
  false => nm.esbuild-names(o.target < lower.no-lowering)
}

# The rest of a build, once every symbol has its name: the program, its legal comments and its map;
# the stylesheets it imports, beside it under its name; and the files those and its modules name.
fn named-built(o: Options, f: Format) -> [Written] =
  beside(o.outfile ++ ".LEGAL.txt", notes.file) ++ js
  ++ [sheet-written(css-out, b)... for b in css]
  ++ assets-written([a for b in css for a in b.assets] ++ module-assets(dir-of(o.outfile))) ++ url-assets-of(o, dir-of(o.outfile))
  ++ analysis-written(o, [analyze.Output(path: o.outfile, kind: "js", text: text-written(js, o.outfile), base: len(head) + out0.base, marks: out0.marks, root: m.entry,
                                         imports: [], dynamic: [])]
                         ++ [analyze.Output(path: css-out, kind: "css", text: b.text, base: 0, marks: [], root: -1, imports: [], dynamic: []) for b in css],
                      [m.entry])
  where out0 = match grouped?(o) {
          true => grouped-output(o, f)
          false => flat-output(o, f)
        },
        # The banner comes first, ahead of everything the map describes.
        head = match o.banner { "" => ""  b => b ++ "\n" },
        footer = match o.footer { "" => ""  t => t ++ "\n" },
        notes = legal.placed(o.legal-comments, legal-of-modules(none, {}), o.outfile),
        full = timed(o.timing, "print", head ++ out0.text ++ footer ++ notes.tail),
        js = with-map(o, o.outfile, full, full, len(head) + out0.base, out0.marks),
        sheets = m.css-imports(),
        css-out = with-extension(o.outfile, ".css"),
        css = [cssb.bundle(sheets, css-out, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments)
               for s in [sheets] if len(s) > 0]

# The output when something needs the whole program: lowering, which adds helpers and names, or a
# spec's own optimiser. Each group is optimised and dropped by itself (nothing the optimiser does
# crosses a group), the program they make lowered whole, and the lowered program made ASCII and
# printed run by run (see `stable-runs`), on many threads at once.
fn flat-output(o: Options, f: Format) -> Printed =
  Printed(text: f.prefix ++ all.text ++ f.suffix, base: len(f.prefix), marks: all.marks ++ [analyze.end-mark(len(all.text))])
  where groups = match o.has-optimize {
          true => [spec-optimized(o, e.group-made(g)) for g in e.groups()]
          false => [group-optimized(g) for g in e.groups()]
        },
        entry = match o.has-optimize {
          true => spec-optimized(o, entry-calls(f))
          false => optimized-stmts(o, entry-calls(f))
        },
        lowered = timed(o.timing, "lower", lowered-of(o, program-of(None(), flagged(groups ++ [entry])))),
        exports = export-statements(f),
        all = pieces-joined(o, [run-printed(run) for run in stable-runs(lowered.body.kids)]
                               ++ [render-part(Program(None(), List(exports...))) for x in [exports] if len(x) > 0])

# Lists of statements one after another, a `Flag()` between each that has any and the one before.
fn flagged(lists: [[Node]]) -> [Node] =
  [s for k in 0..len(lists) if len(lists[k]) > 0
     for s in [Flag() for x in [k] if any j in 0..k: len(lists[j]) > 0] ++ lists[k]]

# A group's statements optimised, or folded, and what is dropped dropped: by the bundler's own
# optimiser, which is all a group's answer may read of the build's options.
fn group-optimized(g: e.Group) -> [Node] = optimized-stmts(building.options, e.group-made(g))

fn optimized-stmts(o: Options, stmts: [Node]) -> [Node] = dropped-of(o, steps).body.kids
  where p = program-of(None(), match o.minify-syntax and o.minify-identifiers {
          true => inline.inlined(stmts, e.written-in(inline.names-in(stmts)))
          false => stmts
        }),
        steps = match o.minify-syntax {
          true => default-optimize(p)
          false => fold.run(p)
        }

# A spec's own optimiser, a function value no answer is kept by, given each group.
fn spec-optimized(o: Options, stmts: [Node]) -> [Node] = dropped-of(o, steps).body.kids
  where p = program-of(None(), stmts),
        steps = match o.minify-syntax {
          true => o.optimize(p)
          false => fold.run(p)
        }

# A run of the lowered program, made ASCII and printed.
fn run-printed(stmts: [Node]) -> Rendered = rendered-of(building.options, stmts)

fn rendered-of(o: Options, stmts: [Node]) -> Rendered =
  printed(ascii-of(o, program-of(None(), stmts)), o.pretty, tracked?(o), analyzed?(o))

# With the bundler's own optimiser and nothing to lower, the output is made group by group (see
# `e.groups`), each group's text from its own units alone, on many threads at once, and the texts
# joined. Nothing the optimiser does crosses from one group to the next.
fn grouped?(o: Options) -> Bool = not o.has-optimize and o.target >= lower.no-lowering

fn grouped-output(o: Options, f: Format) -> Printed =
  Printed(text: f.prefix ++ all.text ++ f.suffix, base: len(f.prefix), marks: all.marks ++ [analyze.end-mark(len(all.text))])
  where exports = export-statements(f),
        all = pieces-joined(o, [group-output(g) for g in e.groups()]
                               ++ [group-rendered(o, entry-calls(f))]
                               ++ [render-part(Program(None(), List(exports...))) for x in [exports] if len(x) > 0])

fn group-output(g: e.Group) -> Rendered = group-rendered(building.options, e.group-made(g))

# Statements as the output has them: minified or folded, what is dropped dropped, made ASCII, and
# printed. A group is a module's, the finest a change to the output is followed, as Turbopack's is.
fn group-rendered(o: Options, stmts: [Node]) -> Rendered = match stmts {
  # Most groups of namespace objects have none: nothing to optimise or print.
  [] => Rendered(text: "", marks: [], open: false)
  _ => rendered-of(o, optimized-stmts(o, stmts))
}

# ---------------------------------------------------------------- code splitting

# The legal comments of the modules in the output, or in one chunk of it, in module order.
fn legal-of-modules(chunk: chunks.Chunk?, homes: {Int:[Int]}) -> [legal.Note] =
  [legal.Note(path: m.modules[id].path, text: t) for id in m.order if len(m.modules[id].legal) > 0 if in-output?(chunk, id, homes)
   for t in m.modules[id].legal]

fn in-output?(chunk: chunks.Chunk?, id: Int, homes: {Int:[Int]}) -> Bool = match chunk {
  some(c) => (any p in e.parts-of(id): p in c.parts) or c.id in (homes[id] ?? [])
  none => e.included?(id)
}

# A file in the output none of whose statements any chunk holds, such as a barrel that only passes
# names on, still has its legal comments in the output, as esbuild has them: in the chunk loaded by
# exactly the roots that reach it, or else in each of those roots' own.
fn legal-homes(all: [chunks.Chunk]) -> {Int:[Int]} =
  {id: homes for id in m.order if len(m.modules[id].legal) > 0 and e.included?(id)
     if not (any c in all: any p in e.parts-of(id): p in c.parts)
     for roots in [sort r in [r for m.db.entered(?r, id) distinct r] by r] if len(roots) > 0
     for homes in [match [c.id for c in all if chunks.same-roots?(c.roots, roots)] {
       [] => [c.id for c in all if c.root in roots]
       found => [found[0]]
     }]}

# What running this chunk's entry looks like at its end.
fn root-statements(root: Int) -> [Node] = match m.modules[root] {
  m.Module(kind: m.Cjs, ...) as mo => [stmt`export default $call_me();`] where call-me = e.final-of(an.require-sym(mo))
  mo if an.wrapped?(mo) and an.asynchronous?(mo) => [ExprStmt(Await(exp`$call_me()`))] ++ exports-of-root(root) where call-me = e.final-of(an.init-sym(mo))
  mo if an.wrapped?(mo) => [stmt`$call_me();`] ++ exports-of-root(root) where call-me = e.final-of(an.init-sym(mo))
  _ => exports-of-root(root)
}

fn chunk-root-statements(c: chunks.Chunk) -> [Node] = match c.root {
  r if r < 0 => []
  r => root-statements(r)
}

# The body of one chunk, as text with placeholders in it.
fn chunk-program(o: Options, c: chunks.Chunk, all: [chunks.Chunk], selected: [e.Unit]) -> Printed =
  Printed(text: r.text ++ "\n", base: 0, marks: r.marks ++ [analyze.end-mark(len(r.text))])
  where emission = with e.units = selected, e.chunk-parts = some(c.parts), e.initializer-parts = c.initializers { e.program() },
        p = for-target(o, match o.minify-syntax {
          true => o.optimize(emission.tree)
          false => fold.run(emission.tree)
        }),
        stmts = chunks.imports-of(c, all) ++ p.body.kids ++ chunk-root-statements(c) ++ chunks.exports-of(c, all),
        r = printed(Program(None(), List(stmts...)), o.pretty, tracked?(o), analyzed?(o))

# With the bundler's own optimiser and nothing to lower (see `grouped?`), a chunk's whole body is
# its own work: the chunks are made at once, each giving the settings that say which chunk it is
# to itself alone.
setting chunk-list: [chunks.Chunk]
setting chunk-selected: [[e.Unit]]
setting chunk-options: Options

fn chunk-at(i: Int) -> Printed = chunk-own(chunk-options, chunk-list[i], chunk-list, chunk-selected[i])

# Its imports, then each group of its statements, then what runs its root and its exports, each
# printed by itself and joined, as a single output is (see `grouped-output`): nothing the optimiser
# does crosses a group, so the text is what the whole chunk printed at once would be.
fn chunk-own(o: Options, c: chunks.Chunk, all: [chunks.Chunk], selected: [e.Unit]) -> Printed =
  Printed(text: r.text ++ "\n", base: 0, marks: r.marks ++ [analyze.end-mark(len(r.text))])
  where imports = render-part(Program(None(), List(chunks.imports-of(c, all)...))),
        groups = with e.units = selected, e.chunk-parts = some(c.parts), e.initializer-parts = c.initializers {
          [chunk-group(g) for g in e.groups()]
        },
        ending = render-part(Program(None(), List((chunk-root-statements(c) ++ chunks.exports-of(c, all))...))),
        r = pieces-joined(o, [imports] ++ groups ++ [ending])

# One group of a chunk, made and printed by itself: what it makes on the way is let go once it is
# text (`apart` in the pipeline), so a chunk's whole tree is never there at once.
fn chunk-group(g: e.Group) -> Rendered = group-rendered(chunk-options, e.group-made(g))

fn chunk-programs(o: Options, all: [chunks.Chunk], selected: [[e.Unit]]) -> [Printed] = match grouped?(o) {
  false => [chunk-program(o, all[i], all, selected[i]) for i in 0..len(all)]
  true => with chunk-list = all, chunk-selected = selected, chunk-options = o {
    [chunk-at(i) for i in 0..len(all)]
  }
}

fn chunk-path-of(o: Options, c: chunks.Chunk, hash: Text, base: Text, static-roots: [Int]) -> Text = match c.root {
  r if r < 0 => o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", "chunk", hash) ++ ".js"
  r if r in static-roots => entry-output-hashed(o, (first entry in o.entries if real-path(entry) == m.modules[r].path: entry) ?? m.modules[r].path, base, hash)
  r => o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", chunk-stem(m.modules[r].path), hash) ++ ".js"
}

# A file's name for its chunk: its stem, with what a virtual module's id may hold that a file name
# should not (`tanstack-start-manifest:v`, a query) made `_`.
fn chunk-stem(path: Text) -> Text =
  text-of-bytes([match c { '/' | ':' | '?' | '*' | '"' | '<' | '>' | '|' | '=' | '&' => '_'  _ => c } for c in bytes-of(path-stem(text-before-query(path)))])

fn text-before-query(path: Text) -> Text = match index-of(path, "?") {
  some(at) => path[0..at]
  none => path
}

fn bytes-of(t: Text) -> [Int] = [t[i] for i in 0..len(t)]

fn split-built(options: Options) -> [Written] = match options.outdir, options.format.export-names {
  "", _ => panic "code splitting needs --outdir"
  _, false => panic "code splitting needs --format=esm"
  _, true => with m.loading = loading-of(o, o.outdir), an.linking = linking-of(o, false, true, esm-format()), e.emitting = emitting-of(o, esm-format()),
                  printing = printing-of(o) {
      match timed(o.timing, "load: parse files ahead", m.parsed-ahead(o.entries)) { _ =>
        split-graph(o, timed(o.timing, "load: resolve, scopes, the graph", m.graph(include-text("runtime.js"), o.entries))) }
    } where o = with-node-env(options)
}

# A split build once its modules are known.
fn split-graph(o: Options, g: m.Graph) -> [Written] =
  with m.modules = g.modules, m.by-path = g.by-path, m.order = g.order, m.ranks = g.ranks, m.blocks = g.module-blocks, m.entries = g.entries, m.entry = g.entries[0] {
    linked-split(o, g)
  }

fn linked-split(o: Options, g: m.Graph) -> [Written] =
  with an.linked = timed(o.timing, "link: modules", an.link(g.symbols)),
       m.table = timed(o.timing, "link: table", an.linked-table(g)),
       m.db = timed(o.timing, "link: facts and Datalog", an.solved-facts()) {
    with e.units = e.units-of-order() { units-split(o) }
  }

# Every symbol's name, and the units the chunks are packed from (see `fragments.model`): neither
# reads the other, and both are worked out at once. The model is an answer the build keeps, which
# packing then finds made.
record Side { names: [sym.Table], units: Int }
setting side-options: Options

fn side(i: Int) -> Side = match i {
  0 => Side(names: [match side-options.minify-identifiers {
    true => final-names(side-options)
    false => nm.names-by-stems(side-options.target < lower.no-lowering)
  }], units: 0)
  _ => Side(names: [], units: len(fragments.model(side-options.chunking.fragments).units))
}

# Minified names are counted and handed out. esbuild's numbered names are of stems, and a stem is
# a name the build's table of names may not have met: which modules claim each stem is worked out
# first, and only the rest, which reads that table, is beside the units.
fn names-beside-units(o: Options) -> sym.Table = match o.minify-identifiers {
  true => sides(o)[0].names[0]
  false => with nm.stems = nm.stems-db() { sides(o)[0].names[0] }
}

fn sides(o: Options) -> [Side] = with side-options = o { [side(i) for i in [0, 1]] }

fn units-split(o: Options) -> [Written] =
  with nm.finals = timed(o.timing, "naming, and the units of chunks", names-beside-units(o)) {
    with e.singles = singles-of(o) { named-split(o) }
  }

# The rest of a split build, once every symbol has its name: a chunk for each root, which an import
# of it names by a placeholder until every chunk's name is known.
fn named-split(o: Options) -> [Written] =
  with e.chunk-paths = {root: chunks.placeholder(ids[root] ?? (panic "{} has no chunk", m.modules[root].path)) for root in roots},
       e.chunk-styles = {styles[i].root: chunks.placeholder(len(all) + i) for i in 0..len(styles)} {
    chunks-written(o, all, styles)
  } where roots = m.entries ++ an.linked.dynamic-roots,
          all = timed(o.timing, "chunk: policy", chunks.configured(roots, o.chunking)),
          ids = {c.root: c.id for c in all if c.root >= 0},
          styles = [root-stylesheet(o, r, sheets) for r in roots for sheets in [m.stylesheets(r)] if len(sheets) > 0]

# Each chunk printed, its placeholders filled once every chunk's name is known.
record RootStylesheet { root: Int, path: Text, bundle: cssb.Bundled }

fn root-stylesheet(o: Options, root: Int, sheets: [Text]) -> RootStylesheet =
  RootStylesheet(root: root, path: path, bundle: cssb.bundle(sheets, path, o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments))
  where bundled = cssb.bundle(sheets, o.outdir ++ "/style.css", o.minify-syntax or o.minify-identifiers, o.pretty, o.legal-comments),
        path = match root in m.entries and o.page == "" and not contains-text?(o.entry-names, "[hash]") {
          true => with-extension(entry-output(o, (first entry in o.entries if real-path(entry) == m.modules[root].path: entry)
                                                  ?? m.modules[root].path, base-dir(o)), ".css")
          false => o.outdir ++ "/" ++ chunks.pattern-path(o.chunk-names, "", path-stem(m.modules[root].path), host.content-hash(bundled.text)) ++ ".css"
        }

fn chunks-written(o: Options, all: [chunks.Chunk], styles: [RootStylesheet]) -> [Written] =
  [w for ws in js for w in ws]
  ++ [sheet-written(s.path, s.bundle)... for s in styles]
  ++ analysis-written(o, [chunk-analyzed(all, i, printed[i], holes[i], paths, text-written(js[i], paths[i])) for i in 0..len(all)]
                         ++ [analyze.Output(path: s.path, kind: "css", text: s.bundle.text, base: 0, marks: [], root: -1, imports: [], dynamic: []) for s in styles],
                      m.entries ++ an.linked.dynamic-roots)
  ++ assets-written([a for s in styles for a in s.bundle.assets] ++ module-assets(o.outdir)) ++ url-assets-of(o, o.outdir)
  ++ page-written(o, all, paths, styles)
  ++ manifest-written(o, all, paths, styles)
  where unit-index = {p: i for i in 0..len(e.units) for p in e.units[i].parts},
        printed = chunk-programs(o, all, [chunk-units(c, unit-index) for c in all]),
        js = [chunk-written(o, all[i], printed[i], holes[i], paths[i], paths, homes) for i in 0..len(all)],
        texts = [p.text for p in printed] ++ [s.bundle.text for s in styles],
        holes = [chunks.holes-in(text) for text in texts],
        base = base-dir(o),
        # A chunk's hash is its own work, over its text and those it reaches: all are made at once.
        hashes = [chunks.content-hash(c.id, texts, holes) for c in all],
        paths = [chunk-path-of(o, all[i], hashes[i], base, m.entries) for i in 0..len(all)]
                ++ [s.path for s in styles],
        homes = legal-homes(all)

# With a page as the entry, the page written again (bundle.pages): for each script or stylesheet it
# loads, the chunk the build made of it, the chunks that one imports, all the way down, to preload,
# and its stylesheets; paths from the output directory, given from the public path (`/`). And the
# project's `public` directory, copied, as Vite copies it.
fn page-written(o: Options, all: [chunks.Chunk], paths: [Text], styles: [RootStylesheet]) -> [Written] = match o.page {
  "" => []
  page => [Written(path: out, text: t, said: said-of(t, out))] ++ public-written(dir-of(page) ++ "/public", o.outdir)
    where out = o.outdir ++ "/" ++ path-base(page),
          t = pages.written(pages.page-of(page), made, match o.public-path { "" => "/"  p => p }),
          made = [pages.Made(source: entry, file: below(o.outdir, paths[i]), preload: [below(o.outdir, paths[j]) for j in imported-closure(all, i)],
                             styles: [below(o.outdir, s.path) for s in styles if s.root == r])
                  for k in 0..len(o.entries) for entry in [o.entries[k]] for r in [m.entries[k]] for i in [first-chunk(all, r)]]
}

fn first-chunk(all: [chunks.Chunk], root: Int) -> Int = (first i in 0..len(all) if all[i].root == root: i) ?? panic "{} has no chunk", m.modules[root].path

# The chunks a chunk imports, and what those import, in the order a walk first meets them.
fn imported-closure(all: [chunks.Chunk], i: Int) -> [Int] = [j for j in reached([chunk-imports(all, k) for k in 0..len(all)], [i], []) if j != i]

fn reached(edges: [[Int]], todo: [Int], seen: [Int]) -> [Int] = match todo {
  [] => seen
  [x, rest...] if x in seen => reached(edges, rest, seen)
  [x, rest...] => reached(edges, rest ++ edges[x], seen ++ [x])
}

fn chunk-imports(all: [chunks.Chunk], i: Int) -> [Int] =
  [other.id for other in all if other.id != c.id if other.id in c.needs or (c.root >= 0 and c.root in other.roots)]
  where c = all[i]

# With `--manifest`, the output directory's `.vite/manifest.json`, as Vite writes it: for each entry
# and each module an `import()` names, by its path from where the build runs (a page's script by the
# page's), the file it became, its name, whether it is an entry or loaded by `import()`, the chunks
# it imports and the roots it loads (by their keys), and its stylesheets; each other chunk by `_`
# and its file's name. Keys in order.
fn manifest-written(o: Options, all: [chunks.Chunk], paths: [Text], styles: [RootStylesheet]) -> [Written] = match o.manifest {
  false => []
  true => [Written(path: out, text: t, said: said-of(t, out))]
    where out = o.outdir ++ "/.vite/manifest.json",
          keys = [chunk-key(o, all[i], paths[i]) for i in 0..len(all)],
          t = "{\n" ++ join([manifest-entry(o, all, paths, styles, keys, i) for i in sort i in [i for i in 0..len(all)] by keys[i]], ",\n") ++ "\n}\n"
}

fn chunk-key(o: Options, c: chunks.Chunk, path: Text) -> Text = match c.root {
  r if r < 0 => "_" ++ path-base(path)
  r if r in m.entries and o.page != "" => m.shown-path(o.page)
  r => m.shown-path(m.modules[r].path)
}

fn manifest-entry(o: Options, all: [chunks.Chunk], paths: [Text], styles: [RootStylesheet], keys: [Text], i: Int) -> Text =
  "  " ++ host.js-string(keys[i]) ++ ": {\n" ++ join(fields, ",\n") ++ "\n  }"
  where c = all[i],
        fields = ["    \"file\": " ++ host.js-string(below(o.outdir, paths[i])),
                  "    \"name\": " ++ host.js-string(path-stem(text-before(below(o.outdir, paths[i]), "-")))]
                 ++ ["    \"src\": " ++ host.js-string(keys[i]) for r in [c.root] if r >= 0]
                 ++ ["    \"isEntry\": true" for r in [c.root] if r in m.entries]
                 ++ ["    \"isDynamicEntry\": true" for r in [c.root] if r >= 0 and not (r in m.entries)]
                 ++ ["    \"imports\": [" ++ join([host.js-string(keys[j]) for j in chunk-imports(all, i)], ", ") ++ "]"
                     for js in [chunk-imports(all, i)] if len(js) > 0]
                 ++ ["    \"dynamicImports\": [" ++ join([host.js-string(keys[first-chunk(all, r)]) for r in ds], ", ") ++ "]"
                     for ds in [loaded-roots(all, i)] if len(ds) > 0]
                 ++ ["    \"css\": [" ++ join([host.js-string(below(o.outdir, s.path)) for s in styles if s.root == c.root], ", ") ++ "]"
                     for r in [c.root] if r >= 0 and any s in styles: s.root == r]

# The roots a chunk's statements `import()`.
fn loaded-roots(all: [chunks.Chunk], i: Int) -> [Int] =
  sort r in [r for p in keys(all[i].parts) for id in [first m.db.part-of(p, ?mo): mo] if let some(mo) = id
             for t in fragments.dynamic-targets(mo, p) for r in [t] if r in an.linked.dynamic-roots distinct r] by r

# Every file under a directory, copied to the same place under the output directory.
fn public-written(dir: Text, out: Text) -> [Written] =
  [Written(path: out ++ "/" ++ rel, text: read-file(dir ++ "/" ++ rel), said: "") for rel in files-under(dir, "")]

fn files-under(dir: Text, rel: Text) -> [Text] =
  [f for line in split(dir-listing(dir ++ rel), "\n") if line != "" for name in [line[1..len(line)]]
   for f in (match line[0] {
     'd' => files-under(dir, rel ++ "/" ++ name)
     _ => [(rel ++ "/" ++ name)[1..len(rel) + 1 + len(name)]]
   })]

# Join a chunk's part ids through an inverted index, then restore the original emission order.
# Asking every module about every chunk creates mostly-empty memo answers and graph-sized
# dependency frames. Only units actually owned by a chunk participate in that chunk's emission.
fn chunk-units(c: chunks.Chunk, index: {Int:Int}) -> [e.Unit] =
  [e.units[i] for i in sort i in [id for p in keys(c.parts) for id in index[p] distinct id] by i]

# A chunk's files are its own work, once every chunk's name is known.
fn chunk-written(o: Options, c: chunks.Chunk, pr: Printed, holes: [chunks.Hole], path: Text, paths: [Text], homes: {Int:[Int]}) -> [Written] =
  beside(path ++ ".LEGAL.txt", notes.file) ++ with-map(o, path, done.text ++ notes.tail, done.text, pr.base, done.marks)
  where done = chunks.filled(pr.text, pr.base, pr.marks, holes, path, paths),
        notes = legal.placed(o.legal-comments, legal-of-modules(some(c), homes), path)

# ---------------------------------------------------------------- what a build says of itself

# A chunk as the analysis sees it: its text as written, every chunk's name in it, and where it passes from
# one module's code to the next; what it imports, and what it loads with `import()`.
fn chunk-analyzed(all: [chunks.Chunk], i: Int, pr: Printed, holes: [chunks.Hole], paths: [Text], text: Text) -> analyze.Output =
  analyze.Output(path: paths[i], kind: "js", text: text, base: pr.base, marks: done.marks, root: c.root, imports: imports,
                 dynamic: [h.chunk for h in holes if h.chunk < len(all) and h.chunk != i and not (h.chunk in imports) distinct h.chunk])
  where c = all[i],
        done = chunks.filled(pr.text, pr.base, pr.marks, holes, paths[i], paths),
        imports = [other.id for other in all if other.id != c.id if other.id in c.needs or (c.root >= 0 and c.root in other.roots)]

# The text written at `path`: what an analysis measures, the line naming the map included.
fn text-written(ws: [Written], path: Text) -> Text = (first w in ws if w.path == path: w.text) ?? (panic "nothing written at {}", path)

# With `--analyze=DIR`: the analysis as JSON. The page is made from the JSON
# when asked (`esb --view=DIR`, bundle.view), not by the build.
fn analysis-written(o: Options, outputs: [analyze.Output], roots: [Int]) -> [Written] = match o.ledger or len(o.lints) > 0 {
  false => analysis-json(o, outputs, roots)
  true => analysis-json(o, outputs, roots) ++ ledgered(o, led.ledger(outputs, roots))
}

# What is made of the ledger: itself, written, and what the lints find in it.
fn ledgered(o: Options, made: led.Ledger) -> [Written] = ledger-files(o, made) ++ lint-written(o, made)

fn analysis-json(o: Options, outputs: [analyze.Output], roots: [Int]) -> [Written] = match o.analyze {
  "" => []
  dir => [Written(path: dir ++ "/analysis.json", text: r.json, said: said-of(r.json, dir ++ "/analysis.json"))]
    where r = analyze.report(outputs, roots)
}

fn ledger-files(o: Options, made: led.Ledger) -> [Written] = match o.ledger {
  false => []
  true => ledger-file(o, made)
}

fn ledger-file(o: Options, made: led.Ledger) -> [Written] = match o.analyze {
  "" => fail-build("a ledger is written beside an analysis: --ledger needs --analyze=DIR")
  _ => [Written(path: ledger-path(o), text: t, said: said-of(t, ledger-path(o)))] where t = led.json-of(made)
}

# What the lints found: a message (`message-path`), whose text is how many errors it holds.
fn lint-written(o: Options, made: led.Ledger) -> [Written] = match o.lints {
  [] => []
  files => lint-message(lint.linted(files, shipped.Build(ledger: made, node: o.platform-node, fix: o.fix)))
}

# What the lints found, said; and each file their fixes changed, at a path that says so (`fixes-of`).
fn lint-message(r: lint.Linted) -> [Written] =
  [Written(path: message-path, text: int-text(r.errors), said: r.text)]
  ++ [Written(path: fix-prefix ++ f.path, text: f.text, said: "fixed " ++ int-text(f.made) ++ " in " ++ m.shown-path(f.path))
      for f in shipped.fixed-files(r.edits)]

const fix-prefix: Text = "<fix>"

# The source files a `--fix` changes, to be written where they are; and nothing else.
fn fixes-of(ws: [Written]) -> [Written] = [w with { path: w.path[len(fix-prefix)..len(w.path)] } for w in ws if starts-with(w.path, fix-prefix)]

fn lint-errors(ws: [Written]) -> Int = sum w in ws if message?(w): parse-int(w.text)
fn lint-report(ws: [Written]) -> Text = join([w.said for w in ws if message?(w)], "\n")

# The files written, unless a lint found an error, when the build fails saying what.
fn published(ws: [Written]) -> Void = match lint-errors(ws) {
  0 => written(ws)
  n => fail-build("the build stops, for what its lints found:\n\n" ++ lint-report(ws))
}

# Where the ledger is written: beside the analysis.
fn ledger-path(o: Options) -> Text = o.analyze ++ "/ledger.json"

# The ledger a build wrote, of the files it wrote.
fn ledger-written(o: Options, files: [Written]) -> Text = (first w in files if w.path == ledger-path(o): w.text) ?? (panic "the build wrote no ledger at {}", ledger-path(o))
