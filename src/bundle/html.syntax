# HTML as the build's own pages write it (`--analyze`): elements with attributes, void elements, and
# text. Space is kept as written, a token of its own, so a page prints as its templates read. Text and
# attribute values are leaves, printed as they are: what makes them (bundle.view) escapes them.
syntax
start Doc
space Nothing
word NameChar

fragment Nothing = (!. .)* ;
fragment NameChar = [a-zA-Z0-9\-] ;

raw token Ws = [ \t\n\r]+ ;
token Name = [a-zA-Z] NameChar* ;
# A quoted value, or a template's hole for one.
token Value = "\"" [^"]* "\"" | "$" [a-zA-Z0-9_]+ ;
token Chars = [^<>]+ ;

rule Doc = Doctype? Node* -> Doc(doctype, nodes) ;
rule Doctype = "<!doctype html>" -> Doctype ;
rule Node = Element | Void | Chars ;
rule Element = "<" Name Attr* Ws? ">" Node* "</" Name ">" -> Element(name, attrs, space, kids, close) ;
rule Void = "<" Name Attr* Ws? "/>" -> Void(name, attrs, space) ;
rule Attr = Ws Name "=" Value -> Attr(space, name, value) ;
