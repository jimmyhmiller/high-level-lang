# Lints over what a build ships (`.lint`): rules, as Datalog, over the build's own relations (what
# each route loads, what each statement needs, what linking kept and why), with JavaScript patterns
# as atoms. Data, read when a build runs, as a build spec is; `lint.rules` says what it means.
#
#   secret(P, N) :- code(P, `process.env.$N`), !starts-with(N, "PUBLIC_") ;
#   lint secret-shipped error at P "process.env.{N} ships in {R}" :- ships(R, P), secret(P, N) ;
#   rewrite no-get `$G($O, $K)` => `$O?.[$K]` :- imported(G, "lodash", "get") ;
syntax
start File
space Space
word NameChar

fragment Space = ([ \t\n\r] | "#" [^\n]*)* ;
fragment NameChar = [a-zA-Z0-9_\-] ;
fragment Keyword = ("lint" | "rewrite" | "fix" | "error" | "warning" | "at" | "count" | "sum" | "min" | "max") !NameChar ;
# A relation's name starts with a small letter, a variable's with a capital.
token Name = !Keyword [a-z] NameChar* ;
token Var = [A-Z] NameChar* ;
token Str = "\"" ("\\" . | [^"\\])* "\"" ;
token Num = [0-9]+ ;
# JavaScript, as js.syntax reads it: an expression or a statement, `$X` a variable of the rule's,
# `$_` anything, and `$$X` in a list (arguments, elements) any number of them.
token Pattern = "`" [^`]* "`" ;

rule File = Item* -> File(items) ;
rule Item
  = "lint" Name Severity At? Str ":-" Literal,+ ";" -> Lint(name, severity, at, message, body)
  # A rewrite of each module's code as it loads: what the pattern matches becomes the template, the
  # pattern's variables put in, where the conditions hold of the module and its names.
  | "rewrite" Name Pattern "=>" Pattern Conditions? ";" -> Rewrite(name, pattern, template, conditions)
  # A fix of a lint's findings, made to the source files with `--fix`: in the statement each finding
  # is at, what the pattern matches becomes the template.
  | "fix" Name Pattern "=>" Pattern ";" -> Fix(name, pattern, template)
  | Head ":-" Literal,+ ";" -> Rule(head, body)
  | Head ";" -> Fact(head)
  ;
rule Conditions = ":-" Literal,+ -> Conditions(literals) ;
rule Severity = "error" -> Error | "warning" -> Warning ;
# The variable whose value says where a finding is: a statement, a place, or a module.
rule At = "at" Var -> At(var) ;

rule Head = Name "(" HeadArg,* ")" -> Head(name, args) ;
rule HeadArg = "count" Var -> Count(var) | "sum" Var -> Sum(var) | "min" Var -> Min(var) | "max" Var -> Max(var) | Term ;

rule Literal
  = "!" Atom -> Not(atom)
  | Term "!=" Term -> Ne(left, right)
  | Term "<=" Term -> Le(left, right)
  | Term ">=" Term -> Ge(left, right)
  | Term "<" Term -> Lt(left, right)
  | Term ">" Term -> Gt(left, right)
  | Term "=" Term -> Eq(left, right)
  | Atom
  ;
rule Atom = Name "(" Arg,* ")" -> Atom(name, args) ;
rule Arg = Pattern -> Code(text) | Term ;
rule Term = Var -> Variable(name) | Str -> Text(value) | Num -> Number(value) | "_" -> Anything ;
