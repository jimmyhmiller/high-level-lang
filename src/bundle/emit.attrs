# From a solved graph to one program: name every symbol, rewrite identifiers to their final names,
# wrap CommonJS modules and pick the live statements.
attrs bundle.emit over bundle.js
use bundle.js as js
use bundle.scopes as sc
use bundle.modules as m
use bundle.analysis as an
use bundle.minhost as host
use bundle.naming as nm
use bundle.evaluation as ev

quote stmt at 1 0 ;
quote exp at 1 0 0 ;

# How the build emits: `undefined` as `void 0`, `require` native or not, the names a kept import binds
# that nothing reads left out, and nodes stamped for a source map.
record Emitting { void-undefined: Bool, native-require: Bool, drop-unused-imports: Bool, sourcemap: Bool }

setting emitting: Emitting
# Code splitting: the statements of the chunk being printed, none when it is the whole program; and
# what to write for the path of the chunk each root module starts.
setting chunk-parts: {Int:Bool}?
setting initializer-parts: {Int:Bool}
setting chunk-paths: {Int:Text}
setting chunk-styles: {Int:Text} = {}

fn chunk-path(root: Int) -> Text =
  chunk-paths[root] ?? panic "{} starts no chunk in this build", m.modules[root].path

context here: m.Module = m.blank-module(-1, "", m.External, -1)
# The body of the module `here` is: what it is made of.
context body: m.Body = m.empty-body()

fn import-symbol?(s: Int) -> Bool = nm.import-symbol?(s)

# What a symbol finally means: an import means whatever it resolves to.
fn target-of(s: Int) -> Int =
  (first m.db.import-of(s, ?d, ?n): import-target(s, d, n))
  ?? (first m.db.ns-import(s, ?target): an.ns-sym(m.modules[target]))
  ?? s

# What an import of `n` from `d` means: its export, or with `export *` from CommonJS, itself; or
# from a script, which exports nothing, itself, read as `undefined`.
fn import-target(s: Int, d: Int, n: Int) -> Int = match resolved-export(d, n) {
  some(t) => t
  none if m.db.dynamic(d) or m.modules[d].script => s
  none => panic "No matching export in {} for import {}", m.modules[d].path, name-of(m.names, n)
}

fn included?(id: Int) -> Bool = nm.included?(id)
fn live?(p: Int) -> Bool = nm.live?(p)
fn parts-of(id: Int) -> [Int] = nm.parts-of(id)

fn final-of(s: Int) -> Text = nm.final-of(s)

fn helper-name(name: Text) -> Text = final-of(an.helper(name))

fn void-zero() -> Node = exp`void 0`

# The CommonJS property this name reads, whether imported here or re-exported to here.
fn cjs-import-of(leaf: Node) -> an.CjsImport? = match m.symbol-in(body, here, leaf.lo) {
  some(s) => match an.linked.cjs-imports[s] {
    none if an.linked.any-reexport => an.linked.cjs-imports[target-of(s)]
    found => found
  }
  none => none
}

fn cjs-read(ci: an.CjsImport) -> Node = match ci.namespace {
  true => Ident(final-of(ci.import-var))
  false => Member(Ident(final-of(ci.import-var)), PropName(ci.name))
}

# The symbol an export name means in a module: the one it resolves to that is not itself an import;
# with none, the one import it stops at (one from CommonJS, whose names are only known at run time),
# or the module's own. Two that are not imports (two `export *` giving the name) make it ambiguous,
# and, as esbuild has it, nothing exports it.
fn resolved-export(module: Int, name: Int) -> Int? = match p.final, p.finals, p.held, p.helds {
  f, 1, _, _ => some(f)
  _, 0, h, 1 => some(h)
  _, 0, _, 0 => none
  _, 0, _, _ => first m.db.local-export(module, name, ?s): s
  _, _, _, _ => none
} where p = fold seen = Candidates(final: -1, finals: 0, held: -1, helds: 0) for m.db.resolved(module, name, ?c): candidate(seen, c)

# What an export name resolves to, seen one candidate at a time: the first that is not an import and
# how many different ones there are (two: more than one), and the same of the imports.
record Candidates { final: Int, finals: Int, held: Int, helds: Int }

fn candidate(p: Candidates, c: Int) -> Candidates = match import-symbol?(c), p.finals, p.helds {
  false, 0, _ => p with { final: c, finals: 1 }
  false, 1, _ if c != p.final => p with { finals: 2 }
  false, _, _ => p
  true, _, 0 => p with { held: c, helds: 1 }
  true, _, 1 if c != p.held => p with { helds: 2 }
  true, _, _ => p
}

# What reading a symbol looks like in the output.
fn symbol-read(s: Int) -> Node = match an.linked.cjs-imports[t] {
  some(ci) => cjs-read(ci)
  none => dynamic-read(s) ?? script-read(s) ?? Ident(final-of(t))
} where t = target-of(s)

fn namespace-property(target: Int, name: Text) -> Node = Member(Ident(final-of(an.ns-sym(m.modules[target]))), PropName(name))

# `ns.name` when `ns` is `import * as` of an ES module: the export itself.
fn namespace-read(n: Node) -> Node? = match an.namespace-of(body, here, n.object) {
  none => none
  some(target) => match exported(target, n.property.text) {
    some(s) => some(symbol-read(s))
    none if m.db.dynamic(target) => some(namespace-property(target, n.property.text))
    none => some(void-zero())
  }
}

# What a module exports under a name. A name never interned is in no fact, so nothing exports it.
fn exported(target: Int, name: Text) -> Int? = match known-name(m.names, name) {
  id if id < 0 => none
  id => resolved-export(target, id)
}

# An import from a script, which exports nothing: `void 0`.
fn script-read(s: Int) -> Node? = first m.db.import-of(s, ?d, _) if m.modules[d].script: void-zero()

# An import of a name only `export *` from CommonJS can supply, known at run time.
fn dynamic-read(s: Int) -> Node? =
  first m.db.import-of(s, ?d, ?n) if an.linked.any-dynamic and not m.db.resolved(d, n, _) and m.db.dynamic(d):
    namespace-property(d, name-of(m.names, n))

fn require-of(t: m.Module) -> Node = exp`$call_me()` where call-me = final-of(an.require-sym(t))

# `require("x")` of a wrapped ES module: `(init_x(), __toCommonJS(x_exports))`.
fn require-esm(t: m.Module) -> Node = exp`($init(), $to_cjs($ns))`
  where init = final-of(an.init-sym(t)),
        to-cjs = helper-name("__toCommonJS"),
        ns = final-of(an.ns-sym(t))

# `import("x")`: nothing to fetch in one bundle, so a resolved promise of its namespace.
fn import-call(t: m.Module) -> Node = match t.kind {
  Cjs => exp`Promise.resolve().then(() => $to_esm($req()))`
    where to-esm = helper-name("__toESM"),
          req = final-of(an.require-sym(t))
  _ => exp`Promise.resolve().then(() => ($init(), $ns))`
    where init = final-of(an.init-sym(t)),
          ns = final-of(an.ns-sym(t))
}

# `import("x")` of a chunk: its file, and a CommonJS module's value comes out as its default export.
fn import-chunk(t: m.Module) -> Node = match chunk-styles[t.id] {
  some(css) => exp`$load(new URL($sheet, import.meta.url).href).then(() => $loaded)`
    where load = helper-name("__loadCSS"), sheet = Str(quote-text(css)), loaded = import-chunk-code(t)
  none => import-chunk-code(t)
}

fn import-chunk-code(t: m.Module) -> Node = match t.kind {
  Cjs => exp`import($path).then(($param) => $to_esm($param.default))`
    where to-esm = helper-name("__toESM"), param = match to-esm { "m" => "n" _ => "m" }
  _ => exp`import($path)`
} where path = Str(quote-text(chunk-path(t.id)))

# Function-like kinds rebind `this`; arrows do not.
fn rebinds-this?(n: Node) -> Bool = sc.scope-kind(n.kind) == "function" and not (n is Arrow(...) | AsyncArrow(...))

fn wrapper-param(name: Text) -> Int =
  sym.scope-at(m.table, sym.scope-at(m.table, here.root).parent).names[name]
  ?? panic "{}: a CommonJS wrapper has no {} symbol", here.path, name

# Identifiers take their final names, and what reads another module reads it as the bundle has it.
# `depth` counts the functions, arrows aside, and class bodies around a node: `this` at the top of
# a module is its `exports`, or nothing.
inh depth: Int = 0

on FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...) | FuncExpr(...) | GenExpr(...)
  | AsyncFuncExpr(...) | AsyncGenExpr(...) | Method(...) | GenMethod(...) | AsyncMethod(...)
  | AsyncGenMethod(...) | Getter(...) | Setter(...) | StaticBlock(...) | ClassBody(...) { kids.depth = depth + 1 }

rewrite Ident(x) as n => final-ident(n, x)
rewrite BindName(_) as n => match m.symbol-in(body, here, n.lo) {
  some(s) => BindName(final-of(s)) with { lo: n.lo, hi: n.hi }
  none => n
}
rewrite This() as n if depth > 0 => n
rewrite This() if here.kind == Cjs => Ident(final-of(wrapper-param("exports")))
rewrite This() => void-zero()
rewrite Shorthand(old) as n if old.out is Ident(_) and old.out.text == old.text => n
rewrite Shorthand(old) => Prop(PropName(old.text), old.out)
rewrite PatShort(old, init) => short-pattern(old, old.out, init.out)
rewrite CallExpr(callee, _) as n => final-call(n, callee, n.out)
# `require` of a wrapped ES module whose value goes unused only runs it, as esbuild writes it.
rewrite ExprStmt(CallExpr(...) as call) as n => match an.known-require-target(body, here, call) {
  some(t) if m.modules[t].kind == Esm and an.wrapped?(m.modules[t]) => stmt`$init();` where init = final-of(an.init-sym(m.modules[t]))
  _ => n.out
}
rewrite Member(object, property) as n =>
  namespace-read(n) ?? Member(object.out, property) with { lo: object.out.lo, hi: property.hi }
rewrite ImportCall(...) as n => match an.known-import-call-target(here, n) {
  some(t) if m.modules[t].kind == External => n
  some(t) if an.linking.splitting => import-chunk(m.modules[t])
  some(t) => import-call(m.modules[t])
  none => n.out
}
rewrite ImportMeta() => exp`({})`.expr
# An empty statement in a statement list does nothing.
rewrite List(...) as n => without-empty(n.out)

fn without-empty(l: Node) -> Node = l with { kids: [k for k in l.kids if not (k is Empty())] }

# A statement with its final names.
fn rewritten(s: Node) -> Node = run(s).tree

fn final-ident(n: Node, x: Text) -> Node = match cjs-import-of(n) {
  some(ci) => cjs-read(ci)
  none => match m.symbol-in(body, here, n.lo) {
    some(s) => dynamic-read(s) ?? script-read(s) ?? Ident(final-of(target-of(s))) with { lo: n.lo, hi: n.hi }
    none if x in here.helpers => Ident(helper-name(x)) with { lo: n.lo, hi: n.hi }
    # A free `undefined` is the shorter `void 0` under --minify-syntax.
    none if emitting.void-undefined and x == "undefined" => void-zero()
    none => n
  }
}

fn short-pattern(old: Node, new: Node, init: Node) -> Node = match new.text {
  t if t == old.text => PatShort(new, init) with { lo: new.lo, hi: init.hi }
  _ => PatProp(PropName(old.text), BindElement(new, init) with { lo: new.lo, hi: init.hi })
}

# `require("x")` becomes `require_x()`; a call of a CommonJS import keeps `this` undefined by
# reading the function first: `(0, import_x.f)(…)`. `out` is the call with its parts rewritten.
fn final-call(n: Node, callee: Node, out: Node) -> Node = match an.known-require-target(body, here, n) {
  some(target) => required(m.modules[target], out)
  none => CallExpr(wrapped, out.args) with { lo: wrapped.lo, hi: out.args.hi }
    where wrapped = callee-read(callee, out.callee)
}

fn required(t: m.Module, out: Node) -> Node = match t.kind {
  Cjs => require-of(t)
  External => external-required(t)
  _ => require-esm(t)
}

fn callee-read(callee: Node, new-callee: Node) -> Node = match callee {
  Ident(_) => match cjs-import-of(callee) {
    some(ci) if not ci.namespace => exp`(0, $new_callee)`
    _ => new-callee
  }
  _ => new-callee
}

fn init-call(t: m.Module) -> Node? = match an.wrapped?(t) {
  true => some(stmt`$init();`) where init = final-of(an.init-sym(t))
  false => none
}

# `require("x")` where the output's runner has `require`, and esbuild's `__require("x")` elsewhere.
fn external-required(t: m.Module) -> Node = match emitting.native-require {
  true => exp`require($path)`
  false => exp`$load($path)` where load = helper-name("__require")
} where path = Str(quote-text(t.path))

# `var import_x = __toESM(require_x(), 1);` Files in node mode (.mjs, or a package with
# "type": "module") get the second argument, so `default` is module.exports.
fn import-cjs-stmt(t: m.Module) -> Node = stmt`var $v = $value;`
  where v = final-of(an.known-import-var(here, t.id)),
        value = to-esm-call(t)

fn to-esm-call(t: m.Module) -> Node = match m.node-mode?(here.path) {
  true => exp`$to_esm($object, 1)`
  false => exp`$to_esm($object)`
} where to-esm = helper-name("__toESM"),
        object = match t.kind {
          External => external-required(t)
          _ => require-of(t)
        }

# `export * from` CommonJS: `__reExport(x_exports, __toESM(require_y()));`
fn reexport-all(t: m.Module) -> Node = stmt`$re($ns, $value);`
  where re = helper-name("__reExport"),
        ns = final-of(an.ns-sym(here)),
        value = to-esm-call(t)

# In ES module output, `export *` from an outside module copies its namespace, imported where the
# statement stands, as esbuild writes it: `__reExport(x_exports, y_star); import * as y_star from "y";`.
fn reexport-kept(t: m.Module) -> [Node] = [stmt`$re($ns, $star);`, Import(ImportNamespace(BindName(star)), path-of(t))]
  where re = helper-name("__reExport"),
        ns = final-of(an.ns-sym(here)),
        star = final-of(an.known-import-var(here, t.id))

fn import-or-init(t: m.Module) -> Node? = match an.opaque?(t) {
  true => some(import-cjs-stmt(t))
  false => init-call(t)
}

# The body statements of a part, ready to print. None for a part with no code.
fn part-output(s: Node) -> Node? = match s {
  ImportBare(from) => match t.kind {
    Cjs => some(import-cjs-stmt(t))
    External if an.kept?(t) => some(ImportBare(path-of(t)))
    External => some(stmt`var $v = $object;`) where v = final-of(an.known-import-var(here, t.id)), object = external-required(t)
    _ => init-call(t)
  } where t = m.modules[an.known-dep(here, from)]
  ExportAll(from) => match an.opaque?(t) {
    true if an.kept-star?(here, t) => some(ExportAll(path-of(t)))
    true if an.kept?(t) => some(List(reexport-kept(t)...))
    true => some(reexport-all(t))
    false => init-call(t)
  } where t = m.modules[an.known-dep(here, from)]
  ExportAllAs(name, from) => match an.kept?(t) {
    true => some(Import(ImportNamespace(BindName(reexport-local(name))), path-of(t)))
    false => import-or-init(t)
  } where t = m.modules[an.known-dep(here, from)]
  ExportFrom(List(specs...), from) => match an.kept?(t) {
    true => some(Import(ImportNamed(List([import-spec(spec.local, reexport-local(spec)) for spec in specs if exported-spec?(spec)]...)),
                        path-of(t)))
    false => import-or-init(t)
  } where t = m.modules[an.known-dep(here, from)]
  ExportNamed(...) => none
  Import(clause, from) => match an.kept?(t) {
    true => some(kept-import(clause, t))
    false => import-or-init(t)
  } where t = m.modules[an.known-dep(here, from)]
  ExportVar(list) => some(rewritten(VarDecl(list) with { lo: s.lo, hi: s.hi }))
  ExportLexical(d) | ExportFunction(d) | ExportClass(d) => some(rewritten(d))
  _ => some(rewritten(s))
}

# ---------------------------------------------------------------- imports kept as statements

# An import an external module keeps in ES module output, its names as the output spells them, and
# those nothing reads left out when asked, as esbuild's `--minify-syntax` leaves them: with none
# left, only the loading.
fn kept-import(clause: Node, t: m.Module) -> Node = match kept-clause(clause) {
  some(c) => Import(c, path-of(t))
  none => ImportBare(path-of(t))
}

fn kept-clause(c: Node) -> Node? = match c {
  ImportDefault(b) if wanted?(b) => some(ImportDefault(local-of(b)))
  ImportNamespace(b) if wanted?(b) => some(ImportNamespace(local-of(b)))
  ImportDefaultAnd(b, rest) => match wanted?(b), kept-clause(rest) {
    true, some(r) => some(ImportDefaultAnd(local-of(b), r))
    true, none => some(ImportDefault(local-of(b)))
    false, r => r
  }
  ImportNamed(List(specs...)) => match [named-spec(x) for x in specs if named-binding?(x) and wanted?(x.name)] {
    [] => none
    kept => some(ImportNamed(List(kept...)))
  }
  _ => none
}

fn named-binding?(x: Node) -> Bool = x is ImportAs(...) or x is ImportName(...)

fn named-spec(x: Node) -> Node = match x {
  ImportAs(imported, b) => import-spec(imported, final-of(binding-sym(b)))
  _ => import-spec(PropName(x.name.text), final-of(binding-sym(x.name)))
}

# `{ x }` when the local name is the one imported, and `{ x as y }` when it is not.
fn import-spec(imported: Node, local: Text) -> Node = match imported {
  PropName(name) if name == local => ImportName(BindName(local))
  _ => ImportAs(imported, BindName(local))
}

fn wanted?(b: Node) -> Bool = not emitting.drop-unused-imports or (any m.db.mentions(?p, binding-sym(b)): live?(p))

fn binding-sym(b: Node) -> Int = m.symbol-in(body, here, b.lo) ?? panic "{}: no symbol for import {}", here.path, b.text

fn local-of(b: Node) -> Node = BindName(final-of(binding-sym(b)))

# The name a kept `export … from` binds: its re-export's symbol.
fn reexport-local(spec: Node) -> Text = final-of(an.reexport-sym(here, match spec {
  ExportAs(...) | ExportName(...) => an.export-spec-names(spec)
  _ => m.module-name(spec)
}))

fn exported-spec?(spec: Node) -> Bool = spec is ExportAs(...) or spec is ExportName(...)

fn path-of(t: m.Module) -> Node = Str(quote-text(t.path))

# For a source map: each leaf's offset gains its module, as (module+1)<<32 | offset.
fn stamp-tree(n: Node, base: Int) -> Node = match n.lo {
  lo if lo > 0 and lo < 4294967296 => stamped with { lo: lo + base }
  _ => stamped
} where stamped = n with { kids: [stamp-tree(k, base) for k in n.kids] }

fn stamped(n: Node) -> Node = match emitting.sourcemap {
  true => stamp-tree(n, (here.id + 1) * 4294967296)
  false => n
}

fn param-of(s: Int) -> Node = Param(BindName(final-of(s)), None())

# `var require_x = __commonJS({ "path"(exports, module) { … } });`, leaving out parameters nothing
# uses, as esbuild does.
fn cjs-part() -> Node = match an.linking.compact {
  true => stmt`var $name = $wrap(($$params) => { $$kept });`
  false => stmt`var $name = $wrap({ $path($$params) { $$kept } });`
} where e = wrapper-param("exports"),
        mo = wrapper-param("module"),
        # Its statements that stay, after the wrapper's own part.
        kept = [stamped(rewritten(stmts[i])) for i in 0..len(stmts) if live?(ps[i + 1]) and in-this-chunk?(ps[i + 1])],
        stmts = body.tree.body.kids,
        ps = parts-of(here.id),
        name = final-of(an.require-sym(here)),
        wrap = helper-name(an.wrapper-helper("__commonJS")),
        path = Str(quote-text(m.shown-path(here.path))),
        # `eval` may read either.
        params = match sym.symbol-at(m.table, mo).uses > 0 or sym.scope-at(m.table, here.root).dynamic,
                       sym.symbol-at(m.table, e).uses > 0 {
          true, _ => [param-of(e), param-of(mo)]
          false, true => [param-of(e)]
          false, false => []
        }

fn plain-key?(s: Text) -> Bool = len(s) > 0 and host.name-start-byte?(s[0]) and (all c in s: host.name-byte?(c))

fn export-getter(name-id: Int, s: Int) -> Node = Prop(key, exp`() => $target`)
  where name = name-of(m.names, name-id),
        target = symbol-read(s),
        key = match name {
          _ if plain-key?(name) => PropName(name)
          _ => Str(quote-text(name))
        }

# `var x_exports = {}; __export(x_exports, { a: () => a, … });`, names sorted.
fn namespace-stmts() -> [Node] = [stmt`var $ns = {};`] ++ [stmt`$export_all($ns, { $$getters });` for g in [getters] if len(g) > 0]
  where ns = final-of(an.ns-sym(here)),
        getters = [export-getter(n, s) for n in sort n in [n for m.db.resolved(here.id, ?n, _) distinct n] by name-of(m.names, n)
                   if let some(s) = resolved-export(here.id, n)],
        export-all = helper-name("__export")

# A binding pattern says the same thing as an assignment target, in other nodes.
fn pattern-expr(t: Node) -> Node = match t {
  BindName(x) => Ident(x)
  ArrayPattern(List(slots...)) => ArrayLit(List([slot-expr(s) for s in slots]...))
  ObjectPattern(List(props...)) => ObjectLit(List([prop-expr(p) for p in props]...))
  _ => panic "unexpected binding pattern: {}", js.kind-name(t.kind)
}

fn element-expr(e: Node) -> Node = match e {
  BindElement(t, None()) => pattern-expr(t)
  BindElement(t, init) => Assignment(pattern-expr(t), AssignOp("="), init)
  _ => panic "unexpected pattern element: {}", js.kind-name(e.kind)
}

fn slot-expr(s: Node) -> Node = match s {
  PatHole() => Hole()
  PatRest(t) => ElemLast(Spread(pattern-expr(t)))
  PatItem(e) => Elem(element-expr(e))
  PatLast(e) => ElemLast(element-expr(e))
  _ => panic "unexpected array pattern slot: {}", js.kind-name(s.kind)
}

fn prop-expr(p: Node) -> Node = match p {
  PatPropRest(t) => SpreadProp(pattern-expr(t))
  PatProp(key, e) => Prop(key, element-expr(e))
  PatShort(BindName(x), None()) => Shorthand(Ident(x))
  PatShort(BindName(x), init) => CoverInit(Ident(x), init)
  _ => panic "unexpected object pattern property: {}", js.kind-name(p.kind)
}

# The names a pattern binds, as declarators, without entering its default values.
fn pattern-names(t: Node) -> [Node] = match t {
  BindName(x) => [Declarator(BindName(x), None())]
  ArrayPattern(List(slots...)) => [slot-names(s)... for s in slots]
  ObjectPattern(List(props...)) => [property-names(p)... for p in props]
  _ => panic "unexpected binding pattern: {}", js.kind-name(t.kind)
}

fn slot-names(s: Node) -> [Node] = match s {
  PatHole() => []
  PatRest(x) => pattern-names(x)
  PatItem(e) | PatLast(e) => pattern-names(e.target)
  _ => panic "unexpected array pattern slot: {}", js.kind-name(s.kind)
}

fn property-names(p: Node) -> [Node] = match p {
  PatPropRest(x) => pattern-names(x)
  PatProp(_, e) => pattern-names(e.target)
  PatShort(name, _) => pattern-names(name)
  _ => panic "unexpected object pattern property: {}", js.kind-name(p.kind)
}

fn function-decl?(n: Node) -> Bool = n is FuncDecl(...) | GenDecl(...) | AsyncFuncDecl(...) | AsyncGenDecl(...)

# `var a, b; function f() {} var init_x = __esm({ "path"() { a = 1; } });` A `var` statement inside
# an initialiser: its names hoist out and its values become assignments. Functions hoist whole.
fn wrapped-module(outputs: [Node]) -> [Node] =
  [VarDecl(List(hoisted...)) for h in [hoisted] if len(h) > 0] ++ [s for s in outputs if function-decl?(s)]
  ++ [match an.linking.compact {
        true => stmt`var $name = $wrap(() => { $$body });`
        false => stmt`var $name = $wrap({ $path() { $$body } });`
      }]
  where rest = [s for s in outputs if not function-decl?(s)],
        hoisted = [declared-names(d)... for VarDecl(List(ds...)) in rest for d in ds],
        body = [initializing(s)... for s in rest],
        name = final-of(an.init-sym(here)),
        wrap = helper-name(an.wrapper-helper("__esm")),
        path = Str(quote-text(m.shown-path(here.path)))

# A wrapped module's variables are declared outside it and set inside it.
fn declared-names(d: Node) -> [Node] = match d {
  Declarator(BindName(x), _) => [Declarator(BindName(x), None())]
  Declarator(target, _) => pattern-names(target)
  _ => panic "a declaration list holds declarators"
}

fn initializing(s: Node) -> [Node] = match s {
  VarDecl(List(ds...)) => [assigning(d)... for d in ds]
  _ => [s]
}

# `x = init;`, and `({ a, b } = init);` with the names hoisted, as esbuild does.
fn assigning(d: Node) -> [Node] = match d {
  Declarator(BindName(_), None()) => []
  Declarator(BindName(x), init) => [stmt`$x = $init;`]
  Declarator(target, init) => [ExprStmt(Assignment(pattern-expr(target), AssignOp("="), init))]
  _ => panic "a declaration list holds declarators"
}

# Every live statement, in module order. Namespace objects go right after the runtime: their
# getters are all functions, so this makes them safe to read from any module's top level.
fn in-this-chunk?(p: Int) -> Bool = match chunk-parts {
  some(parts) => p in parts
  none => true
}

fn any-part-here?(id: Int) -> Bool = any p in parts-of(id): in-this-chunk?(p)

# One module's statements, its namespace object's, and the imports it needs hoisted. Each module
# is emitted on its own: they read what linking and naming decided, and change nothing shared.
record Emitted { body: [Node], namespace: [Node] }

# What is emitted, or counted for names, at once: some of a module's parts. `first`: the unit that
# counts for the module as a whole, once.
record Unit { module: Int, parts: [Int], first: Bool }

const unit-parts: Int = 64

# Where statements go, in the order they run, as esbuild has it: a module after what it imports;
# and an import that runs code (a CommonJS module, an ES module's wrapper, an outside module) where
# it stands among the imports, before the code of a module imported after it. Modules come in the
# order the graph has them; only those imports move.
record Piece { module: Int, parts: [Int] }

# The units, in order, worked out once a build is linked: naming and emitting both go by them.
setting units: [Unit]

# The graph's walk again, with each import that runs code a node of its own among its module's
# imports: the walk's order is the order statements go in.
fn units-of-order() -> [Unit] = with module-keys = ["m:" ++ int-text(i) for i in 0..len(m.modules)] { units-walked() }

# Each module's name as a node of that walk, by its id: made once, so every edge to a module names
# it by the one text.
setting module-keys: [Text]

fn units-walked() -> [Unit] = [piece-units(pc, first)... for i in 0..len(pieces) for pc in [pieces[i]]
                               for first in [(last-piece[pc.module] ?? -1) == i]]
  where w = depth-first([module-keys[0]] ++ [module-keys[e] for e in m.entries], order-children),
        pieces = [pc for i in w.post for pc in piece-at(w.pre[i])],
        last-piece = {pieces[i].module: i for i in 0..len(pieces)}

fn order-children(key: Text) -> [Text] = match key {
  "m:" ++ id => module-children(m.modules[parse-int(id)])
  _ => []
}

# An import that runs code waits for the next module whose own code runs (a plain ES module), and
# goes just before it, as esbuild places it; one that no such module follows goes with its module.
# What CommonJS and wrapped modules add before then are definitions, which run nothing.
record Order { nodes: [Text], pending: [Text] }

fn module-children(mo: m.Module) -> [Text] = match split?(mo) {
  true => o.nodes ++ deps ++ o.pending where o = fold st = Order(nodes: [], pending: []) for p in imports-of(mo): import-children(st, mo, p)
  false => deps
} where deps = [module-keys[d] for d in mo.deps]

fn import-children(st: Order, mo: m.Module, p: Int) -> Order = match split?(t) {
  true => Order(nodes: st.nodes ++ st.pending ++ [key], pending: [])
  false => Order(nodes: st.nodes ++ [key], pending: st.pending ++ eager-node(mo, p))
} where t = m.modules[imported-module(mo, p)],
        key = module-keys[t.id]

fn eager-node(mo: m.Module, p: Int) -> [Text] =
  ["p:" ++ int-text(mo.id) ++ ":" ++ int-text(p) for t in [m.modules[imported-module(mo, p)]] if runs-code?(t)]

fn piece-at(key: Text) -> [Piece] = match key {
  "m:" ++ id => [Piece(module: mo.id, parts: own-parts(mo)) for mo in [m.modules[parse-int(id)]] if mo.kind != m.External]
  "p:" ++ id ++ ":" ++ part => [Piece(module: parse-int(id), parts: [parse-int(part)])]
  _ => []
}

# A plain ES module is cut at its imports that run code; its other parts go together.
fn split?(mo: m.Module) -> Bool = mo.kind == m.Esm and not an.wrapped?(mo)

fn own-parts(mo: m.Module) -> [Int] = match split?(mo) {
  true => [p for p in parts-of(mo.id) if not (p in early)]
    where early = {p: true for p in imports-of(mo) if runs-code?(m.modules[imported-module(mo, p)])}
  false => parts-of(mo.id)
}

fn imports-of(mo: m.Module) -> [Int] = [x.part for x in import-parts(mo.id)]

fn imported-module(mo: m.Module, p: Int) -> Int =
  (first x in import-parts(mo.id) if x.part == p: x.target) ?? panic "{}: part {} imports nothing", mo.path, p

# A module's parts that import, and the module each imports: what ordering the output needs of a
# module, kept by itself, so ordering never reads every module's body.
record ImportPart { part: Int, target: Int }

fn import-parts(id: Int) -> [ImportPart] = with here = m.modules[id], body = m.body-of(id) {
  [ImportPart(part: p, target: an.known-dep(here, from)) for p in parts-of(id) for from in import-from(an.stmt-in(body, here, p))]
}

fn import-from(s: Node) -> Node? = match s {
  Import(_, from) | ImportBare(from) | ExportFrom(_, from) | ExportAllAs(_, from) | ExportAll(from) => some(from)
  _ => none
}

# Whether importing this runs code at the import, rather than the module's own code coming before.
fn runs-code?(t: m.Module) -> Bool = an.held?(t) or (t.kind == m.Esm and an.wrapped?(t))

# A piece in units: a plain ES module's long run of parts cut, for emitting at once.
fn piece-units(pc: Piece, first: Bool) -> [Unit] = match m.modules[pc.module] {
  m.Module(kind: m.Esm, ...) as mo if not an.wrapped?(mo) and n > 2 * unit-parts =>
    [Unit(module: pc.module, parts: pc.parts[k * unit-parts..min(n, (k + 1) * unit-parts)], first: first and k == 0)
     for k in 0..(n + unit-parts - 1) / unit-parts]
  _ => [Unit(module: pc.module, parts: pc.parts, first: first)]
} where n = len(pc.parts)

# A unit's statements, and what it adds to the namespace objects: each made by itself, since a group
# holds one or the other.
fn unit-emitted(u: Unit) -> Emitted = Emitted(body: unit-body(u), namespace: unit-namespace(u))

fn unit-body(u: Unit) -> [Node] = match included?(u.module) and any-part-here?(u.module) {
  false => []
  true => with here = m.modules[u.module], body = m.body-of(u.module) { module-body(u) }
}

fn unit-namespace(u: Unit) -> [Node] = match included?(u.module) and any-part-here?(u.module) {
  false => []
  true => with here = m.modules[u.module], body = m.body-of(u.module) { module-namespace(u) }
}

# Each part in order, as what it adds to the body. An import statement cannot be inside the wrapper:
# it goes before it, where it still loads first.
fn module-body(u: Unit) -> [Node] = match here.kind {
  Cjs => [cjs-part()]
  _ if an.scheduled?(here) => scheduled-body(u)
  _ => match an.wrapped?(here) {
    true => [s for s in outputs if import-statement?(s)] ++ wrapped-module([s for s in outputs if not import-statement?(s)])
    false => outputs
  } where outputs = [s for p in u.parts if live?(p) and in-this-chunk?(p) for s in part-body(p)]
}

# Only the island's home defines the initializer. Other fragments are ordinary inert
# declarations, even when the packer happens to put them beside the initialization island.
fn scheduled-body(u: Unit) -> [Node] =
  match an.forwarded-init?(here) {
    true => [s for p in parts if not ev.static-import?(an.stmt-in(body, here, p)) for s in part-body(p)]
    false => [s for p in parts if not (p in initializer-parts) for s in part-body(p)]
  ++ [s for s in imports if import-statement?(s)]
  ++ (if init-part in parts then match an.asynchronous?(here) {
        true => async-module(import-parts, statements)
        false => wrapped-module([s for s in imports if not import-statement?(s)] ++ statements)
      } else [])
  }
  where parts = [p for p in u.parts if live?(p) and in-this-chunk?(p)],
        init-part = (an.linked.part-starts[here.id] ?? -2) + 1,
        import-parts = [p for p in parts if p in initializer-parts if ev.static-import?(an.stmt-in(body, here, p))],
        imports = [s for p in import-parts for s in part-body(p)],
        statements = [s for p in parts if p in initializer-parts if not ev.static-import?(an.stmt-in(body, here, p)) for s in part-body(p)]

# Callback locals are fresh relative to the emitted dependency code. Module-body bindings
# remain outside these callbacks, so dependency temporaries cannot shadow user bindings.
everywhere fn identifier-names(n: Node) -> [Text] = match n { Ident(x) | BindName(x) => [x] }

fn fresh-local(base: Text, used: {Text:Bool}) -> Text = if base in used then fresh-local(base ++ "_", used) else base

fn async-module(parts: [Int], statements: [Node]) -> [Node] =
  [VarDecl(List(hoisted...)) for h in [hoisted] if len(h) > 0]
  ++ [s for s in statements if function-decl?(s)]
  ++ [stmt`var $name = $wrap(($path) => { var $waits = []; $$dependencies; return $waits; }, $callback);`]
  where outputs = [s for p in parts for s in part-body(p) if not import-statement?(s)],
        used = {x: true for s in outputs for x in identifier-names(s)},
        path = fresh-local("__evaluation_path", used), waits = fresh-local("__evaluation_waits", used),
        hoisted = [declared-names(d)... for VarDecl(List(ds...)) in outputs ++ statements for d in ds],
        dependencies = [s for p in parts for s in async-dependency(p, path, waits)],
        body = [initializing(s)... for s in statements if not function-decl?(s)],
        callback = if an.own-await?(here) then exp`async () => { $$body }` else exp`() => { $$body }`,
        name = final-of(an.init-sym(here)), wrap = helper-name("__esmAsync")

fn async-dependency(p: Int, path: Text, waits: Text) -> [Node] = match imported-module(here, p) {
  id if an.asynchronous?(m.modules[id]) => [stmt`$waits.push($init($path));`] where init = final-of(an.init-sym(m.modules[id]))
  _ => [initializing(s)... for s in part-body(p) if not import-statement?(s)]
}

# What the module adds to the namespace objects: an ES module's own, made by its first part, when
# that part is this unit's and lives (see `an.synthetic`).
fn module-namespace(u: Unit) -> [Node] = match here.kind {
  Esm => [s for p in u.parts if p == first and live?(p) and in-this-chunk?(p) for s in namespace-stmts()]
    where first = an.linked.part-starts[here.id] ?? panic "{} has no parts", here.path
  _ => []
}

fn statements-of(o: Node) -> [Node] = match o {
  List(xs...) => xs
  _ => [o]
}

fn import-statement?(s: Node) -> Bool = s is Import(...) or s is ImportBare(...)

# A part's statements: none for the namespace object's part. A part may stand for several, as a list.
fn part-body(p: Int) -> [Node] = match an.stmt-in(body, here, p) {
  None() | Flag() => []
  s => [stamped(x) for some(o) in [part-output(s)] for x in statements-of(o)]
}



# The program, and the imports to hoist above it, each once.
record Emission { tree: Node }

# The output's statements in groups: the runtime's, then each piece's namespace objects, then each
# piece's statements, where a piece is a run of units of one module. Between groups the program has
# a `Flag()`, which prints as nothing and which nothing the optimiser does crosses: as esbuild, which
# never merges one file's statements with another's. Each group is made from its own units alone.
record Group { units: [Unit], namespace: Bool }

# Where each group's units are among the build's: from, up to, and which of the two it holds.
record Range { from: Int, to: Int, namespace: Bool }

fn ranges() -> [Range] =
  [Range(from: 0, to: runtime-units, namespace: false)]
  ++ [Range(from: ns[i], to: ns[i + 1], namespace: true) for i in 0..len(ns) - 1]
  ++ [Range(from: bodies[i], to: bodies[i + 1], namespace: false) for i in 0..len(bodies) - 1]
  where runtime-units = (last i in 0..len(units) if units[i].module == 0: i + 1) ?? 0,
        ns = piece-ends(0, len(units)),
        bodies = piece-ends(runtime-units, len(units))

# Where runs of units of one module start and end, from `from` up to `to`.
fn piece-ends(from: Int, to: Int) -> [Int] =
  [from] ++ [k for k in from + 1..to if units[k].module != units[k - 1].module] ++ [to]

fn groups() -> [Group] = [Group(units: units[r.from..r.to], namespace: r.namespace) for r in ranges()]

fn group-stmts(namespace: Bool, emitted: [Emitted]) -> [Node] = match namespace {
  true => [s for em in emitted for s in em.namespace]
  false => [s for em in emitted for s in em.body]
}

# A group's statements, made from its units' answers.
fn group-made(g: Group) -> [Node] = match g.namespace {
  true => [s for u in g.units for s in unit-namespace(u)]
  false => [s for u in g.units for s in unit-body(u)]
}

# Every live statement, in the units' order. The namespace objects go after the runtime's statements
# and before everything else.
fn program() -> Emission =
  Emission(tree: Program(None(), List([s for k in 0..len(made) if len(made[k]) > 0
                                       for s in [Flag() for x in [k] if any j in 0..k: len(made[j]) > 0] ++ made[k]]...)))
  where emitted = [unit-emitted(u) for u in units],
        made = [group-stmts(r.namespace, emitted[r.from..r.to]) for r in ranges()]
