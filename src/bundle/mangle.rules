# Identifier minification, after esbuild's minify renamer. Symbols in sibling scopes can share a
# name, so nested symbols get a "slot" by depth; top-level symbols each get their own. Slots are
# sorted by how often their symbols are used, and the commonest gets the shortest name, drawn from
# an alphabet ordered by character frequency.
rules bundle.mangle over bundle.js
use bundle.modules as m
use bundle.emit as e
use bundle.analysis as an
use bundle.naming as nm

# The symbols live code uses, once for each use, an import counted as what it resolves to.
everywhere fn uses-in(n: Node, b: m.Body, mo: m.Module) -> [Int] = match n {
  Ident(_) | BindName(_) => [e.target-of(s) if let some(s) = m.symbol-in(b, mo, n.lo)]
}

# The symbols kept JSX tags name, which only a JSX file has.
everywhere fn tags-in(n: Node, b: m.Body, mo: m.Module) -> [Int] = match n {
  JsxElement(Ident(_), ...) => [e.target-of(s) if let some(s) = m.symbol-in(b, mo, n.tag.lo)] ++ [tags-in(k, b, mo)... for k in n.kids]
}

fn jsx-file?(path: Text) -> Bool = m.loader-of(path) == "jsx" or m.loader-of(path) == "tsx"

# What one unit of live code uses: each symbol once for each use, which name kept JSX tags, how
# often each byte, and the top-level symbols its parts declare outside a dynamic scope (whose names
# are kept), in order. Units are counted at once; the sums do not depend on the order they are
# added in.
record Usage { used: [Int], tags: [Int], freq: [Int], toplevel: [Int] }

fn unit-usage(u: e.Unit) -> Usage = match nm.included?(u.module) {
  false => Usage(used: [], tags: [], freq: [], toplevel: [])
  true => Usage(used: [x for p in live for x in uses-in(an.stmt-in(b, mo, p), b, mo)],
                tags: match jsx-file?(mo.path) {
                  true => [x for p in live for x in tags-in(an.stmt-in(b, mo, p), b, mo)]
                  false => []
                },
                freq: match u.first {
                  true => byte-counts(b.text)
                  false => []
                },
                toplevel: [s for p in live for m.db.declares(p, ?s) if not nm.import-symbol?(s) and not in-dynamic-scope?(s)])
} where mo = m.modules[u.module],
        b = m.body-of(u.module),
        live = [p for p in u.parts if nm.live?(p)]

fn in-dynamic-scope?(s: Int) -> Bool = sym.scope-at(m.table, sym.symbol-at(m.table, s).scope).dynamic

# How often each byte, over some units: summed a run of units at a time, each run at once.
fn bytes-of(usages: [Usage]) -> [Int] = [sum u in usages if len(u.freq) > 0: u.freq[c] for c in 0..256]

const usage-run: Int = 256

# A symbol's slot.
record Slotted { symbol: Int, at: Int }

# Nested symbols: each scope's symbols take slots from `from` on, and its children from where they
# stopped, so siblings share.
fn nested-slots(scope: Int, from: Int) -> [Slotted] = own ++ [nested-slots(child, from + len(own))... for child in now.children]
  where now = sym.scope-at(m.table, scope),
        own = [Slotted(symbol: now.symbols[i], at: from + i) for i in 0..len(now.symbols) if not now.dynamic]

# A module's nested symbols: CommonJS is inside its wrapper's scope.
fn module-slots(id: Int) -> [Slotted] = match m.modules[id].kind {
  m.Cjs => nested-slots(root.parent, 0)
  _ => [nested-slots(child, 0)... for child in root.children]
} where root = sym.scope-at(m.table, m.modules[id].root)

# Name characters, commonest first, so frequent symbols compress well.
fn sorted-chars(candidates: Text, freq: [Int]) -> [Int] = sort c in [c for c in candidates] by freq[c] desc

# The `index`th name: a first character, then characters of `tail`, as digits from the lowest.
fn minified-name(head: [Int], tail: [Int], index: Int) -> Text =
  byte-text(head[index % len(head)]) ++ name-rest(tail, index / len(head))

fn name-rest(tail: [Int], i: Int) -> Text = match i {
  0 => ""
  _ => byte-text(tail[(i - 1) % len(tail)]) ++ name-rest(tail, (i - 1) / len(tail))
}

# The alphabets: what a name starts with, what follows, and the capitals a JSX tag's starts with.
record Alphabets { head: [Int], tail: [Int], capitals: [Int] }

# Which names are given, which of each alphabet comes next, and each slot's.
record Slotting { given: {Text:Bool}, plain: Int, capital: Int, names: {Int:Text} }

# Each slot's name, the commonest slot first: the next name of its alphabet that nothing has. A slot
# holding a kept JSX tag's symbol gets a capital, or `<Foo/>` would become an element called `a`.
fn slot-names(order: [Int], capital: {Int:Bool}, abc: Alphabets, reserved: {Text:Int}) -> {Int:Text} =
  (fold st = Slotting(given: {}, plain: 0, capital: 0, names: {}) for at in order:
     (st with { given: st.given ++ {name: true}, names: st.names ++ {at: name},
                plain: match caps { true => st.plain  false => i + 1 },
                capital: match caps { true => i + 1  false => st.capital } }
      where caps = at in capital,
            alphabet = match caps { true => abc.capitals  false => abc.head },
            from = match caps { true => st.capital  false => st.plain },
            i = first j in from.. if not (minified-name(alphabet, abc.tail, j) in reserved or minified-name(alphabet, abc.tail, j) in st.given): j,
            name = minified-name(alphabet, abc.tail, i))).names

# Every symbol's minified name: live code counted for uses and character frequency, nested slots
# first, so top-level symbols never collide with them, each slotted symbol named by the last slot it
# took; a dynamic scope's keep theirs.
fn minified-names(threads: Int) -> [Text] =
  nm.named-table([nm.Named(symbol: x.symbol, name: names[x.at] ?? panic "a slot with no name") for x in slotted])
  where usages = parallel-map(e.units, unit-usage, threads),
        uses = histogram(sym.symbol-count(m.table), [s for u in usages for s in u.used]),
        tagged = {s: true for u in usages for s in u.tags},
        runs = parallel-map([usages[k * usage-run..min(len(usages), (k + 1) * usage-run)] for k in 0..(len(usages) + usage-run - 1) / usage-run],
                            bytes-of, threads),
        freq = [sum r in runs: r[c] for c in 0..256],
        nested = [x for found in parallel-map([id for id in m.order if nm.included?(id)], module-slots, threads) for x in found],
        first-top = fold top = 0 for x in nested: max(top, x.at + 1),
        toplevel = [s for u in usages for s in u.toplevel],
        slotted = nested ++ [Slotted(symbol: toplevel[i], at: first-top + i) for i in 0..len(toplevel)],
        slots = first-top + len(toplevel),
        counts = histogram(slots, [x.at for x in slotted], [uses[x.symbol] for x in slotted]),
        capital = {x.at: true for x in slotted if x.symbol in tagged},
        abc = Alphabets(head: sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$", freq),
                        tail: sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789", freq),
                        capitals: sorted-chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ", freq)),
        # Slot numbers, by descending use; ties keep slot order.
        order = sort i in [i for i in 0..slots] by counts[i] desc,
        names = slot-names(order, capital, abc, nm.reserved(nm.runtime-globals))
