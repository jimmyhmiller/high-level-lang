# Identifier minification. A nested scope's symbols are named as Terser names them: each scope's,
# in the order it declares them, take the first names of the alphabet that no symbol it encloses
# (one of a scope around it that code in it refers to) has. So every function's parameters are
# `e`, `t`, `n`… again unless it reads one of the same names from outside, which gzip compresses
# far better than names that run on from the scope around. Top-level symbols, each the commonest
# first, take the names no nested scope took, so a nested name never hides one, wherever a function
# is written in (bundle.inline). Names are drawn from an alphabet ordered by character frequency.
rules bundle.mangle over bundle.js
use bundle.modules as m
use bundle.emit as e
use bundle.analysis as an
use bundle.naming as nm

# The symbols live code uses, once for each use, an import counted as what it resolves to.
everywhere fn uses-in(n: Node, b: m.Body, mo: m.Module) -> [Int] = match n {
  Ident(_) | BindName(_) => [e.target-of(s) if let some(s) = m.symbol-in(b, mo, n.lo)]
}

# The symbols kept JSX tags name, which only a JSX file has.
everywhere fn tags-in(n: Node, b: m.Body, mo: m.Module) -> [Int] = match n {
  JsxElement(Ident(_), ...) => [e.target-of(s) if let some(s) = m.symbol-in(b, mo, n.tag.lo)] ++ [tags-in(k, b, mo)... for k in n.kids]
}

fn jsx-file?(path: Text) -> Bool = m.loader-of(path) == "jsx" or m.loader-of(path) == "tsx"

# What one unit of live code uses: each symbol once for each use, which name kept JSX tags, how
# often each byte, and the top-level symbols its parts declare outside a dynamic scope (whose names
# are kept), in order. Units are counted at once; the sums do not depend on the order they are
# added in.
record Usage { used: [Int], tags: [Int], freq: [Int], toplevel: [Int] }

fn unit-usage(u: e.Unit) -> Usage = match nm.included?(u.module) {
  false => Usage(used: [], tags: [], freq: [], toplevel: [])
  true => Usage(used: [x for p in live for x in uses-in(an.stmt-in(b, mo, p), b, mo)],
                tags: match jsx-file?(mo.path) {
                  true => [x for p in live for x in tags-in(an.stmt-in(b, mo, p), b, mo)]
                  false => []
                },
                freq: match u.first {
                  true => byte-counts(b.text)
                  false => []
                },
                toplevel: [s for p in live for m.db.declares(p, ?s) if not nm.import-symbol?(s) and not in-dynamic-scope?(s)])
} where mo = m.modules[u.module],
        b = m.body-of(u.module),
        live = [p for p in u.parts if nm.live?(p)]

fn in-dynamic-scope?(s: Int) -> Bool = sym.scope-at(m.table, sym.symbol-at(m.table, s).scope).dynamic

# What naming nested scopes reads of the whole program: the alphabets, the names nothing may take,
# and the symbols kept JSX tags name, which need a capital.
setting alphabet: Alphabets
setting kept: {Text:Int}
setting tagged: {Int:Bool}

# A scope's symbols named, and every scope's inside it. `outer`: the names of the symbols of the
# scopes around it, by symbol. A dynamic scope keeps its names.
fn scope-named(scope: Int, outer: {Int:Text}) -> [nm.Named] =
  own ++ [scope-named(child, inner)... for child in now.children]
  where now = sym.scope-at(m.table, scope),
        own = match now.dynamic {
          true => [nm.Named(symbol: x, name: sym.symbol-at(m.table, x).name) for x in now.symbols]
          false => own-named(now.symbols, {name: true for e in now.enclosed for name in enclosed-name(e, outer)})
        },
        inner = outer ++ {x.symbol: x.name for x in own}

# What a symbol a scope encloses is called where it is read: a name given a scope around it, or the
# name a dynamic scope keeps. A top-level symbol's name is none a nested scope gives.
fn enclosed-name(e: Int, outer: {Int:Text}) -> Text? = match outer[e] {
  some(n) => some(n)
  none => match sym.scope-at(m.table, sym.symbol-at(m.table, e).scope).dynamic {
    true => some(sym.symbol-at(m.table, e).name)
    false => none
  }
}

# A scope's symbols, in order, each the next name of its alphabet that is not taken: kept, or the
# name of a symbol the scope encloses. A kept JSX tag's symbol takes a capital.
fn own-named(symbols: [Int], taken: {Text:Bool}) -> [nm.Named] =
  (fold st = Naming(named: [], plain: 0, capital: 0) for x in symbols:
     (st with { named: st.named ++ [nm.Named(symbol: x, name: name)],
                plain: if caps then st.plain else i + 1,
                capital: if caps then i + 1 else st.capital }
      where caps = x in tagged,
            letters = if caps then alphabet.capitals else alphabet.head,
            i = first j in (if caps then st.capital else st.plain).. if free-name?(minified-name(letters, alphabet.tail, j), taken): j,
            name = minified-name(letters, alphabet.tail, i))).named

record Naming { named: [nm.Named], plain: Int, capital: Int }

fn free-name?(name: Text, taken: {Text:Bool}) -> Bool = not (name in kept) and not (name in taken)

# A module's nested symbols named: CommonJS's start with its wrapper's own scope.
fn module-nested(id: Int) -> [nm.Named] = match m.modules[id].kind {
  m.Cjs => scope-named(root.parent, {})
  _ => [scope-named(child, {})... for child in root.children]
} where root = sym.scope-at(m.table, m.modules[id].root)

# Name characters, commonest first, so frequent symbols compress well.
fn sorted-chars(candidates: Text, freq: [Int]) -> [Int] = sort c in [c for c in candidates] by freq[c] desc

# The `index`th name: a first character, then characters of `tail`, as digits from the lowest.
fn minified-name(head: [Int], tail: [Int], index: Int) -> Text =
  byte-text(head[index % len(head)]) ++ name-rest(tail, index / len(head))

fn name-rest(tail: [Int], i: Int) -> Text = match i {
  0 => ""
  _ => byte-text(tail[(i - 1) % len(tail)]) ++ name-rest(tail, (i - 1) / len(tail))
}

# The alphabets: what a name starts with, what follows, and the capitals a JSX tag's starts with.
record Alphabets { head: [Int], tail: [Int], capitals: [Int] }

# Top-level symbols named, the commonest first: the next name of its alphabet that is neither kept
# nor any nested scope's. A kept JSX tag's symbol takes a capital, or `<Foo/>` would become an
# element called `a`.
fn top-named(order: [Int], caps: {Int:Bool}, abc: Alphabets, taken: {Text:Bool}, reserved: {Text:Int}) -> [nm.Named] =
  (fold st = Naming(named: [], plain: 0, capital: 0) for x in order:
     (st with { named: st.named ++ [nm.Named(symbol: x, name: name)],
                plain: if capital then st.plain else i + 1,
                capital: if capital then i + 1 else st.capital }
      where capital = x in caps,
            letters = if capital then abc.capitals else abc.head,
            i = first j in (if capital then st.capital else st.plain)..
                  if not (minified-name(letters, abc.tail, j) in reserved) and not (minified-name(letters, abc.tail, j) in taken): j,
            name = minified-name(letters, abc.tail, i))).named

# Every symbol's minified name: live code counted for uses and character frequency; nested scopes
# named module by module, and top-level symbols then from what they left; a dynamic scope's keep
# theirs.
fn minified-names() -> [Text] = nm.named-table(nested ++ top)
  where usages = [unit-usage(u) for u in e.units],
        uses = histogram(sym.symbol-count(m.table), [s for u in usages for s in u.used]),
        caps = {s: true for u in usages for s in u.tags},
        freq = summed-lists([byte-counts("")] ++ [u.freq for u in usages]),
        abc = Alphabets(head: sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$", freq),
                        tail: sorted-chars("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789", freq),
                        capitals: sorted-chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ", freq)),
        reserved = nm.reserved(nm.runtime-globals),
        nested = with alphabet = abc, kept = reserved, tagged = caps {
          [x for found in [module-nested(id) for id in m.order if nm.included?(id)] for x in found]
        },
        taken = {x.name: true for x in nested},
        toplevel = [s for u in usages for s in u.toplevel],
        # By descending use; ties keep declaration order.
        order = sort i in [i for i in 0..len(toplevel)] by uses[toplevel[i]] desc,
        top = top-named([toplevel[i] for i in order], caps, abc, taken, reserved)
