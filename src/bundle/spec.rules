# What a build spec (`.bundler`, the grammar `spec.syntax`) means: each target's settings folded
# into the options `api.build` takes. A spec is data. The steps it names (rewrites, hooks) are code,
# so a program offers them to it by name, and a name it does not offer is an error in the spec.
rules bundle.spec over bundle.spec-file
use bundle.spec-file as sf
use bundle.api as api
use bundle.js as js
use bundle.literal as lit
use bundle.minhost as host
use bundle.boundaries as boundaries
use bundle.chunking as chunking
use bundle.fragments as fragments

# The steps a program lets its spec name.
record Steps {
  passes: {Text:Fn(js.Node)->js.Node},
  resolvers: {Text:Fn(Text,Text)->Text?},
  loaders: {Text:Fn(Text)->Text?},
  chunkers: {Text:Fn([fragments.Unit],chunking.Limits)->[chunking.Group]}
}

# The spec being read, for its errors.
setting path: Text
setting source: Text
# What `transform` and `optimize` name for the target being built, in order.
setting transforms: [Fn(js.Node)->js.Node]
setting optimizes: [Fn(js.Node)->js.Node]

# Every target a spec describes, built, and their files written.
fn build-all(text: Text, file: Text, steps: Steps) -> Void =
  with path = file, source = text { api.published(files(sf.parse(text, file), steps)) }

fn files(spec: Node, steps: Steps) -> [api.Written] = [files-of(t, formats, steps)... for t in spec.targets.kids]
  where formats = {"iife": api.iife-format(), "esm": api.esm-format(), "cjs": api.cjs-format()}
                  ++ {d.name.text: format-of(d) for d in spec.formats.kids}

fn files-of(t: Node, formats: {Text:api.Format}, steps: Steps) -> [api.Written] =
  with transforms = [pass(steps, w) for Transform(ws) in t.settings.kids for w in ws.kids],
       optimizes = [pass(steps, w) for Optimize(ws) in t.settings.kids for w in ws.kids] {
    target-files(t, checked(t, settled))
  }
  where settled = fold o = initial-options(t) for s in t.settings.kids: applied(o, s, formats, steps)

# Paired entries default to Node before explicit target settings are folded in, so a caller's
# conditions/main-fields still override those defaults in the ordinary way.
fn initial-options(t: Node) -> api.Options = match any s in t.settings.kids: s is ClientOutfile(_) {
  true => api.on-node(api.options-new("", ""))
  false => api.options-new("", "")
}

# One target can describe a coordinated server build and the browser entries it discovers.
fn target-files(t: Node, o: api.Options) -> [api.Written] = match client, manifest {
  none, none => api.files(o)
  none, some(p) => fail(t.name, "client-manifest needs client-outfile")
  some(""), _ => fail(t.name, "client-outfile must not be empty")
  _, some("") => fail(t.name, "client-manifest must not be empty")
  some(path), _ => boundaries.files(paired-options(t, o), path, manifest ?? path ++ ".manifest.json")
} where client = last ClientOutfile(p) in t.settings.kids: text(p),
        manifest = last ClientManifest(p) in t.settings.kids: text(p)

fn paired-options(t: Node, o: api.Options) -> api.Options = match format, platform {
  some(f), _ if f != "cjs" => fail(t.name, "paired builds emit cjs on the server and esm in the browser; omit format or use cjs")
  _, some(p) if p != "node" => fail(t.name, "a paired target runs its entry on platform node")
  _, _ => o
} where format = last Format(n) in t.settings.kids: n.text,
        platform = last Platform(n) in t.settings.kids: n.text

# A target must say where it starts and what it writes.
fn checked(t: Node, o: api.Options) -> api.Options = match o.entry, o.splitting, o.outfile, o.outdir {
  "", _, _, _ => fail(t.name, "target " ++ t.name.text ++ " has no entry")
  _, true, _, "" => fail(t.name, "code splitting needs outdir")
  _, false, "", _ => fail(t.name, "target " ++ t.name.text ++ " has no outfile")
  _, _, _, _ => o
}

fn applied(o: api.Options, s: Node, formats: {Text:api.Format}, steps: Steps) -> api.Options = match s {
  Entry(p) => o with { entry: text(p), entries: [text(p)] }
  Entries(ps) => o with { entry: text(ps.kids[0]), entries: [text(p) for p in ps.kids] }
  Outdir(p) => o with { outdir: text(p) }
  PublicPath(path) => o with { public-path: unquote(path.text) }
  Analyze(p) => o with { analyze: text(p) }
  Ledger() => o with { ledger: true }
  Lint(p) => o with { lints: o.lints ++ [text(p)] }
  Rewrite(p) => o with { rewrites: o.rewrites ++ [text(p)] }
  Splitting() => o with { splitting: true }
  Fragments(Name("on")) => o with { chunking: o.chunking with { fragments: true } }
  Fragments(Name("off")) => o with { chunking: o.chunking with { fragments: false } }
  Fragments(n) => fail(n, "fragments is on or off")
  ChunkPolicy(n) => o with { chunking: chosen-chunker(o.chunking, n, steps) }
  ChunkMinSize(n) => o with { chunking: o.chunking with { limits: o.chunking.limits with { min-size: parse-int(n.text) } } }
  ChunkMaxSize(n) => o with { chunking: o.chunking with { limits: o.chunking.limits with { max-size: parse-int(n.text) } } }
  ChunkMaxRequests(n) => o with { chunking: o.chunking with { limits: o.chunking.limits with { max-requests: parse-int(n.text) } } }
  ChunkRequestCost(n) => o with { chunking: o.chunking with { limits: o.chunking.limits with { request-cost: parse-int(n.text) } } }
  Outfile(p) => o with { outfile: text(p) }
  ClientOutfile(_) | ClientManifest(_) => o
  Format(f) => o with { format: formats[f.text] ?? fail(f, "no format named " ++ f.text ++ "; define one with `format … end`") }
  Global(g) => o with { global-name: text(g) }
  Define(key, value) => api.with-define(o, key.text, value.text)
  MainFields(ws) => o with { main-fields: words(ws) }
  Conditions(ws) => o with { conditions: some(words(ws)) }
  Minify(List()) => o with { minify-identifiers: true, minify-syntax: true }
  Minify(ws) => fold p = o for w in ws.kids: minified(p, w)
  Pretty() => o with { pretty: true }
  Sourcemap() => o with { sourcemap: true }
  Platform(Name("node")) => api.on-node(o)
  Platform(Name("browser")) => o
  Platform(n) => fail(n, "the platform is browser or node")
  External(ws) => o with { external: o.external ++ words(ws) }
  Alias(from, to) => api.with-alias(o, text(from), text(to))
  Loader(e, Name(k)) if k in api.loader-kinds => api.with-loader(o, text(e), k)
  Loader(_, k) => fail(k, "the loader is " ++ join(api.loader-kinds, ", "))
  Banner(b) => o with { banner: text(b) }
  Footer(f) => o with { footer: text(f) }
  TreeShaking(Name("on")) => o
  TreeShaking(Name("off")) => o with { tree-shaking: false }
  TreeShaking(n) => fail(n, "tree-shaking is on or off")
  Jsx(r) => api.with-jsx(o, o.jsx with { runtime: api.jsx-runtime(r.text) ?? fail(r, "jsx is transform, automatic or preserve") })
  JsxFactory(x) => api.with-jsx-factory(o, text(x))
  JsxFragment(x) => api.with-jsx-fragment(o, text(x))
  JsxImportSource(x) => api.with-jsx-import-source(o, text(x))
  JsxDev() => api.with-jsx-dev(o)
  SyntaxTarget(y) => o with { target: api.target-year(y.text) ?? fail(y, "the language is esnext, es6 or a year such as es2017") }
  OnResolve(ws) => o with { on-resolve: o.on-resolve ++ [steps.resolvers[w.text] ?? unoffered(w, "resolve hook", keys(steps.resolvers)) for w in ws.kids] }
  OnLoad(ws) => o with { on-load: o.on-load ++ [steps.loaders[w.text] ?? unoffered(w, "load hook", keys(steps.loaders)) for w in ws.kids] }
  Transform(_) => o with { has-transform: true, transform: transformed }
  Optimize(_) => o with { has-optimize: true, optimize: optimized }
}

fn chosen-chunker(o: chunking.Options, n: Node, steps: Steps) -> chunking.Options = match steps.chunkers[n.text] {
  some(pack) => o with { name: "custom:" ++ n.text, pack: pack }
  none => o with { name: n.text, pack: chunking.policies()[n.text] ?? fail(n, "no chunk policy named " ++ n.text) }
}

fn minified(o: api.Options, w: Node) -> api.Options = match w.text {
  "identifiers" => o with { minify-identifiers: true }
  "syntax" => o with { minify-syntax: true }
  _ => fail(w, "minify takes identifiers and syntax, or nothing for both")
}

fn format-of(d: Node) -> api.Format = fold f = blank for p in d.parts.kids: format-part(f, p)
  where blank = api.Format(prefix: "", suffix: "", exports: "", export-names: false, es-module: false, native-require: false)

fn format-part(f: api.Format, p: Node) -> api.Format = match p {
  Prefix(t) => f with { prefix: text(t) }
  Suffix(t) => f with { suffix: text(t) }
  ExportsVia(t) => f with { exports: text(t) }
  ExportsNames() => f with { export-names: true }
  EsModule() => f with { es-module: true }
  NativeRequire() => f with { native-require: true }
}

# The steps the target names, in order: what its `transform` and `optimize` run.
fn transformed(n: js.Node) -> js.Node = fold t = n for f in transforms: f(t)
fn optimized(n: js.Node) -> js.Node = fold t = n for f in optimizes: f(t)

fn pass(steps: Steps, w: Node) -> Fn(js.Node)->js.Node = steps.passes[w.text] ?? unoffered(w, "pass", keys(steps.passes))

fn unoffered(w: Node, what: Text, offered: [Text]) -> Never =
  fail(w, "no " ++ what ++ " named " ++ w.text ++ "; the program offers " ++ join(offered, ", "))

fn words(ws: Node) -> [Text] = [w.text for w in ws.kids]

# A string's value: its escapes resolved, as JavaScript reads them.
fn text(s: Node) -> Text = join([piece-text(s, p) for p in host.pieces(unquote(s.text))], "")

fn piece-text(s: Node, p: lit.Node) -> Text = match p {
  lit.Plain(t) => t
  lit.EscOther("\\n") => "\n"
  lit.EscOther("\\t") => "\t"
  lit.EscOther("\\r") => "\r"
  lit.EscOther(e) => e[1..len(e)]
  lit.EscHex(t) => text-of-points([digits-number(t[2..4], 16, 256) ?? 0])
  lit.EscUni(t) => text-of-points([digits-number(t[2..6], 16, 65536) ?? 0])
  lit.EscBrace(t) => text-of-points([digits-number(t[3..len(t) - 1], 16, 1114112) ?? 0])
  _ => fail(s, "a spec's strings have no octal escapes: " ++ p.text)
}

fn fail(at: Node, message: Text) -> Never =
  panic "{}:{}:{}: {}", path, line-of(source, at.lo), col-of(source, at.lo), message
