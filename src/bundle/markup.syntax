# An HTML page as its tags and what lies between them: enough to find the scripts and stylesheets a
# page loads and change those in place, every other byte as it was. A script's or a style's body is
# text up to its end tag, as the HTML tokenizer has it; tag and attribute names are any case.
syntax
start Page
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
fragment Script = [sS] [cC] [rR] [iI] [pP] [tT] ;
fragment Style = [sS] [tT] [yY] [lL] [eE] ;
token Comment = "<!--" (!"-->" .)* "-->" ;
token Doctype = "<!" [^>]* ">" ;
token Gap = [ \t\n\r\f]+ ;
token ScriptOpen = "<" Script ;
token ScriptClose = "</" Script [ \t\n\r\f]* ">" ;
token ScriptBody = (!("</" Script) .)+ ;
token StyleOpen = "<" Style ;
token StyleClose = "</" Style [ \t\n\r\f]* ">" ;
token StyleBody = (!("</" Style) .)+ ;
token TagOpen = "<" [a-zA-Z] [a-zA-Z0-9\-:]* ;
token EndTag = "</" [a-zA-Z] [a-zA-Z0-9\-:]* [ \t\n\r\f]* ">" ;
token AttrName = [^ \t\n\r\f/>="'<]+ ;
token Quoted = "\"" [^"]* "\"" | "'" [^']* "'" ;
token Bare = [^ \t\n\r\f>"'=<`]+ ;
token Text = [^<]+ ;
token Lone = "<" ;

rule Page = Piece* -> Page(pieces) ;
rule Piece
  = Comment | Doctype
  | ScriptOpen Attr* Gap? "/"? ">" ScriptBody? ScriptClose -> Script(open, attrs, gap, slash, body, close)
  | StyleOpen Attr* Gap? ">" StyleBody? StyleClose -> Style(open, attrs, gap, body, close)
  | TagOpen Attr* Gap? "/"? ">" -> Open(tag, attrs, gap, slash)
  | EndTag
  | Text
  | Lone
  ;
rule Attr = Gap AttrName AttrValue? -> Attr(gap, name, value) ;
rule AttrValue = Gap? "=" Gap? AttrText -> Value(before, after, text) ;
rule AttrText = Quoted | Bare ;
