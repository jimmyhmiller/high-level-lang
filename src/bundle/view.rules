# The analysis as one page (`--analyze=DIR` writes DIR/index.html): HTML made from templates over the
# report's records, with no script. Beside everything, a sidebar of the routes and of every package's
# modules. What a route loads is a treemap, laid out here (`squarified`): packages, then their
# directories, then modules, each as large as its bytes. The route shown is the one the address names
# (CSS `:target`), the first when none is. A module opens its drawer over the side of the page (HTML's
# `popover`), which says why it is in the build, and leaves the route where it is; a module named in a
# drawer opens its own over it. Labels show where they fit (CSS container queries).
rules bundle.view over bundle.html
use bundle.html as h
use bundle.analyze as a
use bundle.paths as paths
quote html at 1 0 ;

# What every view reads: the analysis, each package's class (`k0`, `k1`…, which give it its hue),
# and the directory the program's own modules share, which their labels leave out.
record Ctx { r: a.Analysis, classes: {Text:Text}, prefix: Text }

fn page(r: a.Analysis) -> Text = "<!doctype html>\n" ++ h.render(document, false) ++ "\n"
  where keys = package-keys(r),
        c = Ctx(r: r, classes: {keys[i]: "k" ++ int-text(i) for i in 0..len(keys)}, prefix: common-dir([m.path for m in r.modules if m.package == "" and m.kind != "runtime"])),
        style = join(css ++ tab-css(r) ++ [".k" ++ int-text(i) ++ " { --h: " ++ int-text(hue-of(keys, i)) ++ "; }" for i in 0..len(keys)], "\n"),
        tabs = [route-tab(r, i) for i in 0..len(r.roots)],
        siderows = [side-route(r, i) for i in 0..len(r.roots)],
        total = max(1, sum m in r.modules: module-bytes(m)),
        about = text(int-text(len(r.modules)) ++ " modules, " ++ size(total)),
        tree = [tree-package(c, k) for k in keys if any m in r.modules: package-key(m) == k],
        routes = [route-section(c, i) for i in 0..len(r.roots)],
        db = paths-of(r),
        modules = [module-section(c, db, i) for i in 0..len(r.modules)],
        document = html`<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Bundle analysis</title>
<style>$style</style>
</head>
<body>
<header><span class="brand">Bundle analysis</span><nav class="tabs">$$tabs</nav></header>
<div class="app">
<nav class="side">
<h4>Routes</h4>
<div>$$siderows</div>
<h4><span>Modules</span> <i>$about</i></h4>
<div class="tree">$$tree</div>
</nav>
<main>$$routes</main>
</div>
<div>$$modules</div>
</body>
</html>`

fn route-tab(r: a.Analysis, i: Int) -> h.Node = html`<a class="tab" href=$href><b>$name</b> <i>$bytes</i></a>`
  where href = attr("#r" ++ int-text(i)), name = text(path-base(r.roots[i].path)), bytes = text(size(r.roots[i].bytes))

fn side-route(r: a.Analysis, i: Int) -> h.Node = html`<a class="sroute" href=$href><b>$name</b><i>$bytes</i></a>`
  where href = attr("#r" ++ int-text(i)), name = text(path-base(r.roots[i].path)), bytes = text(size(r.roots[i].bytes))

# The tab and the sidebar's line of the route shown stand out: the route named, or the first when none is.
fn tab-css(r: a.Analysis) -> [Text] =
  ["body:has(#r" ++ int-text(i) ++ ":target) :is(.tab, .sroute)[href=\"#r" ++ int-text(i) ++ "\"] { " ++ active ++ " }" for i in 0..len(r.roots)]
  ++ ["body:not(:has(.route:target)) :is(.tab, .sroute)[href=\"#r0\"] { " ++ active ++ " }"]
  where active = "color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); background: var(--panel);"

# ---------------------------------------------------------------- packages

# A module's package, or the program's own code, or the bundler's runtime.
fn package-key(m: a.ModuleReport) -> Text = match m.package, m.kind {
  "", "runtime" => "(runtime)"
  "", _ => "(app)"
  p, _ => p
}

fn package-label(key: Text) -> Text = match key {
  "(app)" => "your code"
  "(runtime)" => "bundler runtime"
  k => k
}

# The packages, the largest first, then the program's own code and the runtime: each its hue, the
# same on every route; the program's own code is blue.
fn package-keys(r: a.Analysis) -> [Text] =
  (sort k in [package-key(m) for m in r.modules if m.package != "" distinct package-key(m)] by 0 - package-bytes(r, k)) ++ ["(app)", "(runtime)"]

const palette: [Int] = [24, 150, 272, 338, 52, 182, 0, 96, 304, 124, 248, 70]

fn hue-of(keys: [Text], i: Int) -> Int = match keys[i] {
  "(app)" => 212
  "(runtime)" => 60
  _ => palette[i % len(palette)]
}

fn class-of(c: Ctx, key: Text) -> Text = c.classes[key] ?? panic "no class for the package {}", key

fn package-bytes(r: a.Analysis, key: Text) -> Int = sum m in [m for m in r.modules if package-key(m) == key]: module-bytes(m)

fn module-bytes(m: a.ModuleReport) -> Int = sum w in m.outputs: w.bytes

# Where a module sits in its package, or in the program's own code.
fn dir-in(c: Ctx, m: a.ModuleReport) -> Text = match m.package {
  "" => trimmed-dir(dir-of(m.path)[min(len(c.prefix), len(dir-of(m.path)))..len(dir-of(m.path))])
  p => match last-index-of(m.path, marker) {
    some(at) => trimmed-dir(dir-of(m.path[at + len(marker)..len(m.path)]))
    none => trimmed-dir(dir-of(m.path))
  } where marker = "node_modules/" ++ p ++ "/"
}

fn trimmed-dir(d: Text) -> Text = match d {
  "." | "/" => ""
  "/" ++ rest => rest
  _ => d
}

# The directory every path is in, with its `/`.
fn common-dir(paths: [Text]) -> Text = match len(paths) {
  0 => ""
  _ => join(segments[0..shared], "/") ++ (if shared > 0 then "/" else "")
} where segments = split(dir-of(paths[0]), "/"),
        shared = (first k in 0..len(segments) if not (all p in paths: starts-with(p, join(segments[0..k + 1], "/") ++ "/")): k) ?? len(segments)

# A module by its file's name, or with its directory's when the name says little (`index.js`).
fn short-name(path: Text) -> Text = match path-stem(path) {
  "index" => path-base(dir-of(path)) ++ "/" ++ path-base(path)
  _ => path-base(path)
}

# ---------------------------------------------------------------- the treemap

# A box of the map: a group (a package or a directory), a module, or the bytes between files.
record Tile { kind: Text, label: Text, tip: Text, bytes: Int, module: Int, pk: Text, shade: Int, kids: [Tile] }

fn route-tiles(c: Ctx, root: a.RootReport) -> [Tile] = sorted-tiles([package-tile(c, root, k) for k in keys] ++ glue)
  where keys = [package-key(c.r.modules[x.module]) for x in root.modules distinct package-key(c.r.modules[x.module])],
        between = sum o in root.loads: c.r.outputs[o].own,
        glue = [Tile(kind: "glue", label: "between files", tip: "imports, exports and the like the bundler writes between files · " ++ size(between),
                     bytes: between, module: -1, pk: "", shade: 0, kids: [])]

fn package-tile(c: Ctx, root: a.RootReport, key: Text) -> Tile =
  Tile(kind: "group", label: package-label(key), tip: package-label(key) ++ " · " ++ size(total), bytes: total, module: -1, pk: pk, shade: 0,
       kids: match len(dirs) {
         1 => module-tiles(c, members, pk, 0)
         _ => sorted-tiles([dir-tile(c, members, dirs[i], pk, i % 2) for i in 0..len(dirs)])
       })
  where members = [x for x in root.modules if package-key(c.r.modules[x.module]) == key],
        total = sum x in members: x.bytes,
        pk = class-of(c, key),
        dirs = [dir-in(c, c.r.modules[x.module]) for x in members if x.bytes > 0 distinct dir-in(c, c.r.modules[x.module])]

fn dir-tile(c: Ctx, members: [a.Held], dir: Text, pk: Text, shade: Int) -> Tile =
  Tile(kind: "group", label: label, tip: label ++ " · " ++ size(total), bytes: total, module: -1, pk: pk, shade: shade,
       kids: module-tiles(c, mine, pk, shade))
  where mine = [x for x in members if dir-in(c, c.r.modules[x.module]) == dir],
        total = sum x in mine: x.bytes,
        label = if dir == "" then "./" else dir ++ "/"

fn module-tiles(c: Ctx, members: [a.Held], pk: Text, shade: Int) -> [Tile] =
  sorted-tiles([Tile(kind: "module", label: short-name(m.path), tip: m.path ++ " · " ++ size(x.bytes), bytes: x.bytes, module: x.module,
                     pk: pk, shade: shade, kids: []) for x in members for m in [c.r.modules[x.module]]])

fn sorted-tiles(tiles: [Tile]) -> [Tile] = sort t in [t for t in tiles if t.bytes > 0] by 0 - t.bytes

# Tiles in a box `w` by `h`, in units as long one way as the other: each, and its own tiles inside it
# in a box of its shape, its longer side `units`.
fn treemap(tiles: [Tile], w: Int, h: Int) -> [h.Node] = [tile-node(tiles[i], rects[i], w, h) for i in 0..len(tiles)]
  where rects = squarified([t.bytes for t in tiles], w, h)

fn tile-node(t: Tile, b: Rect, w: Int, h: Int) -> h.Node = match t.kind {
  "group" => html`<div class=$gcls style=$look title=$tip><div class="gl"><b>$name</b> <i>$bytes</i></div><div class="gb">$$kids</div></div>`
  "glue" => html`<div class="t glue" style=$look title=$tip><span class="lb"><b>$name</b> <i>$bytes</i></span></div>`
  _ => html`<button class=$cls popovertarget=$target style=$look title=$tip><span class="lb"><b>$name</b> <i>$bytes</i></span></button>`
} where look = attr(position(b, w, h)),
        gcls = attr("g " ++ t.pk),
        tip = attr(t.tip), name = text(t.label), bytes = text(size(t.bytes)),
        cls = attr("t " ++ t.pk ++ (if t.shade == 1 then " alt" else "")),
        target = attr("m" ++ int-text(t.module)),
        longer = max(1, max(b.w, b.h)),
        kids = treemap(t.kids, max(1, b.w * units / longer), max(1, b.h * units / longer))

fn position(b: Rect, w: Int, h: Int) -> Text =
  "left:" ++ pct(b.x, w) ++ ";top:" ++ pct(b.y, h) ++ ";width:" ++ pct(b.w, w) ++ ";height:" ++ pct(b.h, h)

fn pct(v: Int, total: Int) -> Text = int-text(t / 100) ++ "." ++ int-text(t / 10 % 10) ++ int-text(t % 10) ++ "%"
  where t = v * 10000 / max(1, total)

# ---------------------------------------------------------------- squarified layout

# Boxes for sizes, the largest first, filling `w` by `h`, as near square as rows let them be (Bruls,
# Huizing and van Wijk): each row along the shorter side takes boxes while that makes its worst box
# no worse, and the rest fill what is left.
record Rect { x: Int, y: Int, w: Int, h: Int }

# A box's longer side, in the units its tiles are laid out in: a hundredth of a percent.
const units: Int = 10000

fn squarified(sizes: [Int], w: Int, h: Int) -> [Rect] = laid([s * w * h / total for s in sizes], Rect(x: 0, y: 0, w: w, h: h))
  where total = max(1, sum s in sizes: s)

fn laid(areas: [Int], b: Rect) -> [Rect] = match len(areas) {
  0 => []
  _ => placed(areas[0..n], b, across) ++ laid(areas[n..len(areas)], rest)
} where tall = b.h > b.w,
        side = max(1, if tall then b.w else b.h),
        n = row-count(areas, side),
        s = sum a in areas[0..n]: a,
        # How thick the row is, to the nearest unit: the last takes all that is left.
        across = if n == len(areas) then (if tall then b.h else b.w) else (s + side / 2) / side,
        rest = if tall then Rect(x: b.x, y: b.y + across, w: b.w, h: b.h - across) else Rect(x: b.x + across, y: b.y, w: b.w - across, h: b.h)

fn row-count(areas: [Int], side: Int) -> Int =
  (first k in 1..len(areas) if worst(areas, k + 1, side) > worst(areas, k, side): k) ?? len(areas)

# How far from square the first `k` boxes are, laid in a row along `side`: in hundredths. Areas are
# at most `units` squared over 2, so no product passes 2^63.
fn worst(areas: [Int], k: Int, side: Int) -> Int = max(side * side * areas[0] * 100 / max(1, s * s), s * s * 100 / max(1, side * side * areas[k - 1]))
  where s = max(1, sum a in areas[0..k]: a)

fn placed(row: [Int], b: Rect, across: Int) -> [Rect] = [cell(b, across, starts[i], starts[i + 1]) for i in 0..len(row)]
  where tall = b.h > b.w,
        length = if tall then b.w else b.h,
        s = max(1, sum a in row: a),
        starts = [0] ++ [(t * length + s / 2) / s for t in scan t = 0 for a in row: t + a]

fn cell(b: Rect, across: Int, from: Int, to: Int) -> Rect = match b.h > b.w {
  true => Rect(x: b.x + from, y: b.y, w: to - from, h: across)
  false => Rect(x: b.x, y: b.y + from, w: across, h: to - from)
}

# ---------------------------------------------------------------- routes

fn route-section(c: Ctx, i: Int) -> h.Node = html`<section class="route" id=$id>
<div class="title"><h2>$name</h2><span class="badge">$kind</span></div>
<p class="path">$path</p>
<div class="cards">$$cards</div>
<div class="map">$$tiles</div>
<p class="hint">Each box is a module, as large as its bytes in what this route loads, grouped by package and then by directory. Select one to see why it is here.</p>
<div class="cols">
<div class="panel"><h3>Packages</h3><div class="rows">$$packages</div></div>
<div class="panel"><h3>Files it loads</h3><div class="rows">$$files</div></div>
</div>
</section>`
  where root = c.r.roots[i],
        id = attr("r" ++ int-text(i)),
        name = text(path-base(root.path)),
        kind = text(if root.kind == "entry" then "entry" else "loaded by import()"),
        path = text(root.path),
        tiles-all = route-tiles(c, root),
        tiles = treemap(tiles-all, units, units / 2),
        largest = [t for t in tiles-all if t.kind == "group"],
        alone = sum o in [o for o in root.loads if (count x in c.r.roots: o in x.loads) == 1]: c.r.outputs[o].bytes,
        cards = [card("Loads", size(root.bytes), "before it runs, " ++ size(alone) ++ " of it in files no other route loads"),
                 card("Files", int-text(len(root.loads)), int-text(count o in root.loads: (count x in c.r.roots: o in x.loads) > 1) ++ " shared with other routes"),
                 card("Modules", int-text(len(root.modules)), "from " ++ int-text(count t in largest: t.label != "your code" and t.label != "bundler runtime") ++ " packages")]
                ++ [card("Largest", t.label, size(t.bytes) ++ " · " ++ share(t.bytes, root.bytes)) for t in largest[0..min(1, len(largest))]],
        packages = [package-row(c, root, t) for t in largest],
        top = max(1, (first t in largest: t.bytes) ?? 1),
        biggest-file = max(1, fold b = 1 for o in root.loads: max(b, c.r.outputs[o].bytes)),
        files = [file-row(c, o, biggest-file) for o in sort o in root.loads by 0 - c.r.outputs[o].bytes]

fn card(label: Text, value: Text, note: Text) -> h.Node = html`<p><i>$k</i><b>$v</b><small>$n</small></p>`
  where k = text(label), v = text(value), n = text(note)

fn share(part: Int, whole: Int) -> Text = int-text(part * 100 / max(1, whole)) ++ "% of it"

fn package-row(c: Ctx, root: a.RootReport, t: Tile) -> h.Node = html`<details class=$cls><summary><span class="sw"></span><span class="nm">$name</span><span class="bar"><span style=$fill></span></span><span class="n">$bytes</span><span class="n muted">$part</span></summary><div class="sub">$$modules</div></details>`
  where cls = attr("row " ++ t.pk),
        name = text(t.label),
        fill = attr("width:" ++ pct(t.bytes, root.bytes)),
        bytes = text(size(t.bytes)),
        part = text(int-text(t.bytes * 100 / max(1, root.bytes)) ++ "%"),
        members = sort x in [x for x in root.modules if package-label(package-key(c.r.modules[x.module])) == t.label] by 0 - x.bytes,
        modules = [module-row(c, x.module, x.bytes) for x in members]

fn module-row(c: Ctx, i: Int, bytes: Int) -> h.Node = html`<div class="mrow"><span>$link</span><span class="dim">$place</span><span class="n">$amount</span></div>`
  where link = module-link(c, i), place = text(dir-in(c, c.r.modules[i])), amount = text(size(bytes))

fn file-row(c: Ctx, o: Int, biggest: Int) -> h.Node = html`<div class="frow"><span class="nm">$name</span><span class="tag">$tag</span><span class="bar"><span style=$fill></span></span><span class="n">$bytes</span></div>`
  where file = c.r.outputs[o],
        name = text(path-base(file.path)),
        routes = count x in c.r.roots: o in x.loads,
        tag = text(match routes {
          1 => "this route only"
          n => "shared by " ++ int-text(n) ++ " routes"
        }),
        fill = attr("width:" ++ pct(file.bytes, biggest)),
        bytes = text(size(file.bytes))

# ---------------------------------------------------------------- modules

fn module-section(c: Ctx, db: paths.Db, i: Int) -> h.Node = html`<aside class="drawer" popover="auto" id=$id>
<div class="dhead"><nav class="crumbs"><span>$package</span><span>$dir</span></nav><button class="x" popovertarget=$id popovertargetaction="hide" title="Close">×</button></div>
<div class="title"><h2>$name</h2><span class="badge">$kind</span></div>
<p class="path">$path</p>
<div class="cards">$$cards</div>
<div>$note</div>
<div class="cols">
<div class="panel"><h3>What keeps it: who reads what, from each route</h3><div>$$reasons</div></div>
<div class="panel"><h3>Read by, and what</h3><div>$$users</div></div>
</div>
<div class="cols">
<div class="panel"><h3>How each route imports it</h3><div>$$chains</div></div>
<div class="panel"><h3>Kept for what it does as it loads</h3><div>$$effects</div></div>
</div>
<div class="panel"><h3>It imports</h3><div class="chips">$$imports</div></div>
</aside>`
  where m = c.r.modules[i],
        id = attr("m" ++ int-text(i)),
        package = text(package-label(package-key(m))),
        dir = text(dir-in(c, m)),
        name = text(short-name(m.path)),
        kind = text(m.kind),
        path = text(m.path),
        chained = chains-of(c, db, i),
        reasoned = reasons-of(c, db, i),
        routes = len([ch.root for ch in chained distinct ch.root]),
        written = sum w in m.outputs: w.written,
        cards = [card("In the output", size(module-bytes(m)), int-text(len(m.outputs)) ++ (if len(m.outputs) == 1 then " file" else " files")
                      ++ (if written > 0 then " · " ++ size(written) ++ " written by the bundler" else "")),
                 card("Source", size(m.source), m.kind),
                 card("Statements kept", int-text(m.kept) ++ " of " ++ int-text(m.statements), share(m.kept, m.statements)),
                 card("Loaded by", int-text(routes) ++ " of " ++ int-text(len(c.r.roots)), if len(c.r.roots) == 1 then "route" else "routes")],
        note = module-note(c, i),
        chains = or-none([chain-node(c, [x for x in chained if chain-key(x) == k]) for k in [chain-key(x) for x in chained distinct chain-key(x)]]),
        reasons = or-none([reason-node(c, i, [x for x in reasoned if reason-key(x) == k]) for k in [reason-key(x) for x in reasoned distinct reason-key(x)]]),
        users = or-none([user-node(c, u) for u in m.used-by]),
        effects = match m.kind {
          "commonjs" => [html`<p class="muted">All of it: CommonJS runs whole, in its wrapper, when it is first required.</p>`]
          _ => or-none([effect-node(k) for k in m.kept-for[0..min(shown-effects, len(m.kept-for))]]
                       ++ [more-node(len(m.kept-for) - shown-effects) for x in [0] if len(m.kept-for) > shown-effects])
        },
        imports = or-none([module-link(c, d) for d in m.imports])

# What is unusual about a module: it holds no code and only passes names on, or nothing it declares
# is read and it is here for what it does as it loads.
fn module-note(c: Ctx, i: Int) -> h.Node = match module-bytes(m) == 0, len(m.used-by) == 0 and len(m.kept-for) > 0 and not root {
  true, _ => html`<div class="note"><p>It holds no code of its own in the output. It passes these names on to the code that reads them through it:</p><div class="names">$$names</div></div>`
    where names = [code-node(x) for x in m.passes]
  false, true => html`<p class="note">Nothing it declares is read: it is in the output only for what the statements below do as it loads.</p>`
  false, false => html`<span></span>`
} where m = c.r.modules[i], root = any x in c.r.roots: x.module == i

# Chains alike but for their route are one, its first step the routes.
fn chain-key(ch: Chain) -> Text = join([int-text(m) for m in ch.modules[min(1, len(ch.modules))..len(ch.modules)]], " ")

fn chain-node(c: Ctx, alike: [Chain]) -> h.Node = html`<ol class="chain"><li class="roots">$$roots</li>$$steps</ol>`
  where ch = alike[0],
        roots = [module-link(c, x.modules[0]) for x in alike if len(x.modules) > 0],
        steps = [chain-step(c, m) for m in ch.modules[min(1, len(ch.modules))..len(ch.modules)]]

fn chain-step(c: Ctx, m: Int) -> h.Node = html`<li>$link</li>` where link = module-link(c, m)

# From the route, each module and what it reads from the next, to this one. Reasons alike but for
# their route are one, its first step the routes.
fn reason-key(x: Reason) -> Text = join([int-text(h.module) ++ ":" ++ h.name for h in x.hops[min(1, len(x.hops))..len(x.hops)]], " ")
  ++ " " ++ ((first h in x.hops: h.name) ?? "")

fn reason-node(c: Ctx, i: Int, alike: [Reason]) -> h.Node = html`<ol class="chain"><li class="roots">$$roots<span class="rd">$first</span></li>$$steps</ol>`
  where x = alike[0],
        roots = [module-link(c, y.hops[0].module) for y in alike if len(y.hops) > 0],
        first = text(read-label((first h in x.hops: h.name) ?? "")),
        steps = [hop-node(c, hop) for hop in x.hops[min(1, len(x.hops))..len(x.hops)]] ++ [chain-step(c, i)]

fn hop-node(c: Ctx, hop: Hop) -> h.Node = html`<li>$link<span class="rd">$name</span></li>`
  where link = module-link(c, hop.module), name = text(read-label(hop.name))

fn read-label(name: Text) -> Text = match name {
  "*" => "reads it all, as a namespace"
  "()" => "runs it"
  n => "reads " ++ n
}

fn user-node(c: Ctx, u: a.UsedBy) -> h.Node = html`<div class="user"><div>$link</div><div class="names">$$names</div></div>`
  where link = module-link(c, u.module), names = [code-node(x) for x in u.names]

fn code-node(t: Text) -> h.Node = html`<code>$x</code>` where x = text(match t {
  "*" => "* (the whole namespace)"
  "()" => "() (runs it)"
  _ => t
})

# The statements a module's section shows; analysis.json has them all.
const shown-effects: Int = 12

fn more-node(n: Int) -> h.Node = html`<p class="muted">$x</p>` where x = text("and " ++ int-text(n) ++ " more, in analysis.json")

fn effect-node(k: a.KeptFor) -> h.Node = html`<pre class="stmt"><span class="ln">$line</span>$code</pre>`
  where line = text(int-text(k.line)), code = text(k.text)

fn module-link(c: Ctx, i: Int) -> h.Node = html`<button class=$cls popovertarget=$target>$name</button>`
  where m = c.r.modules[i],
        target = attr("m" ++ int-text(i)),
        cls = attr("mod " ++ class-of(c, package-key(m))),
        name = text(short-name(m.path))

fn or-none(items: [h.Node]) -> [h.Node] = match len(items) {
  0 => [html`<p class="muted">none</p>`]
  _ => items
}

# ---------------------------------------------------------------- how routes reach modules

# How a route reaches a module: the modules from the root to it, each importing the next.
record Chain { root: Int, modules: [Int] }
# What keeps a module: from a root, each module that reads, and the name it reads from the next (`*`:
# the next's whole namespace object; `()`: what runs it), the last read being of the module itself.
record Hop { module: Int, name: Text }
record Reason { root: Int, hops: [Hop] }

# The analysis's routes, imports and reads, solved (bundle.paths): made here, not by the build.
fn paths-of(r: a.Analysis) -> paths.Db = paths.solved(
  [paths.fact-root(x.module) for x in r.roots if x.module >= 0]
  ++ [paths.fact-imports(i, d) for i in 0..len(r.modules) for d in r.modules[i].imports]
  ++ [paths.fact-reads(i, u.module) for i in 0..len(r.modules) for u in r.modules[i].used-by])

fn route-modules(c: Ctx) -> [Int] = [x.module for x in c.r.roots if x.module >= 0 distinct x.module]

fn chains-of(c: Ctx, db: paths.Db, i: Int) -> [Chain] =
  [Chain(root: x, modules: [x] ++ reversed([w.b for w in paths.why-reached(db, x, i) if w.relation == "imports"]))
   for x in route-modules(c) if db.reached(x, i)]

fn reasons-of(c: Ctx, db: paths.Db, i: Int) -> [Reason] =
  [Reason(root: x, hops: [Hop(module: w.b, name: read-of(c, w.a, w.b)) for w in reversed([w for w in paths.why-needs(db, x, i) if w.relation == "reads"])])
   for x in route-modules(c) if x != i and db.needs(x, i)]

# What a module reads of another: the first name.
fn read-of(c: Ctx, module: Int, reader: Int) -> Text = (first u in c.r.modules[module].used-by if u.module == reader: (first n in u.names: n) ?? "") ?? ""

# ---------------------------------------------------------------- the sidebar's modules

fn tree-package(c: Ctx, key: Text) -> h.Node = html`<details class=$cls><summary><span class="sw"></span><span class="nm">$name</span><i>$bytes</i></summary><div>$$modules</div></details>`
  where cls = attr("pkg " ++ class-of(c, key)),
        name = text(package-label(key)),
        bytes = text(size(package-bytes(c.r, key))),
        members = sort i in [i for i in 0..len(c.r.modules) if package-key(c.r.modules[i]) == key] by 0 - module-bytes(c.r.modules[i]),
        modules = [tree-leaf(c, i) for i in members]

fn tree-leaf(c: Ctx, i: Int) -> h.Node = html`<button class="leaf" popovertarget=$target title=$tip><span>$name</span><i>$bytes</i></button>`
  where m = c.r.modules[i],
        target = attr("m" ++ int-text(i)),
        tip = attr(m.path),
        name = text(short-name(m.path)),
        bytes = text(size(module-bytes(m)))

# ---------------------------------------------------------------- text

# Text as HTML shows it, and an attribute's value, quoted.
fn text(t: Text) -> Text = replace-many(t, ["&", "<", ">"], ["&amp;", "&lt;", "&gt;"])
fn attr(t: Text) -> Text = "\"" ++ replace-many(t, ["&", "\""], ["&amp;", "&quot;"]) ++ "\""

fn size(bytes: Int) -> Text = match bytes {
  b if b >= 1048576 => int-text(b / 1048576) ++ "." ++ int-text(b * 100 / 1048576 % 100) ++ " MB"
  b if b >= 1024 => int-text(b / 1024) ++ "." ++ int-text(b * 10 / 1024 % 10) ++ " KB"
  b => int-text(b) ++ " B"
}

const css: [Text] = [
  ":root { --bg: #f6f6f4; --panel: #ffffff; --ink: #1c1c1a; --muted: #6d6c66; --line: #e3e2dd; --accent: #2f6fdb; --note: #fff3c4; --tile-s: 62%; --tile-l: 78%; --tile-alt: 71%; --head-l: 90%; color-scheme: light dark; }",
  "@media (prefers-color-scheme: dark) { :root { --bg: #141413; --panel: #1d1d1b; --ink: #ecebe6; --muted: #9a988f; --line: #33322e; --accent: #7aa7ff; --note: #4a3c0c; --tile-s: 48%; --tile-l: 33%; --tile-alt: 28%; --head-l: 19%; } }",
  "* { box-sizing: border-box; }",
  "body { margin: 0; background: var(--bg); color: var(--ink); font: 13px/1.45 ui-sans-serif, system-ui, -apple-system, sans-serif; }",
  "a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }",
  "header { position: sticky; top: 0; z-index: 10; display: flex; align-items: stretch; gap: 20px; padding: 0 20px; background: var(--bg); border-bottom: 1px solid var(--line); }",
  ".brand { font-weight: 650; align-self: center; white-space: nowrap; }",
  ".tabs { display: flex; gap: 2px; overflow-x: auto; }",
  ".tab { display: flex; gap: 6px; align-items: baseline; padding: 12px 12px 10px; color: var(--muted); white-space: nowrap; }",
  ".tab:hover { color: var(--ink); text-decoration: none; } .tab b { font-weight: 600; } .tab i { font-style: normal; font-size: 12px; font-variant-numeric: tabular-nums; }",
  "button { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; text-align: left; }",
  ".app { display: grid; grid-template-columns: 280px minmax(0, 1fr); align-items: start; }",
  ".side { position: sticky; top: 45px; height: calc(100vh - 45px); overflow: auto; border-right: 1px solid var(--line); padding: 14px 10px 24px; background: var(--bg); }",
  ".side h4 { display: flex; justify-content: space-between; align-items: baseline; margin: 6px 6px 6px; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }",
  ".side h4 i { font-style: normal; text-transform: none; letter-spacing: 0; } .side h4 + div { margin-bottom: 14px; }",
  ".sroute { display: flex; justify-content: space-between; gap: 8px; padding: 5px 8px; border-radius: 6px; color: var(--muted); }",
  ".sroute:hover { text-decoration: none; background: var(--panel); color: var(--ink); } .sroute b { font-weight: 550; } .sroute i, .pkg i, .leaf i { font-style: normal; font-size: 12px; font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }",
  ".pkg summary { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 4px 8px; border-radius: 6px; cursor: pointer; list-style: none; }",
  ".pkg summary::-webkit-details-marker { display: none; } .pkg summary:hover { background: var(--panel); }",
  ".pkg .sw { width: 10px; height: 10px; } .pkg[open] summary .nm { font-weight: 650; }",
  ".leaf { display: flex; justify-content: space-between; gap: 8px; width: 100%; padding: 2px 8px 2px 26px; border-radius: 5px; font-size: 12px; }",
  ".leaf span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .leaf:hover { background: hsl(var(--h) var(--tile-s) var(--head-l)); }",
  "main { padding: 20px 24px; min-width: 0; }",
  ".route { display: none; scroll-margin-top: 45px; }",
  "li.roots { display: inline-flex; flex-wrap: wrap; gap: 4px; align-items: center; }",
  ".route:target { display: block; }",
  "main:not(:has(:target)) .route:first-child { display: block; }",
  ".drawer { position: fixed; inset: 0 0 0 auto; width: min(560px, 100vw); height: 100vh; max-height: 100vh; margin: 0; padding: 16px 20px 32px; overflow: auto; border: 0; border-left: 1px solid var(--line); background: var(--bg); color: var(--ink); box-shadow: -12px 0 32px rgb(0 0 0 / .12); }",
  ".drawer::backdrop { background: transparent; }",
  ".drawer .cols { grid-template-columns: 1fr; gap: 12px; margin-bottom: 12px; } .drawer .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }",
  ".drawer > .panel { margin-bottom: 12px; }",
  ".dhead { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }",
  ".x { font-size: 20px; line-height: 1; padding: 2px 8px; border-radius: 6px; color: var(--muted); } .x:hover { background: var(--panel); color: var(--ink); }",
  ".title { display: flex; align-items: center; gap: 10px; } h2 { font-size: 20px; margin: 0; font-weight: 650; }",
  ".lede { margin: 2px 0 16px; color: var(--muted); }",
  ".badge { font-size: 11px; padding: 2px 8px; border-radius: 99px; background: var(--line); color: var(--muted); }",
  ".path { margin: 2px 0 16px; color: var(--muted); font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }",
  ".cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin-bottom: 16px; }",
  ".cards > p { display: flex; flex-direction: column; margin: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; min-width: 0; }",
  ".cards i { font-style: normal; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }",
  ".cards b { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }",
  ".cards small { font-size: 12px; color: var(--muted); }",
  ".map { position: relative; aspect-ratio: 2 / 1; background: var(--bg); border-radius: 8px; overflow: hidden; }",
  ".g, .t { position: absolute; container-type: size; border: 1px solid var(--bg); overflow: hidden; }",
  "button.t { display: block; text-align: left; }",
  ".g { background: hsl(var(--h) var(--tile-s) var(--head-l)); border-width: 2px; }",
  ".gl { height: 18px; padding: 1px 5px; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--ink); }",
  ".gl i, .lb i { font-style: normal; opacity: .7; font-variant-numeric: tabular-nums; }",
  ".gb { position: absolute; top: 18px; left: 0; right: 0; bottom: 0; }",
  "@container (max-height: 46px) or (max-width: 64px) { .gl { display: none; } .gb { top: 0; } }",
  ".t { display: block; background: hsl(var(--h) var(--tile-s) var(--tile-l)); color: var(--ink); text-decoration: none; }",
  ".t.alt { background: hsl(var(--h) var(--tile-s) var(--tile-alt)); }",
  ".t.glue { background: repeating-linear-gradient(45deg, var(--line), var(--line) 4px, var(--panel) 4px, var(--panel) 8px); }",
  "button.t:hover { text-decoration: none; filter: brightness(1.08) saturate(1.2); outline: 2px solid var(--ink); outline-offset: -2px; z-index: 2; }",
  ".lb { display: block; padding: 2px 5px; font-size: 11px; line-height: 1.3; overflow: hidden; }",
  ".lb b { display: block; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
  "@container (max-height: 30px) { .lb i { display: none; } }",
  "@container (max-height: 15px) or (max-width: 40px) { .lb { display: none; } }",
  "@container (min-height: 60px) and (min-width: 90px) { .lb { padding: 5px 7px; font-size: 12px; } }",
  ".hint { color: var(--muted); font-size: 12px; margin: 8px 0 20px; }",
  ".cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px; margin-bottom: 16px; }",
  ".panel { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; min-width: 0; }",
  "h3 { font-size: 13px; margin: 0 0 6px; font-weight: 650; } .panel > p.muted { margin: 0 0 10px; font-size: 12px; }",
  ".muted { color: var(--muted); }",
  ".row summary, .frow { display: grid; grid-template-columns: 12px minmax(0, 1.4fr) minmax(60px, 2fr) 72px 48px; gap: 10px; align-items: center; padding: 5px 0; border-bottom: 1px solid var(--line); }",
  ".frow { grid-template-columns: minmax(0, 1.4fr) 130px minmax(40px, 1fr) 72px; }",
  ".row summary { cursor: pointer; list-style: none; } .row summary::-webkit-details-marker { display: none; }",
  ".row[open] summary { border-bottom-color: transparent; }",
  ".sw { width: 12px; height: 12px; border-radius: 3px; background: hsl(var(--h) var(--tile-s) var(--tile-l)); }",
  ".nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 550; }",
  ".bar { height: 8px; background: var(--bg); border-radius: 4px; overflow: hidden; } .bar span { display: block; height: 100%; background: hsl(var(--h, 212) var(--tile-s) var(--tile-alt)); }",
  ".n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }",
  ".tag { font-size: 11px; color: var(--muted); white-space: nowrap; }",
  ".sub { padding: 2px 0 8px 22px; border-bottom: 1px solid var(--line); max-height: 320px; overflow: auto; }",
  ".mrow { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 72px; gap: 10px; padding: 2px 0; }",
  ".mrow > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .dim { color: var(--muted); font-size: 12px; }",
  ".crumbs { display: flex; gap: 6px; font-size: 12px; color: var(--muted); margin-bottom: 6px; } .crumbs > * + *::before { content: '›'; margin-right: 6px; }",
  ".crumbs span:empty { display: none; }",
  ".note { background: var(--note); padding: 8px 12px; border-radius: 8px; margin: 0 0 16px; } .note p { margin: 0 0 6px; } .note p:last-child { margin: 0; }",
  "ol.chain { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; list-style: none; padding: 0; margin: 0 0 10px; }",
  "ol.chain li + li::before { content: '→'; color: var(--muted); margin: 0 6px; }",
  ".rd { margin-left: 6px; font-size: 11px; color: var(--muted); font-style: italic; }",
  "button.mod { display: inline-block; padding: 1px 7px; border-radius: 5px; background: hsl(var(--h) var(--tile-s) var(--head-l)); color: var(--ink); font-size: 12px; }",
  "button.mod:hover { text-decoration: none; background: hsl(var(--h) var(--tile-s) var(--tile-l)); }",
  ".user { display: grid; grid-template-columns: minmax(120px, auto) 1fr; gap: 10px; padding: 4px 0; border-bottom: 1px solid var(--line); }",
  ".names { display: flex; flex-wrap: wrap; gap: 4px; } code { font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--bg); padding: 1px 5px; border-radius: 4px; }",
  ".chips { display: flex; flex-wrap: wrap; gap: 4px; }",
  "pre.stmt { margin: 0 0 4px; padding: 6px 8px; background: var(--bg); border-radius: 6px; white-space: pre-wrap; word-break: break-all; font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; }",
  ".ln { color: var(--muted); margin-right: 10px; user-select: none; }",
  "@media (max-width: 860px) { .app { grid-template-columns: 1fr; } .side { position: static; height: auto; max-height: 40vh; border-right: 0; border-bottom: 1px solid var(--line); } }",
  "@media (max-width: 640px) { header { gap: 10px; padding: 0 12px; } main { padding: 12px 16px; } .cols { grid-template-columns: 1fr; } }"
]
