# JSX becomes calls, before anything else looks at the program, so the rest of the bundler never
# meets it. Which call is the build's choice, or a pragma comment's.
attrs bundle.jsx over bundle.js
use bundle.js as js
use bundle.comments as cm
use bundle.minhost as host

enum Runtime { Classic, Automatic, Preserve }

record Options {
  runtime: Runtime,
  factory: Text,
  fragment: Text,
  import-source: Text,
  dev: Bool,
  side-effects: Bool,
  explicit: Bool        # the build said something about JSX, which a tsconfig.json then does not override
}

fn options-new() -> Options =
  Options(runtime: Classic, factory: "React.createElement", fragment: "React.Fragment",
          import-source: "react", dev: false, side-effects: false, explicit: false)

# What one file is being lowered under.
record Lowered { tree: Node, pure-calls: {Int:Int}, imports: Bool }
record Span { lo: Int, hi: Int }

input now: Options
input src: Text
input path: Text
# Calls that may go if nothing uses them.
collect pure: [Span]

# Each element and fragment becomes one call, which may go if nothing uses its value, unless the
# build says JSX has effects.
on JsxElement(...) | JsxFragment(...) as n if not now.side-effects { pure += Span(lo: n.lo, hi: n.hi) }


# ---------------------------------------------------------------- pragmas

fn word-end(s: Text, from: Int) -> Int = from + span-not-of(s, from, " \t\n\r*")

# The word after `@name` in a comment, if the comment has it.
fn pragma(comment: Text, name: Text) -> Text? =
  first i in occurrences(comment, ["@" ++ name]): pragma-value(comment, i + len(name) + 1)

# What follows a pragma's name: blanks, then a word.
fn pragma-value(comment: Text, after: Int) -> Text? =
  first w in [comment[from..word-end(comment, from)]] if from > after and w != "": w
  where from = after + span-of(comment, after, " \t")

fn runtime-named(s: Text, file: Text) -> Runtime = match s {
  "automatic" => Automatic
  "classic" => Classic
  other => panic "{}: @jsxRuntime is automatic or classic, not {}", file, other
}

# A file's comments may override the build, unless the build keeps JSX as it is.
fn with-pragmas(o: Options, source: Text, file: Text) -> Options = match source {
  _ if not contains-text?(source, "@jsx") => o
  _ => match cm.parse(source, "<comments>") {
    cm.Scan(List(parts...)) => fold out = o for cm.Comment(_) as p in parts: with-comment-pragmas(out, o, p.text, file)
  }
}

fn with-comment-pragmas(out: Options, o: Options, comment: Text, file: Text) -> Options =
  out with { factory: pragma(comment, "jsx") ?? out.factory,
             fragment: pragma(comment, "jsxFrag") ?? out.fragment,
             import-source: pragma(comment, "jsxImportSource") ?? out.import-source,
             runtime: match pragma(comment, "jsxRuntime") {
               some(v) if o.runtime != Preserve => runtime-named(v, file)
               _ => out.runtime
             } }

# ---------------------------------------------------------------- text

# Every entity HTML names, and its code point: `amp 38` to a line.
const entities: {Text:Int} =
  {text-before(line, " "): parse-int(text-after(line, " ")) for line in split(include-text("jsx_entities.txt"), "\n") if len(line) > 0}


# The value of `#38` or `#x26`, if it is one. Past 32 bits it is not.
fn entity-value(e: Text) -> Int? = match e {
  "#x" ++ digits if digits != "" => digits-number(digits, 16, 2147483647)
  "#" ++ digits => digits-number(digits, 10, 2147483647)
  _ => entities[e]
}

# `&amp;` and friends decoded. Anything that isn't one stays as written; no entity's name holds
# an `&`, so each starts after one.
fn entities-decoded(t: Text) -> Text = match split(t, "&") {
  [head, rest...] => head ++ join([after-ampersand(p) for p in rest], "")
}

fn after-ampersand(p: Text) -> Text = match p {
  name ++ ";" ++ rest if name != "" => (first v in entity-value(name): text-of-points([v]) ++ rest) ?? "&" ++ p
  _ => "&" ++ p
}

const other-spaces: [Int] = [11, 12, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200,
                             8201, 8202, 8239, 8287, 12288, 65279]

fn blank-point?(c: Int) -> Bool = c == 9 or c == 32 or c in other-spaces

# Text between tags, per JSX: lines are trimmed and joined by one space, and blank ones go. Text
# of one line stays as it is; the first line keeps the space it starts with, and the last the
# space it ends with.
fn child-text(raw: Text) -> Text = match jsx-lines(raw) {
  [_] => entities-decoded(raw)
  lines => join([entities-decoded(l) for i in 0..len(lines) for l in [line-shaped(lines, i)] if len(l) > 0], " ")
}

fn line-shaped(lines: [Text], i: Int) -> Text = match i {
  0 => trimmed-end(lines[i])
  _ if i == len(lines) - 1 => trimmed-start(lines[i])
  _ => trimmed-start(trimmed-end(lines[i]))
}

const line-separators: [Text] = [text-of-points([8232]), text-of-points([8233])]

fn jsx-lines(t: Text) -> [Text] =
  [d for a in split(t, "\r") for b in split(a, "\n") for c in split(b, line-separators[0]) for d in split(c, line-separators[1])]

fn trimmed-start(t: Text) -> Text = text-of-points(points[len([c for c in points while blank-point?(c)])..len(points)])
  where points = code-points-of(t)

fn trimmed-end(t: Text) -> Text = text-of-points(points[0..len(points) - len([c for c in reversed(points) while blank-point?(c)])])
  where points = code-points-of(t)

# A quoted attribute value keeps its line breaks.
fn attr-text(raw: Text) -> Text = entities-decoded(raw[1..len(raw) - 1])

# A source map should point at the text, not at the line break before it.
fn leading-space(raw: Text) -> Int = span-of(raw, 0, " \t\n\r")

fn string-at(text: Text, at: Node) -> Node = Str(host.js-string(text)) with { lo: at.lo, hi: at.hi }

# ---------------------------------------------------------------- names

# Scope analysis finds a name's symbol by offset, so each generated reference takes an offset no
# other reference has. A node has its own `<`, and the byte after it.
fn dotted(text: Text, lo: Int) -> Node = placed(js.parse(text ++ ";", "<jsx>").body.kids[0].expr, lo)

fn placed(n: Node, lo: Int) -> Node = match n.kids {
  [] => n with { lo: lo, hi: lo }
  kids => n with { lo: lo, hi: lo, kids: [placed(k, lo) for k in kids] }
}

# A name the source does not have in it anywhere, so it can be no one else's.
fn fresh-name(base: Text, source: Text) -> Text = unused(base, source) ?? first n in 1..: unused(base ++ "_" ++ int-text(n), source)

fn unused(name: Text, source: Text) -> Text? = first x in [name] if not contains-text?(source, x): x

# A name of the automatic runtime's, which its import binds.
fn imported-ref(name: Text, lo: Int) -> Node = Ident(fresh-name(name, src)) with { lo: lo, hi: lo }

fn runtime-module-of(o: Options) -> Text = o.import-source ++ match o.dev {
  true => "/jsx-dev-runtime"
  false => "/jsx-runtime"
}

# The runtime's names the calls use, as `from\nname`, in the order the calls are made: each piece's
# own pieces first, then a fragment's `Fragment`, then its call's own.
everywhere fn imports-made(n: Node, o: Options) -> [Text] = match n {
  JsxElement(_, props, rest) => [imports-made(k, o)... for k in n.kids] ++ [element-import(props.kids, children(rest), o)]
  JsxFragment(kids) =>
    [imports-made(k, o)... for k in n.kids] ++ [runtime-module-of(o) ++ "\nFragment", element-import([], kids.kids, o)]
}

# The name an element's call is: `createElement` when a key follows a spread, else the runtime's
# for one child, several, or a development build.
fn element-import(props: [Node], kids: [Node], o: Options) -> Text = match key-after-spread-attr?(props) {
  true => o.import-source ++ "\ncreateElement"
  false => runtime-module-of(o) ++ "\n" ++ match o.dev, many-children?(kids) {
    true, _ => "jsxDEV"
    false, true => "jsxs"
    false, false => "jsx"
  }
}

fn key-after-spread-attr?(props: [Node]) -> Bool =
  any i in 0..len(props): props[i] is JsxAttr(JsxName("key"), _) and (any j in 0..i: props[j] is JsxSpreadAttr(_))

# Whether children are more than one value, or one spread: blank text and an empty `{}` are none.
fn many-children?(kids: [Node]) -> Bool = match sum k in kids: child-values(k) {
  n if n > 1 => true
  1 => any k in kids: k is JsxSpreadChild(_)
  _ => false
}

fn child-values(k: Node) -> Int = match k {
  JsxText(raw) => match child-text(raw) {
    "" => 0
    _ => 1
  }
  JsxContainer(None()) => 0
  _ => 1
}


# `import { jsx } from "react/jsx-runtime"`, one statement per name, at the top of the file. A
# binding's offset identifies it too, and real offsets are not negative.
fn import-statements(keys: [Text], source: Text) -> [Node] = [import-statement(keys[i], -2 - i, source) for i in 0..len(keys)]

fn import-statement(key: Text, at: Int, source: Text) -> Node = match key {
  from ++ "\n" ++ name => Import(ImportNamed(List(ImportAs(PropName(name), BindName(fresh-name(name, source)) with { lo: at, hi: at }))),
                                Str(host.js-string(from)), None())
}

# In CommonJS the runtime is required instead, as esbuild has it: `var import_jsx_runtime =
# require("react/jsx-runtime");`, and each name the calls read, `(0, import_jsx_runtime.jsx)`.
record Read { holder: Text, name: Text }

fn runtime-required(tree: Node, source: Text) -> Node =
  Program(tree.hashbang, List(([required-holder(holders[modules[k]] ?? "", modules[k], k) for k in 0..len(modules)]
                                ++ [read-from(s, reads) for s in rest])...))
  where injected = [s for s in tree.body.kids while injected?(s)],
        rest = tree.body.kids[len(injected)..len(tree.body.kids)],
        modules = [imported-from(s) for s in injected distinct imported-from(s)],
        holders = {mo: fresh-name("import_" ++ holder-base(mo), source) for mo in modules},
        reads = {local-of(s): Read(holder: holders[imported-from(s)] ?? "", name: imported-name(s)) for s in injected}

# Names a leaf's offset identifies, so a made one has an offset no source leaf has: below the
# imports' own, -2 and down.
fn required-holder(holder: Text, mo: Text, k: Int) -> Node =
  VarDecl(List(Declarator(BindName(holder) with { lo: at, hi: at },
                          CallExpr(Ident("require") with { lo: at - 1, hi: at - 1 }, Args(List(Str(host.js-string(mo))))))))
  where at = -1000000 - 2 * k

everywhere fn read-from(n: Node, reads: {Text:Read}) -> Node = match n {
  # A call reads its function first, so it is called with no `this`.
  CallExpr(Ident(x) as callee, args) if x in reads =>
    CallExpr(Paren(Seq(Num("0"), held-read(callee, reads))) with { lo: callee.lo, hi: callee.hi }, read-from(args, reads)) with { lo: n.lo, hi: n.hi }
  Ident(x) if x in reads => held-read(n, reads)
}

fn held-read(n: Node, reads: {Text:Read}) -> Node = match reads[n.text] {
  some(r) => Member(Ident(r.holder) with { lo: n.lo, hi: n.hi }, PropName(r.name)) with { lo: n.lo, hi: n.hi }
  none => n
}

# An import this lowering made: its binding has no place in the source.
fn injected?(s: Node) -> Bool = match s {
  Import(ImportNamed(List(ImportAs(_, b))), _, _) => b.lo < 0
  _ => false
}

fn imported-from(s: Node) -> Text = unquote(s.from.text)
fn imported-name(s: Node) -> Text = s.clause.specs.kids[0].imported.text
fn local-of(s: Node) -> Text = s.clause.specs.kids[0].name.text

# `react/jsx-runtime` -> `jsx_runtime`, as esbuild names what holds it.
fn holder-base(mo: Text) -> Text = text-of-bytes([match c { '-' | '.' | '@' => '_'  _ => c } for c in last-segment])
  where last-segment = last(split(mo, "/"))

fn first-of-each(xs: [Text]) -> [Text] = [xs[i] for i in 0..len(xs) if not (any j in 0..i: xs[j] == xs[i])]

# ---------------------------------------------------------------- the calls

fn tag-value(tag: Node) -> Node = match tag {
  JsxTagText(t) => string-at(t, tag)
  JsxNs(a, b) => string-at(a.text ++ ":" ++ b.text, tag)
  _ => tag
}

fn key-of(name: Node) -> Node = match name {
  JsxName(t) if not has-byte?(t, '-') => PropName(t) with { lo: name.lo, hi: name.hi }
  JsxName(t) => string-at(t, name)
  JsxNs(a, b) => string-at(a.text ++ ":" ++ b.text, name)
}

fn call-of(callee: Node, args: [Node], at: Node) -> Node = CallExpr(callee, Args(List(args...))) with { lo: at.lo, hi: at.hi }

fn text-child(raw: Text, at: Node) -> [Node] = match child-text(raw) {
  "" => []
  t => [string-at(t, at) with { lo: at.lo + leading-space(raw) }]
}

fn classic(tag: Node, props: [Node], children: [Node], at: Node) -> Node =
  call-of(dotted(now.factory, at.lo), [tag, shown] ++ children, at)
  where shown = match props {
    [] => Null()
    _ => ObjectLit(List(props...))
  }

fn key-prop?(p: Node) -> Bool = p is Prop(PropName("key"), _)

# `<a {...b} key="c"/>` has to go through `createElement`: `b` may hold a key of its own, and
# which one wins depends on the order.
fn key-after-spread?(props: [Node]) -> Bool =
  any i in 0..len(props): key-prop?(props[i]) and (any j in 0..i: props[j] is SpreadProp(_))

fn spread-free?(xs: [Node]) -> Bool = all x in xs: not (x is Spread(_))

# The children as a `children` prop: one is itself, and several, or a spread, are an array.
fn children-prop(children: [Node], at: Node) -> [Node] = match children {
  [] => []
  [only] if spread-free?(children) => [children-of(only, at)]
  _ => [children-of(array-of(children), at)]
}

fn children-of(value: Node, at: Node) -> Node = Prop(PropName("children"), value) with { lo: at.lo, hi: at.hi }

fn array-of(xs: [Node]) -> Node = match xs {
  [init..., x] => ArrayLit(List(([Elem(y) for y in init] ++ [ElemLast(x)])...))
  [] => ArrayLit(List())
}

fn dev-source(at: Node) -> Node =
  ObjectLit(List(Prop(PropName("fileName"), Str(host.js-string(path))),
                 Prop(PropName("lineNumber"), Num(int-text(line-of(src, at.lo)))),
                 Prop(PropName("columnNumber"), Num(int-text(col-of(src, at.lo) + 1)))))

fn js-bool(b: Bool) -> Node = match b {
  true => True()
  false => False()
}

fn automatic(tag: Node, attrs: [Node], children: [Node], at: Node) -> Node = match attrs {
  _ if key-after-spread?(attrs) =>
    call-of(imported-ref("createElement", at.lo), [tag, ObjectLit(List(attrs...))] ++ children, at)
  _ if any v in keys: v is True() => panic "{}: `key` needs an explicit value", path
  _ => call-of(imported-ref(name, at.lo), [tag, whole] ++ key ++ dev, at)
} where keys = [v for Prop(PropName("key"), v) in attrs],
        many = len(children) > 1 or (len(children) == 1 and not spread-free?(children)),
        whole = ObjectLit(List(([a for a in attrs if not (a is Prop(PropName("key"), _))] ++ children-prop(children, at))...)),
        name = match now.dev, many {
          true, _ => "jsxDEV"
          false, true => "jsxs"
          false, false => "jsx"
        },
        key = match keys {
          [..., k] => [k]
          [] => []
        },
        dev = match now.dev, keys {
          false, _ => []
          true, [] => [Void(Num("0")), js-bool(many), dev-source(at), This()]
          true, _ => [js-bool(many), dev-source(at), This()]
        }

fn fragment-tag(at: Node) -> Node = match now.runtime {
  Automatic => imported-ref("Fragment", at.lo + 1)
  _ => dotted(now.fragment, at.lo + 1)
}

fn element(tag: Node, props: [Node], children: [Node], at: Node) -> Node = match now.runtime {
  Automatic => automatic(tag, props, children, at)
  _ => classic(tag, props, children, at)
}

# What each piece of JSX becomes, from what its pieces became: an element a call, an attribute a
# property, text a string, a `{…}` what it holds.
rewrite JsxFragment(kids) as n => element(fragment-tag(n), [], kids.out.kids, n)
rewrite JsxElement(tag, props, rest) as n => element(tag-value(tag), props.out.kids, children(rest.out), n)
rewrite JsxAttr(name, None()) as a => Prop(key-of(name), True()) with { lo: a.lo, hi: a.hi }
rewrite JsxAttr(name, v) as a => Prop(key-of(name), v.out) with { lo: a.lo, hi: a.hi }
rewrite JsxSpreadAttr(e) as a => SpreadProp(e.out) with { lo: a.lo, hi: a.hi }
rewrite JsxStr(raw) as v => string-at(attr-text(raw), v)
rewrite JsxValue(e) => e.out
rewrite JsxText(raw) as k => text-child(raw, k)
rewrite JsxContainer(None()) => []
rewrite JsxContainer(e) => e.out
rewrite JsxSpreadChild(e) as k => Spread(e.out) with { lo: k.lo, hi: k.hi }

fn children(rest: Node) -> [Node] = match rest {
  JsxClose(List(kids...), _) => kids
  _ => []
}

# A tree with no JSX left in it, and which of its calls may go if unused.
fn lower(tree: Node, source: Text, file: Text, o: Options) -> Lowered = match with-pragmas(o, source, file) {
  Options(runtime: Preserve, ...) => Lowered(tree: tree, pure-calls: {}, imports: false)
  now-options => lowered-with(run(tree, now-options, source, file), source, match now-options.runtime {
    Automatic => first-of-each(imports-made(tree, now-options))
    _ => []
  })
}

fn lowered-with(a: Attrs, source: Text, keys: [Text]) -> Lowered =
  Lowered(tree: Program(a.tree.hashbang, List(import-statements(keys, source) ++ a.tree.body.kids...)),
          pure-calls: {s.lo: s.hi for s in a.pure}, imports: len(keys) > 0)

# Names a kept `<div/>` will need once something else lowers it, so TypeScript must not take their
# imports for types.
fn kept-names(source: Text, file: Text, o: Options) -> [Text] = match with-pragmas(o, source, file) {
  Options(runtime: Preserve, factory: f, fragment: g, ...) => [text-before(f, "."), text-before(g, ".")]
  _ => []
}
