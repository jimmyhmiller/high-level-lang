# What a build does as Vite's does, for a project written for Vite: its assets (an image, a font, a
# medium a module or stylesheet names is a file the build writes, as Vite's assetsInclude has it,
# unless a loader is given), its import queries (`?url`, `?raw`), `import.meta.glob`, how a
# stylesheet's `@import` finds a package's stylesheet (vite.stylesheets), and, for a project with
# `@tailwindcss/vite` installed, Tailwind (tailwind.vite).
rules vite.compat
use bundle.api as api
use bundle.modules as m
use vite.glob as glob
use vite.stylesheets as sheets

const assets: [Text] = [".apng", ".png", ".jpg", ".jpeg", ".jfif", ".pjpeg", ".pjp", ".gif", ".svg", ".ico", ".webp", ".avif",
  ".cur", ".jxl", ".mp4", ".webm", ".ogg", ".mp3", ".wav", ".flac", ".aac", ".opus", ".mov", ".m4a", ".vtt", ".woff", ".woff2",
  ".eot", ".ttf", ".otf", ".webmanifest", ".pdf", ".txt"]

fn compatible(o: api.Options) -> api.Options =
  o with { url-queries: true, transforms: o.transforms ++ [glob.globbed],
           stylesheet-resolves: o.stylesheet-resolves ++ [sheets.resolved-in],
           loaders: o.loaders ++ [m.TextPair(key: ext, value: "file") for ext in assets if not (any l in o.loaders: l.key == ext)] }
