# `import.meta.env`, as Vite gives it to an application's code: the mode's names (MODE, DEV, PROD,
# SSR, BASE_URL), and every variable named with the `VITE_` prefix from the project's `.env` files
# (`.env`, `.env.local`, `.env.[mode]`, `.env.[mode].local`, each later one over the earlier) and
# from the process's environment, which is over them all. Each is a define: a read of
# `import.meta.env.VITE_X` is its value, and `import.meta.env` read whole is an object of them all.
# `process.env.NODE_ENV` is the mode's too, unless the build defines it.
rules vite.env
use bundle.api as api
use bundle.minhost as host

const prefix: Text = "VITE_"

record Var { name: Text, value: Text }

# The defines for a build of the project at `root` in `mode`, for the server or not, served from `base`.
fn defines(root: Text, mode: Text, ssr: Bool, base: Text) -> [api.DefineText] =
  [api.DefineText(key: "import.meta.env." ++ v.name, value: v.value) for v in fixed]
  ++ [api.DefineText(key: "import.meta.env." ++ v.name, value: host.js-string(v.value)) for v in exposed]
  ++ [api.DefineText(key: "import.meta.env", value: "({" ++ join([host.js-string(v.name) ++ ": " ++ v.value for v in fixed]
                                                                  ++ [host.js-string(v.name) ++ ": " ++ host.js-string(v.value) for v in exposed], ", ") ++ "})")]
  where prod = mode == "production",
        fixed = [Var(name: "BASE_URL", value: host.js-string(base)), Var(name: "MODE", value: host.js-string(mode)),
                 Var(name: "DEV", value: if prod then "false" else "true"), Var(name: "PROD", value: if prod then "true" else "false"),
                 Var(name: "SSR", value: if ssr then "true" else "false")],
        exposed = [v for v in loaded(root, mode) if starts-with(v.name, prefix)]

# A build's options with Vite's env: its defines added, none the build has given already.
fn with-env(o: api.Options, root: Text, mode: Text, ssr: Bool) -> api.Options =
  o with { defines: o.defines ++ [d for d in defines(root, mode, ssr, "/") ++ [node-env(mode)] if not api.has-define?(o, d.key)] }

fn node-env(mode: Text) -> api.DefineText =
  api.DefineText(key: "process.env.NODE_ENV", value: host.js-string(if mode == "production" then "production" else "development"))

# ---------------------------------------------------------------- the variables

# Every variable, the files' in order and then the process's: the last of a name is its value.
fn loaded(root: Text, mode: Text) -> [Var] = [last-of(all, n) for n in [v.name for v in all distinct v.name]]
  where files = [v for f in [".env", ".env.local", ".env." ++ mode, ".env." ++ mode ++ ".local"]
                 for path in [path-normalize(root ++ "/" ++ f)] if readable-file?(path) for v in parsed(read-file(path))],
        process = [Var(name: text-before(line, "="), value: text-after(line, "=")) for line in split(environment-text(), "\n")
                   if contains-text?(line, "=") and starts-with(line, prefix)],
        expanded = [v with { value: expand(v.value, files ++ process) } for v in files],
        all = expanded ++ process

fn last-of(vars: [Var], name: Text) -> Var = (last v in vars if v.name == name: v) ?? panic "vite.env: no variable {}", name

# A .env file, as dotenv reads one: `NAME=value` lines (`export ` before is allowed), a value
# quoted with ', " or ` running to its closing quote (over lines; a double-quoted one's \n is a
# line break), an unquoted one up to a ` #` comment; `#` lines and blank ones say nothing.
fn parsed(text: Text) -> [Var] = parsed-from(text, 0)

fn parsed-from(text: Text, at: Int) -> [Var] = match at >= len(text) {
  true => []
  false => match entry-at(text, at) {
    some(e) => [e.item] ++ parsed-from(text, e.next)
    none => parsed-from(text, line-after(text, at))
  }
}

record Entry { item: Var, next: Int }

fn line-after(text: Text, at: Int) -> Int = match index-of(text[at..len(text)], "\n") {
  some(n) => at + n + 1
  none => len(text)
}

fn entry-at(text: Text, at: Int) -> Entry? = match trim(line) {
  "" => none
  t if starts-with(t, "#") => none
  t => match index-of(body, "=") {
    none => none
    some(eq) => some(Entry(item: Var(name: trim(body[0..eq]), value: v.value), next: v.next))
      where v = value-at(text, at + (len(line) - len(trim-left(line))) + (len(t) - len(body)) + eq + 1)
  } where body = match t { "export " ++ rest => trim-left(rest)  _ => t }
} where line = text[at..line-after(text, at)]

fn trim-left(s: Text) -> Text = s[span-of(s, 0, " \t")..len(s)]

record Value { value: Text, next: Int }

fn value-at(text: Text, at: Int) -> Value = match text[start..min(start + 1, len(text))] {
  q if q == "\"" or q == "'" or q == "`" => match index-of(text[start + 1..len(text)], q) {
    some(n) => Value(value: if q == "\"" then replace-all(raw, "\\n", "\n") else raw, next: line-after(text, start + 1 + n))
      where raw = text[start + 1..start + 1 + n]
    none => unquoted(text, start)
  }
  _ => unquoted(text, start)
} where start = at + span-of(text, at, " \t")

fn unquoted(text: Text, start: Int) -> Value = Value(value: trim(match index-of(raw, " #") { some(c) => raw[0..c]  none => raw }), next: line-after(text, start))
  where raw = trim-bytes(text[start..line-after(text, start)], "\r\n")

# `${NAME}`, `${NAME:-default}` and `$NAME` in a value, as dotenv-expand reads them.
fn expand(value: Text, vars: [Var]) -> Text = match index-of(value, "$") {
  none => value
  some(at) => value[0..at] ++ match value[at + 1..min(at + 2, len(value))] {
    "{" => match index-of(value[at + 2..len(value)], "}") {
      some(n) => looked-up(inner, vars) ++ expand(value[at + 3 + n..len(value)], vars)
        where inner = value[at + 2..at + 2 + n]
      none => value[at..len(value)]
    }
    _ => match at + 1 + span-of(value, at + 1, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_") {
      end if end > at + 1 => looked-up(value[at + 1..end], vars) ++ expand(value[end..len(value)], vars)
      _ => "$" ++ expand(value[at + 1..len(value)], vars)
    }
  }
}

fn looked-up(inner: Text, vars: [Var]) -> Text = match index-of(inner, ":-") {
  some(c) => (last v in vars if v.name == inner[0..c] and v.value != "": v.value) ?? inner[c + 2..len(inner)]
  none => (last v in vars if v.name == inner: v.value) ?? ""
}
