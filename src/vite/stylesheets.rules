# How Vite finds the stylesheet an `@import` names (its CSS resolver: `createCSSResolvers` in
# vite/src/node/plugins/css.ts): a relative name is a file, `.css` added when it has none; any other
# is first a file beside the importer (`preferRelative`), then a package's stylesheet, by its
# `exports` with the `style` condition and the mode's (`production` or `development`), then its
# `style` field, then `main`. No directory index is tried. Tailwind's `@import "tailwindcss"` and
# packages like `@fontsource/inter` rely on this; plain esbuild resolves every `@import` as a
# relative URL.
rules vite.stylesheets
use bundle.resolve as res
use bundle.package as pkg
use bundle.package-targets as targets

# Whether the build is Vite's production one (`vite build`): the `development|production` condition.
setting production: Bool = true

fn conditions() -> [Text] = ["style", if production then "production" else "development", "import"]

# The stylesheet `spec` names from the stylesheet at `importer`, its real path.
fn resolved(spec: Text, importer: Text) -> Text? = first p in located(spec, dir-of(importer)): res.canonical(p)

fn located(spec: Text, from-dir: Text) -> Text? = match spec {
  "/" ++ _ => css-file(path-normalize(spec))
  _ if res.relative?(spec) => css-file(path-normalize(from-dir ++ "/" ++ spec))
  _ => css-file(path-normalize(from-dir ++ "/" ++ spec)) ?? package-stylesheet(spec, from-dir)
}

# A file as named, or with `.css` after it.
fn css-file(base: Text) -> Text? = res.existing(base) ?? res.existing(base ++ ".css")

fn package-stylesheet(spec: Text, from-dir: Text) -> Text? = first dir in path-ancestors(from-dir)
  for pdir in [res.in-dir(dir, "node_modules/" ++ res.package-name(spec))] for doc in res.package-doc(pdir):
    in-package(pdir, doc, res.package-subpath(spec))

fn in-package(pdir: Text, doc: pkg.Node, sub: Text) -> Text? = match res.member(doc, "exports") {
  some(value) => match targets.exports(value, sub, conditions()) {
    targets.Target(kind: targets.Path, value: target) => first decoded in targets.decoded(target): css-file(path-normalize(pdir ++ "/" ++ decoded))
    _ => none
  }
  none if sub == "." => first entry in (res.text-member(doc, "style") ?? res.text-member(doc, "main")): css-file(path-normalize(pdir ++ "/" ++ entry))
  none => css-file(path-normalize(pdir ++ "/" ++ sub))
}
