# The demo build, from the top of the tower: six targets, each its own bundler. The steps named
# here (strip-debug, shrink, …) are the ones `build.rules` offers.
bundler

# A format is something a spec writes: this one sets a global, whatever the module exports.
format attach
  prefix "(function(){"
  suffix "})();\n"
  exports "globalThis.bundled = %;"
end

target client
  entry "apps/named.js"
  outfile "../out/spec/client.js"
  format iife
  define process.env.NODE_ENV = "production"
  main-fields module main
  conditions import browser
  minify
  transform strip-debug
  optimize note shrink spell
end

target server
  entry "apps/named.js"
  outfile "../out/spec/server.js"
  format cjs
  platform node
  define process.env.NODE_ENV = "development"
  sourcemap
  pretty
end

target library
  entry "apps/lib.js"
  outfile "../out/spec/lib.mjs"
  format esm
  minify syntax
end

# JSX, its call chosen by the spec.
target ui
  entry "apps/jsx/spec.jsx"
  outfile "../out/spec/ui.cjs"
  jsx-factory "h"
end

# Code for an older engine.
target old
  entry "apps/lower/spec.js"
  outfile "../out/spec/old.js"
  language es2017
end

# Plugins, a spec-defined format, a banner and a loader.
target plugged
  entry "apps/plugged.js"
  outfile "../out/spec/plugged.js"
  format attach
  banner "/* built by the spec */"
  loader ".txt" = text
  on-resolve virtual-resolve
  on-load virtual-load
end
