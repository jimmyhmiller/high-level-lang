# Functions of the strategies in src/app/build.pipeline, which its mechanisms name (`… by F`): how
# the bundler's answers are checked, compared, saved and let go, said apart from the code that makes
# them.
rules app.versions
use bundle.package as pkg
use bundle.link as link
use bundle.analysis as an

# Versions (`check by`): what an answer is made from, as text that changes when it does.

# A package.json, by what it says (for bundle.resolve/doc-of).
fn doc-version(path: Text) -> Text = hash-text(read-file(path))

# A directory, by its listing (for bundle.resolve/listing-of).
fn listing-version(dir: Text) -> Text = hash-text(dir-listing(dir))

# Cutoffs (`cutoff by`): whether an answer made again counts as the one it replaces.

# Two readings of a package.json that say the same, however laid out: the resolver reads what a
# package.json says, never where.
fn same-package?(old: pkg.Node, new: pkg.Node) -> Bool = said(old) == said(new)

# What a JSON value says, without its layout.
fn said(v: pkg.Node) -> Text = match v {
  pkg.Object(List(ms...)) => "{" ++ join([m.key.text ++ ":" ++ said(m.value) for m in ms], ",") ++ "}"
  pkg.Array(List(items...)) => "[" ++ join([said(x) for x in items], ",") ++ "]"
  pkg.True() => "true"
  pkg.False() => "false"
  pkg.Null() => "null"
  _ => v.text
}

# What is saved (`store … by`): whether the answer for an argument goes into the cache.

# What a package holds, under node_modules, changes least between runs: only answers for it are
# saved, and the app's own files are read again by the next run.
fn in-packages?(path: Text) -> Bool = contains-text?(path, "node_modules/") or ends-with(path, "node_modules")

# What is let go (`evict by`): after each build, given how many builds since an answer was last
# asked for (0: this one) and how many the function keeps.

# What the last three builds never asked for, or, with more than 5000 kept, what the last did not.
fn unasked?(idle: Int, kept: Int) -> Bool = idle >= 3 or (idle >= 1 and kept > 5000)

# Updates (`update by`): an answer made from the last one, as the function would make it afresh.

# Linking's database (bundle.analysis/solved-facts) brought up to date from the last one solved:
# only what the facts that differ change is derived again or taken out (see `solved-from` in
# hl.facts).
fn solved-again(last: link.Db) -> link.Db = link.solved-from(last, an.fact-blocks())
