# An application-supplied policy: grouping by source directory instead of package boundaries.
# The spec offers it by name, exactly like a rewrite or load hook. It works with either units.
rules app.chunk-policies
use bundle.chunking as c
use bundle.fragments as f

fn directory-key(u: f.Unit) -> Text = c.exact-key(u) ++ "directory:" ++ dir-of(u.path)

fn directories(units: [f.Unit], limits: c.Limits) -> [c.Group] = c.group-by(units, directory-key)
