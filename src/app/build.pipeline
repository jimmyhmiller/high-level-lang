# How the bundler divides its work, and plans that divide it differently. Each stage names what does
# it; a plan that runs a stage in parallel only compiles if those functions share no state. The
# rules that do the work (src/bundle) say nothing of threads.
pipeline app.pipelines

# How answers are kept. Each is one of the ways a strategy can keep a function's answers.

# Kept in memory and saved with the cache; used again once everything an answer read is shown
# unchanged; an answer made again the same changes nothing that read it.
mechanism red-green
  store memory disk
  check reads
  cutoff equal
  evict none
end

# As red-green, the answers kept while the program runs and not saved with the cache: what is made
# of a file's tree costs as much to read back as to make again from its text (parsing is as fast as
# decoding), and is most of what a cache would hold. What was made from them is saved; one asked
# for after a restart, and not found, is made again from the file.
mechanism trees
  from red-green
  store memory
end

# Trees kept by the text they were made from (a file as a side's step left it), not its path: an
# edit makes a new text, and the tree of the last is never asked for again, so what the last builds
# did not ask for is let go (see app.versions/unasked?).
mechanism text-trees
  from trees
  evict by app.versions/unasked?
end

# The same, bounded: never saved, and no more than 2000 answers of each function in memory, those
# asked for longest ago let go and made again when next asked for.
mechanism lean
  from red-green
  store memory
  evict least-recently-used 2000
end

# Used again only while no input at all has changed: nothing an answer reads is kept, and an answer
# made again is not compared with the last; any edit makes everything again.
mechanism coarse
  from red-green
  check any-change
  cutoff none
end

# Made once and used for as long as the program runs: for what depends on nothing that changes.
mechanism frozen
  from red-green
  check never
end

# Used again, once any input changed, while what it was made from says the same: what each was made
# from as a version, given by a function of its own.
mechanism by-content
  from red-green
  check by app.versions/doc-version
end
mechanism by-listing
  from red-green
  check by app.versions/listing-version
end

# After each build, what the last builds never asked for let go (see app.versions/unasked?): memory
# follows what the builds need.
mechanism generational
  from red-green
  evict by app.versions/unasked?
end

# The same, and saved with the cache only for what packages hold (app.versions/in-packages?).
mechanism packages-saved
  from generational
  store memory disk by app.versions/in-packages?
end

# The same, and a package.json read again that says the same, laid out otherwise, changes nothing
# (app.versions/same-package?).
mechanism package-docs
  from packages-saved
  cutoff by app.versions/same-package?
end

# The same, and an answer made again is brought up to date from the last one made (see
# app.versions/solved-again): for linking's database, which a change to a few modules' facts
# changes a little.
mechanism updated
  from red-green
  update by app.versions/solved-again
end

# The same for where renaming looks (see app.versions/stems-again).
mechanism updated-stems
  from red-green
  update by app.versions/stems-again
end

# What is kept: each function a strategy names has its answers kept by its arguments, while what
# they were made from stays the same. The code that does the work says nothing of it. A run uses one
# strategy: --strategy=NAME, or else `incremental` while watching or with the cache, and `once`
# for anything else.

# One build computes once what it asks for many times: files read and parsed, names resolved,
# each module's tree and import parts. Without these one build does the same work over and over
# (each import reads its directory again).
strategy once
  default
  keep bundle.cssbundle/tree-of bundle.cssbundle/asset-name
  keep bundle.modules/hook-answer
       bundle.modules/full-path bundle.modules/shown-path bundle.modules/body-of bundle.modules/runtime-parsed
  keep bundle.resolve/listing-of bundle.resolve/file? bundle.resolve/doc-of bundle.resolve/type-module-dir?
       bundle.resolve/effect-patterns bundle.resolve/resolution bundle.resolve/resolution-kind bundle.resolve/canonical
       bundle.resolve/canonical-dir bundle.resolve/package-json-for
  keep bundle.tsconfig/config-of-file bundle.tsconfig/config-of-dir
  keep bundle.lint/file-program
  keep bundle.emit/import-parts bundle.analysis/module-link
  keep bundle.naming/module-stem-claims bundle.naming/fixed-by-stem
  keep bundle.modules/styled? bundle.api/export-prefix
  # What a module imports to run, asked once for whether it may move and again for what it waits on.
  keep bundle.fragments/static-deps
  # Which functions the program reads once: asked by every group a minified build prints; and each
  # one's declaration, asked by the group it is written in and the group that declares it.
  keep bundle.emit/single-use-functions bundle.emit/single-declaration
  # What each of these makes on the way to its answer is let go as it answers: the steps that see
  # the whole program, and what is worked out once for each file, module and unit.
  apart bundle.fragments/model bundle.chunks/configured bundle.api/chunk-program bundle.api/chunk-own bundle.api/chunk-own
        bundle.resolve/resolution-kind bundle.mangle/unit-usage bundle.analysis/summaries-of bundle.analysis/module-link
        bundle.modules/parsed-of bundle.modules/parsed-text bundle.modules/plain-analysed bundle.modules/own-analysed bundle.modules/loaded bundle.analysis/solved-facts bundle.analysis/link
        bundle.mangle/minified-names bundle.emit/unit-body bundle.emit/units-of-order
        # A group's emitted and optimized trees are dead once its text is printed.
        bundle.api/group-output bundle.api/chunk-group
        hl.graph/components hl.graph/propagated hl.graph/closed-safe hl.graph/buckets
        bundle.fragments/dependencies bundle.fragments/raw-units bundle.fragments/eligibility
  # A piece of a big text's tree is part of the file's tree: made to last, by whoever parsed it.
  apart lasting bundle.jspieces/piece
end

# From one build to the next while watching, and saved with the cache from one run to the next, so
# a build after an edit computes only what the edit reaches.
strategy incremental
  from once
  tracks
  persists
  watching
  uses red-green
  # The runtime's tree depends on the runtime's text alone.
  keep with frozen bundle.modules/runtime-parsed
  # Linking's rules bring the last database up to date, rather than solving again.
  keep with updated bundle.analysis/solved-facts
  # Files' trees, and the trees made of them, kept while running and never saved.
  keep with trees bundle.modules/body-of bundle.modules/parsed-of bundle.modules/plain-analysed bundle.modules/own-analysed bundle.modules/loaded
       bundle.emit/unit-body bundle.emit/unit-namespace bundle.api/group-optimized
       bundle.emit/single-declaration
  keep with text-trees bundle.modules/parsed-text
  keep bundle.analysis/on-demand-calls
       bundle.analysis/module-facts-at bundle.analysis/binding-facts-at bundle.analysis/link
       bundle.analysis/solved-facts
  keep bundle.api/group-optimized bundle.api/run-printed bundle.api/bundle bundle.api/group-output
  keep bundle.emit/units-of-order bundle.emit/unit-body bundle.emit/unit-namespace
  # What each module declares that is a function, and what each statement reads: what the functions
  # read once are found from, file by file.
  keep bundle.emit/declared-functions bundle.emit/reader-counts
  keep bundle.hmr/dev-shape bundle.hmr/dev-function bundle.hmr/dev-accepts
  keep bundle.mangle/unit-usage bundle.mangle/minified-names
  keep bundle.modules/graph bundle.modules/table-size bundle.modules/file-block bundle.modules/runtime-block
       bundle.modules/leads-of bundle.modules/whole-of bundle.modules/scopes-of bundle.modules/module-of
       bundle.modules/led-ahead bundle.modules/exports-of
  keep with updated-stems bundle.naming/stems-db
  keep bundle.analysis/module-reserved bundle.naming/stem-facts-at bundle.naming/stems-db
  keep bundle.naming/module-stem-claims bundle.naming/module-named
       bundle.naming/bucket-named bundle.naming/module-names bundle.naming/claims-now
       bundle.naming/reserved-now bundle.naming/top-names-now bundle.naming/fixed-by-stem
       bundle.naming/own-names bundle.naming/esbuild-names
end

# As `incremental`, with memory bounded: nothing saved, at most 2000 answers of each function.
strategy lean
  from incremental
  uses lean
end

# As `incremental`, with the packages a build reads trusted: what is under node_modules is read as
# it is, never checked or watched again (an edit there is seen by the next run with another cache).
strategy trusting
  from incremental
  trust "**/node_modules/**"
  # A trusted file is never read again to see whether it changed; an answer not saved would be made
  # again from it as it is now, and see an edit trust says is not seen. So what is made of trees is
  # saved, as the answers it was made from are.
  keep with red-green bundle.modules/body-of bundle.modules/parsed-of bundle.modules/plain-analysed bundle.modules/own-analysed bundle.modules/loaded
       bundle.emit/unit-body bundle.emit/unit-namespace bundle.api/group-optimized
       bundle.emit/single-declaration
  keep with generational bundle.modules/parsed-text
end

# As `incremental`, kept only while nothing at all changes: a run that changed nothing reads its
# answers back; an edit builds everything again.
strategy coarse
  from incremental
  uses coarse
end

# As `incremental`, with packages' package.json and directories' listings used again while they say
# the same, as versions of their own, and not by what they read.
strategy versioned
  from incremental
  keep with by-content bundle.resolve/doc-of
  keep with by-listing bundle.resolve/listing-of
end

# As `incremental`, tailored by functions of its own (src/app/versions.rules): what the last builds
# did not ask for let go; for what is asked of a path, only answers for packages saved with the
# cache; a package.json that says the same, laid out otherwise, changing nothing.
strategy tailored
  from incremental
  uses generational
  keep with packages-saved bundle.resolve/listing-of bundle.resolve/file? bundle.modules/loaded
       bundle.modules/parsed-of bundle.modules/whole-of
  keep with package-docs bundle.resolve/doc-of
end

# The stages: what is done once for each file, module, unit or chunk, and what sees the whole
# program. The rules say what each list holds; here is said which lists are a stage's work, and a
# plan gives each stage its threads.

# Each file on its own: read, parsed, its JSX and TypeScript lowered, early errors, comments, and
# what it imports, resolved; then, the graph's order known, its module and its table at its place.
stage load     per file bundle.modules/led-ahead
               bundle.modules/whole-of bundle.modules/table-size bundle.modules/module-at bundle.modules/file-block
               makes bundle.modules/loaded bundle.modules/parsed-of bundle.modules/parsed-text bundle.modules/plain-analysed bundle.modules/own-analysed bundle.modules/exports-of
               reads files
               also bundle.modules/parsed-of bundle.modules/parsed-text bundle.modules/plain-analysed bundle.modules/own-analysed bundle.modules/exports-of bundle.modules/loaded
# A big text of JavaScript, parsed in pieces (bundle.jspieces), and a big program's analysis, which
# the scopes definition divides itself: its parts' scopes walked apart and joined, as one walk
# would have made them. Nothing is gained by cutting what one thread will do.
stage pieces   per piece bundle.jspieces/piece
               alone bundle.jspieces/cut is bundle.jspieces/uncut
               inside bundle.scopes
# A file's statements, each checked for early errors: little work each, so many at a time.
stage early    per 32 of 256 statements bundle.early/part-found
               alone bundle.modules/found-in is bundle.modules/found-whole
# Where each of a file's imports leads: little work each, so many at a time.
stage resolve  per 64 requests bundle.modules/lead-request
# The output's groups optimised, and its statements, by groups or by runs, made ASCII and printed;
# each chunk's placeholders found, its hash made, and its files written.
stage optimize per group bundle.api/group-optimized
stage print    per run bundle.api/run-printed bundle.api/group-output
               bundle.chunks/holes-in bundle.chunks/content-hash bundle.api/chunk-written
# A chunk's whole body, when each is its own work (see `chunk-own`): each is given the chunk's own
# units as settings.
stage chunks   per chunk bundle.api/chunk-at
               gives settings
# Naming and the chunks' units, which read nothing of each other's.
stage sides    per side bundle.api/side
               gives settings
# What each module's statements mention and declare, for linking; what each chunk needs of the
# others.
stage facts    per module bundle.analysis/summaries-of
               bundle.analysis/module-link
               bundle.fragments/candidate bundle.fragments/static-deps bundle.fragments/module-units
               bundle.fragments/unit-dependencies bundle.fragments/module-statements bundle.chunks/with-needs
               makes bundle.analysis/summaries-of
# Each module's facts, whose names get their ids in the order one thread would have met them.
stage gather   per module bundle.analysis/module-facts-at bundle.analysis/binding-facts-at
               bundle.naming/stem-facts-at
               names by bundle.modules/name-id
# Names as esbuild gives them: what each module claims and reserves, each group of stems named,
# and each module's block with its names.
stage naming   per module bundle.naming/module-stem-claims bundle.analysis/module-reserved
               bundle.naming/bucket-named bundle.naming/output-block
# What each module uses, for its names, and then its statements with their final names.
stage emit     per module bundle.mangle/unit-usage bundle.mangle/module-nested bundle.emit/unit-emitted
# The rest sees the whole program at once.
stage link     whole    bundle.analysis/link
stage name     whole    bundle.emit/assign-names
# Blame and what-if (bundle.blame): each edit tried, linking solved again with it, or without what
# it takes away.
stage what-if  per edit bundle.blame/left-routes bundle.blame/reached-with
# The semantic graph is a kept value, independently of which packing policy consumes it.
stage partition whole bundle.fragments/model bundle.chunks/configured
                makes bundle.fragments/model

# How big the units are that the rules cut work into. The rules say where work may be cut; how
# finely is said here, beside the stages and plans it is tuned with.
# A big file is parsed in pieces of about this many bytes; one under twice that is parsed whole.
size bundle.jspieces/piece-bytes 8192
# A plain ES module with many statements is emitted, and counted for names, this many at a time.
size bundle.emit/unit-parts 64
# Top-level names are given to stems in this many groups: an edit names again the groups of the
# stems it changed.
size bundle.naming/buckets 64

plan single
end

plan load-only
  threads auto
  load parallel
  pieces parallel
  early parallel
  resolve parallel
end

plan back-half
  optimize parallel 8
  print parallel 8
end

plan two
  threads 2
  load parallel
  pieces parallel
  early parallel
  resolve parallel
  facts parallel
  gather parallel
  naming parallel
  emit parallel
  optimize parallel
  print parallel
  sides parallel
  chunks parallel
  what-if parallel
end

plan full
  threads auto
  load parallel
  pieces parallel
  early parallel
  resolve parallel
  facts parallel
  gather parallel
  naming parallel
  emit parallel
  optimize parallel auto
  print parallel auto
  sides parallel
  # A chunk's statements are walked to the end of each list, on the stack: every thread that makes
  # chunks holds a deep one meanwhile, so a few make them.
  chunks parallel 6
  what-if parallel
end

# A framework's browser build and server build, side by side in one program (TanStack Start's): the
# context is `bundle.api/context`. What reading a file needs is the same for both (`parsing`), and
# React Fast Refresh's options are given once around both builds, for the browser's.
contexts by bundle.api/context shared bundle.modules/parsing bundle.tsconfig/forced react.refresh/options end
