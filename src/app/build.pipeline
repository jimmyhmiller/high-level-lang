# How the bundler divides its work, and plans that divide it differently. Each stage names what does
# it; a plan that runs a stage in parallel only compiles if those functions share no state.
pipeline app.pipelines fills bundle.api/Plan

# What a build keeps: each function named here has its answers kept by its arguments, while what
# they were made from stays the same, from one build to the next and, with the cache, from one run
# to the next. The code that does the work says nothing of it; keep nothing, and every function
# is computed each time it is asked.
keep bundle.analysis/summaries-of bundle.analysis/on-demand-calls bundle.analysis/module-link
     bundle.analysis/module-facts-at bundle.analysis/binding-facts-at bundle.analysis/linked-now
     bundle.analysis/table-now bundle.analysis/db-now
keep bundle.api/run-step bundle.api/rendered-run bundle.api/built-files bundle.api/names-now
     bundle.api/group-output
keep bundle.cssbundle/tree-of bundle.cssbundle/asset-name
keep bundle.emit/import-parts bundle.emit/units-now bundle.emit/unit-emitted-of
keep bundle.hmr/dev-function bundle.hmr/dev-accepts
keep bundle.mangle/unit-usage-of
keep bundle.modules/body-of bundle.modules/hook-answer bundle.modules/visit-file bundle.modules/split-source
     bundle.modules/piece-of bundle.modules/prepared-of bundle.modules/walked-of bundle.modules/early-of
     bundle.modules/from-of bundle.modules/graph-of bundle.modules/loaded bundle.modules/parsed-alone
     bundle.modules/hooked-text bundle.modules/parsed-hooked bundle.modules/runtime-parsed
     bundle.modules/leads-of bundle.modules/whole-of bundle.modules/scopes-of bundle.modules/module-of
     bundle.modules/full-path bundle.modules/shown-path
keep bundle.naming/module-reserved bundle.naming/module-claims bundle.naming/module-named
     bundle.naming/top-level-now bundle.naming/own-names-now
keep bundle.resolve/listing-of bundle.resolve/file? bundle.resolve/doc-of bundle.resolve/type-module-dir?
     bundle.resolve/effect-patterns bundle.resolve/resolution
keep bundle.tsconfig/config-of-file bundle.tsconfig/config-of-dir

# Each file on its own: read, parsed, its JSX and TypeScript lowered, early errors, comments, and
# what it imports, resolved.
stage load     per file bundle.modules/visit-file bundle.modules/next-files bundle.modules/first-files bundle.modules/after-files bundle.modules/parsed-file
               makes bundle.modules/loaded
# Rewrites, and printing, of runs of the program's statements.
stage optimize per part bundle.api/default-optimize bundle.finish/ascii-only bundle.api/finished-piece
stage print    per part bundle.api/render-part bundle.api/printed-piece
# What each module's statements mention and declare, for linking.
stage facts    per module bundle.analysis/on-demand-calls bundle.analysis/summaries-of
# What each module uses, for its names, and then its statements with their final names.
stage emit     per module bundle.mangle/unit-usage bundle.emit/unit-emitted
# The rest sees the whole program at once.
stage link     whole    bundle.analysis/link
stage name     whole    bundle.emit/assign-names

plan single
end

plan load-only
  threads auto
  load parallel
end

plan back-half
  optimize parallel 8
  print parallel 8
end

plan two
  threads 2
  load parallel
  facts parallel
  emit parallel
  optimize parallel
  print parallel
end

plan full
  threads auto
  load parallel
  facts parallel
  emit parallel
  optimize parallel auto parts 96
  print parallel auto parts 24
end
