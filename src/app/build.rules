# The demo build: the spec in `build.bundler`, and the steps this program lets it name. A step with
# no language of its own is an ordinary function over the grammar's node type, offered like a
# generated pass.
rules app.build
use bundle.spec as spec
use bundle.minify as minify
use bundle.final as final
use app.strip-debug as strip-debug
use app.passes as passes
use app.plugins as plugins
use app.chunk-policies as chunk-policies

main run on big stack

# `spec` builds the demo spec; `spec FILE` builds another with the same steps.
fn run() -> Void = match arg-count() {
  1 => spec.build-all(include-text("build.bundler"), "src/app/build.bundler", steps())
  _ => spec.build-all(read-file(arg-at(1)), arg-at(1), steps())
}

fn steps() -> spec.Steps = spec.Steps(
  passes: {"strip-debug": strip-debug.run, "shrink": minify.run, "spell": final.run, "note": passes.note},
  resolvers: {"virtual-resolve": plugins.virtual-resolve},
  loaders: {"virtual-load": plugins.virtual-load},
  chunkers: {"directories": chunk-policies.directories})
