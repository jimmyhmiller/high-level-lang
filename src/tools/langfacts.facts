# A small fact database for langtest: what a graph reaches from its roots.
facts
relation root(f)
relation edge(f, g)
relation reach(f)
reach(F) :- root(F) ;
reach(G) :- reach(F), edge(F, G) ;

# Aggregates: each node's fan-out, the weight of what each reaches, the lightest and heaviest
# reached node, and how many nodes are reached at all; and edges to another node only.
relation weight(f, w)
relation fanout(f, n)
relation reach-weight(r, w)
relation lightest(w)
relation heaviest(w)
relation reached-count(n)
relation away(f, g)
fanout(F, count G) :- edge(F, G) ;
reach-weight(R, sum W) :- root(R), reach(F), weight(F, W) ;
lightest(min W) :- reach(F), weight(F, W) ;
heaviest(max W) :- reach(F), weight(F, W) ;
reached-count(count F) :- reach(F) ;
away(F, G) :- edge(F, G), F != G ;
