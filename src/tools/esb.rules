# The command line, esbuild style:
#   esb ENTRY… [--outfile=PATH | --outdir=DIR] [--splitting] [--format=iife|esm|cjs] [--global-name=X] [--minify]
#       [--minify-identifiers] [--minify-syntax] [--pretty] [--timing] [--watch] [--hmr] [--serve=PORT] [--define:KEY=VALUE]…
#       [--cache] [--no-cache] [--cache-dir=DIR]
rules tools.esb
use bundle.api as api
use bundle.modules as m
use bundle.jsx as jsx
use bundle.hmr as hmr
use app.pipelines as plans

main run on big stack

fn after(a: Text, prefix: Text) -> Text = a[len(prefix)..len(a)]

fn split-at-equals(body: Text) -> m.TextPair = match body {
  key ++ "=" ++ value => m.TextPair(key: key, value: value)
  _ => panic "expected KEY=VALUE, got {}", body
}

fn split-commas(s: Text) -> [Text] = [x for x in split(s, ",") if len(x) > 0]

# The options with one more argument of the command line.
fn with-flag(o: api.Options, a: Text) -> api.Options = match a {
  "--format=iife" => o with { format: api.iife-format() }
  "--format=esm" => o with { format: api.esm-format() }
  "--format=cjs" => o with { format: api.cjs-format() }
  "--tree-shaking=false" => o with { tree-shaking: false }
  "--jsx-dev" => api.with-jsx-dev(o)
  "--jsx-side-effects" => api.with-jsx(o, o.jsx with { side-effects: true })
  "--pretty" => o with { pretty: true }
  "--timing" => o with { timing: true }
  "--sourcemap" => o with { sourcemap: true }
  "--platform=node" => api.on-node(o)
  "--platform=browser" | "--bundle" => o
  "--charset=utf8" => o with { charset-ascii: false }
  "--charset=ascii" => o with { charset-ascii: true }
  "--drop:console" => o with { drop-console: true }
  "--drop:debugger" => o with { drop-debugger: true }
  "--packages=external" => o with { packages-external: true }
  "--packages=bundle" => o with { packages-external: false }
  "--splitting" => o with { splitting: true }
  "--minify-identifiers" => o with { minify-identifiers: true }
  "--minify-syntax" => o with { minify-syntax: true }
  "--minify" => o with { minify-identifiers: true, minify-syntax: true }
  "--jsx=" ++ name => api.with-jsx-runtime(o, name)
  "--jsx-factory=" ++ name => api.with-jsx-factory(o, name)
  "--jsx-fragment=" ++ name => api.with-jsx-fragment(o, name)
  "--jsx-import-source=" ++ name => api.with-jsx-import-source(o, name)
  "--tsconfig=" ++ path => o with { tsconfig: path }
  "--outfile=" ++ path => o with { outfile: path }
  "--legal-comments=" ++ mode => o with { legal-comments: mode }
  "--pipeline=" ++ name => o with { plan: plans.plan(name) }
  "--threads=" ++ count => o with { plan: api.Plan(name: "threads", load-threads: n, optimize-parts: n, optimize-threads: n,
                                                    print-parts: n, print-threads: n, facts-threads: n, emit-threads: n) }
    where n = parse-int(count)
  "--target=" ++ name => api.with-target(o, name)
  "--outdir=" ++ dir => o with { outdir: dir }
  "--outbase=" ++ dir => o with { outbase: dir }
  "--entry-names=" ++ pattern => o with { entry-names: pattern }
  "--chunk-names=" ++ pattern => o with { chunk-names: pattern }
  "--global-name=" ++ name => o with { global-name: name }
  "--define:" ++ body => api.with-define(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--external:" ++ spec => o with { external: o.external ++ [spec] }
  "--alias:" ++ body => api.with-alias(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--loader:" ++ body => api.with-loader(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--banner:js=" ++ text => o with { banner: text }
  "--footer:js=" ++ text => o with { footer: text }
  "--main-fields=" ++ list => o with { main-fields: split-commas(list) }
  "--conditions=" ++ list => o with { conditions: split-commas(list) }
  "--resolve-extensions=" ++ list => o with { extensions: split-commas(list) }
  "--pure:" ++ name => o with { pure: o.pure ++ [name] }
  "--public-path=" ++ path => o with { public-path: path }
  "--log-level=" ++ _ => o
  # For a profiler: the whole build run this many times in one process.
  "--repeat=" ++ _ => o
  # How the builds are run: see `Run`. Hot module replacement builds in a format of its own.
  "--hmr" => o
  a if run-only?(a) => o
  "--" ++ _ => panic "unknown option {}", a
  entry => o with { entries: o.entries ++ [entry] }
}

# How the builds are run, which changes nothing they make.
record Run {
  # `--watch`: build again whenever an input changes, looking every `interval` milliseconds.
  watch: Bool,
  interval: Int,
  # `--hmr`: watching, each build in the development format, and what changed sent to the page;
  # `--serve=PORT`: the output's directory served, with the page's event stream (-1: not served).
  hmr: Bool,
  serve-port: Int,
  # What builds compute, kept on disk in `cache-dir` (by default node_modules/.cache/esb), so a
  # later run starts where this one stopped: always while watching unless `no-cache`, and for one
  # build with `cache`. `cache-key` tells one command line's cache from another's.
  cache: Bool,
  no-cache: Bool,
  cache-dir: Text,
  cache-key: Text,
  # `--strategy=NAME`: which of the pipeline's strategies says what is kept (see build.pipeline);
  # none named, the one marked `watching` while watching or with the cache, else the default.
  strategy: Text
}

fn with-run-flag(r: Run, a: Text) -> Run = match a {
  "--watch" => r with { watch: true }
  "--cache" => r with { cache: true }
  "--no-cache" => r with { no-cache: true }
  "--cache-dir=" ++ dir => r with { cache-dir: dir }
  "--hmr" => r with { watch: true, hmr: true }
  "--serve=" ++ port => r with { serve-port: parse-int(port) }
  "--watch-interval=" ++ ms => r with { interval: parse-int(ms) }
  "--strategy=" ++ name => r with { strategy: name }
  _ => r
}

# The command line's options.
fn options() -> api.Options = fold o = api.options-new(arg-at(1), "") for i in 2..arg-count(): with-flag(o, arg-at(i))

fn run-options() -> Run =
  fold r = Run(watch: false, interval: 100, hmr: false, serve-port: -1, cache: false, no-cache: false,
               cache-dir: "node_modules/.cache/esb", cache-key: cache-key(), strategy: "")
  for i in 2..arg-count(): with-run-flag(r, arg-at(i))

# What tells one command line's cache from another's: the directory it runs in and its arguments,
# but not those that change only how a build is run and reported, and not `--watch`, so one build
# with `--cache` starts from what watching kept.
fn cache-key() -> Text = join([working-dir()] ++ [a for i in 1..arg-count() for a in [arg-at(i)] if not run-only?(a)], "\n")

fn run-only?(a: Text) -> Bool = match a {
  "--watch" | "--timing" | "--cache" | "--no-cache" => true
  "--serve=" ++ _ | "--cache-dir=" ++ _ | "--repeat=" ++ _ | "--watch-interval=" ++ _ | "--strategy=" ++ _ => true
  _ => false
}

fn repeats() -> Int = (last i in 2..arg-count() for n in [arg-at(i)] if starts-with(n, "--repeat="): parse-int(after(n, "--repeat="))) ?? 1

fn run() -> Void = for-each-time(repeats(), options(), run-options())

fn for-each-time(times: Int, o: api.Options, r: Run) -> Void {
  for i in 0..times { build(o, r) }
}

# Builds of the options: one; or while watching, one each time an input a build read says something
# else, until the process is stopped; with hot module replacement, each in the development format.
fn build(o: api.Options, r: Run) -> Void {
  started(o, r)
  match r.hmr {
    true => dev-rebuilding(api.dev-given(o), r)
    false => builds(o, r)
  }
  memo-audit-report!()
}

fn builds(o: api.Options, r: Run) -> Void {
  var count = 0
  var going = true
  while going {
    let start = now-us()
    let before = memo-computed()
    let instructions = instructions-retired()
    let cycles = cycles-elapsed()
    let user = cpu-user-us()
    let system = cpu-system-us()
    let faults = page-faults()
    let waited = switches-waiting()
    let forced = switches-forced()
    timed(o.timing, "write", api.delivered(o, api.files(o)))
    count = count + 1
    let took = now-us() - start
    if r.watch {
      print "[watch] build {}: {}.{} ms, {} memo answers computed, {} inputs watched", count, took / 1000, took % 1000 / 100,
        memo-computed() - before, inputs-watched()
      if o.timing and instructions >= 0 {
        print "[watch] build {}: {} M instructions, {} M cycles", count, (instructions-retired() - instructions) / 1000000,
          (cycles-elapsed() - cycles) / 1000000
      }
      if o.timing {
        print "[watch] build {}: {} us user, {} us system, {} page faults, {} waits, {} preempted", count, cpu-user-us() - user,
          cpu-system-us() - system, page-faults() - faults, switches-waiting() - waited, switches-forced() - forced
      }
    }
    let saving = now-us()
    cache-kept(o, r)
    if o.timing and cached?(r) and not r.watch {
      print "[cache] saved in {}.{} ms", (now-us() - saving) / 1000, (now-us() - saving) % 1000 / 100
    }
    if r.watch {
      let changed = wait-for-changes!(r.interval)
      print "[watch] changed: {}", join(changed, " ")
    } else {
      going = false
    }
  }
  if r.watch { print "[watch] stopped" }
}

# Whether builds keep what they compute on disk, and start from what an earlier run kept.
fn cached?(r: Run) -> Bool = not r.no-cache and (r.cache or r.watch)

# A cache is the command line's and its strategy's: another strategy keeps other answers.
fn cache-path(r: Run) -> Text = r.cache-dir ++ "/" ++ hash-text(r.cache-key ++ "\n" ++ strategy-of(r)) ++ ".cache"

fn strategy-of(r: Run) -> Text = match r.strategy {
  "" if r.watch or cached?(r) => plans.watching-strategy()
  "" => plans.default-strategy()
  name => name
}

# The run's strategy chosen, before anything is computed; builds that watch, or start from the
# cache, track what each answer was made from, and the first starts from what an earlier run kept.
fn started(o: api.Options, r: Run) -> Void {
  let strategy = strategy-of(r)
  if r.watch or cached?(r) {
    one-entry(o)
    if not plans.strategy-tracks?(strategy) {
      panic "--watch and --cache keep answers from one build to the next, which strategy {} does not track", strategy
    }
  }
  let start = now-us()
  if plans.run-started!(strategy, cache-of(r)) and o.timing {
    print "[cache] loaded {} in {}.{} ms", cache-path(r), (now-us() - start) / 1000, (now-us() - start) % 1000 / 100
  }
}

# The cache a run starts from and saves to, if any.
fn cache-of(r: Run) -> Text = match cached?(r) {
  true => cache-path(r)
  false => ""
}

fn one-entry(o: api.Options) -> Bool = match o.splitting, o.outfile, len(o.entries), o.entry {
  false, out, 1, entry if out != "" and not ends-with(entry, ".css") => true
  _, _, _, _ => panic "--watch and --cache build one JavaScript entry to --outfile, for now"
}

# What the builds computed, kept: while watching, on a thread of its own while the watcher waits;
# for one build, before the program ends.
fn cache-kept(o: api.Options, r: Run) -> Void = plans.build-done!(strategy-of(r), cache-of(r), r.watch, o.timing)

# Hot module replacement: each build in the development format, written, and after the first what
# changed sent to the page as an update, or a reload when nothing that changed can take one.
fn dev-rebuilding(o: api.Options, r: Run) -> Void {
  let events = match r.serve-port {
    port if port >= 0 => "http://127.0.0.1:" ++ int-text(served) ++ "/hmr"
      where served = serve!(port, dir-of(o.outfile), "<!doctype html>\n<meta charset=\"utf-8\">\n<body>\n<script src=\"/" ++ path-base(o.outfile) ++ "\"></script>\n</body>\n")
    _ => ""
  }
  if events != "" { print "[hmr] serving {} at {}", dir-of(o.outfile), text-before(events, "/hmr") }
  var before = hmr.Dev(text: "", functions: {})
  var builds = 0
  while true {
    let start = now-us()
    let computed = memo-computed()
    let step = api.dev-step-of(o, before, events)
    api.written([api.Written(path: o.outfile, text: step.dev.text, said: api.said-of(step.dev.text, o.outfile))])
    builds = builds + 1
    let took = now-us() - start
    print "[watch] build {}: {}.{} ms, {} memo answers computed, {} inputs watched", builds, took / 1000, took % 1000 / 100,
      memo-computed() - computed, inputs-watched()
    cache-kept(o, r)
    if builds > 1 {
      match step.sent {
        some(sent) => {
          broadcast!(sent.event, sent.text)
          print "[hmr] {} to {} listening: {}", sent.event, listeners(), join(sent.changed, " ")
        }
        none => print "[hmr] no module changed"
      }
    }
    before = step.dev
    let changed = wait-for-changes!(r.interval)
    print "[watch] changed: {}", join(changed, " ")
  }
}
