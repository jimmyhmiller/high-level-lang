# The command line, esbuild style:
#   esb ENTRY… [--outfile=PATH | --outdir=DIR] [--splitting] [--format=iife|esm|cjs] [--global-name=X] [--minify]
#       [--minify-identifiers] [--minify-syntax] [--pretty] [--timing] [--define:KEY=VALUE]…
rules tools.esb
use bundle.api as api
use bundle.modules as m
use bundle.jsx as jsx
use app.pipelines as plans

main run on big stack

fn after(a: Text, prefix: Text) -> Text = a[len(prefix)..len(a)]

fn split-at-equals(body: Text) -> m.TextPair = match body {
  key ++ "=" ++ value => m.TextPair(key: key, value: value)
  _ => panic "expected KEY=VALUE, got {}", body
}

fn split-commas(s: Text) -> [Text] = [x for x in split(s, ",") if len(x) > 0]

# The options with one more argument of the command line.
fn with-flag(o: api.Options, a: Text) -> api.Options = match a {
  "--format=iife" => o with { format: api.iife-format() }
  "--format=esm" => o with { format: api.esm-format() }
  "--format=cjs" => o with { format: api.cjs-format() }
  "--tree-shaking=false" => o with { tree-shaking: false }
  "--jsx-dev" => api.with-jsx-dev(o)
  "--jsx-side-effects" => api.with-jsx(o, o.jsx with { side-effects: true })
  "--pretty" => o with { pretty: true }
  "--timing" => o with { timing: true }
  "--sourcemap" => o with { sourcemap: true }
  "--platform=node" => api.on-node(o)
  "--platform=browser" | "--bundle" => o
  "--charset=utf8" => o with { charset-ascii: false }
  "--charset=ascii" => o with { charset-ascii: true }
  "--drop:console" => o with { drop-console: true }
  "--drop:debugger" => o with { drop-debugger: true }
  "--packages=external" => o with { packages-external: true }
  "--packages=bundle" => o with { packages-external: false }
  "--splitting" => o with { splitting: true }
  "--minify-identifiers" => o with { minify-identifiers: true }
  "--minify-syntax" => o with { minify-syntax: true }
  "--minify" => o with { minify-identifiers: true, minify-syntax: true }
  "--jsx=" ++ name => api.with-jsx-runtime(o, name)
  "--jsx-factory=" ++ name => api.with-jsx-factory(o, name)
  "--jsx-fragment=" ++ name => api.with-jsx-fragment(o, name)
  "--jsx-import-source=" ++ name => api.with-jsx-import-source(o, name)
  "--tsconfig=" ++ path => o with { tsconfig: path }
  "--outfile=" ++ path => o with { outfile: path }
  "--legal-comments=" ++ mode => o with { legal-comments: mode }
  "--pipeline=" ++ name => o with { plan: plans.plan(name) }
  "--threads=" ++ count => o with { plan: api.Plan(name: "threads", load-threads: n, optimize-parts: n, optimize-threads: n,
                                                    print-parts: n, print-threads: n, facts-threads: n, emit-threads: n) }
    where n = parse-int(count)
  "--target=" ++ name => api.with-target(o, name)
  "--outdir=" ++ dir => o with { outdir: dir }
  "--outbase=" ++ dir => o with { outbase: dir }
  "--entry-names=" ++ pattern => o with { entry-names: pattern }
  "--chunk-names=" ++ pattern => o with { chunk-names: pattern }
  "--global-name=" ++ name => o with { global-name: name }
  "--define:" ++ body => api.with-define(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--external:" ++ spec => o with { external: o.external ++ [spec] }
  "--alias:" ++ body => api.with-alias(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--loader:" ++ body => api.with-loader(o, pair.key, pair.value) where pair = split-at-equals(body)
  "--banner:js=" ++ text => o with { banner: text }
  "--footer:js=" ++ text => o with { footer: text }
  "--main-fields=" ++ list => o with { main-fields: split-commas(list) }
  "--conditions=" ++ list => o with { conditions: split-commas(list) }
  "--resolve-extensions=" ++ list => o with { extensions: split-commas(list) }
  "--pure:" ++ name => o with { pure: o.pure ++ [name] }
  "--public-path=" ++ path => o with { public-path: path }
  "--log-level=" ++ _ => o
  # For a profiler: the whole build run this many times in one process.
  "--repeat=" ++ _ => o
  "--" ++ _ => panic "unknown option {}", a
  entry => o with { entries: o.entries ++ [entry] }
}

# The command line's options, and how many times to build.
fn options() -> api.Options = fold o = api.options-new(arg-at(1), "") for i in 2..arg-count(): with-flag(o, arg-at(i))

fn repeats() -> Int = (last i in 2..arg-count() for n in [arg-at(i)] if starts-with(n, "--repeat="): parse-int(after(n, "--repeat="))) ?? 1

fn run() -> Void = for-each-time(repeats(), options())

fn for-each-time(times: Int, o: api.Options) -> Void {
  for i in 0..times { api.build(o) }
}
