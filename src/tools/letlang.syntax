# A tiny language with ML's `let`, for checking what `.scopes` can say about where a name is seen.
syntax
start Expr
space Space
word NameChar
group "(" ")" Paren
precedence Expr Sum Atom ;
printwords "abcdefghijklmnopqrstuvwxyz0123456789_" ;

fragment Space = [ \t\n\r]* ;
fragment NameChar = [a-z0-9_] ;
fragment Kw = ("let" | "in") !NameChar ;
token Var = !Kw [a-z_] NameChar* ;
token Bind = !Kw [a-z_] NameChar* ;
token Num = [0-9]+ ;

rule Expr
  = "let" Bind "=" Expr "in" Expr -> Let(name, init, body)
  | Sum
  ;
infix Sum over Atom  left "+" Add ;
rule Atom
  = Num
  | Var
  | "(" Expr ")" -> Paren(inner)
  ;
