# Tailwind's compiler and scanner by themselves, for checking them against Tailwind's own:
#   twc parse FILE          the stylesheet as Tailwind's parser reads it, printed as its toCss prints it
#   twc decode VALUE…       each arbitrary value as Tailwind decodes it
#   twc values VALUE…       each value parsed and printed again
#   twc scan SOURCE…        the candidates the scanner finds for these sources, one a line
#   twc scanned-files SOURCE…  the files it reads for them
#   twc extract EXT FILE    the candidates in FILE's text, read as a file with extension EXT
# where each SOURCE is `--source BASE PATTERN` or `--not BASE PATTERN` (`@source not`).
rules tools.twc
use tailwind.ast as ast
use tailwind.candidate as cand
use tailwind.values as vp
use tailwind.theme as theme
use tailwind.numbers as num
use tailwind.utilities as ut
use tailwind.compile as tw
use tailwind.scan as scan
use tailwind.vite as tv
use css.sheet as csheet
use css.tokens as ctok
use css.color as ccolor
use css.values as cvals

main run on big stack

fn run() -> Void {
  let command = arg-at(1)
  match command {
    "parse" => write-standard-output!(ast.css(ast.parse(read-file(arg-at(2)), arg-at(2))))
    "decode" => write-standard-output!(join([cand.decode(arg-at(i)) ++ "\n" for i in 2..arg-count()], ""))
    "numbers" => write-standard-output!(join([js-number-text(arg-at(i)) ++ " " ++ js-number-scaled(arg-at(i), 100) ++ " " ++ js-parse-float(arg-at(i)) ++ " " ++ int-text(num.compare(arg-at(i), "a10")) ++ "\n" for i in 2..arg-count()], ""))
    "registry" => write-standard-output!(join([u.name ++ "\n" for u in ut.registry()], ""))
    "build" => write-standard-output!(tw.build(tw.compiler(read-file(arg-at(2)), real-path(arg-at(2))), [x for x in split(read-file(arg-at(3)), "\n") if x != ""], "4.3.5"))
    "read" => write-standard-output!(ast.css(tw.compiler(read-file(arg-at(2)), real-path(arg-at(2))).nodes))
    "root" => write-standard-output!(if tv.root?(real-path(arg-at(2))) then "true\n" else "false\n")
    "candidates" => write-standard-output!(join([c ++ "\n" for c in tv.candidates-of(real-path(arg-at(2)))], ""))
    "compiled" => write-standard-output!(tv.transformed(real-path(arg-at(2))) ?? "")
    "scan" => write-standard-output!(join([c ++ "\n" for c in scan.candidates(sources-of-args(2))], ""))
    "scan-entries" => write-standard-output!(scan.entries-text(sources-of-args(2)))
    "ignore-rule" => write-standard-output!(join([scan.rule-test(arg-at(2), arg-at(i)) ++ "\n" for i in 3..arg-count()], ""))
    "scanned-files" => write-standard-output!(join([f ++ "\n" for f in scan.scanned-files(sources-of-args(2))], ""))
    "extract" => write-standard-output!(join([c ++ "\n" for c in scan.content-candidates(read-file(arg-at(3)), arg-at(2))], ""))
    "tokens" => write-standard-output!(join([decl-line(d) ++ "\n" for d in declarations-in(csheet.parse(read-file(arg-at(2)), arg-at(2)))], ""))
    "floats" => write-standard-output!(join([float-line(arg-at(i)) ++ "\n" for i in 2..arg-count()], ""))
    "values" => write-standard-output!(join([vp.css(vp.parse(arg-at(i))) ++ "\n" for i in 2..arg-count()], ""))
    _ => fail-build("usage: twc parse FILE | read FILE | root FILE | candidates FILE | compiled FILE | build FILE CANDIDATES | scan SOURCE… | scanned-files SOURCE… | extract EXT FILE | tokens FILE | decode VALUE… | values VALUE…")
  }
}

# `--source BASE PATTERN` and `--not BASE PATTERN`, from argument `i` on.
fn sources-of-args(i: Int) -> [scan.Source] = match i {
  _ if i >= arg-count() => []
  _ if i + 2 >= arg-count() => fail-build("twc: a source is --source BASE PATTERN or --not BASE PATTERN")
  _ => match arg-at(i) {
    "--source" => [scan.Source(base: arg-at(i + 1), pattern: arg-at(i + 2), negated: false)] ++ sources-of-args(i + 3)
    "--not" => [scan.Source(base: arg-at(i + 1), pattern: arg-at(i + 2), negated: true)] ++ sources-of-args(i + 3)
    other => fail-build("twc: expected --source or --not, not " ++ other)
  }
}

fn float-line(t: Text) -> Text = f32-dtoa-text(x) ++ " " ++ f32-short-text(x) ++ " " ++ f32-short-text(x * 3.0 + 0.5 - -x / 2)
  ++ " " ++ (if x < 1.5 then "small" else "big") ++ " " ++ f32-short-text(f32-cbrt(x)) ++ " " ++ int-text(f32-to-i32(x))
  where x = css-number-of(t)

fn declarations-in(n: csheet.Node) -> [csheet.Node] = match n {
  csheet.Declaration(...) | csheet.CustomDeclaration(...) => [n]
  _ => [d for k in n.kids for d in declarations-in(k)]
}

fn decl-line(d: csheet.Node) -> Text = match d {
  csheet.Declaration(name, _, csheet.List(parts...), _, _) | csheet.CustomDeclaration(name, _, csheet.List(parts...), _, _) => name.text ++ ": " ++ ctok.tokens-text(ts) ++ "  |  "
    ++ (match ccolor.color-only(ts) { some(c) => ccolor.color-text(c, true)  none => "-" })
    where ts = ctok.tokens-of(parts)
}
