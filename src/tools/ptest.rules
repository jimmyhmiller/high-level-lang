# A small test of parallel-map and task state, run before anything real uses them.
rules tools.ptest

main run on big stack

task state scratch: [Int] = []
state shared-count: Int = 0

# Arithmetic, mostly: lists come from an arena that is never freed. The task state checks that
# each thread has its own: another thread's writes would change the sum.
fn work(n: Int) -> Int {
  scratch = [n]
  var total = 0
  for i in 0..n * 20000 {
    total = (total + i * 7 + scratch[0]) % 1000003
  }
  total + scratch[0]
}

fn run() -> Void {
  let xs = [i for i in 0..200]
  let one = parallel-map(xs, work, 1)
  let many = parallel-map(xs, work, 8)
  var same = true
  for i in 0..len(xs) {
    if one[i] != many[i] { same = false }
  }
  let t0 = now-ms()
  for r in 0..5 { parallel-map(xs, work, 1) }
  let t1 = now-ms()
  for r in 0..5 { parallel-map(xs, work, 8) }
  let t2 = now-ms()
  print "same results: {}; 1 thread {} ms, 8 threads {} ms", same, t1 - t0, t2 - t1
}
