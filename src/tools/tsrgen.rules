rules tools.tsrgen
use tanstack.pretty as pretty
use tanstack.routes as routes

main run on big stack

# tsrgen format FILE [semi] [double]: FILE printed as Prettier prints it.
# tsrgen generate ROOT: the route tree of the project at ROOT, and its route files, written.
# tsrgen print ROOT: the route tree, printed, nothing written.
fn run() -> Void = match arg-at(1) {
  "format" => write-standard-output!(pretty.formatted(read-file(arg-at(2)), arg-at(2), any i in 3..arg-count(): arg-at(i) == "semi", not (any i in 3..arg-count(): arg-at(i) == "double")))
  "generate" => routes.generate!(arg-at(2))
  "print" => write-standard-output!(routes.generated(arg-at(2)).text)
  _ => panic "usage: tsrgen format FILE [semi] [double] | generate ROOT | print ROOT"
}
