# Test driver for the JavaScript parser.
#   jsparse print FILE        print the compact form to stdout
#   jsparse check LISTFILE    parse each path in LISTFILE; report the ones that fail
#   jsparse pieces FILE       where a big file is cut for parsing at once, and whether each piece parses
#   jsparse bench LIST N      each file parsed N times on one thread, and its early errors checked
#                             N times: per file, `BENCH path bytes parse-best parse-median check-best
#                             check-median`, in microseconds
# A path ending in .module.js parses with module flags (top-level await).
rules tools.jsparse over bundle.js
use bundle.js as js
use bundle.early as early
use bundle.modules as m
use bundle.coarse as co
use bundle.jspieces as jsp

main run on big stack

fn module-file?(path: Text) -> Bool = ends-with(path, ".module.js")
fn typescript-file?(path: Text) -> Bool =
  ends-with(path, ".ts") or ends-with(path, ".tsx") or ends-with(path, ".mts") or ends-with(path, ".cts")
fn flags-for(path: Text) -> Int =
  (if module-file?(path) then js.flag-bit("await") else 0)
    + (if ends-with(path, ".jsx") or ends-with(path, ".tsx") then js.flag-bit("jsx") else 0)
    + (if typescript-file?(path) then js.flag-bit("ts") else 0)

fn lines-of(text: Text) -> [Text] {
  var out: [Text] = []
  var start = 0
  for i in 0..len(text) {
    if text[i] == '\n' {
      if i > start { out += text[start..i] }
      start = i + 1
    }
  }
  out
}

# How long parsing takes, and the early-error check after it, each by itself: the best and the
# median of `rounds` runs, after one that settles how the file parses (as the bundler parses it: a
# script, else with top-level `await`). One thread; the bundler parses a big file in pieces at once.
fn bench-list(list: Text, rounds: Int) -> Void {
  for path in lines-of(read-file(list)) {
    let src = read-file(path)
    let plain = flags-for(path)
    let flags = if is-some(js.parse-opt(src, path, plain)) then plain else plain + js.flag-bit("await")
    match js.parse-opt(src, path, flags) {
      none => print "SKIP {} does not parse", path
      some(tree) => {
        let is-module = module-file?(path) or early.program-has-module-syntax?(tree)
        var parses: [Int] = []
        var checks: [Int] = []
        for r in 0..rounds {
          let a = now-us()
          let t = js.parse-opt(src, path, flags)
          let b = now-us()
          let found = early.check(t ?? tree, is-module, true, typescript-file?(path))
          let c = now-us()
          if is-some(found) { panic "{}: an early error the first check did not find", path }
          parses += b - a
          checks += c - b
        }
        print "BENCH {} {} {} {} {} {}", path, len(src), best(parses), median(parses), best(checks), median(checks)
      }
    }
  }
}

fn best(xs: [Int]) -> Int = fold m = xs[0] for x in xs: min(m, x)
fn median(xs: [Int]) -> Int = (sort x in xs by x)[len(xs) / 2]

fn check-list(list: Text, quiet: Bool, allow-return: Bool, script-goal: Bool) -> Void {
  var good = 0
  var bad = 0
  for path in lines-of(read-file(list)) {
    let src = read-file(path)
    # Library code parses as the bundler parses it: as a script, and failing that, with top-level
    # `await` (what a module without imports or exports may have). A test262 file says its goal.
    let tree = match js.parse-opt(src, path, flags-for(path)) {
      some(t) => some(t)
      none => if script-goal then none else js.parse-opt(src, path, flags-for(path) + js.flag-bit("await"))
    }
    match tree {
      some(tree) => {
        # Library code here is CommonJS or an ES module, which the syntax decides. A test262 file
        # says so by its name.
        let is-module = module-file?(path) or (not script-goal and early.program-has-module-syntax?(tree))
        match early.check(tree, is-module, allow-return, typescript-file?(path)) {
          none => {
            good += 1
            if quiet { print "OK {}", path }
          }
          some(p) => {
            bad += 1
            if not quiet { print "FAIL {}:{}:{} {}", path, line-of(src, p.at), col-of(src, p.at), p.message }
          }
        }
      }
      none => {
        bad += 1
        if not quiet {
          print "FAIL {}:{}:{} expected {} found {:?}", last-parse-path(), last-parse-line(), last-parse-col(), last-parse-want(), last-parse-found()
        }
      }
    }
  }
  print "parsed {} failed {}", good, bad
}

# Print each listed file to OUTDIR/<index>.js, for differential testing.
fn print-all(list: Text, outdir: Text) -> Void {
  var i = 0
  for path in lines-of(read-file(list)) {
    match js.parse-opt(read-file(path), path, flags-for(path)) {
      some(tree) => write-file(outdir ++ "/" ++ int-text(i) ++ ".js", js.render(tree, false))
      none => {}
    }
    i += 1
  }
}

fn run() -> Int {
  let cmd = if arg-count() > 1 then arg-at(1) else ""
  let arg = if arg-count() > 2 then arg-at(2) else ""
  match cmd {
    "print" => {
      let src = read-file(arg)
      match js.parse-opt(src, arg, flags-for(arg)) {
        some(tree) => print "{}", js.render(tree, false)
        none => fail-last-parse()
      }
      0
    }
    "printall" => { print-all(arg, arg-at(3)) 0 }
    "pieces" => {
      let src = read-file(arg)
      let read = if is-some(co.parse-opt(src, "<coarse>", 0)) then "reads" else "does not read"
      let sp = jsp.parts-of-source(src)
      let inside = if sp.open >= 0 then " inside the function body at " ++ int-text(sp.open) ++ " to " ++ int-text(sp.close) else ""
      print "{} bytes; the coarse grammar {} it; {} pieces{}", len(src), read, len(sp.starts), inside
      let trees = [js.parse-piece(src[0..jsp.piece-end(sp, k)], arg, 0, sp.starts[k]) for k in 0..len(sp.starts)]
      for k in 0..len(sp.starts) {
        print "  {} at {} (line {}): {}", k, sp.starts[k], line-of(src, sp.starts[k]), if is-some(trees[k]) then "parses" else "DOES NOT PARSE"
      }
      if sp.open >= 0 and (all t in trees: is-some(t)) {
        match jsp.assembled(sp, arg, [t for some(t) in trees]) {
          some(tree) => match js.parse-opt(src, arg, 0) {
            some(whole) => print "put together: {}", if same-tree?(tree, whole) then "the same tree as parsing it whole" else "DIFFERENT from parsing it whole: " ++ first-difference(tree, whole)
            none => print "put together, but the whole file does not parse"
          }
          none => print "NOT put together: the blank is no one empty function body, or a piece has module syntax"
        }
      }
      0
    }
    "apart" => { apart-list(arg) 0 }
    "check" => { check-list(arg, false, true, false) 0 }
    # test262 is strict about a top-level return; library code is often CommonJS.
    "strict" => { check-list(arg, false, false, true) 0 }
    "accepted" => { check-list(arg, true, false, true) 0 }
    "bench" => { bench-list(arg, if arg-count() > 3 then parse-int(arg-at(3)) else 5) 0 }
    _ => {
      print "usage: jsparse print FILE | check LIST | accepted LIST"
      1
    }
  }
}

# Two trees alike in every node: kind, text, place and children.
# Each file of a list parsed in pieces and whole: the same tree, or it says where they part. (With
# HL_ALONE=never, or one thread cuts nothing.)
fn apart-list(list: Text) -> Void {
  var cut = 0
  var bad = 0
  for path in lines-of(read-file(list)) {
    let src = read-file(path)
    let flags = (if ends-with(path, ".jsx") or ends-with(path, ".tsx") then js.flag-bit("jsx") else 0)
                + (if typescript-file?(path) then js.flag-bit("ts") else 0)
    match jsp.parsed-apart(src, path, flags) {
      none => 0
      some(tree) => {
        cut += 1
        match js.parse-opt(src, path, flags) {
          some(whole) => if not same-tree?(tree, whole) {
            bad += 1
            print "DIFFERS {}: {}", path, first-difference(tree, whole)
          }
          none => {
            bad += 1
            print "DIFFERS {}: its pieces parse and the whole does not", path
          }
        }
      }
    }
  }
  print "cut {} differ {}", cut, bad
}

fn same-tree?(a: Node, b: Node) -> Bool =
  a.kind == b.kind and a.text == b.text and a.lo == b.lo and a.hi == b.hi and len(a.kids) == len(b.kids)
  and (all i in 0..len(a.kids): same-tree?(a.kids[i], b.kids[i]))

fn first-difference(a: Node, b: Node) -> Text =
  if a.kind != b.kind or a.text != b.text or a.lo != b.lo or a.hi != b.hi or len(a.kids) != len(b.kids)
  then js.kind-name(a.kind) ++ " " ++ int-text(a.lo) ++ ".." ++ int-text(a.hi) ++ " (" ++ int-text(len(a.kids)) ++ " children) against "
       ++ js.kind-name(b.kind) ++ " " ++ int-text(b.lo) ++ ".." ++ int-text(b.hi) ++ " (" ++ int-text(len(b.kids)) ++ " children)"
  else (first i in 0..len(a.kids): if same-tree?(a.kids[i], b.kids[i]) then none else some(first-difference(a.kids[i], b.kids[i]))) ?? "none"
