# What the rules language's forms mean, checked by running them: a map literal, `++` of maps, a
# `var` that copies what it starts from, a fold that adds to its accumulator in place, and the
# patterns: text, lists, records, several values at once; quantifiers with clauses; `where`.
# Prints each check and exits non-zero on the first that fails.
rules tools.langtest

main run on big stack

record Box { items: [Int], seen: {Text:Int} }

fn check(name: Text, ok: Bool) -> Void {
  if not ok { panic "langtest: {} failed", name }
  print "ok   {}", name
}

fn kept(xs: [Int]) -> Box = Box(items: xs, seen: {})

fn stem-of(path: Text) -> Text = match path {
  "./" ++ rest => stem-of(rest)
  stem ++ ".js" | stem ++ ".jsx" => stem
  _ => path
}

fn shape(xs: [Int]) -> Text = match xs {
  [] => "empty"
  [x] => "one"
  [x, y] if x == y => "pair of the same"
  [x, rest...] if len(rest) > 2 => "long"
  [..., z] => "ends " ++ int-text(z)
}

fn box-kind(b: Box) -> Text = match b {
  Box(items: [], ...) => "no items"
  Box(items: [only], seen: s) => "one, " ++ int-text(only)
  _ => "more"
}

fn two(a: [Text], b: Text) -> Int = match a, b {
  [], "" => 0
  ["**", rest...], _ => 1 + len(rest)
  [x, ...], y if x == y => 10
  _, _ => -1
}

fn exponent(s: Text) -> Text = match s {
  m ++ "e+" ++ x => m ++ "|" ++ x
  "/*" ++ inner ++ "*/" => inner
  m ++ "e" ++ x => m ++ "|" ++ x
  _ => "none"
}

record Tally { seen: {Text:Int}, order: [Text], count: Int }

fn counted(start: Tally, ws: [Text]) -> Tally = fold t = start for w in ws:
  t with { seen: t.seen ++ {w: (t.seen[w] ?? 0) + 1}, order: t.order ++ [w ++ int-text(len(t.order))], count: t.count + 1 }

fn hyp(a: Int, b: Int) -> Int = aa + bb where bb = b * b, aa = a * a

fn edges(n: Text) -> [Text] = match n {
  "a" => ["b", "c"]
  "b" => ["d"]
  "c" => ["d", "a"]
  "e" => ["b"]
  _ => []
}

fn run() -> Void {
  let m = {"a": 1, "b": 2}
  check("a map literal holds its entries", (m["a"] ?? 0) == 1 and (m["b"] ?? 0) == 2 and len(keys(m)) == 2)
  let both = m ++ {"b": 20, "c": 3}
  check("++ of maps: the right wins, the left is unchanged",
        (both["b"] ?? 0) == 20 and (both["c"] ?? 0) == 3 and (m["b"] ?? 0) == 2 and not ("c" in m))

  var copy = m
  copy["a"] = 100
  check("a var copies the map it starts from", (m["a"] ?? 0) == 1 and (copy["a"] ?? 0) == 100)

  let squares: [Int] = fold acc = [] for i in 0..5: acc ++ [i * i]
  check("a fold appends", len(squares) == 5 and squares[4] == 16)
  let start = [7]
  let grown = fold acc = start for i in 0..3: acc ++ [i]
  check("a fold starting from a name leaves it alone", len(start) == 1 and len(grown) == 4)

  # The accumulator as it stood before the step, for each item of the step.
  let sizes: [Int] = fold acc = [] for i in 0..3: acc ++ [len(acc), len(acc)]
  check("a step that reads the accumulator sees it before the step", len(sizes) == 6 and sizes[2] == 2 and sizes[3] == 2)

  # A value made from the accumulator keeps what it saw.
  let boxes: [Box] = fold acc = [] for i in 0..3: acc ++ [kept([b.items[0] for b in acc] ++ [i])]
  check("an item made from the accumulator", len(boxes) == 3 and len(boxes[2].items) == 3)

  # One item or none, chosen by what the accumulator holds.
  let runs: [Int] = fold acc = [] for x in [1, 1, 2, 2, 2, 3]: acc ++ (if len(acc) > 0 and last(acc) == x then [] else [x])
  check("a step that chooses by the accumulator", len(runs) == 3 and runs[2] == 3)

  let counts: {Text:Int} = fold acc = {} for w in ["x", "y", "x"]: acc ++ {w: (acc[w] ?? 0) + 1}
  check("a fold adds to a map", (counts["x"] ?? 0) == 2 and (counts["y"] ?? 0) == 1)
  let base = {"z": 9}
  let more = fold acc = base for w in ["p"]: acc ++ {w: 1}
  check("a map fold starting from a name leaves it alone", len(keys(base)) == 1 and len(keys(more)) == 2)
  check("a text pattern takes a prefix, then a suffix", stem-of("./a/b.jsx") == "a/b" and stem-of("c.ts") == "c.ts")
  check("list patterns", shape([]) == "empty" and shape([4]) == "one" and shape([2, 2]) == "pair of the same"
                         and shape([1, 2, 3, 4]) == "long" and shape([1, 5]) == "ends 5")
  check("record patterns", box-kind(kept([])) == "no items" and box-kind(kept([3])) == "one, 3" and box-kind(kept([1, 2])) == "more")
  check("a match on two values", two([], "") == 0 and two(["**", "a", "b"], "x") == 3 and two(["q"], "q") == 10
                                 and two(["q"], "r") == -1)
  check("where: equations in any order", hyp(3, 4) == 25)
  check("a literal between two patterns, at its first place; a literal at both ends",
        exponent("1.5e+21") == "1.5|21" and exponent("2e3e4") == "2|3e4" and exponent("/* a */") == " a " and exponent("12") == "none")
  check("first with a clause, and a value that is no option",
        ((first x in [1, 2, 3, 4] if x > 2: x * 10) ?? 0) == 30 and is-none(first x in [1] if x > 5: x))
  check("any and count with clauses", (any x in [1, 2] for y in [2, 3]: x == y) and (count x in [1, 2, 3] if x > 1: x < 3) == 1)
  check("an option is a list of one or none", (sum x in some(4): x) == 4 and (sum x in [5, 6][0..0]: x) == 0
        and len([y for y in first x in [7, 8]: some(x)]) == 1)
  let empty = Tally(seen: {}, order: [], count: 0)
  let t = counted(empty, ["a", "b", "a"])
  check("a record fold: each field from the record before the step",
        (t.seen["a"] ?? 0) == 2 and len(t.order) == 3 and t.order[2] == "a2" and t.count == 3)
  check("a record fold leaves the record it started from alone", len(empty.order) == 0 and len(keys(empty.seen)) == 0)
  let fresh = fold t = Tally(seen: {}, order: [], count: 0) for w in ["x", "x"]: t with { seen: t.seen ++ {w: len(t.order)}, order: t.order ++ [w] }
  check("a record fold from a new record", (fresh.seen["x"] ?? 0) == 1 and len(fresh.order) == 2)
  # a -> b, c; b -> d; c -> d, a; d -> (nothing); and a second root e -> b.
  let w = depth-first(["a", "e"], edges)
  check("a depth-first walk reaches each node once, in order", join(w.pre, " ") == "a b d c e")
  check("a depth-first walk finishes children first", join([w.pre[i] for i in w.post], " ") == "d b c a e")
  check("a depth-first walk says what reached each node",
        join([int-text(p) for p in w.parent], " ") == "-1 0 1 0 -1" and join([int-text(x) for x in w.slot], " ") == "-1 0 0 1 -1")
  print "all checks passed"
}
