# What the rules language's collection forms mean, checked by running them: a map literal, `++` of
# maps, a `var` that copies what it starts from, and a fold that adds to its accumulator in place.
# Prints each check and exits non-zero on the first that fails.
rules tools.langtest

main run on big stack

record Box { items: [Int], seen: {Text:Int} }

fn check(name: Text, ok: Bool) -> Void {
  if not ok { panic "langtest: {} failed", name }
  print "ok   {}", name
}

fn kept(xs: [Int]) -> Box = Box(items: xs, seen: {})

fn run() -> Void {
  let m = {"a": 1, "b": 2}
  check("a map literal holds its entries", (m["a"] ?? 0) == 1 and (m["b"] ?? 0) == 2 and len(keys(m)) == 2)
  let both = m ++ {"b": 20, "c": 3}
  check("++ of maps: the right wins, the left is unchanged",
        (both["b"] ?? 0) == 20 and (both["c"] ?? 0) == 3 and (m["b"] ?? 0) == 2 and not ("c" in m))

  var copy = m
  copy["a"] = 100
  check("a var copies the map it starts from", (m["a"] ?? 0) == 1 and (copy["a"] ?? 0) == 100)

  let squares: [Int] = fold acc = [] for i in 0..5: acc ++ [i * i]
  check("a fold appends", len(squares) == 5 and squares[4] == 16)
  let start = [7]
  let grown = fold acc = start for i in 0..3: acc ++ [i]
  check("a fold starting from a name leaves it alone", len(start) == 1 and len(grown) == 4)

  # The accumulator as it stood before the step, for each item of the step.
  let sizes: [Int] = fold acc = [] for i in 0..3: acc ++ [len(acc), len(acc)]
  check("a step that reads the accumulator sees it before the step", len(sizes) == 6 and sizes[2] == 2 and sizes[3] == 2)

  # A value made from the accumulator keeps what it saw.
  let boxes: [Box] = fold acc = [] for i in 0..3: acc ++ [kept([b.items[0] for b in acc] ++ [i])]
  check("an item made from the accumulator", len(boxes) == 3 and len(boxes[2].items) == 3)

  let counts: {Text:Int} = fold acc = {} for w in ["x", "y", "x"]: acc ++ {w: (acc[w] ?? 0) + 1}
  check("a fold adds to a map", (counts["x"] ?? 0) == 2 and (counts["y"] ?? 0) == 1)
  let base = {"z": 9}
  let more = fold acc = base for w in ["p"]: acc ++ {w: 1}
  check("a map fold starting from a name leaves it alone", len(keys(base)) == 1 and len(keys(more)) == 2)
  print "all checks passed"
}
