# What the rules language's forms mean, checked by running them: a map literal, `++` of maps, a
# `var` that copies what it starts from, a fold that adds to its accumulator in place, and the
# patterns: text, lists, records, several values at once; quantifiers with clauses; `where`.
# Prints each check and exits non-zero on the first that fails.
rules tools.langtest
use tools.langfacts as lf
use tools.letlang as ll
use tools.letscope as ls
use hl.graph as graph

main run on big stack

record Box { items: [Int], seen: {Text:Int} }
boxed record SharedValue { count: Int, items: [Int] }
record SharedContainer { value: SharedValue }
setting shared-value: SharedValue
memo fn shared-total() -> Int = shared-value.count + (sum x in shared-value.items: x)
memo fn shared-key(v: SharedValue) -> Int = v.count + len(v.items)
state slice-calls: Int = 0
fn slice-bound(n: Int) -> Int {
  slice-calls += 1
  n
}

enum Access { Read, Write }
record MemoRequest { access: Access, path: Text, parts: [Int] }
memo fn access-value(access: Access) -> Int = match access { Read => 1 Write => 2 }
memo fn request-value(request: MemoRequest) -> Text = request.path ++ ":" ++ int-text(access-value(request.access))
  ++ ":" ++ join([int-text(part) for part in request.parts], ",")

fn check(name: Text, ok: Bool) -> Void {
  if not ok { panic "langtest: {} failed", name }
  print "ok   {}", name
}

fn kept(xs: [Int]) -> Box = Box(items: xs, seen: {})

fn stem-of(path: Text) -> Text = match path {
  "./" ++ rest => stem-of(rest)
  stem ++ ".js" | stem ++ ".jsx" => stem
  _ => path
}

fn shape(xs: [Int]) -> Text = match xs {
  [] => "empty"
  [x] => "one"
  [x, y] if x == y => "pair of the same"
  [x, rest...] if len(rest) > 2 => "long"
  [..., z] => "ends " ++ int-text(z)
}

fn box-kind(b: Box) -> Text = match b {
  Box(items: [], ...) => "no items"
  Box(items: [only], seen: s) => "one, " ++ int-text(only)
  _ => "more"
}

fn two(a: [Text], b: Text) -> Int = match a, b {
  [], "" => 0
  ["**", rest...], _ => 1 + len(rest)
  [x, ...], y if x == y => 10
  _, _ => -1
}

fn exponent(s: Text) -> Text = match s {
  m ++ "e+" ++ x => m ++ "|" ++ x
  "/*" ++ inner ++ "*/" => inner
  m ++ "e" ++ x => m ++ "|" ++ x
  _ => "none"
}

record Tally { seen: {Text:Int}, order: [Text], count: Int }

fn counted(start: Tally, ws: [Text]) -> Tally = fold t = start for w in ws:
  t with { seen: t.seen ++ {w: (t.seen[w] ?? 0) + 1}, order: t.order ++ [w ++ int-text(len(t.order))], count: t.count + 1 }

fn hyp(a: Int, b: Int) -> Int = aa + bb where bb = b * b, aa = a * a

fn edges(n: Text) -> [Text] = match n {
  "a" => ["b", "c"]
  "b" => ["d"]
  "c" => ["d", "a"]
  "e" => ["b"]
  _ => []
}

fn item-count(b: Box) -> Int = len(b.items)
fn first-item(b: Box) -> Int = b.items[0]
fn twice(n: Int) -> Int = n * 2
fn inc(n: Int) -> Int = n + 1
fn gone(why: Text) -> Never = panic "langtest: {}", why

fn guarded-items(ok: Bool) -> [Int] = match ok {
  true => [4, 5]
  false => gone("guarded-items was rejected")
}

fn run() -> Void {
  let shared = SharedValue(count: 3, items: [4, 5])
  let changed = shared with { count: 8, items: shared.items ++ [6] }
  check("boxed records retain value semantics", shared.count == 3 and len(shared.items) == 2 and changed.count == 8 and len(changed.items) == 3)
  check("boxed records compare by fields", shared == SharedValue(count: 3, items: [4, 5]) and shared != changed)
  check("enclosing records retain value equality", SharedContainer(value: shared) == SharedContainer(value: SharedValue(count: 3, items: [4, 5])))
  check("boxed record patterns", match changed { SharedValue(count: 8, items: [4, 5, 6]) => true _ => false })
  check("boxed records work in collections", ([shared, changed][1]).count == 8 and ({"x": shared}["x"] ?? changed).count == 3)
  let copied = [v with { count: v.count + 1 } for v in [shared, changed]]
  check("boxed values copied from collection references", copied[0].count == 4 and copied[1].count == 9 and shared.count == 3)
  check("boxed records make value-based memo keys", shared-key(shared) == 5 and shared-key(changed) == 11 and shared-key(SharedValue(count: 3, items: [4, 5])) == 5)
  check("boxed settings update kept answers", (with shared-value = shared { shared-total() }) == 12 and (with shared-value = changed { shared-total() }) == 23)
  let sliced = [5, 6, 7][slice-bound(0)..slice-bound(2)]
  check("slice bounds are evaluated once", slice-calls == 2 and len(sliced) == 2 and sliced[0] == 5 and sliced[1] == 6)
  check("a reversed slice is empty", len([5, 6, 7][2..1]) == 0)
  check("enum memo keys retain distinct variants", access-value(Read) == 1 and access-value(Write) == 2 and access-value(Read) == 1)
  check("record memo keys recursively encode enum and list fields",
    request-value(MemoRequest(access: Read, path: "source", parts: [1, 2])) == "source:1:1,2"
    and request-value(MemoRequest(access: Write, path: "source", parts: [1, 2])) == "source:2:1,2"
    and request-value(MemoRequest(access: Read, path: "source", parts: [12])) == "source:1:12")

  let list-options = {"full": [1, 2]}
  check("an optional list is one list or none, not its elements", (sum xs in list-options["full"]: len(xs)) == 2
        and (sum xs in list-options["missing"]: len(xs)) == 0)
  let map-options = {"full": {"x": 7}}
  check("an optional map is one map or none, not its keys", (sum m in map-options["full"]: m["x"] ?? 0) == 7
        and (sum m in map-options["missing"]: len(keys(m))) == 0)
  let components = graph.components([[1], [2], [0, 3], [4], [3], []])
  check("graph components preserve cycles and isolated vertices", join([int-text(x) for x in components], " ") == "0 0 0 3 3 5")
  check("an empty graph has no components", len(graph.components([])) == 0)
  let safe = graph.closed-safe([[1], [2], [1], []], [true, true, false, true])
  check("unsafe graph dependencies propagate through cycles without affecting isolated vertices", not safe[0] and not safe[1] and not safe[2] and safe[3])
  let buckets = graph.buckets([2, 0, 2, 0])
  check("dense graph buckets retain each vertex once in label order", len(buckets) == 2 and buckets[0][0] == 1 and buckets[0][1] == 3
        and buckets[1][0] == 0 and buckets[1][1] == 2)
  let demand = graph.propagated([[1], [2], [1], []], [[7], [9], [], [3]])
  check("consumer labels propagate through dependencies and cycles without duplication", demand[0][0] == 7
        and len(demand[1]) == 2 and demand[1][0] == 7 and demand[1][1] == 9
        and len(demand[2]) == 2 and demand[3][0] == 3)
  check("a constant made from one written after it has that one's value", join(later-texts, "") == "AB")
  check("json of a record, its lists, options and text, as its type says",
        json(Shaped(name: "a\"b", sizes: [1, 2], inner: [Inner(on: true, note: none), Inner(on: false, note: some("x"))])) ==
        "{\"name\":\"a\\\"b\",\"sizes\":[1,2],\"inner\":[{\"on\":true,\"note\":null},{\"on\":false,\"note\":\"x\"}]}")
  let shaped = Shaped(name: "a\"b\né 😀", sizes: [1, -2, 300], inner: [Inner(on: true, note: none), Inner(on: false, note: some("x"))])
  check("read-json reads back what json writes, as the type wanted says", json(shaped-back(json(shaped))) == json(shaped))
  check("read-json reads escapes, other spacing and fields in another order",
        json(shaped-back("{ \"sizes\" : [ ], \"inner\": [], \"name\": \"\\u00e9\\ud83d\\ude00\\n\" }")) == json(Shaped(name: "é😀\n", sizes: [], inner: [])))
  let lists = [[1, 2], [], [3]]
  let owners = [k for k in 0..len(lists) for x in lists[k]]
  check("a comprehension repeats its outer value once for each inner item it does not use", join([int-text(x) for x in owners], " ") == "0 0 2")
  let flipped = flipped-edges([[1], [0, 2], [], [0]])
  let big = [[(k * 7 + j * 13) % 300 for j in 0..(k % 5)] for k in 0..300]
  let big-flipped = flipped-edges(big)
  let brute = [[k for k in 0..300 if any y in big[k]: y == x] for x in 0..300]
  check("a big graph reversed through parallel comprehensions keeps each edge's ends together",
        all x in 0..300: join([int-text(v) for v in sort v in big-flipped[x] by v], ",") == join([int-text(v) for v in sort v in brute[x] by v], ","))
  check("a graph reversed through parallel comprehensions keeps each edge's ends together",
        join([join([int-text(x) for x in xs], ",") for xs in flipped], " ") == "1,3 0 1 ")
  let least = graph.reached-min([[1], [2], [1, 3], [], [0]], [5, 9, 8, 2, 7])
  check("the least value reached passes through cycles and stops at what is not reached",
        join([int-text(x) for x in least], " ") == "2 2 2 2 2")
  let apart = graph.reached-min([[1], [], [3], [2], []], [4, 6, 9, 1, 3])
  check("the least value reached is each vertex's own where it reaches nothing smaller", join([int-text(x) for x in apart], " ") == "4 6 1 1 3")
  let deep = graph.reached-min([[i + 1 for j in [i] if i < 19999] for i in 0..20000], [20000 - i for i in 0..20000])
  check("the least value reached does not use the native stack for depth", deep[0] == 1 and deep[19999] == 1)
  let chain = graph.components([[i + 1 for j in [i] if i < 19999] for i in 0..20000])
  check("graph traversal does not use the native stack for depth", len(chain) == 20000 and chain[19999] == 19999)
  check("a fused list match can have a non-returning error arm", join([int-text(x) for x in guarded-items(true)], " ") == "4 5")
  let m = {"a": 1, "b": 2}
  check("a map literal holds its entries", (m["a"] ?? 0) == 1 and (m["b"] ?? 0) == 2 and len(keys(m)) == 2)
  let both = m ++ {"b": 20, "c": 3}
  check("++ of maps: the right wins, the left is unchanged",
        (both["b"] ?? 0) == 20 and (both["c"] ?? 0) == 3 and (m["b"] ?? 0) == 2 and not ("c" in m))

  var copy = m
  copy["a"] = 100
  check("a var copies the map it starts from", (m["a"] ?? 0) == 1 and (copy["a"] ?? 0) == 100)

  let squares: [Int] = fold acc = [] for i in 0..5: acc ++ [i * i]
  check("a fold appends", len(squares) == 5 and squares[4] == 16)
  let start = [7]
  let grown = fold acc = start for i in 0..3: acc ++ [i]
  check("a fold starting from a name leaves it alone", len(start) == 1 and len(grown) == 4)

  # The accumulator as it stood before the step, for each item of the step.
  let sizes: [Int] = fold acc = [] for i in 0..3: acc ++ [len(acc), len(acc)]
  check("a step that reads the accumulator sees it before the step", len(sizes) == 6 and sizes[2] == 2 and sizes[3] == 2)

  # A value made from the accumulator keeps what it saw.
  let boxes: [Box] = fold acc = [] for i in 0..3: acc ++ [kept([b.items[0] for b in acc] ++ [i])]
  check("an item made from the accumulator", len(boxes) == 3 and len(boxes[2].items) == 3)

  # One item or none, chosen by what the accumulator holds.
  let runs: [Int] = fold acc = [] for x in [1, 1, 2, 2, 2, 3]: acc ++ (if len(acc) > 0 and last(acc) == x then [] else [x])
  check("a step that chooses by the accumulator", len(runs) == 3 and runs[2] == 3)

  let counts: {Text:Int} = fold acc = {} for w in ["x", "y", "x"]: acc ++ {w: (acc[w] ?? 0) + 1}
  check("a fold adds to a map", (counts["x"] ?? 0) == 2 and (counts["y"] ?? 0) == 1)
  let base = {"z": 9}
  let more = fold acc = base for w in ["p"]: acc ++ {w: 1}
  check("a map fold starting from a name leaves it alone", len(keys(base)) == 1 and len(keys(more)) == 2)
  check("a text pattern takes a prefix, then a suffix", stem-of("./a/b.jsx") == "a/b" and stem-of("c.ts") == "c.ts")
  check("list patterns", shape([]) == "empty" and shape([4]) == "one" and shape([2, 2]) == "pair of the same"
                         and shape([1, 2, 3, 4]) == "long" and shape([1, 5]) == "ends 5")
  check("record patterns", box-kind(kept([])) == "no items" and box-kind(kept([3])) == "one, 3" and box-kind(kept([1, 2])) == "more")
  check("a match on two values", two([], "") == 0 and two(["**", "a", "b"], "x") == 3 and two(["q"], "q") == 10
                                 and two(["q"], "r") == -1)
  check("where: equations in any order", hyp(3, 4) == 25)
  check("a literal between two patterns, at its first place; a literal at both ends",
        exponent("1.5e+21") == "1.5|21" and exponent("2e3e4") == "2|3e4" and exponent("/* a */") == " a " and exponent("12") == "none")
  check("first with a clause, and a value that is no option",
        ((first x in [1, 2, 3, 4] if x > 2: x * 10) ?? 0) == 30 and is-none(first x in [1] if x > 5: x))
  check("any and count with clauses", (any x in [1, 2] for y in [2, 3]: x == y) and (count x in [1, 2, 3] if x > 1: x < 3) == 1)
  check("an option is a list of one or none", (sum x in some(4): x) == 4 and (sum x in [5, 6][0..0]: x) == 0
        and len([y for y in first x in [7, 8]: some(x)]) == 1)
  let empty = Tally(seen: {}, order: [], count: 0)
  let t = counted(empty, ["a", "b", "a"])
  check("a record fold: each field from the record before the step",
        (t.seen["a"] ?? 0) == 2 and len(t.order) == 3 and t.order[2] == "a2" and t.count == 3)
  check("a record fold leaves the record it started from alone", len(empty.order) == 0 and len(keys(empty.seen)) == 0)
  let fresh = fold t = Tally(seen: {}, order: [], count: 0) for w in ["x", "x"]: t with { seen: t.seen ++ {w: len(t.order)}, order: t.order ++ [w] }
  check("a record fold from a new record", (fresh.seen["x"] ?? 0) == 1 and len(fresh.order) == 2)
  # a -> b, c; b -> d; c -> d, a; d -> (nothing); and a second root e -> b.
  let w = depth-first(["a", "e"], edges)
  check("a depth-first walk reaches each node once, in order", join(w.pre, " ") == "a b d c e")
  check("a depth-first walk finishes children first", join([w.pre[i] for i in w.post], " ") == "d b c a e")
  check("a depth-first walk says what reached each node",
        join([int-text(p) for p in w.parent], " ") == "-1 0 1 0 -1" and join([int-text(x) for x in w.slot], " ") == "-1 0 0 1 -1")
  let by-name = {"count": item-count, "first": first-item}
  let counting = by-name["count"] ?? gone("a map of functions lost one")
  check("a map of functions over a record, one taken by name", counting(kept([4, 5, 6])) == 3)
  check("an optional function is an option", is-none(by-name["last"]) and is-some(by-name["first"]))
  check("a list of functions, folded", (fold x = 1 for f in [twice, inc, twice]: f(x)) == 6)
  let graph = [lf.fact-root(1), lf.fact-edge(1, 2), lf.fact-edge(2, 3), lf.fact-edge(4, 5)]
  let db = lf.solved(graph)
  check("a query over a database held by let", len([x for db.reach(?x)]) == 3 and join([int-text(g) for db.edge(2, ?g)], " ") == "3")
  check("a question to a database held by let", db.reach(3) and not db.reach(4) and db.edge(_, 5))
  check("a query over a database passed by value", reached(db) == 3)
  check("a database a call makes, passed to a function", reached(lf.solved(graph)) == 3)
  let count-of = reached
  check("a database passed through a function value", count-of(db) == 3 and count-of(lf.solved(graph)) == 3)
  check("a database passed on through functions, and asked again after", reached-twice(db) == 6 and reached(db) == 3)
  check("a query over a database a call makes", len([f for lf.solved(graph).edge(?f, _)]) == 3)
  let weighed = lf.solved([lf.fact-root(1), lf.fact-edge(1, 2), lf.fact-edge(1, 3), lf.fact-edge(2, 2), lf.fact-edge(4, 5),
                           lf.fact-weight(1, 10), lf.fact-weight(2, 20), lf.fact-weight(3, 5), lf.fact-weight(5, 7)])
  check("count: each node's edges", join([int-text(f) ++ ":" ++ int-text(n) for weighed.fanout(?f, ?n)], " ") == "1:2 2:1 4:1")
  check("sum: the weight of what a root reaches, each node once", ((first weighed.reach-weight(1, ?w): w) ?? -1) == 35)
  check("min and max over what is reached", ((first weighed.lightest(?w): w) ?? -1) == 5 and ((first weighed.heaviest(?w): w) ?? -1) == 20)
  check("count with no group", ((first weighed.reached-count(?n): n) ?? -1) == 3)
  check("!= filters an answer", len([g for weighed.away(2, ?g)]) == 0 and len([g for weighed.away(1, ?g)]) == 2)
  let paths = lf.solved([lf.fact-root(1), lf.fact-edge(1, 2), lf.fact-edge(2, 3), lf.fact-edge(3, 4), lf.fact-edge(1, 3)])
  let told = lf.why-reach(paths, 4)
  check("why: a reached node explained by the fewest steps, each row after what explains it",
        join([w.relation ++ "(" ++ int-text(w.a) ++ (if w.relation == "edge" then "," ++ int-text(w.b) else "") ++ ")@" ++ int-text(w.depth) for w in told], " ")
        == "reach(4)@0 reach(3)@1 reach(1)@2 root(1)@3 edge(1,3)@2 edge(3,4)@1")
  check("why: a row not there has no explanation", len(lf.why-reach(paths, 9)) == 0)
  let shape = [lf.fact-root(1), lf.fact-edge(1, 2), lf.fact-edge(2, 3)] ++ [lf.fact-edge(100 + i, 101 + i) for i in 0..60]
              ++ [lf.fact-weight(100 + i, i) for i in 0..60]
  let before = lf.solved-blocks([shape, [lf.fact-weight(1, 1), lf.fact-weight(2, 2)], [lf.fact-weight(3, 4)]])
  let after = lf.solved-from(before, [shape, [lf.fact-weight(1, 1), lf.fact-weight(2, 2)], [lf.fact-weight(3, 40)]])
  check("an aggregate brought up to date when what it reads changes",
        ((first after.reach-weight(1, ?w): w) ?? -1) == 43 and ((first after.heaviest(?w): w) ?? -1) == 40
        and ((first after.fanout(1, ?n): n) ?? -1) == 1)
  # `let y = y + 1 in …` reads the `y` around it: the value's `y` is the first binding, the body's the second.
  let program = ll.parse("let y = 1 in let y = y + 1 in y + y", "let")
  let scoped = ls.analysis(program, [])
  let binds = [scoped.bindings[at] ?? -1 for at in leaves(program, true)]
  let reads = [scoped.bindings[at] ?? -1 for at in leaves(program, false)]
  check(".scopes: a let's name is seen in its body and not in its value",
        len(binds) == 2 and len(reads) == 3 and reads[0] == binds[0] and reads[1] == binds[1] and reads[2] == binds[1]
        and binds[0] != binds[1])
  # In a block, `let y = y + 1;` reads the `y` before it, and what follows reads the new one.
  let block = ll.parse("{ let y = 1; let y = y + 1; y + 0 }", "block")
  let seen = ls.analysis(block, [])
  let block-binds = [seen.bindings[at] ?? -1 for at in leaves(block, true)]
  let block-reads = [seen.bindings[at] ?? -1 for at in leaves(block, false)]
  check(".scopes: a sequential let is seen by what follows it, not by its value",
        len(block-binds) == 2 and len(block-reads) == 2 and block-reads[0] == block-binds[0] and block-reads[1] == block-binds[1]
        and block-binds[0] != block-binds[1])
  # The same block's statements walked as parts, as a big file's are: a sequential part's scope
  # holds the parts after it.
  let declared = ls.declarations(block, [])
  let parted = ls.part-analysis(declared.table, declared.root, block.kids[0].kids)
  let part-binds = [parted.bindings[at] ?? -1 for at in leaves(block, true)]
  let part-reads = [parted.bindings[at] ?? -1 for at in leaves(block, false)]
  check(".scopes: a sequential part is seen by the parts after it",
        len(part-binds) == 2 and len(part-reads) == 2 and part-reads[0] == part-binds[0] and part-reads[1] == part-binds[1]
        and part-binds[0] != part-binds[1] and part-binds[0] >= 0)
  print "all checks passed"
}

# Where each binding, or each reference, of a let program starts.
fn leaves(n: ll.Node, binding: Bool) -> [Int] = match n {
  ll.Bind(_) if binding => [n.lo]
  ll.Var(_) if not binding => [n.lo]
  _ => [at for k in n.kids for at in leaves(k, binding)]
}

fn reached(db: lf.Db) -> Int = len([x for db.reach(?x)])
fn reached-twice(db: lf.Db) -> Int = reached(db) + reached(db)

fn flipped-edges(edges: [[Int]]) -> [[Int]] =
  graph.adjacency(len(edges), [x for k in 0..len(edges) for x in edges[k]], [k for k in 0..len(edges) for x in edges[k]])

const later-texts: [Text] = [byte-text(c) for c in later-codes]
const later-codes: [Int] = [65, 66]

record Inner { on: Bool, note: Text? }
record Shaped { name: Text, sizes: [Int], inner: [Inner] }
fn shaped-back(text: Text) -> Shaped = read-json(text)
