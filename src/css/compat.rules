# Browser targets as lightningcss uses them (targets.rs, and the generated compat.rs and
# prefixes.rs, whose data is css.compat-data): whether every target has a feature, whether some
# do, which vendor prefixes they need, and whether a feature should be compiled away, which a
# transform's `include` and `exclude` flags can force either way.
rules css.compat
use css.compat-data as data

# The browsers targeted (`chrome`, `firefox`, `safari`, `ios_saf`, `edge`, …) with their versions
# (major << 16 | minor << 8), and the feature flags included and excluded (lightningcss's
# `Features` bits; see `flag`).
record Targets { browsers: {Text:Int}, include: Int, exclude: Int }

fn no-targets() -> Targets = Targets(browsers: {}, include: 0, exclude: 0)

# `Features` bits.
fn flag(name: Text) -> Int = match name {
  "nesting" => 1
  "not-selector-list" => 2
  "dir-selector" => 4
  "lang-selector-list" => 8
  "is-selector" => 16
  "text-decoration-thickness-percent" => 32
  "media-interval-syntax" => 64
  "media-range-syntax" => 128
  "custom-media-queries" => 256
  "clamp-function" => 512
  "color-function" => 1024
  "oklab-colors" => 2048
  "lab-colors" => 4096
  "p3-colors" => 8192
  "hex-alpha-colors" => 16384
  "space-separated-color-notation" => 32768
  "font-family-system-ui" => 65536
  "double-position-gradients" => 131072
  "vendor-prefixes" => 262144
  "logical-properties" => 524288
  "light-dark" => 1048576
  "selectors" => 31
  "media-queries" => 448
  "colors" => 1113088
  _ => fail-build("lightningcss: no feature flag " ++ name)
}

fn has-bits?(set: Int, bits: Int) -> Bool = bit-and(set, bits) == bits
fn any-bits?(set: Int, bits: Int) -> Bool = bit-and(set, bits) != 0

# `Feature::is_compatible`: every targeted browser has had the feature since a version no later
# than the one targeted. With no browsers, everything is.
fn compatible?(feature: Text, browsers: {Text:Int}) -> Bool = match data.features[feature] {
  none => fail-build("lightningcss: no compatibility data for " ++ feature)
  some(since) => all s in since: since-ok?(s, browsers)
}

fn since-ok?(s: data.Since, browsers: {Text:Int}) -> Bool = match browsers[s.browser] {
  none => true
  some(v) => s.min >= 0 and v >= s.min
}

# `Feature::is_partially_compatible`: some one targeted browser has it.
fn partially-compatible?(feature: Text, browsers: {Text:Int}) -> Bool =
  any b in browser-order if is-some(browsers[b]): compatible?(feature, {b: browsers[b] ?? 0})

const browser-order: [Text] = ["android", "chrome", "edge", "firefox", "ie", "ios_saf", "opera", "safari", "samsung"]

# `Targets::is_compatible`.
fn target-compatible?(t: Targets, feature: Text) -> Bool = compatible?(feature, t.browsers)

# `Targets::should_compile`: included, or not excluded and not every target has it.
fn should-compile?(t: Targets, feature: Text, flag-name: Text) -> Bool =
  has-bits?(t.include, flag(flag-name)) or (not has-bits?(t.exclude, flag(flag-name)) and not compatible?(feature, t.browsers))

# `Targets::should_compile_selectors`.
fn should-compile-selectors?(t: Targets) -> Bool =
  any-bits?(t.include, flag("selectors")) or (not any-bits?(t.exclude, flag("selectors")) and len(keys(t.browsers)) > 0)

# Vendor prefixes as lightningcss keeps them: bits 1 (none), 2 (-webkit-), 4 (-moz-), 8 (-ms-),
# 16 (-o-), printed in that order of the prefixed ones first, then the unprefixed.
fn prefixes-for(feature: Text, browsers: {Text:Int}) -> Int = match data.prefixes[feature] {
  none => fail-build("lightningcss: no prefix data for " ++ feature)
  some(needs) => fold p = 1 for n in needs if needs-prefix?(n, browsers): bit-or(p, n.prefix)
}

fn needs-prefix?(n: data.Needs, browsers: {Text:Int}) -> Bool = match browsers[n.browser] {
  none => false
  some(v) => v >= n.low and (n.high < 0 or v <= n.high)
}

# `Targets::prefixes`: an unprefixed value gets what the targets need (all, with the
# vendor-prefixes flag included; as it is, with it excluded or no browsers).
fn target-prefixes(t: Targets, prefix: Int, feature: Text) -> Int = match has-bits?(prefix, 1) and not has-bits?(t.exclude, flag("vendor-prefixes")) {
  false => prefix
  true if has-bits?(t.include, flag("vendor-prefixes")) => 31
  true if len(keys(t.browsers)) == 0 => prefix
  true => prefixes-for(feature, t.browsers)
}

fn in-spans?(spans: [data.Span], browsers: {Text:Int}) -> Bool =
  any s in spans: (match browsers[s.browser] { some(v) => v >= s.low and v <= s.high  none => false })

fn flex-2009?(browsers: {Text:Int}) -> Bool = in-spans?(data.is-flex-2009, browsers)
fn webkit-gradient?(browsers: {Text:Int}) -> Bool = in-spans?(data.is-webkit-gradient, browsers)

# A prefix's text.
fn prefix-text(p: Int) -> Text = match p {
  2 => "-webkit-"
  4 => "-moz-"
  8 => "-ms-"
  16 => "-o-"
  _ => ""
}

# The prefixes in a set, in the order lightningcss prints them.
fn prefix-list(set: Int) -> [Int] = [p for p in [2, 4, 8, 16, 1] if bit-and(set, p) != 0]
