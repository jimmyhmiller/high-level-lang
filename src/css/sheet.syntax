# CSS as lightningcss reads it (its cssparser crate, v0.37): tokens as css-syntax-3 and cssparser
# make them, and the rules, at-rules and declarations a stylesheet's blocks hold. A token keeps
# the text it was written with; what an identifier or string means (its escapes undone) is
# `css.tokens`'. Space and comments are tokens, since space means something in CSS (`.a .b` is
# not `.a.b`).
#
# The structure is cssparser's rule body parser: at the top and in an at-rule's block, an item is
# an at-rule or a qualified rule; in a block that allows them, a name and a colon start a
# declaration, which ends at a `;` or the block's end, and a declaration that cannot be one (a
# `{` in a property's value, something after `!important`) is tried as a nested rule. What is
# none of these is read to the next `;` and is an error lightningcss recovers from.
syntax
start Sheet
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
fragment Nl = "\r\n" | [\n\r\x0c] ;
fragment WsByte = [ \t\n\r\x0c] ;
fragment Hex = [0-9a-fA-F] ;
fragment Escape = "\\" (Hex Hex? Hex? Hex? Hex? Hex? ("\r\n" | WsByte)? | !Nl .) ;
fragment NameStart = [a-zA-Z_\x80-\xff\0] | Escape ;
fragment NameChar = [a-zA-Z0-9_\-\x80-\xff\0] | Escape ;
fragment IdentBody = "-" ("-" | NameStart) NameChar* | NameStart NameChar* ;
fragment Number = [+\-]? ([0-9]+ ("." [0-9]+)? | "." [0-9]+) ([eE] [+\-]? [0-9]+)? ;
fragment StrBody = "\"" ("\\" Nl | Escape | "\\" !. | [^"\\\n\r\x0c])* "\"" | "'" ("\\" Nl | Escape | "\\" !. | [^'\\\n\r\x0c])* "'" ;
fragment UrlByte = Escape | [^"'()\\ \t\n\r\x0c\x01-\x08\x0b\x0e-\x1f\x7f] ;
fragment CommentBody = "/*" (!"*/" .)* ("*/" | !.) ;

token Ws = WsByte+ ;
token Comment = CommentBody ;
token Str = StrBody ;
token Url = [uU] [rR] [lL] "(" WsByte* UrlByte* WsByte* ")" ;
token FuncName = IdentBody "(" ;
token AtKeyword = "@" IdentBody ;
token Hash = "#" NameChar+ ;
token Dimension = Number IdentBody ;
token Percentage = Number "%" ;
token Num = Number ;
token Cdo = "<!--" ;
token Cdc = "-->" ;
token Ident = IdentBody ;
token Match = [~|^$*] "=" ;
# Any other character is a delimiter; one beyond ASCII starts an identifier, so this is ASCII.
token Delim = [^ \t\n\r\x0c{}()\[\];,:"'] ;
token Colon = ":" ;
token Semi = ";" ;
token Comma = "," ;

rule Sheet = TopItem* -> Sheet(items) ;
rule TopItem = Ws | Comment | Cdo | Cdc | AtRule | QualifiedRule | Junk ;

# An at-rule: its name, its prelude, and a block or none.
rule AtRule = AtKeyword Prelude* AtEnd -> AtRule(name, prelude, block) ;
rule AtEnd = Block | ";" -> NoBlock | AtClose ;
rule AtClose = &"}" -> Unclosed | @eof -> Unclosed ;

# A qualified rule: a prelude (a selector, a keyframe's offsets) and its block.
rule QualifiedRule = Prelude+ Block -> QualifiedRule(prelude, block) ;
rule Prelude = Ws | Comment | Value ;

rule Block = "{" BodyItem* "}" -> Block(items) ;
rule BodyItem = Ws | Comment | Semi | AtRule | Declaration | QualifiedRule | Junk ;

# A declaration: a name, a colon, its value, and whether it is important. A custom property's value
# may hold blocks; any other's ends at a `{`.
rule Declaration
  = CustomName Space* ":" CustomPart* Importance? DeclEnd -> CustomDeclaration(name, gap, value, important, end)
  | Ident Space* ":" DeclPart* Importance? DeclEnd -> Declaration(name, gap, value, important, end)
  ;
token CustomName = "--" NameChar* ;
rule Space = Ws | Comment ;
rule DeclEnd = ";" -> Ended | DeclClose ;
rule DeclClose = &"}" -> Closed | @eof -> Closed ;
rule Importance = "!" Space* ImportantWord Space* -> Important(before, word, after) ;
token ImportantWord = [iI] [mM] [pP] [oO] [rR] [tT] [aA] [nN] [tT] !NameChar ;
rule DeclPart = Ws | Comment | DeclValue ;
rule CustomPart = Ws | Comment | DeclValue | "{" CustomPart* "}" -> CustomBraces(items) ;

# What cannot be read as anything else, up to a `;` (read with it) or the block's end: lightningcss
# warns and goes on.
rule Junk = JunkPart+ ";"? -> Junk(parts, semi) ;
rule JunkPart = Ws | Comment | Value | "{" BodyItem* "}" -> JunkBraces(items) ;

# A component value: a token, or a function or a block with the values in it.
rule Value = Url | FuncName Inner* ")" -> Func(name, args) | "(" Inner* ")" -> Parens(items)
           | "[" Inner* "]" -> Brackets(items) | Str | Dimension | Percentage | Num | Hash | AtKeyword
           | Cdo | Cdc | Ident | Match | Colon | Comma | Delim ;
# In a declaration's value a `!` ends it and a `{` cannot be.
rule DeclValue = !"!" Value ;
rule Inner = Ws | Comment | Value | Semi | "{" Inner* "}" -> Braces(items) ;
