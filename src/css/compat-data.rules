# Which browser versions have each feature lightningcss asks about, and which need a vendor prefix
# for each feature that may have one: lightningcss 1.33.0's own data (src/compat.rs and
# src/prefixes.rs, which it generates from caniuse and mdn), written as data by
# tools/lightning-data.py. Do not edit by hand. Versions are lightningcss's: major << 16 | minor << 8.
rules css.compat-data

# A browser has the feature from version `min` on; -1 when it has never had it.
record Since { browser: Text, min: Int }

# A browser needs `prefix` (lightningcss's bits: 2 webkit, 4 moz, 8 ms, 16 o) from `low` to `high`
# (-1: and every version after).
record Needs { browser: Text, low: Int, high: Int, prefix: Int }

record Span { browser: Text, low: Int, high: Int }

