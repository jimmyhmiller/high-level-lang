# CSS as Tailwind's own parser reads it (tailwindcss/src/css-parser.ts, v4.3.5). It has no tokens:
# text gathers into a prelude until a `;`, `{` or `}` outside parentheses, and what the prelude was
# followed by decides what it is (a statement, a block's head, the last declaration of a block).
# Inside parentheses those three are plain bytes. A custom property (`--x: …`, starting where no
# prelude has started) is read raw, to a `;` or `}` outside every bracket, `(`, `[` and `{` alike.
# Strings, escapes and comments are read whole wherever they are. What the prelude's text becomes
# (space collapsed, comments gone) is `tailwind.ast`'s.
syntax
start Sheet
space Nothing
word Nothing

fragment Nothing = (!. .)* ;
fragment StrBody = "\"" ("\\" . | [^"\\\n])* "\"" | "'" ("\\" . | [^'\\\n])* "'" ;
fragment CommentBody = "/*" (!"*/" .)* "*/" ;
# Inside a custom property: brackets nest, and a closing one that is not the innermost's is a byte.
fragment CustomGroup
  = "(" (CustomAtom | [^)])* ")"?
  | "[" (CustomAtom | [^\]])* "]"?
  | "{" (CustomAtom | [^}])* "}"?
  ;
fragment CustomAtom = "\\" . | StrBody | CommentBody | CustomGroup ;

token Ws = ([ \t\n] | "\r\n")+ ;
token Comment = CommentBody ;
token Str = StrBody ;
token Esc = "\\" .? ;
token Char = [^;{}()"'\\ \t\n/] | "/" ;
token CustomHead = "--" ("\\" . | StrBody | CommentBody | [^:;}(\[{"'\\])* ;
token CustomValue = (CustomAtom | [^;}])* ;

rule Sheet = Bom? SheetItem* -> Sheet(bom, items) ;
rule Bom = "﻿" -> Bom ;
rule SheetItem
  = Ws
  | Comment
  | "<!--" -> Cdo
  | "-->" -> Cdc
  | Item
  ;
rule BlockItem = Ws | Comment | Item | Prelude &"}" -> Tail(prelude) ;
rule Item
  = ";" -> Semi
  | CustomHead ":" CustomValue ";"? -> Custom(head, value, semi)
  | Prelude ";" -> Statement(prelude)
  | Prelude? "{" BlockItem* "}" -> Block(prelude, items)
  | Prelude @eof -> Tail(prelude)
  ;
# A prelude starts with something that is not space or a comment: those before it are its
# block's, not its own.
memo rule Prelude = Lead Piece* -> Prelude(lead, pieces) ;
rule Lead = Str | Esc | Parens | Char ;
rule Piece = Ws | Comment | Str | Esc | Parens | Char ;
rule Parens = "(" Inner* ")" -> Parens(inner) ;
rule Inner = Ws | Comment | Str | Esc | Parens | InnerChar ;
token InnerChar = [^()"'\\ \t\n/] | "/" ;
