# Tailwind's variants (tailwindcss/src/variants.ts, v4.3.5): what each does to a utility's rule (a
# selector or an at-rule around its declarations), in Tailwind's order, which is the order their
# rules come out in. Most are a selector or a media query, as data; `not`, `group`, `peer`, `in`
# and `has` take another variant and rewrite what it made; `data-*`, `aria-*`, `supports-*`,
# `min-*`, `max-*` and the container queries take a value. The theme's breakpoints are variants
# too, and so are a stylesheet's own (`@custom-variant`).
rules tailwind.variants
use tailwind.ast as ast
use tailwind.candidate as cand
use tailwind.theme as th
use tailwind.text as tx
use tailwind.values as vp
use tailwind.numbers as num

# A variant: its kind, its place in the order (variants of a group share one), what it may be
# nested under (bits: 1 at-rules, 2 style rules), what it takes when it is a compound, and its
# group's comparison of values ("" none, or `asc`/`desc` of breakpoints or containers).
record Def { name: Text, kind: cand.VariantKind, order: Int, compounds: Int, compounds-with: Int, compare: Text,
             selectors: [Text], custom: [ast.Css] }

fn variant-def(name: Text, kind: cand.VariantKind, compounds: Int) -> Def =
  Def(name: name, kind: kind, order: 0, compounds: compounds, compounds-with: 0, compare: "", selectors: [], custom: [])

# A variant that is selectors (or at-rules), each around what the utility made.
fn selectors(name: Text, sels: [Text]) -> Def = variant-def(name, cand.StaticVariant, cand.compounds-for(sels)) with { selectors: sels }
fn selectors-never(name: Text, sels: [Text]) -> Def = selectors(name, sels) with { compounds: 0 }

fn compound(name: Text, compounds-with: Int) -> Def = variant-def(name, cand.CompoundVariant, 2) with { compounds-with: compounds-with }

fn functional(name: Text, compounds: Int) -> Def = variant-def(name, cand.FunctionalVariant, compounds)

# Variants in Tailwind's order, numbered: one after another, but each group of them sharing a
# number. A stylesheet's own come last, in the order it defined them.
fn registry(t: th.Theme, own: [Def]) -> [Def] = numbered(groups(t) ++ [[d] for d in own])

fn numbered(gs: [[Def]]) -> [Def] = [d with { order: i + 1 } for i in 0..len(gs) for d in gs[i]]

fn groups(t: th.Theme) -> [[Def]] = [[d] for d in before-breakpoints()]
  ++ [[functional("max", 1) with { compare: "breakpoint-desc" }],
      [variant-def(n.name ?? "", cand.StaticVariant, 1) with { compare: "breakpoint-asc", selectors: ["@media (width >= " ++ n.value ++ ")"] }
       for n in th.namespace(t, "--breakpoint") if is-some(n.name)] ++ [functional("min", 1) with { compare: "breakpoint-asc" }],
      [functional("@max", 1) with { compare: "container-desc" }],
      [functional("@", 1) with { compare: "container-asc" }, functional("@min", 1) with { compare: "container-asc" }]]
  ++ [[d] for d in after-breakpoints()]

fn before-breakpoints() -> [Def] = [
  selectors-never("*", [":is(& > *)"]), selectors-never("**", [":is(& *)"]),
  compound("not", 3), compound("group", 2), compound("peer", 2),
  selectors("first-letter", ["&::first-letter"]), selectors("first-line", ["&::first-line"]),
  selectors("marker", ["& *::marker", "&::marker", "& *::-webkit-details-marker", "&::-webkit-details-marker"]),
  selectors("selection", ["& *::selection", "&::selection"]), selectors("file", ["&::file-selector-button"]),
  selectors("placeholder", ["&::placeholder"]), selectors("backdrop", ["&::backdrop"]),
  selectors("details-content", ["&::details-content"]),
  variant-def("before", cand.StaticVariant, 0), variant-def("after", cand.StaticVariant, 0),
  selectors("first", ["&:first-child"]), selectors("last", ["&:last-child"]), selectors("only", ["&:only-child"]),
  selectors("odd", ["&:nth-child(odd)"]), selectors("even", ["&:nth-child(even)"]),
  selectors("first-of-type", ["&:first-of-type"]), selectors("last-of-type", ["&:last-of-type"]),
  selectors("only-of-type", ["&:only-of-type"]), selectors("visited", ["&:visited"]), selectors("target", ["&:target"]),
  selectors("open", ["&:is([open], :popover-open, :open)"]), selectors("default", ["&:default"]),
  selectors("checked", ["&:checked"]), selectors("indeterminate", ["&:indeterminate"]),
  selectors("placeholder-shown", ["&:placeholder-shown"]), selectors("autofill", ["&:autofill"]),
  selectors("optional", ["&:optional"]), selectors("required", ["&:required"]), selectors("valid", ["&:valid"]),
  selectors("invalid", ["&:invalid"]), selectors("user-valid", ["&:user-valid"]), selectors("user-invalid", ["&:user-invalid"]),
  selectors("in-range", ["&:in-range"]), selectors("out-of-range", ["&:out-of-range"]), selectors("read-only", ["&:read-only"]),
  selectors("empty", ["&:empty"]), selectors("focus-within", ["&:focus-within"]),
  variant-def("hover", cand.StaticVariant, 2),
  selectors("focus", ["&:focus"]), selectors("focus-visible", ["&:focus-visible"]), selectors("active", ["&:active"]),
  selectors("enabled", ["&:enabled"]), selectors("disabled", ["&:disabled"]), selectors("inert", ["&:is([inert], [inert] *)"]),
  compound("in", 2), compound("has", 2),
  functional("aria", 2), functional("data", 2), functional("nth", 2), functional("nth-last", 2), functional("nth-of-type", 2),
  functional("nth-last-of-type", 2), functional("supports", 1),
  selectors("motion-safe", ["@media (prefers-reduced-motion: no-preference)"]),
  selectors("motion-reduce", ["@media (prefers-reduced-motion: reduce)"]),
  selectors("contrast-more", ["@media (prefers-contrast: more)"]), selectors("contrast-less", ["@media (prefers-contrast: less)"])]

fn after-breakpoints() -> [Def] = [
  selectors("portrait", ["@media (orientation: portrait)"]), selectors("landscape", ["@media (orientation: landscape)"]),
  selectors("ltr", ["&:where(:dir(ltr), [dir=\"ltr\"], [dir=\"ltr\"] *)"]),
  selectors("rtl", ["&:where(:dir(rtl), [dir=\"rtl\"], [dir=\"rtl\"] *)"]),
  selectors("dark", ["@media (prefers-color-scheme: dark)"]), selectors("starting", ["@starting-style"]),
  selectors("print", ["@media print"]), selectors("forced-colors", ["@media (forced-colors: active)"]),
  selectors("inverted-colors", ["@media (inverted-colors: inverted)"]), selectors("pointer-none", ["@media (pointer: none)"]),
  selectors("pointer-coarse", ["@media (pointer: coarse)"]), selectors("pointer-fine", ["@media (pointer: fine)"]),
  selectors("any-pointer-none", ["@media (any-pointer: none)"]), selectors("any-pointer-coarse", ["@media (any-pointer: coarse)"]),
  selectors("any-pointer-fine", ["@media (any-pointer: fine)"]), selectors("noscript", ["@media (scripting: none)"])]

# What the design system says of variants' names, for parsing candidates.
record Table { defs: {Text:Def} }

fn table(defs: [Def]) -> Table = Table(defs: {d.name: d for d in defs})

# ---------------------------------------------------------------- ordering

# Tailwind's `variants.compare`.
fn compare(a: cand.Variant, z: cand.Variant, tb: Table, t: th.Theme) -> Int = match a.kind, z.kind {
  cand.ArbitraryVariant, cand.ArbitraryVariant => if a.selector == z.selector then 0 else if a.selector < z.selector then -1 else 1
  cand.ArbitraryVariant, _ => 1
  _, cand.ArbitraryVariant => -1
  _, _ => match order-of(a, tb) - order-of(z, tb) {
    0 => same-order(a, z, tb, t)
    d => d
  }
}

fn order-of(v: cand.Variant, tb: Table) -> Int = (tb.defs[v.root] ?? panic "tailwind: no variant {}", v.root).order

fn same-order(a: cand.Variant, z: cand.Variant, tb: Table, t: th.Theme) -> Int = match a.kind, z.kind {
  cand.CompoundVariant, cand.CompoundVariant => match compare(a.inner[0], z.inner[0], tb, t) {
    0 => match a.modifier, z.modifier {
      some(am), some(zm) => if am.value < zm.value then -1 else 1
      some(_), none => 1
      none, some(_) => -1
      none, none => 0
    }
    d => d
  }
  _, _ => match (tb.defs[a.root] ?? panic "tailwind: no variant {}", a.root).compare {
    "" => plain-compare(a, z)
    how => breakpoint-compare(a, z, how, t)
  }
}

fn plain-compare(a: cand.Variant, z: cand.Variant) -> Int = match a.root == z.root {
  false => if a.root < z.root then -1 else 1
  true => match a.value, z.value {
    none, _ => -1
    _, none => 1
    some(av), some(zv) if av.arbitrary and not zv.arbitrary => 1
    some(av), some(zv) if not av.arbitrary and zv.arbitrary => -1
    some(av), some(zv) => if av.value < zv.value then -1 else 1
  }
}

# Tailwind's `compareBreakpointVariants`.
fn breakpoint-compare(a: cand.Variant, z: cand.Variant, how: Text, t: th.Theme) -> Int = match a == z {
  true => 0
  false => match resolved-size(a, how, t), resolved-size(z, how, t) {
    none, _ => if ends-with(how, "asc") then -1 else 1
    _, none => if ends-with(how, "asc") then 1 else -1
    some(av), some(zv) => num.compare-breakpoints(av, zv, ends-with(how, "asc"))
  }
}

# The size a breakpoint or container variant stands for.
fn resolved-size(v: cand.Variant, how: Text, t: th.Theme) -> Text? = match v.kind {
  cand.StaticVariant if starts-with(how, "breakpoint") => th.resolve-value(t, some(v.root), ["--breakpoint"])
  cand.FunctionalVariant if starts-with(how, "breakpoint") and is-some(v.modifier) => none
  cand.FunctionalVariant => match v.value {
    none => none
    some(x) => first s in (if x.arbitrary then some(x.value) else th.resolve-value(t, some(x.value), [if starts-with(how, "breakpoint") then "--breakpoint" else "--container"]))
      if s != "" and not contains-text?(s, "var("): s
  }
  _ => none
}

# ---------------------------------------------------------------- applying

# What a variant makes of a rule (a style rule, or the `@slot` a compound variant fills): none when
# it does not apply. `depth` is how deep inside compound variants it is.
fn applied(node: ast.Css, v: cand.Variant, tb: Table, t: th.Theme, depth: Int) -> ast.Css? = match v.kind {
  cand.ArbitraryVariant if v.relative and depth == 0 => none
  cand.ArbitraryVariant => some(node with { nodes: [arbitrary-child(v.selector, node.nodes)] })
  cand.CompoundVariant => compounded(node, v, tb, t, depth)
  _ => variant-made(node, v, tb, t)
}

fn arbitrary-child(selector: Text, nodes: [ast.Css]) -> ast.Css = match ast.rule(selector, nodes) {
  r if r.kind == ast.AtRule and r.head == "@scope" =>
    ast.context({"source": "variant"}, [r with { nodes: [ast.context({"source": "user"}, nodes)] }])
  r => r
}

fn compounded(node: ast.Css, v: cand.Variant, tb: Table, t: th.Theme, depth: Int) -> ast.Css? =
  match applied(ast.at-rule("@slot", "", []), v.inner[0], tb, t, depth + 1) {
    none => none
    some(slot) if v.root == "not" and len(slot.nodes) > 1 => none
    some(slot) if any c in slot.nodes: c.kind != ast.StyleRule and c.kind != ast.AtRule => none
    some(slot) => match [compound-made(c, v, tb, t) for c in slot.nodes] {
      made if any m in made: is-none(m) => none
      made => some(node with { nodes: [filled-slots(m, node.nodes) for o in made for m in o] })
    }
  }

# Tailwind's walk that puts the utility's nodes in each rule a compound variant left empty.
fn filled-slots(n: ast.Css, inner: [ast.Css]) -> ast.Css = match n.kind {
  ast.StyleRule | ast.AtRule if len(n.nodes) == 0 => n with { nodes: inner }
  ast.Decl | ast.Comment => n
  _ => n with { nodes: [filled-slots(c, inner) for c in n.nodes] }
}

fn variant-made(node: ast.Css, v: cand.Variant, tb: Table, t: th.Theme) -> ast.Css? = match v.root {
  "before" | "after" => some(node with { nodes: [ast.style-rule("&::" ++ v.root, [ast.at-root([content-property()]),
                                                  ast.decl("content", "var(--tw-content)")] ++ node.nodes)] })
  "hover" => some(node with { nodes: [ast.style-rule("&:hover", [ast.at-rule("@media", "(hover: hover)", node.nodes)])] })
  "aria" => match v.value {
    _ if is-some(v.modifier) => none
    some(x) => first sel in [if x.arbitrary then "[aria-" ++ quoted-attribute(x.value) ++ "]" else "[aria-" ++ x.value ++ "=\"true\"]"]
      if valid-attribute?(sel): node with { nodes: [ast.style-rule("&" ++ sel, node.nodes)] }
    none => none
  }
  "data" => match v.value {
    _ if is-some(v.modifier) => none
    some(x) => first sel in ["[data-" ++ quoted-attribute(x.value) ++ "]"] if valid-attribute?(sel):
      node with { nodes: [ast.style-rule("&" ++ sel, node.nodes)] }
    none => none
  }
  "nth" | "nth-last" | "nth-of-type" | "nth-last-of-type" => match v.value {
    _ if is-some(v.modifier) => none
    some(x) if not x.arbitrary and not num.positive-integer?(x.value) => none
    some(x) => some(node with { nodes: [ast.style-rule("&:" ++ nth-pseudo(v.root) ++ "(" ++ x.value ++ ")", node.nodes)] })
    none => none
  }
  "supports" => match v.value {
    _ if is-some(v.modifier) => none
    some(x) => some(node with { nodes: [ast.at-rule("@supports", supports-query(x.value), node.nodes)] })
    none => none
  }
  "max" | "min" => match v.modifier {
    some(_) => none
    none => first size in resolved-size(v, "breakpoint", t):
      node with { nodes: [ast.at-rule("@media", "(width " ++ (if v.root == "max" then "<" else ">=") ++ " " ++ size ++ ")", node.nodes)] }
  }
  "@max" | "@" | "@min" => first size in resolved-size(v, "container", t):
    node with { nodes: [ast.at-rule("@container", ((first m in v.modifier: m.value ++ " ") ?? "") ++ "(width " ++ (if v.root == "@max" then "<" else ">=")
                                                  ++ " " ++ size ++ ")", node.nodes)] }
  root => match tb.defs[root] {
    some(d) if len(d.custom) > 0 => some(custom-made(node, d))
    some(d) => some(node with { nodes: [ast.rule(s, node.nodes) for s in d.selectors] })
    none => panic "tailwind: no variant {}", root
  }
}

fn content-property() -> ast.Css = ast.at-rule("@property", "--tw-content",
  [ast.decl("syntax", "\"*\""), ast.decl("initial-value", "\"\""), ast.decl("inherits", "false")])

fn nth-pseudo(root: Text) -> Text = match root {
  "nth" => "nth-child"
  "nth-last" => "nth-last-child"
  "nth-of-type" => "nth-of-type"
  _ => "nth-last-of-type"
}

# Tailwind's `quoteAttributeValue`: `data-[a=b]` is `[data-a="b"]`, keeping a trailing ` i` or ` s`.
fn quoted-attribute(input: Text) -> Text = match index-of(input, "=") {
  none => input
  some(_) => match tx.js-trim(join(parts[1..len(parts)], "=")) {
    value if value != "" and (value[0] == '\'' or value[0] == '"') => input
    value if len(value) > 1 and value[len(value) - 2] == ' ' and has-byte?("iIsS", value[len(value) - 1]) =>
      parts[0] ++ "=\"" ++ value[0..len(value) - 2] ++ "\" " ++ value[len(value) - 1..len(value)]
    value => parts[0] ++ "=\"" ++ value ++ "\""
  } where parts = tx.segment(input, '=')
}

# The supports query a `supports-*` value makes.
fn supports-query(value: Text) -> Text = match supports-function?(value) {
  true => match vp.css(spaced-conditions(vp.parse(value))) {
    q if q != vp.css(vp.parse(value)) => q
    _ => value
  }
  false => parenthesized(if has-byte?(value, ':') then value else value ++ ": var(--tw)")
}

fn parenthesized(v: Text) -> Text = if starts-with(v, "(") and ends-with(v, ")") then v else "(" ++ v ++ ")"

# `/^[\w-]*\s*\(/`.
fn supports-function?(value: Text) -> Bool = match index-of(value, "(") {
  some(at) => span-of(tx.js-trim-end(value[0..at]), 0, word-bytes) == len(tx.js-trim-end(value[0..at]))
  none => false
}

const word-bytes: Text = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"

fn spaced-conditions(nodes: [vp.Value]) -> [vp.Value] = [spaced-condition(n) for n in nodes]

fn spaced-condition(n: vp.Value) -> vp.Value = match n.kind {
  vp.Function if n.value == "selector" => n
  vp.Function if n.value == "and" or n.value == "or" or n.value == "not" => n with { value: " " ++ n.value ++ " ", nodes: spaced-conditions(n.nodes) }
  vp.Function => n with { nodes: spaced-conditions(n.nodes) }
  _ => n
}

# ---------------------------------------------------------------- compound variants

fn compound-made(child: ast.Css, v: cand.Variant, tb: Table, t: th.Theme) -> ast.Css? = match v.root {
  "not" => negated(child, v)
  "group" | "peer" => match v.inner[0] {
    inner if inner.kind == cand.ArbitraryVariant and inner.relative => none
    _ => in-relation(child, ":where(." ++ prefix-escape(t) ++ v.root ++ ((first m in v.modifier: "\\/" ++ m.value) ?? "") ++ ")",
                     if v.root == "group" then " &" else " ~ &")
  }
  "in" => if is-some(v.modifier) then none else rewritten-top-rules(child, fn-in)
  "has" => if is-some(v.modifier) then none else rewritten-top-rules(child, fn-has)
  _ => panic "tailwind: no compound variant {}", v.root
}

fn prefix-escape(t: th.Theme) -> Text = if t.prefix == "" then "" else t.prefix ++ "\\:"

record Rewrite { how: Text, selector: Text, after: Text }

const fn-in: Rewrite = Rewrite(how: "in", selector: "", after: "")
const fn-has: Rewrite = Rewrite(how: "has", selector: "", after: "")

fn in-relation(child: ast.Css, selector: Text, after: Text) -> ast.Css? =
  rewritten-top-rules(child, Rewrite(how: "relation", selector: selector, after: after))

# The variants that rewrite the selectors of the outermost style rules (and fail when one is
# inside another): `group`, `peer`, `in`, `has`.
fn rewritten-top-rules(n: ast.Css, rw: Rewrite) -> ast.Css? = match nested-rule?(n, false) {
  true => none
  false => match any-style-rule?(n) {
    false => none
    true => some(top-rewritten(n, rw))
  }
}

# Whether a style rule has a style rule inside it (the walk stops there and the variant fails).
fn nested-rule?(n: ast.Css, inside: Bool) -> Bool = match n.kind {
  ast.StyleRule if inside => true
  ast.StyleRule => any c in n.nodes: nested-rule?(c, true)
  ast.Decl | ast.Comment => false
  _ => any c in n.nodes: nested-rule?(c, inside)
}

fn any-style-rule?(n: ast.Css) -> Bool = match n.kind {
  ast.StyleRule => true
  ast.Decl | ast.Comment => false
  _ => any c in n.nodes: any-style-rule?(c)
}

fn top-rewritten(n: ast.Css, rw: Rewrite) -> ast.Css = match n.kind {
  ast.StyleRule => n with { head: rewritten-selector(n.head, rw) }
  ast.Decl | ast.Comment => n
  _ => n with { nodes: [top-rewritten(c, rw) for c in n.nodes] }
}

fn rewritten-selector(s: Text, rw: Rewrite) -> Text = match rw.how {
  "in" => ":where(" ++ replace-all(s, "&", "*") ++ ") &"
  "has" => "&:has(" ++ replace-all(s, "&", "*") ++ ")"
  _ => ":is(" ++ grouped(replace-all(s, "&", rw.selector)) ++ rw.after ++ ")"
}

fn grouped(s: Text) -> Text = if len(tx.segment(s, ',')) > 1 then ":is(" ++ s ++ ")" else s

# `not-*`: the selector and at-rule the inner variant made, negated. Tailwind's walk negates at each
# empty rule it reaches, the last one winning; one under two at-rules or two style rules stops it,
# keeping what was made; one that cannot be negated fails it.
fn negated(child: ast.Css, v: cand.Variant) -> ast.Css? = match v.inner[0] {
  inner if inner.kind == cand.ArbitraryVariant and inner.relative => none
  _ if is-some(v.modifier) => none
  _ => first r in (fold made = Negation(stopped: false, result: none) for path in leaves(child, []) while not made.stopped:
                     negation-step(made, path)).result: unwrapped(r)
}

record Negation { stopped: Bool, result: ast.Css? }

fn negation-step(made: Negation, path: [ast.Css]) -> Negation =
  match [x for x in path if x.kind == ast.AtRule], [x for x in path if x.kind == ast.StyleRule] {
    ats, styles if len(ats) > 1 or len(styles) > 1 => made with { stopped: true }
    ats, styles => match [negate-selector(x.head) for x in styles], [negate-at-rule(a) for a in ats] {
      sels, rules if (any x in sels: is-none(x)) or (any x in rules: is-none(x)) => Negation(stopped: true, result: none)
      sels, rules => made with { result: some(ast.style-rule("&", [ast.style-rule(x, []) for o in sels for x in o] ++ [r for o in rules for r in o])) }
    }
  }

fn unwrapped(r: ast.Css) -> ast.Css = match r.nodes {
  [only] if r.head == "&" => only
  _ => r
}

# Each empty rule or at-rule under `n` (and `n` itself), in walk order, with the rules from `n`
# down to it.
fn leaves(n: ast.Css, above: [ast.Css]) -> [[ast.Css]] = match n.kind {
  ast.StyleRule | ast.AtRule if len(n.nodes) == 0 => [above ++ [n]]
  ast.StyleRule | ast.AtRule => [p for c in n.nodes for p in leaves(c, above ++ [n])]
  ast.Context | ast.AtRoot => [p for c in n.nodes for p in leaves(c, above)]
  _ => []
}

fn negate-selector(selector: Text) -> Text? = match contains-text?(selector, "::") {
  true => none
  false => some("&:not(" ++ join([replace-all(s, "&", "*") for s in tx.segment(selector, ',')], ", ") ++ ")")
}

fn negate-at-rule(r: ast.Css) -> ast.Css? = match r.head {
  "@media" | "@supports" | "@container" => match tx.segment(r.params, ',') {
    [condition] => some(ast.at-rule(r.head, negate-condition(r.head, condition), []))
    _ => none
  }
  _ => none
}

fn negate-condition(name: Text, condition: Text) -> Text = match name {
  "@container" => negate-container(condition, vp.parse(tx.js-trim(condition)))
  _ => match tx.segment(tx.js-trim(condition), ' ') {
    ["not", rest...] => join(rest, " ")
    _ => "not " ++ tx.js-trim(condition)
  }
}

fn negate-container(condition: Text, ast-nodes: [vp.Value]) -> Text = match ast-nodes {
  [f, ...] if f.kind == vp.Function => "not " ++ condition
  [w, _, f, rest...] if w.kind == vp.Word and w.value == "not" and f.kind == vp.Function => vp.css([f] ++ rest)
  [a, s, w, _, f, rest...] if a.kind == vp.Word and w.kind == vp.Word and w.value == "not" and f.kind == vp.Function => vp.css([a, s, f] ++ rest)
  [w, s, f, rest...] if w.kind == vp.Word and w.value != "not" and f.kind == vp.Function =>
    vp.css([w, vp.separator(" "), vp.word("not"), s, f] ++ rest)
  _ => "not " ++ condition
}

# ---------------------------------------------------------------- a stylesheet's own variants

# `@custom-variant name (selector, @media …);` and `@custom-variant name { … @slot; … }`, and what
# such a variant does: puts the utility where `@slot` is.
fn custom-made(node: ast.Css, d: Def) -> ast.Css = node with { nodes: slotted(d.custom, node.nodes) }

fn slotted(body: [ast.Css], inner: [ast.Css]) -> [ast.Css] = [y for x in body for y in slot-one(x, inner)]

fn slot-one(x: ast.Css, inner: [ast.Css]) -> [ast.Css] = match x.kind {
  ast.AtRule if x.head == "@slot" => inner
  ast.AtRule if x.head == "@keyframes" or x.head == "@property" => [ast.at-root([x])]
  ast.Decl | ast.Comment => [x]
  _ => [x with { nodes: slotted(x.nodes, inner) }]
}

# A selector list or at-rule list of a `@custom-variant name (…)`: style rules joined, at-rules each.
fn custom-of-selectors(name: Text, sels: [Text]) -> Def =
  variant-def(name, cand.StaticVariant, cand.compounds-for(sels)) with {
    custom: (if len(styles) > 0 then [ast.style-rule(join(styles, ", "), [ast.at-rule("@slot", "", [])])] else [])
            ++ [ast.rule(a, [ast.at-rule("@slot", "", [])]) for a in ats] }
  where styles = [s for s in sels if not starts-with(s, "@")], ats = [s for s in sels if starts-with(s, "@")]

fn custom-of-body(name: Text, body: [ast.Css]) -> Def = variant-def(name, cand.StaticVariant, cand.compounds-for(body-selectors(body))) with { custom: body }

fn body-selectors(nodes: [ast.Css]) -> [Text] = [s for n in nodes for s in body-selector(n)]

fn body-selector(n: ast.Css) -> [Text] = match n.kind {
  ast.StyleRule => [n.head] ++ body-selectors(n.nodes)
  ast.AtRule if n.head == "@variant" => body-selectors(n.nodes)
  ast.AtRule if n.head != "@slot" => [n.head ++ " " ++ n.params] ++ body-selectors(n.nodes)
  ast.Decl | ast.Comment => []
  _ => body-selectors(n.nodes)
}

# Tailwind's `AttributeSelectorParser.parse` accepting the selector: `[name]`, or `[name op value]`
# with an optional ` i` or ` s`, space allowed around each part.
fn valid-attribute?(sel: Text) -> Bool = match sel {
  "[" ++ _ ++ "]" if len(sel) >= 2 => attribute-ok?(sel, len(sel) - 1, ws-end(sel, 1, len(sel) - 1))
  _ => false
}

fn ws-end(s: Text, i: Int, end: Int) -> Int = if i >= end then i else i + span-of(s[0..end], i, " \t\n\r")

fn attribute-ok?(s: Text, end: Int, start: Int) -> Bool = match name-end(s, start, end) {
  i if i == start => false
  i => after-name?(s, end, ws-end(s, i, end))
}

fn name-end(s: Text, i: Int, end: Int) -> Int = match i {
  _ if i >= end => i
  _ if s[i] == 92 => name-end(s, i + 2, end)
  _ if s[i] >= 128 or has-byte?(word-bytes, s[i]) => name-end(s, i + 1, end)
  _ => i
}

fn after-name?(s: Text, end: Int, i: Int) -> Bool = match i {
  _ if i == end => true
  _ if s[i] == '=' => after-operator?(s, end, ws-end(s, i + 1, end))
  _ if has-byte?("~|^$*", s[i]) and i + 1 < len(s) and s[i + 1] == '=' => after-operator?(s, end, ws-end(s, i + 2, end))
  _ => false
}

fn after-operator?(s: Text, end: Int, i: Int) -> Bool = match i {
  _ if i >= end => false
  _ if s[i] == '"' or s[i] == '\'' => after-value?(s, end, ws-end(s, last-quote(s, i + 1, end, s[i], i + 1), end))
  _ => after-value?(s, end, ws-end(s, i + span-not-of(s[0..end], i, " \t\n\r"), end))
}

# Where a quoted value ends: after the last quote like its opening one before the `]`.
fn last-quote(s: Text, j: Int, end: Int, quote: Int, found: Int) -> Int = match j {
  _ if j >= end => found
  _ if s[j] == quote => last-quote(s, j + 1, end, quote, j + 1)
  _ if s[j] == 92 => last-quote(s, j + 2, end, quote, found)
  _ => last-quote(s, j + 1, end, quote, found)
}

fn after-value?(s: Text, end: Int, i: Int) -> Bool = match i {
  _ if i == end => true
  _ if has-byte?("iIsS", s[i]) => ws-end(s, i + 1, end) == end
  _ => false
}
