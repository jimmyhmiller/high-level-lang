# What kind of value an arbitrary value is, as Tailwind guesses it (utils/infer-data-type.ts and
# is-color.ts): a color, a length, a percentage, an image… A utility that sets one of several
# properties (`bg-[…]`, `text-[…]`) picks the property by the first of its types the value has.
rules tailwind.types
use tailwind.text as tx
use tailwind.candidate as cand

# Tailwind's `inferDataType`: the first of these types the value is; none for a `var(…)`.
fn infer(value: Text, types: [Text]) -> Text? = match value {
  "var(" ++ _ => none
  _ => first ty in types if is?(ty, value): ty
}

fn is?(ty: Text, value: Text) -> Bool = match ty {
  "color" => color?(value)
  "length" => length?(value)
  "percentage" => percentage?(value)
  "ratio" => fraction?(value)
  "number" => number?(value)
  "integer" => tailwind-integer?(value)
  "url" => url?(value)
  "position" => background-position?(value)
  "bg-size" => background-size?(value)
  "line-width" => line-width?(value)
  "image" => image?(value)
  "family-name" => family-name?(value)
  "generic-name" => value in generic-names
  "absolute-size" => value in absolute-sizes
  "relative-size" => value == "larger" or value == "smaller"
  "angle" => angle?(value)
  "vector" => vector?(value)
  _ => false
}

# `isPositiveInteger`, which `integer` is.
fn tailwind-integer?(value: Text) -> Bool = value != "" and span-of(value, 0, "0123456789") == len(value) and js-number-text(value) == value

fn url?(value: Text) -> Bool = starts-with(value, "url(") and ends-with(value, ")") and not has-byte?(value, '\n') and not has-byte?(value, '\r')

fn line-width?(value: Text) -> Bool =
  all part in tx.segment(value, ' '): length?(part) or number?(part) or part == "thin" or part == "medium" or part == "thick"

fn image?(value: Text) -> Bool = match [image-part(part) for part in tx.segment(value, ',')] {
  kinds if any k in kinds: k == 0 => false
  kinds => any k in kinds: k == 1
}

# 1: an image, 2: a variable (counted as neither), 0: not an image.
fn image-part(part: Text) -> Int = match part {
  "var(" ++ _ => 2
  _ if url?(part) or gradient?(part) or image-function?(part) => 1
  _ => 0
}

fn gradient?(part: Text) -> Bool = match (if starts-with(part, "repeating-") then part[10..len(part)] else part) {
  "conic-gradient(" ++ _ | "linear-gradient(" ++ _ | "radial-gradient(" ++ _ => true
  _ => false
}

fn image-function?(part: Text) -> Bool = match part {
  "element(" ++ _ | "image(" ++ _ | "cross-fade(" ++ _ | "image-set(" ++ _ => true
  _ => false
}

const generic-names: [Text] = ["serif", "sans-serif", "monospace", "cursive", "fantasy", "system-ui", "ui-serif", "ui-sans-serif",
  "ui-monospace", "ui-rounded", "math", "emoji", "fangsong"]

const absolute-sizes: [Text] = ["xx-small", "x-small", "small", "medium", "large", "x-large", "xx-large", "xxx-large"]

fn family-name?(value: Text) -> Bool = match [family-part(part) for part in tx.segment(value, ',')] {
  kinds if any k in kinds: k == 0 => false
  kinds => any k in kinds: k == 1
}

fn family-part(part: Text) -> Int = match part {
  _ if part != "" and digit-byte?(part[0]) => 0
  "var(" ++ _ => 2
  _ => 1
}

# `[+-]?\d*\.?\d+(?:[eE][+-]?\d+)?` is the whole text.
fn number-text?(s: Text) -> Bool = match s {
  "+" ++ rest | "-" ++ rest => unsigned-number?(rest)
  _ => unsigned-number?(s)
}

fn unsigned-number?(s: Text) -> Bool = match index-of-any(s, ["e", "E"]) {
  some(at) => mantissa?(s[0..at]) and exponent?(s[at + 1..len(s)])
  none => mantissa?(s)
}

fn mantissa?(s: Text) -> Bool = match split(s, ".") {
  [whole] => whole != "" and all-digits?(whole)
  [whole, fraction] => all-digits?(whole) and fraction != "" and all-digits?(fraction)
  _ => false
}

fn exponent?(s: Text) -> Bool = match s {
  "+" ++ rest | "-" ++ rest => rest != "" and all-digits?(rest)
  _ => s != "" and all-digits?(s)
}

fn all-digits?(s: Text) -> Bool = span-of(s, 0, "0123456789") == len(s)

fn number?(value: Text) -> Bool = number-text?(value) or cand.has-math-fn?(value)

fn percentage?(value: Text) -> Bool = (ends-with(value, "%") and number-text?(value[0..len(value) - 1])) or cand.has-math-fn?(value)

fn fraction?(value: Text) -> Bool = match index-of(value, "/") {
  some(at) => (number-text?(tx.js-trim-end(value[0..at])) and number-text?(tx.js-trim-start(value[at + 1..len(value)])))
              or cand.has-math-fn?(value)
  none => cand.has-math-fn?(value)
}

const length-units: [Text] = ["cm", "mm", "Q", "in", "pc", "pt", "px", "em", "ex", "ch", "cap", "ic", "rem", "rex", "rch", "rcap", "ric",
  "lh", "rlh", "vw", "vh", "vmin", "vmax", "vb", "vi", "svw", "svh", "svi", "svb", "svmin", "svmax", "lvw", "lvh", "lvi", "lvb", "lvmin",
  "lvmax", "dvw", "dvh", "dvi", "dvb", "dvmin", "dvmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"]

const angle-units: [Text] = ["deg", "rad", "grad", "turn"]

# A number followed by one of these units, all of the text.
fn with-unit?(value: Text, units: [Text]) -> Bool = any u in units: ends-with(value, u) and len(value) > len(u) and number-text?(value[0..len(value) - len(u)])

fn length?(value: Text) -> Bool = with-unit?(value, length-units) or starts-with(ascii-lower(value), "--spacing(") or cand.has-math-fn?(value)

fn angle?(value: Text) -> Bool = with-unit?(value, angle-units)

fn vector?(value: Text) -> Bool = match [p for p in split(value, " ") if p != ""] {
  [a, b, c] => number-text?(a) and number-text?(b) and number-text?(c) and not has-byte?(value, '\t') and value[0] != ' ' and value[len(value) - 1] != ' '
  _ => false
}

fn background-position?(value: Text) -> Bool = match [position-part(part) for part in tx.segment(value, ' ')] {
  kinds if any k in kinds: k == 0 => false
  kinds => any k in kinds: k == 1
}

fn position-part(part: Text) -> Int = match part {
  "center" | "top" | "right" | "bottom" | "left" => 1
  "var(" ++ _ => 2
  _ if length?(part) or percentage?(part) => 1
  _ => 0
}

# A size of more than two values makes none of them sizes; one that is not made of sizes is not
# counted.
fn background-size?(value: Text) -> Bool = match [size-kind(size) for size in tx.segment(value, ',')] {
  kinds if any k in kinds: k == 0 => false
  kinds => any k in kinds: k == 1
}

fn size-kind(size: Text) -> Int = match size {
  "cover" | "contain" => 1
  _ => match tx.segment(size, ' ') {
    vs if len(vs) != 1 and len(vs) != 2 => 0
    vs if all v in vs: v == "auto" or length?(v) or percentage?(v) => 1
    _ => 2
  }
}

# Tailwind's `isColor`.
fn color?(value: Text) -> Bool = (value != "" and value[0] == '#') or color-function?(ascii-lower(value)) or (ascii-lower(value) in named-colors)

fn color-function?(lower: Text) -> Bool = any f in ["rgb(", "rgba(", "hsl(", "hsla(", "hwb(", "color(", "lab(", "lch(", "oklab(", "oklch(",
  "light-dark(", "color-mix(", "--alpha("]: starts-with(lower, f)

fn named-color?(value: Text) -> Bool = ascii-lower(value) in named-colors

const named-colors: [Text] = ["black", "silver", "gray", "white", "maroon", "red", "purple", "fuchsia", "green", "lime", "olive", "yellow",
  "navy", "blue", "teal", "aqua", "aliceblue", "antiquewhite", "aquamarine", "azure", "beige", "bisque", "blanchedalmond", "blueviolet",
  "brown", "burlywood", "cadetblue", "chartreuse", "chocolate", "coral", "cornflowerblue", "cornsilk", "crimson", "cyan", "darkblue",
  "darkcyan", "darkgoldenrod", "darkgray", "darkgreen", "darkgrey", "darkkhaki", "darkmagenta", "darkolivegreen", "darkorange",
  "darkorchid", "darkred", "darksalmon", "darkseagreen", "darkslateblue", "darkslategray", "darkslategrey", "darkturquoise",
  "darkviolet", "deeppink", "deepskyblue", "dimgray", "dimgrey", "dodgerblue", "firebrick", "floralwhite", "forestgreen", "gainsboro",
  "ghostwhite", "gold", "goldenrod", "greenyellow", "grey", "honeydew", "hotpink", "indianred", "indigo", "ivory", "khaki", "lavender",
  "lavenderblush", "lawngreen", "lemonchiffon", "lightblue", "lightcoral", "lightcyan", "lightgoldenrodyellow", "lightgray",
  "lightgreen", "lightgrey", "lightpink", "lightsalmon", "lightseagreen", "lightskyblue", "lightslategray", "lightslategrey",
  "lightsteelblue", "lightyellow", "limegreen", "linen", "magenta", "mediumaquamarine", "mediumblue", "mediumorchid", "mediumpurple",
  "mediumseagreen", "mediumslateblue", "mediumspringgreen", "mediumturquoise", "mediumvioletred", "midnightblue", "mintcream",
  "mistyrose", "moccasin", "navajowhite", "oldlace", "olivedrab", "orange", "orangered", "orchid", "palegoldenrod", "palegreen",
  "paleturquoise", "palevioletred", "papayawhip", "peachpuff", "peru", "pink", "plum", "powderblue", "rebeccapurple", "rosybrown",
  "royalblue", "saddlebrown", "salmon", "sandybrown", "seagreen", "seashell", "sienna", "skyblue", "slateblue", "slategray",
  "slategrey", "snow", "springgreen", "steelblue", "tan", "thistle", "tomato", "turquoise", "violet", "wheat", "whitesmoke",
  "yellowgreen", "transparent", "currentcolor", "canvas", "canvastext", "linktext", "visitedtext", "activetext", "buttonface",
  "buttontext", "buttonborder", "field", "fieldtext", "highlight", "highlighttext", "selecteditem", "selecteditemtext", "mark",
  "marktext", "graytext", "accentcolor", "accentcolortext"]
