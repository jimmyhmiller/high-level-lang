      for u in spacing(x[0], ["--padding", "--spacing"], [d(x[1], "$")], false, false)]
  ++ [s1("text-" ++ v, "text-align", v) for v in ["left", "center", "right", "justify", "start", "end"]]
  ++ spacing("indent", ["--text-indent", "--spacing"], [d("text-indent", "$")], true, false)
  ++ [s1("align-" ++ v, "vertical-align", v) for v in ["baseline", "top", "middle", "bottom", "text-top", "text-bottom", "sub", "super"]]
  ++ [value("align", [], [d("vertical-align", "$")]), own("font"),
      value("font-features", [], [d("font-feature-settings", "$")]),
      s1("uppercase", "text-transform", "uppercase"), s1("lowercase", "text-transform", "lowercase"),
      s1("capitalize", "text-transform", "capitalize"), s1("normal-case", "text-transform", "none"),
      s1("italic", "font-style", "italic"), s1("not-italic", "font-style", "normal"),
      s1("underline", "text-decoration-line", "underline"), s1("overline", "text-decoration-line", "overline"),
      s1("line-through", "text-decoration-line", "line-through"), s1("no-underline", "text-decoration-line", "none")]
  ++ [s1("font-stretch-" ++ v, "font-stretch", v) for v in ["normal", "ultra-condensed", "extra-condensed", "condensed", "semi-condensed",
      "semi-expanded", "expanded", "extra-expanded", "ultra-expanded"]]
  ++ [value("font-stretch", [], [d("font-stretch", "$")]) with { bare: "font-stretch" },
      color("placeholder", ["--placeholder-color", "--color"], [nest("&::placeholder", [d("--tw-sort", "placeholder-color"), d("color", "$")])])]
  ++ [s1("decoration-" ++ v, "text-decoration-style", v) for v in ["solid", "double", "dotted", "dashed", "wavy"]]
  ++ [s1("decoration-auto", "text-decoration-thickness", "auto"), s1("decoration-from-font", "text-decoration-thickness", "from-font"),
      own("decoration"),
      value("animate", ["--animate"], [d("animation", "$")]) with { values: {"none": [d("animation", "none")]} },
      own("filter"), own("backdrop-filter"),
      value("blur", ["--blur"], filter-out("blur", "blur")) with { values: {"none": [props("filter"), d("--tw-blur", " "), d("filter", filter-value)]} },
      value("backdrop-blur", ["--backdrop-blur", "--blur"], backdrop-out("blur", "blur")) with { values: {"none": [props("backdrop"),
        d("--tw-backdrop-blur", " "), d("-webkit-backdrop-filter", backdrop-value), d("backdrop-filter", backdrop-value)]} },
      integer-value("brightness", ["--brightness"], filter-out("brightness", "brightness"), "integer-percent"),
      integer-value("backdrop-brightness", ["--backdrop-brightness", "--brightness"], backdrop-out("brightness", "brightness"), "integer-percent"),
      integer-value("contrast", ["--contrast"], filter-out("contrast", "contrast"), "integer-percent"),
      integer-value("backdrop-contrast", ["--backdrop-contrast", "--contrast"], backdrop-out("contrast", "contrast"), "integer-percent"),
      integer-value("grayscale", ["--grayscale"], filter-out("grayscale", "grayscale"), "integer-percent") with { defaulted: true, default: some("100%") },
      integer-value("backdrop-grayscale", ["--backdrop-grayscale", "--grayscale"], backdrop-out("grayscale", "grayscale"), "integer-percent")
        with { defaulted: true, default: some("100%") }]
  ++ signed(integer-value("hue-rotate", ["--hue-rotate"], filter-out("hue-rotate", "hue-rotate"), "integer-deg"))
  ++ signed(integer-value("backdrop-hue-rotate", ["--backdrop-hue-rotate", "--hue-rotate"], backdrop-out("hue-rotate", "hue-rotate"), "integer-deg"))
  ++ [integer-value("invert", ["--invert"], filter-out("invert", "invert"), "integer-percent") with { defaulted: true, default: some("100%") },
      integer-value("backdrop-invert", ["--backdrop-invert", "--invert"], backdrop-out("invert", "invert"), "integer-percent")
        with { defaulted: true, default: some("100%") },
      integer-value("saturate", ["--saturate"], filter-out("saturate", "saturate"), "integer-percent"),
      integer-value("backdrop-saturate", ["--backdrop-saturate", "--saturate"], backdrop-out("saturate", "saturate"), "integer-percent"),
      integer-value("sepia", ["--sepia"], filter-out("sepia", "sepia"), "integer-percent") with { defaulted: true, default: some("100%") },
      integer-value("backdrop-sepia", ["--backdrop-sepia", "--sepia"], backdrop-out("sepia", "sepia"), "integer-percent")
        with { defaulted: true, default: some("100%") },
      fixed("drop-shadow-none", [props("filter"), d("--tw-drop-shadow", " "), d("filter", filter-value)]),
      own("drop-shadow"),
      value("backdrop-opacity", ["--backdrop-opacity", "--opacity"], backdrop-out("opacity", "opacity")) with { bare: "opacity-percent" },
      value("transition", ["--transition-property"], transition-out("$")) with { defaulted: true,
        default: some("color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to, opacity, box-shadow, transform, translate, scale, rotate, filter, -webkit-backdrop-filter, backdrop-filter, display, content-visibility, overlay, pointer-events"),
        values: {"none": [d("transition-property", "none")], "all": transition-out("all"),
          "colors": transition-out("color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to"),
          "opacity": transition-out("opacity"), "shadow": transition-out("box-shadow"),
          "transform": transition-out("transform, translate, scale, rotate")} },
      s1("transition-discrete", "transition-behavior", "allow-discrete"), s1("transition-normal", "transition-behavior", "normal"),
      integer-value("delay", ["--transition-delay"], [d("transition-delay", "$")], "integer-ms"),
      fixed("duration-initial", [props("duration"), d("--tw-duration", "initial")]),
      own("duration"),
      value("ease", ["--ease"], [props("ease"), d("--tw-ease", "$"), d("transition-timing-function", "$")]) with { values: {
        "initial": [props("ease"), d("--tw-ease", "initial")],
        "linear": [props("ease"), d("--tw-ease", "linear"), d("transition-timing-function", "linear")]} },
      s1("will-change-auto", "will-change", "auto"), s1("will-change-scroll", "will-change", "scroll-position"),
      s1("will-change-contents", "will-change", "contents"), s1("will-change-transform", "will-change", "transform"),
      value("will-change", [], [d("will-change", "$")]),
      fixed("content-none", [d("--tw-content", "none"), d("content", "none")]),
      value("content", ["--content"], [props("content"), d("--tw-content", "$"), d("content", "var(--tw-content)")]),
      s1("contain-none", "contain", "none"), s1("contain-content", "contain", "content"), s1("contain-strict", "contain", "strict"),
      fixed("contain-size", [props("contain"), d("--tw-contain-size", "size"), d("contain", contain-value)]),
      fixed("contain-inline-size", [props("contain"), d("--tw-contain-size", "inline-size"), d("contain", contain-value)]),
      fixed("contain-layout", [props("contain"), d("--tw-contain-layout", "layout"), d("contain", contain-value)]),
      fixed("contain-paint", [props("contain"), d("--tw-contain-paint", "paint"), d("contain", contain-value)]),
      fixed("contain-style", [props("contain"), d("--tw-contain-style", "style"), d("contain", contain-value)]),
      value("contain", [], [d("contain", "$")]),
      s1("forced-color-adjust-none", "forced-color-adjust", "none"), s1("forced-color-adjust-auto", "forced-color-adjust", "auto")]
  ++ [u with { values: {"none": [props("leading"), d("--tw-leading", "1"), d("line-height", "1")]} } for u in
      spacing("leading", ["--leading", "--spacing"], [props("leading"), d("--tw-leading", "$"), d("line-height", "$")], false, false)]
  ++ signed(value("tracking", ["--tracking"], [props("tracking"), d("--tw-tracking", "$"), d("letter-spacing", "$")]))
  ++ [fixed("antialiased", [d("-webkit-font-smoothing", "antialiased"), d("-moz-osx-font-smoothing", "grayscale")]),
      fixed("subpixel-antialiased", [d("-webkit-font-smoothing", "auto"), d("-moz-osx-font-smoothing", "auto")]),
      s1("normal-nums", "font-variant-numeric", "normal")]
  ++ [fixed(x[0], [props("numeric"), d(x[1], x[0]), d("font-variant-numeric", numeric-value)]) for x in [["ordinal", "--tw-ordinal"],
      ["slashed-zero", "--tw-slashed-zero"], ["lining-nums", "--tw-numeric-figure"], ["oldstyle-nums", "--tw-numeric-figure"],
      ["proportional-nums", "--tw-numeric-spacing"], ["tabular-nums", "--tw-numeric-spacing"],
      ["diagonal-fractions", "--tw-numeric-fraction"], ["stacked-fractions", "--tw-numeric-fraction"]]]
  ++ [own-static("outline-hidden")]
  ++ [fixed("outline-" ++ v, [d("--tw-outline-style", v), d("outline-style", v)]) for v in ["none", "solid", "dashed", "dotted", "double"]]
  ++ [own("outline")]
  ++ signed(integer-value("outline-offset", ["--outline-offset"], [d("outline-offset", "$")], "integer-px"))
  ++ [value("opacity", ["--opacity"], [d("opacity", "$")]) with { bare: "opacity-percent" }]
  ++ signed(integer-value("underline-offset", ["--text-underline-offset"], [d("text-underline-offset", "$")], "integer-px")
            with { values: {"auto": [d("text-underline-offset", "auto")]} })
  ++ [own("text"), fixed("text-shadow-initial", [props("text-shadow"), d("--tw-text-shadow-color", "initial")]), own("text-shadow"),
      fixed("shadow-initial", [props("box-shadow"), d("--tw-shadow-color", "initial")]), own("shadow"),
      fixed("inset-shadow-initial", [props("box-shadow"), d("--tw-inset-shadow-color", "initial")]), own("inset-shadow"),
      fixed("ring-inset", [props("box-shadow"), d("--tw-ring-inset", "inset")]), own("ring"), own("inset-ring"), own("ring-offset"),
      own("@container")]
  ++ legacy()

# Tailwind's `registerLegacyUtilities`, after the core's.
fn legacy() -> [U] =
  [fixed("bg-gradient-to-" ++ x[0], [d("--tw-gradient-position", "to " ++ x[1] ++ " in oklab"), d("background-image", "linear-gradient(var(--tw-gradient-stops))")])
   for x in [["t", "top"], ["tr", "top right"], ["r", "right"], ["br", "bottom right"], ["b", "bottom"], ["bl", "bottom left"],
             ["l", "left"], ["tl", "top left"]]]
  ++ [s1("bg-left-top", "background-position", "left top"), s1("bg-right-top", "background-position", "right top"),
      s1("bg-left-bottom", "background-position", "left bottom"), s1("bg-right-bottom", "background-position", "right bottom"),
      s1("object-left-top", "object-position", "left top"), s1("object-right-top", "object-position", "right top"),
      s1("object-left-bottom", "object-position", "left bottom"), s1("object-right-bottom", "object-position", "right bottom"),
      own("max-w-screen"), s1("overflow-ellipsis", "text-overflow", "ellipsis"),
      fixed("decoration-slice", [d("-webkit-box-decoration-break", "slice"), d("box-decoration-break", "slice")]),
      fixed("decoration-clone", [d("-webkit-box-decoration-break", "clone"), d("box-decoration-break", "clone")]),
      own("flex-shrink"), own("flex-grow"), s1("order-none", "order", "0"), s1("break-words", "overflow-wrap", "break-word")]
  ++ [u for x in [["start", "inset-inline-start"], ["end", "inset-inline-end"]]
      for u in [s1(x[0] ++ "-auto", x[1], "auto"), s1(x[0] ++ "-full", x[1], "100%"), s1("-" ++ x[0] ++ "-full", x[1], "-100%"),
                s1(x[0] ++ "-px", x[1], "1px"), s1("-" ++ x[0] ++ "-px", x[1], "-1px"), own("-" ++ x[0]), own(x[0])]]

fn ascii-upper(s: Text) -> Text = text-of-bytes([if c >= 97 and c <= 122 then c - 32 else c for c in byte-list(s)])

fn byte-list(s: Text) -> [Int] = [s[i] for i in 0..len(s)]

# ---------------------------------------------------------------- what a utility makes

# What a utility makes of a candidate, none when it does not take it.
fn compiled(u: U, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match u.how {
  Fixed => handled(u, u.fill, t)
  Value => value-utility(u, c, t)
  Color => color-utility(u, c, t)
  Own => own-made(u, c, t)
}

fn handled(u: U, value: Text, t: th.Theme) -> [ast.Css]? = match u.handler {
  "" => some(filled(u.out, value, t))
  h => some(own-handled(h, value))
}

fn handled-negated(u: U, value: Text, t: th.Theme) -> [ast.Css]? =
  handled(u, if u.negated then cand.math-spaced("calc(" ++ value ++ " * -1)") else value, t)

# Tailwind's `functionalUtility`.
fn value-utility(u: U, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none if is-some(c.modifier) => none
  none => first v in default-value(u, t) for out in handled-negated(u, v, t): out
  some(v) if v.arbitrary and is-some(c.modifier) => none
  some(v) if v.arbitrary => handled-negated(u, v.value, t)
  some(v) => match th.resolve(t, some(v.fraction ?? v.value), u.keys) {
    some(_) if is-some(c.modifier) and is-none(v.fraction) => none
    some(x) => handled-negated(u, x, t)
    none => unthemed(u, c, v, t)
  }
}

fn default-value(u: U, t: th.Theme) -> Text? = match u.defaulted {
  true if u.default-key != "" => th.raw(t, [u.default-key]) ?? u.default
  true => u.default
  false => th.resolve(t, none, u.keys)
}

# A named value the theme does not have: a fraction, a bare value, or a fixed one.
fn unthemed(u: U, c: cand.Candidate, v: cand.UtilityValue, t: th.Theme) -> [ast.Css]? = match v.fraction {
  some(f) if u.fractions => match tx.segment(f, '/') {
    [l, r] if num.positive-integer?(l) and num.positive-integer?(r) => handled-negated(u, "calc(" ++ l ++ " / " ++ r ++ " * 100%)", t)
    _ => none
  }
  _ => match u.negated and u.negative-bare != "" {
    true => match bare-value(u.negative-bare, v, t) {
      b if is-some(c.modifier) and not slashed?(b) => none
      some(b) => handled(u, b, t)
      none => positive-bare(u, c, v, t)
    }
    false => positive-bare(u, c, v, t)
  }
}

fn slashed?(b: Text?) -> Bool = match b {
  some(x) => has-byte?(x, '/')
  none => false
}

fn positive-bare(u: U, c: cand.Candidate, v: cand.UtilityValue, t: th.Theme) -> [ast.Css]? = match u.bare {
  "" => fixed-value(u, c, v, t)
  rule => match bare-value(rule, v, t) {
    b if is-some(c.modifier) and not slashed?(b) => none
    some(b) => handled-negated(u, b, t)
    none => fixed-value(u, c, v, t)
  }
}

fn fixed-value(u: U, c: cand.Candidate, v: cand.UtilityValue, t: th.Theme) -> [ast.Css]? = match u.values[v.value] {
  some(out) if not u.negated and is-none(c.modifier) => some(filled(out, "", t))
  _ => none
}

# What a bare value (`4`, `1/2`, `50%`) is, by the rule a utility names.
fn bare-value(rule: Text, v: cand.UtilityValue, t: th.Theme) -> Text? = match rule {
  "integer" => if num.positive-integer?(v.value) then some(v.value) else none
  "integer-percent" => if num.positive-integer?(v.value) then some(v.value ++ "%") else none
  "integer-deg" => if num.positive-integer?(v.value) then some(v.value ++ "deg") else none
  "integer-px" => if num.positive-integer?(v.value) then some(v.value ++ "px") else none
  "integer-ms" => if num.positive-integer?(v.value) then some(v.value ++ "ms") else none
  "repeat" => if num.strict-positive-integer?(v.value) then some("repeat(" ++ v.value ++ ", minmax(0, 1fr))") else none
  "spacing" => if spaced?(t) and num.quarter-multiple?(v.value) then some("--spacing(" ++ v.value ++ ")") else none
  "negative-spacing" => if spaced?(t) and num.quarter-multiple?(v.value) then some("--spacing(-" ++ v.value ++ ")") else none
  "opacity-percent" => if num.quarter-multiple?(v.value) then some(v.value ++ "%") else none
  "aspect" => match v.fraction {
    some(f) => match tx.segment(f, '/') {
      [l, r] if num.quarter-multiple?(l) and num.quarter-multiple?(r) => some(f)
      _ => none
    }
    none => none
  }
  "font-stretch" => match v.value {
    n ++ "%" if num.positive-integer?(js-number-text(n)) and parse-int(js-number-text(n)) >= 50 and parse-int(js-number-text(n)) <= 200 => some(v.value)
    _ => none
  }
  "mask-angle" => match v.value {
    x if not num.positive-integer?(x) => none
    x if num.zero?(x) => some("0deg")
    x if num.one?(x) => some("1deg")
    x => some("calc(1deg * " ++ x ++ ")")
  }
  "negative-mask-angle" => match v.value {
    x if not num.positive-integer?(x) => none
    x if num.zero?(x) => some("0deg")
    x if num.one?(x) => some("-1deg")
    x => some("calc(1deg * -" ++ x ++ ")")
  }
  _ => panic "tailwind: no bare value rule {}", rule
}

fn spaced?(t: th.Theme) -> Bool = is-some(th.resolve(t, none, ["--spacing"]))

# Tailwind's `colorUtility`.
fn color-utility(u: U, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => first x in as-color(v.value, c.modifier, t): filled(u.out, x, t)
  some(v) => first x in theme-color(c, v, t, u.keys): filled(u.out, x, t)
}

# ---------------------------------------------------------------- colors

# Tailwind's `withAlpha`: a color with an alpha (a number is a fraction of 100%), mixed with
# transparent unless it is all of it.
fn with-alpha(value: Text, alpha: Text) -> Text = match (if num.number?(alpha) then num.percent-of(alpha) else alpha) {
  "100%" => value
  a => "color-mix(in oklab, " ++ value ++ " " ++ a ++ ", transparent)"
}

fn replace-alpha(value: Text, alpha: Text) -> Text =
  "oklab(from " ++ value ++ " l a b / " ++ (if num.number?(alpha) then num.percent-of(alpha) else alpha) ++ ")"

# Tailwind's `asColor`: the color with its opacity modifier.
fn as-color(value: Text, modifier: cand.Named?, t: th.Theme) -> Text? = match modifier {
  none => some(value)
  some(m) if m.arbitrary => some(with-alpha(value, m.value))
  some(m) => match th.resolve(t, some(m.value), ["--opacity"]) {
    some(alpha) => some(with-alpha(value, alpha))
    none if num.quarter-multiple?(m.value) => some(with-alpha(value, m.value ++ "%"))
    none => none
  }
}

# Tailwind's `resolveThemeColor`.
fn theme-color(c: cand.Candidate, v: cand.UtilityValue, t: th.Theme, keys: [Text]) -> Text? = match v.value {
  "inherit" => as-color("inherit", c.modifier, t)
  "transparent" => as-color("transparent", c.modifier, t)
  "current" => as-color("currentcolor", c.modifier, t)
  name => first x in th.resolve(t, some(name), keys) for colored in as-color(x, c.modifier, t): colored
}

fn named-value(c: cand.Candidate) -> Text? = first v in c.value if not v.arbitrary: v.value

fn modifier-alpha(c: cand.Candidate) -> Text? = match c.modifier {
  some(m) if m.arbitrary => some(m.value)
  some(m) if num.quarter-multiple?(m.value) => some(m.value ++ "%")
  _ => none
}

# ---------------------------------------------------------------- utilities of their own

fn decls(pairs: [[Text]]) -> [ast.Css] = [ast.decl(x[0], x[1]) for x in pairs]
fn at-props(group: Text) -> ast.Css = ast.at-root(property-group(group))

fn arbitrary-type(v: cand.UtilityValue, types: [Text]) -> Text? = match v.data-type {
  some(dt) => some(dt)
  none => ty.infer(v.value, types)
}

fn own-made(u: U, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match u.name {
  "container" => some([ast.decl("--tw-sort", "--tw-container-component"), ast.decl("width", "100%")]
    ++ [ast.at-rule("@media", "(width >= " ++ b ++ ")", [ast.decl("max-width", b)]) for b in sorted-breakpoints(t)])
  "flex" => match c.value {
    none => none
    some(v) if v.arbitrary => if is-some(c.modifier) then none else some([ast.decl("flex", v.value)])
    some(v) => match v.fraction {
      some(f) => match tx.segment(f, '/') {
        [l, r] if num.positive-integer?(l) and num.positive-integer?(r) => some([ast.decl("flex", "calc(" ++ f ++ " * 100%)")])
        _ => none
      }
      none if num.positive-integer?(v.value) and is-none(c.modifier) => some([ast.decl("flex", v.value)])
      none => none
    }
  }
  "scale" | "-scale" => scaled(c, t, u.name == "-scale")
  "rotate" | "-rotate" => rotated(c, t, u.name == "-rotate")
  "transform" => match c.value {
    _ if is-some(c.modifier) => none
    none => some([at-props("transform"), ast.decl("transform", transform-value)])
    some(v) if v.arbitrary => some([at-props("transform"), ast.decl("transform", v.value)])
    _ => none
  }
  "border" | "border-x" | "border-y" | "border-s" | "border-e" | "border-bs" | "border-be" | "border-t" | "border-r" | "border-b" | "border-l" =>
    border-side(u.name, c, t)
  "bg-linear" | "-bg-linear" => bg-linear(c, t, u.name == "-bg-linear")
  "bg-conic" | "-bg-conic" => bg-conic(c, t, u.name == "-bg-conic")
  "bg-radial" => match c.value {
    none => some(decls([["--tw-gradient-position", interpolation(c.modifier)], ["background-image", "radial-gradient(var(--tw-gradient-stops))"]]))
    some(v) if v.arbitrary and is-none(c.modifier) =>
      some(decls([["--tw-gradient-position", v.value], ["background-image", "radial-gradient(var(--tw-gradient-stops," ++ v.value ++ "))"]]))
    _ => none
  }
  "bg" => background(c, t)
  "from" | "via" | "to" => gradient-stop(u.name, c, t)
  "mask" => match c.value {
    some(v) if v.arbitrary and is-none(c.modifier) => match arbitrary-type(v, ["image", "percentage", "position", "bg-size", "length", "url"]) {
      some("percentage") | some("position") => some([ast.decl("mask-position", v.value)])
      some("bg-size") | some("length") | some("size") => some([ast.decl("mask-size", v.value)])
      _ => some([ast.decl("mask-image", v.value)])
    }
    _ => none
  }
  "mask-x-from" | "mask-x-to" | "mask-y-from" | "mask-y-to" | "mask-t-from" | "mask-t-to" | "mask-r-from" | "mask-r-to" | "mask-b-from"
  | "mask-b-to" | "mask-l-from" | "mask-l-to" => mask-stop(u.name, c, t)
  "mask-linear-from" | "mask-linear-to" | "mask-radial-from" | "mask-radial-to" | "mask-conic-from" | "mask-conic-to" => mask-stop(u.name, c, t)
  "fill" => match c.value {
    none => none
    some(v) if v.arbitrary => first x in as-color(v.value, c.modifier, t): [ast.decl("fill", x)]
    some(v) => first x in theme-color(c, v, t, ["--fill", "--color"]): [ast.decl("fill", x)]
  }
  "stroke" => match c.value {
    none => none
    some(v) if v.arbitrary => match arbitrary-type(v, ["color", "number", "length", "percentage"]) {
      some("number") | some("length") | some("percentage") => if is-some(c.modifier) then none else some([ast.decl("stroke-width", v.value)])
      _ => first x in as-color(v.value, c.modifier, t): [ast.decl("stroke", x)]
    }
    some(v) => match theme-color(c, v, t, ["--stroke", "--color"]) {
      some(x) => some([ast.decl("stroke", x)])
      none if is-some(c.modifier) => none
      none => match th.resolve(t, some(v.value), ["--stroke-width"]) {
        some(w) => some([ast.decl("stroke-width", w)])
        none if num.positive-integer?(v.value) => some([ast.decl("stroke-width", v.value)])
        none => none
      }
    }
  }
  "font" => font(c, t)
  "decoration" => decoration(c, t)
  "filter" => match c.value {
    _ if is-some(c.modifier) => none
    none => some([at-props("filter"), ast.decl("filter", filter-value)])
    some(v) if v.arbitrary => some([ast.decl("filter", v.value)])
    some(v) if v.value == "none" => some([ast.decl("filter", "none")])
    _ => none
  }
  "backdrop-filter" => match c.value {
    _ if is-some(c.modifier) => none
    none => some([at-props("backdrop"), ast.decl("-webkit-backdrop-filter", backdrop-value), ast.decl("backdrop-filter", backdrop-value)])
    some(v) if v.arbitrary => some([ast.decl("-webkit-backdrop-filter", v.value), ast.decl("backdrop-filter", v.value)])
    some(v) if v.value == "none" => some([ast.decl("-webkit-backdrop-filter", "none"), ast.decl("backdrop-filter", "none")])
    _ => none
  }
  "drop-shadow" => drop-shadow(c, t)
  "duration" => match c.value {
    _ if is-some(c.modifier) => none
    none => none
    some(v) => first x in (if v.arbitrary then some(v.value) else duration-of(v, t)):
      [at-props("duration"), ast.decl("--tw-duration", x), ast.decl("transition-duration", x)]
  }
  "outline-hidden" => some([ast.decl("--tw-outline-style", "none"), ast.decl("outline-style", "none"),
    ast.at-rule("@media", "(forced-colors: active)", [ast.decl("outline", "2px solid transparent"), ast.decl("outline-offset", "2px")])])
  "outline" => outline(c, t)
  "text" => text(c, t)
  "text-shadow" => shadowed(c, t, "text-shadow")
  "shadow" => shadowed(c, t, "shadow")
  "inset-shadow" => shadowed(c, t, "inset-shadow")
  "ring" => ring(c, t, false)
  "inset-ring" => ring(c, t, true)
  "ring-offset" => ring-offset(c, t)
  "@container" => match c.value {
    none => container-type("inline-size", c)
    some(v) if v.arbitrary => container-type(v.value, c)
    some(v) if v.value == "normal" or v.value == "size" => container-type(v.value, c)
    _ => none
  }
  "max-w-screen" => match c.value {
    some(v) if not v.arbitrary => first x in th.resolve(t, some(v.value), ["--breakpoint"]): [ast.decl("max-width", x)]
    _ => none
  }
  "flex-shrink" | "flex-grow" => match c.value {
    _ if is-some(c.modifier) => none
    none => some([ast.decl(u.name, "1")])
    some(v) if v.arbitrary => some([ast.decl(u.name, v.value)])
    some(v) if num.positive-integer?(v.value) => some([ast.decl(u.name, v.value)])
    _ => none
  }
  "start" | "-start" => legacy-inset(c, t, "inset-inline-start", u.name == "-start")
  "end" | "-end" => legacy-inset(c, t, "inset-inline-end", u.name == "-end")
  _ => fail-build("tailwind: the utility `" ++ u.name ++ "` has no implementation")
}

fn own-handled(handler: Text, value: Text) -> [ast.Css] = match handler {
  "space-x" => [at-props("space-x"), ast.style-rule(children, [ast.decl("--tw-sort", "row-gap"), ast.decl("--tw-space-x-reverse", "0"),
    ast.decl("margin-inline-start", if zero-spacing?(value) then "0" else "calc(" ++ value ++ " * var(--tw-space-x-reverse))"),
    ast.decl("margin-inline-end", if zero-spacing?(value) then "0" else "calc(" ++ value ++ " * calc(1 - var(--tw-space-x-reverse)))")])]
  "space-y" => [at-props("space-y"), ast.style-rule(children, [ast.decl("--tw-sort", "column-gap"), ast.decl("--tw-space-y-reverse", "0"),
    ast.decl("margin-block-start", if zero-spacing?(value) then "0" else "calc(" ++ value ++ " * var(--tw-space-y-reverse))"),
    ast.decl("margin-block-end", if zero-spacing?(value) then "0" else "calc(" ++ value ++ " * calc(1 - var(--tw-space-y-reverse)))")])]
  _ => panic "tailwind: no handler {}", handler
}

# `space-x-0`'s margins are 0, not a product.
fn zero-spacing?(value: Text) -> Bool = match value {
  "--spacing(0)" | "--spacing(-0)" => true
  _ => match num.dimension(value) {
    some(dim) => num.zero?(dim.number) and (dim.unit == "" or ty.length?(value))
    none => false
  }
}

fn sorted-breakpoints(t: th.Theme) -> [Text] = sort-breakpoints([n.value for n in th.namespace(t, "--breakpoint")], true)

# Breakpoints in Tailwind's order (`compareBreakpoints`), by insertion: stable, as Array.sort is.
fn sort-breakpoints(xs: [Text], ascending: Bool) -> [Text] = fold out = [] for x in xs: inserted-breakpoint(out, x, ascending)

fn inserted-breakpoint(sorted: [Text], x: Text, ascending: Bool) -> [Text] =
  sorted[0..at] ++ [x] ++ sorted[at..len(sorted)]
  where at = len([s for s in sorted while num.compare-breakpoints(s, x, ascending) <= 0])

fn scaled(c: cand.Candidate, t: th.Theme, negative: Bool) -> [ast.Css]? = match c.value {
  _ if is-some(c.modifier) => none
  none => none
  some(v) if v.arbitrary => some([ast.decl("scale", if negative then "calc(" ++ v.value ++ " * -1)" else v.value)])
  some(v) => first x in (th.resolve(t, some(v.value), ["--scale"]) ?? integer-with(v.value, "%"))
    for s in [if negative then "calc(" ++ x ++ " * -1)" else x]:
    [at-props("scale"), ast.decl("--tw-scale-x", s), ast.decl("--tw-scale-y", s), ast.decl("--tw-scale-z", s),
     ast.decl("scale", "var(--tw-scale-x) var(--tw-scale-y)")]
}

fn rotated(c: cand.Candidate, t: th.Theme, negative: Bool) -> [ast.Css]? = match c.value {
  _ if is-some(c.modifier) => none
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["angle", "vector"]) {
    some("vector") => some([ast.decl("rotate", v.value ++ " var(--tw-rotate)")])
    _ => some([ast.decl("rotate", if negative then "calc(" ++ v.value ++ " * -1)" else v.value)])
  }
  some(v) => first x in (th.resolve(t, some(v.value), ["--rotate"]) ?? integer-with(v.value, "deg")):
    [ast.decl("rotate", if negative then "calc(" ++ x ++ " * -1)" else x)]
}

# Tailwind's `borderSideUtility`.
fn border-side(root: Text, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none if is-some(c.modifier) => none
  none => some(border-width(root, th.raw(t, ["--default-border-width"]) ?? "1px"))
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "line-width", "length"]) {
    some("line-width") | some("length") => if is-some(c.modifier) then none else some(border-width(root, v.value))
    _ => first x in as-color(v.value, c.modifier, t): [border-color(root, x)]
  }
  some(v) => match theme-color(c, v, t, ["--border-color", "--color"]) {
    some(x) => some([border-color(root, x)])
    none if is-some(c.modifier) => none
    none => match th.resolve(t, some(v.value), ["--border-width"]) {
      some(w) => some(border-width(root, w))
      none if num.positive-integer?(v.value) => some(border-width(root, v.value ++ "px"))
      none => none
    }
  }
}

fn border-side-name(root: Text) -> Text = match root {
  "border" => ""
  "border-x" => "-inline"
  "border-y" => "-block"
  "border-s" => "-inline-start"
  "border-e" => "-inline-end"
  "border-bs" => "-block-start"
  "border-be" => "-block-end"
  "border-t" => "-top"
  "border-r" => "-right"
  "border-b" => "-bottom"
  "border-l" => "-left"
  _ => panic "tailwind: no border side {}", root
}

fn border-width(root: Text, value: Text) -> [ast.Css] =
  [at-props("border"), ast.decl("border" ++ border-side-name(root) ++ "-style", "var(--tw-border-style)"),
   ast.decl("border" ++ border-side-name(root) ++ "-width", value)]

fn border-color(root: Text, value: Text) -> ast.Css = ast.decl("border" ++ border-side-name(root) ++ "-color", value)

fn interpolation(modifier: cand.Named?) -> Text = match modifier {
  some(m) if m.arbitrary => m.value
  some(m) if m.value == "longer" or m.value == "shorter" or m.value == "increasing" or m.value == "decreasing" => "in oklch " ++ m.value ++ " hue"
  some(m) => "in " ++ m.value
  none => "in oklab"
}

fn linear-direction(v: Text) -> Text? = match v {
  "to-t" => some("to top")
  "to-tr" => some("to top right")
  "to-r" => some("to right")
  "to-br" => some("to bottom right")
  "to-b" => some("to bottom")
  "to-bl" => some("to bottom left")
  "to-l" => some("to left")
  "to-tl" => some("to top left")
  _ => none
}

fn bg-linear(c: cand.Candidate, t: th.Theme, negative: Bool) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary and is-some(c.modifier) => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["angle"]) {
    some("angle") => some(decls([["--tw-gradient-position", a], ["background-image", "linear-gradient(var(--tw-gradient-stops," ++ a ++ "))"]]))
      where a = if negative then "calc(" ++ v.value ++ " * -1)" else v.value
    _ if negative => none
    _ => some(decls([["--tw-gradient-position", v.value], ["background-image", "linear-gradient(var(--tw-gradient-stops," ++ v.value ++ "))"]]))
  }
  some(v) => first direction in (if not negative and is-some(linear-direction(v.value)) then linear-direction(v.value)
                                 else if num.positive-integer?(v.value) then some(if negative then "calc(" ++ v.value ++ "deg * -1)" else v.value ++ "deg")
                                 else none):
    [ast.decl("--tw-gradient-position", direction),
     ast.rule("@supports (background-image: linear-gradient(in lab, red, red))", [ast.decl("--tw-gradient-position", direction ++ " " ++ interpolation(c.modifier))]),
     ast.decl("background-image", "linear-gradient(var(--tw-gradient-stops))")]
}

fn bg-conic(c: cand.Candidate, t: th.Theme, negative: Bool) -> [ast.Css]? = match c.value {
  some(v) if v.arbitrary and is-some(c.modifier) => none
  some(v) if v.arbitrary => some(decls([["--tw-gradient-position", v.value], ["background-image", "conic-gradient(var(--tw-gradient-stops," ++ v.value ++ "))"]]))
  none => some(decls([["--tw-gradient-position", interpolation(c.modifier)], ["background-image", "conic-gradient(var(--tw-gradient-stops))"]]))
  some(v) if num.positive-integer?(v.value) =>
    some(decls([["--tw-gradient-position", "from " ++ (if negative then "calc(" ++ v.value ++ "deg * -1)" else v.value ++ "deg") ++ " " ++ interpolation(c.modifier)],
                ["background-image", "conic-gradient(var(--tw-gradient-stops))"]]))
  _ => none
}

fn background(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["image", "color", "percentage", "position", "bg-size", "length", "url"]) {
    some("percentage") | some("position") => if is-some(c.modifier) then none else some([ast.decl("background-position", v.value)])
    some("bg-size") | some("length") | some("size") => if is-some(c.modifier) then none else some([ast.decl("background-size", v.value)])
    some("image") | some("url") => if is-some(c.modifier) then none else some([ast.decl("background-image", v.value)])
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl("background-color", x)]
  }
  some(v) => match theme-color(c, v, t, ["--background-color", "--color"]) {
    some(x) => some([ast.decl("background-color", x)])
    none if is-some(c.modifier) => none
    none => first x in th.resolve(t, some(v.value), ["--background-image"]): [ast.decl("background-image", x)]
  }
}

const gradient-stops: Text = "var(--tw-gradient-via-stops, var(--tw-gradient-position), var(--tw-gradient-from) var(--tw-gradient-from-position), var(--tw-gradient-to) var(--tw-gradient-to-position))"

fn gradient-color(stop: Text, value: Text) -> [ast.Css] = match stop {
  "from" => [at-props("gradient"), ast.decl("--tw-sort", "--tw-gradient-from"), ast.decl("--tw-gradient-from", value), ast.decl("--tw-gradient-stops", gradient-stops)]
  "via" => [at-props("gradient"), ast.decl("--tw-sort", "--tw-gradient-via"), ast.decl("--tw-gradient-via", value),
            ast.decl("--tw-gradient-via-stops", "var(--tw-gradient-position), var(--tw-gradient-from) var(--tw-gradient-from-position), var(--tw-gradient-via) var(--tw-gradient-via-position), var(--tw-gradient-to) var(--tw-gradient-to-position)"),
            ast.decl("--tw-gradient-stops", "var(--tw-gradient-via-stops)")]
  _ => [at-props("gradient"), ast.decl("--tw-sort", "--tw-gradient-to"), ast.decl("--tw-gradient-to", value), ast.decl("--tw-gradient-stops", gradient-stops)]
}

fn gradient-position(stop: Text, value: Text) -> [ast.Css] = [at-props("gradient"), ast.decl("--tw-gradient-" ++ stop ++ "-position", value)]

# Tailwind's `gradientStopUtility`.
fn gradient-stop(stop: Text, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length", "percentage"]) {
    some("length") | some("percentage") => if is-some(c.modifier) then none else some(gradient-position(stop, v.value))
    _ => first x in as-color(v.value, c.modifier, t): gradient-color(stop, x)
  }
  some(v) => match theme-color(c, v, t, ["--background-color", "--color"]) {
    some(x) => some(gradient-color(stop, x))
    none if is-some(c.modifier) => none
    none => match th.resolve(t, some(v.value), ["--gradient-color-stop-positions"]) {
      some(x) => some(gradient-position(stop, x))
      none => match v.value {
        n ++ "%" if num.positive-integer?(n) => some(gradient-position(stop, v.value))
        _ => none
      }
    }
  }
}

# Tailwind's `maskStopUtility`, for the edges' (`maskEdgeUtility`) and the gradients'.
fn mask-stop(name: Text, c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["length", "percentage", "color"]) {
    some("color") => first x in as-color(v.value, c.modifier, t): mask-stopped(name, "color", x)
    some("percentage") => if is-some(c.modifier) or not num.positive-integer?(v.value[0..len(v.value) - 1]) then none
                          else some(mask-stopped(name, "position", v.value))
    _ => if is-some(c.modifier) then none else some(mask-stopped(name, "position", v.value))
  }
  some(v) => match theme-color(c, v, t, ["--background-color", "--color"]) {
    some(x) => some(mask-stopped(name, "color", x))
    none if is-some(c.modifier) => none
    none => match ty.infer(v.value, ["number", "percentage"]) {
      some("number") => if spaced?(t) and num.quarter-multiple?(v.value) then some(mask-stopped(name, "position", "--spacing(" ++ v.value ++ ")")) else none
      some("percentage") => if num.positive-integer?(v.value[0..len(v.value) - 1]) then some(mask-stopped(name, "position", v.value)) else none
      _ => none
    }
  }
}

const mask-image: Text = "var(--tw-mask-linear), var(--tw-mask-radial), var(--tw-mask-conic)"

# What a mask stop sets, its color or its position (`which`).
fn mask-stopped(name: Text, which: Text, value: Text) -> [ast.Css] = match name {
  "mask-linear-" ++ stop => [at-props("mask-gradient"), at-props("mask-linear"), ast.decl("mask-image", mask-image), ast.decl("mask-composite", "intersect"),
    ast.decl("--tw-mask-linear-stops", "var(--tw-mask-linear-position), var(--tw-mask-linear-from-color) var(--tw-mask-linear-from-position), var(--tw-mask-linear-to-color) var(--tw-mask-linear-to-position)"),
    ast.decl("--tw-mask-linear", "linear-gradient(var(--tw-mask-linear-stops))"), ast.decl("--tw-mask-linear-" ++ stop ++ "-" ++ which, value)]
  "mask-radial-" ++ stop => [at-props("mask-gradient"), at-props("mask-radial"), ast.decl("mask-image", mask-image), ast.decl("mask-composite", "intersect"),
    ast.decl("--tw-mask-radial-stops", "var(--tw-mask-radial-shape) var(--tw-mask-radial-size) at var(--tw-mask-radial-position), var(--tw-mask-radial-from-color) var(--tw-mask-radial-from-position), var(--tw-mask-radial-to-color) var(--tw-mask-radial-to-position)"),
    ast.decl("--tw-mask-radial", "radial-gradient(var(--tw-mask-radial-stops))"), ast.decl("--tw-mask-radial-" ++ stop ++ "-" ++ which, value)]
  "mask-conic-" ++ stop => [at-props("mask-gradient"), at-props("mask-conic"), ast.decl("mask-image", mask-image), ast.decl("mask-composite", "intersect"),
    ast.decl("--tw-mask-conic-stops", "from var(--tw-mask-conic-position), var(--tw-mask-conic-from-color) var(--tw-mask-conic-from-position), var(--tw-mask-conic-to-color) var(--tw-mask-conic-to-position)"),
    ast.decl("--tw-mask-conic", "conic-gradient(var(--tw-mask-conic-stops))"), ast.decl("--tw-mask-conic-" ++ stop ++ "-" ++ which, value)]
  "mask-" ++ edge-stop => [at-props("mask-gradient"), at-props("mask-edge"), ast.decl("mask-image", mask-image), ast.decl("mask-composite", "intersect"),
    ast.decl("--tw-mask-linear", "var(--tw-mask-left), var(--tw-mask-right), var(--tw-mask-bottom), var(--tw-mask-top)")]
    ++ [n for e in mask-edges(edge-stop[0..1])
        for n in [ast.decl("--tw-mask-" ++ e, "linear-gradient(to " ++ e ++ ", var(--tw-mask-" ++ e ++ "-from-color) var(--tw-mask-" ++ e ++ "-from-position), var(--tw-mask-" ++ e ++ "-to-color) var(--tw-mask-" ++ e ++ "-to-position))"),
                  at-props("mask-" ++ e), ast.decl("--tw-mask-" ++ e ++ "-" ++ edge-stop[2..len(edge-stop)] ++ "-" ++ which, value)]]
  _ => panic "tailwind: no mask stop {}", name
}

# The edges a mask edge utility's letter stands for, in Tailwind's order.
fn mask-edges(letter: Text) -> [Text] = match letter {
  "x" => ["right", "left"]
  "y" => ["top", "bottom"]
  "t" => ["top"]
  "r" => ["right"]
  "b" => ["bottom"]
  "l" => ["left"]
  _ => panic "tailwind: no mask edge {}", letter
}

fn font(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  _ if is-some(c.modifier) => none
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["number", "generic-name", "family-name"]) {
    some("generic-name") | some("family-name") => some([ast.decl("font-family", v.value)])
    _ => some([at-props("font-weight"), ast.decl("--tw-font-weight", v.value), ast.decl("font-weight", v.value)])
  }
  some(v) => match th.resolve-nested(t, v.value, ["--font"], ["--font-feature-settings", "--font-variation-settings"]) {
    some(w) => some([ast.decl("font-family", w.value), ast.decl-opt("font-feature-settings", w.nested["--font-feature-settings"]),
                     ast.decl-opt("font-variation-settings", w.nested["--font-variation-settings"])])
    none => first x in th.resolve(t, some(v.value), ["--font-weight"]): [at-props("font-weight"), ast.decl("--tw-font-weight", x), ast.decl("font-weight", x)]
  }
}

fn decoration(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length", "percentage"]) {
    some("length") | some("percentage") => if is-some(c.modifier) then none else some([ast.decl("text-decoration-thickness", v.value)])
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl("text-decoration-color", x)]
  }
  some(v) => match th.resolve(t, some(v.value), ["--text-decoration-thickness"]) {
    some(x) => if is-some(c.modifier) then none else some([ast.decl("text-decoration-thickness", x)])
    none if num.positive-integer?(v.value) => if is-some(c.modifier) then none else some([ast.decl("text-decoration-thickness", v.value ++ "px")])
    none => first x in theme-color(c, v, t, ["--text-decoration-color", "--color"]): [ast.decl("text-decoration-color", x)]
  }
}

fn duration-of(v: cand.UtilityValue, t: th.Theme) -> Text? = match th.resolve(t, some(v.fraction ?? v.value), ["--transition-duration"]) {
  some(x) => some(x)
  none if num.positive-integer?(v.value) => some(v.value ++ "ms")
  none => none
}

fn outline-width(value: Text) -> [ast.Css] = [at-props("outline"), ast.decl("outline-style", "var(--tw-outline-style)"), ast.decl("outline-width", value)]

fn outline(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none if is-some(c.modifier) => none
  none => some(outline-width(th.raw(t, ["--default-outline-width"]) ?? "1px"))
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length", "number", "percentage"]) {
    some("length") | some("number") | some("percentage") => if is-some(c.modifier) then none else some(outline-width(v.value))
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl("outline-color", x)]
  }
  some(v) => match theme-color(c, v, t, ["--outline-color", "--color"]) {
    some(x) => some([ast.decl("outline-color", x)])
    none if is-some(c.modifier) => none
    none => match th.resolve(t, some(v.value), ["--outline-width"]) {
      some(x) => some(outline-width(x))
      none if num.positive-integer?(v.value) => some(outline-width(v.value ++ "px"))
      none => none
    }
  }
}

# A line height from the modifier of `text-*/…`.
fn leading-of(m: cand.Named, t: th.Theme) -> Text? = match (if m.arbitrary then some(m.value) else th.resolve(t, some(m.value), ["--leading"])) {
  some(x) if x != "" => some(x)
  _ if num.quarter-multiple?(m.value) and spaced?(t) => some("--spacing(" ++ m.value ++ ")")
  _ if num.quarter-multiple?(m.value) => none
  _ if m.value == "none" => some("1")
  _ => none
}

fn text(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length", "percentage", "absolute-size", "relative-size"]) {
    some("size") | some("length") | some("percentage") | some("absolute-size") | some("relative-size") => match c.modifier {
      some(m) => first lh in leading-of(m, t): [ast.decl("font-size", v.value), ast.decl("line-height", lh)]
      none => some([ast.decl("font-size", v.value)])
    }
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl("color", x)]
  }
  some(v) => match theme-color(c, v, t, ["--text-color", "--color"]) {
    some(x) => some([ast.decl("color", x)])
    none => first w in th.resolve-nested(t, v.value, ["--text"], ["--line-height", "--letter-spacing", "--font-weight"])
      for out in text-size(c, w, t): out
  }
}

fn text-size(c: cand.Candidate, w: th.With, t: th.Theme) -> [ast.Css]? = match c.modifier {
  some(m) => first lh in leading-of(m, t): [ast.decl("font-size", w.value), ast.decl("line-height", lh)]
  none => some([ast.decl("font-size", w.value),
                ast.decl-opt("line-height", first x in w.nested["--line-height"]: "var(--tw-leading, " ++ x ++ ")"),
                ast.decl-opt("letter-spacing", first x in w.nested["--letter-spacing"]: "var(--tw-tracking, " ++ x ++ ")"),
                ast.decl-opt("font-weight", first x in w.nested["--font-weight"]: "var(--tw-font-weight, " ++ x ++ ")")])
}

# `shadow`, `inset-shadow` and `text-shadow`: a shadow from the theme or arbitrary, its colors made to
# read the utility's color variable; or a color for that variable.
fn shadowed(c: cand.Candidate, t: th.Theme, kind: Text) -> [ast.Css]? = match c.value {
  none => first value in th.raw(t, ["--" ++ kind]) if not (is-some(c.modifier) and is-none(alpha)) for out in [shadow-made(kind, value, alpha, false)]: out
  some(v) if v.arbitrary => match arbitrary-type(v, ["color"]) {
    some("color") => first x in as-color(v.value, c.modifier, t): shadow-colored(kind, x)
    _ if is-some(c.modifier) and is-none(alpha) => none
    _ => some(shadow-made(kind, v.value, alpha, kind == "inset-shadow"))
  }
  some(v) if v.value == "none" => if is-some(c.modifier) then none else some(shadow-none(kind))
  some(v) if v.value == "inherit" => if is-some(c.modifier) then none else some([at-props(shadow-group(kind)), ast.decl(shadow-var(kind) ++ "-color", "inherit")])
  some(v) => match th.raw(t, ["--" ++ kind ++ "-" ++ v.value]) {
    some(value) => if is-some(c.modifier) and is-none(alpha) then none else some(shadow-made(kind, value, alpha, false))
    none => first x in theme-color(c, v, t, [if kind == "text-shadow" then "--text-shadow-color" else "--box-shadow-color", "--color"]):
      shadow-colored(kind, x)
  }
} where alpha = modifier-alpha(c)

fn shadow-group(kind: Text) -> Text = if kind == "text-shadow" then "text-shadow" else "box-shadow"
fn shadow-var(kind: Text) -> Text = "--tw-" ++ kind
fn shadow-property(kind: Text) -> Text = if kind == "text-shadow" then "text-shadow" else shadow-var(kind)

fn shadow-colored(kind: Text, x: Text) -> [ast.Css] =
  [at-props(shadow-group(kind)), ast.decl(shadow-var(kind) ++ "-color", with-alpha(x, "var(" ++ shadow-var(kind) ++ "-alpha)"))]

fn shadow-none(kind: Text) -> [ast.Css] = match kind {
  "text-shadow" => [at-props("text-shadow"), ast.decl("text-shadow", "none")]
  "shadow" => [at-props("box-shadow"), ast.decl("--tw-shadow", null-shadow), ast.decl("box-shadow", box-shadow-value)]
  _ => [at-props("box-shadow"), ast.decl("--tw-inset-shadow", "inset " ++ null-shadow), ast.decl("box-shadow", box-shadow-value)]
}

fn shadow-made(kind: Text, value: Text, alpha: Text?, inset: Bool) -> [ast.Css] =
  [at-props(shadow-group(kind)), ast.decl-opt(shadow-var(kind) ++ "-alpha", alpha)]
  ++ alpha-replaced(shadow-property(kind), value, alpha, shadow-var(kind) ++ "-color", if inset then "inset" else "")
  ++ (if kind == "text-shadow" then [] else [ast.decl("box-shadow", box-shadow-value)])

# Tailwind's `alphaReplacedShadowProperties`: the shadow's colors read the color variable, with the
# alpha applied; a variable color or alpha needs relative color syntax, with a fallback before it.
fn alpha-replaced(property: Text, value: Text, alpha: Text?, color-var: Text, prefix: Text) -> [ast.Css] = match needs-fallback(value, alpha) {
  true => [ast.decl(property, prefixed(prefix, replaced-shadow(value, injected(color-var, none)))),
           ast.rule("@supports (color: lab(from red l a b))", [ast.decl(property, prefixed(prefix, replaced-shadow(value, injected(color-var, alpha))))])]
  false => [ast.decl(property, prefixed(prefix, replaced-shadow(value, injected(color-var, alpha))))]
}

# Whether replacing a shadow's colors with an alpha needs relative color syntax: some color that is
# not `currentcolor` is a variable, or the alpha is.
fn needs-fallback(value: Text, alpha: Text?) -> Bool = match alpha {
  some(a) => any c in shadow-colors(value): not starts-with(c, "current") and (starts-with(c, "var(") or starts-with(a, "var("))
  none => false
}

record Injection { color-var: Text, alpha: Text? }

fn injected(color-var: Text, alpha: Text?) -> Injection = Injection(color-var: color-var, alpha: alpha)

fn injection-of(i: Injection, color: Text) -> Text = "var(" ++ i.color-var ++ ", " ++ (match i.alpha {
  none => color
  some(a) if starts-with(color, "current") => with-alpha(color, a)
  some(a) => replace-alpha(color, a)
}) ++ ")"

fn prefixed(prefix: Text, x: Text) -> Text = match prefix {
  "" => x
  _ => join([tx.js-trim(prefix) ++ " " ++ tx.js-trim(part) for part in tx.segment(x, ',')], ", ")
}

# Tailwind's `replaceShadowColors`, each shadow's color the replacement's.
fn replaced-shadow(input: Text, i: Injection) -> Text = join([replaced-one(tx.js-trim(s), i) for s in tx.segment(input, ',')], ", ")

# The colors the shadows of a value have, as `replaceShadowColors` would find them.
fn shadow-colors(input: Text) -> [Text] = [c for s in tx.segment(input, ',') for c in shadow-color(tx.js-trim(s))]

record Scan { color-at: Int, lengths: Int, unknowns: Int, unknown-at: Int }

fn scanned(nodes: [vp.Value]) -> Scan = fold sc = Scan(color-at: -1, lengths: 0, unknowns: 0, unknown-at: -1)
  for i in 0..len(nodes) while sc.color-at == -1: scan-step(sc, nodes[i], i)

fn scan-step(sc: Scan, n: vp.Value, i: Int) -> Scan = match n.kind {
  vp.Separator => sc
  vp.Word if ascii-lower(n.value) in ["inset", "inherit", "initial", "revert", "unset"] => sc
  vp.Word if length-word?(ascii-lower(n.value)) => sc with { lengths: sc.lengths + 1 }
  vp.Word if (n.value != "" and n.value[0] == '#') or ty.named-color?(n.value) => sc with { color-at: i }
  vp.Word => sc with { unknowns: sc.unknowns + 1, unknown-at: i }
  vp.Function if ascii-lower(n.value) in shadow-color-functions => sc with { color-at: i }
  vp.Function if ascii-lower(n.value) in ["calc", "clamp", "max", "min", "--spacing"] => sc with { lengths: sc.lengths + 1 }
  vp.Function => sc with { unknowns: sc.unknowns + 1, unknown-at: i }
}

const shadow-color-functions: [Text] = ["color", "color-mix", "contrast-color", "device-cmyk", "hsl", "hsla", "hwb", "lab", "lch",
  "light-dark", "oklab", "oklch", "rgb", "rgba", "--alpha"]

# `^-?(\d+|\.\d+)`.
fn length-word?(w: Text) -> Bool = match (if starts-with(w, "-") then w[1..len(w)] else w) {
  "." ++ rest => rest != "" and digit-byte?(rest[0])
  rest => rest != "" and digit-byte?(rest[0])
}

fn shadow-color(shadow: Text) -> [Text] = match scanned(nodes) {
  sc if sc.color-at != -1 => [vp.css([nodes[sc.color-at]])]
  sc if sc.lengths < 2 => []
  sc if sc.unknowns == 0 => ["currentcolor"]
  sc if sc.unknowns == 1 => [vp.css([nodes[sc.unknown-at]])]
  _ => []
} where nodes = vp.parse(shadow)

fn replaced-one(shadow: Text, i: Injection) -> Text = match scanned(nodes) {
  sc if sc.color-at != -1 => vp.css(replaced-at(nodes, sc.color-at, i))
  sc if sc.lengths < 2 => shadow
  sc if sc.unknowns == 0 => shadow ++ " " ++ injection-of(i, "currentcolor")
  sc if sc.unknowns == 1 => vp.css(replaced-at(nodes, sc.unknown-at, i))
  _ => shadow
} where nodes = vp.parse(shadow)

fn replaced-at(nodes: [vp.Value], at: Int, i: Injection) -> [vp.Value] =
  nodes[0..at] ++ vp.parse(injection-of(i, vp.css([nodes[at]]))) ++ nodes[at + 1..len(nodes)]

fn drop-shadow(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => first value in th.raw(t, ["--drop-shadow"]) for resolved in th.resolve(t, none, ["--drop-shadow"])
    if not (is-some(c.modifier) and is-none(alpha)) for out in [drop-made(value, alpha, some(resolved))]: out
  some(v) if v.arbitrary => match arbitrary-type(v, ["color"]) {
    some("color") => first x in as-color(v.value, c.modifier, t):
      [at-props("filter"), ast.decl("--tw-drop-shadow-color", with-alpha(x, "var(--tw-drop-shadow-alpha)")), ast.decl("--tw-drop-shadow", "var(--tw-drop-shadow-size)")]
    _ if is-some(c.modifier) and is-none(alpha) => none
    _ => some(drop-made(v.value, alpha, none))
  }
  some(v) => match th.raw(t, ["--drop-shadow-" ++ v.value]) {
    some(value) if is-some(th.resolve(t, some(v.value), ["--drop-shadow"])) =>
      if is-some(c.modifier) and is-none(alpha) then none
      else some(drop-made(value, alpha, if is-some(alpha) then none else th.resolve(t, some(v.value), ["--drop-shadow"])))
    _ => match theme-color(c, v, t, ["--drop-shadow-color", "--color"]) {
      some("inherit") => some([at-props("filter"), ast.decl("--tw-drop-shadow-color", "inherit"), ast.decl("--tw-drop-shadow", "var(--tw-drop-shadow-size)")])
      some(x) => some([at-props("filter"), ast.decl("--tw-drop-shadow-color", with-alpha(x, "var(--tw-drop-shadow-alpha)")),
                       ast.decl("--tw-drop-shadow", "var(--tw-drop-shadow-size)")])
      none => none
    }
  }
} where alpha = modifier-alpha(c)

# A drop shadow: `resolved`, the theme's value, is the shadow itself when there is no alpha.
fn drop-made(value: Text, alpha: Text?, resolved: Text?) -> [ast.Css] =
  [at-props("filter"), ast.decl-opt("--tw-drop-shadow-alpha", alpha)]
  ++ drop-replaced(value, alpha)
  ++ [ast.decl("--tw-drop-shadow", match resolved {
        some(r) => join(["drop-shadow(" ++ x ++ ")" for x in tx.segment(r, ',')], " ")
        none => "var(--tw-drop-shadow-size)"
      }), ast.decl("filter", filter-value)]

# Tailwind's `alphaReplacedDropShadowProperties`.
fn drop-replaced(value: Text, alpha: Text?) -> [ast.Css] = match needs-fallback(value, alpha) {
  true => [ast.decl("--tw-drop-shadow-size", drops(value, injected("--tw-drop-shadow-color", none))),
           ast.rule("@supports (color: lab(from red l a b))", [ast.decl("--tw-drop-shadow-size", drops(value, injected("--tw-drop-shadow-color", alpha)))])]
  false => [ast.decl("--tw-drop-shadow-size", drops(value, injected("--tw-drop-shadow-color", alpha)))]
}

fn drops(value: Text, i: Injection) -> Text = join(["drop-shadow(" ++ replaced-shadow(part, i) ++ ")" for part in tx.segment(value, ',')], " ")

fn ring-shadow(value: Text, t: th.Theme) -> Text =
  "var(--tw-ring-inset, ) 0 0 0 calc(" ++ value ++ " + var(--tw-ring-offset-width)) var(--tw-ring-color, " ++ (th.raw(t, ["--default-ring-color"]) ?? "currentcolor") ++ ")"

fn inset-ring-shadow(value: Text) -> Text = "inset 0 0 0 " ++ value ++ " var(--tw-inset-ring-color, currentcolor)"

fn ring-made(value: Text, t: th.Theme, inset: Bool) -> [ast.Css] =
  [at-props("box-shadow"), if inset then ast.decl("--tw-inset-ring-shadow", inset-ring-shadow(value)) else ast.decl("--tw-ring-shadow", ring-shadow(value, t)),
   ast.decl("box-shadow", box-shadow-value)]

fn ring(c: cand.Candidate, t: th.Theme, inset: Bool) -> [ast.Css]? = match c.value {
  none if is-some(c.modifier) => none
  none => some(ring-made(if inset then "1px" else th.raw(t, ["--default-ring-width"]) ?? "1px", t, inset))
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length"]) {
    some("length") => if is-some(c.modifier) then none else some(ring-made(v.value, t, inset))
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl(ring-color(inset), x)]
  }
  some(v) => match theme-color(c, v, t, ["--ring-color", "--color"]) {
    some(x) => some([ast.decl(ring-color(inset), x)])
    none if is-some(c.modifier) => none
    none => first w in th.resolve(t, some(v.value), ["--ring-width"]) ?? integer-with(v.value, "px"):
      ring-made(w, t, inset)
  }
}

fn ring-color(inset: Bool) -> Text = if inset then "--tw-inset-ring-color" else "--tw-ring-color"

const ring-offset-shadow: Text = "var(--tw-ring-inset, ) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color)"

fn ring-offset(c: cand.Candidate, t: th.Theme) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => match arbitrary-type(v, ["color", "length"]) {
    some("length") => if is-some(c.modifier) then none else some(decls([["--tw-ring-offset-width", v.value], ["--tw-ring-offset-shadow", ring-offset-shadow]]))
    _ => first x in as-color(v.value, c.modifier, t): [ast.decl("--tw-ring-offset-color", x)]
  }
  some(v) => match th.resolve(t, some(v.value), ["--ring-offset-width"]) {
    some(w) => if is-some(c.modifier) then none else some(decls([["--tw-ring-offset-width", w], ["--tw-ring-offset-shadow", ring-offset-shadow]]))
    none if num.positive-integer?(v.value) => if is-some(c.modifier) then none
      else some(decls([["--tw-ring-offset-width", v.value ++ "px"], ["--tw-ring-offset-shadow", ring-offset-shadow]]))
    none => first x in theme-color(c, v, t, ["--ring-offset-color", "--color"]): [ast.decl("--tw-ring-offset-color", x)]
  }
}

fn container-type(value: Text, c: cand.Candidate) -> [ast.Css]? = match c.modifier {
  some(m) => some([ast.decl("container-type", value), ast.decl("container-name", m.value)])
  none => some([ast.decl("container-type", value)])
}

# `start-*` and `end-*`, the legacy inline insets.
fn legacy-inset(c: cand.Candidate, t: th.Theme, property: Text, negative: Bool) -> [ast.Css]? = match c.value {
  none => none
  some(v) if v.arbitrary => if is-some(c.modifier) then none else some([ast.decl(property, if negative then "calc(" ++ v.value ++ " * -1)" else v.value)])
  some(v) => match th.resolve(t, some(v.fraction ?? v.value), ["--inset", "--spacing"]) {
    some(x) => some([ast.decl(property, if negative then "calc(" ++ x ++ " * -1)" else x)])
    none => match v.fraction {
      some(f) => match tx.segment(f, '/') {
        [l, r] if num.positive-integer?(l) and num.positive-integer?(r) =>
          some([ast.decl(property, if negative then "calc(calc(" ++ f ++ " * 100%) * -1)" else "calc(" ++ f ++ " * 100%)")])
        _ => none
      }
      none => first m in th.resolve(t, none, ["--spacing"]) if num.quarter-multiple?(v.value):
        [ast.decl(property, if negative then "calc(" ++ m ++ " * -" ++ v.value ++ ")" else "calc(" ++ m ++ " * " ++ v.value ++ ")")]
    }
  }
}

# A positive integer with a unit after it.
fn integer-with(v: Text, unit: Text) -> Text? = if num.positive-integer?(v) then some(v ++ unit) else none
