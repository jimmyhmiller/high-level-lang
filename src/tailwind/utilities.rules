# Tailwind's utilities (tailwindcss/src/utilities.ts and compat/legacy-utilities.ts, v4.3.5), as a
# table in Tailwind's order. Most utilities are data: a static one is its declarations; a
# functional one names the theme keys its value is looked up in, what a bare value may be (`p-4`
# is `--spacing(4)`), fixed values (`z-auto`), and the declarations the value goes into (`$` in a
# template); a color utility the same for colors with an opacity modifier. The rest (`bg`, `text`,
# `shadow`, `border`, …) choose between several properties by what the value is, and are each an
# arm of `own`. A candidate's root may have several utilities: each is asked in order.
rules tailwind.utilities
use tailwind.ast as ast
use tailwind.candidate as cand
use tailwind.theme as th
use tailwind.text as tx
use tailwind.values as vp
use tailwind.numbers as num
use tailwind.types as ty

# ---------------------------------------------------------------- templates

enum Part { Declare, Props, Nest, Ref }

# A node of a utility's output with `$` where its value goes: a declaration, the `@property` rules
# of a group (hoisted to the root), or a rule around more of them.
boxed record T { part: Part, a: Text, b: Text, inner: [T] }

fn d(property: Text, value: Text) -> T = T(part: Declare, a: property, b: value, inner: [])
fn props(group: Text) -> T = T(part: Props, a: group, b: "", inner: [])
fn nest(selector: Text, inner: [T]) -> T = T(part: Nest, a: selector, b: "", inner: inner)
# A declaration whose value the theme decides: `ease` and `duration`, the transitions' defaults.
fn themed(property: Text, which: Text) -> T = T(part: Ref, a: property, b: which, inner: [])

fn filled(ts: [T], value: Text, t: th.Theme) -> [ast.Css] = [filled-one(x, value, t) for x in ts]

fn filled-one(x: T, value: Text, t: th.Theme) -> ast.Css = match x.part {
  Declare => ast.decl(x.a, replace-all(x.b, "$", value))
  Props => ast.at-root(property-group(x.a))
  Nest => ast.rule(x.a, filled(x.inner, value, t))
  Ref => ast.decl(x.a, referred(x.b, t))
}

fn referred(which: Text, t: th.Theme) -> Text = match which {
  "ease" => "var(--tw-ease, " ++ (th.resolve(t, none, ["--default-transition-timing-function"]) ?? "ease") ++ ")"
  "duration" => "var(--tw-duration, " ++ (th.resolve(t, none, ["--default-transition-duration"]) ?? "0s") ++ ")"
  _ => panic "tailwind: no theme reference {}", which
}

# Tailwind's `property(ident, initialValue, syntax)`: an `@property` rule.
record P { name: Text, initial: Text, syntax: Text }

fn p(name: Text) -> P = P(name: name, initial: "", syntax: "")
fn pi(name: Text, initial: Text) -> P = P(name: name, initial: initial, syntax: "")
fn ps(name: Text, initial: Text, syntax: Text) -> P = P(name: name, initial: initial, syntax: syntax)

fn property-node(x: P) -> ast.Css = ast.at-rule("@property", x.name,
  [ast.decl("syntax", if x.syntax == "" then "\"*\"" else "\"" ++ x.syntax ++ "\""), ast.decl("inherits", "false")]
  ++ (if x.initial == "" then [] else [ast.decl("initial-value", x.initial)]))

fn property-group(g: Text) -> [ast.Css] = [property-node(x) for x in group-members(g)]

const null-shadow: Text = "0 0 #0000"

fn group-members(g: Text) -> [P] = match g {
  "border-spacing" => [ps("--tw-border-spacing-x", "0", "<length>"), ps("--tw-border-spacing-y", "0", "<length>")]
  "translate" => [pi("--tw-translate-x", "0"), pi("--tw-translate-y", "0"), pi("--tw-translate-z", "0")]
  "scale" => [pi("--tw-scale-x", "1"), pi("--tw-scale-y", "1"), pi("--tw-scale-z", "1")]
  "transform" => [p("--tw-rotate-x"), p("--tw-rotate-y"), p("--tw-rotate-z"), p("--tw-skew-x"), p("--tw-skew-y")]
  "touch" => [p("--tw-pan-x"), p("--tw-pan-y"), p("--tw-pinch-zoom")]
  "snap" => [ps("--tw-scroll-snap-strictness", "proximity", "*")]
  "space-x" => [pi("--tw-space-x-reverse", "0")]
  "space-y" => [pi("--tw-space-y-reverse", "0")]
  "scrollbar-color" => [ps("--tw-scrollbar-thumb", "#0000", "<color>"), ps("--tw-scrollbar-track", "#0000", "<color>")]
  "border" => [pi("--tw-border-style", "solid")]
  "divide-x" => [pi("--tw-divide-x-reverse", "0")]
  "divide-y" => [pi("--tw-divide-y-reverse", "0")]
  "gradient" => [p("--tw-gradient-position"), ps("--tw-gradient-from", "#0000", "<color>"), ps("--tw-gradient-via", "#0000", "<color>"),
                 ps("--tw-gradient-to", "#0000", "<color>"), p("--tw-gradient-stops"), p("--tw-gradient-via-stops"),
                 ps("--tw-gradient-from-position", "0%", "<length-percentage>"), ps("--tw-gradient-via-position", "50%", "<length-percentage>"),
                 ps("--tw-gradient-to-position", "100%", "<length-percentage>")]
  "mask-gradient" => [pi("--tw-mask-linear", "linear-gradient(#fff, #fff)"), pi("--tw-mask-radial", "linear-gradient(#fff, #fff)"),
                      pi("--tw-mask-conic", "linear-gradient(#fff, #fff)")]
  "mask-edge" => [pi("--tw-mask-left", "linear-gradient(#fff, #fff)"), pi("--tw-mask-right", "linear-gradient(#fff, #fff)"),
                  pi("--tw-mask-bottom", "linear-gradient(#fff, #fff)"), pi("--tw-mask-top", "linear-gradient(#fff, #fff)")]
  "mask-top" | "mask-right" | "mask-bottom" | "mask-left" => [pi(e ++ "-from-position", "0%"), pi(e ++ "-to-position", "100%"),
                  pi(e ++ "-from-color", "black"), pi(e ++ "-to-color", "transparent")] where e = "--tw-" ++ g
  "mask-linear" => [pi("--tw-mask-linear-position", "0deg"), pi("--tw-mask-linear-from-position", "0%"), pi("--tw-mask-linear-to-position", "100%"),
                    pi("--tw-mask-linear-from-color", "black"), pi("--tw-mask-linear-to-color", "transparent")]
  "mask-radial" => [pi("--tw-mask-radial-from-position", "0%"), pi("--tw-mask-radial-to-position", "100%"), pi("--tw-mask-radial-from-color", "black"),
                    pi("--tw-mask-radial-to-color", "transparent"), pi("--tw-mask-radial-shape", "ellipse"),
                    pi("--tw-mask-radial-size", "farthest-corner"), pi("--tw-mask-radial-position", "center")]
  "mask-conic" => [pi("--tw-mask-conic-position", "0deg"), pi("--tw-mask-conic-from-position", "0%"), pi("--tw-mask-conic-to-position", "100%"),
                   pi("--tw-mask-conic-from-color", "black"), pi("--tw-mask-conic-to-color", "transparent")]
  "font-weight" => [p("--tw-font-weight")]
  "filter" => [p("--tw-blur"), p("--tw-brightness"), p("--tw-contrast"), p("--tw-grayscale"), p("--tw-hue-rotate"), p("--tw-invert"),
               p("--tw-opacity"), p("--tw-saturate"), p("--tw-sepia"), p("--tw-drop-shadow"), p("--tw-drop-shadow-color"),
               ps("--tw-drop-shadow-alpha", "100%", "<percentage>"), p("--tw-drop-shadow-size")]
  "backdrop" => [p("--tw-backdrop-blur"), p("--tw-backdrop-brightness"), p("--tw-backdrop-contrast"), p("--tw-backdrop-grayscale"),
                 p("--tw-backdrop-hue-rotate"), p("--tw-backdrop-invert"), p("--tw-backdrop-opacity"), p("--tw-backdrop-saturate"),
                 p("--tw-backdrop-sepia")]
  "duration" => [p("--tw-duration")]
  "ease" => [p("--tw-ease")]
  "content" => [pi("--tw-content", "\"\"")]
  "contain" => [p("--tw-contain-size"), p("--tw-contain-layout"), p("--tw-contain-paint"), p("--tw-contain-style")]
  "leading" => [p("--tw-leading")]
  "tracking" => [p("--tw-tracking")]
  "numeric" => [p("--tw-ordinal"), p("--tw-slashed-zero"), p("--tw-numeric-figure"), p("--tw-numeric-spacing"), p("--tw-numeric-fraction")]
  "outline" => [pi("--tw-outline-style", "solid")]
  "text-shadow" => [p("--tw-text-shadow-color"), ps("--tw-text-shadow-alpha", "100%", "<percentage>")]
  "box-shadow" => [pi("--tw-shadow", null-shadow), p("--tw-shadow-color"), ps("--tw-shadow-alpha", "100%", "<percentage>"),
                   pi("--tw-inset-shadow", null-shadow), p("--tw-inset-shadow-color"), ps("--tw-inset-shadow-alpha", "100%", "<percentage>"),
                   p("--tw-ring-color"), pi("--tw-ring-shadow", null-shadow), p("--tw-inset-ring-color"), pi("--tw-inset-ring-shadow", null-shadow),
                   p("--tw-ring-inset"), ps("--tw-ring-offset-width", "0px", "<length>"), pi("--tw-ring-offset-color", "#fff"),
                   pi("--tw-ring-offset-shadow", null-shadow)]
  _ => panic "tailwind: no @property group {}", g
}

# ---------------------------------------------------------------- utilities

enum How { Fixed, Value, Color, Own }

# A utility. Fixed: `out`, its `$` replaced by `fill`. Value (Tailwind's `functionalUtility`): its
# value looked up in `keys`, or made of a bare value by the rule `bare` names (`negative-bare` for
# the `-` form), or one of `values`; `negated` for the `-` form; a default when there is no value
# (`defaulted`: `default`, which may be none; otherwise the bare namespace's value). Color (Tailwind's
# `colorUtility`): a color from `keys` with an opacity modifier. Own: an arm of `own`.
record U {
  name: Text,
  static: Bool,
  how: How,
  out: [T],
  fill: Text,
  keys: [Text],
  negated: Bool,
  fractions: Bool,
  default: Text?,
  defaulted: Bool,
  bare: Text,
  negative-bare: Text,
  values: {Text:[T]},
  handler: Text,
  default-key: Text
}

fn fixed(name: Text, out: [T]) -> U = U(name: name, static: true, how: Fixed, out: out, fill: "", keys: [], negated: false,
  fractions: false, default: none, defaulted: false, bare: "", negative-bare: "", values: {}, handler: "", default-key: "")
fn value(name: Text, keys: [Text], out: [T]) -> U = U(name: name, static: false, how: Value, out: out, fill: "", keys: keys,
  negated: false, fractions: false, default: none, defaulted: false, bare: "", negative-bare: "", values: {}, handler: "", default-key: "")
fn color(name: Text, keys: [Text], out: [T]) -> U = U(name: name, static: false, how: Color, out: out, fill: "", keys: keys,
  negated: false, fractions: false, default: none, defaulted: false, bare: "", negative-bare: "", values: {}, handler: "", default-key: "")
fn own(name: Text) -> U = U(name: name, static: false, how: Own, out: [], fill: "", keys: [], negated: false, fractions: false,
  default: none, defaulted: false, bare: "", negative-bare: "", values: {}, handler: "", default-key: "")
fn own-static(name: Text) -> U = own(name) with { static: true }

# One declaration, static.
fn s1(name: Text, property: Text, v: Text) -> U = fixed(name, [d(property, v)])

# A functional utility and its `-` form, the `-` one first as Tailwind registers them.
fn signed(u: U) -> [U] = [u with { name: "-" ++ u.name, negated: true }, u]

fn maybe-signed(u: U, negative: Bool) -> [U] = if negative then signed(u) else [u]

# Tailwind's `spacingUtility`: `-name-px` and `name-px`, then the functional utility, a bare value a
# multiple of the spacing scale.
fn spacing(name: Text, keys: [Text], out: [T], negative: Bool, fractions: Bool) -> [U] =
  (if negative then [fixed("-" ++ name ++ "-px", out) with { fill: "-1px" }] else [])
  ++ [fixed(name ++ "-px", out) with { fill: "1px" }]
  ++ maybe-signed(value(name, keys, out) with { fractions: fractions, defaulted: true, default: none, bare: "spacing", negative-bare: "negative-spacing" }, negative)

fn integer-value(name: Text, keys: [Text], out: [T], bare: Text) -> U = value(name, keys, out) with { bare: bare }

const transform-value: Text = "var(--tw-rotate-x, ) var(--tw-rotate-y, ) var(--tw-rotate-z, ) var(--tw-skew-x, ) var(--tw-skew-y, )"
const filter-value: Text = "var(--tw-blur, ) var(--tw-brightness, ) var(--tw-contrast, ) var(--tw-grayscale, ) var(--tw-hue-rotate, ) var(--tw-invert, ) var(--tw-saturate, ) var(--tw-sepia, ) var(--tw-drop-shadow, )"
const backdrop-value: Text = "var(--tw-backdrop-blur, ) var(--tw-backdrop-brightness, ) var(--tw-backdrop-contrast, ) var(--tw-backdrop-grayscale, ) var(--tw-backdrop-hue-rotate, ) var(--tw-backdrop-invert, ) var(--tw-backdrop-opacity, ) var(--tw-backdrop-saturate, ) var(--tw-backdrop-sepia, )"
const box-shadow-value: Text = "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"
const contain-value: Text = "var(--tw-contain-size, ) var(--tw-contain-layout, ) var(--tw-contain-paint, ) var(--tw-contain-style, )"
const numeric-value: Text = "var(--tw-ordinal, ) var(--tw-slashed-zero, ) var(--tw-numeric-figure, ) var(--tw-numeric-spacing, ) var(--tw-numeric-fraction, )"
const touch-value: Text = "var(--tw-pan-x, ) var(--tw-pan-y, ) var(--tw-pinch-zoom, )"
const translate-xy: Text = "var(--tw-translate-x) var(--tw-translate-y)"
const children: Text = ":where(& > :not(:last-child))"

fn filter-out(name: Text, f: Text) -> [T] = [props("filter"), d("--tw-" ++ name, f ++ "($)"), d("filter", filter-value)]
fn backdrop-out(name: Text, f: Text) -> [T] =
  [props("backdrop"), d("--tw-backdrop-" ++ name, f ++ "($)"), d("-webkit-backdrop-filter", backdrop-value), d("backdrop-filter", backdrop-value)]

fn radius(root: Text, properties: [Text]) -> U = value(root, ["--radius"], [d(x, "$") for x in properties]) with {
  values: {"none": [d(x, "0") for x in properties], "full": [d(x, "calc(infinity * 1px)") for x in properties]} }

fn origin-values(property: Text) -> {Text:[T]} = {"center": [d(property, "center")], "top": [d(property, "top")],
  "top-right": [d(property, "100% 0")], "right": [d(property, "100%")], "bottom-right": [d(property, "100% 100%")],
  "bottom": [d(property, "bottom")], "bottom-left": [d(property, "0 100%")], "left": [d(property, "0")], "top-left": [d(property, "0 0")]}

fn mask-out(group: Text, last: [T]) -> [T] =
  [props("mask-gradient"), props(group), d("mask-image", "var(--tw-mask-linear), var(--tw-mask-radial), var(--tw-mask-conic)"),
   d("mask-composite", "intersect")] ++ last

fn transition-out(property: Text) -> [T] =
  [d("transition-property", property), themed("transition-timing-function", "ease"), themed("transition-duration", "duration")]

# Every utility, in the order Tailwind registers them.
fn registry() -> [U] = [
  fixed("sr-only", [d("position", "absolute"), d("width", "1px"), d("height", "1px"), d("padding", "0"), d("margin", "-1px"),
                    d("overflow", "hidden"), d("clip-path", "inset(50%)"), d("white-space", "nowrap"), d("border-width", "0")]),
  fixed("not-sr-only", [d("position", "static"), d("width", "auto"), d("height", "auto"), d("padding", "0"), d("margin", "0"),
                        d("overflow", "visible"), d("clip-path", "none"), d("white-space", "normal")]),
  s1("pointer-events-none", "pointer-events", "none"), s1("pointer-events-auto", "pointer-events", "auto"),
  s1("visible", "visibility", "visible"), s1("invisible", "visibility", "hidden"), s1("collapse", "visibility", "collapse"),
  s1("static", "position", "static"), s1("fixed", "position", "fixed"), s1("absolute", "position", "absolute"),
  s1("relative", "position", "relative"), s1("sticky", "position", "sticky")]
  ++ [u for x in [["inset", "inset"], ["inset-x", "inset-inline"], ["inset-y", "inset-block"], ["inset-s", "inset-inline-start"],
                  ["inset-e", "inset-inline-end"], ["inset-bs", "inset-block-start"], ["inset-be", "inset-block-end"], ["top", "top"],
                  ["right", "right"], ["bottom", "bottom"], ["left", "left"]]
      for u in [s1(x[0] ++ "-auto", x[1], "auto"), s1(x[0] ++ "-full", x[1], "100%"), s1("-" ++ x[0] ++ "-full", x[1], "-100%")]
               ++ spacing(x[0], ["--inset", "--spacing"], [d(x[1], "$")], true, true)]
  ++ [s1("isolate", "isolation", "isolate"), s1("isolation-auto", "isolation", "auto")]
  ++ signed(integer-value("z", ["--z-index"], [d("z-index", "$")], "integer") with { values: {"auto": [d("z-index", "auto")]} })
  ++ signed(integer-value("order", ["--order"], [d("order", "$")], "integer") with { values: {"first": [d("order", "-9999")], "last": [d("order", "9999")]} })
  ++ signed(integer-value("col", ["--grid-column"], [d("grid-column", "$")], "integer") with { values: {"auto": [d("grid-column", "auto")]} })
  ++ [integer-value("col-span", [], [d("grid-column", "span $ / span $")], "integer") with { values: {"full": [d("grid-column", "1 / -1")]} }]
  ++ signed(integer-value("col-start", ["--grid-column-start"], [d("grid-column-start", "$")], "integer") with { values: {"auto": [d("grid-column-start", "auto")]} })
  ++ signed(integer-value("col-end", ["--grid-column-end"], [d("grid-column-end", "$")], "integer") with { values: {"auto": [d("grid-column-end", "auto")]} })
  ++ signed(integer-value("row", ["--grid-row"], [d("grid-row", "$")], "integer") with { values: {"auto": [d("grid-row", "auto")]} })
  ++ [integer-value("row-span", [], [d("grid-row", "span $ / span $")], "integer") with { values: {"full": [d("grid-row", "1 / -1")]} }]
  ++ signed(integer-value("row-start", ["--grid-row-start"], [d("grid-row-start", "$")], "integer") with { values: {"auto": [d("grid-row-start", "auto")]} })
  ++ signed(integer-value("row-end", ["--grid-row-end"], [d("grid-row-end", "$")], "integer") with { values: {"auto": [d("grid-row-end", "auto")]} })
  ++ [s1("float-start", "float", "inline-start"), s1("float-end", "float", "inline-end"), s1("float-right", "float", "right"),
      s1("float-left", "float", "left"), s1("float-none", "float", "none"), s1("clear-start", "clear", "inline-start"),
      s1("clear-end", "clear", "inline-end"), s1("clear-right", "clear", "right"), s1("clear-left", "clear", "left"),
      s1("clear-both", "clear", "both"), s1("clear-none", "clear", "none")]
  ++ [u for x in [["m", "margin"], ["mx", "margin-inline"], ["my", "margin-block"], ["ms", "margin-inline-start"], ["me", "margin-inline-end"],
                  ["mbs", "margin-block-start"], ["mbe", "margin-block-end"], ["mt", "margin-top"], ["mr", "margin-right"],
                  ["mb", "margin-bottom"], ["ml", "margin-left"]]
      for u in [s1(x[0] ++ "-auto", x[1], "auto")] ++ spacing(x[0], ["--margin", "--spacing"], [d(x[1], "$")], true, false)]
  ++ [s1("box-border", "box-sizing", "border-box"), s1("box-content", "box-sizing", "content-box"),
      integer-value("line-clamp", ["--line-clamp"], [d("overflow", "hidden"), d("display", "-webkit-box"), d("-webkit-box-orient", "vertical"),
                                                       d("-webkit-line-clamp", "$")], "integer")
        with { values: {"none": [d("overflow", "visible"), d("display", "block"), d("-webkit-box-orient", "horizontal"), d("-webkit-line-clamp", "unset")]} }]
  ++ [s1(x[0], "display", x[1]) for x in [["block", "block"], ["inline-block", "inline-block"], ["inline", "inline"], ["hidden", "none"],
      ["inline-flex", "inline-flex"], ["table", "table"], ["inline-table", "inline-table"], ["table-caption", "table-caption"],
      ["table-cell", "table-cell"], ["table-column", "table-column"], ["table-column-group", "table-column-group"],
      ["table-footer-group", "table-footer-group"], ["table-header-group", "table-header-group"], ["table-row-group", "table-row-group"],
      ["table-row", "table-row"], ["flow-root", "flow-root"], ["flex", "flex"], ["grid", "grid"], ["inline-grid", "inline-grid"],
      ["contents", "contents"], ["list-item", "list-item"]]]
  ++ [s1("field-sizing-content", "field-sizing", "content"), s1("field-sizing-fixed", "field-sizing", "fixed"),
      value("aspect", ["--aspect"], [d("aspect-ratio", "$")]) with { bare: "aspect", values: {"auto": [d("aspect-ratio", "auto")], "square": [d("aspect-ratio", "1 / 1")]} }]
  ++ [u for x in [["full", "100%"], ["svw", "100svw"], ["lvw", "100lvw"], ["dvw", "100dvw"], ["svh", "100svh"], ["lvh", "100lvh"],
                  ["dvh", "100dvh"], ["min", "min-content"], ["max", "max-content"], ["fit", "fit-content"]]
      for u in [fixed("size-" ++ x[0], [d("--tw-sort", "size"), d("width", x[1]), d("height", x[1])]), s1("w-" ++ x[0], "width", x[1]),
                s1("h-" ++ x[0], "height", x[1]), s1("min-w-" ++ x[0], "min-width", x[1]), s1("min-h-" ++ x[0], "min-height", x[1]),
                s1("max-w-" ++ x[0], "max-width", x[1]), s1("max-h-" ++ x[0], "max-height", x[1])]]
  ++ [fixed("size-auto", [d("--tw-sort", "size"), d("width", "auto"), d("height", "auto")]), s1("w-auto", "width", "auto"),
      s1("h-auto", "height", "auto"), s1("min-w-auto", "min-width", "auto"), s1("min-h-auto", "min-height", "auto"),
      s1("h-lh", "height", "1lh"), s1("min-h-lh", "min-height", "1lh"), s1("max-h-lh", "max-height", "1lh"),
      s1("w-screen", "width", "100vw"), s1("min-w-screen", "min-width", "100vw"), s1("max-w-screen", "max-width", "100vw"),
      s1("h-screen", "height", "100vh"), s1("min-h-screen", "min-height", "100vh"), s1("max-h-screen", "max-height", "100vh"),
      s1("max-w-none", "max-width", "none"), s1("max-h-none", "max-height", "none")]
  ++ spacing("size", ["--size", "--spacing"], [d("--tw-sort", "size"), d("width", "$"), d("height", "$")], false, true)
  ++ [u for x in [["w", "width"], ["min-w", "min-width"], ["max-w", "max-width"]]
      for u in spacing(x[0], ["--" ++ x[1], "--spacing", "--container"], [d(x[1], "$")], false, true)]
  ++ spacing("h", ["--height", "--spacing"], [d("height", "$")], false, true)
  ++ spacing("min-h", ["--min-height", "--height", "--spacing"], [d("min-height", "$")], false, true)
  ++ spacing("max-h", ["--max-height", "--height", "--spacing"], [d("max-height", "$")], false, true)
  ++ [u for x in [["full", "100%"], ["min", "min-content"], ["max", "max-content"], ["fit", "fit-content"]]
      for u in [s1("inline-" ++ x[0], "inline-size", x[1]), s1("block-" ++ x[0], "block-size", x[1]),
                s1("min-inline-" ++ x[0], "min-inline-size", x[1]), s1("min-block-" ++ x[0], "min-block-size", x[1]),
                s1("max-inline-" ++ x[0], "max-inline-size", x[1]), s1("max-block-" ++ x[0], "max-block-size", x[1])]]
  ++ [u for x in [["svw", "100svw"], ["lvw", "100lvw"], ["dvw", "100dvw"]]
      for u in [s1("inline-" ++ x[0], "inline-size", x[1]), s1("min-inline-" ++ x[0], "min-inline-size", x[1]),
                s1("max-inline-" ++ x[0], "max-inline-size", x[1])]]
  ++ [u for x in [["svh", "100svh"], ["lvh", "100lvh"], ["dvh", "100dvh"]]
