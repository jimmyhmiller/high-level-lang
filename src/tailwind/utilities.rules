      s1("bg-top", "background-position", "top"), s1("bg-top-left", "background-position", "left top"),
      s1("bg-top-right", "background-position", "right top"), s1("bg-bottom", "background-position", "bottom"),
      s1("bg-bottom-left", "background-position", "left bottom"), s1("bg-bottom-right", "background-position", "right bottom"),
      s1("bg-left", "background-position", "left"), s1("bg-right", "background-position", "right"),
      s1("bg-center", "background-position", "center"),
      value("bg-position", [], [d("background-position", "$")]),
      s1("bg-repeat", "background-repeat", "repeat"), s1("bg-no-repeat", "background-repeat", "no-repeat"),
      s1("bg-repeat-x", "background-repeat", "repeat-x"), s1("bg-repeat-y", "background-repeat", "repeat-y"),
      s1("bg-repeat-round", "background-repeat", "round"), s1("bg-repeat-space", "background-repeat", "space"),
      s1("bg-none", "background-image", "none"),
      own("-bg-linear"), own("bg-linear"), own("-bg-conic"), own("bg-conic"), own("bg-radial"), own("bg"),
      own("from"), s1("via-none", "--tw-gradient-via-stops", "initial"), own("via"), own("to"),
      s1("mask-none", "mask-image", "none"), own("mask"),
      s1("mask-add", "mask-composite", "add"), s1("mask-subtract", "mask-composite", "subtract"),
      s1("mask-intersect", "mask-composite", "intersect"), s1("mask-exclude", "mask-composite", "exclude"),
      s1("mask-alpha", "mask-mode", "alpha"), s1("mask-luminance", "mask-mode", "luminance"), s1("mask-match", "mask-mode", "match-source"),
      s1("mask-type-alpha", "mask-type", "alpha"), s1("mask-type-luminance", "mask-type", "luminance"),
      s1("mask-auto", "mask-size", "auto"), s1("mask-cover", "mask-size", "cover"), s1("mask-contain", "mask-size", "contain"),
      value("mask-size", [], [d("mask-size", "$")]),
      s1("mask-top", "mask-position", "top"), s1("mask-top-left", "mask-position", "left top"),
      s1("mask-top-right", "mask-position", "right top"), s1("mask-bottom", "mask-position", "bottom"),
      s1("mask-bottom-left", "mask-position", "left bottom"), s1("mask-bottom-right", "mask-position", "right bottom"),
      s1("mask-left", "mask-position", "left"), s1("mask-right", "mask-position", "right"), s1("mask-center", "mask-position", "center"),
      value("mask-position", [], [d("mask-position", "$")]),
      s1("mask-repeat", "mask-repeat", "repeat"), s1("mask-no-repeat", "mask-repeat", "no-repeat"),
      s1("mask-repeat-x", "mask-repeat", "repeat-x"), s1("mask-repeat-y", "mask-repeat", "repeat-y"),
      s1("mask-repeat-round", "mask-repeat", "round"), s1("mask-repeat-space", "mask-repeat", "space"),
      s1("mask-clip-border", "mask-clip", "border-box"), s1("mask-clip-padding", "mask-clip", "padding-box"),
      s1("mask-clip-content", "mask-clip", "content-box"), s1("mask-clip-fill", "mask-clip", "fill-box"),
      s1("mask-clip-stroke", "mask-clip", "stroke-box"), s1("mask-clip-view", "mask-clip", "view-box"),
      s1("mask-no-clip", "mask-clip", "no-clip"),
      s1("mask-origin-border", "mask-origin", "border-box"), s1("mask-origin-padding", "mask-origin", "padding-box"),
      s1("mask-origin-content", "mask-origin", "content-box"), s1("mask-origin-fill", "mask-origin", "fill-box"),
      s1("mask-origin-stroke", "mask-origin", "stroke-box"), s1("mask-origin-view", "mask-origin", "view-box")]
  ++ [own("mask-" ++ e ++ "-" ++ stop) for e in ["x", "y", "t", "r", "b", "l"] for stop in ["from", "to"]]
  ++ signed(value("mask-linear", [], mask-out("mask-linear", [d("--tw-mask-linear", "linear-gradient(var(--tw-mask-linear-stops, var(--tw-mask-linear-position)))"),
        d("--tw-mask-linear-position", "$")])) with { defaulted: true, default: none, bare: "mask-angle", negative-bare: "negative-mask-angle" })
  ++ [own("mask-linear-from"), own("mask-linear-to")]
