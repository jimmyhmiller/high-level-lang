        "right": [d("object-position", "right")], "center": [d("object-position", "center")]} }]
  ++ [u for x in [["p", "padding"], ["px", "padding-inline"], ["py", "padding-block"], ["ps", "padding-inline-start"],
                  ["pe", "padding-inline-end"], ["pbs", "padding-block-start"], ["pbe", "padding-block-end"], ["pt", "padding-top"],
