# Numbers as Tailwind's TypeScript reads them: `Number(text)` and `String(number)`, JavaScript's,
# which the runtime computes with doubles (`js-number-text`, `js-number-scaled`, `js-parse-float`).
# What Tailwind asks of a named value (a positive integer, a multiple of 0.25) is whether the text
# is what JavaScript would print for its number, and what that number is.
rules tailwind.numbers

# Tailwind's `isPositiveInteger`: a whole number 0 or more, written as JavaScript writes it.
fn positive-integer?(v: Text) -> Bool = v != "" and span-of(v, 0, "0123456789") == len(v) and js-number-text(v) == v

fn strict-positive-integer?(v: Text) -> Bool = positive-integer?(v) and v != "0"

# Tailwind's `isMultipleOf(value, 0.25)` (`isValidSpacingMultiplier`, `isValidOpacityValue`): not
# negative, a multiple of a quarter, written as JavaScript writes it.
fn quarter-multiple?(v: Text) -> Bool = match js-number-text(v) {
  t if t != v => false
  "-" ++ _ | "NaN" => false
  t if contains-text?(t, "e-") => false
  t if contains-text?(t, "e") => true
  _ ++ "." ++ fraction => fraction == "25" or fraction == "5" or fraction == "75"
  _ => true
}

# `Number(v)` is a number, and not NaN.
fn number?(v: Text) -> Bool = js-number-text(v) != "NaN"

# Whether `Number(v)` is zero, and whether it is one.
fn zero?(v: Text) -> Bool = js-number-text(v) == "0"
fn one?(v: Text) -> Bool = js-number-text(v) == "1"

# `${Number(v) * 100}%` where v is a number, as Tailwind's `withAlpha` writes an alpha.
fn percent-of(v: Text) -> Text = js-number-scaled(v, 100) ++ "%"

# Tailwind's `dimensions`: a number (`-1.5`, `.5`) and its unit (letters or `%`), when that is all
# the text is.
record Dimension { number: Text, unit: Text }

fn dimension(input: Text) -> Dimension? = match span-of(input, sign, "0123456789.") {
  0 => none
  n => match input[sign + n..len(input)] {
    unit if unit == "%" or (unit != "" and span-of(ascii-lower(unit), 0, "abcdefghijklmnopqrstuvwxyz") == len(unit)) or unit == "" =>
      first ok in [number-shape?(input[sign..sign + n])] if ok: Dimension(number: input[0..sign + n], unit: unit)
    _ => none
  }
} where sign = if input != "" and (input[0] == '-' or input[0] == '+') then 1 else 0

# `(\d*\.)?\d+`: digits, or digits with one dot before at least one more.
fn number-shape?(n: Text) -> Bool = match split(n, ".") {
  [whole] => whole != ""
  [_, fraction] => fraction != ""
  _ => false
}

# Tailwind's `compare`: text compared byte by byte, but runs of digits as the numbers they are.
fn compare(a: Text, z: Text) -> Int = compare-from(a, z, 0)

fn compare-from(a: Text, z: Text, i: Int) -> Int = match i {
  _ if i >= len(a) or i >= len(z) => len(a) - len(z)
  _ if digit-byte?(a[i]) and digit-byte?(z[i]) => match js-number-compare(a[i..a-end], z[i..z-end]) {
    0 if a[i..a-end] < z[i..z-end] => -1
    0 if a[i..a-end] > z[i..z-end] => 1
    0 => compare-from(a, z, a-end)
    d => d
  } where a-end = i + span-of(a, i, "0123456789"), z-end = i + span-of(z, i, "0123456789")
  _ if a[i] == z[i] => compare-from(a, z, i + 1)
  _ => a[i] - z[i]
}

# Tailwind's `compareBreakpoints`: by unit (or function name), then by the number, ascending or
# descending; by the text when the numbers are not numbers.
fn compare-breakpoints(a: Text, z: Text, ascending: Bool) -> Int = match a == z {
  true => 0
  false => match bucket-order {
    0 => match js-number-compare(js-parse-float(a), js-parse-float(z)) {
      2 => if a < z then -1 else 1
      d => if ascending then d else -d
    }
    o => o
  }
} where bucket-order = (if bucket(a) == bucket(z) then 0 else if bucket(a) < bucket(z) then -1 else 1)

fn bucket(v: Text) -> Text = match index-of(v, "(") {
  some(at) => v[0..at]
  none => join(split-digits(v), "")
}

# The text without its digits and dots (`replace(/[\d.]+/g, '')`).
fn split-digits(v: Text) -> [Text] = [byte-text(v[i]) for i in 0..len(v) if not (digit-byte?(v[i]) or v[i] == '.')]
