# ML scoping as an attribute grammar: each expression inherits the names in scope.
# A let's initializer sees the scope *outside* the let; its body sees the new name.
attrs mini.check over mini.lang
use mini.lang as syn

input functions: [Text]
inh env: [Text] = []
collect unbound: [Text]
collect calls: [Text]

on Def(name, params, body) { body.env = [p.text for p in params.names.kids] }
on Let(name, init, body) { body.env = [name.text] ++ env }
on Var(x) as v { if not (x in env) { unbound += x } }
on Call(callee, args) {
  calls += callee.text
  if not (callee.text in functions) { unbound += callee.text ++ "()" }
}
