# mini: a tiny ML-ish language, to test whether the grammar language is general.
syntax
start Prog
space Space
word NameChar
group "(" ")" Paren
precedence Expr Sum Atom ;
printwords "abcdefghijklmnopqrstuvwxyz0123456789_" ;
breaks ";" ;

fragment Space = ([ \t\n\r] | "--" [^\n]*)* ;
fragment NameChar = [a-z0-9_] ;
fragment Kw = ("def" | "let" | "in" | "if" | "then" | "else") !NameChar ;
token Var = !Kw [a-z_] NameChar* ;
token FnRef = !Kw [a-z_] NameChar* ;
token Bind = !Kw [a-z_] NameChar* ;
token Num = [0-9]+ ;

rule Prog = Def* -> Prog(defs) ;
rule Def = "def" Bind "(" Params ")" "=" Expr ";" -> Def(name, params, body) ;
rule Params = Bind,* -> Params(names) ;
rule Expr
  = "let" Bind "=" Expr "in" Expr -> Let(name, init, body)
  | "if" Expr "then" Expr "else" Expr -> If(test, yes, no)
  | Sum
  ;
infix Sum over Atom  left "+" Add "-" Sub  left "*" Mul ;
rule Atom
  = Num
  | FnRef "(" Expr,* ")" -> Call(callee, args)
  | Var
  | "(" Expr ")" -> Paren(inner)
  ;
