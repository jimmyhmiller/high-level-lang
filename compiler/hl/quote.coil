;;; Templates: a tree read from a template's text, as code that builds that tree. `$x` is a
;;; hole, `$$xs` splices a list wherever a list goes. Knows nothing about any grammar: node
;;; kinds are names, and the generated calls go through the alias the caller imported.
(module hl.quote)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)

(defstruct QNode [(kind (slice u8)) (text (slice u8)) (kids (ArrayList QNode))])

;;; A list element that is nothing but a splice: its first leaf, with only empty siblings.
;;; Never through a nested list: a splice belongs to the innermost list around it.
(defn splice-name [(n QNode)] (-> (slice u8))
  (if (= (len (.kids n)) 0)
      (if (rt/at? (.text n) 0 "$$") (rt/subtext (.text n) 2 (len (.text n))) "")
      (let [(mut ok) (!= (.kind n) "List")]
        (for i (range 1 (len (.kids n)))
          (unless (= (.kind (get (.kids n) i)) "None") (set! ok false)))
        (if ok (splice-name (get (.kids n) 0)) ""))))

(defn hole-entry [(name (slice u8)) (holes Code)] (-> Code)
  (let [(mut hit) `()]
    (for h holes
      (when (= (primitive/code-str (get h 0)) name) (set! hit h)))
    (when (= (len hit) 0)
      (primitive/error (rt/join "a template has no value for the hole " name)))
    hit))

;;; A leaf's text that names a hole inside other text: a hole is a whole leaf, or it would be
;;; printed as written. "" when there is none.
(defn buried-hole [(text (slice u8)) (holes Code)] (-> (slice u8))
  (let [(mut found) ""]
    (for h holes
      (let [name (primitive/code-str (get h 0))]
        (for i (range 0 (len text))
          (when (and (= (get text i) #\$)
                     (rt/at? text (+ i 1) name)
                     (or (= (+ i 1 (len name)) (len text))
                         (not (rt/name-char? (get text (+ i 1 (len name)))))))
            (set! found name)))))
    found))

(defn kind-of [(n QNode) (alias (slice u8))] (-> Code)
  (primitive/code-symbol alias "/K" (.kind n)))

;;; The finished form, read back as plain text so its names mean what they say at the
;;; template's own site: the alias its module imported, and the variables in the holes.
(defn expansion [(n QNode) (alias (slice u8)) (holes Code)] (-> Code)
  (primitive/code-read (dsl/render (code n alias holes)) `(reader-config)))

(defn code [(n QNode) (alias (slice u8)) (holes Code)] (-> Code)
  (cond (= (.kind n) "None") `(~(primitive/code-symbol alias "/none-node"))
        (and (= (len (.kids n)) 0)
             (rt/at? (.text n) 0 "$")
             (not (rt/at? (.text n) 0 "$$")))
          (let [entry
                  (hole-entry (rt/subtext (.text n) 1 (len (.text n))) holes)
                value (get entry 1)
                sort (primitive/code-str (get entry 2))]
            (if (= sort "text")
                `(~(primitive/code-symbol alias "/leaf") (~(kind-of n alias))
                    ~value
                    0
                    0)
                value))
        (and (= (len (.kids n)) 0) (> (len (.text n)) 0))
          (let [buried (buried-hole (.text n) holes)]
            (when (> (len buried) 0)
              (primitive/error (rt/join (rt/join "a template's hole $" buried)
                                         " is inside other text, where it is printed as written; give it a node of its own")))
          `(~(primitive/code-symbol alias "/leaf") (~(kind-of n alias))
              ~(.text n)
              0
              0))
        :else
          (let [(mut pushes) (primitive/code-list-new)
                (mut total) `0
                (mut fixed) 0]
            (for k (.kids n)
              (let [splice (if (= (.kind n) "List") (splice-name k) "")]
                (if (> (len splice) 0)
                    (let [entry (hole-entry splice holes)]
                      (set! total `(+ ~total (len ~(get entry 1))))
                      (push! (mut pushes)
                             `(for (ref each) ~(get entry 1)
                                (push! (mut kids) each))))
                    (do
                      (set! fixed (+ fixed 1))
                      (push! (mut pushes)
                             `(push! (mut kids) ~(code k alias holes)))))))
            ;; The kids' list is made as long as it will be: the kids written, and each list spliced.
            `(let [(mut kids) (~(primitive/code-symbol alias "/new-kids-sized") (+ ~fixed ~total))]
               ~@pushes
               (~(primitive/code-symbol alias "/mk") (~(kind-of n alias))
                  kids
                  0
                  0)))))
