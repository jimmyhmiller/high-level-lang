;;; `.syntax`: the parsing language. One grammar is the source of truth for the
;;; parser, the AST type, the printer, and a compile-time table of node shapes that
;;; other languages check themselves against.
;;;
;;; It is a scannerless PEG, because context decides what JavaScript's tokens are:
;;; a regex can only start where an expression can, so it needs no lexer mode.
;;;
;;;   syntax
;;;   start Program
;;;   space Space                   # skipped before every token in a `rule`
;;;   word IdPart                   # what may not follow a word literal
;;;   flags noin gen await          # parser state, set with `with(...)`
;;;   keep noin ;                   # parentheses stay as written under this flag
;;;   group "(" ")" Paren           # how the printer parenthesises
;;;   opaque OptMember Coalesce ;   # kinds whose parentheses are never removed
;;;   precedence Seq Assign Cond ;  # lowest first
;;;   printwords "abc_" high ;      # bytes of a word, for telling tokens apart; high: above ASCII too
;;;   apart "+" "+" ;               # these must not touch when printed
;;;   apartdigits "." ;             # this must not follow a token of only digits
;;;   softclose "}" ;               # a soft `;` is dropped before this
;;;   breaks ";" "{" "}" ;          # pretty output breaks the line after these
;;;
;;;   fragment Space = [ \n]* ;     # bytes, no node
;;;   token Ident = [a-z]+ ;        # bytes, a leaf node of that name
;;;   raw token Text = [^<]+ ;      # the same, but the space before it is part of it
;;;   rule Block = "{" Stmt* "}" -> Block | Other ;
;;;   memo rule Assign = … ;        # packrat this rule
;;;   hidden rule Semi prints soft ";" = ";" | &"}" | @eof | @nl ;
;;;   infix Binary over Unary  left "+" Add "-" Sub  left "*" Mul ;
;;;   infix B over U  left "<" Lt drop if(ts) @nonl "as" Type ; # the left stays, the right is
;;;                                 # matched and thrown away, and tighter operators may follow
;;;   postfix Call over New  "." PropName -> Member | Args -> Call ;  # loops
;;;   suffix Cond over Binary  "?" Assign ":" Assign -> Cond ;        # at most once
;;;   postfix Call over New  "!" ;  # an alternative with no label and no captures keeps the left
;;;
;;; Items in a rule: "lit", Name, X*, X+, X,* (optional trailing comma), X,+,
;;; X?, ( … )?, !X, &X, ~X (keep this child's parentheses), with(a -b) X, if(a),
;;; unless(a), @eof, @nl, @nonl. In a token or fragment: also [class] and `.`.
;;;
;;; `-> Label(a, b)` names the node's children, so other languages can write `n.a`; an infix
;;; operator's are `left` and `right`.
;;;
;;; An alternative with no `-> Label` has exactly one capture and passes it on.
;;; `X*` captures one List node, and `X?` captures its one capture or a None.
(module hl.syntax)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.str" :as str)
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)

(reader-provider "hl.syntax" read-syntax)

;; ---------------------------------------------------------------- the grammar

(defsum PEOp
  (OLit)
  (OClass)
  (OAny)
  (ORef)
  (OSeq)
  (OChoice)
  (OStar)
  (OPlus)
  (OOpt)
  (OSepStar)
  (OSepPlus)
  (ONot)
  (OAnd)
  (OKeep)
  (OWith)
  (OIf)
  (OUnless)
  (OEof)
  (OBof)
  (OLineStart)
  (ONl)
  (ONoNl))

(derive Eq PEOp)

(defstruct Range [(lo i64) (hi i64)])

;;; One parsing expression. `text` is a literal's bytes, a reference's name, or a
;;; flag's name; `on`/`off` are a `with`'s flag names.
(defstruct PE
  [(op PEOp)
   (text (slice u8))
   (kids (ArrayList PE))
   (ranges (ArrayList Range))
   (neg bool)
   (on (ArrayList (slice u8)))
   (off (ArrayList (slice u8)))
   (tok rt/Tok)])

(defstruct Alt [(seq PE) (label (slice u8)) (fields (ArrayList (slice u8)))])

(defstruct Op
  [(lit (slice u8))
   (kind (slice u8))
   (level i64)
   (unless-flag (slice u8))
   (tok rt/Tok)])

(defstruct Drop
  [(lit (slice u8))
   (level i64)
   (flag (slice u8))
   (nonl bool)
   (rule (slice u8))
   (tok rt/Tok)])

(defsum DeclKind
  (DFragment)
  (DToken)
  (DRule)
  (DHidden)
  (DInfix)
  (DPostfix)
  (DSuffix))

(derive Eq DeclKind)

(defstruct Decl
  [(kind DeclKind)
   (name (slice u8))
   (over (slice u8))
   (alts (ArrayList Alt))
   (ops (ArrayList Op))
   (drops (ArrayList Drop))
   (body PE)
   (memo bool)
   (print-soft bool)
   (print-text (slice u8))
   (raw bool)
   (tok rt/Tok)])

;;; What a kind prints as: an alternative, an operator, or a token's own bytes.
(defsum Print
  (PAlt [(alt Alt) (base-min i64)])
  (POp [(op Op)])
  (PLeaf []))

(defstruct KindDef
  [(name (slice u8))
   (arity i64)
   (level i64)
   (print Print)
   (fields (ArrayList (slice u8)))])

(defstruct Named [(name (slice u8)) (value i64)])

(defstruct Lit [(text (slice u8)) (id i64)])

(defstruct Grammar
  [(start (slice u8))
   (space (slice u8))
   (word (slice u8))
   (flags (ArrayList (slice u8)))
   (print-words (slice u8))
   (print-high bool)
   (apart (slice u8))
   (apart-digits (slice u8))
   (soft-close (slice u8))
   (breaks (ArrayList (slice u8)))
   (keep-under (ArrayList (slice u8)))
   (group-open (slice u8))
   (group-close (slice u8))
   (group-kind (slice u8))
   (opaque (ArrayList (slice u8)))
   (precedence (ArrayList (slice u8)))
   (keep-min (slice u8))
   (keep-forbid (ArrayList (slice u8)))
   (nomix (ArrayList (slice u8)))
   ;; `notbefore "?." "0123456789"`: a punctuation literal that is no token before these bytes,
   ;; as a pair of texts each, literal then bytes.
   (not-before (ArrayList (slice u8)))
   (decls (ArrayList Decl))
   (kinds (ArrayList KindDef))
   (lits (ArrayList Lit))
   (reps (ArrayList (slice u8)))
   (memo-count i64)
   (next-aux i64)
   (aux (ArrayList (slice u8)))
   (path (slice u8))])

;;; A function, not a const: a const is lost when this runs from a top-level macro.
;;; See experiments/repros/h-const-in-provider.
(defn no-level [] (-> i64)
  1000000)

;; ---------------------------------------------------------------- reading

(defn empty-pes [] (-> (ArrayList PE))
  (ArrayList::new [PE] (malloc-allocator)))

(defn empty-strs [] (-> (ArrayList (slice u8)))
  (ArrayList::new [(slice u8)] (malloc-allocator)))

;;; An infix operator's two children.
(defn left-right [] (-> (ArrayList (slice u8)))
  (let [(mut out) (empty-strs)]
    (push! (mut out) "left")
    (push! (mut out) "right")
    out))

(defn pe-new [(op PEOp) (text (slice u8)) (tok rt/Tok)] (-> PE)
  (PE
    :op op
    :text text
    :kids (empty-pes)
    :ranges (ArrayList::new [Range] (malloc-allocator))
    :neg false
    :on (empty-strs)
    :off (empty-strs)
    :tok tok))

(defn pe-wrap [(op PEOp) (inner PE) (tok rt/Tok)] (-> PE)
  (let [(mut out) (pe-new op "" tok)]
    (push! (mut (.kids out)) inner)
    out))

(defn hex-value [(c u8)] (-> i64)
  (cond (and (>= c #\0) (<= c #\9)) (- (cast i64 c) 48)
        (and (>= c #\a) (<= c #\f)) (+ (- (cast i64 c) 97) 10)
        (and (>= c #\A) (<= c #\F)) (+ (- (cast i64 c) 65) 10)
        :else -1))

(defn push-utf8! [(out (mut (ArrayList u8))) (cp i64)] (-> void)
  (cond (< cp 128) (push! (mut out) (cast u8 cp))
        (< cp 2048)
          (do
            (push! (mut out) (cast u8 (+ 192 (/ cp 64))))
            (push! (mut out) (cast u8 (+ 128 (% cp 64)))))
        :else
          (do
            (push! (mut out) (cast u8 (+ 224 (/ cp 4096))))
            (push! (mut out) (cast u8 (+ 128 (% (/ cp 64) 64))))
            (push! (mut out) (cast u8 (+ 128 (% cp 64)))))))

(defn hex-at [(c (mut dsl/Cur)) (t rt/Tok) (s (slice u8)) (at i64) (count i64)]
  (-> i64)
  (let [(mut v) 0]
    (for k (range 0 count)
      (let [d (if (< (+ at k) (len s)) (hex-value (get s (+ at k))) -1)]
        (when (< d 0) (dsl/die (mut c) t "bad hex escape"))
        (set! v (+ (* v 16) d))))
    v))

;;; How many source bytes the escape at `i` takes, and its value.
(defstruct Esc [(value i64) (size i64)])

(defn read-escape [(c (mut dsl/Cur)) (t rt/Tok) (s (slice u8)) (i i64)] (-> Esc)
  (when (>= (+ i 1) (len s)) (dsl/die (mut c) t "dangling backslash"))
  (let [e (get s (+ i 1))]
    (cond (= e #\n) (Esc :value 10 :size 2)
          (= e #\r) (Esc :value 13 :size 2)
          (= e #\t) (Esc :value 9 :size 2)
          (= e #\0) (Esc :value 0 :size 2)
          (= e #\x) (Esc :value (hex-at (mut c) t s (+ i 2) 2) :size 4)
          (= e #\u) (Esc :value (hex-at (mut c) t s (+ i 2) 4) :size 6)
          :else (Esc :value (cast i64 e) :size 2))))

;;; A string token's bytes with its escapes resolved; \u is UTF-8 encoded.
(defn decode-string [(c (mut dsl/Cur)) (t rt/Tok)] (-> (slice u8))
  (let [s (.text t)
        (mut out) (ArrayList::new [u8] (malloc-allocator))
        (mut i) 0]
    (while (< i (len s))
      (if (= (get s i) #\\)
          (let [e (read-escape (mut c) t s i)]
            (push-utf8! (mut out) (.value e))
            (set! i (+ i (.size e))))
          (do (push! (mut out) (get s i)) (set! i (+ i 1)))))
    (slice out)))

;;; `[a-z_\n]` or `[^…]`. Values are bytes: \xHH names one directly.
(defn read-class [(c (mut dsl/Cur)) (t rt/Tok)] (-> PE)
  (let [s (.text t)
        (mut out) (pe-new (OClass) "" t)
        (mut i) 0
        (mut vals) (ArrayList::new [i64] (malloc-allocator))]
    (when (and (> (len s) 0) (= (get s 0) #\^))
      (set! (.neg out) true)
      (set! i 1))
    (while (< i (len s))
      (let [lo
              (if (= (get s i) #\\)
                  (let [e (read-escape (mut c) t s i)]
                    (set! i (+ i (.size e)))
                    (.value e))
                  (let [v (cast i64 (get s i))]
                    (set! i (+ i 1))
                    v))]
        (if (and (< (+ i 1) (len s)) (= (get s i) #\-))
            (let [hi
                    (if (= (get s (+ i 1)) #\\)
                        (let [e (read-escape (mut c) t s (+ i 1))]
                          (set! i (+ i 1 (.size e)))
                          (.value e))
                        (let [v (cast i64 (get s (+ i 1)))]
                          (set! i (+ i 2))
                          v))]
              (push! (mut (.ranges out)) (Range :lo lo :hi hi)))
            (push! (mut (.ranges out)) (Range :lo lo :hi lo)))))
    out))

(defn read-with [(c (mut dsl/Cur)) (t rt/Tok)] (-> PE)
  (let [(mut out) (pe-new (OWith) "" t)]
    (dsl/expect! (mut c) "(")
    (while (not (dsl/accept! (mut c) ")"))
      (if (dsl/accept! (mut c) "-")
          (push! (mut (.off out)) (.text (dsl/name! (mut c) "a flag")))
          (push! (mut (.on out)) (.text (dsl/name! (mut c) "a flag")))))
    (push! (mut (.kids out)) (read-prefixed (mut c)))
    out))

(defn read-flag-test [(c (mut dsl/Cur)) (t rt/Tok) (op PEOp)] (-> PE)
  (dsl/expect! (mut c) "(")
  (let [n (dsl/name! (mut c) "a flag")]
    (dsl/expect! (mut c) ")")
    (pe-new op (.text n) t)))

(defn read-atom [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))]
    (cond (= (.kind t) (rt/TStr))
            (do
              (dsl/advance! (mut c))
              (pe-new (OLit) (decode-string (mut c) t) t))
          (= (.kind t) (rt/TClass))
            (do (dsl/advance! (mut c)) (read-class (mut c) t))
          (dsl/accept! (mut c) ".") (pe-new (OAny) "" t)
          (dsl/accept! (mut c) "(")
            (let [inner (read-choice (mut c))]
              (dsl/expect! (mut c) ")")
              inner)
          (= (.kind t) (rt/TIdent))
            (do (dsl/advance! (mut c)) (pe-new (ORef) (.text t) t))
          :else
            (dsl/die (mut c)
                     t
                     (dsl/join2 "expected a grammar item, found " (.text t))))))

(defn read-suffixed [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        a (read-atom (mut c))]
    (cond (dsl/accept! (mut c) "*") (pe-wrap (OStar) a t)
          (dsl/accept! (mut c) "+") (pe-wrap (OPlus) a t)
          (dsl/accept! (mut c) "?") (pe-wrap (OOpt) a t)
          (dsl/accept! (mut c) ",*") (pe-wrap (OSepStar) a t)
          (dsl/accept! (mut c) ",+") (pe-wrap (OSepPlus) a t)
          :else a)))

(defn read-prefixed [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))]
    (cond (dsl/accept! (mut c) "!") (pe-wrap (ONot) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "&") (pe-wrap (OAnd) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "~") (pe-wrap (OKeep) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "@")
            (let [n (dsl/name! (mut c) "eof, nl or nonl")]
              (cond (= (.text n) "eof") (pe-new (OEof) "" t)
                    (= (.text n) "bof") (pe-new (OBof) "" t)
                    (= (.text n) "linestart") (pe-new (OLineStart) "" t)
                    (= (.text n) "nl") (pe-new (ONl) "" t)
                    (= (.text n) "nonl") (pe-new (ONoNl) "" t)
                    :else (dsl/die (mut c) n "expected @eof, @nl or @nonl")))
          (dsl/accept! (mut c) "with") (read-with (mut c) t)
          (dsl/accept! (mut c) "if") (read-flag-test (mut c) t (OIf))
          (dsl/accept! (mut c) "unless") (read-flag-test (mut c) t (OUnless))
          :else (read-suffixed (mut c)))))

(defn seq-end? [(c (mut dsl/Cur))] (-> bool)
  (or (dsl/at? (mut c) "|")
      (dsl/at? (mut c) ";")
      (dsl/at? (mut c) "->")
      (dsl/at? (mut c) ")")))

(defn read-seq [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        (mut out) (pe-new (OSeq) "" t)]
    (while (not (seq-end? (mut c)))
      (push! (mut (.kids out)) (read-prefixed (mut c))))
    (when (= (len (.kids out)) 0)
      (dsl/die (mut c) t "an empty sequence"))
    (if (= (len (.kids out)) 1) (get (.kids out) 0) out)))

(defn read-choice [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        first (read-seq (mut c))]
    (if (dsl/at? (mut c) "|")
        (let [(mut out) (pe-new (OChoice) "" t)]
          (push! (mut (.kids out)) first)
          (while (dsl/accept! (mut c) "|")
            (push! (mut (.kids out)) (read-seq (mut c))))
          out)
        first)))

;;; A child's name may have dashes, as names do in the languages that read it: `type-params`. The
;;; words and dashes must touch, or `a - b` would be one name.
(defn dashed-name [(c (mut dsl/Cur)) (first rt/Tok)] (-> (slice u8))
  (let [(mut name) (.text first)
        (mut end) (+ (.col first) (len (.text first)))
        (mut go) true]
    (while go
      (let [d (dsl/peek (mut c))]
        (if (and (dsl/at? (mut c) "-")
                 (= (.line d) (.line first))
                 (= (.col d) end))
            (do
              (dsl/advance! (mut c))
              (let [w (dsl/name! (mut c) "a word after the dash")]
                (unless (= (.col w) (+ end 1))
                  (dsl/die (mut c) w "a dashed name has no spaces"))
                (set! name (dsl/join3 name "-" (.text w)))
                (set! end (+ (.col w) (len (.text w))))))
            (set! go false))))
    name))

;;; `-> Label(a, b)`: names for the node's children, in order, after the `(`.
(defn read-field-names [(c (mut dsl/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut out) (empty-strs)
        (mut go) (not (dsl/accept! (mut c) ")"))]
    (while go
      (let [t (dsl/name! (mut c) "a child's name")
            name (dashed-name (mut c) t)]
        (for x out
          (when (= x name)
            (dsl/die (mut c)
                     t
                     (dsl/join3 "the child name " name " is used twice"))))
        (push! (mut out) name))
      (unless (dsl/accept! (mut c) ",")
        (dsl/expect! (mut c) ")")
        (set! go false)))
    out))

;;; `seq -> Label`, with a `|` between alternatives and a `;` after the last.
(defn read-alts [(c (mut dsl/Cur))] (-> (ArrayList Alt))
  (let [(mut alts) (ArrayList::new [Alt] (malloc-allocator))
        (mut go) true]
    (dsl/accept! (mut c) "|")
    (while go
      (let [s (read-seq (mut c))
            label
              (if (dsl/accept! (mut c) "->")
                  (.text (dsl/name! (mut c) "a node label"))
                  "")
            fields
              (if (and (> (len label) 0) (dsl/accept! (mut c) "("))
                  (read-field-names (mut c))
                  (empty-strs))]
        (push! (mut alts)
               (Alt
                 :seq s
                 :label label
                 :fields fields))
        (unless (dsl/accept! (mut c) "|") (set! go false))))
    (dsl/expect! (mut c) ";")
    alts))

(defn read-drop! [(c (mut dsl/Cur)) (d (mut Decl)) (level i64)] (-> void)
  (let [flag
          (if (dsl/accept! (mut c) "if")
              (.text (read-flag-test (mut c) (dsl/peek (mut c)) (OIf)))
              "")
        nonl
          (if (dsl/accept! (mut c) "@")
              (do (dsl/expect! (mut c) "nonl") true)
              false)
        lit (dsl/string! (mut c) "an operator literal")
        rule (dsl/name! (mut c) "a hidden rule")]
    (when (< level 0)
      (dsl/die (mut c) lit "an operator needs a `left` level before it"))
    (push! (mut (.drops d))
           (Drop
             :lit (decode-string (mut c) lit)
             :level level
             :flag flag
             :nonl nonl
             :rule (.text rule)
             :tok lit))))

(defn read-ops! [(c (mut dsl/Cur)) (d (mut Decl))] (-> void)
  (let [(mut level) -1]
    (while (not (dsl/accept! (mut c) ";"))
      (when (dsl/accept! (mut c) "left") (set! level (+ level 1)))
      (if (dsl/accept! (mut c) "drop")
          (read-drop! (mut c) (mut d) level)
          (let [flag
                  (if (dsl/accept! (mut c) "unless")
                      (.text (read-flag-test (mut c)
                                             (dsl/peek (mut c))
                                             (OUnless)))
                      "")
                lit (dsl/string! (mut c) "an operator literal")
                kind (dsl/name! (mut c) "a node label")]
            (when (< level 0)
              (dsl/die (mut c) lit "an operator needs a `left` level before it"))
            (push! (mut (.ops d))
                   (Op
                     :lit (decode-string (mut c) lit)
                     :kind (.text kind)
                     :level level
                     :unless-flag flag
                     :tok lit)))))))

(defn decl-new [(kind DeclKind) (name (slice u8)) (t rt/Tok)] (-> Decl)
  (Decl
    :kind kind
    :name name
    :over ""
    :alts (ArrayList::new [Alt] (malloc-allocator))
    :ops (ArrayList::new [Op] (malloc-allocator))
    :drops (ArrayList::new [Drop] (malloc-allocator))
    :body (pe-new (OSeq) "" t)
    :memo false
    :print-soft false
    :print-text ""
    :raw false
    :tok t))

(defn read-decl [(c (mut dsl/Cur))] (-> Decl)
  (let [t (dsl/peek (mut c))
        memo (dsl/accept! (mut c) "memo")]
    (cond (dsl/accept! (mut c) "fragment")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DFragment) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "raw")
            (let [_ (dsl/expect! (mut c) "token")
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DToken) (.text n) n)]
              (set! (.raw d) true)
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "token")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DToken) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "hidden")
            (let [_ (dsl/expect! (mut c) "rule")
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DHidden) (.text n) n)]
              (when (dsl/accept! (mut c) "prints")
                (set! (.print-soft d) (dsl/accept! (mut c) "soft"))
                (let [s (dsl/string! (mut c) "the printed text")]
                  (set! (.print-text d) (decode-string (mut c) s))))
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "rule")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DRule) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.alts d) (read-alts (mut c)))
              (set! (.memo d) memo)
              d)
          (dsl/accept! (mut c) "infix")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DInfix) (.text n) n)]
              (dsl/expect! (mut c) "over")
              (set! (.over d) (.text (dsl/name! (mut c) "a rule")))
              (read-ops! (mut c) (mut d))
              d)
          (or (dsl/at? (mut c) "postfix") (dsl/at? (mut c) "suffix"))
            (let [kind
                    (if (dsl/accept! (mut c) "postfix")
                        (DPostfix)
                        (do (dsl/expect! (mut c) "suffix") (DSuffix)))
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new kind (.text n) n)]
              (dsl/expect! (mut c) "over")
              (set! (.over d) (.text (dsl/name! (mut c) "a rule")))
              (set! (.alts d) (read-alts (mut c)))
              (set! (.memo d) memo)
              d)
          :else
            (dsl/die (mut c)
                     t
                     "expected fragment, token, rule, hidden, infix, postfix or suffix"))))

;; ---------------------------------------------------------------- analysis

(defn find-decl [(g Grammar) (n (slice u8))] (-> (Option Decl))
  (let [(mut out) (None [Decl])]
    (for d (.decls g) (when (= (.name d) n) (set! out (Some d))))
    out))

(defn contains? [(xs (ArrayList (slice u8))) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x xs (when (= x s) (set! hit true)))
    hit))

(defn add-unique! [(xs (mut (ArrayList (slice u8)))) (s (slice u8))] (-> void)
  (unless (contains? xs s) (push! (mut xs) s)))

(defn decl-kind-of [(g Grammar) (c (mut dsl/Cur)) (t rt/Tok) (n (slice u8))]
  (-> DeclKind)
  (match (find-decl g n)
    (Some [d] (.kind d))
    (None [] (dsl/die (mut c) t (dsl/join2 "no rule named " n)))))

;;; Does this item capture a child in a rule?
(defn captures? [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> bool)
  (match (.op e)
    (OLit [] false)
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (cond (= k (DHidden)) false
                  (= k (DFragment)) false
                  :else true)))
    (OStar [] true)
    (OPlus [] true)
    (OOpt [] true)
    (OSepStar [] true)
    (OSepPlus [] true)
    (OKeep [] (captures? g (mut c) (get (.kids e) 0)))
    (OWith [] (captures? g (mut c) (get (.kids e) 0)))
    (OChoice [] (no-captures-inside! g (mut c) e) false)
    (OSeq [] (no-captures-inside! g (mut c) e) false)
    (_ false)))

;;; A bare group is matched but yields nothing, so a capture inside it would vanish.
(defn no-captures-inside! [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> void)
  (for k (.kids e)
    (when (captures? g (mut c) k)
      (dsl/die (mut c)
               (.tok k)
               "this capture is inside a bare group and would be lost; give the group a rule"))))

(defn seq-items [(e PE)] (-> (ArrayList PE))
  (if (= (.op e) (OSeq))
      (.kids e)
      (let [(mut out) (empty-pes)]
        (push! (mut out) e)
        out)))

(defn count-captures [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> i64)
  (let [(mut n) 0]
    (for it (seq-items e) (when (captures? g (mut c) it) (set! n (+ n 1))))
    n))

;;; What must not begin a capture that a `!` guard protects: its literals.
(defn guard-lits! [(e PE) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.op e)
    (OLit [] (add-unique! (mut out) (.text e)))
    (OChoice [] (for k (.kids e) (guard-lits! k (mut out))))
    (OSeq [] (guard-lits! (get (.kids e) 0) (mut out)))
    (_ 0)))

(defn word-literal? [(s (slice u8))] (-> bool)
  (and (> (len s) 0) (rt/name-start? (get s 0))))

(defn collect-lits! [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> void)
  (match (.op e)
    (OLit []
          (let [(mut hit) false]
            (for l (.lits g) (when (= (.text l) (.text e)) (set! hit true)))
            (unless hit
              (push! (mut (.lits g)) (Lit :text (.text e) :id (len (.lits g)))))))
    (_ (for k (.kids e) (collect-lits! (mut g) (mut c) k)))))

(defn add-lit! [(g (mut Grammar)) (text (slice u8))] (-> void)
  (let [(mut hit) false]
    (for l (.lits g) (when (= (.text l) text) (set! hit true)))
    (unless hit (push! (mut (.lits g)) (Lit :text text :id (len (.lits g)))))))

(defn lit-id [(g (mut Grammar)) (text (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for l (.lits g) (when (= (.text l) text) (set! out (.id l))))
    (when (< out 0) (panic "literal {} was not collected" text))
    out))

;;; A printable signature of an alternative: a label may repeat across rules only
;;; if every use prints the same way.
(defn sig [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (let [(mut out) ""]
    (for it (seq-items e)
      (let [one (sig-item g (mut c) it)]
        (when (> (len one) 0) (set! out (dsl/join3 out " " one)))))
    out))

(defn sig-item [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (match (.op e)
    (OLit [] (.text e))
    (ORef []
          ;; A hidden rule that prints nothing is no part of a form.
          (match (find-decl g (.text e))
            (Some [d]
                  (if (and (= (.kind d) (DHidden))
                           (not (.print-soft d))
                           (= (len (.print-text d)) 0))
                      ""
                      (.text e)))
            (None [] (.text e))))
    (OStar [] (dsl/join2 "*" (sig g (mut c) (get (.kids e) 0))))
    (OPlus [] (dsl/join2 "+" (sig g (mut c) (get (.kids e) 0))))
    (OSepStar [] (dsl/join2 ",*" (sig g (mut c) (get (.kids e) 0))))
    (OSepPlus [] (dsl/join2 ",+" (sig g (mut c) (get (.kids e) 0))))
    (OOpt [] (dsl/join2 "?" (sig g (mut c) (get (.kids e) 0))))
    (OKeep [] (sig-item g (mut c) (get (.kids e) 0)))
    (OWith [] (sig-item g (mut c) (get (.kids e) 0)))
    (_ "")))

(defn add-kind! [(g (mut Grammar)) (c (mut dsl/Cur)) (t rt/Tok) (k KindDef)]
  (-> void)
  (let [(mut dup) false]
    (for old (.kinds g)
      (when (= (.name old) (.name k))
        (set! dup true)
        (let [same
                (match (.print old)
                  (PAlt [a _]
                        (match (.print k)
                          (PAlt [b _]
                                (= (sig g (mut c) (.seq a))
                                   (sig g (mut c) (.seq b))))
                          (_ false)))
                  (_ false))]
          (unless same
            (dsl/die (mut c)
                     t
                     (dsl/join3 "the label "
                                (.name k)
                                " is used with two different forms; a printer needs one form per label"))))))
    (when (and (> (len (.fields k)) 0) (!= (len (.fields k)) (.arity k)))
      (dsl/die (mut c)
               t
               (dsl/join3 (dsl/join3 "the node " (.name k) " has ")
                          (rt/num-text (.arity k))
                          (dsl/join3 " children, but "
                                     (rt/num-text (len (.fields k)))
                                     " names"))))
    (for i (range 0 (len (.kinds g)))
      (let [old (get (.kinds g) i)]
        (when (and (= (.name old) (.name k)) (> (len (.fields k)) 0))
          (if (= (len (.fields old)) 0)
              (set! (mut (.kinds g)) i (with-fields old (.fields k)))
              (unless (same-strs? (.fields old) (.fields k))
                (dsl/die (mut c)
                         t
                         (dsl/join3 "the node "
                                    (.name k)
                                    " names its children differently here")))))))
    (unless dup (push! (mut (.kinds g)) k))))

(defn with-fields [(k KindDef) (fields (ArrayList (slice u8)))] (-> KindDef)
  (KindDef
    :name (.name k)
    :arity (.arity k)
    :level (.level k)
    :print (.print k)
    :fields fields))

(defn same-strs? [(a (ArrayList (slice u8))) (b (ArrayList (slice u8)))]
  (-> bool)
  (and (= (len a) (len b))
       (let [(mut same) true]
         (for i (range 0 (len a))
           (unless (= (get a i) (get b i)) (set! same false)))
         same)))

(defn set-kind-level! [(g (mut Grammar)) (name (slice u8)) (level i64)]
  (-> void)
  (for i (range 0 (len (.kinds g)))
    (let [k (get (.kinds g) i)]
      (when (= (.name k) name)
        (set! (mut (.kinds g))
              i
              (KindDef
                :name (.name k)
                :arity (.arity k)
                :level level
                :print (.print k)
                :fields (.fields k)))))))

(defn set-kind-base! [(g (mut Grammar)) (name (slice u8)) (base-min i64)]
  (-> void)
  (for i (range 0 (len (.kinds g)))
    (let [k (get (.kinds g) i)]
      (when (= (.name k) name)
        (match (.print k)
          ;; A label shared across rules keeps the strictest requirement.
          (PAlt [a old]
                (when (> base-min old)
                  (set! (mut (.kinds g))
                        i
                        (KindDef
                          :name (.name k)
                          :arity (.arity k)
                          :level (.level k)
                          :print (PAlt a base-min)
                          :fields (.fields k)))))
          (_ 0))))))

(defn check-refs! [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> void)
  (when (= (.op e) (ORef))
    (decl-kind-of g (mut c) (.tok e) (.text e))
    0)
  (for k (.kids e) (check-refs! g (mut c) k)))

(defn analyse-alts! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl) (extra i64)]
  (-> void)
  (for a (.alts d)
    (check-refs! g (mut c) (.seq a))
    (collect-lits! (mut g) (mut c) (.seq a))
    (let [n (count-captures g (mut c) (.seq a))]
      (cond (> (len (.label a)) 0)
              (add-kind! (mut g)
                         (mut c)
                         (.tok (.seq a))
                         (KindDef
                           :name (.label a)
                           :arity (+ n extra)
                           :level (no-level)
                           :print (PAlt a 0)
                           :fields (.fields a)))
            (and (= extra 0) (!= n 1))
              (dsl/die (mut c)
                       (.tok (.seq a))
                       "an alternative with no label must capture exactly one thing")
            (and (> extra 0) (!= n 0))
              (dsl/die (mut c)
                       (.tok (.seq a))
                       "a postfix or suffix alternative with captures needs a label")
            :else 0))))

(defn analyse! [(g (mut Grammar)) (c (mut dsl/Cur))] (-> void)
  (for d (.decls g)
    (let [k (.kind d)]
      (cond (= k (DRule)) (analyse-alts! (mut g) (mut c) d 0)
            (or (= k (DPostfix)) (= k (DSuffix)))
              (do
                (decl-kind-of g (mut c) (.tok d) (.over d))
                (analyse-alts! (mut g) (mut c) d 1))
            (= k (DInfix))
              (do
                (decl-kind-of g (mut c) (.tok d) (.over d))
                (for op (.ops d)
                  (add-lit! (mut g) (.lit op))
                  (add-kind! (mut g)
                             (mut c)
                             (.tok op)
                             (KindDef
                               :name (.kind op)
                               :arity 2
                               :level (no-level)
                               :print (POp op)
                               :fields (left-right))))
                (for dr (.drops d)
                  (add-lit! (mut g) (.lit dr))
                  (unless (= (decl-kind-of g (mut c) (.tok dr) (.rule dr))
                             (DHidden))
                    (dsl/die (mut c)
                             (.tok dr)
                             "what a `drop` operator discards must be a hidden rule"))))
            (= k (DToken))
              (do
                (check-refs! g (mut c) (.body d))
                (add-kind! (mut g)
                           (mut c)
                           (.tok d)
                           (KindDef
                             :name (.name d)
                             :arity 0
                             :level (no-level)
                             :print (PLeaf)
                             :fields (empty-strs))))
            (= k (DHidden))
              (do
                (check-refs! g (mut c) (.body d))
                (collect-lits! (mut g) (mut c) (.body d)))
            :else (check-refs! g (mut c) (.body d))))))

;;; Number the precedence chain, lowest first, and give kinds their rule's level.
;;; Infix operators take one level each, so a rule's level is its lowest kind.
(defn assign-levels! [(g (mut Grammar))
                      (c (mut dsl/Cur))
                      (levels (mut (ArrayList Named)))] (-> void)
  (let [(mut level) 1]
    (for name (.precedence g)
      (match (find-decl g name)
        (None []
              (dsl/die (mut c)
                       (dsl/peek (mut c))
                       (dsl/join2 "precedence names no rule called " name)))
        (Some [d]
              (push! (mut levels) (Named :name name :value level))
              (if (= (.kind d) (DInfix))
                  (let [(mut top) 0]
                    (for op (.ops d)
                      (set-kind-level! (mut g) (.kind op) (+ level (.level op)))
                      (when (> (.level op) top) (set! top (.level op))))
                    (set! level (+ level top 1)))
                  (do
                    (for a (.alts d)
                      (when (> (len (.label a)) 0)
                        (set-kind-level! (mut g) (.label a) level)))
                    (set! level (+ level 1)))))))
    ;; A postfix chain may nest in itself; a suffix's base must sit above it.
    (for d (.decls g)
      (when (or (= (.kind d) (DPostfix)) (= (.kind d) (DSuffix)))
        (let [self (named-value levels (.name d))
              over (named-value levels (.over d))]
          (for a (.alts d)
            (set-kind-base! (mut g)
                            (.label a)
                            (if (= (.kind d) (DPostfix)) self over))))))))

(defn named-value [(xs (ArrayList Named)) (n (slice u8))] (-> i64)
  (let [(mut out) 0]
    (for x xs (when (= (.name x) n) (set! out (.value x))))
    out))

;; ---------------------------------------------------------------- symbols

(defn kind-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "K" n))

(defn rule-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "p-" n))

(defn impl-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-impl")))

(defn lex-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "lex-" n))

(defn hidden-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "h-" n))

(defn rep-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "rep-" n))

(defn rep1-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "rep1-" n))

(defn sep-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "sep-" n))

(defn sep1-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "sep1-" n))

(defn cap-sym [(i i64)] (-> Code)
  (primitive/code-symbol "c" i))

(defn lit-sym [(i i64)] (-> Code)
  (primitive/code-symbol "lit-" i))

(defn aux-sym [(i i64)] (-> Code)
  (primitive/code-symbol "opt-" i))

(defn flag-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "FLAG-" n))

(defn alt-sym [(n (slice u8)) (i i64)] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-alt") i))

(defn fresh-aux! [(g (mut Grammar))] (-> i64)
  (let [i (.next-aux g)]
    (set! (.next-aux g) (+ i 1))
    i))

(defn add-aux! [(g (mut Grammar)) (form Code)] (-> void)
  (push! (mut (.aux g)) (dsl/render form)))

;; ---------------------------------------------------------------- lexical code

;;; Is this literal next? Most tests fail, and on the first byte, so check that alone
;;; before comparing strings.
(defn bytes-test [(s (slice u8))] (-> Code)
  (if (= (len s) 1)
      `(= (rt/peek (mut p)) ~(cast i64 (get s 0)))
      `(and (= (rt/peek (mut p)) ~(cast i64 (get s 0)))
            (rt/at-bytes? (mut p) ~s))))

;;; The bytes a class matches, as ranges: a negated one's are the rest of 0 to 255.
(defn class-ranges [(e PE)] (-> PE)
  (if (not (.neg e))
      e
      (let [(mut out) e
            (mut rs) (ArrayList::new [Range] (malloc-allocator))]
        (for b (range 0 256)
          (let [(mut in) false]
            (for r (.ranges e)
              (when (and (>= b (.lo r)) (<= b (.hi r))) (set! in true)))
            (unless in
              (if (and (> (len rs) 0) (= (.hi (get rs (- (len rs) 1))) (- b 1)))
                  (let [last (get rs (- (len rs) 1))]
                    (set! (mut rs) (- (len rs) 1) (Range :lo (.lo last) :hi b)))
                  (push! (mut rs) (Range :lo b :hi b))))))
        (set! (.ranges out) rs)
        (set! (.neg out) false)
        out)))

;;; A bool expression over bytes that advances on success and restores on failure. A class of
;;; more than two ranges, or a negated one, is one test of a 256-bit set.
(defn class-test [(e PE)] (-> Code)
  (if (or (.neg e) (> (len (.ranges e)) 2))
      (let [(mut f) (First :ranges (.ranges (class-ranges e)) :known true)]
        (byte-test (bytes-of-first f)))
      (class-test-ranges e)))

(defn class-test-ranges [(e PE)] (-> Code)
  (let [(mut tests) (primitive/code-list-new)]
    (for r (.ranges e)
      (if (= (.lo r) (.hi r))
          (push! (mut tests) `(= c ~(.lo r)))
          (push! (mut tests) `(and (>= c ~(.lo r)) (<= c ~(.hi r))))))
    (if (.neg e)
        `(and (>= c 0) (not (or ~@tests)))
        `(or ~@tests))))

;;; The bytes `e` matches when it always matches exactly one byte: a class, a one-byte literal, any
;;; byte, or a choice of those, through fragments too.
(defn byte-set-of [(g Grammar) (e PE) (depth i64)] (-> (Option Bytes))
  (match (.op e)
    (OClass []
            (let [(mut f) (First :ranges (.ranges (class-ranges e)) :known true)]
              (Some (bytes-of-first f))))
    (OLit []
          (if (= (len (.text e)) 1)
              (let [(mut f)
                      (First
                        :ranges (ArrayList::new [Range] (malloc-allocator))
                        :known true)
                    b (cast i64 (get (.text e) 0))]
                (push! (mut (.ranges f)) (Range :lo b :hi b))
                (Some (bytes-of-first f)))
              (None [Bytes])))
    (OAny []
          (Some (Bytes
                  :w0 -1
                  :w1 -1
                  :w2 -1
                  :w3 -1
                  :known true)))
    (OChoice []
             (let [(mut acc) (Some (bytes-none))]
               (for k (.kids e)
                 (match acc
                   (Some [a]
                         (match (byte-set-of g k depth)
                           (Some [b] (set! acc (Some (bytes-union a b))))
                           (None [] (set! acc (None [Bytes])))))
                   (None [] 0)))
               acc))
    (ORef []
          (if (> depth 8)
              (None [Bytes])
              (match (find-decl g (.text e))
                (Some [d]
                      (if (= (.kind d) (DFragment))
                          (byte-set-of g (.body d) (+ depth 1))
                          (None [Bytes])))
                (None [] (None [Bytes])))))
    (_ (None [Bytes]))))

;;; A byte set's test of the byte here, and the step past it.
(defn byte-step [(b Bytes)] (-> Code)
  `(let [c (rt/peek (mut p))]
     (if ~(byte-test b) (do (rt/advance! (mut p) 1) true) false)))

(defn lex-code [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (byte-set-of g e 0)
    (Some [b]
          (if (or (= (.op e) (OLit)) (= (.op e) (OClass)))
              (lex-code-of g (mut c) e)
              (byte-step b)))
    (None [] (lex-code-of g (mut c) e))))

(defn lex-code-of [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (.op e)
    (OLit []
          `(if ~(bytes-test (.text e))
               (do (rt/advance! (mut p) ~(len (.text e))) true)
               false))
    (OClass []
            `(let [c (rt/peek (mut p))]
               (if ~(class-test e)
                   (do (rt/advance! (mut p) 1) true)
                   false)))
    (OAny []
          `(if (rt/eof? (mut p)) false (do (rt/advance! (mut p) 1) true)))
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (unless (or (= k (DFragment)) (= k (DToken)))
              (dsl/die (mut c)
                       (.tok e)
                       "a token can only use fragments and tokens"))
            `(~(lex-sym (.text e)) (mut p))))
    (OSeq []
          (let [(mut parts) (primitive/code-list-new)]
            (for k (.kids e) (push! (mut parts) (lex-code g (mut c) k)))
            `(let [s (.pos p)]
               (if (and ~@parts true) true (do (set! (.pos p) s) false)))))
    ;; Each alternative is tried only if the byte here can begin it: the byte is read once, as
    ;; a failing alternative leaves the position where it was.
    (OChoice []
             (let [(mut parts) (primitive/code-list-new)]
               (for k (.kids e)
                 (let [code (lex-code g (mut c) k)
                       (mut f)
                         (First
                           :ranges (ArrayList::new [Range] (malloc-allocator))
                           :known true)
                       empty (first-of! g k (mut f) 0)]
                   (push! (mut parts)
                          (if (and (.known f)
                                   (not empty)
                                   (not (= (.op k) (OLit)))
                                   (not (= (.op k) (OClass))))
                              `(and ~(byte-test (bytes-of-first f)) ~code)
                              code))))
               `(let [c (rt/peek (mut p))] (or ~@parts))))
    ;; A repetition of single bytes is a loop over bytes, with nothing to save and put back.
    (OStar []
           (match (byte-set-of g (get (.kids e) 0) 0)
             (Some [b]
                   `(do
                      (while (let [c (rt/peek (mut p))] ~(byte-test b))
                        (rt/advance! (mut p) 1))
                      true))
             (None []
                   `(let [(mut go) true]
                      (while go
                        (let [s (.pos p)]
                          (unless (and ~(lex-code g (mut c) (get (.kids e) 0))
                                       (> (.pos p) s))
                            (set! go false))))
                      true))))
    (OPlus []
           (match (byte-set-of g (get (.kids e) 0) 0)
             (Some [b]
                   `(if (let [c (rt/peek (mut p))] ~(byte-test b))
                        (do
                          (rt/advance! (mut p) 1)
                          (while (let [c (rt/peek (mut p))] ~(byte-test b))
                            (rt/advance! (mut p) 1))
                          true)
                        false))
             (None []
                   `(if ~(lex-code g (mut c) (get (.kids e) 0))
                        (let [(mut go) true]
                          (while go
                            (let [s (.pos p)]
                              (unless (and ~(lex-code g
                                                      (mut c)
                                                      (get (.kids e) 0))
                                           (> (.pos p) s))
                                (set! go false))))
                          true)
                        false))))
    (OOpt []
          `(do ~(lex-code g (mut c) (get (.kids e) 0)) true))
    (ONot []
          `(let [s (.pos p)
                 hit ~(lex-code g (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             (not hit)))
    (OAnd []
          `(let [s (.pos p)
                 hit ~(lex-code g (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             hit))
    (OEof [] `(rt/eof? (mut p)))
    (OBof [] `(= (.pos p) 0))
    (OLineStart [] `(rt/at-line-start? (mut p)))
    (_ (dsl/die (mut c)
                (.tok e)
                "this item is not allowed in a token or fragment"))))

;; ---------------------------------------------------------------- recognisers

;;; `X*` with nothing captured. A step that consumes nothing ends it.
(defn rec-star [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE)] (-> Code)
  `(let [(mut go) true]
     (while go
       (let [from (.pos p)]
         (unless (and ~(rec-code (mut g) (mut c) inner) (> (.pos p) from))
           (set! (.pos p) from)
           (set! go false))))
     true))

;;; `X,+` with nothing captured: at least one, then a comma before each more, and one may trail.
(defn rec-sep [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE)] (-> Code)
  `(if ~(rec-code (mut g) (mut c) inner)
       (let [(mut go) true]
         (while go
           (let [from (.pos p)]
             (unless (and (comma! (mut p)) ~(rec-code (mut g) (mut c) inner))
               (set! (.pos p) from)
               (set! go false))))
         (comma! (mut p))
         true)
       false))

;;; A bool expression over rules, for lookaheads and hidden rules: nothing captured.
(defn rec-code [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (.op e)
    (OLit [] `(~(lit-sym (lit-id (mut g) (.text e))) (mut p)))
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (cond (= k (DHidden)) `(~(hidden-sym (.text e)) (mut p))
                  (= k (DFragment))
                    `(do (skip! (mut p)) (~(lex-sym (.text e)) (mut p)))
                  :else
                    `(match (~(rule-sym (.text e)) (mut p))
                       (Some [_] true)
                       (None [] false)))))
    (OSeq []
          (let [(mut parts) (primitive/code-list-new)]
            (for k (.kids e) (push! (mut parts) (rec-code (mut g) (mut c) k)))
            `(let [s (.pos p)]
               (if (and ~@parts true) true (do (set! (.pos p) s) false)))))
    (OChoice []
             (let [(mut parts) (primitive/code-list-new)]
               (for k (.kids e)
                 (push! (mut parts) (rec-code (mut g) (mut c) k)))
               `(or ~@parts)))
    (OOpt [] `(do ~(rec-code (mut g) (mut c) (get (.kids e) 0)) true))
    (OStar [] (rec-star (mut g) (mut c) (get (.kids e) 0)))
    (OPlus []
           (let [once (rec-code (mut g) (mut c) (get (.kids e) 0))]
             `(and ~once
                   (do ~(rec-star (mut g) (mut c) (get (.kids e) 0)) true))))
    (OSepStar [] `(do ~(rec-sep (mut g) (mut c) (get (.kids e) 0)) true))
    (OSepPlus [] (rec-sep (mut g) (mut c) (get (.kids e) 0)))
    (OWith []
           `(let [old (.flags p)]
              (set! (.flags p)
                    (rt/apply-flags old
                                    ~(flag-mask (.on e))
                                    ~(flag-mask (.off e))))
              (let [r ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
                (set! (.flags p) old)
                r)))
    (ONot []
          `(let [s (.pos p)
                 hit ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             (not hit)))
    (OAnd []
          `(let [s (.pos p)
                 hit ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             hit))
    (OEof [] `(skip-peek? (mut p)))
    (ONl [] `(newline-ahead? (mut p)))
    (ONoNl [] `(not (newline-ahead? (mut p))))
    (OIf [] `(rt/flag? (mut p) ~(flag-sym (.text e))))
    (OUnless [] `(not (rt/flag? (mut p) ~(flag-sym (.text e)))))
    (_ (dsl/die (mut c)
                (.tok e)
                "this item is not allowed in a lookahead or hidden rule"))))

;; ---------------------------------------------------------------- parsing code

(defn flag-mask [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut parts) (primitive/code-list-new)]
    (for n names (push! (mut parts) (flag-sym n)))
    `(| 0 0 ~@parts)))

(defn none-fail [] (-> Code)
  `(None [Node]))

;;; A generated function for `X?`: at most one capture, and never fails.
(defn emit-opt! [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE)] (-> Code)
  (let [id (fresh-aux! (mut g))
        n (count-captures g (mut c) inner)
        name (aux-sym id)]
    (when (> n 1)
      (dsl/die (mut c)
               (.tok inner)
               "an optional group may capture at most one thing"))
    (let [tail (if (= n 1) `(Some c0) `(Some (flag-node)))
          body (seq-code (mut g) (mut c) (seq-items inner) 0 0 tail)]
      (add-aux! (mut g)
                `(defn ~name [(p (mut rt/P))] (-> (Option Node))
                   (let [s (.pos p)]
                     (match ~body
                       (Some [v] (Some v))
                       (None []
                             (set! (.pos p) s)
                             (Some (none-node)))))))
      `(~name (mut p)))))

;;; The call producing a capture, always (Option Node). Repetitions need a helper
;;; for what they repeat, so their inner item must be a plain reference.
(defn capture-call [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (.op e)
    (ORef [] `(~(rule-sym (.text e)) (mut p)))
    (OKeep [] (capture-call (mut g) (mut c) (get (.kids e) 0)))
    (OWith []
           `(let [old (.flags p)]
              (set! (.flags p)
                    (rt/apply-flags old
                                    ~(flag-mask (.on e))
                                    ~(flag-mask (.off e))))
              (let [r ~(capture-call (mut g) (mut c) (get (.kids e) 0))]
                (set! (.flags p) old)
                r)))
    (OOpt [] (emit-opt! (mut g) (mut c) (get (.kids e) 0)))
    (OStar [] `(~(rep-sym (rep-name! (mut g) (mut c) e)) (mut p)))
    (OPlus [] `(~(rep1-sym (rep-name! (mut g) (mut c) e)) (mut p)))
    (OSepStar [] `(~(sep-sym (rep-name! (mut g) (mut c) e)) (mut p)))
    (OSepPlus [] `(~(sep1-sym (rep-name! (mut g) (mut c) e)) (mut p)))
    (_ (dsl/die (mut c) (.tok e) "this item cannot capture"))))

(defn rep-name! [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (let [inner (get (.kids e) 0)]
    (unless (= (.op inner) (ORef))
      (dsl/die (mut c)
               (.tok e)
               "a repetition needs a plain rule name; give the group a rule"))
    (add-unique! (mut (.reps g)) (.text inner))
    (.text inner)))

;;; Items i.. of a sequence, nested, ending in `tail`.
(defn seq-code [(g (mut Grammar))
                (c (mut dsl/Cur))
                (items (ArrayList PE))
                (i i64)
                (cap i64)
                (tail Code)] (-> Code)
  (if (>= i (len items))
      tail
      (let [e (get items i)]
        (if (captures? g (mut c) e)
            (let [call (capture-call (mut g) (mut c) e)]
              `(match ~call
                 (Some [~(cap-sym cap)]
                       ~(seq-code (mut g) (mut c) items (+ i 1) (+ cap 1) tail))
                 (None [] ~(none-fail))))
            `(if ~(rec-code (mut g) (mut c) e)
                 ~(seq-code (mut g) (mut c) items (+ i 1) cap tail)
                 ~(none-fail))))))

;;; All items matched: build the node, or pass the one capture through.
(defn alt-tail [(g Grammar) (c (mut dsl/Cur)) (a Alt) (extra i64)] (-> Code)
  (if (= (len (.label a)) 0)
      `(Some c0)
      (let [(mut pushes) (primitive/code-list-new)
            total (+ (count-captures g (mut c) (.seq a)) extra)]
        (for i (range 0 total)
          (push! (mut pushes) `(push! (mut kids) ~(cap-sym i))))
        `(let [(mut kids) (new-kids)]
           ;; The node's children are counted here already: one allocation, no growing.
           (reserve! (mut kids) ~total)
           ~@pushes
           (Some (mk (~(kind-sym (.label a))) kids lo (.pos p)))))))

(defn emit-alt-fn! [(g (mut Grammar))
                    (c (mut dsl/Cur))
                    (name (slice u8))
                    (i i64)
                    (a Alt)
                    (extra i64)] (-> void)
  (let [tail (alt-tail g (mut c) a extra)
        body (seq-code (mut g) (mut c) (seq-items (.seq a)) 0 extra tail)]
    (add-aux! (mut g)
              (if (> extra 0)
                  `(defn ~(alt-sym name i) [(c0 Node) (p (mut rt/P))]
                     (-> (Option Node))
                     (let [lo (.lo c0)] ~body))
                  `(defn ~(alt-sym name i) [(p (mut rt/P))] (-> (Option Node))
                     (let [lo (token-start (mut p))] ~body))))))

;;; Try alternatives in order, restoring the position after each failure.
(defn try-alts [(name (slice u8)) (i i64) (total i64) (base bool)] (-> Code)
  (if (>= i total)
      (none-fail)
      `(match ~(if base
                   `(~(alt-sym name i) acc (mut p))
                   `(~(alt-sym name i) (mut p)))
         (Some [r] (Some r))
         (None []
               (set! (.pos p) save)
               ~(try-alts name (+ i 1) total base)))))

(defn emit-rule-fn! [(g (mut Grammar)) (d Decl) (body Code)] (-> void)
  (if (.memo d)
      (let [id (.memo-count g)]
        (set! (.memo-count g) (+ id 1))
        (add-aux! (mut g)
                  `(defn ~(impl-sym (.name d)) [(p (mut rt/P))]
                     (-> (Option Node))
                     ~body))
        (add-aux! (mut g)
                  `(defn ~(rule-sym (.name d)) [(p (mut rt/P))]
                     (-> (Option Node))
                     (let [key (rt/memo-key (mut p))]
                       (match (rt/memo-get (mut p) ~id key)
                         (Some [hit]
                               (set! (.pos p) (.end hit))
                               (if (.ok hit)
                                   (Some (load (cast (ptr Node) (.node hit))))
                                   (None [Node])))
                         (None []
                               (let [r (~(impl-sym (.name d)) (mut p))]
                                 (match r
                                   (Some [n]
                                         (rt/memo-put! (mut p)
                                                       ~id
                                                       key
                                                       (rt/MemoHit
                                                         :ok true
                                                         :end (.pos p)
                                                         :node (box-node n))))
                                   (None []
                                         (rt/memo-put! (mut p)
                                                       ~id
                                                       key
                                                       (rt/MemoHit
                                                         :ok false
                                                         :end (.pos p)
                                                         :node 0))))
                                 r)))))))
      (add-aux! (mut g)
                `(defn ~(rule-sym (.name d)) [(p (mut rt/P))] (-> (Option Node))
                   ~body))))

(defn emit-rule! [(g (mut Grammar))
                  (c (mut dsl/Cur))
                  (d Decl)
                  (memo (mut FirstMemo))] (-> void)
  (for i (range 0 (len (.alts d)))
    (emit-alt-fn! (mut g) (mut c) (.name d) i (get (.alts d) i) 0))
  (let [(mut guards) (ArrayList::new [Code] (malloc-allocator))
        (mut guarded) (ArrayList::new [bool] (malloc-allocator))
        (mut any) false]
    (for a (.alts d)
      (let [s (pe-start g (.seq a) (mut memo))
            known (and (.known (.bytes s)) (not (.empty s)))]
        (push! (mut guards) (if known (byte-test (.bytes s)) `true))
        (push! (mut guarded) known)
        (when known (set! any true))))
    (emit-rule-fn! (mut g)
                   d
                   (if any
                       `(let [save (.pos p)
                              c (next-byte (mut p))]
                          ~(guarded-alts (.name d) guards guarded 0))
                       `(let [save (.pos p)]
                          ~(try-alts (.name d) 0 (len (.alts d)) false))))))

;;; Alternatives in order, each tried only when the next token's first byte is one it can begin with.
(defn guarded-alts [(name (slice u8))
                    (guards (ArrayList Code))
                    (guarded (ArrayList bool))
                    (i i64)] (-> Code)
  (if (>= i (len guards))
      (none-fail)
      (let [g (get guards i)
            call
              (if (get guarded i)
                  `(if (or ~g (.careful p))
                       (~(alt-sym name i) (mut p))
                       (None [Node]))
                  `(~(alt-sym name i) (mut p)))]
        `(match ~call
           (Some [r] (Some r))
           (None []
                 (set! (.pos p) save)
                 ~(guarded-alts name guards guarded (+ i 1)))))))

;;; A base, then alternatives that extend it: repeatedly, or at most once.
(defn emit-chain! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl) (repeat bool)]
  (-> void)
  (for i (range 0 (len (.alts d)))
    (emit-alt-fn! (mut g) (mut c) (.name d) i (get (.alts d) i) 1))
  (let [step (try-alts (.name d) 0 (len (.alts d)) true)]
    (emit-rule-fn! (mut g)
                   d
                   (if repeat
                       `(match (~(rule-sym (.over d)) (mut p))
                          (None [] (None [Node]))
                          (Some [first]
                                (let [(mut acc) first
                                      (mut go) true]
                                  (while go
                                    (let [save (.pos p)]
                                      (match ~step
                                        (Some [r] (set! acc r))
                                        (None []
                                              (set! (.pos p) save)
                                              (set! go false)))))
                                  (Some acc))))
                       `(match (~(rule-sym (.over d)) (mut p))
                          (None [] (None [Node]))
                          (Some [acc]
                                (let [save (.pos p)]
                                  (match ~step
                                    (Some [r] (Some r))
                                    (None [] (set! (.pos p) save) (Some acc))))))))))

(defn infix-level-sym [(name (slice u8)) (level i64)] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" name "-level") level))

(defn next-level-sym [(d Decl) (level i64) (top i64)] (-> Code)
  (if (= level top)
      (rule-sym (.over d))
      (infix-level-sym (.name d) (+ level 1))))

;;; `acc op next` while operators at this level keep matching.
;;; The loop of one level, as a function that takes what is already on the left.
(defn infix-rest-sym [(name (slice u8)) (level i64)] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" name "-rest") level))

;;; After a dropped operator the left side is finished, so operators tighter than this level may
;;; follow it, as in `a as T + b`. Every tighter loop gets its chance, tightest first.
(defn climb-code [(d Decl) (level i64) (at i64) (inner Code)] (-> Code)
  (if (<= at level)
      inner
      (climb-code d
                  level
                  (- at 1)
                  `(~(infix-rest-sym (.name d) at) (mut p) ~inner))))

(defn drop-arms [(g (mut Grammar))
                 (c (mut dsl/Cur))
                 (d Decl)
                 (i i64)
                 (level i64)
                 (top i64)] (-> Code)
  (cond (>= i (len (.drops d))) `(set! go false)
        (!= (.level (get (.drops d) i)) level)
          (drop-arms (mut g) (mut c) d (+ i 1) level top)
        :else
          (let [dr (get (.drops d) i)
                flag
                  (if (> (len (.flag dr)) 0)
                      `(rt/flag? (mut p) ~(flag-sym (.flag dr)))
                      `true)
                nonl (if (.nonl dr) `(not (newline-ahead? (mut p))) `true)]
            `(if (and ~flag
                      ~nonl
                      (~(lit-sym (lit-id (mut g) (.lit dr))) (mut p))
                      (~(hidden-sym (.rule dr)) (mut p)))
                 (set! acc ~(climb-code d level top `acc))
                 (do
                   (set! (.pos p) save)
                   ~(drop-arms (mut g) (mut c) d (+ i 1) level top))))))

(defn infix-arms [(g (mut Grammar))
                  (c (mut dsl/Cur))
                  (d Decl)
                  (i i64)
                  (level i64)
                  (top i64)] (-> Code)
  (cond (>= i (len (.ops d))) (drop-arms (mut g) (mut c) d 0 level top)
        (!= (.level (get (.ops d) i)) level)
          (infix-arms (mut g) (mut c) d (+ i 1) level top)
        :else
          (let [op (get (.ops d) i)
                test `(~(lit-sym (lit-id (mut g) (.lit op))) (mut p))
                guarded
                  (if (> (len (.unless-flag op)) 0)
                      `(and (not (rt/flag? (mut p)
                                           ~(flag-sym (.unless-flag op))))
                            ~test)
                      test)]
            `(if ~guarded
                 (match (~(next-level-sym d level top) (mut p))
                   (Some [r] (set! acc (node2 (~(kind-sym (.kind op))) acc r)))
                   (None [] (set! (.pos p) save) (set! go false)))
                 ~(infix-arms (mut g) (mut c) d (+ i 1) level top)))))

(defn emit-infix! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl)] (-> void)
  (let [(mut top) 0]
    (for op (.ops d) (when (> (.level op) top) (set! top (.level op))))
    (for level (range 0 (+ top 1))
      (add-aux! (mut g)
                `(defn ~(infix-rest-sym (.name d) level) [(p (mut rt/P))
                                                          (first Node)]
                   (-> Node)
                   (let [(mut acc) first
                         (mut go) true]
                     (while go
                       (let [save (.pos p)]
                         ~(infix-arms (mut g) (mut c) d 0 level top)))
                     acc)))
      (add-aux! (mut g)
                `(defn ~(infix-level-sym (.name d) level) [(p (mut rt/P))]
                   (-> (Option Node))
                   (match (~(next-level-sym d level top) (mut p))
                     (None [] (None [Node]))
                     (Some [first]
                           (Some (~(infix-rest-sym (.name d) level) (mut p)
                                    first)))))))
    (add-aux! (mut g)
              `(defn ~(rule-sym (.name d)) [(p (mut rt/P))] (-> (Option Node))
                 (~(infix-level-sym (.name d) 0) (mut p))))))

(defn emit-reps! [(g (mut Grammar))] (-> void)
  (for n (.reps g)
    (add-aux! (mut g)
              `(defn ~(rep-sym n) [(p (mut rt/P))] (-> (Option Node))
                 (let [(mut kids) (new-kids)
                       (mut go) true
                       lo (.pos p)]
                   (while go
                     (let [save (.pos p)]
                       (match (~(rule-sym n) (mut p))
                         (Some [v] (push! (mut kids) v))
                         (None [] (set! (.pos p) save) (set! go false)))))
                   (Some (mk (KList) kids lo (.pos p))))))
    (add-aux! (mut g)
              `(defn ~(rep1-sym n) [(p (mut rt/P))] (-> (Option Node))
                 (match (~(rep-sym n) (mut p))
                   (Some [l] (if (> (len (.kids l)) 0) (Some l) (None [Node])))
                   (None [] (None [Node])))))
    ;; X,* : zero or more, trailing comma allowed.
    (add-aux! (mut g)
              `(defn ~(sep-sym n) [(p (mut rt/P))] (-> (Option Node))
                 (let [(mut kids) (new-kids)
                       (mut go) true
                       lo (.pos p)]
                   (while go
                     (let [save (.pos p)]
                       (match (~(rule-sym n) (mut p))
                         (Some [v]
                               (push! (mut kids) v)
                               (unless (comma! (mut p)) (set! go false)))
                         (None [] (set! (.pos p) save) (set! go false)))))
                   (Some (mk (KList) kids lo (.pos p))))))
    ;; X,+ : one or more, no trailing comma.
    (add-aux! (mut g)
              `(defn ~(sep1-sym n) [(p (mut rt/P))] (-> (Option Node))
                 (let [lo (.pos p)]
                   (match (~(rule-sym n) (mut p))
                     (None [] (None [Node]))
                     (Some [v]
                           (let [(mut kids) (new-kids)
                                 (mut go) true]
                             (push! (mut kids) v)
                             (while go
                               (let [save (.pos p)]
                                 (if (comma! (mut p))
                                     (match (~(rule-sym n) (mut p))
                                       (Some [w] (push! (mut kids) w))
                                       (None []
                                             (set! (.pos p) save)
                                             (set! go false)))
                                     (set! go false))))
                             (Some (mk (KList) kids lo (.pos p)))))))))))

(defn emit-token! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl)] (-> void)
  (add-aux! (mut g)
            `(defn ~(lex-sym (.name d)) [(p (mut rt/P))] (-> bool)
               ~(lex-code g (mut c) (.body d))))
  (when (= (.kind d) (DToken))
    (add-aux! (mut g)
              `(defn ~(rule-sym (.name d)) [(p (mut rt/P))] (-> (Option Node))
                 (let [before (.pos p)]
                   ~(if (.raw d) `0 `(skip! (mut p)))
                   (let [start (.pos p)]
                     (if (~(lex-sym (.name d)) (mut p))
                         (Some (leaf (~(kind-sym (.name d)))
                                     (rt/span (mut p) start (.pos p))
                                     start
                                     (.pos p)))
                         (do
                           (rt/note-fail! (mut p) ~(.name d))
                           (set! (.pos p) before)
                           (None [Node])))))))))

(defn emit-hidden! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl)] (-> void)
  (add-aux! (mut g)
            `(defn ~(hidden-sym (.name d)) [(p (mut rt/P))] (-> bool)
               (let [s (.pos p)]
                 (if ~(rec-code (mut g) (mut c) (.body d))
                     true
                     (do (set! (.pos p) s) false))))))

;;; The bytes a punctuation literal may not stand before (`notbefore`), or "".
(defn not-before-of [(g Grammar) (text (slice u8))] (-> (slice u8))
  (let [(mut out) ""]
    (for i (range 0 (/ (len (.not-before g)) 2))
      (when (= (get (.not-before g) (* 2 i)) text)
        (set! out (get (.not-before g) (+ (* 2 i) 1)))))
    out))

;;; A word literal may not run into the next character; punctuation may not be a
;;; prefix of a longer literal that also matches here, nor stand before the bytes `notbefore`
;;; says it may not (where the longer literal is no token, this one may be).
(defn emit-lit! [(g (mut Grammar)) (l Lit)] (-> void)
  (let [(mut guards) (primitive/code-list-new)
        own-stop (not-before-of g (.text l))]
    (when (> (len own-stop) 0)
      (push! (mut guards) `(not (rt/followed-by-any? (mut p) ~(len (.text l)) ~own-stop))))
    (if (word-literal? (.text l))
        (push! (mut guards)
               `(let [e (.pos p)
                      more
                        (do
                          (rt/advance! (mut p) ~(len (.text l)))
                          (~(lex-sym (.word g)) (mut p)))]
                  (set! (.pos p) e)
                  (not more)))
        (for other (.lits g)
          (when (and (> (len (.text other)) (len (.text l)))
                     (not (word-literal? (.text other)))
                     (rt/at? (.text other) 0 (.text l)))
            (let [stop (not-before-of g (.text other))]
              (if (> (len stop) 0)
                  (push! (mut guards)
                         `(not (and (rt/at-bytes? (mut p) ~(.text other))
                                    (not (rt/followed-by-any? (mut p) ~(len (.text other)) ~stop)))))
                  (push! (mut guards) `(not (rt/at-bytes? (mut p) ~(.text other)))))))))
    (add-aux! (mut g)
              `(defn ~(lit-sym (.id l)) [(p (mut rt/P))] (-> bool)
                 (let [s (.pos p)]
                   (skip! (mut p))
                   (if (and ~(bytes-test (.text l)) ~@guards true)
                       (do (rt/advance! (mut p) ~(len (.text l))) true)
                       (do
                         (rt/note-fail! (mut p) ~(.text l))
                         (set! (.pos p) s)
                         false)))))))

;; ---------------------------------------------------------------- printing code

;;; The rule a capture refers to, through `with` and `~`.
(defn captured-ref [(e PE)] (-> (slice u8))
  (match (.op e)
    (ORef [] (.text e))
    (OWith [] (captured-ref (get (.kids e) 0)))
    (OKeep [] (captured-ref (get (.kids e) 0)))
    (_ "")))

;;; The precedence a position naming this rule requires. A rule outside the chain
;;; that only passes something through, like `Arg = … | Assign`, requires what it
;;; passes through, or `f((a, b))` would lose its parentheses.
(defn rule-level [(g Grammar)
                  (levels (ArrayList Named))
                  (name (slice u8))
                  (depth i64)] (-> i64)
  (let [(mut out) (named-value levels name)]
    (when (and (= out 0) (< depth 16))
      (match (find-decl g name)
        (Some [d]
              (when (= (.kind d) (DRule))
                (for a (.alts d)
                  (when (= (len (.label a)) 0)
                    (for it (seq-items (.seq a))
                      (let [r (captured-ref it)]
                        (when (> (len r) 0)
                          (let [l (rule-level g levels r (+ depth 1))]
                            (when (> l out) (set! out l))))))))))
        (None [] 0)))
    out))

(defn level-of-item [(g Grammar) (levels (ArrayList Named)) (name (slice u8))]
  (-> i64)
  (rule-level g levels name 0))

;;; The literal the hidden rule prints, if any.
(defn print-ref [(g Grammar)
                 (levels (ArrayList Named))
                 (name (slice u8))
                 (source Code)
                 (keep bool)] (-> Code)
  (if keep
      `(print-keep ~source (mut w))
      `(print-at ~source ~(level-of-item g levels name) (mut w))))

;;; Print `items`, drawing captures from `(get (.kids n) k)` from index `cap` on.
;;; A `!` guard just before a capture parenthesises output that would start that way.
(defn print-items [(g Grammar)
                   (c (mut dsl/Cur))
                   (levels (ArrayList Named))
                   (items (ArrayList PE))
                   (cap i64)
                   (single bool)] (-> Code)
  (let [(mut body) (primitive/code-list-new)
        (mut k) cap
        (mut guard) (None [PE])]
    (for e items
      (let [source (if single `o `(get (.kids n) ~k))
            printed (print-item g (mut c) levels e source)]
        (match (.op e)
          (ONot [] (set! guard (Some e)))
          (_ (if (captures? g (mut c) e)
                 (do
                   (match guard
                     (Some [ge]
                           (push! (mut body) (guarded g (mut c) ge printed))
                           (set! guard (None [PE])))
                     (None [] (push! (mut body) printed)))
                   (set! k (+ k 1)))
                 (push! (mut body) printed))))))
    `(do ~@body)))

(defn guarded [(g Grammar) (c (mut dsl/Cur)) (ge PE) (printed Code)] (-> Code)
  (let [(mut lits) (empty-strs)
        (mut tests) (primitive/code-list-new)]
    (guard-lits! (get (.kids ge) 0) (mut lits))
    (for l lits
      (push! (mut tests)
             (if (word-literal? l)
                 `(rt/w-starts-word? (mut w) mark ~l)
                 `(rt/w-starts? (mut w) mark ~l))))
    (if (= (len lits) 0)
        printed
        `(let [mark (rt/w-mark! (mut w))]
           ~printed
           (when (or ~@tests)
             (rt/w-wrap! (mut w) mark ~(.group-open g) ~(.group-close g)))))))

(defn print-item [(g Grammar)
                  (c (mut dsl/Cur))
                  (levels (ArrayList Named))
                  (e PE)
                  (source Code)] (-> Code)
  (match (.op e)
    (OLit [] `(rt/tok! (mut w) ~(.text e)))
    (ORef []
          (match (find-decl g (.text e))
            (Some [d]
                  (cond (= (.kind d) (DHidden))
                          (cond (.print-soft d)
                                  `(rt/soft-semi! (mut w) ~(.print-text d))
                                (> (len (.print-text d)) 0)
                                  `(rt/tok! (mut w) ~(.print-text d))
                                :else `0)
                        (= (.kind d) (DFragment)) `0
                        :else (print-ref g levels (.text e) source false)))
            (None [] `0)))
    (OKeep []
           (let [inner (get (.kids e) 0)]
             (print-ref g levels (.text inner) source true)))
    (OWith []
           (let [inner (print-item g (mut c) levels (get (.kids e) 0) source)
                 (mut on) false
                 (mut off) false]
             (for f (.keep-under g)
               (when (contains? (.on e) f) (set! on true))
               (when (contains? (.off e) f) (set! off true)))
             (cond on
                     `(let [old (.keep w)]
                        (set! (.keep w) (+ old 1))
                        ~inner
                        (set! (.keep w) old))
                   off
                     `(let [old (.keep w)]
                        (set! (.keep w) 0)
                        ~inner
                        (set! (.keep w) old))
                   :else inner)))
    (OStar [] (print-rep g levels e source false))
    (OPlus [] (print-rep g levels e source false))
    (OSepStar [] (print-rep g levels e source true))
    (OSepPlus [] (print-rep g levels e source true))
    (OOpt []
          (let [inner (get (.kids e) 0)]
            `(let [o ~source]
               (unless (= (.kind o) (KNone))
                 ~(print-items g (mut c) levels (seq-items inner) 0 true)))))
    (_ `0)))

(defn print-rep [(g Grammar)
                 (levels (ArrayList Named))
                 (e PE)
                 (source Code)
                 (commas bool)] (-> Code)
  (let [name (.text (get (.kids e) 0))
        min (level-of-item g levels name)]
    (if commas
        `(let [items (.kids ~source)]
           (for i (range 0 (len items))
             (when (> i 0) (rt/tok! (mut w) ","))
             (print-at (get items i) ~min (mut w))))
        `(for (ref each) (.kids ~source)
           (print-at each ~min (mut w))))))

(defn print-arm [(g Grammar)
                 (c (mut dsl/Cur))
                 (levels (ArrayList Named))
                 (k KindDef)] (-> Code)
  (match (.print k)
    (PLeaf []
           `(~(kind-sym (.name k)) [] (rt/leaf-tok! (mut w) (.text n) (.lo n))))
    (POp [op]
         `(~(kind-sym (.name k)) []
             (do
               (print-operand (.kind n) (get (.kids n) 0) ~(.level k) (mut w))
               (rt/tok! (mut w) ~(.lit op))
               (print-operand (.kind n)
                              (get (.kids n) 1)
                              ~(+ (.level k) 1)
                              (mut w)))))
    (PAlt [a base-min]
          (let [items (seq-items (.seq a))
                is-chain (> (.arity k) (count-captures g (mut c) (.seq a)))]
            (if is-chain
                `(~(kind-sym (.name k)) []
                    (do
                      (print-at (get (.kids n) 0) ~base-min (mut w))
                      ~(print-items g (mut c) levels items 1 false)))
                `(~(kind-sym (.name k)) []
                    ~(print-items g (mut c) levels items 0 false)))))))

;; ---------------------------------------------------------------- first bytes

;;; The bytes `e` can start with. True when `e` can also match nothing, so what follows it
;;; counts too. A negated class gives up: `known` goes false.
(defstruct First [(ranges (ArrayList Range)) (known bool)])

;;; A set of bytes, as 256 bits, for what a rule's next token may begin with. `known` false: anything.
(defstruct Bytes [(w0 i64) (w1 i64) (w2 i64) (w3 i64) (known bool)])

(defn bytes-none [] (-> Bytes)
  (Bytes
    :w0 0
    :w1 0
    :w2 0
    :w3 0
    :known true))

(defn bytes-union [(a Bytes) (b Bytes)] (-> Bytes)
  (Bytes
    :w0 (| (.w0 a) (.w0 b))
    :w1 (| (.w1 a) (.w1 b))
    :w2 (| (.w2 a) (.w2 b))
    :w3 (| (.w3 a) (.w3 b))
    :known (and (.known a) (.known b))))

(defn bytes-of-first [(f First)] (-> Bytes)
  (let [(mut out) (bytes-none)]
    (set! (.known out) (.known f))
    (for r (.ranges f)
      (for b (range (.lo r) (+ (.hi r) 1))
        (when (and (>= b 0) (< b 256))
          (let [bit (<< 1 (% b 64))]
            (cond (< b 64) (set! (.w0 out) (| (.w0 out) bit))
                  (< b 128) (set! (.w1 out) (| (.w1 out) bit))
                  (< b 192) (set! (.w2 out) (| (.w2 out) bit))
                  :else (set! (.w3 out) (| (.w3 out) bit)))))))
    out))

;;; A set's bytes as runs.
(defn bytes-ranges [(b Bytes)] (-> (ArrayList Range))
  (let [(mut out) (ArrayList::new [Range] (malloc-allocator))]
    (for x (range 0 256)
      (let [w
              (cond (< x 64) (.w0 b)
                    (< x 128) (.w1 b)
                    (< x 192) (.w2 b)
                    :else (.w3 b))]
        (when (!= (& (>> w (% x 64)) 1) 0)
          (if (and (> (len out) 0) (= (.hi (get out (- (len out) 1))) (- x 1)))
              (let [last (get out (- (len out) 1))]
                (set! (mut out) (- (len out) 1) (Range :lo (.lo last) :hi x)))
              (push! (mut out) (Range :lo x :hi x))))))
    out))

;;; A bool over `c`, the byte: is it in the set? A few runs are compared; more, looked up.
(defn byte-test [(b Bytes)] (-> Code)
  (let [rs (bytes-ranges b)]
    (if (<= (len rs) 3)
        (let [(mut tests) (primitive/code-list-new)]
          (for r rs
            (if (= (.lo r) (.hi r))
                (push! (mut tests) `(= c ~(.lo r)))
                (push! (mut tests) `(and (>= c ~(.lo r)) (<= c ~(.hi r))))))
          `(or ~@tests false))
        (byte-test-set b))))

(defn byte-test-set [(b Bytes)] (-> Code)
  (let [w0 (.w0 b)
        w1 (.w1 b)
        w2 (.w2 b)
        w3 (.w3 b)]
    `(rt/byte-in? c ~w0 ~w1 ~w2 ~w3)))

;;; What a reference begins with, and whether it can match nothing.
(defstruct Start [(bytes Bytes) (empty bool)])

;;; Each rule's start, worked out once for the grammar. A rule met again while its own is being
;;; worked out is a cycle: unknown.
(defstruct FirstMemo
  [(names (ArrayList (slice u8)))
   (starts (ArrayList Start))
   (busy (ArrayList (slice u8)))])

(defn first-memo-new [] (-> FirstMemo)
  (FirstMemo
    :names (ArrayList::new [(slice u8)] (malloc-allocator))
    :starts (ArrayList::new [Start] (malloc-allocator))
    :busy (ArrayList::new [(slice u8)] (malloc-allocator))))

(defn unknown-start [] (-> Start)
  (Start
    :bytes
      (Bytes
        :w0 0
        :w1 0
        :w2 0
        :w3 0
        :known false)
    :empty false))

(defn lexical-start [(g Grammar) (body PE)] (-> Start)
  (let [(mut f)
          (First
            :ranges (ArrayList::new [Range] (malloc-allocator))
            :known true)
        empty (first-of! g body (mut f) 0)]
    (Start :bytes (bytes-of-first f) :empty empty)))

;;; The bytes the next token can begin with when a rule matches, space skipped first.
(defn rule-start [(g Grammar) (name (slice u8)) (m (mut FirstMemo))] (-> Start)
  (let [(mut at) -1]
    (for i (range 0 (len (.names m)))
      (when (= (get (.names m) i) name) (set! at i)))
    (cond (>= at 0) (get (.starts m) at)
          (contains? (.busy m) name) (unknown-start)
          :else
            (match (find-decl g name)
              (None [] (unknown-start))
              (Some [d]
                    (push! (mut (.busy m)) name)
                    (let [s
                            (cond (= (.kind d) (DFragment))
                                    (lexical-start g (.body d))
                                  (and (= (.kind d) (DToken)) (not (.raw d)))
                                    (lexical-start g (.body d))
                                  (= (.kind d) (DHidden))
                                    (pe-start g (.body d) (mut m))
                                  (= (.kind d) (DRule))
                                    (let [(mut acc)
                                            (Start
                                              :bytes (bytes-none)
                                              :empty false)]
                                      (for a (.alts d)
                                        (let [s1 (pe-start g (.seq a) (mut m))]
                                          (set! acc
                                                (Start
                                                  :bytes
                                                    (bytes-union (.bytes acc)
                                                                 (.bytes s1))
                                                  :empty
                                                    (or (.empty acc)
                                                        (.empty s1))))))
                                      acc)
                                  (and (= (.kind d) (DPostfix))
                                       (> (len (.over d)) 0))
                                    (rule-start g (.over d) (mut m))
                                  :else (unknown-start))]
                      (pop! (mut (.busy m)))
                      (push! (mut (.names m)) name)
                      (push! (mut (.starts m)) s)
                      s))))))

(defn seq-start [(a Start) (b Start)] (-> Start)
  (if (.empty a)
      (Start :bytes (bytes-union (.bytes a) (.bytes b)) :empty (.empty b))
      a))

(defn maybe [(s Start)] (-> Start)
  (Start :bytes (.bytes s) :empty true))

(defn zero-width [] (-> Start)
  (Start :bytes (bytes-none) :empty true))

;;; The same for a parsing expression of a rule.
(defn pe-start [(g Grammar) (e PE) (m (mut FirstMemo))] (-> Start)
  (match (.op e)
    (OLit []
          (let [(mut f)
                  (First
                    :ranges (ArrayList::new [Range] (malloc-allocator))
                    :known true)
                b (cast i64 (get (.text e) 0))]
            (push! (mut (.ranges f)) (Range :lo b :hi b))
            (Start :bytes (bytes-of-first f) :empty false)))
    (ORef [] (rule-start g (.text e) (mut m)))
    (OSeq []
          (let [(mut acc) (zero-width)]
            (for k (.kids e)
              (when (.empty acc)
                (set! acc (seq-start acc (pe-start g k (mut m))))))
            acc))
    (OChoice []
             (let [(mut acc) (Start :bytes (bytes-none) :empty false)]
               (for k (.kids e)
                 (let [s (pe-start g k (mut m))]
                   (set! acc
                         (Start
                           :bytes (bytes-union (.bytes acc) (.bytes s))
                           :empty (or (.empty acc) (.empty s))))))
               acc))
    (OStar [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OOpt [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OSepStar [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OPlus [] (pe-start g (get (.kids e) 0) (mut m)))
    (OSepPlus [] (pe-start g (get (.kids e) 0) (mut m)))
    (OWith [] (pe-start g (get (.kids e) 0) (mut m)))
    (OKeep [] (pe-start g (get (.kids e) 0) (mut m)))
    ;; Zero width: what follows decides.
    (OIf [] (zero-width))
    (OUnless [] (zero-width))
    (ONot [] (zero-width))
    (OAnd [] (zero-width))
    (ONl [] (zero-width))
    (ONoNl [] (zero-width))
    (OEof [] (zero-width))
    (OBof [] (zero-width))
    (OLineStart [] (zero-width))
    (_ (unknown-start))))

(defn first-of! [(g Grammar) (e PE) (f (mut First)) (depth i64)] (-> bool)
  (match (.op e)
    (OLit []
          (let [b (cast i64 (get (.text e) 0))]
            (push! (mut (.ranges f)) (Range :lo b :hi b))
            false))
    (OClass []
            (do
              (for r (.ranges (class-ranges e)) (push! (mut (.ranges f)) r))
              false))
    (OAny [] (set! (.known f) false) false)
    (ORef []
          (if (> depth 16)
              (do (set! (.known f) false) false)
              (match (find-decl g (.text e))
                (Some [d] (first-of! g (.body d) (mut f) (+ depth 1)))
                (None [] (set! (.known f) false) false))))
    (OSeq []
          (let [(mut empty) true]
            (for k (.kids e)
              (when empty (set! empty (first-of! g k (mut f) depth))))
            empty))
    (OChoice []
             (let [(mut empty) false]
               (for k (.kids e)
                 (when (first-of! g k (mut f) depth) (set! empty true)))
               empty))
    (OStar [] (first-of! g (get (.kids e) 0) (mut f) depth) true)
    (OOpt [] (first-of! g (get (.kids e) 0) (mut f) depth) true)
    (OPlus [] (first-of! g (get (.kids e) 0) (mut f) depth))
    ;; Zero width: they consume nothing, so what follows decides.
    (ONot [] true)
    (OAnd [] true)
    (OBof [] true)
    (OLineStart [] true)
    (OEof [] true)
    (_ (set! (.known f) false) false)))

;;; A bool over `c`: could a space begin here?
(defn space-start-test [(g (mut Grammar)) (cu (mut dsl/Cur))] (-> Code)
  (match (find-decl g (.space g))
    (None []
          (dsl/die (mut cu) (dsl/peek (mut cu)) "the grammar has no space rule"))
    (Some [d]
          (let [(mut f)
                  (First
                    :ranges (ArrayList::new [Range] (malloc-allocator))
                    :known true)
                (mut tests) (primitive/code-list-new)]
            (first-of! g (.body d) (mut f) 0)
            (if (.known f)
                (do
                  (for r (.ranges f)
                    (if (= (.lo r) (.hi r))
                        (push! (mut tests) `(= c ~(.lo r)))
                        (push! (mut tests)
                               `(and (>= c ~(.lo r)) (<= c ~(.hi r))))))
                  `(or ~@tests))
                `true)))))

;; ---------------------------------------------------------------- the module

;;; Written parentheses are dropped where precedence does not need them. A grammar
;;; with no `group` has no such node, so the arm is absent.
(defn group-arm [(g Grammar)] (-> Code)
  (if (= (len (.group-kind g)) 0)
      `()
      `((~(kind-sym (.group-kind g)) []
           (let [inner (get (.kids n) 0)]
             (if (and (= (.keep w) 0)
                      (>= (kind-level (.kind inner)) min)
                      (not (opaque-spine? inner)))
                 (print-at inner min (mut w))
                 (print-node n (mut w))))))))

;;; (match k (KA [] true) … (_ false)) for the nomix group from index `from` to `to`.
(defn nomix-test [(g Grammar) (from i64) (to i64)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for i (range from to)
      (push! (mut arms) `(~(kind-sym (get (.nomix g) i)) [] true)))
    `(match k ~@arms (_ false))))

(defn forbid-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for name (.keep-forbid g)
      (push! (mut arms) `(~(kind-sym name) [] true)))
    `(match (.kind n) ~@arms (_ false))))

;;; Under a kept flag, an operator that flag disables needs parentheses:
;;; `for (x = ("a" in b);;)`.
(defn flagged-op-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for d (.decls g)
      (for op (.ops d)
        (when (contains? (.keep-under g) (.unless-flag op))
          (push! (mut arms) `(~(kind-sym (.kind op)) [] true)))))
    `(match (.kind n) ~@arms (_ false))))

(defn opaque-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for name (.opaque g)
      (push! (mut arms) `(~(kind-sym name) [] true)))
    `(match (.kind n) ~@arms (_ false))))

(defn emit-module! [(g (mut Grammar))
                    (c (mut dsl/Cur))
                    (levels (ArrayList Named))] (-> Code)
  (let [(mut variants) (primitive/code-list-new)
        (mut table) (primitive/code-list-new)
        (mut arms) (primitive/code-list-new)
        (mut level-arms) (primitive/code-list-new)
        (mut flag-consts) (primitive/code-list-new)
        (mut tag-arms) (primitive/code-list-new)
        (mut name-arms) (primitive/code-list-new)
        (mut kinds-made) (primitive/code-list-new)
        (mut tag) 0
        (mut bit) 1]
    (for f (.flags g)
      (push! (mut flag-consts) `(const ~(flag-sym f) ~bit))
      (set! bit (* bit 2)))
    (for k (.kinds g)
      (push! (mut tag-arms) `(~(kind-sym (.name k)) [] ~tag))
      (push! (mut name-arms) `(~(kind-sym (.name k)) [] ~(.name k)))
      (push! (mut kinds-made) `(push! (mut ks) (~(kind-sym (.name k)))))
      (set! tag (+ tag 1))
      (push! (mut variants) `(~(kind-sym (.name k)) []))
      (push! (mut table) `(~(.name k) ~(.arity k)))
      (push! (mut arms) (print-arm g (mut c) levels k))
      (when (< (.level k) (no-level))
        (push! (mut level-arms) `(~(kind-sym (.name k)) [] ~(.level k)))))
    (push! (mut tag-arms) `(KList [] ~tag))
    (push! (mut tag-arms) `(KNone [] ~(+ tag 1)))
    (push! (mut tag-arms) `(KFlag [] ~(+ tag 2)))
    (push! (mut name-arms) `(KList [] "List"))
    (push! (mut name-arms) `(KNone [] "None"))
    (push! (mut name-arms) `(KFlag [] "Flag"))
    `(do
       (import "coil.alloc" :use [malloc-allocator box!])
       (import "coil.arraylist" :use [ArrayList])
       (import "hl.rt" :as rt)
       (import "coil.primitive" :as primitive)
       (import "hl.quote" :as hq)

       ~@flag-consts

       (defsum Kind ~@variants (KList []) (KNone []) (KFlag []))
       ;; Not `derive`: it cannot see a type declared by the same macro expansion, and a
       ;; grammar may be expanded by a macro when a reader needs its parser.
       (defn kind-tag :inline (Always) [(k Kind)] (-> i64)
         (match k ~@tag-arms))
       (impl Eq Kind
         (= [(a Kind) (b Kind)] (-> bool)
           (= (kind-tag a) (kind-tag b))))
       (defn kind-name [(k Kind)] (-> (slice u8))
         (match k ~@name-arms))
       ;; Each kind by its tag, made once: what a node read from the cache has.
       (defstruct KindTable [(ready bool) (kinds (ArrayList Kind))])
       (defn kind-of-tag [(i i64)] (-> Kind)
         (let [t (primitive/alloc-static KindTable)]
           (unless (.ready t)
             (let [(mut ks) (ArrayList::new [Kind] (malloc-allocator))]
               ~@kinds-made
               (push! (mut ks) (KList))
               (push! (mut ks) (KNone))
               (push! (mut ks) (KFlag))
               (set! (.kinds t) ks)
               (set! (.ready t) true)))
           (when (or (< i 0) (>= i (len (.kinds t))))
             (panic "a node in the cache has kind {}, which this grammar has not"
                    i))
           (get (.kinds t) i)))
       (defstruct Node
         [(kind Kind)
          (text (slice u8))
          (kids (ArrayList Node))
          (lo i64)
          (hi i64)
          (gen i64)])

       (defn node-table [] (-> Code)
         (quasiquote (~@table ("List" -1) ("None" 0) ("Flag" 0))))

       ;;; Whether two trees are the same: kinds, text, places and children. Children in one
       ;;; buffer are the same without a look inside, so a tree compared with itself, or with one
       ;;; that kept its unchanged subtrees, costs little.
       (defn node-same? [(a Node) (b Node)] (-> bool)
         (and (= (.kind a) (.kind b))
              (= (.lo a) (.lo b))
              (= (.hi a) (.hi b))
              (= (.text a) (.text b))
              (= (len (.kids a)) (len (.kids b)))
              (or (= (primitive/cast i64 (data (slice (.kids a))))
                     (primitive/cast i64 (data (slice (.kids b)))))
                  (block :same
                    (for i (range 0 (len (.kids a)))
                      (unless (node-same? (get (.kids a) i) (get (.kids b) i))
                        (return-from :same false)))
                    true))))
       ;;; A tree's identity, as text: its kind, place and text, and where its children are. Trees
       ;;; are never changed and their memory never reused, so the same identity is the same tree.
       (defn node-key [(n Node)] (-> (slice u8))
         (rt/node-identity (kind-tag (.kind n))
                           (.lo n)
                           (.hi n)
                           (.text n)
                           (primitive/cast i64 (data (slice (.kids n))))
                           (len (.kids n))))
       (defn new-kids [] (-> (ArrayList Node))
         (ArrayList::new [Node] (rt/tree-allocator)))
       ;;; Room for `n` kids from the start: a template knows how many it adds.
       (defn new-kids-sized [(n i64)] (-> (ArrayList Node))
         (let [(mut kids) (ArrayList::new [Node] (rt/tree-allocator))]
           (when (> n 0) (ArrayList::reserve! (mut kids) n))
           kids))
       (defn mk [(k Kind) (kids (ArrayList Node)) (lo i64) (hi i64)] (-> Node)
         (Node
           :kind k
           :text ""
           :kids kids
           :lo lo
           :hi hi
           :gen 0))
       ;;; Whether two nodes are one value: every field the same, children and text by where they are.
       (defn same-node? [(a Node) (b Node)] (-> bool)
         (and (= (.kind a) (.kind b))
              (= (.lo a) (.lo b))
              (= (.hi a) (.hi b))
              (= (.gen a) (.gen b))
              (= (len (.kids a)) (len (.kids b)))
              (= (primitive/cast i64 (data (slice (.kids a))))
                 (primitive/cast i64 (data (slice (.kids b)))))
              (= (len (.text a)) (len (.text b)))
              (= (primitive/cast i64 (data (.text a)))
                 (primitive/cast i64 (data (.text b))))))
       ;;; A node for the cache (see the cache in hl.rt): its kind, text, children, place and stamp.
       ;;; A list of children is an object of the cache's, so a tree that shares children with
       ;;; another shares them after a load too, and `node-key` stays its identity.
       (defstruct NodeTables [(load i64)])
       ;; Its one cell, whose address tells this grammar's lists from others' as they are written.
       (defn node-tables [] (-> (ptr NodeTables))
         (primitive/alloc-static NodeTables))
       (defn node-encode! [(w (ptr rt/Writer)) (n Node)] (-> void)
         (rt/put-varint! w (kind-tag (.kind n)))
         (rt/put-text! w (.text n))
         (when (rt/put-object! w
                               (primitive/cast i64 (node-tables))
                               (primitive/cast i64 (data (slice (.kids n))))
                               (len (.kids n)))
           (rt/put-varint! w (len (.kids n)))
           (for c (.kids n) (node-encode! w c))
           (rt/put-object-end! w))
         (rt/put-int! w (.lo n))
         (rt/put-int! w (.hi n))
         (rt/put-int! w (.gen n))
         0)
       (defn node-decode [(r (ptr rt/Reader))] (-> Node)
         (let [kind (kind-of-tag (rt/take-varint r))
               text (rt/take-text r)
               kids (node-kids-decode r)
               lo (rt/take-int r)
               hi (rt/take-int r)
               g (rt/take-int r)]
           (Node
             :kind kind
             :text text
             :kids kids
             :lo lo
             :hi hi
             :gen g)))
       (defn node-kids-decode [(r (ptr rt/Reader))] (-> (ArrayList Node))
         (let [id (rt/take-object r)]
           (if (rt/object-ready? r id)
               (do
                 (rt/object-skip! r)
                 (load (cast (ptr (ArrayList Node)) (rt/object-value r id))))
               (do
                 (rt/object-enter! r)
                 (let [n (rt/take-varint r)
                       (mut kids) (new-kids)]
                   (reserve! (mut kids) n)
                   (for _ (range 0 n) (push! (mut kids) (node-decode r)))
                   (rt/object-leave! r
                                     (cast (ptr u8) (mut kids))
                                     (sizeof (ArrayList Node)))
                   (rt/writer-know! (primitive/cast i64 (node-tables))
                                    (primitive/cast i64 (data (slice kids)))
                                    (len kids)
                                    id)
                   kids)))))
       ;;; A copy of a node with another stamp; the node itself is untouched.
       (defn with-gen [(n Node) (g i64)] (-> Node)
         (let [(mut c) n] (set! (.gen c) g) c))
       (defn leaf [(k Kind) (text (slice u8)) (lo i64) (hi i64)] (-> Node)
         (Node
           :kind k
           :text text
           :kids (new-kids)
           :lo lo
           :hi hi
           :gen 0))
       ;;; The nodes of a list from `from` up to `to`.
       (defn sublist [(items (ArrayList Node)) (from i64) (to i64)]
         (-> (ArrayList Node))
         (let [(mut out) (new-kids)]
           (reserve! (mut out) (- to from))
           (for i (range from to) (push! (mut out) (get items i)))
           out))
       ;; The same children with the one at `at` replaced: `n with { name: v }` for a named child.
       (defn kids-with [(items (ArrayList Node)) (at i64) (v Node)]
         (-> (ArrayList Node))
         (let [(mut out) (new-kids)]
           (reserve! (mut out) (len items))
           (for i (range 0 (len items))
             (push! (mut out) (if (= i at) v (get items i))))
           out))
       (defn none-node [] (-> Node)
         (leaf (KNone) "" 0 0))
       (defn flag-node [] (-> Node)
         (leaf (KFlag) "" 0 0))
       (defn node2 [(k Kind) (a Node) (b Node)] (-> Node)
         (let [(mut kids) (new-kids)]
           (push! (mut kids) a)
           (push! (mut kids) b)
           (mk k kids (.lo a) (.hi b))))
       (defn box-node [(n Node)] (-> i64)
         (cast i64 (box! (rt/tree-allocator) Node n)))

       ;; Templates: source text in this grammar, read at compile time. `hl.quote` turns
       ;; the tree into code that builds it, for whichever grammar it came from.
       (defn quote-tree [(n Node)] (-> hq/QNode)
         (let [(mut kids) (ArrayList::new [hq/QNode] (malloc-allocator))]
           (for (ref k) (.kids n) (push! (mut kids) (quote-tree k)))
           (hq/QNode
             :kind (kind-name (.kind n))
             :text (.text n)
             :kids kids)))
       ;;; ALIAS is how the caller imported this grammar, PATH the children to descend
       ;;; to reach the form wanted, HOLES ((NAME VALUE SORT) …).
       (defn quote-template [(alias Code) (src Code) (path Code) (holes Code)]
         (-> Code)
         (match (parse-result (primitive/code-str src) "<template>" 0)
           (Err [e]
                (primitive/error (rt/join "this template does not parse: "
                                          (primitive/code-str src))))
           (Ok [tree]
               (let [(mut at) tree]
                 (for step path
                   (set! at (get (.kids at) (primitive/code-int step))))
                 (hq/expansion (quote-tree at) (primitive/code-str alias) holes)))))

       ;;; Most tokens have no space before them, and the grammar says which bytes could
       ;;; begin some: anything else needs no look at all.
       ;;; Space depends only on where it starts, so each run of it is scanned once. Most calls
       ;;; ask again about the space just skipped, and cost one comparison.
       (defn skip! :inline (Always) [(p (mut rt/P))] (-> void)
         (if (= (.ws-from p) (.pos p))
             (set! (.pos p) (.ws-to p))
             (skip-new! (mut p))))

       (defn skip-new! [(p (mut rt/P))] (-> void)
         (let [from (.pos p)
               c (rt/peek (mut p))]
           (if ~(space-start-test (mut g) (mut c))
               (let [known (rt/ws-known (mut p) from)]
                 (if (> known 0)
                     (do
                       (set! (.pos p) (+ from (- (/ known 2) 1)))
                       (set! (.ws-nl p) (= (% known 2) 1)))
                     (do
                       (set! (.ws-scan p) from)
                       (~(lex-sym (.space g)) (mut p))
                       (set! (.ws-nl p)
                             (and (> (.pos p) from)
                                  (rt/has-newline? (.src p) from (.pos p))))
                       (rt/ws-remember! (mut p) from (.pos p) (.ws-nl p)))))
               (set! (.ws-nl p) false))
           (set! (.ws-from p) from)
           (set! (.ws-to p) (.pos p))))

       ;;; Is there a line terminator between here and the next token?
       (defn newline-ahead? [(p (mut rt/P))] (-> bool)
         (let [s (.pos p)]
           (skip! (mut p))
           (set! (.pos p) s)
           (.ws-nl p)))

       (defn skip-peek? [(p (mut rt/P))] (-> bool)
         (let [s (.pos p)]
           (skip! (mut p))
           (let [at-end (rt/eof? (mut p))]
             (set! (.pos p) s)
             at-end)))

       ;;; The first byte of the next token, without consuming anything.
       (defn next-byte [(p (mut rt/P))] (-> i64)
         (let [s (.pos p)]
           (skip! (mut p))
           (let [b (rt/peek (mut p))]
             (set! (.pos p) s)
             b)))

       ;;; Where the next token begins, without consuming the space before it.
       (defn token-start [(p (mut rt/P))] (-> i64)
         (let [s (.pos p)]
           (skip! (mut p))
           (let [t (.pos p)]
             (set! (.pos p) s)
             t)))

       (defn comma! [(p (mut rt/P))] (-> bool)
         (~(lit-sym (lit-id (mut g) ",")) (mut p)))

       ~(primitive/code-symbol "@@AUX@@")

       (defn parse-result [(src (slice u8)) (path (slice u8)) (flags i64)]
         (-> (Result Node rt/ParseError))
         (parse-result-from src path flags 0))

       ;;; The program from `from` to the end of `src`, positions counted from the start of `src`.
       ;;; A program that does not parse is parsed again carefully, for the reason: first-byte guards
       ;;; skip alternatives that could not match, and a skipped one notes no failure.
       (defn parse-result-from [(src (slice u8))
                                (path (slice u8))
                                (flags i64)
                                (from i64)] (-> (Result Node rt/ParseError))
         (match (parse-attempt src path flags from false)
           (Ok [n] (Ok n))
           (Err [_] (parse-attempt src path flags from true))))

       (defn parse-attempt [(src (slice u8))
                            (path (slice u8))
                            (flags i64)
                            (from i64)
                            (careful bool)] (-> (Result Node rt/ParseError))
         ;; Asked by a computation working apart, the parse works in that computation's
         ;; storage: what it leaves behind goes with it, and the tree is copied out once.
         (if (rt/apart-open?)
             (parse-working src path flags from careful)
             (let [scratch (rt/scratch-enter!)
                   result (parse-working src path flags from careful)]
               (rt/region-leave!)
               (rt/own-begin!)
               (let [out (parse-owned-result scratch result)]
                 (rt/own-end!)
                 (rt/scratch-dispose! scratch)
                 out))))

       (defn parse-working [(src (slice u8)) (path (slice u8)) (flags i64)
                            (from i64) (careful bool)] (-> (Result Node rt/ParseError))
         (let [(mut p) (rt/p-new src path flags ~(.memo-count g) from)
               _ (set! (.careful p) careful)
               result
                 (match (~(rule-sym (.start g)) (mut p))
                   (Some [n]
                         (skip! (mut p))
                         (if (rt/eof? (mut p))
                             (Ok n)
                             (do
                               (rt/note-fail! (mut p) "end of input")
                               (Err (rt/parse-error (mut p))))))
                   (None [] (Err (rt/parse-error (mut p)))))]
           (rt/p-free! (mut p))
           result))

       (defn parse-owned-result [(scratch (ptr rt/Region)) (result (Result Node rt/ParseError))]
         (-> (Result Node rt/ParseError))
         (match result
           (Ok [n] (Ok (node-own-in scratch n)))
           (Err [e] (Err (rt/ParseError :path (rt/text-copy (.path e))
                                      :line (.line e) :col (.col e)
                                      :want (rt/text-copy (.want e))
                                      :found (rt/text-copy (.found e)))))))

       ;;; A tree out of scratch storage (see "values out of scratch storage" in hl.rt): its own
       ;;; copy of each node made there, sharing every subtree and text made outside it. Only the
       ;;; accepted tree survives parsing, and its texts are still the source's; failed
       ;;; alternatives and packrat results go with the scratch storage.
       (defn node-own-in [(from (ptr rt/Region)) (n Node)] (-> Node)
         (if (rt/storage-in? from (primitive/cast i64 (data (slice (.kids n)))) (cap (.kids n)))
             (let [storage (primitive/cast i64 (data (slice (.kids n))))
                   seen (rt/own-seen storage)
                   kids
                     (if (and (!= (primitive/cast i64 seen) 0)
                              (= (len (load (primitive/cast (ptr (ArrayList Node)) seen))) (len (.kids n))))
                         (load (primitive/cast (ptr (ArrayList Node)) seen))
                         (let [(mut made) (new-kids)]
                           (reserve! (mut made) (len (.kids n)))
                           (for child (.kids n) (push! (mut made) (node-own-in from child)))
                           (rt/own-keep! storage (primitive/cast (ptr u8) (mut made)) (sizeof (ArrayList Node)))
                           made))]
               (Node :kind (.kind n) :text (rt/text-own-in from (.text n)) :kids kids
                     :lo (.lo n) :hi (.hi n) :gen (.gen n)))
             (Node :kind (.kind n) :text (rt/text-own-in from (.text n)) :kids (.kids n)
                   :lo (.lo n) :hi (.hi n) :gen (.gen n))))

       ;;; Parse a whole file. Syntax errors stop the program with file:line:col.
       (defn parse [(src (slice u8)) (path (slice u8))] (-> Node)
         (match (parse-result src path 0)
           (Ok [n] n)
           (Err [e] (rt/parse-failed e))))

       ;;; Parse under `base`, trying again with `more` too if that fails. Errors are the first try's.
       (defn parse-tries [(src (slice u8))
                          (path (slice u8))
                          (base i64)
                          (more i64)] (-> Node)
         (match (parse-result src path base)
           (Ok [t] t)
           (Err [first]
                (match (parse-attempt src path (| base more) 0 false)
                  (Ok [t] t)
                  (Err [_] (rt/parse-failed first))))))

       ;;; Parse under flags, or nothing, for tools that report failures themselves.
       (defn parse-opt [(src (slice u8)) (path (slice u8)) (flags i64)]
         (-> (Option Node))
         (match (parse-result src path flags)
           (Ok [t] (Some t))
           (Err [e] (set! (.last (rt/last-parse-error)) e) (None [Node]))))

       ;;; A piece of a program: the statements from `from` to the end of `src`, or nothing when
       ;;; they are not a program by themselves.
       (defn parse-piece [(src (slice u8))
                          (path (slice u8))
                          (flags i64)
                          (from i64)] (-> (Option Node))
         (match (parse-attempt src path flags from false)
           (Ok [t] (Some t))
           (Err [_] (None [Node]))))

       ;;; A flag's bit, by name.
       (defn flag-bit [(name (slice u8))] (-> i64)
         (cond ~@(flag-arms g) :else (panic "no flag named {}" name)))

       (defn kind-level [(k Kind)] (-> i64)
         (match k ~@level-arms (_ ~(no-level))))

       (defn opaque-kind? [(n Node)] (-> bool)
         ~(opaque-test g))

       ;;; Parentheses around this must stay: an opaque kind, at or under its base.
       (defn opaque-spine? [(n Node)] (-> bool)
         (cond (opaque-kind? n) true
               (and (> (len (.kids n)) 0)
                    (< (kind-level (.kind n)) ~(no-level)))
                 (opaque-spine? (get (.kids n) 0))
               :else false))

       ;;; Print with this much precedence required: redundant written parentheses
       ;;; go, missing ones appear.
       (defn print-at [(n Node) (min i64) (w (mut rt/W))] (-> void)
         (match (.kind n)
           ~@(group-arm g)
           (_ (if (or (< (kind-level (.kind n)) min)
                      (and (> (.keep w) 0) ~(flagged-op-test g)))
                  (do
                    (rt/tok! (mut w) ~(.group-open g))
                    (print-node n (mut w))
                    (rt/tok! (mut w) ~(.group-close g)))
                  (print-node n (mut w))))))

       (defn nomix-first? [(k Kind)] (-> bool)
         ~(nomix-test g 0 (if (> (len (.nomix g)) 0) 1 0)))
       (defn nomix-rest? [(k Kind)] (-> bool)
         ~(nomix-test g (if (> (len (.nomix g)) 0) 1 0) (len (.nomix g))))

       ;;; An operand, with parentheses when the grammar forbids these two side by side.
       (defn print-operand [(parent Kind) (n Node) (min i64) (w (mut rt/W))]
         (-> void)
         (if (or (and (nomix-first? parent) (nomix-rest? (.kind n)))
                 (and (nomix-rest? parent) (nomix-first? (.kind n))))
             (do
               (rt/tok! (mut w) ~(.group-open g))
               (print-node n (mut w))
               (rt/tok! (mut w) ~(.group-close g)))
             (print-at n min (mut w))))

       ;;; A forbidden kind on the left spine: `new (a())` needs its parentheses even
       ;;; when a rewrite removed them.
       (defn forbidden-spine? [(n Node)] (-> bool)
         (cond ~(forbid-test g) true
               (and (> (len (.kids n)) 0)
                    (< (kind-level (.kind n)) ~(no-level)))
                 (forbidden-spine? (get (.kids n) 0))
               :else false))

       ;;; A `~X` child: written parentheses stay, and any it now needs appear.
       (defn print-keep [(n Node) (w (mut rt/W))] (-> void)
         (let [old (.keep w)]
           (set! (.keep w) (+ old 1))
           (if (or (forbidden-spine? n)
                   (< (kind-level (.kind n))
                      ~(named-value levels (.keep-min g))))
               (do
                 (rt/tok! (mut w) ~(.group-open g))
                 (print-node n (mut w))
                 (rt/tok! (mut w) ~(.group-close g)))
               (print-node n (mut w)))
           (set! (.keep w) old)))

       (defn print-node [(n Node) (w (mut rt/W))] (-> void)
         (rt/note-source! (mut w) (.lo n))
         (match (.kind n)
           ~@arms
           (KList []
                  (panic "a List node has no printed form outside a repetition"))
           (KNone [] 0)
           (KFlag [] 0)))

       ;;; Printed text and where each leaf landed, for source maps.
       (defn print-style [] (-> rt/PrintStyle)
         (let [(mut breaks) (ArrayList::new [(slice u8)] (malloc-allocator))]
           ~@(break-pushes g)
           (rt/print-style ~(.print-words g)
                           ~(.print-high g)
                           ~(.apart g)
                           ~(.apart-digits g)
                           ~(.soft-close g)
                           breaks)))

       (defn render-tracked [(n Node) (pretty bool) (tracking bool)]
         (-> rt/Rendered)
         (let [(mut w) (rt/w-new pretty (print-style))]
           (set! (.tracking w) tracking)
           (print-at n 0 (mut w))
           (rt/Rendered
             :text (rt/w-finish w)
             :marks (.marks w)
             :open (.pending w))))

       ;;; Printed text and where it passes from one source file to the next.
       (defn render-files [(n Node) (pretty bool)] (-> rt/Rendered)
         (let [(mut w) (rt/w-new pretty (print-style))]
           (set! (.tracking w) true)
           (set! (.by-file w) true)
           (print-at n 0 (mut w))
           (rt/Rendered
             :text (rt/w-finish w)
             :marks (.marks w)
             :open (.pending w))))

       ;;; Print into a writer the caller set up, for one that tracks leaf positions.
       (defn render-into [(n Node) (w (mut rt/W))] (-> void)
         (print-at n 0 (mut w)))

       ;;; The grammar printed back: `pretty` breaks lines, otherwise it is minimal.
       (defn render [(n Node) (pretty bool)] (-> (slice u8))
         (let [(mut w) (rt/w-new pretty (print-style))]
           (print-at n 0 (mut w))
           (rt/w-finish w))))))

;; ---------------------------------------------------------------- entry

(defn break-pushes [(g Grammar)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for b (.breaks g) (push! (mut out) `(push! (mut breaks) ~b)))
    `(~@out)))

(defn flag-arms [(g Grammar)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for f (.flags g)
      (push! (mut out) `(= name ~f))
      (push! (mut out) (flag-sym f)))
    `(~@out)))

(defstruct Loaded [(grammar Grammar) (cursor dsl/Cur)])

;;; One node a grammar declares: what another language checks itself against.
(defstruct KindEntry
  [(name (slice u8)) (arity i64) (leaf bool) (fields (ArrayList (slice u8)))])

;;; Every node of a grammar, for languages that read one without generating it.
(defn grammar-table [(source (slice u8)) (path (slice u8))]
  (-> (ArrayList KindEntry))
  (let [(mut l) (load-grammar source path)
        (mut out) (ArrayList::new [KindEntry] (malloc-allocator))]
    (for k (.kinds (.grammar l))
      (push! (mut out)
             (KindEntry
               :name (.name k)
               :arity (.arity k)
               :leaf (match (.print k) (PLeaf [] true) (_ false))
               :fields (.fields k))))
    (push! (mut out)
           (KindEntry
             :name "List"
             :arity -1
             :leaf false
             :fields (empty-strs)))
    (push! (mut out)
           (KindEntry
             :name "None"
             :arity 0
             :leaf false
             :fields (empty-strs)))
    (push! (mut out)
           (KindEntry
             :name "Flag"
             :arity 0
             :leaf false
             :fields (empty-strs)))
    out))

(defn load-grammar [(source (slice u8)) (path (slice u8))] (-> Loaded)
  (let [(mut c)
          (dsl/grammar-cursor source
                              path
                              "-> ,* ,+ = | ; * + ? ! & ~ ( ) . @ - ,")
        (mut g)
          (Grammar
            :start ""
            :space ""
            :word ""
            :print-words ""
            :print-high false
            :apart ""
            :apart-digits ""
            :soft-close ""
            :breaks (empty-strs)
            :flags (empty-strs)
            :keep-under (empty-strs)
            :group-open "("
            :group-close ")"
            :group-kind ""
            :opaque (empty-strs)
            :precedence (empty-strs)
            :keep-min ""
            :keep-forbid (empty-strs)
            :nomix (empty-strs)
            :not-before (empty-strs)
            :decls (ArrayList::new [Decl] (malloc-allocator))
            :kinds (ArrayList::new [KindDef] (malloc-allocator))
            :lits (ArrayList::new [Lit] (malloc-allocator))
            :reps (empty-strs)
            :memo-count 0
            :next-aux 0
            :aux (empty-strs)
            :path path)
        (mut go) true]
    (dsl/expect! (mut c) "syntax")
    (while go
      (cond (dsl/accept! (mut c) "start")
              (set! (.start g) (.text (dsl/name! (mut c) "a rule")))
            (dsl/accept! (mut c) "space")
              (set! (.space g) (.text (dsl/name! (mut c) "a fragment")))
            (dsl/accept! (mut c) "word")
              (set! (.word g) (.text (dsl/name! (mut c) "a fragment")))
            (dsl/accept! (mut c) "printwords")
              (do
                (set! (.print-words g)
                      (.text (dsl/string! (mut c) "the bytes of a word")))
                (while (not (dsl/accept! (mut c) ";"))
                  (dsl/expect! (mut c) "high")
                  (set! (.print-high g) true)))
            (dsl/accept! (mut c) "apart")
              (while (not (dsl/accept! (mut c) ";"))
                (set! (.apart g)
                      (dsl/join2 (.apart g)
                                 (.text (dsl/string! (mut c) "a byte")))))
            (dsl/accept! (mut c) "apartdigits")
              (while (not (dsl/accept! (mut c) ";"))
                (set! (.apart-digits g)
                      (dsl/join2 (.apart-digits g)
                                 (.text (dsl/string! (mut c) "a byte")))))
            (dsl/accept! (mut c) "softclose")
              (do
                (set! (.soft-close g) (.text (dsl/string! (mut c) "a token")))
                (dsl/expect! (mut c) ";"))
            (dsl/accept! (mut c) "breaks")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.breaks g))
                       (.text (dsl/string! (mut c) "a token"))))
            (dsl/accept! (mut c) "flags")
              (while (not (dsl/accept! (mut c) ";"))
                (let [t (dsl/name! (mut c) "a flag")]
                  (when (>= (len (.flags g)) 8)
                    (dsl/die (mut c)
                             t
                             "a grammar has at most 8 flags: the memo table's key has room for no more"))
                  (push! (mut (.flags g)) (.text t))))
            (dsl/accept! (mut c) "keep")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.keep-under g))
                       (.text (dsl/name! (mut c) "a flag"))))
            (dsl/accept! (mut c) "group")
              (let [o (dsl/string! (mut c) "an opening literal")
                    e (dsl/string! (mut c) "a closing literal")]
                (set! (.group-open g) (.text o))
                (set! (.group-close g) (.text e))
                (set! (.group-kind g)
                      (.text (dsl/name! (mut c) "the parenthesis node"))))
            ;; `~X` positions: what they require, and kinds that may not be on their spine.
            ;; The first operator may not sit directly beside any of the others, whatever
            ;; their precedence: `a ?? b || c` is a syntax error.
            (dsl/accept! (mut c) "nomix")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.nomix g)) (.text (dsl/name! (mut c) "a kind"))))
            ;; A literal that is no token before certain bytes: JavaScript's `?.` before a digit
            ;; is `?` and a number (`a?.5:b`).
            (dsl/accept! (mut c) "notbefore")
              (let [l (dsl/string! (mut c) "a punctuation literal")
                    bytes (dsl/string! (mut c) "the bytes it may not stand before")]
                (push! (mut (.not-before g)) (.text l))
                (push! (mut (.not-before g)) (.text bytes))
                (dsl/expect! (mut c) ";"))
            (dsl/accept! (mut c) "keeplevel")
              (set! (.keep-min g) (.text (dsl/name! (mut c) "a rule")))
            (dsl/accept! (mut c) "keepforbid")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.keep-forbid g))
                       (.text (dsl/name! (mut c) "a kind"))))
            (dsl/accept! (mut c) "opaque")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.opaque g)) (.text (dsl/name! (mut c) "a kind"))))
            (dsl/accept! (mut c) "precedence")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.precedence g))
                       (.text (dsl/name! (mut c) "a rule"))))
            :else (set! go false)))
    (while (not (dsl/eof? (mut c)))
      (push! (mut (.decls g)) (read-decl (mut c))))
    (analyse! (mut g) (mut c))
    (Loaded :grammar g :cursor c)))

(defn read-grammar [(source (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [l (load-grammar source path)
        (mut g) (.grammar l)
        (mut c) (.cursor l)
        (mut levels) (ArrayList::new [Named] (malloc-allocator))]
    (add-lit! (mut g) ",")
    (assign-levels! (mut g) (mut c) (mut levels))
    ;; Code generation order: bodies first, so literals and reps are all known.
    (let [(mut firsts) (first-memo-new)]
      (for d (.decls g)
        (let [k (.kind d)]
          (cond (or (= k (DFragment)) (= k (DToken)))
                  (emit-token! (mut g) (mut c) d)
                (= k (DHidden)) (emit-hidden! (mut g) (mut c) d)
                (= k (DRule)) (emit-rule! (mut g) (mut c) d (mut firsts))
                (= k (DPostfix)) (emit-chain! (mut g) (mut c) d true)
                (= k (DSuffix)) (emit-chain! (mut g) (mut c) d false)
                (= k (DInfix)) (emit-infix! (mut g) (mut c) d)
                :else 0))))
    (emit-reps! (mut g))
    (for l (.lits g) (emit-lit! (mut g) l))
    (let [shell (dsl/render (emit-module! (mut g) (mut c) levels))]
      (splice-aux shell (.aux g)))))

;;; The module's text with every generated function where the marker stands.
(defn splice-aux [(shell (slice u8)) (aux (ArrayList (slice u8)))]
  (-> (slice u8))
  (let [marker "@@AUX@@"
        (mut b) (str/StrBuf::new (malloc-allocator))
        (mut at) -1]
    (for i (range 0 (- (len shell) (len marker)))
      (when (and (< at 0) (rt/at? shell i marker)) (set! at i)))
    (when (< at 0) (panic "generated module is missing its marker"))
    (for i (range 0 at) (push! (mut (.bytes b)) (get shell i)))
    (for form aux
      (push-str! (mut b) form)
      (push-str! (mut b) "\n"))
    (for i (range (+ at (len marker)) (len shell))
      (push! (mut (.bytes b)) (get shell i)))
    (finish! (mut b))))

(defn read-syntax [(context Code)] (-> Code)
  (primitive/code-read (read-grammar (dsl/source-of context)
                                     (dsl/path-of context))
                       `(reader-config)))

;;; The same compiler as a generator, for grammars a reader must call at compile
;;; time: a provider image is built with no readers active, so it cannot import a
;;; .syntax module. An ordinary module expands a macro that calls this.
(defn define-from [(source (slice u8)) (path (slice u8))] (-> Code)
  (primitive/code-read (read-grammar source path) `(reader-config)))
