;;; `.syntax`: the parsing language. One grammar is the source of truth for the
;;; parser, the AST type, the printer, and a compile-time table of node shapes that
;;; other languages check themselves against.
;;;
;;; It is a scannerless PEG, because context decides what JavaScript's tokens are:
;;; a regex can only start where an expression can, so it needs no lexer mode.
;;;
;;;   syntax
;;;   start Program
;;;   space Space                   # skipped before every token in a `rule`
;;;   newline LineEnd               # one line terminator: what @nl, @nonl and @linestart look for
;;;   word IdPart                   # what may not follow a word literal
;;;   flags noin gen await          # parser state, set with `with(...)`
;;;   keep noin ;                   # parentheses stay as written under this flag
;;;   group "(" ")" Paren           # how the printer parenthesises
;;;   opaque OptMember Coalesce ;   # kinds whose parentheses are never removed
;;;   precedence Seq Assign Cond ;  # lowest first
;;;   printwords "abc_" high ;      # bytes of a word, for telling tokens apart; high: above ASCII too
;;;   apart "+" "+" ;               # these must not touch when printed
;;;   apartdigits "." ;             # this must not follow a token of only digits
;;;   softclose "}" ;               # a soft `;` is dropped before this
;;;   breaks ";" "{" "}" ;          # pretty output breaks the line after these
;;;
;;;   fragment Space = [ \n]* ;     # bytes, no node
;;;   token Ident = [a-z]+ ;        # bytes, a leaf node of that name
;;;   raw token Text = [^<]+ ;      # the same, but the space before it is part of it
;;;   rule Block = "{" Stmt* "}" -> Block | Other ;
;;;   memo rule Assign = … ;        # packrat this rule
;;;   hidden rule Semi prints soft ";" = ";" | &"}" | @eof | @nl ;
;;;   infix Binary over Unary  left "+" Add "-" Sub  left "*" Mul ;
;;;   infix B over U  left "<" Lt drop if(ts) @nonl "as" Type ; # the left stays, the right is
;;;                                 # matched and thrown away, and tighter operators may follow
;;;   postfix Call over New  "." PropName -> Member | Args -> Call ;  # loops
;;;   suffix Cond over Binary  "?" Assign ":" Assign -> Cond ;        # at most once
;;;   postfix Call over New  "!" ;  # an alternative with no label and no captures keeps the left
;;;
;;; Items in a rule: "lit", Name, X*, X+, X,* (optional trailing comma), X,+,
;;; X?, ( … )?, !X, &X, ~X (keep this child's parentheses), with(a -b) X, if(a),
;;; unless(a), @eof, @nl, @nonl. In a token or fragment: also [class] and `.`.
;;;
;;; `-> Label(a, b)` names the node's children, so other languages can write `n.a`; an infix
;;; operator's are `left` and `right`.
;;;
;;; An alternative with no `-> Label` has exactly one capture and passes it on.
;;; `X*` captures one List node, and `X?` captures its one capture or a None.
(module hl.syntax)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.str" :as str)
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)

(reader-provider "hl.syntax" read-syntax)

;; ---------------------------------------------------------------- the grammar

(defsum PEOp
  (OLit)
  (OClass)
  (OAny)
  (ORef)
  (OSeq)
  (OChoice)
  (OStar)
  (OPlus)
  (OOpt)
  (OSepStar)
  (OSepPlus)
  (ONot)
  (OAnd)
  (OKeep)
  (OWith)
  (OIf)
  (OUnless)
  (OEof)
  (OBof)
  (OLineStart)
  (ONl)
  (ONoNl))

(derive Eq PEOp)

(defstruct Range [(lo i64) (hi i64)])

;;; One parsing expression. `text` is a literal's bytes, a reference's name, or a
;;; flag's name; `on`/`off` are a `with`'s flag names.
(defstruct PE
  [(op PEOp)
   (text (slice u8))
   (kids (ArrayList PE))
   (ranges (ArrayList Range))
   (neg bool)
   (on (ArrayList (slice u8)))
   (off (ArrayList (slice u8)))
   (tok rt/Tok)])

(defstruct Alt [(seq PE) (label (slice u8)) (fields (ArrayList (slice u8)))])

(defstruct Op
  [(lit (slice u8))
   (kind (slice u8))
   (level i64)
   (unless-flag (slice u8))
   (tok rt/Tok)])

(defstruct Drop
  [(lit (slice u8))
   (level i64)
   (flag (slice u8))
   (nonl bool)
   (rule (slice u8))
   (tok rt/Tok)])

(defsum DeclKind
  (DFragment)
  (DToken)
  (DRule)
  (DHidden)
  (DInfix)
  (DPostfix)
  (DSuffix))

(derive Eq DeclKind)

(defstruct Decl
  [(kind DeclKind)
   (name (slice u8))
   (over (slice u8))
   (alts (ArrayList Alt))
   (ops (ArrayList Op))
   (drops (ArrayList Drop))
   (body PE)
   (memo bool)
   (print-soft bool)
   (print-text (slice u8))
   (raw bool)
   (tok rt/Tok)])

;;; What a kind prints as: an alternative, an operator, or a token's own bytes.
(defsum Print
  (PAlt [(alt Alt) (base-min i64)])
  (POp [(op Op)])
  (PLeaf []))

(defstruct KindDef
  [(name (slice u8))
   (arity i64)
   (level i64)
   (print Print)
   (fields (ArrayList (slice u8)))])

(defstruct Named [(name (slice u8)) (value i64)])

(defstruct Lit [(text (slice u8)) (id i64)])

(defstruct Grammar
  [(start (slice u8))
   (space (slice u8))
   (newline (slice u8))
   (word (slice u8))
   (flags (ArrayList (slice u8)))
   (print-words (slice u8))
   (print-high bool)
   (apart (slice u8))
   (apart-digits (slice u8))
   (soft-close (slice u8))
   (breaks (ArrayList (slice u8)))
   (keep-under (ArrayList (slice u8)))
   (group-open (slice u8))
   (group-close (slice u8))
   (group-kind (slice u8))
   (opaque (ArrayList (slice u8)))
   (precedence (ArrayList (slice u8)))
   (keep-min (slice u8))
   (keep-forbid (ArrayList (slice u8)))
   (nomix (ArrayList (slice u8)))
   ;; `notbefore "?." "0123456789"`: a punctuation literal that is no token before these bytes,
   ;; as a pair of texts each, literal then bytes.
   (not-before (ArrayList (slice u8)))
   (decls (ArrayList Decl))
   (kinds (ArrayList KindDef))
   (lits (ArrayList Lit))
   (reps (ArrayList (slice u8)))
   (memo-count i64)
   (next-aux i64)
   (aux (ArrayList (slice u8)))
   (path (slice u8))
   ;; Each rule's start, worked out once (see FirstMemo), for code made where none is passed.
   (firsts FirstMemo)
   ;; Whether the layout being made looks at the next token's first eight bytes.
   (plan-c2 bool)
   ;; What layouts ask of each alternative, worked out once (see AltInfo).
   (info-names (ArrayList (slice u8)))
   ;; The lists of chains whose operators-after function has been made (see `rests-code`).
   (rests-made (ArrayList (slice u8)))
   (infos (ArrayList (ArrayList AltInfo)))])

;;; A function, not a const: a const is lost when this runs from a top-level macro.
;;; See experiments/repros/h-const-in-provider.
(defn no-level [] (-> i64)
  1000000)

;; ---------------------------------------------------------------- reading

(defn empty-pes [] (-> (ArrayList PE))
  (ArrayList::new [PE] (rt/value-allocator)))

(defn empty-strs [] (-> (ArrayList (slice u8)))
  (ArrayList::new [(slice u8)] (rt/value-allocator)))

;;; An infix operator's two children.
(defn left-right [] (-> (ArrayList (slice u8)))
  (let [(mut out) (empty-strs)]
    (push! (mut out) "left")
    (push! (mut out) "right")
    out))

(defn pe-new [(op PEOp) (text (slice u8)) (tok rt/Tok)] (-> PE)
  (PE
    :op op
    :text text
    :kids (empty-pes)
    :ranges (ArrayList::new [Range] (rt/value-allocator))
    :neg false
    :on (empty-strs)
    :off (empty-strs)
    :tok tok))

(defn pe-wrap [(op PEOp) (inner PE) (tok rt/Tok)] (-> PE)
  (let [(mut out) (pe-new op "" tok)]
    (push! (mut (.kids out)) inner)
    out))

(defn hex-value [(c u8)] (-> i64)
  (cond (and (>= c #\0) (<= c #\9)) (- (cast i64 c) 48)
        (and (>= c #\a) (<= c #\f)) (+ (- (cast i64 c) 97) 10)
        (and (>= c #\A) (<= c #\F)) (+ (- (cast i64 c) 65) 10)
        :else -1))

(defn push-utf8! [(out (mut (ArrayList u8))) (cp i64)] (-> void)
  (cond (< cp 128) (push! (mut out) (cast u8 cp))
        (< cp 2048)
          (do
            (push! (mut out) (cast u8 (+ 192 (/ cp 64))))
            (push! (mut out) (cast u8 (+ 128 (% cp 64)))))
        :else
          (do
            (push! (mut out) (cast u8 (+ 224 (/ cp 4096))))
            (push! (mut out) (cast u8 (+ 128 (% (/ cp 64) 64))))
            (push! (mut out) (cast u8 (+ 128 (% cp 64)))))))

(defn hex-at [(c (mut dsl/Cur)) (t rt/Tok) (s (slice u8)) (at i64) (count i64)]
  (-> i64)
  (let [(mut v) 0]
    (for k (range 0 count)
      (let [d (if (< (+ at k) (len s)) (hex-value (get s (+ at k))) -1)]
        (when (< d 0) (dsl/die (mut c) t "bad hex escape"))
        (set! v (+ (* v 16) d))))
    v))

;;; How many source bytes the escape at `i` takes, and its value.
(defstruct Esc [(value i64) (size i64)])

(defn read-escape [(c (mut dsl/Cur)) (t rt/Tok) (s (slice u8)) (i i64)] (-> Esc)
  (when (>= (+ i 1) (len s)) (dsl/die (mut c) t "dangling backslash"))
  (let [e (get s (+ i 1))]
    (cond (= e #\n) (Esc :value 10 :size 2)
          (= e #\r) (Esc :value 13 :size 2)
          (= e #\t) (Esc :value 9 :size 2)
          (= e #\0) (Esc :value 0 :size 2)
          (= e #\x) (Esc :value (hex-at (mut c) t s (+ i 2) 2) :size 4)
          (= e #\u) (Esc :value (hex-at (mut c) t s (+ i 2) 4) :size 6)
          :else (Esc :value (cast i64 e) :size 2))))

;;; A string token's bytes with its escapes resolved; \u is UTF-8 encoded.
(defn decode-string [(c (mut dsl/Cur)) (t rt/Tok)] (-> (slice u8))
  (let [s (.text t)
        (mut out) (ArrayList::new [u8] (rt/value-allocator))
        (mut i) 0]
    (while (< i (len s))
      (if (= (get s i) #\\)
          (let [e (read-escape (mut c) t s i)]
            (push-utf8! (mut out) (.value e))
            (set! i (+ i (.size e))))
          (do (push! (mut out) (get s i)) (set! i (+ i 1)))))
    (slice out)))

;;; `[a-z_\n]` or `[^…]`. Values are bytes: \xHH names one directly.
(defn read-class [(c (mut dsl/Cur)) (t rt/Tok)] (-> PE)
  (let [s (.text t)
        (mut out) (pe-new (OClass) "" t)
        (mut i) 0
        (mut vals) (ArrayList::new [i64] (rt/value-allocator))]
    (when (and (> (len s) 0) (= (get s 0) #\^))
      (set! (.neg out) true)
      (set! i 1))
    (while (< i (len s))
      (let [lo
              (if (= (get s i) #\\)
                  (let [e (read-escape (mut c) t s i)]
                    (set! i (+ i (.size e)))
                    (.value e))
                  (let [v (cast i64 (get s i))]
                    (set! i (+ i 1))
                    v))]
        (if (and (< (+ i 1) (len s)) (= (get s i) #\-))
            (let [hi
                    (if (= (get s (+ i 1)) #\\)
                        (let [e (read-escape (mut c) t s (+ i 1))]
                          (set! i (+ i 1 (.size e)))
                          (.value e))
                        (let [v (cast i64 (get s (+ i 1)))]
                          (set! i (+ i 2))
                          v))]
              (push! (mut (.ranges out)) (Range :lo lo :hi hi)))
            (push! (mut (.ranges out)) (Range :lo lo :hi lo)))))
    out))

(defn read-with [(c (mut dsl/Cur)) (t rt/Tok)] (-> PE)
  (let [(mut out) (pe-new (OWith) "" t)]
    (dsl/expect! (mut c) "(")
    (while (not (dsl/accept! (mut c) ")"))
      (if (dsl/accept! (mut c) "-")
          (push! (mut (.off out)) (.text (dsl/name! (mut c) "a flag")))
          (push! (mut (.on out)) (.text (dsl/name! (mut c) "a flag")))))
    (push! (mut (.kids out)) (read-prefixed (mut c)))
    out))

(defn read-flag-test [(c (mut dsl/Cur)) (t rt/Tok) (op PEOp)] (-> PE)
  (dsl/expect! (mut c) "(")
  (let [n (dsl/name! (mut c) "a flag")]
    (dsl/expect! (mut c) ")")
    (pe-new op (.text n) t)))

(defn read-atom [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))]
    (cond (= (.kind t) (rt/TStr))
            (do
              (dsl/advance! (mut c))
              (pe-new (OLit) (decode-string (mut c) t) t))
          (= (.kind t) (rt/TClass))
            (do (dsl/advance! (mut c)) (read-class (mut c) t))
          (dsl/accept! (mut c) ".") (pe-new (OAny) "" t)
          (dsl/accept! (mut c) "(")
            (let [inner (read-choice (mut c))]
              (dsl/expect! (mut c) ")")
              inner)
          (= (.kind t) (rt/TIdent))
            (do (dsl/advance! (mut c)) (pe-new (ORef) (.text t) t))
          :else
            (dsl/die (mut c)
                     t
                     (dsl/join2 "expected a grammar item, found " (.text t))))))

(defn read-suffixed [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        a (read-atom (mut c))]
    (cond (dsl/accept! (mut c) "*") (pe-wrap (OStar) a t)
          (dsl/accept! (mut c) "+") (pe-wrap (OPlus) a t)
          (dsl/accept! (mut c) "?") (pe-wrap (OOpt) a t)
          (dsl/accept! (mut c) ",*") (pe-wrap (OSepStar) a t)
          (dsl/accept! (mut c) ",+") (pe-wrap (OSepPlus) a t)
          :else a)))

(defn read-prefixed [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))]
    (cond (dsl/accept! (mut c) "!") (pe-wrap (ONot) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "&") (pe-wrap (OAnd) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "~") (pe-wrap (OKeep) (read-prefixed (mut c)) t)
          (dsl/accept! (mut c) "@")
            (let [n (dsl/name! (mut c) "eof, nl or nonl")]
              (cond (= (.text n) "eof") (pe-new (OEof) "" t)
                    (= (.text n) "bof") (pe-new (OBof) "" t)
                    (= (.text n) "linestart") (pe-new (OLineStart) "" t)
                    (= (.text n) "nl") (pe-new (ONl) "" t)
                    (= (.text n) "nonl") (pe-new (ONoNl) "" t)
                    :else (dsl/die (mut c) n "expected @eof, @nl or @nonl")))
          (dsl/accept! (mut c) "with") (read-with (mut c) t)
          (dsl/accept! (mut c) "if") (read-flag-test (mut c) t (OIf))
          (dsl/accept! (mut c) "unless") (read-flag-test (mut c) t (OUnless))
          :else (read-suffixed (mut c)))))

(defn seq-end? [(c (mut dsl/Cur))] (-> bool)
  (or (dsl/at? (mut c) "|")
      (dsl/at? (mut c) ";")
      (dsl/at? (mut c) "->")
      (dsl/at? (mut c) ")")))

(defn read-seq [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        (mut out) (pe-new (OSeq) "" t)]
    (while (not (seq-end? (mut c)))
      (push! (mut (.kids out)) (read-prefixed (mut c))))
    (when (= (len (.kids out)) 0)
      (dsl/die (mut c) t "an empty sequence"))
    (if (= (len (.kids out)) 1) (get (.kids out) 0) out)))

(defn read-choice [(c (mut dsl/Cur))] (-> PE)
  (let [t (dsl/peek (mut c))
        first (read-seq (mut c))]
    (if (dsl/at? (mut c) "|")
        (let [(mut out) (pe-new (OChoice) "" t)]
          (push! (mut (.kids out)) first)
          (while (dsl/accept! (mut c) "|")
            (push! (mut (.kids out)) (read-seq (mut c))))
          out)
        first)))

;;; A child's name may have dashes, as names do in the languages that read it: `type-params`. The
;;; words and dashes must touch, or `a - b` would be one name.
(defn dashed-name [(c (mut dsl/Cur)) (first rt/Tok)] (-> (slice u8))
  (let [(mut name) (.text first)
        (mut end) (+ (.col first) (len (.text first)))
        (mut go) true]
    (while go
      (let [d (dsl/peek (mut c))]
        (if (and (dsl/at? (mut c) "-")
                 (= (.line d) (.line first))
                 (= (.col d) end))
            (do
              (dsl/advance! (mut c))
              (let [w (dsl/name! (mut c) "a word after the dash")]
                (unless (= (.col w) (+ end 1))
                  (dsl/die (mut c) w "a dashed name has no spaces"))
                (set! name (dsl/join3 name "-" (.text w)))
                (set! end (+ (.col w) (len (.text w))))))
            (set! go false))))
    name))

;;; `-> Label(a, b)`: names for the node's children, in order, after the `(`.
(defn read-field-names [(c (mut dsl/Cur))] (-> (ArrayList (slice u8)))
  (let [(mut out) (empty-strs)
        (mut go) (not (dsl/accept! (mut c) ")"))]
    (while go
      (let [t (dsl/name! (mut c) "a child's name")
            name (dashed-name (mut c) t)]
        (for x out
          (when (= x name)
            (dsl/die (mut c)
                     t
                     (dsl/join3 "the child name " name " is used twice"))))
        (push! (mut out) name))
      (unless (dsl/accept! (mut c) ",")
        (dsl/expect! (mut c) ")")
        (set! go false)))
    out))

;;; `seq -> Label`, with a `|` between alternatives and a `;` after the last.
(defn read-alts [(c (mut dsl/Cur))] (-> (ArrayList Alt))
  (let [(mut alts) (ArrayList::new [Alt] (rt/value-allocator))
        (mut go) true]
    (dsl/accept! (mut c) "|")
    (while go
      (let [s (read-seq (mut c))
            label
              (if (dsl/accept! (mut c) "->")
                  (.text (dsl/name! (mut c) "a node label"))
                  "")
            fields
              (if (and (> (len label) 0) (dsl/accept! (mut c) "("))
                  (read-field-names (mut c))
                  (empty-strs))]
        (push! (mut alts)
               (Alt
                 :seq s
                 :label label
                 :fields fields))
        (unless (dsl/accept! (mut c) "|") (set! go false))))
    (dsl/expect! (mut c) ";")
    alts))

(defn read-drop! [(c (mut dsl/Cur)) (d (mut Decl)) (level i64)] (-> void)
  (let [flag
          (if (dsl/accept! (mut c) "if")
              (.text (read-flag-test (mut c) (dsl/peek (mut c)) (OIf)))
              "")
        nonl
          (if (dsl/accept! (mut c) "@")
              (do (dsl/expect! (mut c) "nonl") true)
              false)
        lit (dsl/string! (mut c) "an operator literal")
        rule (dsl/name! (mut c) "a hidden rule")]
    (when (< level 0)
      (dsl/die (mut c) lit "an operator needs a `left` level before it"))
    (push! (mut (.drops d))
           (Drop
             :lit (decode-string (mut c) lit)
             :level level
             :flag flag
             :nonl nonl
             :rule (.text rule)
             :tok lit))))

(defn read-ops! [(c (mut dsl/Cur)) (d (mut Decl))] (-> void)
  (let [(mut level) -1]
    (while (not (dsl/accept! (mut c) ";"))
      (when (dsl/accept! (mut c) "left") (set! level (+ level 1)))
      (if (dsl/accept! (mut c) "drop")
          (read-drop! (mut c) (mut d) level)
          (let [flag
                  (if (dsl/accept! (mut c) "unless")
                      (.text (read-flag-test (mut c)
                                             (dsl/peek (mut c))
                                             (OUnless)))
                      "")
                lit (dsl/string! (mut c) "an operator literal")
                kind (dsl/name! (mut c) "a node label")]
            (when (< level 0)
              (dsl/die (mut c) lit "an operator needs a `left` level before it"))
            (push! (mut (.ops d))
                   (Op
                     :lit (decode-string (mut c) lit)
                     :kind (.text kind)
                     :level level
                     :unless-flag flag
                     :tok lit)))))))

(defn decl-new [(kind DeclKind) (name (slice u8)) (t rt/Tok)] (-> Decl)
  (Decl
    :kind kind
    :name name
    :over ""
    :alts (ArrayList::new [Alt] (rt/value-allocator))
    :ops (ArrayList::new [Op] (rt/value-allocator))
    :drops (ArrayList::new [Drop] (rt/value-allocator))
    :body (pe-new (OSeq) "" t)
    :memo false
    :print-soft false
    :print-text ""
    :raw false
    :tok t))

(defn read-decl [(c (mut dsl/Cur))] (-> Decl)
  (let [t (dsl/peek (mut c))
        memo (dsl/accept! (mut c) "memo")]
    (cond (dsl/accept! (mut c) "fragment")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DFragment) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "raw")
            (let [_ (dsl/expect! (mut c) "token")
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DToken) (.text n) n)]
              (set! (.raw d) true)
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "token")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DToken) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "hidden")
            (let [_ (dsl/expect! (mut c) "rule")
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DHidden) (.text n) n)]
              (when (dsl/accept! (mut c) "prints")
                (set! (.print-soft d) (dsl/accept! (mut c) "soft"))
                (let [s (dsl/string! (mut c) "the printed text")]
                  (set! (.print-text d) (decode-string (mut c) s))))
              (dsl/expect! (mut c) "=")
              (set! (.body d) (read-choice (mut c)))
              (dsl/expect! (mut c) ";")
              d)
          (dsl/accept! (mut c) "rule")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DRule) (.text n) n)]
              (dsl/expect! (mut c) "=")
              (set! (.alts d) (read-alts (mut c)))
              (set! (.memo d) memo)
              d)
          (dsl/accept! (mut c) "infix")
            (let [n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new (DInfix) (.text n) n)]
              (dsl/expect! (mut c) "over")
              (set! (.over d) (.text (dsl/name! (mut c) "a rule")))
              (read-ops! (mut c) (mut d))
              d)
          (or (dsl/at? (mut c) "postfix") (dsl/at? (mut c) "suffix"))
            (let [kind
                    (if (dsl/accept! (mut c) "postfix")
                        (DPostfix)
                        (do (dsl/expect! (mut c) "suffix") (DSuffix)))
                  n (dsl/name! (mut c) "a name")
                  (mut d) (decl-new kind (.text n) n)]
              (dsl/expect! (mut c) "over")
              (set! (.over d) (.text (dsl/name! (mut c) "a rule")))
              (set! (.alts d) (read-alts (mut c)))
              (set! (.memo d) memo)
              d)
          :else
            (dsl/die (mut c)
                     t
                     "expected fragment, token, rule, hidden, infix, postfix or suffix"))))

;; ---------------------------------------------------------------- analysis

(defn find-decl [(g Grammar) (n (slice u8))] (-> (Option Decl))
  (let [(mut out) (None [Decl])]
    (for d (.decls g) (when (= (.name d) n) (set! out (Some d))))
    out))

(defn contains? [(xs (ArrayList (slice u8))) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x xs (when (= x s) (set! hit true)))
    hit))

(defn add-unique! [(xs (mut (ArrayList (slice u8)))) (s (slice u8))] (-> void)
  (unless (contains? xs s) (push! (mut xs) s)))

(defn decl-kind-of [(g Grammar) (c (mut dsl/Cur)) (t rt/Tok) (n (slice u8))]
  (-> DeclKind)
  (match (find-decl g n)
    (Some [d] (.kind d))
    (None [] (dsl/die (mut c) t (dsl/join2 "no rule named " n)))))

;;; Does this item capture a child in a rule?
(defn captures? [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> bool)
  (match (.op e)
    (OLit [] false)
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (cond (= k (DHidden)) false
                  (= k (DFragment)) false
                  :else true)))
    (OStar [] true)
    (OPlus [] true)
    (OOpt [] true)
    (OSepStar [] true)
    (OSepPlus [] true)
    (OKeep [] (captures? g (mut c) (get (.kids e) 0)))
    (OWith [] (captures? g (mut c) (get (.kids e) 0)))
    (OChoice [] (no-captures-inside! g (mut c) e) false)
    (OSeq [] (no-captures-inside! g (mut c) e) false)
    (_ false)))

;;; A bare group is matched but yields nothing, so a capture inside it would vanish.
(defn no-captures-inside! [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> void)
  (for k (.kids e)
    (when (captures? g (mut c) k)
      (dsl/die (mut c)
               (.tok k)
               "this capture is inside a bare group and would be lost; give the group a rule"))))

(defn seq-items [(e PE)] (-> (ArrayList PE))
  (if (= (.op e) (OSeq))
      (.kids e)
      (let [(mut out) (empty-pes)]
        (push! (mut out) e)
        out)))

(defn count-captures [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> i64)
  (let [(mut n) 0]
    (for it (seq-items e) (when (captures? g (mut c) it) (set! n (+ n 1))))
    n))

;;; What must not begin a capture that a `!` guard protects: its literals.
(defn guard-lits! [(e PE) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.op e)
    (OLit [] (add-unique! (mut out) (.text e)))
    (OChoice [] (for k (.kids e) (guard-lits! k (mut out))))
    (OSeq [] (guard-lits! (get (.kids e) 0) (mut out)))
    (_ 0)))

(defn word-literal? [(s (slice u8))] (-> bool)
  (and (> (len s) 0) (rt/name-start? (get s 0))))

(defn collect-lits! [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> void)
  (match (.op e)
    (OLit []
          (let [(mut hit) false]
            (for l (.lits g) (when (= (.text l) (.text e)) (set! hit true)))
            (unless hit
              (push! (mut (.lits g)) (Lit :text (.text e) :id (len (.lits g)))))))
    (_ (for k (.kids e) (collect-lits! (mut g) (mut c) k)))))

(defn add-lit! [(g (mut Grammar)) (text (slice u8))] (-> void)
  (let [(mut hit) false]
    (for l (.lits g) (when (= (.text l) text) (set! hit true)))
    (unless hit (push! (mut (.lits g)) (Lit :text text :id (len (.lits g)))))))

(defn lit-id [(g (mut Grammar)) (text (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for l (.lits g) (when (= (.text l) text) (set! out (.id l))))
    (when (< out 0) (panic "literal {} was not collected" text))
    out))

;;; A printable signature of an alternative: a label may repeat across rules only
;;; if every use prints the same way.
(defn sig [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (let [(mut out) ""]
    (for it (seq-items e)
      (let [one (sig-item g (mut c) it)]
        (when (> (len one) 0) (set! out (dsl/join3 out " " one)))))
    out))

(defn sig-item [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (match (.op e)
    (OLit [] (.text e))
    (ORef []
          ;; A hidden rule that prints nothing is no part of a form.
          (match (find-decl g (.text e))
            (Some [d]
                  (if (and (= (.kind d) (DHidden))
                           (not (.print-soft d))
                           (= (len (.print-text d)) 0))
                      ""
                      (.text e)))
            (None [] (.text e))))
    (OStar [] (dsl/join2 "*" (sig g (mut c) (get (.kids e) 0))))
    (OPlus [] (dsl/join2 "+" (sig g (mut c) (get (.kids e) 0))))
    (OSepStar [] (dsl/join2 ",*" (sig g (mut c) (get (.kids e) 0))))
    (OSepPlus [] (dsl/join2 ",+" (sig g (mut c) (get (.kids e) 0))))
    (OOpt [] (dsl/join2 "?" (sig g (mut c) (get (.kids e) 0))))
    (OKeep [] (sig-item g (mut c) (get (.kids e) 0)))
    (OWith [] (sig-item g (mut c) (get (.kids e) 0)))
    (_ "")))

(defn add-kind! [(g (mut Grammar)) (c (mut dsl/Cur)) (t rt/Tok) (k KindDef)]
  (-> void)
  (let [(mut dup) false]
    (for old (.kinds g)
      (when (= (.name old) (.name k))
        (set! dup true)
        (let [same
                (match (.print old)
                  (PAlt [a _]
                        (match (.print k)
                          (PAlt [b _]
                                (= (sig g (mut c) (.seq a))
                                   (sig g (mut c) (.seq b))))
                          (_ false)))
                  (_ false))]
          (unless same
            (dsl/die (mut c)
                     t
                     (dsl/join3 "the label "
                                (.name k)
                                " is used with two different forms; a printer needs one form per label"))))))
    (when (and (> (len (.fields k)) 0) (!= (len (.fields k)) (.arity k)))
      (dsl/die (mut c)
               t
               (dsl/join3 (dsl/join3 "the node " (.name k) " has ")
                          (rt/num-text (.arity k))
                          (dsl/join3 " children, but "
                                     (rt/num-text (len (.fields k)))
                                     " names"))))
    (for i (range 0 (len (.kinds g)))
      (let [old (get (.kinds g) i)]
        (when (and (= (.name old) (.name k)) (> (len (.fields k)) 0))
          (if (= (len (.fields old)) 0)
              (set! (mut (.kinds g)) i (with-fields old (.fields k)))
              (unless (same-strs? (.fields old) (.fields k))
                (dsl/die (mut c)
                         t
                         (dsl/join3 "the node "
                                    (.name k)
                                    " names its children differently here")))))))
    (unless dup (push! (mut (.kinds g)) k))))

(defn with-fields [(k KindDef) (fields (ArrayList (slice u8)))] (-> KindDef)
  (KindDef
    :name (.name k)
    :arity (.arity k)
    :level (.level k)
    :print (.print k)
    :fields fields))

(defn same-strs? [(a (ArrayList (slice u8))) (b (ArrayList (slice u8)))]
  (-> bool)
  (and (= (len a) (len b))
       (let [(mut same) true]
         (for i (range 0 (len a))
           (unless (= (get a i) (get b i)) (set! same false)))
         same)))

(defn set-kind-level! [(g (mut Grammar)) (name (slice u8)) (level i64)]
  (-> void)
  (for i (range 0 (len (.kinds g)))
    (let [k (get (.kinds g) i)]
      (when (= (.name k) name)
        (set! (mut (.kinds g))
              i
              (KindDef
                :name (.name k)
                :arity (.arity k)
                :level level
                :print (.print k)
                :fields (.fields k)))))))

(defn set-kind-base! [(g (mut Grammar)) (name (slice u8)) (base-min i64)]
  (-> void)
  (for i (range 0 (len (.kinds g)))
    (let [k (get (.kinds g) i)]
      (when (= (.name k) name)
        (match (.print k)
          ;; A label shared across rules keeps the strictest requirement.
          (PAlt [a old]
                (when (> base-min old)
                  (set! (mut (.kinds g))
                        i
                        (KindDef
                          :name (.name k)
                          :arity (.arity k)
                          :level (.level k)
                          :print (PAlt a base-min)
                          :fields (.fields k)))))
          (_ 0))))))

(defn check-refs! [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> void)
  (when (= (.op e) (ORef))
    (decl-kind-of g (mut c) (.tok e) (.text e))
    0)
  (for k (.kids e) (check-refs! g (mut c) k)))

(defn analyse-alts! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl) (extra i64)]
  (-> void)
  (for a (.alts d)
    (check-refs! g (mut c) (.seq a))
    (collect-lits! (mut g) (mut c) (.seq a))
    (let [n (count-captures g (mut c) (.seq a))]
      (cond (> (len (.label a)) 0)
              (add-kind! (mut g)
                         (mut c)
                         (.tok (.seq a))
                         (KindDef
                           :name (.label a)
                           :arity (+ n extra)
                           :level (no-level)
                           :print (PAlt a 0)
                           :fields (.fields a)))
            (and (= extra 0) (!= n 1))
              (dsl/die (mut c)
                       (.tok (.seq a))
                       "an alternative with no label must capture exactly one thing")
            (and (> extra 0) (!= n 0))
              (dsl/die (mut c)
                       (.tok (.seq a))
                       "a postfix or suffix alternative with captures needs a label")
            :else 0))))

(defn analyse! [(g (mut Grammar)) (c (mut dsl/Cur))] (-> void)
  (for d (.decls g)
    (let [k (.kind d)]
      (cond (= k (DRule)) (analyse-alts! (mut g) (mut c) d 0)
            (or (= k (DPostfix)) (= k (DSuffix)))
              (do
                (decl-kind-of g (mut c) (.tok d) (.over d))
                (analyse-alts! (mut g) (mut c) d 1))
            (= k (DInfix))
              (do
                (decl-kind-of g (mut c) (.tok d) (.over d))
                (for op (.ops d)
                  (add-lit! (mut g) (.lit op))
                  (add-kind! (mut g)
                             (mut c)
                             (.tok op)
                             (KindDef
                               :name (.kind op)
                               :arity 2
                               :level (no-level)
                               :print (POp op)
                               :fields (left-right))))
                (for dr (.drops d)
                  (add-lit! (mut g) (.lit dr))
                  (unless (= (decl-kind-of g (mut c) (.tok dr) (.rule dr))
                             (DHidden))
                    (dsl/die (mut c)
                             (.tok dr)
                             "what a `drop` operator discards must be a hidden rule"))))
            (= k (DToken))
              (do
                (check-refs! g (mut c) (.body d))
                (add-kind! (mut g)
                           (mut c)
                           (.tok d)
                           (KindDef
                             :name (.name d)
                             :arity 0
                             :level (no-level)
                             :print (PLeaf)
                             :fields (empty-strs))))
            (= k (DHidden))
              (do
                (check-refs! g (mut c) (.body d))
                (collect-lits! (mut g) (mut c) (.body d)))
            :else (check-refs! g (mut c) (.body d))))))

;;; Number the precedence chain, lowest first, and give kinds their rule's level.
;;; Infix operators take one level each, so a rule's level is its lowest kind.
(defn assign-levels! [(g (mut Grammar))
                      (c (mut dsl/Cur))
                      (levels (mut (ArrayList Named)))] (-> void)
  (let [(mut level) 1]
    (for name (.precedence g)
      (match (find-decl g name)
        (None []
              (dsl/die (mut c)
                       (dsl/peek (mut c))
                       (dsl/join2 "precedence names no rule called " name)))
        (Some [d]
              (push! (mut levels) (Named :name name :value level))
              (if (= (.kind d) (DInfix))
                  (let [(mut top) 0]
                    (for op (.ops d)
                      (set-kind-level! (mut g) (.kind op) (+ level (.level op)))
                      (when (> (.level op) top) (set! top (.level op))))
                    (set! level (+ level top 1)))
                  (do
                    (for a (.alts d)
                      (when (> (len (.label a)) 0)
                        (set-kind-level! (mut g) (.label a) level)))
                    (set! level (+ level 1)))))))
    ;; A postfix chain may nest in itself; a suffix's base must sit above it.
    (for d (.decls g)
      (when (or (= (.kind d) (DPostfix)) (= (.kind d) (DSuffix)))
        (let [self (named-value levels (.name d))
              over (named-value levels (.over d))]
          (for a (.alts d)
            (set-kind-base! (mut g)
                            (.label a)
                            (if (= (.kind d) (DPostfix)) self over))))))))

(defn named-value [(xs (ArrayList Named)) (n (slice u8))] (-> i64)
  (let [(mut out) 0]
    (for x xs (when (= (.name x) n) (set! out (.value x))))
    out))

;; ---------------------------------------------------------------- symbols

(defn kind-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "K" n))

(defn rule-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "p-" n))

(defn impl-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-impl")))

(defn lex-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "lex-" n))

(defn token-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "token-" n))

(defn hidden-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "h-" n))

(defn rep-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "rep-" n))

(defn rep1-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "rep1-" n))

(defn sep-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "sep-" n))

(defn sep1-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "sep1-" n))

(defn cap-sym [(i i64)] (-> Code)
  (primitive/code-symbol "c" i))

(defn lit-sym [(i i64)] (-> Code)
  (primitive/code-symbol "lit-" i))

(defn aux-sym [(i i64)] (-> Code)
  (primitive/code-symbol "opt-" i))

(defn flag-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "FLAG-" n))

(defn alt-sym [(n (slice u8)) (i i64)] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-alt") i))

(defn fresh-aux! [(g (mut Grammar))] (-> i64)
  (let [i (.next-aux g)]
    (set! (.next-aux g) (+ i 1))
    i))

(defn add-aux! [(g (mut Grammar)) (form Code)] (-> void)
  (push! (mut (.aux g)) (dsl/render form)))

;; ---------------------------------------------------------------- lexical code

;;; Is this literal next? Most tests fail, and on the first byte, so check that alone
;;; before comparing strings.
(defn bytes-test [(s (slice u8))] (-> Code)
  (if (= (len s) 1)
      `(= (rt/peek (mut p)) ~(cast i64 (get s 0)))
      `(and (= (rt/peek (mut p)) ~(cast i64 (get s 0)))
            (rt/at-bytes? (mut p) ~s))))

;;; The bytes a class matches, as ranges: a negated one's are the rest of 0 to 255.
(defn class-ranges [(e PE)] (-> PE)
  (if (not (.neg e))
      e
      (let [(mut out) e
            (mut rs) (ArrayList::new [Range] (rt/value-allocator))]
        (for b (range 0 256)
          (let [(mut in) false]
            (for r (.ranges e)
              (when (and (>= b (.lo r)) (<= b (.hi r))) (set! in true)))
            (unless in
              (if (and (> (len rs) 0) (= (.hi (get rs (- (len rs) 1))) (- b 1)))
                  (let [last (get rs (- (len rs) 1))]
                    (set! (mut rs) (- (len rs) 1) (Range :lo (.lo last) :hi b)))
                  (push! (mut rs) (Range :lo b :hi b))))))
        (set! (.ranges out) rs)
        (set! (.neg out) false)
        out)))

;;; A bool expression over bytes that advances on success and restores on failure. A class of
;;; more than two ranges, or a negated one, is one test of a 256-bit set.
(defn class-test [(e PE)] (-> Code)
  (if (or (.neg e) (> (len (.ranges e)) 2))
      (let [(mut f) (First :ranges (.ranges (class-ranges e)) :known true)]
        (byte-test (bytes-of-first f)))
      (class-test-ranges e)))

(defn class-test-ranges [(e PE)] (-> Code)
  (let [(mut tests) (primitive/code-list-new)]
    (for r (.ranges e)
      (if (= (.lo r) (.hi r))
          (push! (mut tests) `(= c ~(.lo r)))
          (push! (mut tests) `(and (>= c ~(.lo r)) (<= c ~(.hi r))))))
    (if (.neg e)
        `(and (>= c 0) (not (or ~@tests)))
        `(or ~@tests))))

;;; The bytes `e` matches when it always matches exactly one byte: a class, a one-byte literal, any
;;; byte, or a choice of those, through fragments too.
(defn byte-set-of [(g Grammar) (e PE) (depth i64)] (-> (Option Bytes))
  (match (.op e)
    (OClass []
            (let [(mut f) (First :ranges (.ranges (class-ranges e)) :known true)]
              (Some (bytes-of-first f))))
    (OLit []
          (if (= (len (.text e)) 1)
              (let [(mut f)
                      (First
                        :ranges (ArrayList::new [Range] (rt/value-allocator))
                        :known true)
                    b (cast i64 (get (.text e) 0))]
                (push! (mut (.ranges f)) (Range :lo b :hi b))
                (Some (bytes-of-first f)))
              (None [Bytes])))
    (OAny []
          (Some (Bytes
                  :w0 -1
                  :w1 -1
                  :w2 -1
                  :w3 -1
                  :known true)))
    (OChoice []
             (let [(mut acc) (Some (bytes-none))]
               (for k (.kids e)
                 (match acc
                   (Some [a]
                         (match (byte-set-of g k depth)
                           (Some [b] (set! acc (Some (bytes-union a b))))
                           (None [] (set! acc (None [Bytes])))))
                   (None [] 0)))
               acc))
    (ORef []
          (if (> depth 8)
              (None [Bytes])
              (match (find-decl g (.text e))
                (Some [d]
                      (if (= (.kind d) (DFragment))
                          (byte-set-of g (.body d) (+ depth 1))
                          (None [Bytes])))
                (None [] (None [Bytes])))))
    (_ (None [Bytes]))))

;;; The bytes a fragment takes one at a time: of a choice (or a fragment that is one), the bytes of
;;; its single-byte alternatives, less those an earlier alternative of more than a byte can begin
;;; with. The choice, tried at one of them, matches that byte and no more: PEG tries alternatives
;;; in order, and every one before it either cannot begin there or is a single byte too. None
;;; when there are none, or an earlier alternative's first bytes are not known.
(defn leading-bytes [(g Grammar) (e PE) (depth i64)] (-> (Option Bytes))
  (match (.op e)
    (ORef []
          (if (> depth 8)
              (None [Bytes])
              (match (find-decl g (.text e))
                (Some [d]
                      (if (= (.kind d) (DFragment))
                          (leading-bytes g (.body d) (+ depth 1))
                          (None [Bytes])))
                (None [] (None [Bytes])))))
    (OChoice []
             (let [(mut out) (bytes-none)
                   (mut blocked) (bytes-none)
                   (mut any) false
                   (mut going) true]
               (for k (.kids e)
                 (when going
                   (match (byte-set-of g k 0)
                     (Some [b]
                           (set! out (bytes-union out (bytes-less b blocked)))
                           (set! any true))
                     (None []
                           (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)]
                             (first-of! g k (mut f) 0)
                             (if (.known f)
                                 (set! blocked (bytes-union blocked (bytes-of-first f)))
                                 (set! going false)))))))
               (if any (Some out) (None [Bytes]))))
    (_ (None [Bytes]))))

;;; The bytes of `a` that are not in `b`.
(defn bytes-less [(a Bytes) (b Bytes)] (-> Bytes)
  (Bytes
    :w0 (& (.w0 a) (- -1 (.w0 b)))
    :w1 (& (.w1 a) (- -1 (.w1 b)))
    :w2 (& (.w2 a) (- -1 (.w2 b)))
    :w3 (& (.w3 a) (- -1 (.w3 b)))
    :known (and (.known a) (.known b))))

;;; The bytes a fragment's alternatives of more than a byte can begin with: a byte that is none of
;;; its `leading-bytes` can only be matched by one of them, and only where it can begin. None when
;;; that is not known. An alternative that can match nothing is no
;;; matter to a repetition, which stops at a step that takes no byte; `strict` is for a single
;;; match, where it is one: None then.
(defn after-leading [(g Grammar) (e PE) (depth i64) (strict bool)] (-> (Option Bytes))
  (match (.op e)
    (ORef []
          (if (> depth 8)
              (None [Bytes])
              (match (find-decl g (.text e))
                (Some [d]
                      (if (= (.kind d) (DFragment))
                          (after-leading g (.body d) (+ depth 1) strict)
                          (None [Bytes])))
                (None [] (None [Bytes])))))
    (OChoice []
             (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)
                   (mut empty) false]
               (for k (.kids e)
                 (match (byte-set-of g k 0)
                   (Some [_] 0)
                   (None [] (when (first-of! g k (mut f) 0) (set! empty true)))))
               (if (and (.known f) (not (and strict empty)))
                   (Some (bytes-of-first f))
                   (None [Bytes]))))
    (_ (None [Bytes]))))

;;; For `!X .`, any byte where X does not match: the bytes X can begin with, when they are known
;;; and X cannot match nothing. Any other byte is one the step takes.
(defn until-bytes [(g Grammar) (e PE)] (-> (Option Bytes))
  (if (and (= (.op e) (OSeq))
           (= (len (.kids e)) 2)
           (= (.op (get (.kids e) 0)) (ONot))
           (= (.op (get (.kids e) 1)) (OAny)))
      (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)
            empty (first-of! g (get (.kids (get (.kids e) 0)) 0) (mut f) 0)]
        (if (and (.known f) (not empty)) (Some (bytes-of-first f)) (None [Bytes])))
      (None [Bytes])))

;;; Past every byte not of the set from here on. Where the set is a few bytes (what ends a
;;; comment, a line), eight bytes at a time first: a word with none of them in it is stepped over
;;; whole. (A word less a byte repeated has a zero byte where it holds that byte, and
;;; `(x - 0x01…) & ~x & 0x80…` is not zero exactly when x has a zero byte.)
(defn byte-run-until [(b Bytes)] (-> Code)
  (let [(mut stops) (ArrayList::new [i64] (rt/value-allocator))
        ones 72340172838076673
        (mut tests) (primitive/code-list-new)]
    (for x (range 0 256) (when (bytes-has? b x) (push! (mut stops) x)))
    (for x stops
      (let [rep (primitive/imul x ones)]
        (push! (mut tests)
               `(let [x (^ w ~rep)]
                  (& (primitive/isub x 72340172838076673) (& (- -1 x) -9187201950435737472))))))
    `(let [src (.src p)
           n (len src)
           (mut i) (.pos p)]
       ~(if (and (> (len stops) 0) (<= (len stops) 4))
            `(while (and (<= (+ i 8) n)
                         (let [w (load (primitive/cast (ptr i64) (primitive/index (data src) i)))]
                           (= (| 0 0 ~@tests) 0)))
               (set! i (+ i 8)))
            `0)
       (while (and (< i n) (let [c (cast i64 (get src i))] (not ~(byte-test b))))
         (set! i (+ i 1)))
       (set! (.pos p) i))))

;;; Past every byte of the set from here on.
(defn byte-run [(b Bytes)] (-> Code)
  `(let [src (.src p)
         n (len src)
         (mut i) (.pos p)]
     (while (and (< i n) (let [c (cast i64 (get src i))] ~(byte-test b)))
       (set! i (+ i 1)))
     (set! (.pos p) i)))

;;; A byte set's test of the byte here, and the step past it.
(defn byte-step [(b Bytes)] (-> Code)
  `(let [c (rt/peek (mut p))]
     (if ~(byte-test b) (do (rt/advance! (mut p) 1) true) false)))

;;; What an alternative begins with, and what comes after that: its first item and the rest.
(defn alt-head [(k PE)] (-> PE)
  (if (and (= (.op k) (OSeq)) (> (len (.kids k)) 0)) (get (.kids k) 0) k))

(defn alt-rest [(k PE)] (-> PE)
  (let [(mut out) (pe-new (OSeq) "" (.tok k))]
    (when (= (.op k) (OSeq))
      (for i (range 1 (len (.kids k))) (push! (mut (.kids out)) (get (.kids k) i))))
    (if (= (len (.kids out)) 1) (get (.kids out) 0) out)))

;;; What an expression of bytes begins with, as a set; unknown when it can match nothing.
(defn lex-first [(g Grammar) (e PE)] (-> Bytes)
  (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)
        empty (first-of! g e (mut f) 0)
        (mut b) (bytes-of-first f)]
    (when empty (set! (.known b) false))
    b))

(defn bytes-apart? [(a Bytes) (b Bytes)] (-> bool)
  (and (.known a) (.known b)
       (= (& (.w0 a) (.w0 b)) 0) (= (& (.w1 a) (.w1 b)) 0)
       (= (& (.w2 a) (.w2 b)) 0) (= (& (.w3 a) (.w3 b)) 0)))

;;; A choice's alternatives with those that begin alike made one: `A b | A c` is `A (b | c)`,
;;; which matches the same and matches `A` once. An expression matches the same way wherever it
;;; is asked at the same place, so that is always so in a PEG; and an alternative between two
;;; that begin alike is stepped over where it cannot begin as they do, since then its place among
;;; them makes no difference.
(defn factored [(g Grammar) (kids (ArrayList PE))] (-> (ArrayList PE))
  (let [(mut out) (empty-pes)
        (mut used) (ArrayList::new [bool] (rt/value-allocator))]
    (for _ kids (push! (mut used) false))
    (for i (range 0 (len kids))
      (unless (get used i)
        (let [k (get kids i)
              head (alt-head k)
              first (lex-first g head)
              (mut rests) (empty-pes)
              (mut going) (= (.op k) (OSeq))]
          (push! (mut rests) (alt-rest k))
          (for j (range (+ i 1) (len kids))
            (when (and going (not (get used j)))
              (let [other (get kids j)]
                (if (and (= (.op other) (OSeq)) (pe-same? (alt-head other) head))
                    (do
                      (push! (mut rests) (alt-rest other))
                      (set! (mut used) j true))
                    (unless (bytes-apart? first (lex-first g other))
                      (set! going false))))))
          (if (> (len rests) 1)
              (let [(mut both) (pe-new (OSeq) "" (.tok k))
                    (mut choice) (pe-new (OChoice) "" (.tok k))]
                (for r rests (push! (mut (.kids choice)) r))
                (push! (mut (.kids both)) head)
                (push! (mut (.kids both)) choice)
                (push! (mut out) both))
              (push! (mut out) k)))))
    out))

(defn lex-code [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (byte-set-of g e 0)
    (Some [b]
          (if (or (= (.op e) (OLit)) (= (.op e) (OClass)))
              (lex-code-of g (mut c) e)
              (byte-step b)))
    (None [] (lex-code-of g (mut c) e))))

(defn lex-code-of [(g Grammar) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (.op e)
    (OLit []
          `(if ~(bytes-test (.text e))
               (do (rt/advance! (mut p) ~(len (.text e))) true)
               false))
    (OClass []
            `(let [c (rt/peek (mut p))]
               (if ~(class-test e)
                   (do (rt/advance! (mut p) 1) true)
                   false)))
    (OAny []
          `(if (rt/eof? (mut p)) false (do (rt/advance! (mut p) 1) true)))
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (unless (or (= k (DFragment)) (= k (DToken)))
              (dsl/die (mut c)
                       (.tok e)
                       "a token can only use fragments and tokens"))
            ;; Most of what such a fragment matches is one of its leading bytes: those are
            ;; taken here, and only the rest calls it.
            (match (leading-bytes g e 0)
              (Some [b]
                    `(let [c (rt/peek (mut p))]
                       (if ~(byte-test b)
                           (do (rt/advance! (mut p) 1) true)
                           ;; None of those: only where a later alternative can begin is
                           ;; the fragment asked at all.
                           ~(match (after-leading g e 0 true)
                              (Some [rest] `(and ~(byte-test rest) (~(lex-sym (.text e)) (mut p))))
                              (None [] `(~(lex-sym (.text e)) (mut p)))))))
              ;; A fragment that must begin with one of a few bytes is asked only at one of them.
              (None []
                    (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)
                          empty (first-of! g e (mut f) 0)]
                      (if (and (.known f) (not empty))
                          `(and (let [c (rt/peek (mut p))] ~(byte-test (bytes-of-first f)))
                                (~(lex-sym (.text e)) (mut p)))
                          `(~(lex-sym (.text e)) (mut p))))))))
    (OSeq []
          (let [(mut parts) (primitive/code-list-new)]
            (for k (.kids e) (push! (mut parts) (lex-code g (mut c) k)))
            `(let [s (.pos p)]
               (if (and ~@parts true) true (do (set! (.pos p) s) false)))))
    ;; Each alternative is tried only if the byte here can begin it: the byte is read once, as
    ;; a failing alternative leaves the position where it was.
    (OChoice []
             (let [(mut parts) (primitive/code-list-new)]
               (for k (factored g (.kids e))
                 (let [code (lex-code g (mut c) k)
                       (mut f)
                         (First
                           :ranges (ArrayList::new [Range] (rt/value-allocator))
                           :known true)
                       empty (first-of! g k (mut f) 0)]
                   (push! (mut parts)
                          (if (and (.known f)
                                   (not empty)
                                   (not (= (.op k) (OLit)))
                                   (not (= (.op k) (OClass))))
                              `(and ~(byte-test (bytes-of-first f)) ~code)
                              code))))
               `(let [c (rt/peek (mut p))] (or ~@parts))))
    ;; A repetition of single bytes is a loop over bytes, with nothing to save and put back: an
    ;; index in a register, the position written once at the end.
    (OStar []
           (match (byte-set-of g (get (.kids e) 0) 0)
             (Some [b] `(do ~(byte-run b) true))
             (None []
                   (match (until-bytes g (get (.kids e) 0))
                     ;; `(!X .)*`: every byte X cannot begin with is taken in a loop of its
                     ;; own, and X is tried only at one it can.
                     (Some [stop]
                           (let [inner (get (.kids e) 0)]
                             `(let [(mut go) true]
                                (while go
                                  ~(byte-run-until stop)
                                  (let [s (.pos p)]
                                    (unless (and ~(lex-code g (mut c) inner) (> (.pos p) s))
                                      (set! go false))))
                                true)))
                     (None []
                   (match (leading-bytes g (get (.kids e) 0) 0)
                     ;; A run of an identifier's characters: the leading bytes in a loop of their
                     ;; own, the fragment itself only for the others.
                     (Some [lead]
                           `(let [(mut go) true]
                              (while go
                                ~(byte-run lead)
                                ;; The byte here is none of those: only an alternative after
                                ;; them can go on, and only where it can begin.
                                (let [s (.pos p)
                                      c (rt/peek (mut p))]
                                  (unless (and ~(match (after-leading g (get (.kids e) 0) 0 false)
                                                  (Some [b] (byte-test b))
                                                  (None [] `true))
                                               ~(lex-code g (mut c) (get (.kids e) 0))
                                               (> (.pos p) s))
                                    (set! go false))))
                              true))
                     (None []
                           `(let [(mut go) true]
                              (while go
                                (let [s (.pos p)]
                                  (unless (and ~(lex-code g (mut c) (get (.kids e) 0))
                                               (> (.pos p) s))
                                    (set! go false))))
                              true))))))))
    (OPlus []
           (match (byte-set-of g (get (.kids e) 0) 0)
             (Some [b]
                   `(if (let [c (rt/peek (mut p))] ~(byte-test b))
                        (do
                          (rt/advance! (mut p) 1)
                          ~(byte-run b)
                          true)
                        false))
             (None []
                   `(if ~(lex-code g (mut c) (get (.kids e) 0))
                        (let [(mut go) true]
                          (while go
                            (let [s (.pos p)]
                              (unless (and ~(lex-code g
                                                      (mut c)
                                                      (get (.kids e) 0))
                                           (> (.pos p) s))
                                (set! go false))))
                          true)
                        false))))
    (OOpt []
          `(do ~(lex-code g (mut c) (get (.kids e) 0)) true))
    (ONot []
          `(let [s (.pos p)
                 hit ~(lex-code g (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             (not hit)))
    (OAnd []
          `(let [s (.pos p)
                 hit ~(lex-code g (mut c) (get (.kids e) 0))]
             (set! (.pos p) s)
             hit))
    (OEof [] `(rt/eof? (mut p)))
    (OBof [] `(= (.pos p) 0))
    (OLineStart [] (do (needs-newline g (mut c) e) `(at-line-start? (mut p))))
    (_ (dsl/die (mut c)
                (.tok e)
                "this item is not allowed in a token or fragment"))))

;; ---------------------------------------------------------------- recognisers

;;; What an expression of a rule begins with, by the grammar's own memo of its rules' starts.
(defn start-of! [(g (mut Grammar)) (e PE)] (-> Start)
  (let [(mut m) (.firsts g)
        s (pe-start g e (mut m))]
    (set! (.firsts g) m)
    s))

;;; `X*` with nothing captured. A step that consumes nothing ends it.
(defn rec-star [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE)] (-> Code)
  `(let [(mut go) true]
     (while go
       (let [from (.pos p)]
         (unless (and ~(rec-code (mut g) (mut c) inner) (> (.pos p) from))
           (rt/backtrack! (mut p) from)
           (set! go false))))
     true))

;;; `X,+` with nothing captured: at least one, then a comma before each more, and one may trail.
(defn rec-sep [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE)] (-> Code)
  `(if ~(rec-code (mut g) (mut c) inner)
       (let [(mut go) true]
         (while go
           (let [from (.pos p)]
             (unless (and (comma! (mut p)) ~(rec-code (mut g) (mut c) inner))
               (rt/backtrack! (mut p) from)
               (set! go false))))
         (comma! (mut p))
         true)
       false))

;;; A bool expression over rules, for lookaheads and hidden rules: nothing captured.
(defn rec-code [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> Code)
  (match (.op e)
    (OLit [] `(~(lit-sym (lit-id (mut g) (.text e))) (mut p)))
    (ORef []
          (let [k (decl-kind-of g (mut c) (.tok e) (.text e))]
            (cond (= k (DHidden)) `(~(hidden-sym (.text e)) (mut p))
                  (= k (DFragment))
                    `(do (skip! (mut p)) (~(lex-sym (.text e)) (mut p)))
                  :else
                    `(let [(mut t) (primitive/zeroed Node)]
                       (~(rule-sym (.text e)) (mut p) (mut t))))))
    (OSeq []
          (let [(mut parts) (primitive/code-list-new)]
            (for k (.kids e) (push! (mut parts) (rec-code (mut g) (mut c) k)))
            `(let [s (.pos p)]
               (if (and ~@parts true) true (do (rt/backtrack! (mut p) s) false)))))
    ;; Each alternative is tried only where the next token's first byte can begin it.
    (OChoice []
             (let [(mut parts) (primitive/code-list-new)
                   (mut any) false]
               (for k (.kids e)
                 (let [code (rec-code (mut g) (mut c) k)
                       s (start-of! (mut g) k)]
                   (if (and (.known (.bytes s)) (not (.empty s)))
                       (do
                         (set! any true)
                         (push! (mut parts) `(and (or ~(byte-test (.bytes s)) (.careful p)) ~code)))
                       (push! (mut parts) code))))
               (if any
                   `(let [c (next-byte (mut p))] (or ~@parts))
                   `(or ~@parts))))
    (OOpt [] `(do ~(rec-code (mut g) (mut c) (get (.kids e) 0)) true))
    (OStar [] (rec-star (mut g) (mut c) (get (.kids e) 0)))
    (OPlus []
           (let [once (rec-code (mut g) (mut c) (get (.kids e) 0))]
             `(and ~once
                   (do ~(rec-star (mut g) (mut c) (get (.kids e) 0)) true))))
    (OSepStar [] `(do ~(rec-sep (mut g) (mut c) (get (.kids e) 0)) true))
    (OSepPlus [] (rec-sep (mut g) (mut c) (get (.kids e) 0)))
    (OWith []
           `(let [old (.flags p)]
              (set! (.flags p)
                    (rt/apply-flags old
                                    ~(flag-mask (.on e))
                                    ~(flag-mask (.off e))))
              (let [r ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
                (set! (.flags p) old)
                r)))
    (ONot []
          `(let [s (.pos p)
                 hit ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
             (rt/backtrack! (mut p) s)
             (not hit)))
    (OAnd []
          `(let [s (.pos p)
                 hit ~(rec-code (mut g) (mut c) (get (.kids e) 0))]
             (rt/backtrack! (mut p) s)
             hit))
    (OEof [] `(skip-peek? (mut p)))
    (ONl [] (do (needs-newline g (mut c) e) `(newline-ahead? (mut p))))
    (ONoNl [] (do (needs-newline g (mut c) e) `(not (newline-ahead? (mut p)))))
    (OIf [] `(rt/flag? (mut p) ~(flag-sym (.text e))))
    (OUnless [] `(not (rt/flag? (mut p) ~(flag-sym (.text e)))))
    (_ (dsl/die (mut c)
                (.tok e)
                "this item is not allowed in a lookahead or hidden rule"))))

;; ---------------------------------------------------------------- parsing code

(defn flag-mask [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut parts) (primitive/code-list-new)]
    (for n names (push! (mut parts) (flag-sym n)))
    `(| 0 0 ~@parts)))

(defn none-fail [] (-> Code)
  `false)

;;; A generated function for `X?`: at most one capture, and never fails.
(defn emit-opt! [(g (mut Grammar)) (c (mut dsl/Cur)) (inner PE) (target Code)] (-> Code)
  (let [id (fresh-aux! (mut g))
        n (count-captures g (mut c) inner)
        name (aux-sym id)]
    (when (> n 1)
      (dsl/die (mut c)
               (.tok inner)
               "an optional group may capture at most one thing"))
    ;; Its one capture is parsed into the caller's place; with none, it is a flag.
    (let [tail (if (= n 1) `true `(do (set! out (flag-node-in (mut p))) true))
          body (seq-code (mut g) (mut c) (seq-items inner) 0 0 tail (= n 1))]
      (add-aux! (mut g)
                `(defn ~name [(p (mut rt/P)) (out (mut Node))] (-> bool)
                   (let [s (.pos p)]
                     (unless ~body
                       (rt/backtrack! (mut p) s)
                       (set! out (none-node-in (mut p))))
                     true)))
      `(~name (mut p) ~target))))

;;; The call parsing a capture into `target`, true where it matched. Repetitions need a helper for
;;; what they repeat, so their inner item must be a plain reference.
(defn capture-call [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE) (target Code)] (-> Code)
  (match (.op e)
    (ORef [] `(~(rule-sym (.text e)) (mut p) ~target))
    (OKeep [] (capture-call (mut g) (mut c) (get (.kids e) 0) target))
    (OWith []
           `(let [old (.flags p)]
              (set! (.flags p)
                    (rt/apply-flags old
                                    ~(flag-mask (.on e))
                                    ~(flag-mask (.off e))))
              (let [r ~(capture-call (mut g) (mut c) (get (.kids e) 0) target)]
                (set! (.flags p) old)
                r)))
    (OOpt [] (emit-opt! (mut g) (mut c) (get (.kids e) 0) target))
    (OStar [] `(~(rep-sym (rep-name! (mut g) (mut c) e)) (mut p) ~target))
    (OPlus [] `(~(rep1-sym (rep-name! (mut g) (mut c) e)) (mut p) ~target))
    (OSepStar [] `(~(sep-sym (rep-name! (mut g) (mut c) e)) (mut p) ~target))
    (OSepPlus [] `(~(sep1-sym (rep-name! (mut g) (mut c) e)) (mut p) ~target))
    (_ (dsl/die (mut c) (.tok e) "this item cannot capture"))))

(defn rep-name! [(g (mut Grammar)) (c (mut dsl/Cur)) (e PE)] (-> (slice u8))
  (let [inner (get (.kids e) 0)]
    (unless (= (.op inner) (ORef))
      (dsl/die (mut c)
               (.tok e)
               "a repetition needs a plain rule name; give the group a rule"))
    (add-unique! (mut (.reps g)) (.text inner))
    (.text inner)))

;;; Items i.. of a sequence, nested, ending in `tail`.
(defn seq-code [(g (mut Grammar))
                (c (mut dsl/Cur))
                (items (ArrayList PE))
                (i i64)
                (cap i64)
                (tail Code)
                (direct bool)] (-> Code)
  (if (>= i (len items))
      tail
      (let [e (get items i)]
        (if (captures? g (mut c) e)
            (if direct
                ;; The one capture, passed through: parsed straight into the caller's place.
                `(if ~(capture-call (mut g) (mut c) e `(mut out))
                     ~(seq-code (mut g) (mut c) items (+ i 1) (+ cap 1) tail direct)
                     false)
                `(let [(mut ~(cap-sym cap)) (primitive/zeroed Node)]
                   (if ~(capture-call (mut g) (mut c) e `(mut ~(cap-sym cap)))
                       ~(seq-code (mut g) (mut c) items (+ i 1) (+ cap 1) tail direct)
                       false)))
            `(if ~(rec-code (mut g) (mut c) e)
                 ~(seq-code (mut g) (mut c) items (+ i 1) cap tail direct)
                 false)))))

;;; `inner` with the place for a node's `total` children made: `kids`, and `d`, its first.
(defn kids-place [(inner Code) (total i64)] (-> Code)
  `(let [(mut kids) (kids-sized-in (mut p) ~total)
         d (.data kids)]
     ~inner))

;;; The items of a node with `total` children, two or more, which are counted before any is
;;; parsed: their place is made as soon as the alternative has matched something (a literal, or
;;; its first child), and each child after that is parsed where it will stay. `made`: the place is
;;; there, as `d`. An alternative that fails after that leaves the place behind, as it does what
;;; its children made.
(defn seq-in-place [(g (mut Grammar))
                    (c (mut dsl/Cur))
                    (items (ArrayList PE))
                    (i i64)
                    (cap i64)
                    (total i64)
                    (made bool)
                    (matched bool)
                    (tail Code)] (-> Code)
  (if (>= i (len items))
      tail
      (let [e (get items i)]
        (cond (not (captures? g (mut c) e))
                `(if ~(rec-code (mut g) (mut c) e)
                     ~(seq-in-place (mut g) (mut c) items (+ i 1) cap total made
                                    (or matched (= (.op e) (OLit))) tail)
                     false)
              made
                `(if ~(capture-call (mut g) (mut c) e `(primitive/index d ~cap))
                     ~(seq-in-place (mut g) (mut c) items (+ i 1) (+ cap 1) total true true tail)
                     false)
              ;; A literal has matched: the place is made before this child.
              matched
                (kids-place `(if ~(capture-call (mut g) (mut c) e `(primitive/index d ~cap))
                            ~(seq-in-place (mut g) (mut c) items (+ i 1) (+ cap 1) total true true tail)
                            false)
                       total)
              ;; Nothing has yet: this child is parsed first, and moved in when it matched.
              :else
                `(let [(mut first) (primitive/zeroed Node)]
                   (if ~(capture-call (mut g) (mut c) e `(mut first))
                       ~(kids-place `(do
                                  (store! (primitive/index d ~cap) first)
                                  ~(seq-in-place (mut g) (mut c) items (+ i 1) (+ cap 1) total true true tail))
                               total)
                       false))))))

;;; All items matched: build the node, or pass the one capture through.
(defn alt-tail [(g Grammar) (c (mut dsl/Cur)) (a Alt) (extra i64)] (-> Code)
  (if (= (len (.label a)) 0)
      ;; Passed through: the capture is in place already (a chain's base stays as it was).
      (if (pass-through? g (mut c) a extra) `true `(do (set! out c0) true))
      (let [(mut stores) (primitive/code-list-new)
            total (+ (count-captures g (mut c) (.seq a)) extra)]
        (for i (range 0 total)
          (push! (mut stores)
                 (if (and (= i 0) (> extra 0))
                     `(store! (primitive/index d 0) out)
                     `(store! (primitive/index d ~i) ~(cap-sym i)))))
        (cond (= total 0)
                `(do (set! out (mk (~(kind-sym (.label a))) (kids-in (mut p)) lo (.pos p))) true)
              ;; Its children are where they stay (see `seq-in-place`): a chain's base joins them.
              (in-place? g (mut c) a extra)
                `(do
                   ~(if (> extra 0) `(store! (primitive/index d 0) out) `0)
                   (set! (.len kids) ~total)
                   (set! out (mk (~(kind-sym (.label a))) kids lo (.pos p)))
                   true)
              ;; The node's children are counted here already: one allocation of that size, each
              ;; child written in its place.
              :else
                `(let [(mut kids) (kids-sized-in (mut p) ~total)]
                   (let [d (.data kids)]
                     ~@stores
                     (set! (.len kids) ~total))
                   (set! out (mk (~(kind-sym (.label a))) kids lo (.pos p)))
                   true)))))

;;; Whether a labelled alternative's children are parsed in place: with two or more of its own.
(defn in-place? [(g Grammar) (c (mut dsl/Cur)) (a Alt) (extra i64)] (-> bool)
  (and (> (len (.label a)) 0) (>= (count-captures g (mut c) (.seq a)) 2)))

;;; An alternative without a label and with one capture, not extending a base: what it captures
;;; is what it makes, so it is parsed into the caller's place directly.
(defn pass-through? [(g Grammar) (c (mut dsl/Cur)) (a Alt) (extra i64)] (-> bool)
  (or (> extra 0)
      (and (= (len (.label a)) 0) (= (count-captures g (mut c) (.seq a)) 1))))

(defn emit-alt-fn! [(g (mut Grammar))
                    (c (mut dsl/Cur))
                    (name (slice u8))
                    (i i64)
                    (a Alt)
                    (extra i64)] (-> void)
  (let [tail (alt-tail g (mut c) a extra)
        direct (and (= extra 0) (pass-through? g (mut c) a extra))
        body (if (in-place? g (mut c) a extra)
                 (seq-in-place (mut g) (mut c) (seq-items (.seq a)) 0 extra
                               (+ (count-captures g (mut c) (.seq a)) extra) false false tail)
                 (seq-code (mut g) (mut c) (seq-items (.seq a)) 0 extra tail direct))]
    ;; Each writes what it makes to `out` and says whether it matched. One that extends a base
    ;; finds the base in `out`, and leaves it there unless it matches.
    (add-aux! (mut g)
              (if (> extra 0)
                  `(defn ~(alt-sym name i) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                     (let [lo (.lo out)] ~body))
                  `(defn ~(alt-sym name i) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                     (let [lo (token-start (mut p))] ~body))))))

;;; Try alternatives in order, restoring the position after each failure.
(defn try-alts [(name (slice u8)) (i i64) (total i64)] (-> Code)
  (if (>= i total)
      `false
      `(if (~(alt-sym name i) (mut p) (mut out))
           true
           (do
             (rt/backtrack! (mut p) save)
             ~(try-alts name (+ i 1) total)))))

;;; How many bytes a match must be longer than for a memo to keep it.
(defn memo-least [] (-> i64) 16)

(defn slow-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-slow")))

(defn two-sym [(n (slice u8)) (i i64)] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-two") i))

(defn rest-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" n "-rest")))

;;; A rule's function. `slow` tries every alternative in order, each behind its own guard. Where a
;;; layout by the byte the next token begins with says more (see "plans"), that is the function,
;;; and `slow` is what a careful parse runs.
(defn emit-rule-fn! [(g (mut Grammar)) (d Decl) (slow Code) (memo (mut FirstMemo))] (-> void)
  (when (plans? g d)
    (add-aux! (mut g)
              `(defn ~(slow-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 ~slow)))
  (let [body (if (plans? g d)
                 `(if (.careful p)
                      (~(slow-sym (.name d)) (mut p) (mut out))
                      ~(plan-dispatch (mut g) d (mut memo)))
                 slow)]
    (if (.memo d)
        (let [id (.memo-count g)
              start (rule-start g (.name d) (mut memo))
              ;; A rule asked for where its first byte cannot be fails there at once, and nothing
              ;; is gained remembering it: what it cannot begin with is not looked up or logged.
              can-start (if (and (.known (.bytes start)) (not (.empty start)))
                            `(or (let [c (next-byte (mut p))] ~(byte-test (.bytes start))) (.careful p))
                            `true)]
          (set! (.memo-count g) (+ id 1))
          (add-aux! (mut g)
                    `(defn ~(impl-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                       ~body))
          (add-aux! (mut g)
                    `(defn ~(rule-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                       (if (not ~can-start)
                           false
                           (let [key (rt/memo-key (mut p))]
                             (match (rt/memo-get (mut p) ~id key)
                               (Some [hit]
                                     (set! (.pos p) (.end hit))
                                     (if (.ok hit)
                                         (do (set! out (memo-node (mut p) (.node hit))) true)
                                         false))
                               (None []
                                     (let [from (.pos p)
                                           r (~(impl-sym (.name d)) (mut p) (mut out))]
                                       ;; A match of a few bytes is parsed again as quickly as it
                                       ;; is looked up: only longer ones, and failures, are kept.
                                       (when (or (not r) (> (- (.pos p) from) ~(memo-least)))
                                         (rt/memo-put! (mut p)
                                                       ~id
                                                       key
                                                       (rt/MemoHit
                                                         :ok r
                                                         :end (.pos p)
                                                         :node (if r (memo-node-keep! (mut p) (mut out)) 0))))
                                       r))))))))
        (add-aux! (mut g)
                  `(defn ~(rule-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                     ~body)))))

(defn emit-rule! [(g (mut Grammar))
                  (c (mut dsl/Cur))
                  (d Decl)
                  (memo (mut FirstMemo))] (-> void)
  (for i (range 0 (len (.alts d)))
    (emit-alt-fn! (mut g) (mut c) (.name d) i (get (.alts d) i) 0))
  (emit-two-fns! (mut g) d (mut memo))
  (let [gs (alt-guards (mut g) d (mut memo))]
    (emit-rule-fn! (mut g)
                   d
                   (if (.any gs)
                       `(let [save (.pos p)
                              c (next-byte (mut p))]
                          ~(guarded-alts (.name d) (.tests gs) (.guarded gs) 0))
                       `(let [save (.pos p)]
                          ~(try-alts (.name d) 0 (len (.alts d)))))
                   (mut memo))))

;; ---------------------------------------------------------------- plans
;;;
;;; An operand of an expression is asked for at the loosest level and found at the tightest, a
;;; dozen rules down, each of which looks at the next byte, finds none of its own alternatives
;;; can begin there, and asks the next; and on the way back each looks again for an operator of
;;; its own. The byte decides all of that before any rule is called. A rule's function is laid out
;;; by that byte: for each, the alternatives it can begin, with one that only names another rule
;;; replaced by that rule's own layout for the byte, and so on down. What is left is the rule
;;; that really has a choice to make there (or a token), and the chains passed on the way, whose
;;; operators are looked for afterwards: all at once first, since after most operands none follows.
;;; The parse is the one the rules make one by one: the same alternatives in the same order, only
;;; without those the byte had ruled out.

;;; Is byte `x` in the set? -1, the end of input, is in none.
(defn bytes-has? [(b Bytes) (x i64)] (-> bool)
  (if (or (< x 0) (> x 255))
      false
      (let [w (cond (< x 64) (.w0 b) (< x 128) (.w1 b) (< x 192) (.w2 b) :else (.w3 b))]
        (!= (& (>> w (% x 64)) 1) 0))))

;;; Can something that starts like this begin at byte `x`?
(defn start-has? [(s Start) (x i64)] (-> bool)
  (or (not (.known (.bytes s))) (.empty s) (bytes-has? (.bytes s) x)))

;;; The rule an alternative passes on, when it is nothing but that rule's name.
(defn bare-ref [(g Grammar) (a Alt)] (-> (slice u8))
  (if (and (= (len (.label a)) 0) (= (.op (.seq a)) (ORef)))
      (match (find-decl g (.text (.seq a)))
        (Some [d]
              (if (or (= (.kind d) (DHidden)) (= (.kind d) (DFragment))) "" (.name d)))
        (None [] ""))
      ""))

(defn chain? [(d Decl)] (-> bool)
  (or (= (.kind d) (DPostfix)) (= (.kind d) (DSuffix)) (= (.kind d) (DInfix))))

;;; How many rules' choices one layout holds, one inside another, before the next is a call.
(defn plan-most [] (-> i64) 4)

;;; A layout for one byte: the code that parses what is found first, and the chains whose
;;; operators may follow it, innermost first.
(defstruct Run [(terminal Code) (rests (ArrayList (slice u8)))])

(defn run-of [(terminal Code)] (-> Run)
  (Run :terminal terminal :rests (empty-strs)))

;;; The two-token test of each alternative that has one, as a function of its own: a layout
;;; names it wherever the alternative is tried.
(defn emit-two-fns! [(g (mut Grammar)) (d Decl) (m (mut FirstMemo))] (-> void)
  (for i (range 0 (len (.alts d)))
    (match (two-token-test (mut g) (.seq (get (.alts d) i)) (mut m))
      (Some [t]
            (add-aux! (mut g)
                      `(defn ~(two-sym (.name d) i) :inline (Hint) [(p (mut rt/P)) (c i64)] (-> bool) ~t)))
      (None [] 0))))

;;; What rule `name` does at byte `x`, as it is written: not through its memo.
(defn plan-run [(g (mut Grammar)) (name (slice u8)) (x i64) (depth i64) (lists i64) (m (mut FirstMemo))] (-> Run)
  (match (find-decl g name)
    (None [] (panic "no rule named {}" name))
    (Some [d]
          (cond (chain? d)
                  (let [(mut r) (plan-ref (mut g) (.over d) x (+ depth 1) lists (mut m))]
                    (push! (mut (.rests r)) name)
                    r)
                (= (.kind d) (DRule))
                  (let [(mut apps) (ArrayList::new [i64] (rt/value-allocator))
                        infos (alt-infos (mut g) d (mut m))]
                    (for i (range 0 (len (.alts d)))
                      (when (start-has? (.start (get infos i)) x)
                        (push! (mut apps) i)))
                    (let [only (if (= (len apps) 1) (bare-ref g (get (.alts d) (get apps 0))) "")]
                      (if (and (> (len only) 0)
                               (not (.two (get infos (get apps 0)))))
                          (plan-ref (mut g) only x (+ depth 1) lists (mut m))
                          ;; A few rules' choices are laid out in a function, one inside
                          ;; another: one further down is that rule's own function to make.
                          (if (>= lists (plan-most))
                              (run-of `(~(rule-sym name) (mut p) (mut out)))
                              (run-of `(let [save (.pos p)]
                                         ~(plan-alts (mut g) d apps 0 x depth lists (mut m))))))))
                :else (run-of `(~(rule-sym name) (mut p) (mut out)))))))

;;; What asking for rule `name` does at byte `x`. A memoized rule is asked through its memo, and a
;;; token, or a rule too far down, by its function.
(defn plan-ref [(g (mut Grammar)) (name (slice u8)) (x i64) (depth i64) (lists i64) (m (mut FirstMemo))] (-> Run)
  (match (find-decl g name)
    (None [] (panic "no rule named {}" name))
    (Some [d]
          (if (or (.memo d) (> depth 24) (not (or (chain? d) (= (.kind d) (DRule)))))
              (run-of `(~(rule-sym name) (mut p) (mut out)))
              (plan-run (mut g) name x depth lists (mut m))))))

;;; What a layout asks of an alternative, for every byte: what it starts with, whether it has a
;;; two-token test, and the first tokens it may begin with.
(defstruct AltInfo [(start Start) (two bool) (leads Leads)])

(defn alt-infos [(g (mut Grammar)) (d Decl) (m (mut FirstMemo))] (-> (ArrayList AltInfo))
  (let [(mut at) -1]
    (for i (range 0 (len (.info-names g)))
      (when (= (get (.info-names g) i) (.name d)) (set! at i)))
    (if (>= at 0)
        (get (.infos g) at)
        (let [(mut out) (ArrayList::new [AltInfo] (rt/value-allocator))]
          (for a (.alts d)
            (push! (mut out)
                   (AltInfo
                     :start (pe-start g (.seq a) (mut m))
                     :two (is-some? (two-token-test (mut g) (.seq a) (mut m)))
                     :leads (leads-of g (.seq a) (unknown-start) 0 (mut m)))))
          (push! (mut (.info-names g)) (.name d))
          (push! (mut (.infos g)) out)
          out))))

;;; The literals alternative `info` can begin with when the next token's first byte is `x`: known
;;; where every way it begins is with a literal, and each of those has a second byte. A literal is
;;; matched at the token's start, so the alternative fails wherever the token does not begin with
;;; the bytes of one of them.
(defn lead-literals [(info AltInfo) (x i64)] (-> (Option (ArrayList (slice u8))))
  (let [ls (.leads info)
        (mut out) (empty-strs)
        (mut ok) (and (.ok ls) (not (.through ls)) (> (len (.items ls)) 0))]
    (for l (.items ls)
      (if (!= (.how l) 0)
          (set! ok false)
          (when (= (cast i64 (get (.name l) 0)) x)
            (if (< (len (.name l)) 2)
                (set! ok false)
                (add-unique! (mut out) (.name l))))))
    (if ok (Some out) (None [(ArrayList (slice u8))]))))

;;; A bool over `w`, the next token's first eight bytes: does it begin with `lit`, as far as
;;; eight bytes say?
(defn prefix-test [(lit (slice u8))] (-> Code)
  (let [n (if (< (len lit) 8) (len lit) 8)
        (mut value) 0
        (mut mask) 0]
    (for k (range 0 n)
      (set! value (| value (<< (cast i64 (get lit k)) (* 8 k))))
      (set! mask (| mask (<< 255 (* 8 k)))))
    (if (= n 8)
        `(= w ~value)
        `(= (& w ~mask) ~value))))

;;; The alternatives of `d` that can begin at `x`, from the k-th of them on, in order.
(defn plan-alts [(g (mut Grammar)) (d Decl) (apps (ArrayList i64)) (k i64) (x i64) (depth i64)
                 (lists i64) (m (mut FirstMemo))] (-> Code)
  (if (>= k (len apps))
      `false
      (let [i (get apps k)
            a (get (.alts d) i)
            bare (bare-ref g a)
            body (if (> (len bare) 0)
                     (run-code (mut g) (plan-ref (mut g) bare x (+ depth 1) (+ lists 1) (mut m)) (mut m))
                     `(~(alt-sym (.name d) i) (mut p) (mut out)))
            rest (plan-alts (mut g) d apps (+ k 1) x depth lists (mut m))
            info (get (alt-infos (mut g) d (mut m)) i)
            two (if (.two info)
                    (Some `(~(two-sym (.name d) i) (mut p) c))
                    (None [Code]))
            second (match (lead-literals info x)
                     (Some [lits]
                           (set! (.plan-c2 g) true)
                           (let [(mut tests) (primitive/code-list-new)]
                             (for l lits (push! (mut tests) (prefix-test l)))
                             (Some `(or ~@tests false))))
                     (None [] (None [Code])))
            guard (match second
                    (Some [s2] (match two (Some [t] (Some `(and ~s2 ~t))) (None [] (Some s2))))
                    (None [] two))]
        (match guard
          (Some [test]
                `(let [tried ~test]
                   (if (and tried ~body)
                       true
                       (do
                         (when tried (rt/backtrack! (mut p) save))
                         ~rest))))
          (None []
                `(if ~body
                     true
                     (do
                       (rt/backtrack! (mut p) save)
                       ~rest)))))))

;;; The bytes an operator of chain `name` begins with; unknown when an alternative's is.
(defn rest-bytes [(g Grammar) (name (slice u8)) (m (mut FirstMemo))] (-> Bytes)
  (match (find-decl g name)
    (None [] (.bytes (unknown-start)))
    (Some [d]
          (if (= (.kind d) (DInfix))
              (infix-bytes d)
              (let [(mut out) (bytes-none)]
                (for a (.alts d)
                  (let [s (pe-start g (.seq a) (mut m))]
                    (if (and (.known (.bytes s)) (not (.empty s)))
                        (set! out (bytes-union out (.bytes s)))
                        (set! (.known out) false))))
                out)))))

(defn rest-call [(g Grammar) (name (slice u8))] (-> Code)
  (match (find-decl g name)
    (None [] (panic "no rule named {}" name))
    (Some [d]
          (if (= (.kind d) (DInfix))
              `(~(primitive/code-symbol (dsl/join3 "p-" name "-climb-rest")) (mut p) (mut out) 0)
              `(~(rest-sym name) (mut p) (mut out))))))

;;; The operators of the chains, innermost first: looked for at all only where the next byte begins
;;; one of some chain's, and then each chain's only where it begins one of its own. After a chain
;;; found one, the byte is looked at again.
;;; They are a function of their own for each list of chains, which every layout that ends in
;;; that list calls.
(defn rests-code [(g (mut Grammar)) (rests (ArrayList (slice u8))) (m (mut FirstMemo))] (-> Code)
  (let [(mut steps) (primitive/code-list-new)
        (mut all) (bytes-none)
        (mut name) "p-after"]
    (for r rests (set! name (dsl/join3 name "-" r)))
    (for i (range 0 (len rests))
      (let [own (rest-bytes g (get rests i) (mut m))
            call (rest-call g (get rests i))
            again (if (< (+ i 1) (len rests)) `(set! c (next-byte (mut p))) `0)]
        (set! all (bytes-union all own))
        (push! (mut steps)
               (if (.known own)
                   `(when ~(byte-test own) ~call ~again)
                   `(do ~call ~again)))))
    (unless (contains? (.rests-made g) name)
      (push! (mut (.rests-made g)) name)
      (add-aux! (mut g)
                `(defn ~(primitive/code-symbol name) :inline (Hint) [(p (mut rt/P)) (out (mut Node)) (first i64)] (-> void)
                   (let [(mut c) first] ~@steps))))
    ;; The one look that mostly finds no operator is taken where the operand was parsed: only an
    ;; operator's byte calls the function.
    (if (.known all)
        `(let [c (next-byte (mut p))]
           (when ~(byte-test all) (~(primitive/code-symbol name) (mut p) (mut out) c)))
        `(~(primitive/code-symbol name) (mut p) (mut out) (next-byte (mut p))))))

(defn run-code [(g (mut Grammar)) (r Run) (m (mut FirstMemo))] (-> Code)
  (if (= (len (.rests r)) 0)
      (.terminal r)
      `(if ~(.terminal r) (do ~(rests-code (mut g) (.rests r) (mut m)) true) false)))

;;; The byte of a table for the k-th layout: a printable one, and no quote or backslash.
(defn class-byte [(k i64)] (-> i64)
  (let [b (+ 48 k)]
    (when (> b 125) (panic "a rule has more layouts than the table has bytes for"))
    (if (>= b 92) (+ b 1) b)))

;;; What tells one layout from another: the alternatives tried and the rules gone through, as
;;; `plan-run` finds them, written to `out`. Bytes with the same key share a layout, and it is
;;; made once.
(defn key-text! [(out (mut (ArrayList u8))) (s (slice u8))] (-> void)
  (for ch s (push! (mut out) ch)))

(defn key-run! [(g (mut Grammar)) (name (slice u8)) (x i64) (depth i64) (lists i64) (m (mut FirstMemo))
                (out (mut (ArrayList u8)))] (-> void)
  (match (find-decl g name)
    (None [] (panic "no rule named {}" name))
    (Some [d]
          (cond (chain? d)
                  (do
                    (key-ref! (mut g) (.over d) x (+ depth 1) lists (mut m) (mut out))
                    (key-text! (mut out) "+")
                    (key-text! (mut out) name))
                (= (.kind d) (DRule))
                  (let [infos (alt-infos (mut g) d (mut m))
                        (mut count) 0
                        (mut first) -1]
                    (for i (range 0 (len (.alts d)))
                      (when (start-has? (.start (get infos i)) x)
                        (when (< first 0) (set! first i))
                        (set! count (+ count 1))))
                    (let [only (if (= count 1) (bare-ref g (get (.alts d) first)) "")]
                      (cond (and (> (len only) 0) (not (.two (get infos first))))
                              (key-ref! (mut g) only x (+ depth 1) lists (mut m) (mut out))
                            (>= lists (plan-most)) (key-text! (mut out) name)
                            :else
                              (do
                                (key-text! (mut out) "[")
                                (key-text! (mut out) name)
                                (key-text! (mut out) ":")
                                (for i (range 0 (len (.alts d)))
                                  (when (start-has? (.start (get infos i)) x)
                                    (let [bare (bare-ref g (get (.alts d) i))]
                                      (key-text! (mut out) (rt/num-text i))
                                      (key-text! (mut out) ",")
                                      (match (lead-literals (get infos i) x)
                                        (Some [lits]
                                              (for l lits
                                                (key-text! (mut out) l)
                                                (key-text! (mut out) "~")))
                                        (None [] 0))
                                      (when (> (len bare) 0)
                                        (key-ref! (mut g) bare x (+ depth 1) (+ lists 1) (mut m) (mut out))
                                        (key-text! (mut out) ";")))))
                                (key-text! (mut out) "]")))))
                :else (key-text! (mut out) name)))))

(defn key-ref! [(g (mut Grammar)) (name (slice u8)) (x i64) (depth i64) (lists i64) (m (mut FirstMemo))
                (out (mut (ArrayList u8)))] (-> void)
  (match (find-decl g name)
    (None [] (panic "no rule named {}" name))
    (Some [d]
          (if (or (.memo d) (> depth 24) (not (or (chain? d) (= (.kind d) (DRule)))))
              (key-text! (mut out) name)
              (key-run! (mut g) name x depth lists (mut m) (mut out))))))

;;; Whether a layout can say more than the rule's alternatives in order do: a chain's can, and a
;;; rule's that passes another rule or a token on.
(defn plans? [(g Grammar) (d Decl)] (-> bool)
  (or (chain? d)
      (let [(mut hit) false]
        (for a (.alts d)
          (when (> (len (bare-ref g a)) 0) (set! hit true)))
        hit)))

;;; The code of the class of `c`, the next token's first byte: `table` gives each byte's class
;;; (from -1, the end of input), `codes` each class's code.
(defn by-class [(table (ArrayList u8)) (codes (ArrayList Code))] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for i (range 0 (- (len codes) 1))
      (let [b (class-byte i)] (push! (mut arms) `~b))
      (push! (mut arms) (get codes i)))
    `(case (cast i64 (get ~(slice table) (+ c 1)))
       ~@arms
       ~(get codes (- (len codes) 1)))))

;;; A rule's fast body: its layout for each byte the next token may begin with, the bytes that
;;; share one finding it through a table.
(defn plan-dispatch [(g (mut Grammar)) (d Decl) (m (mut FirstMemo))] (-> Code)
  (let [(mut keys) (empty-strs)
        (mut codes) (ArrayList::new [Code] (rt/value-allocator))
        (mut table) (ArrayList::new [u8] (rt/value-allocator))
        (mut scratch) (ArrayList::new [u8] (rt/value-allocator))]
    (set! (.plan-c2 g) false)
    ;; The table starts at -1, the end of input.
    (for x (range -1 256)
      (let [(mut at) -1]
        (clear! (mut scratch))
        (key-run! (mut g) (.name d) x 0 0 (mut m) (mut scratch))
        (for i (range 0 (len keys))
          (when (= (get keys i) (slice scratch)) (set! at i)))
        (when (< at 0)
          (set! at (len keys))
          (push! (mut keys) (dsl/join2 (slice scratch) ""))
          (push! (mut codes) (run-code (mut g) (plan-run (mut g) (.name d) x 0 0 (mut m)) (mut m))))
        (push! (mut table) (cast u8 (class-byte at)))))
    (let [heads (if (.plan-c2 g)
                    `(c (next-byte (mut p)) w (next-word (mut p)))
                    `(c (next-byte (mut p))))]
      (if (= (len codes) 1)
          `(let [~@heads] ~(get codes 0))
          `(let [~@heads] ~(by-class table codes))))))

;;; Alternatives in order, each tried only when the next token's first byte is one it can begin with.
(defn guarded-alts [(name (slice u8))
                    (guards (ArrayList Code))
                    (guarded (ArrayList bool))
                    (i i64)] (-> Code)
  (if (>= i (len guards))
      `false
      (let [g (get guards i)
            alt `(~(alt-sym name i) (mut p) (mut out))
            rest (guarded-alts name guards guarded (+ i 1))]
        ;; An alternative its guard turns away was never begun: nothing moved, so nothing is
        ;; put back, and the next guard is one look at the same byte.
        (if (get guarded i)
            `(let [tried (or ~g (.careful p))]
               (if (and tried ~alt)
                   true
                   (do
                     (when tried (rt/backtrack! (mut p) save))
                     ~rest)))
            `(if ~alt
                 true
                 (do
                   (rt/backtrack! (mut p) save)
                   ~rest))))))

;;; Each alternative's guard: a test of `c`, the next token's first byte, when what it begins with
;;; is known and it cannot match nothing; whether there is one; and whether any alternative has one.
(defstruct Guards [(tests (ArrayList Code)) (guarded (ArrayList bool)) (any bool)])

(defn alt-guards [(g (mut Grammar)) (d Decl) (memo (mut FirstMemo))] (-> Guards)
  (let [(mut tests) (ArrayList::new [Code] (rt/value-allocator))
        (mut guarded) (ArrayList::new [bool] (rt/value-allocator))
        (mut any) false]
    (for a (.alts d)
      (let [s (pe-start g (.seq a) (mut memo))
            known (and (.known (.bytes s)) (not (.empty s)))
            two (two-token-test (mut g) (.seq a) (mut memo))]
        (push! (mut tests)
               (match two
                 (Some [t] (if known `(and ~(byte-test (.bytes s)) ~t) t))
                 (None [] (if known (byte-test (.bytes s)) `true))))
        (push! (mut guarded) (or known (is-some? two)))
        (when (or known (is-some? two)) (set! any true))))
    (Guards :tests tests :guarded guarded :any any)))

(defn is-some? [(o (Option Code))] (-> bool)
  (match o (Some [_] true) (None [] false)))

;; ---------------------------------------------------------------- two tokens
;;;
;;; An alternative that must begin with a token, and whose next token must begin with one of a few
;;; bytes, is tried only where both hold: `x:` is a label, `x =>` an arrow, and `x;` neither, seen
;;; by one look at a token the parse lexes anyway (the token cache keeps it) and one at the byte
;;; after. Where it can begin otherwise too, or what follows is not known, there is no such test.

;;; A first token an expression may begin with, and the bytes the token after it begins with. Its
;;; `how`: 0 a literal, 1 a token rule, 2 a fragment matched in a rule (space, then its bytes).
(defstruct Lead [(name (slice u8)) (how i64) (follow Start)])

;;; The first tokens an expression may begin with; `through`: it may match nothing, and what
;;; follows it begins instead; `ok`: every way it can begin is one of these.
(defstruct Leads [(items (ArrayList Lead)) (through bool) (ok bool)])

(defn leads-unknown [] (-> Leads)
  (Leads :items (ArrayList::new [Lead] (rt/value-allocator)) :through false :ok false))

(defn leads-empty [] (-> Leads)
  (Leads :items (ArrayList::new [Lead] (rt/value-allocator)) :through true :ok true))

(defn leads-one [(name (slice u8)) (how i64) (follow Start)] (-> Leads)
  (let [(mut items) (ArrayList::new [Lead] (rt/value-allocator))]
    (push! (mut items) (Lead :name name :how how :follow follow))
    (Leads :items items :through false :ok true)))

;;; Where a starts, then b if a may match nothing: `cont` after `e`.
(defn then-start [(g Grammar) (e PE) (cont Start) (m (mut FirstMemo))] (-> Start)
  (seq-start (pe-start g e (mut m)) cont))

(defn leads-of [(g Grammar) (e PE) (cont Start) (depth i64) (m (mut FirstMemo))] (-> Leads)
  (if (> depth 8)
      (leads-unknown)
      (match (.op e)
        (OLit [] (leads-one (.text e) 0 cont))
        (ORef []
              (match (find-decl g (.text e))
                (None [] (leads-unknown))
                (Some [d]
                      (cond (= (.kind d) (DToken)) (leads-one (.name d) 1 cont)
                            (= (.kind d) (DFragment)) (leads-one (.name d) 2 cont)
                            (= (.kind d) (DHidden)) (leads-of g (.body d) cont (+ depth 1) (mut m))
                            (= (.kind d) (DRule))
                              (let [(mut out) (leads-empty)]
                                (set! (.through out) false)
                                (for a (.alts d)
                                  (set! out (leads-or out (leads-of g (.seq a) cont (+ depth 1) (mut m)))))
                                out)
                            :else (leads-unknown)))))
        (OSeq []
              (let [items (.kids e)
                    (mut out) (leads-empty)
                    (mut i) 0]
                (while (and (.ok out) (.through out) (< i (len items)))
                  (let [(mut rest) cont]
                    (for j (range 0 (- (len items) (+ i 1)))
                      (set! rest (then-start g (get items (- (len items) (+ j 1))) rest (mut m))))
                    (let [one (leads-of g (get items i) rest (+ depth 1) (mut m))]
                      (set! (.ok out) (.ok one))
                      (for l (.items one) (push! (mut (.items out)) l))
                      (set! (.through out) (.through one))))
                  (set! i (+ i 1)))
                out))
        (OChoice []
                 (let [(mut out) (leads-empty)]
                   (set! (.through out) false)
                   (for k (.kids e)
                     (set! out (leads-or out (leads-of g k cont (+ depth 1) (mut m)))))
                   out))
        (OOpt [] (leads-maybe (leads-of g (get (.kids e) 0) cont (+ depth 1) (mut m))))
        (OStar []
               (let [inner (get (.kids e) 0)]
                 (leads-maybe (leads-of g inner (start-or (pe-start g inner (mut m)) cont) (+ depth 1) (mut m)))))
        (OPlus []
               (let [inner (get (.kids e) 0)]
                 (leads-of g inner (start-or (pe-start g inner (mut m)) cont) (+ depth 1) (mut m))))
        (OSepStar [] (leads-maybe (leads-of g (get (.kids e) 0) (start-or (comma-start) cont) (+ depth 1) (mut m))))
        (OSepPlus [] (leads-of g (get (.kids e) 0) (start-or (comma-start) cont) (+ depth 1) (mut m)))
        (OWith [] (leads-of g (get (.kids e) 0) cont depth (mut m)))
        (OKeep [] (leads-of g (get (.kids e) 0) cont depth (mut m)))
        ;; Zero width: tests that may only rule more out.
        (OIf [] (leads-empty))
        (OUnless [] (leads-empty))
        (ONot [] (leads-empty))
        (OAnd [] (leads-empty))
        (ONl [] (leads-empty))
        (ONoNl [] (leads-empty))
        (_ (leads-unknown)))))

(defn leads-or [(a Leads) (b Leads)] (-> Leads)
  (let [(mut items) (ArrayList::new [Lead] (rt/value-allocator))]
    (for l (.items a) (push! (mut items) l))
    (for l (.items b) (push! (mut items) l))
    (Leads :items items :through (or (.through a) (.through b)) :ok (and (.ok a) (.ok b)))))

(defn leads-maybe [(a Leads)] (-> Leads)
  (Leads :items (.items a) :through true :ok (.ok a)))

;;; What may begin either: the bytes of both.
(defn start-or [(a Start) (b Start)] (-> Start)
  (start-union a b (.empty b)))

(defn comma-start [] (-> Start)
  (lit-start ","))

;;; A test of `c`, the next byte, that the lead's first token can begin with it.
(defn lead-first-test [(g Grammar) (l Lead) (m (mut FirstMemo))] (-> Code)
  (let [start (if (= (.how l) 0)
                  (lit-start (.name l))
                  (rule-start g (.name l) (mut m)))]
    (if (and (.known (.bytes start)) (not (.empty start)))
        (byte-test (.bytes start))
        `true)))

;;; Code matching a lead's first token here, space before it skipped as a rule would.
(defn lead-match [(g (mut Grammar)) (l Lead)] (-> Code)
  (cond (= (.how l) 0) `(~(lit-sym (lit-id (mut g) (.name l))) (mut p))
        (= (.how l) 2) `(do (skip! (mut p)) (~(lex-sym (.name l)) (mut p)))
        :else
          (let [raw (match (find-decl g (.name l)) (Some [d] (.raw d)) (None [] false))]
            (if raw
                `(~(token-sym (.name l)) (mut p))
                `(do (skip! (mut p)) (~(token-sym (.name l)) (mut p)))))))

(defn every-byte? [(b Bytes)] (-> bool)
  (and (= (.w0 b) -1) (= (.w1 b) -1) (= (.w2 b) -1) (= (.w3 b) -1)))

;;; A bool: can what follows a lead's first token begin here? By the next token's first byte; and
;;; where all that may follow is literals, by their bytes, as far as eight say (`x =>` is an arrow,
;;; `x = 1` is not).
(defn follow-test [(follow Start)] (-> Code)
  (if (and (.plain follow) (> (len (.lits follow)) 0))
      (let [(mut tests) (primitive/code-list-new)]
        (for l (.lits follow) (push! (mut tests) (prefix-test l)))
        `(let [c (next-byte (mut p))]
           (and ~(byte-test (.bytes follow))
                (let [w (next-word (mut p))] (or ~@tests false)))))
      `(let [c (next-byte (mut p))] ~(byte-test (.bytes follow)))))

;;; The two-token test of an alternative, where there is one worth making: it must begin with one
;;; of a few first tokens, one a token rule, each with a known and narrow next byte.
(defn two-token-test [(g (mut Grammar)) (e PE) (m (mut FirstMemo))] (-> (Option Code))
  (let [ls (leads-of g e (unknown-start) 0 (mut m))
        (mut useful) (and (.ok ls) (not (.through ls)) (> (len (.items ls)) 0) (<= (len (.items ls)) 6))
        (mut any-token) false]
    (for l (.items ls)
      (when (= (.how l) 1) (set! any-token true))
      (unless (and (.known (.bytes (.follow l)))
                   (not (.empty (.follow l)))
                   (not (every-byte? (.bytes (.follow l)))))
        (set! useful false)))
    (if (and useful any-token)
        (let [(mut arms) (primitive/code-list-new)]
          (for l (.items ls)
            (push! (mut arms)
                   `(and ~(lead-first-test g l (mut m))
                         (do (set! (.pos p) s) true)
                         ~(lead-match (mut g) l)
                         ~(follow-test (.follow l)))))
          (Some `(let [s (.pos p)
                       hit (or ~@arms)]
                   (set! (.pos p) s)
                   hit)))
        (None [Code]))))

;;; One step of a chain, by the byte the next token begins with: only the alternatives that can
;;; begin there, in order, found through a table as a rule's layouts are. `save` is the position.
(defn step-dispatch [(g (mut Grammar)) (d Decl) (m (mut FirstMemo))] (-> Code)
  (let [(mut keys) (empty-strs)
        (mut codes) (ArrayList::new [Code] (rt/value-allocator))
        (mut table) (ArrayList::new [u8] (rt/value-allocator))
        (mut scratch) (ArrayList::new [u8] (rt/value-allocator))
        infos (alt-infos (mut g) d (mut m))]
    (set! (.plan-c2 g) false)
    (for x (range -1 256)
      (let [(mut at) -1
            (mut apps) (ArrayList::new [i64] (rt/value-allocator))]
        (clear! (mut scratch))
        (for i (range 0 (len (.alts d)))
          (when (start-has? (.start (get infos i)) x)
            (push! (mut apps) i)
            (key-text! (mut scratch) (rt/num-text i))
            (key-text! (mut scratch) ",")
            (match (lead-literals (get infos i) x)
              (Some [lits]
                    (for l lits
                      (key-text! (mut scratch) l)
                      (key-text! (mut scratch) "~")))
              (None [] 0))))
        (for i (range 0 (len keys))
          (when (= (get keys i) (slice scratch)) (set! at i)))
        (when (< at 0)
          (set! at (len keys))
          (push! (mut keys) (dsl/join2 (slice scratch) ""))
          (push! (mut codes) (plan-alts (mut g) d apps 0 x 0 (plan-most) (mut m))))
        (push! (mut table) (cast u8 (class-byte at)))))
    (let [heads (if (.plan-c2 g)
                    `(c (next-byte (mut p)) w (next-word (mut p)))
                    `(c (next-byte (mut p))))]
      (if (= (len codes) 1)
          `(let [~@heads] ~(get codes 0))
          `(let [~@heads] ~(by-class table codes))))))

;;; A base, then alternatives that extend it: repeatedly, or at most once. The extending is a
;;; function of its own, `p-X-rest`, which finds the base in `out`: a layout calls it after
;;; whatever it found the base to be.
(defn emit-chain! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl) (repeat bool) (memo (mut FirstMemo))]
  (-> void)
  (for i (range 0 (len (.alts d)))
    (emit-alt-fn! (mut g) (mut c) (.name d) i (get (.alts d) i) 1))
  (emit-two-fns! (mut g) d (mut memo))
  ;; After each step, an alternative is tried only if the next token can begin it: most of what
  ;; follows a call, `,` `)` `;`, begins none, and the loop ends on one look at the next byte.
  (let [gs (alt-guards (mut g) d (mut memo))
        step (if (.any gs)
                 `(let [c (next-byte (mut p))]
                    ~(guarded-alts (.name d) (.tests gs) (.guarded gs) 0))
                 (try-alts (.name d) 0 (len (.alts d))))]
    (let [fast (step-dispatch (mut g) d (mut memo))
          either `(if (.careful p) ~step ~fast)]
      (add-aux! (mut g)
                `(defn ~(rest-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> void)
                   ~(if repeat
                        `(let [(mut go) true]
                           (while go
                             (let [save (.pos p)]
                               (unless ~either
                                 (rt/backtrack! (mut p) save)
                                 (set! go false)))))
                        `(let [save (.pos p)]
                           (unless ~either (rt/backtrack! (mut p) save)))))))
    (emit-rule-fn! (mut g)
                   d
                   `(if (~(rule-sym (.over d)) (mut p) (mut out))
                        (do (~(rest-sym (.name d)) (mut p) (mut out)) true)
                        false)
                   (mut memo))))

;;; An infix declaration is parsed by climbing: one loop over the operators of every level, each
;;; level's right operand parsed by the same loop with only tighter levels allowed. The tree is the
;;; one a rule per level makes (`left` levels: `a - b - c` is `(a - b) - c`), with one call for an
;;; operand where a rule per level takes one call per level.
(defn climb-sym [(name (slice u8))] (-> Code)
  (primitive/code-symbol (dsl/join3 "p-" name "-climb")))

;;; The bytes the operators of every level begin with, dropped ones too.
(defn infix-bytes [(d Decl)] (-> Bytes)
  (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)]
    (for op (.ops d)
      (let [b (cast i64 (get (.lit op) 0))] (push! (mut (.ranges f)) (Range :lo b :hi b))))
    (for dr (.drops d)
      (let [b (cast i64 (get (.lit dr) 0))] (push! (mut (.ranges f)) (Range :lo b :hi b))))
    (bytes-of-first f)))

;;; The right operand of an operator of `level`: the operand alone at the tightest level, else
;;; what binds tighter than it.
(defn right-operand [(d Decl) (level i64) (top i64) (target Code)] (-> Code)
  (if (= level top)
      `(~(rule-sym (.over d)) (mut p) ~target)
      `(~(climb-sym (.name d)) (mut p) ~target ~(+ level 1))))

;;; The operators of `level` and below, tightest first and each level's dropped operators after
;;; its own, as a rule per level tries them. One that binds looser than `min` is left for the
;;; loop that called this one.
;;; `only`: the byte the operator must begin with, or -1 for any.
(defn climb-arms [(g (mut Grammar)) (d Decl) (level i64) (top i64) (only i64)] (-> Code)
  (if (< level 0)
      `(set! go false)
      (op-arms (mut g) d 0 level top only)))

(defn begins-with? [(lit (slice u8)) (only i64)] (-> bool)
  (or (< only 0) (= (cast i64 (get lit 0)) only)))

(defn op-arms [(g (mut Grammar)) (d Decl) (i i64) (level i64) (top i64) (only i64)] (-> Code)
  (cond (>= i (len (.ops d))) (dropped-arms (mut g) d 0 level top only)
        (or (!= (.level (get (.ops d) i)) level) (not (begins-with? (.lit (get (.ops d) i)) only)))
          (op-arms (mut g) d (+ i 1) level top only)
        :else
          (let [op (get (.ops d) i)
                test `(~(lit-sym (lit-id (mut g) (.lit op))) (mut p))
                guarded
                  (if (> (len (.unless-flag op)) 0)
                      `(and (not (rt/flag? (mut p) ~(flag-sym (.unless-flag op)))) ~test)
                      test)]
            `(if (and (>= ~level min) ~guarded)
                 (let [(mut r) (primitive/zeroed Node)]
                   (if ~(right-operand d level top `(mut r))
                       (set! out (node2-in (mut p) (~(kind-sym (.kind op))) out r))
                       (do (rt/backtrack! (mut p) save) (set! go false))))
                 ~(op-arms (mut g) d (+ i 1) level top only)))))

;;; A dropped operator is matched and what follows it thrown away; the left side stays, and any
;;; operator not looser than `min` may follow, as in `a as T + b`.
(defn dropped-arms [(g (mut Grammar)) (d Decl) (i i64) (level i64) (top i64) (only i64)] (-> Code)
  (cond (>= i (len (.drops d))) (climb-arms (mut g) d (- level 1) top only)
        (or (!= (.level (get (.drops d) i)) level) (not (begins-with? (.lit (get (.drops d) i)) only)))
          (dropped-arms (mut g) d (+ i 1) level top only)
        :else
          (let [dr (get (.drops d) i)
                flag (if (> (len (.flag dr)) 0) `(rt/flag? (mut p) ~(flag-sym (.flag dr))) `true)
                nonl (if (.nonl dr) `(not (newline-ahead? (mut p))) `true)]
            `(if (and (>= ~level min)
                      ~flag
                      ~nonl
                      (~(lit-sym (lit-id (mut g) (.lit dr))) (mut p))
                      (~(hidden-sym (.rule dr)) (mut p)))
                 0
                 (do
                   (rt/backtrack! (mut p) save)
                   ~(dropped-arms (mut g) d (+ i 1) level top only))))))

;;; For each byte an operator begins with, the byte and the operators that begin with it, as
;;; the arms of a `case`.
(defn arms-by-byte [(g (mut Grammar)) (d Decl) (top i64)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        set (infix-bytes d)]
    (for b (range 0 256)
      (when (bytes-has? set b)
        (push! (mut out) `~b)
        (push! (mut out) (climb-arms (mut g) d top top b))))
    `(~@out)))

(defn emit-infix! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl) (memo (mut FirstMemo))] (-> void)
  (let [(mut top) 0
        rest (primitive/code-symbol (dsl/join3 "p-" (.name d) "-climb-rest"))]
    (for op (.ops d) (when (> (.level op) top) (set! top (.level op))))
    (for dr (.drops d) (when (> (.level dr) top) (set! top (.level dr))))
    ;; The operators after an operand already in `out`.
    (add-aux! (mut g)
              `(defn ~rest [(p (mut rt/P)) (out (mut Node)) (min i64)] (-> void)
                 (let [(mut go) true]
                   (while go
                     ;; Only a byte some operator begins with goes on: after most
                     ;; operands none does, and no operator is tried at all.
                     ;; And of the operators, only those that begin with that byte are tried.
                     (let [save (.pos p)
                           c (next-byte (mut p))]
                       (if (.careful p)
                           ~(climb-arms (mut g) d top top -1)
                           (case c ~@(arms-by-byte (mut g) d top) (set! go false))))))))
    (add-aux! (mut g)
              `(defn ~(climb-sym (.name d)) [(p (mut rt/P)) (out (mut Node)) (min i64)] (-> bool)
                 (if (not (~(rule-sym (.over d)) (mut p) (mut out)))
                     false
                     (do (~rest (mut p) (mut out) min) true))))
    (emit-rule-fn! (mut g)
                   d
                   `(~(climb-sym (.name d)) (mut p) (mut out) 0)
                   (mut memo))))

(defn emit-reps! [(g (mut Grammar))] (-> void)
  (for n (.reps g)
    (add-aux! (mut g)
              `(defn ~(rep-sym n) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 (let [base (stack-height (mut p))
                       (mut go) true
                       (mut v) (primitive/zeroed Node)
                       lo (.pos p)]
                   (while go
                     (let [save (.pos p)]
                       (if (~(rule-sym n) (mut p) (mut v))
                           (stack-push! (mut p) (mut v))
                           (do (rt/backtrack! (mut p) save) (set! go false)))))
                   (list-node! (mut p) (mut out) base lo)
                   true)))
    (add-aux! (mut g)
              `(defn ~(rep1-sym n) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 (and (~(rep-sym n) (mut p) (mut out)) (> (len (.kids out)) 0))))
    ;; X,* : zero or more, trailing comma allowed.
    (add-aux! (mut g)
              `(defn ~(sep-sym n) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 (let [base (stack-height (mut p))
                       (mut go) true
                       (mut v) (primitive/zeroed Node)
                       lo (.pos p)]
                   (while go
                     (let [save (.pos p)]
                       (if (~(rule-sym n) (mut p) (mut v))
                           (do
                             (stack-push! (mut p) (mut v))
                             (unless (comma! (mut p)) (set! go false)))
                           (do (rt/backtrack! (mut p) save) (set! go false)))))
                   (list-node! (mut p) (mut out) base lo)
                   true)))
    ;; X,+ : one or more, no trailing comma.
    (add-aux! (mut g)
              `(defn ~(sep1-sym n) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 (let [lo (.pos p)
                       base (stack-height (mut p))
                       (mut v) (primitive/zeroed Node)]
                   (if (not (~(rule-sym n) (mut p) (mut v)))
                       false
                       (let [(mut go) true]
                         (stack-push! (mut p) (mut v))
                         (while go
                           (let [save (.pos p)]
                             (if (and (comma! (mut p)) (~(rule-sym n) (mut p) (mut v)))
                                 (stack-push! (mut p) (mut v))
                                 (do
                                   (rt/backtrack! (mut p) save)
                                   (set! go false)))))
                         (list-node! (mut p) (mut out) base lo)
                         true)))))))

;;; Two parsing expressions alike in every part.
(defn pe-same? [(a PE) (b PE)] (-> bool)
  (and (= (.op a) (.op b))
       (= (.text a) (.text b))
       (= (.neg a) (.neg b))
       (= (len (.ranges a)) (len (.ranges b)))
       (block :ranges
         (for i (range 0 (len (.ranges a)))
           (let [x (get (.ranges a) i) y (get (.ranges b) i)]
             (unless (and (= (.lo x) (.lo y)) (= (.hi x) (.hi y))) (return-from :ranges false))))
         true)
       (same-strs? (.on a) (.on b))
       (same-strs? (.off a) (.off b))
       (= (len (.kids a)) (len (.kids b)))
       (block :kids
         (for i (range 0 (len (.kids a)))
           (unless (pe-same? (get (.kids a) i) (get (.kids b) i)) (return-from :kids false)))
         true)))

;;; Which body a token has, as the first token with that body: tokens that are the same bytes
;;; (an identifier where a name is bound, read, or labels) share what was last lexed.
(defn token-body-id [(g Grammar) (d Decl)] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len (.decls g)))
      (let [e (get (.decls g) i)]
        (when (and (< out 0) (= (.kind e) (DToken)) (pe-same? (.body e) (.body d)))
          (set! out i))))
    out))

(defn emit-token! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl)] (-> void)
  (add-aux! (mut g)
            `(defn ~(lex-sym (.name d)) [(p (mut rt/P))] (-> bool)
               ~(lex-code g (mut c) (.body d))))
  (when (= (.kind d) (DToken))
    ;; The token here (space already skipped), moving past it where it matches. Lexed here
    ;; already, as this body, by the last token asked for: its end, without lexing again.
    (add-aux! (mut g)
              `(defn ~(token-sym (.name d)) :inline (Always) [(p (mut rt/P))] (-> bool)
                 (let [start (.pos p)]
                   (if (and (= (.tok-at p) start) (= (.tok-id p) ~(token-body-id g d)))
                       (do (set! (.pos p) (.tok-end p)) (.tok-ok p))
                       (let [ok (~(lex-sym (.name d)) (mut p))]
                         (set! (.tok-at p) start)
                         (set! (.tok-id p) ~(token-body-id g d))
                         (set! (.tok-end p) (.pos p))
                         (set! (.tok-ok p) ok)
                         ok)))))
    (add-aux! (mut g)
              `(defn ~(rule-sym (.name d)) [(p (mut rt/P)) (out (mut Node))] (-> bool)
                 (let [before (.pos p)]
                   ~(if (.raw d) `0 `(skip! (mut p)))
                   (let [start (.pos p)
                         matched (~(token-sym (.name d)) (mut p))]
                     (if matched
                         (do
                           (set! out (leaf-in (mut p) (~(kind-sym (.name d)))
                                              (rt/span (mut p) start (.pos p))
                                              start
                                              (.pos p)))
                           true)
                         (do
                           (rt/note-fail! (mut p) ~(.name d))
                           (set! (.pos p) before)
                           false))))))))

;;; Whether `e` cannot match while flag `f` is off: it tests the flag, or something it needs does.
(defn fails-without? [(g Grammar) (e PE) (f (slice u8)) (depth i64)] (-> bool)
  (match (.op e)
    (OIf [] (= (.text e) f))
    (OSeq []
          (let [(mut hit) false]
            (for k (.kids e) (when (fails-without? g k f depth) (set! hit true)))
            hit))
    (OChoice []
             (let [(mut all) true]
               (for k (.kids e) (unless (fails-without? g k f depth) (set! all false)))
               all))
    (OPlus [] (fails-without? g (get (.kids e) 0) f depth))
    (ORef []
          (if (> depth 8)
              false
              (match (find-decl g (.text e))
                (Some [d] (and (= (.kind d) (DHidden)) (fails-without? g (.body d) f (+ depth 1))))
                (None [] false))))
    (_ false)))

;;; Whether `e` matches, and takes nothing, while flag `f` is off: it is optional things that
;;; need the flag.
(defn nothing-without? [(g Grammar) (e PE) (f (slice u8)) (depth i64)] (-> bool)
  (match (.op e)
    (OOpt [] (fails-without? g (get (.kids e) 0) f depth))
    (OStar [] (fails-without? g (get (.kids e) 0) f depth))
    (OSeq []
          (let [(mut all) true]
            (for k (.kids e) (unless (nothing-without? g k f depth) (set! all false)))
            all))
    (ORef []
          (if (> depth 8)
              false
              (match (find-decl g (.text e))
                (Some [d] (and (= (.kind d) (DHidden)) (nothing-without? g (.body d) f (+ depth 1))))
                (None [] false))))
    (_ false)))

;;; A hidden rule's function. One that is nothing while a flag is off (a language's extension to
;;; another, under its flag) answers at once then, where it is asked: only with the flag on is
;;; anything called.
(defn emit-hidden! [(g (mut Grammar)) (c (mut dsl/Cur)) (d Decl)] (-> void)
  (let [body `(let [s (.pos p)]
                (if ~(rec-code (mut g) (mut c) (.body d))
                    true
                    (do (rt/backtrack! (mut p) s) false)))
        (mut flag) ""
        (mut answer) false]
    (for f (.flags g)
      (when (= (len flag) 0)
        (cond (nothing-without? g (.body d) f 0) (do (set! flag f) (set! answer true))
              (fails-without? g (.body d) f 0) (do (set! flag f) (set! answer false))
              :else 0)))
    (if (= (len flag) 0)
        (add-aux! (mut g)
                  `(defn ~(hidden-sym (.name d)) [(p (mut rt/P))] (-> bool) ~body))
        (let [full (primitive/code-symbol (dsl/join3 "h-" (.name d) "-on"))]
          (add-aux! (mut g)
                    `(defn ~full :inline (Never) [(p (mut rt/P))] (-> bool) ~body))
          (add-aux! (mut g)
                    `(defn ~(hidden-sym (.name d)) :inline (Always) [(p (mut rt/P))] (-> bool)
                       (if (rt/flag? (mut p) ~(flag-sym flag))
                           (~full (mut p))
                           ~(if answer `true `false))))))))

;;; The bytes a punctuation literal may not stand before (`notbefore`), or "".
(defn not-before-of [(g Grammar) (text (slice u8))] (-> (slice u8))
  (let [(mut out) ""]
    (for i (range 0 (/ (len (.not-before g)) 2))
      (when (= (get (.not-before g) (* 2 i)) text)
        (set! out (get (.not-before g) (+ (* 2 i) 1)))))
    out))

;;; A word literal may not run into the next character; punctuation may not be a
;;; prefix of a longer literal that also matches here, nor stand before the bytes `notbefore`
;;; says it may not (where the longer literal is no token, this one may be).
(defn emit-lit! [(g (mut Grammar)) (c (mut dsl/Cur)) (l Lit)] (-> void)
  (let [(mut guards) (primitive/code-list-new)
        own-stop (not-before-of g (.text l))]
    (when (> (len own-stop) 0)
      (push! (mut guards) `(not (rt/followed-by-any? (mut p) ~(len (.text l)) ~own-stop))))
    (if (word-literal? (.text l))
        (push! (mut guards)
               `(let [e (.pos p)
                      more
                        (do
                          (rt/advance! (mut p) ~(len (.text l)))
                          ~(lex-code-of g (mut c) (pe-new (ORef) (.word g) (.tok (get (.decls g) 0)))))]
                  (set! (.pos p) e)
                  (not more)))
        (for other (.lits g)
          (when (and (> (len (.text other)) (len (.text l)))
                     (not (word-literal? (.text other)))
                     (rt/at? (.text other) 0 (.text l)))
            (let [stop (not-before-of g (.text other))]
              (if (> (len stop) 0)
                  (push! (mut guards)
                         `(not (and (rt/at-bytes? (mut p) ~(.text other))
                                    (not (rt/followed-by-any? (mut p) ~(len (.text other)) ~stop)))))
                  (push! (mut guards) `(not (rt/at-bytes? (mut p) ~(.text other)))))))))
    (add-aux! (mut g)
              `(defn ~(primitive/code-symbol "lit-full-" (.id l)) :inline (Never) [(p (mut rt/P))] (-> bool)
                 (let [s (.pos p)]
                   (skip! (mut p))
                   (if (and ~(bytes-test (.text l)) ~@guards true)
                       (do (rt/advance! (mut p) ~(len (.text l))) true)
                       (do
                         (rt/note-fail! (mut p) ~(.text l))
                         (set! (.pos p) s)
                         false)))))
    ;; Most tries of a literal are made where the space before the next token was just found:
    ;; then its first byte is one load away. Most fail on that byte, and nothing is called; and a
    ;; literal of one byte that nothing else restricts matches on it, and nothing is called either.
    (let [simple (and (= (len (.text l)) 1)
                      (= (len own-stop) 0)
                      (not (word-literal? (.text l)))
                      (block :alone
                        (for other (.lits g)
                          (when (and (> (len (.text other)) 1)
                                     (not (word-literal? (.text other)))
                                     (rt/at? (.text other) 0 (.text l)))
                            (return-from :alone false)))
                        true))]
      (add-aux! (mut g)
                `(defn ~(lit-sym (.id l)) [(p (mut rt/P))] (-> bool)
                   (if (and (= (.ws-from p) (.pos p)) (not (.careful p)))
                       (if (= (byte-at (mut p) (.ws-to p)) ~(cast i64 (get (.text l) 0)))
                           ~(if simple
                                `(do (set! (.pos p) (+ (.ws-to p) 1)) true)
                                `(~(primitive/code-symbol "lit-full-" (.id l)) (mut p)))
                           false)
                       (~(primitive/code-symbol "lit-full-" (.id l)) (mut p))))))))

;; ---------------------------------------------------------------- printing code

;;; The rule a capture refers to, through `with` and `~`.
(defn captured-ref [(e PE)] (-> (slice u8))
  (match (.op e)
    (ORef [] (.text e))
    (OWith [] (captured-ref (get (.kids e) 0)))
    (OKeep [] (captured-ref (get (.kids e) 0)))
    (_ "")))

;;; The precedence a position naming this rule requires. A rule outside the chain
;;; that only passes something through, like `Arg = … | Assign`, requires what it
;;; passes through, or `f((a, b))` would lose its parentheses.
(defn rule-level [(g Grammar)
                  (levels (ArrayList Named))
                  (name (slice u8))
                  (depth i64)] (-> i64)
  (let [(mut out) (named-value levels name)]
    (when (and (= out 0) (< depth 16))
      (match (find-decl g name)
        (Some [d]
              (when (= (.kind d) (DRule))
                (for a (.alts d)
                  (when (= (len (.label a)) 0)
                    (for it (seq-items (.seq a))
                      (let [r (captured-ref it)]
                        (when (> (len r) 0)
                          (let [l (rule-level g levels r (+ depth 1))]
                            (when (> l out) (set! out l))))))))))
        (None [] 0)))
    out))

(defn level-of-item [(g Grammar) (levels (ArrayList Named)) (name (slice u8))]
  (-> i64)
  (rule-level g levels name 0))

;;; The literal the hidden rule prints, if any.
(defn print-ref [(g Grammar)
                 (levels (ArrayList Named))
                 (name (slice u8))
                 (source Code)
                 (keep bool)] (-> Code)
  (if keep
      `(print-keep ~source (mut w))
      `(print-at ~source ~(level-of-item g levels name) (mut w))))

;;; Print `items`, drawing captures from `(get (.kids n) k)` from index `cap` on.
;;; A `!` guard just before a capture parenthesises output that would start that way.
(defn print-items [(g Grammar)
                   (c (mut dsl/Cur))
                   (levels (ArrayList Named))
                   (items (ArrayList PE))
                   (cap i64)
                   (single bool)] (-> Code)
  (let [(mut body) (primitive/code-list-new)
        (mut k) cap
        (mut guard) (None [PE])]
    (for e items
      (let [source (if single `o `(get (.kids n) ~k))
            printed (print-item g (mut c) levels e source)]
        (match (.op e)
          (ONot [] (set! guard (Some e)))
          (_ (if (captures? g (mut c) e)
                 (do
                   (match guard
                     (Some [ge]
                           (push! (mut body) (guarded g (mut c) ge printed))
                           (set! guard (None [PE])))
                     (None [] (push! (mut body) printed)))
                   (set! k (+ k 1)))
                 (push! (mut body) printed))))))
    `(do ~@body)))

(defn guarded [(g Grammar) (c (mut dsl/Cur)) (ge PE) (printed Code)] (-> Code)
  (let [(mut lits) (empty-strs)
        (mut tests) (primitive/code-list-new)]
    (guard-lits! (get (.kids ge) 0) (mut lits))
    (for l lits
      (push! (mut tests)
             (if (word-literal? l)
                 `(rt/w-starts-word? (mut w) mark ~l)
                 `(rt/w-starts? (mut w) mark ~l))))
    (if (= (len lits) 0)
        printed
        `(let [mark (rt/w-mark! (mut w))]
           ~printed
           (when (or ~@tests)
             (rt/w-wrap! (mut w) mark ~(.group-open g) ~(.group-close g)))))))

(defn print-item [(g Grammar)
                  (c (mut dsl/Cur))
                  (levels (ArrayList Named))
                  (e PE)
                  (source Code)] (-> Code)
  (match (.op e)
    (OLit [] `(rt/tok! (mut w) ~(.text e)))
    (ORef []
          (match (find-decl g (.text e))
            (Some [d]
                  (cond (= (.kind d) (DHidden))
                          (cond (.print-soft d)
                                  `(rt/soft-semi! (mut w) ~(.print-text d))
                                (> (len (.print-text d)) 0)
                                  `(rt/tok! (mut w) ~(.print-text d))
                                :else `0)
                        (= (.kind d) (DFragment)) `0
                        :else (print-ref g levels (.text e) source false)))
            (None [] `0)))
    (OKeep []
           (let [inner (get (.kids e) 0)]
             (print-ref g levels (.text inner) source true)))
    (OWith []
           (let [inner (print-item g (mut c) levels (get (.kids e) 0) source)
                 (mut on) false
                 (mut off) false]
             (for f (.keep-under g)
               (when (contains? (.on e) f) (set! on true))
               (when (contains? (.off e) f) (set! off true)))
             (cond on
                     `(let [old (.keep w)]
                        (set! (.keep w) (+ old 1))
                        ~inner
                        (set! (.keep w) old))
                   off
                     `(let [old (.keep w)]
                        (set! (.keep w) 0)
                        ~inner
                        (set! (.keep w) old))
                   :else inner)))
    (OStar [] (print-rep g levels e source false))
    (OPlus [] (print-rep g levels e source false))
    (OSepStar [] (print-rep g levels e source true))
    (OSepPlus [] (print-rep g levels e source true))
    (OOpt []
          (let [inner (get (.kids e) 0)]
            `(let [o ~source]
               (unless (= (.kind o) (KNone))
                 ~(print-items g (mut c) levels (seq-items inner) 0 true)))))
    (_ `0)))

(defn print-rep [(g Grammar)
                 (levels (ArrayList Named))
                 (e PE)
                 (source Code)
                 (commas bool)] (-> Code)
  (let [name (.text (get (.kids e) 0))
        min (level-of-item g levels name)]
    (if commas
        `(let [items (.kids ~source)]
           (for i (range 0 (len items))
             (when (> i 0) (rt/tok! (mut w) ","))
             (print-at (get items i) ~min (mut w))))
        `(for (ref each) (.kids ~source)
           (print-at each ~min (mut w))))))

(defn print-arm [(g Grammar)
                 (c (mut dsl/Cur))
                 (levels (ArrayList Named))
                 (k KindDef)] (-> Code)
  (match (.print k)
    (PLeaf []
           `(~(kind-sym (.name k)) [] (rt/leaf-tok! (mut w) (.text n) (.lo n))))
    (POp [op]
         `(~(kind-sym (.name k)) []
             (do
               (print-operand (.kind n) (get (.kids n) 0) ~(.level k) (mut w))
               (rt/tok! (mut w) ~(.lit op))
               (print-operand (.kind n)
                              (get (.kids n) 1)
                              ~(+ (.level k) 1)
                              (mut w)))))
    (PAlt [a base-min]
          (let [items (seq-items (.seq a))
                is-chain (> (.arity k) (count-captures g (mut c) (.seq a)))]
            (if is-chain
                `(~(kind-sym (.name k)) []
                    (do
                      (print-at (get (.kids n) 0) ~base-min (mut w))
                      ~(print-items g (mut c) levels items 1 false)))
                `(~(kind-sym (.name k)) []
                    ~(print-items g (mut c) levels items 0 false)))))))

;; ---------------------------------------------------------------- first bytes

;;; The bytes `e` can start with. True when `e` can also match nothing, so what follows it
;;; counts too. A negated class gives up: `known` goes false.
(defstruct First [(ranges (ArrayList Range)) (known bool)])

;;; A set of bytes, as 256 bits, for what a rule's next token may begin with. `known` false: anything.
(defstruct Bytes [(w0 i64) (w1 i64) (w2 i64) (w3 i64) (known bool)])

(defn bytes-none [] (-> Bytes)
  (Bytes
    :w0 0
    :w1 0
    :w2 0
    :w3 0
    :known true))

(defn bytes-union [(a Bytes) (b Bytes)] (-> Bytes)
  (Bytes
    :w0 (| (.w0 a) (.w0 b))
    :w1 (| (.w1 a) (.w1 b))
    :w2 (| (.w2 a) (.w2 b))
    :w3 (| (.w3 a) (.w3 b))
    :known (and (.known a) (.known b))))

(defn bytes-of-first [(f First)] (-> Bytes)
  (let [(mut out) (bytes-none)]
    (set! (.known out) (.known f))
    (for r (.ranges f)
      (for b (range (.lo r) (+ (.hi r) 1))
        (when (and (>= b 0) (< b 256))
          (let [bit (<< 1 (% b 64))]
            (cond (< b 64) (set! (.w0 out) (| (.w0 out) bit))
                  (< b 128) (set! (.w1 out) (| (.w1 out) bit))
                  (< b 192) (set! (.w2 out) (| (.w2 out) bit))
                  :else (set! (.w3 out) (| (.w3 out) bit)))))))
    out))

;;; A set's bytes as runs.
(defn bytes-ranges [(b Bytes)] (-> (ArrayList Range))
  (let [(mut out) (ArrayList::new [Range] (rt/value-allocator))]
    (for x (range 0 256)
      (let [w
              (cond (< x 64) (.w0 b)
                    (< x 128) (.w1 b)
                    (< x 192) (.w2 b)
                    :else (.w3 b))]
        (when (!= (& (>> w (% x 64)) 1) 0)
          (if (and (> (len out) 0) (= (.hi (get out (- (len out) 1))) (- x 1)))
              (let [last (get out (- (len out) 1))]
                (set! (mut out) (- (len out) 1) (Range :lo (.lo last) :hi x)))
              (push! (mut out) (Range :lo x :hi x))))))
    out))

;;; A bool over `c`, the byte: is it in the set? A few runs are compared; more, looked up.
(defn byte-test [(b Bytes)] (-> Code)
  (let [rs (bytes-ranges b)]
    (if (<= (len rs) 3)
        (let [(mut tests) (primitive/code-list-new)]
          (for r rs
            (if (= (.lo r) (.hi r))
                (push! (mut tests) `(= c ~(.lo r)))
                (push! (mut tests) `(and (>= c ~(.lo r)) (<= c ~(.hi r))))))
          `(or ~@tests false))
        (byte-test-set b))))

;;; One load from a table of the 256 bytes, with the end of input (-1) before them. The table is
;;; named by the set it holds, and the module defines each one named once (see `byte-tables`).
(defn byte-test-set [(b Bytes)] (-> Code)
  `(= (get ~(primitive/code-symbol (table-name b)) (+ c 1)) 49))

(defn hex-digits [] (-> (slice u8)) "0123456789abcdef")

(defn table-name [(b Bytes)] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] (rt/value-allocator))]
    (push! (mut out) #\b)
    (push! (mut out) #\s)
    (push! (mut out) #\-)
    (for i (range 0 4)
      (let [w (cond (= i 0) (.w0 b) (= i 1) (.w1 b) (= i 2) (.w2 b) :else (.w3 b))]
        (for k (range 0 16)
          (push! (mut out) (get (hex-digits) (& (>> w (* 4 (- 15 k))) 15))))))
    (slice out)))

;;; The definitions of the byte tables the text names: `bs-` and 64 hex digits, the set's four
;;; words, each table a text of '0' and '1'.
(defn byte-tables [(text (slice u8)) (seen (mut (ArrayList (slice u8)))) (out (mut str/StrBuf))] (-> void)
  (let [n (len text)
        (mut i) 0]
    (while (< (+ i 67) (+ n 1))
      (if (and (= (get text i) #\b) (= (get text (+ i 1)) #\s) (= (get text (+ i 2)) #\-)
               (block :hex
                 (for k (range 0 64)
                   (when (< (hex-value (get text (+ i 3 k))) 0) (return-from :hex false)))
                 true))
          (let [name (subslice text i (+ i 67))]
            (unless (contains? seen name)
              (push! (mut seen) name)
              (push-str! (mut out) "(const ")
              (push-str! (mut out) name)
              (push-str! (mut out) " \"0")
              (for x (range 0 256)
                ;; Word x/64 is 16 digits, most significant first; bit x%64 of it.
                (let [digit (hex-value (get name (+ 3 (* 16 (/ x 64)) (- 15 (/ (% x 64) 4)))))]
                  (push-str! (mut out) (if (!= (& (>> digit (% x 4)) 1) 0) "1" "0"))))
              (push-str! (mut out) "\")\n"))
            (set! i (+ i 67)))
          (set! i (+ i 1))))))

;;; What a reference begins with, and whether it can match nothing. `plain`: every way it begins
;;; is with one of the literals `lits` (nothing else: no token, no fragment).
(defstruct Start [(bytes Bytes) (empty bool) (lits (ArrayList (slice u8))) (plain bool)])

;;; The literals either begins with.
(defn lits-union [(a Start) (b Start)] (-> (ArrayList (slice u8)))
  (let [(mut out) (empty-strs)]
    (for l (.lits a) (add-unique! (mut out) l))
    (for l (.lits b) (add-unique! (mut out) l))
    out))

;;; What begins as either does: `empty` says whether it can match nothing.
(defn start-union [(a Start) (b Start) (empty bool)] (-> Start)
  (Start
    :bytes (bytes-union (.bytes a) (.bytes b))
    :empty empty
    :lits (lits-union a b)
    :plain (and (.plain a) (.plain b))))

;;; What begins with nothing yet: the start of a choice before its alternatives are added.
(defn no-start [] (-> Start)
  (Start :bytes (bytes-none) :empty false :lits (empty-strs) :plain true))

;;; What begins with this literal.
(defn lit-start [(text (slice u8))] (-> Start)
  (let [(mut f) (First :ranges (ArrayList::new [Range] (rt/value-allocator)) :known true)
        b (cast i64 (get text 0))
        (mut lits) (empty-strs)]
    (push! (mut (.ranges f)) (Range :lo b :hi b))
    (push! (mut lits) text)
    (Start :bytes (bytes-of-first f) :empty false :lits lits :plain true)))

;;; Each rule's start, worked out once for the grammar. A rule met again while its own is being
;;; worked out is a cycle: unknown.
(defstruct FirstMemo
  [(names (ArrayList (slice u8)))
   (starts (ArrayList Start))
   (busy (ArrayList (slice u8)))])

(defn first-memo-new [] (-> FirstMemo)
  (FirstMemo
    :names (ArrayList::new [(slice u8)] (rt/value-allocator))
    :starts (ArrayList::new [Start] (rt/value-allocator))
    :busy (ArrayList::new [(slice u8)] (rt/value-allocator))))

(defn unknown-start [] (-> Start)
  (Start
    :bytes
      (Bytes
        :w0 0
        :w1 0
        :w2 0
        :w3 0
        :known false)
    :empty false
    :lits (empty-strs)
    :plain false))

(defn lexical-start [(g Grammar) (body PE)] (-> Start)
  (let [(mut f)
          (First
            :ranges (ArrayList::new [Range] (rt/value-allocator))
            :known true)
        empty (first-of! g body (mut f) 0)]
    (Start :bytes (bytes-of-first f) :empty empty :lits (empty-strs) :plain false)))

;;; The bytes the next token can begin with when a rule matches, space skipped first.
(defn rule-start [(g Grammar) (name (slice u8)) (m (mut FirstMemo))] (-> Start)
  (let [(mut at) -1]
    (for i (range 0 (len (.names m)))
      (when (= (get (.names m) i) name) (set! at i)))
    (cond (>= at 0) (get (.starts m) at)
          (contains? (.busy m) name) (unknown-start)
          :else
            (match (find-decl g name)
              (None [] (unknown-start))
              (Some [d]
                    (push! (mut (.busy m)) name)
                    (let [s
                            (cond (= (.kind d) (DFragment))
                                    (lexical-start g (.body d))
                                  (and (= (.kind d) (DToken)) (not (.raw d)))
                                    (lexical-start g (.body d))
                                  (= (.kind d) (DHidden))
                                    (pe-start g (.body d) (mut m))
                                  (= (.kind d) (DRule))
                                    (let [(mut acc) (no-start)]
                                      (for a (.alts d)
                                        (let [s1 (pe-start g (.seq a) (mut m))]
                                          (set! acc (start-union acc s1 (or (.empty acc) (.empty s1))))))
                                      acc)
                                  ;; A chain (postfix, suffix, infix) begins with its base.
                                  (and (or (= (.kind d) (DPostfix))
                                           (= (.kind d) (DSuffix))
                                           (= (.kind d) (DInfix)))
                                       (> (len (.over d)) 0))
                                    (rule-start g (.over d) (mut m))
                                  :else (unknown-start))]
                      (pop! (mut (.busy m)))
                      (push! (mut (.names m)) name)
                      (push! (mut (.starts m)) s)
                      s))))))

(defn seq-start [(a Start) (b Start)] (-> Start)
  (if (.empty a)
      (start-union a b (.empty b))
      a))

(defn maybe [(s Start)] (-> Start)
  (Start :bytes (.bytes s) :empty true :lits (.lits s) :plain (.plain s)))

(defn zero-width [] (-> Start)
  (Start :bytes (bytes-none) :empty true :lits (empty-strs) :plain true))

;;; The same for a parsing expression of a rule.
(defn pe-start [(g Grammar) (e PE) (m (mut FirstMemo))] (-> Start)
  (match (.op e)
    (OLit [] (lit-start (.text e)))
    (ORef [] (rule-start g (.text e) (mut m)))
    (OSeq []
          (let [(mut acc) (zero-width)]
            (for k (.kids e)
              (when (.empty acc)
                (set! acc (seq-start acc (pe-start g k (mut m))))))
            acc))
    (OChoice []
             (let [(mut acc) (no-start)]
               (for k (.kids e)
                 (let [s (pe-start g k (mut m))]
                   (set! acc (start-union acc s (or (.empty acc) (.empty s))))))
               acc))
    (OStar [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OOpt [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OSepStar [] (maybe (pe-start g (get (.kids e) 0) (mut m))))
    (OPlus [] (pe-start g (get (.kids e) 0) (mut m)))
    (OSepPlus [] (pe-start g (get (.kids e) 0) (mut m)))
    (OWith [] (pe-start g (get (.kids e) 0) (mut m)))
    (OKeep [] (pe-start g (get (.kids e) 0) (mut m)))
    ;; Zero width: what follows decides.
    (OIf [] (zero-width))
    (OUnless [] (zero-width))
    (ONot [] (zero-width))
    (OAnd [] (zero-width))
    (ONl [] (zero-width))
    (ONoNl [] (zero-width))
    (OEof [] (zero-width))
    (OBof [] (zero-width))
    (OLineStart [] (zero-width))
    (_ (unknown-start))))

(defn first-of! [(g Grammar) (e PE) (f (mut First)) (depth i64)] (-> bool)
  (match (.op e)
    (OLit []
          (let [b (cast i64 (get (.text e) 0))]
            (push! (mut (.ranges f)) (Range :lo b :hi b))
            false))
    (OClass []
            (do
              (for r (.ranges (class-ranges e)) (push! (mut (.ranges f)) r))
              false))
    (OAny [] (set! (.known f) false) false)
    (ORef []
          (if (> depth 16)
              (do (set! (.known f) false) false)
              (match (find-decl g (.text e))
                (Some [d] (first-of! g (.body d) (mut f) (+ depth 1)))
                (None [] (set! (.known f) false) false))))
    (OSeq []
          (let [(mut empty) true]
            (for k (.kids e)
              (when empty (set! empty (first-of! g k (mut f) depth))))
            empty))
    (OChoice []
             (let [(mut empty) false]
               (for k (.kids e)
                 (when (first-of! g k (mut f) depth) (set! empty true)))
               empty))
    (OStar [] (first-of! g (get (.kids e) 0) (mut f) depth) true)
    (OOpt [] (first-of! g (get (.kids e) 0) (mut f) depth) true)
    (OPlus [] (first-of! g (get (.kids e) 0) (mut f) depth))
    ;; Zero width: they consume nothing, so what follows decides.
    (ONot [] true)
    (OAnd [] true)
    (OBof [] true)
    (OLineStart [] true)
    (OEof [] true)
    (_ (set! (.known f) false) false)))

;;; A bool over `c`, the byte at `from`: is the space here that one byte and no more? It is where
;;; the byte is one of the space fragment's plain bytes and the byte after is neither one of
;;; those nor one another alternative of the fragment can begin with. `false` for a fragment that
;;; is not a repetition with plain bytes.
(defn space-single [(g (mut Grammar)) (cu (mut dsl/Cur))] (-> Code)
  (match (find-decl g (.space g))
    (None [] `false)
    (Some [d]
          (if (= (.op (.body d)) (OStar))
              (let [inner (get (.kids (.body d)) 0)]
                (match (leading-bytes g inner 0)
                  (Some [lead]
                        (match (after-leading g inner 0 false)
                          (Some [rest]
                                `(and ~(byte-test lead)
                                      (let [c (rt/byte-at-or-end (.src p) (+ from 1))]
                                        (not ~(byte-test (bytes-union lead rest))))))
                          (None [] `false)))
                  (None [] `false)))
              `false))))

;;; Space not found before, from `from`, the position: a repetition's leading single bytes in a
;;; loop here, the fragment itself only where one of its other alternatives can begin after them
;;; (a repetition asked again where it stopped goes on as it would have).
(defn space-scan [(g (mut Grammar)) (cu (mut dsl/Cur))] (-> Code)
  (let [whole `(space-rest! (mut p) from from)]
    (match (find-decl g (.space g))
      (None [] whole)
      (Some [d]
            (if (= (.op (.body d)) (OStar))
                (let [inner (get (.kids (.body d)) 0)]
                  (match (leading-bytes g inner 0)
                    (Some [lead]
                          (match (after-leading g inner 0 false)
                            (Some [rest]
                                  `(let [src (.src p)
                                         n (len src)
                                         (mut i) from]
                                     (while (and (< i n) (let [c (cast i64 (get src i))] ~(byte-test lead)))
                                       (set! i (+ i 1)))
                                     (let [c (if (< i n) (cast i64 (get src i)) -1)]
                                       (if ~(byte-test rest)
                                           (space-rest! (mut p) from i)
                                           (space-found! (mut p) from i)))))
                            (None [] whole)))
                    (None [] whole)))
                whole)))))

;;; A bool over `c`: could a space begin here?
;;; What ends a line is the grammar's to say, with `newline`: an item that asks needs it.
(defn needs-newline [(g Grammar) (cu (mut dsl/Cur)) (e PE)] (-> void)
  (when (= (len (.newline g)) 0)
    (dsl/die (mut cu)
             (.tok e)
             "this looks for a line end, but the grammar does not say what one is: `newline Fragment`"))
  0)

;;; The body of `newline-in?`: each byte of the span a line end can begin with, the `newline`
;;; fragment tried there. A grammar without one never asks, and has no line ends.
(defn newline-scan [(g (mut Grammar)) (cu (mut dsl/Cur))] (-> Code)
  (if (= (len (.newline g)) 0)
      `false
      (match (find-decl g (.newline g))
        (None []
              (dsl/die (mut cu) (dsl/peek (mut cu))
                       (dsl/join2 "no fragment for the newline: " (.newline g))))
        (Some [d]
              (do
                (unless (= (.kind d) (DFragment))
                  (dsl/die (mut cu) (dsl/peek (mut cu)) "the newline must be a fragment"))
                (let [start (lexical-start g (.body d))]
                  (when (.empty start)
                    (dsl/die (mut cu) (dsl/peek (mut cu)) "the newline fragment must match at least one byte"))
                  `(let [s (.pos p)
                         src (.src p)
                         (mut i) from
                         (mut hit) false]
                     (while (and (< i to) (not hit))
                       (let [c (cast i64 (get src i))]
                         (when ~(if (.known (.bytes start)) (byte-test (.bytes start)) `true)
                           (set! (.pos p) i)
                           (when (and (~(lex-sym (.newline g)) (mut p)) (<= (.pos p) to))
                             (set! hit true))))
                       (set! i (+ i 1)))
                     (set! (.pos p) s)
                     hit)))))))

(defn space-start-test [(g (mut Grammar)) (cu (mut dsl/Cur))] (-> Code)
  (match (find-decl g (.space g))
    (None []
          (dsl/die (mut cu) (dsl/peek (mut cu)) "the grammar has no space rule"))
    (Some [d]
          (let [(mut f)
                  (First
                    :ranges (ArrayList::new [Range] (rt/value-allocator))
                    :known true)
                (mut tests) (primitive/code-list-new)]
            (first-of! g (.body d) (mut f) 0)
            (if (.known f) (byte-test (bytes-of-first f)) `true)))))

;; ---------------------------------------------------------------- the module

;;; Written parentheses are dropped where precedence does not need them. A grammar
;;; with no `group` has no such node, so the arm is absent.
(defn group-arm [(g Grammar)] (-> Code)
  (if (= (len (.group-kind g)) 0)
      `()
      `((~(kind-sym (.group-kind g)) []
           (let [inner (get (.kids n) 0)]
             (if (and (= (.keep w) 0)
                      (>= (kind-level (.kind inner)) min)
                      (not (opaque-spine? inner)))
                 (print-at inner min (mut w))
                 (print-node n (mut w))))))))

;;; (match k (KA [] true) … (_ false)) for the nomix group from index `from` to `to`.
(defn nomix-test [(g Grammar) (from i64) (to i64)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for i (range from to)
      (push! (mut arms) `(~(kind-sym (get (.nomix g) i)) [] true)))
    `(match k ~@arms (_ false))))

(defn forbid-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for name (.keep-forbid g)
      (push! (mut arms) `(~(kind-sym name) [] true)))
    `(match (.kind n) ~@arms (_ false))))

;;; Under a kept flag, an operator that flag disables needs parentheses:
;;; `for (x = ("a" in b);;)`.
(defn flagged-op-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for d (.decls g)
      (for op (.ops d)
        (when (contains? (.keep-under g) (.unless-flag op))
          (push! (mut arms) `(~(kind-sym (.kind op)) [] true)))))
    `(match (.kind n) ~@arms (_ false))))

(defn opaque-test [(g Grammar)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for name (.opaque g)
      (push! (mut arms) `(~(kind-sym name) [] true)))
    `(match (.kind n) ~@arms (_ false))))

(defn emit-module! [(g (mut Grammar))
                    (c (mut dsl/Cur))
                    (levels (ArrayList Named))] (-> Code)
  (let [(mut variants) (primitive/code-list-new)
        (mut table) (primitive/code-list-new)
        (mut arms) (primitive/code-list-new)
        (mut level-arms) (primitive/code-list-new)
        (mut flag-consts) (primitive/code-list-new)
        (mut tag-arms) (primitive/code-list-new)
        (mut name-arms) (primitive/code-list-new)
        (mut kinds-made) (primitive/code-list-new)
        (mut tag) 0
        (mut bit) 1]
    (for f (.flags g)
      (push! (mut flag-consts) `(const ~(flag-sym f) ~bit))
      (set! bit (* bit 2)))
    (for k (.kinds g)
      (push! (mut tag-arms) `(~(kind-sym (.name k)) [] ~tag))
      (push! (mut name-arms) `(~(kind-sym (.name k)) [] ~(.name k)))
      (push! (mut kinds-made) `(push! (mut ks) (~(kind-sym (.name k)))))
      (set! tag (+ tag 1))
      (push! (mut variants) `(~(kind-sym (.name k)) []))
      (push! (mut table) `(~(.name k) ~(.arity k)))
      (push! (mut arms) (print-arm g (mut c) levels k))
      (when (< (.level k) (no-level))
        (push! (mut level-arms) `(~(kind-sym (.name k)) [] ~(.level k)))))
    (push! (mut tag-arms) `(KList [] ~tag))
    (push! (mut tag-arms) `(KNone [] ~(+ tag 1)))
    (push! (mut tag-arms) `(KFlag [] ~(+ tag 2)))
    (push! (mut name-arms) `(KList [] "List"))
    (push! (mut name-arms) `(KNone [] "None"))
    (push! (mut name-arms) `(KFlag [] "Flag"))
    `(do
       (import "coil.alloc" :use [malloc-allocator box!])
       (import "coil.arraylist" :use [ArrayList])
       (import "hl.rt" :as rt)
       (import "coil.primitive" :as primitive)
       (import "hl.quote" :as hq)

       ~@flag-consts

       (defsum Kind ~@variants (KList []) (KNone []) (KFlag []))
       ;; Not `derive`: it cannot see a type declared by the same macro expansion, and a
       ;; grammar may be expanded by a macro when a reader needs its parser.
       (defn kind-tag :inline (Always) [(k Kind)] (-> i64)
         (match k ~@tag-arms))
       (impl Eq Kind
         (= [(a Kind) (b Kind)] (-> bool)
           (= (kind-tag a) (kind-tag b))))
       (defn kind-name [(k Kind)] (-> (slice u8))
         (match k ~@name-arms))
       ;; Each kind by its tag, made once: what a node read from the cache has.
       (defstruct KindTable [(ready bool) (kinds (ArrayList Kind))])
       (defn kind-of-tag [(i i64)] (-> Kind)
         (let [t (primitive/alloc-static KindTable)]
           (unless (.ready t)
             (let [(mut ks) (ArrayList::new [Kind] (malloc-allocator))]
               ~@kinds-made
               (push! (mut ks) (KList))
               (push! (mut ks) (KNone))
               (push! (mut ks) (KFlag))
               (set! (.kinds t) ks)
               (set! (.ready t) true)))
           (when (or (< i 0) (>= i (len (.kinds t))))
             (panic "a node in the cache has kind {}, which this grammar has not"
                    i))
           (get (.kinds t) i)))
       (defstruct Node
         [(kind Kind)
          (text (slice u8))
          (kids (ArrayList Node))
          (lo i64)
          (hi i64)
          (gen i64)])

       (defn node-table [] (-> Code)
         (quasiquote (~@table ("List" -1) ("None" 0) ("Flag" 0))))

       ;;; Whether two trees are the same: kinds, text, places and children. Children in one
       ;;; buffer are the same without a look inside, so a tree compared with itself, or with one
       ;;; that kept its unchanged subtrees, costs little.
       (defn node-same? [(a Node) (b Node)] (-> bool)
         (and (= (.kind a) (.kind b))
              (= (.lo a) (.lo b))
              (= (.hi a) (.hi b))
              (= (.text a) (.text b))
              (= (len (.kids a)) (len (.kids b)))
              (or (= (primitive/cast i64 (data (slice (.kids a))))
                     (primitive/cast i64 (data (slice (.kids b)))))
                  (block :same
                    (for i (range 0 (len (.kids a)))
                      (unless (node-same? (get (.kids a) i) (get (.kids b) i))
                        (return-from :same false)))
                    true))))
       ;;; A tree's identity, as text: its kind, place and text, and where its children are. Trees
       ;;; are never changed and their memory never reused, so the same identity is the same tree.
       (defn node-key [(n Node)] (-> (slice u8))
         (rt/node-identity (kind-tag (.kind n))
                           (.lo n)
                           (.hi n)
                           (.text n)
                           (primitive/cast i64 (data (slice (.kids n))))
                           (len (.kids n))))
       (defn new-kids [] (-> (ArrayList Node))
         (ArrayList::new [Node] (rt/tree-allocator)))
       ;;; Room for `n` kids from the start: a template knows how many it adds.
       (defn new-kids-sized [(n i64)] (-> (ArrayList Node))
         (let [(mut kids) (ArrayList::new [Node] (rt/tree-allocator))]
           (when (> n 0) (ArrayList::reserve! (mut kids) n))
           kids))
       (defn mk :inline (Always) [(k Kind) (kids (ArrayList Node)) (lo i64) (hi i64)] (-> Node)
         (Node
           :kind k
           :text ""
           :kids kids
           :lo lo
           :hi hi
           :gen 0))
       ;;; Whether two nodes are one value: every field the same, children and text by where they are.
       (defn same-node? [(a Node) (b Node)] (-> bool)
         (and (= (.kind a) (.kind b))
              (= (.lo a) (.lo b))
              (= (.hi a) (.hi b))
              (= (.gen a) (.gen b))
              (= (len (.kids a)) (len (.kids b)))
              (= (primitive/cast i64 (data (slice (.kids a))))
                 (primitive/cast i64 (data (slice (.kids b)))))
              (= (len (.text a)) (len (.text b)))
              (= (primitive/cast i64 (data (.text a)))
                 (primitive/cast i64 (data (.text b))))))
       ;;; A node for the cache (see the cache in hl.rt): its kind, text, children, place and stamp.
       ;;; A list of children is an object of the cache's, so a tree that shares children with
       ;;; another shares them after a load too, and `node-key` stays its identity.
       (defstruct NodeTables [(load i64)])
       ;; Its one cell, whose address tells this grammar's lists from others' as they are written.
       (defn node-tables [] (-> (ptr NodeTables))
         (primitive/alloc-static NodeTables))
       (defn node-encode! [(w (ptr rt/Writer)) (n Node)] (-> void)
         (rt/put-varint! w (kind-tag (.kind n)))
         (rt/put-text! w (.text n))
         (when (rt/put-object! w
                               (primitive/cast i64 (node-tables))
                               (primitive/cast i64 (data (slice (.kids n))))
                               (len (.kids n)))
           (rt/put-varint! w (len (.kids n)))
           (for c (.kids n) (node-encode! w c))
           (rt/put-object-end! w))
         (rt/put-int! w (.lo n))
         (rt/put-int! w (.hi n))
         (rt/put-int! w (.gen n))
         0)
       (defn node-decode [(r (ptr rt/Reader))] (-> Node)
         (let [kind (kind-of-tag (rt/take-varint r))
               text (rt/take-text r)
               kids (node-kids-decode r)
               lo (rt/take-int r)
               hi (rt/take-int r)
               g (rt/take-int r)]
           (Node
             :kind kind
             :text text
             :kids kids
             :lo lo
             :hi hi
             :gen g)))
       (defn node-kids-decode [(r (ptr rt/Reader))] (-> (ArrayList Node))
         (let [id (rt/take-object r)]
           (if (rt/object-ready? r id)
               (do
                 (rt/object-skip! r)
                 (load (cast (ptr (ArrayList Node)) (rt/object-value r id))))
               (do
                 (rt/object-enter! r)
                 (let [n (rt/take-varint r)
                       (mut kids) (new-kids)]
                   (reserve! (mut kids) n)
                   (for _ (range 0 n) (push! (mut kids) (node-decode r)))
                   (rt/object-leave! r
                                     (cast (ptr u8) (mut kids))
                                     (sizeof (ArrayList Node)))
                   (rt/writer-know! (primitive/cast i64 (node-tables))
                                    (primitive/cast i64 (data (slice kids)))
                                    (len kids)
                                    id)
                   kids)))))
       ;;; A copy of a node with another stamp; the node itself is untouched.
       (defn with-gen [(n Node) (g i64)] (-> Node)
         (let [(mut c) n] (set! (.gen c) g) c))
       (defn leaf [(k Kind) (text (slice u8)) (lo i64) (hi i64)] (-> Node)
         (Node
           :kind k
           :text text
           :kids (new-kids)
           :lo lo
           :hi hi
           :gen 0))
       ;;; The nodes of a list from `from` up to `to`.
       (defn sublist [(items (ArrayList Node)) (from i64) (to i64)]
         (-> (ArrayList Node))
         (let [(mut out) (new-kids)]
           (reserve! (mut out) (- to from))
           (for i (range from to) (push! (mut out) (get items i)))
           out))
       ;; The same children with the one at `at` replaced: `n with { name: v }` for a named child.
       (defn kids-with [(items (ArrayList Node)) (at i64) (v Node)]
         (-> (ArrayList Node))
         (let [(mut out) (new-kids)]
           (reserve! (mut out) (len items))
           (for i (range 0 (len items))
             (push! (mut out) (if (= i at) v (get items i))))
           out))
       (defn none-node [] (-> Node)
         (leaf (KNone) "" 0 0))
       (defn flag-node [] (-> Node)
         (leaf (KFlag) "" 0 0))
       (defn node2 [(k Kind) (a Node) (b Node)] (-> Node)
         (let [(mut kids) (new-kids)]
           (push! (mut kids) a)
           (push! (mut kids) b)
           (mk k kids (.lo a) (.hi b))))
       (defn box-node [(n Node)] (-> i64)
         (cast i64 (box! (rt/tree-allocator) Node n)))

       ;; What a parse makes goes where the parse began (`.alloc` of its state): the tree is built
       ;; in place, never copied out. What only the parse needs while it runs, its memo's answers
       ;; and the items of lists still being parsed, is the parse's own, and goes with it.
       (defn kids-in :inline (Always) [(p (mut rt/P))] (-> (ArrayList Node))
         (ArrayList::new [Node] (.alloc p)))
       (defn leaf-in :inline (Always) [(p (mut rt/P)) (k Kind) (text (slice u8)) (lo i64) (hi i64)] (-> Node)
         (Node :kind k :text text :kids (kids-in (mut p)) :lo lo :hi hi :gen 0))
       (defn none-node-in [(p (mut rt/P))] (-> Node)
         (leaf-in (mut p) (KNone) "" 0 0))
       (defn flag-node-in [(p (mut rt/P))] (-> Node)
         (leaf-in (mut p) (KFlag) "" 0 0))
       ;;; Room for `n` children, taken straight from the thread's cursor when the parse has one.
       (defn kids-sized-in :inline (Always) [(p (mut rt/P)) (n i64)] (-> (ArrayList Node))
         (let [(mut kids) (kids-in (mut p))]
           (if (!= (.cursor p) 0)
               (do
                 (set! (.data kids) (primitive/cast (ptr Node) (rt/p-alloc (mut p) (* n (sizeof Node)))))
                 (set! (.cap kids) n))
               (reserve! (mut kids) n))
           kids))
       (defn node2-in :inline (Always) [(p (mut rt/P)) (k Kind) (a Node) (b Node)] (-> Node)
         (let [(mut kids) (kids-sized-in (mut p) 2)]
           (let [d (.data kids)]
             (store! (primitive/index d 0) a)
             (store! (primitive/index d 1) b)
             (set! (.len kids) 2))
           (mk k kids (.lo a) (.hi b))))
       ;;; The items of the lists being parsed, innermost last: a list's items wait here, and the
       ;;; list takes them at once, in one allocation of the size it turns out to be.
       (defn parse-stack [(p (mut rt/P))] (-> (ptr (ArrayList Node)))
         (primitive/cast (ptr (ArrayList Node)) (.stack p)))
       ;;; Pushes are many and the stack has room for nearly all: that case is written here.
       (defn stack-push! :inline (Always) [(p (mut rt/P)) (n (mut Node))] (-> void)
         (let [s (parse-stack (mut p))
               k (load (field s len))]
           (if (< k (load (field s cap)))
               (do
                 (store! (primitive/index (load (field s data)) k) n)
                 (store! (field s len) (+ k 1)))
               (do (push! s n) 0)))
         0)
       (defn stack-height [(p (mut rt/P))] (-> i64)
         (len (load (parse-stack (mut p)))))
       ;;; The items above `base`, as a list of their own, and off the stack.
       ;;; The items above `base` as a List node, written where the node goes, and off the stack.
       ;;; Most lists are short, and many empty: nothing is called for them, and the node's fields
       ;;; are written one by one, with no list or node made anywhere else first.
       (defn list-node! :inline (Always) [(p (mut rt/P)) (out (mut Node)) (base i64) (lo i64)] (-> void)
         (let [s (parse-stack (mut p))
               n (- (load (field s len)) base)]
           (set! (.kind out) (KList))
           (set! (.text out) "")
           (set! (.lo out) lo)
           (set! (.hi out) (.pos p))
           (set! (.gen out) 0)
           (set! (.kids out) (kids-in (mut p)))
           (when (> n 0)
             (if (!= (.cursor p) 0)
                 (do
                   (set! (.data (.kids out))
                         (primitive/cast (ptr Node) (rt/p-alloc (mut p) (* n (sizeof Node)))))
                   (set! (.cap (.kids out)) n))
                 (reserve! (mut (.kids out)) n))
             (let [from (load (field s data))
                   d (.data (.kids out))]
               (for i (range 0 n)
                 (store! (primitive/index d i) (load (primitive/index from (+ base i))))))
             (set! (.len (.kids out)) n)
             (store! (field s len) base))))
       ;;; A memo's answer as it is made: its node goes in the ring's next slot (see `rt/memo-put!`).
       (defn memo-node-keep! :inline (Always) [(p (mut rt/P)) (n (mut Node))] (-> i64)
         (store! (primitive/index (primitive/cast (ptr Node) (.data (.memo-ring-nodes p)))
                                  (rt/memo-slot (mut p)))
                 n)
         0)
       ;;; The node of an answer a memo's table holds.
       (defn memo-node [(p (mut rt/P)) (i i64)] (-> Node)
         (load (primitive/index (primitive/cast (ptr Node) (.data (.memo-kept p))) i)))

       ;; Templates: source text in this grammar, read at compile time. `hl.quote` turns
       ;; the tree into code that builds it, for whichever grammar it came from.
       (defn quote-tree [(n Node)] (-> hq/QNode)
         (let [(mut kids) (ArrayList::new [hq/QNode] (malloc-allocator))]
           (for (ref k) (.kids n) (push! (mut kids) (quote-tree k)))
           (hq/QNode
             :kind (kind-name (.kind n))
             :text (.text n)
             :kids kids)))
       ;;; ALIAS is how the caller imported this grammar, PATH the children to descend
       ;;; to reach the form wanted, HOLES ((NAME VALUE SORT) …).
       (defn quote-template [(alias Code) (src Code) (path Code) (holes Code)]
         (-> Code)
         (match (parse-result (primitive/code-str src) "<template>" 0)
           (Err [e]
                (primitive/error (rt/join "this template does not parse: "
                                          (primitive/code-str src))))
           (Ok [tree]
               (let [(mut at) tree]
                 (for step path
                   (set! at (get (.kids at) (primitive/code-int step))))
                 (hq/expansion (quote-tree at) (primitive/code-str alias) holes)))))

       ;;; Most tokens have no space before them, and the grammar says which bytes could
       ;;; begin some: anything else needs no look at all.
       ;;; Space depends only on where it starts, so each run of it is scanned once. Most calls
       ;;; ask again about the space just skipped, and cost one comparison.
       (defn skip! :inline (Always) [(p (mut rt/P))] (-> void)
         (unless (= (.ws-from p) (.pos p)) (space-ahead! (mut p)))
         (set! (.pos p) (.ws-to p)))

       ;;; The space from here, found and remembered (`ws-from`, `ws-to`), the position left where
       ;;; it is. Out of line, so that asking again about the space last asked about, which is most
       ;;; asking, is a few instructions wherever it is done. Where no space can begin, there is
       ;;; none: nothing to look up or scan. Most space is a few plain bytes and then a token: that
       ;;; much is done here, and the space fragment is asked only where something else of its own
       ;;; (a comment) may come next.
       (defn space-ahead! :inline (Never) [(p (mut rt/P))] (-> void)
         (let [from (.pos p)
               c (rt/peek (mut p))]
           (if ~(space-start-test (mut g) (mut c))
               (if ~(space-single (mut g) (mut c))
                   ;; One plain byte of space and then a token, the commonest space there is:
                   ;; nothing to remember, since finding it again is as quick as looking it up.
                   (do
                     (set! (.ws-from p) from)
                     (set! (.ws-to p) (+ from 1)))
                   (let [known (rt/ws-known (mut p) from)]
                     (if (> known 0)
                         (do
                           (set! (.ws-from p) from)
                           (set! (.ws-to p) (+ from (- known 1))))
                         ~(space-scan (mut g) (mut c)))))
               (do
                 (set! (.ws-from p) from)
                 (set! (.ws-to p) from)))))

       (defn space-found! :inline (Always) [(p (mut rt/P)) (from i64) (to i64)] (-> void)
         (rt/ws-remember! (mut p) from to)
         (set! (.ws-from p) from)
         (set! (.ws-to p) to))

       ;;; The space fragment itself, from `at`, the space from `from` to there being plain bytes
       ;;; of its own: asked last, so that the common case calls nothing.
       (defn space-rest! :inline (Never) [(p (mut rt/P)) (from i64) (at i64)] (-> void)
         (set! (.ws-scan p) from)
         (set! (.pos p) at)
         (~(lex-sym (.space g)) (mut p))
         (let [to (.pos p)]
           (set! (.pos p) from)
           (space-found! (mut p) from to)))

       ;;; Does a line end (the grammar's `newline`) begin at or after `from` and end by `to`?
       (defn newline-in? [(p (mut rt/P)) (from i64) (to i64)] (-> bool)
         ~(newline-scan (mut g) (mut c)))

       ;;; At the start of a line: the space just skipped began the input, or held a line end.
       (defn at-line-start? [(p (mut rt/P))] (-> bool)
         (or (= (.ws-scan p) 0) (newline-in? (mut p) (.ws-scan p) (.pos p))))

       ;;; Is there a line terminator between here and the next token? Few rules ask, and most
       ;;; space is never asked about: it is looked through when one does, and the last answer kept.
       (defn newline-ahead? :inline (Always) [(p (mut rt/P))] (-> bool)
         (let [s (.pos p)]
           (skip! (mut p))
           (let [to (.pos p)]
             (set! (.pos p) s)
             (if (= to s) false (space-newline? (mut p) s to)))))

       (defn space-newline? [(p (mut rt/P)) (from i64) (to i64)] (-> bool)
         (if (= (.ws-nl-at p) from)
             (.ws-nl p)
             (let [nl (newline-in? (mut p) from to)]
               (set! (.ws-nl-at p) from)
               (set! (.ws-nl p) nl)
               nl)))

       (defn skip-peek? :inline (Always) [(p (mut rt/P))] (-> bool)
         (let [s (.pos p)]
           (skip! (mut p))
           (let [at-end (rt/eof? (mut p))]
             (set! (.pos p) s)
             at-end)))

       ;;; The first byte of the next token, without consuming anything.
       (defn next-byte :inline (Always) [(p (mut rt/P))] (-> i64)
         (unless (= (.ws-from p) (.pos p)) (space-ahead! (mut p)))
         (byte-at (mut p) (.ws-to p)))

       ;;; The byte at an offset; -1 past the end.
       (defn byte-at :inline (Always) [(p (mut rt/P)) (at i64)] (-> i64)
         (if (< at (len (.src p))) (cast i64 (get (.src p) at)) -1))

       ;;; The first eight bytes of the next token as one number, the first byte lowest; zeros past
       ;;; the end of input. Asked right after `next-byte`: the space before the
       ;;; token was skipped then, and where it ended is still known.
       (defn next-word :inline (Always) [(p (mut rt/P))] (-> i64)
         (let [t (.ws-to p)]
           (if (<= (+ t 8) (len (.src p)))
               (load (primitive/cast (ptr i64) (primitive/index (data (.src p)) t)))
               (word-at-end (mut p) t))))

       (defn word-at-end :inline (Never) [(p (mut rt/P)) (t i64)] (-> i64)
         (let [(mut w) 0]
           (for k (range 0 8)
             (when (< (+ t k) (len (.src p)))
               (set! w (| w (<< (cast i64 (get (.src p) (+ t k))) (* 8 k))))))
           w))

       ;;; Where the next token begins, without consuming the space before it.
       (defn token-start :inline (Always) [(p (mut rt/P))] (-> i64)
         (unless (= (.ws-from p) (.pos p)) (space-ahead! (mut p)))
         (.ws-to p))

       (defn comma! [(p (mut rt/P))] (-> bool)
         (~(lit-sym (lit-id (mut g) ",")) (mut p)))

       ~(primitive/code-symbol "@@AUX@@")

       (defn parse-result [(src (slice u8)) (path (slice u8)) (flags i64)]
         (-> (Result Node rt/ParseError))
         (parse-result-from src path flags 0))

       ;;; The program from `from` to the end of `src`, positions counted from the start of `src`.
       ;;; A program that does not parse is parsed again carefully, for the reason: first-byte guards
       ;;; skip alternatives that could not match, and a skipped one notes no failure.
       (defn parse-result-from [(src (slice u8))
                                (path (slice u8))
                                (flags i64)
                                (from i64)] (-> (Result Node rt/ParseError))
         (match (parse-attempt src path flags from false)
           (Ok [n] (Ok n))
           (Err [_] (parse-attempt src path flags from true))))

       (defn parse-attempt [(src (slice u8))
                            (path (slice u8))
                            (flags i64)
                            (from i64)
                            (careful bool)] (-> (Result Node rt/ParseError))
         ;; The tree is built where it will live, the caller's storage, and never copied: what a
         ;; failed alternative made stays there, and the parse's own working state goes with it.
         (parse-working src path flags from careful))

       (defn parse-working [(src (slice u8)) (path (slice u8)) (flags i64)
                            (from i64) (careful bool)] (-> (Result Node rt/ParseError))
         (let [(mut p) (rt/p-new src path flags ~(.memo-count g) from (sizeof Node))
               (mut stack) (ArrayList::new [Node] (malloc-allocator))
               _ (reserve! (mut stack) 256)
               _ (set! (.careful p) careful)
               _ (set! (.stack p) (primitive/cast i64 (primitive/cast (ptr (ArrayList Node)) (mut stack))))
               (mut root) (primitive/zeroed Node)
               result
                 (if (~(rule-sym (.start g)) (mut p) (mut root))
                     (do
                       (skip! (mut p))
                       (if (rt/eof? (mut p))
                           (Ok root)
                           (do
                             (rt/note-fail! (mut p) "end of input")
                             (Err (rt/parse-error (mut p))))))
                     (Err (rt/parse-error (mut p))))]
           (rt/p-free! (mut p))
           (free! (mut stack))
           result))

       ;;; A tree out of scratch storage (see "values out of scratch storage" in hl.rt): its own
       ;;; copy of each node made there, sharing every subtree and text made outside it. Only the
       ;;; accepted tree survives parsing, and its texts are still the source's; failed
       ;;; alternatives and packrat results go with the scratch storage.
       (defn node-own-in [(from (ptr rt/Region)) (n Node)] (-> Node)
         (if (rt/storage-in? from (primitive/cast i64 (data (slice (.kids n)))) (cap (.kids n)))
             (let [storage (primitive/cast i64 (data (slice (.kids n))))
                   seen (rt/own-seen storage)
                   kids
                     (if (and (!= (primitive/cast i64 seen) 0)
                              (= (len (load (primitive/cast (ptr (ArrayList Node)) seen))) (len (.kids n))))
                         (load (primitive/cast (ptr (ArrayList Node)) seen))
                         (let [(mut made) (new-kids)]
                           (reserve! (mut made) (len (.kids n)))
                           (for child (.kids n) (push! (mut made) (node-own-in from child)))
                           (rt/own-keep! storage (primitive/cast (ptr u8) (mut made)) (sizeof (ArrayList Node)))
                           made))]
               (Node :kind (.kind n) :text (rt/text-own-in from (.text n)) :kids kids
                     :lo (.lo n) :hi (.hi n) :gen (.gen n)))
             (Node :kind (.kind n) :text (rt/text-own-in from (.text n)) :kids (.kids n)
                   :lo (.lo n) :hi (.hi n) :gen (.gen n))))

       ;;; Parse a whole file. Syntax errors stop the program with file:line:col.
       (defn parse [(src (slice u8)) (path (slice u8))] (-> Node)
         (match (parse-result src path 0)
           (Ok [n] n)
           (Err [e] (rt/parse-failed e))))

       ;;; Parse under `base`, trying again with `more` too if that fails. Errors are the first try's.
       (defn parse-tries [(src (slice u8))
                          (path (slice u8))
                          (base i64)
                          (more i64)] (-> Node)
         (match (parse-result src path base)
           (Ok [t] t)
           (Err [first]
                (match (parse-attempt src path (| base more) 0 false)
                  (Ok [t] t)
                  (Err [_] (rt/parse-failed first))))))

       ;;; Parse under flags, or nothing, for tools that report failures themselves.
       (defn parse-opt [(src (slice u8)) (path (slice u8)) (flags i64)]
         (-> (Option Node))
         (match (parse-result src path flags)
           (Ok [t] (Some t))
           (Err [e] (set! (.last (rt/last-parse-error)) e) (None [Node]))))

       ;;; A piece of a program: the statements from `from` to the end of `src`, or nothing when
       ;;; they are not a program by themselves.
       (defn parse-piece [(src (slice u8))
                          (path (slice u8))
                          (flags i64)
                          (from i64)] (-> (Option Node))
         (match (parse-attempt src path flags from false)
           (Ok [t] (Some t))
           (Err [_] (None [Node]))))

       ;;; A flag's bit, by name.
       (defn flag-bit [(name (slice u8))] (-> i64)
         (cond ~@(flag-arms g) :else (panic "no flag named {}" name)))

       (defn kind-level [(k Kind)] (-> i64)
         (match k ~@level-arms (_ ~(no-level))))

       ;;; Whether the grammar's precedence orders this kind: an expression's.
       (defn expression-kind? [(k Kind)] (-> bool)
         (!= (kind-level k) ~(no-level)))

       (defn opaque-kind? [(n Node)] (-> bool)
         ~(opaque-test g))

       ;;; Parentheses around this must stay: an opaque kind, at or under its base.
       (defn opaque-spine? [(n Node)] (-> bool)
         (cond (opaque-kind? n) true
               (and (> (len (.kids n)) 0)
                    (< (kind-level (.kind n)) ~(no-level)))
                 (opaque-spine? (get (.kids n) 0))
               :else false))

       ;;; Print with this much precedence required: redundant written parentheses
       ;;; go, missing ones appear.
       (defn print-at [(n Node) (min i64) (w (mut rt/W))] (-> void)
         (match (.kind n)
           ~@(group-arm g)
           (_ (if (or (< (kind-level (.kind n)) min)
                      (and (> (.keep w) 0) ~(flagged-op-test g)))
                  (do
                    (rt/tok! (mut w) ~(.group-open g))
                    (print-node n (mut w))
                    (rt/tok! (mut w) ~(.group-close g)))
                  (print-node n (mut w))))))

       (defn nomix-first? [(k Kind)] (-> bool)
         ~(nomix-test g 0 (if (> (len (.nomix g)) 0) 1 0)))
       (defn nomix-rest? [(k Kind)] (-> bool)
         ~(nomix-test g (if (> (len (.nomix g)) 0) 1 0) (len (.nomix g))))

       ;;; An operand, with parentheses when the grammar forbids these two side by side.
       (defn print-operand [(parent Kind) (n Node) (min i64) (w (mut rt/W))]
         (-> void)
         (if (or (and (nomix-first? parent) (nomix-rest? (.kind n)))
                 (and (nomix-rest? parent) (nomix-first? (.kind n))))
             (do
               (rt/tok! (mut w) ~(.group-open g))
               (print-node n (mut w))
               (rt/tok! (mut w) ~(.group-close g)))
             (print-at n min (mut w))))

       ;;; A forbidden kind on the left spine: `new (a())` needs its parentheses even
       ;;; when a rewrite removed them.
       (defn forbidden-spine? [(n Node)] (-> bool)
         (cond ~(forbid-test g) true
               (and (> (len (.kids n)) 0)
                    (< (kind-level (.kind n)) ~(no-level)))
                 (forbidden-spine? (get (.kids n) 0))
               :else false))

       ;;; A `~X` child: written parentheses stay, and any it now needs appear.
       (defn print-keep [(n Node) (w (mut rt/W))] (-> void)
         (let [old (.keep w)]
           (set! (.keep w) (+ old 1))
           (if (or (forbidden-spine? n)
                   (< (kind-level (.kind n))
                      ~(named-value levels (.keep-min g))))
               (do
                 (rt/tok! (mut w) ~(.group-open g))
                 (print-node n (mut w))
                 (rt/tok! (mut w) ~(.group-close g)))
               (print-node n (mut w)))
           (set! (.keep w) old)))

       (defn print-node [(n Node) (w (mut rt/W))] (-> void)
         (rt/note-source! (mut w) (.lo n))
         (match (.kind n)
           ~@arms
           (KList []
                  (panic "a List node has no printed form outside a repetition"))
           (KNone [] 0)
           (KFlag [] 0)))

       ;;; How this grammar prints: the same for the whole program, so made once, in the program's
       ;;; own region (a style made per print, as it once was, was never let go).
       (defstruct StyleCell [(ready bool) (style rt/PrintStyle)])

       (defn print-style [] (-> rt/PrintStyle)
         (let [c (primitive/alloc-static StyleCell)]
           (unless (.ready c)
             ;; Made outside the lock (making memory may take it), kept by the first to finish.
             (rt/state-region-enter!)
             (let [(mut breaks) (ArrayList::new [(slice u8)] (rt/value-allocator))]
               ~@(break-pushes g)
               (let [made (rt/print-style ~(.print-words g)
                                          ~(.print-high g)
                                          ~(.apart g)
                                          ~(.apart-digits g)
                                          ~(.soft-close g)
                                          breaks)]
                 (rt/region-leave!)
                 (rt/init-lock!)
                 (unless (.ready c)
                   (set! (.style c) made)
                   (set! (.ready c) true))
                 (rt/init-unlock!))))
           (.style c)))

       (defn render-tracked [(n Node) (pretty bool) (tracking bool)]
         (-> rt/Rendered)
         (let [(mut w) (rt/w-new pretty (print-style))]
           (set! (.tracking w) tracking)
           (print-at n 0 (mut w))
           (rt/Rendered
             :text (rt/w-finish w)
             :marks (.marks w)
             :open (.pending w))))

       ;;; Printed text and where it passes from one source file to the next.
       (defn render-files [(n Node) (pretty bool)] (-> rt/Rendered)
         (let [(mut w) (rt/w-new pretty (print-style))]
           (set! (.tracking w) true)
           (set! (.by-file w) true)
           (print-at n 0 (mut w))
           (rt/Rendered
             :text (rt/w-finish w)
             :marks (.marks w)
             :open (.pending w))))

       ;;; Print into a writer the caller set up, for one that tracks leaf positions.
       (defn render-into [(n Node) (w (mut rt/W))] (-> void)
         (print-at n 0 (mut w)))

       ;;; The grammar printed back: `pretty` breaks lines, otherwise it is minimal.
       (defn render [(n Node) (pretty bool)] (-> (slice u8))
         (let [(mut w) (rt/w-new pretty (print-style))]
           (print-at n 0 (mut w))
           (rt/w-finish w))))))

;; ---------------------------------------------------------------- entry

(defn break-pushes [(g Grammar)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for b (.breaks g) (push! (mut out) `(push! (mut breaks) ~b)))
    `(~@out)))

(defn flag-arms [(g Grammar)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for f (.flags g)
      (push! (mut out) `(= name ~f))
      (push! (mut out) (flag-sym f)))
    `(~@out)))

(defstruct Loaded [(grammar Grammar) (cursor dsl/Cur)])

;;; One node a grammar declares: what another language checks itself against.
(defstruct KindEntry
  [(name (slice u8)) (arity i64) (leaf bool) (fields (ArrayList (slice u8)))])

;;; Every node of a grammar, for languages that read one without generating it.
(defn grammar-table [(source (slice u8)) (path (slice u8))]
  (-> (ArrayList KindEntry))
  (let [(mut l) (load-grammar source path)
        (mut out) (ArrayList::new [KindEntry] (rt/value-allocator))]
    (for k (.kinds (.grammar l))
      (push! (mut out)
             (KindEntry
               :name (.name k)
               :arity (.arity k)
               :leaf (match (.print k) (PLeaf [] true) (_ false))
               :fields (.fields k))))
    (push! (mut out)
           (KindEntry
             :name "List"
             :arity -1
             :leaf false
             :fields (empty-strs)))
    (push! (mut out)
           (KindEntry
             :name "None"
             :arity 0
             :leaf false
             :fields (empty-strs)))
    (push! (mut out)
           (KindEntry
             :name "Flag"
             :arity 0
             :leaf false
             :fields (empty-strs)))
    out))

(defn load-grammar [(source (slice u8)) (path (slice u8))] (-> Loaded)
  (let [(mut c)
          (dsl/grammar-cursor source
                              path
                              "-> ,* ,+ = | ; * + ? ! & ~ ( ) . @ - ,")
        (mut g)
          (Grammar
            :start ""
            :space ""
            :newline ""
            :word ""
            :print-words ""
            :print-high false
            :apart ""
            :apart-digits ""
            :soft-close ""
            :breaks (empty-strs)
            :flags (empty-strs)
            :keep-under (empty-strs)
            :group-open "("
            :group-close ")"
            :group-kind ""
            :opaque (empty-strs)
            :precedence (empty-strs)
            :keep-min ""
            :keep-forbid (empty-strs)
            :nomix (empty-strs)
            :not-before (empty-strs)
            :decls (ArrayList::new [Decl] (rt/value-allocator))
            :kinds (ArrayList::new [KindDef] (rt/value-allocator))
            :lits (ArrayList::new [Lit] (rt/value-allocator))
            :reps (empty-strs)
            :memo-count 0
            :next-aux 0
            :aux (empty-strs)
            :path path
            :firsts (first-memo-new)
            :plan-c2 false
            :info-names (empty-strs)
            :rests-made (empty-strs)
            :infos (ArrayList::new [(ArrayList AltInfo)] (rt/value-allocator)))
        (mut go) true]
    (dsl/expect! (mut c) "syntax")
    (while go
      (cond (dsl/accept! (mut c) "start")
              (set! (.start g) (.text (dsl/name! (mut c) "a rule")))
            (dsl/accept! (mut c) "space")
              (set! (.space g) (.text (dsl/name! (mut c) "a fragment")))
            (dsl/accept! (mut c) "newline")
              (set! (.newline g) (.text (dsl/name! (mut c) "a fragment")))
            (dsl/accept! (mut c) "word")
              (set! (.word g) (.text (dsl/name! (mut c) "a fragment")))
            (dsl/accept! (mut c) "printwords")
              (do
                (set! (.print-words g)
                      (.text (dsl/string! (mut c) "the bytes of a word")))
                (while (not (dsl/accept! (mut c) ";"))
                  (dsl/expect! (mut c) "high")
                  (set! (.print-high g) true)))
            (dsl/accept! (mut c) "apart")
              (while (not (dsl/accept! (mut c) ";"))
                (set! (.apart g)
                      (dsl/join2 (.apart g)
                                 (.text (dsl/string! (mut c) "a byte")))))
            (dsl/accept! (mut c) "apartdigits")
              (while (not (dsl/accept! (mut c) ";"))
                (set! (.apart-digits g)
                      (dsl/join2 (.apart-digits g)
                                 (.text (dsl/string! (mut c) "a byte")))))
            (dsl/accept! (mut c) "softclose")
              (do
                (set! (.soft-close g) (.text (dsl/string! (mut c) "a token")))
                (dsl/expect! (mut c) ";"))
            (dsl/accept! (mut c) "breaks")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.breaks g))
                       (.text (dsl/string! (mut c) "a token"))))
            (dsl/accept! (mut c) "flags")
              (while (not (dsl/accept! (mut c) ";"))
                (let [t (dsl/name! (mut c) "a flag")]
                  (when (>= (len (.flags g)) 8)
                    (dsl/die (mut c)
                             t
                             "a grammar has at most 8 flags: the memo table's key has room for no more"))
                  (push! (mut (.flags g)) (.text t))))
            (dsl/accept! (mut c) "keep")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.keep-under g))
                       (.text (dsl/name! (mut c) "a flag"))))
            (dsl/accept! (mut c) "group")
              (let [o (dsl/string! (mut c) "an opening literal")
                    e (dsl/string! (mut c) "a closing literal")]
                (set! (.group-open g) (.text o))
                (set! (.group-close g) (.text e))
                (set! (.group-kind g)
                      (.text (dsl/name! (mut c) "the parenthesis node"))))
            ;; `~X` positions: what they require, and kinds that may not be on their spine.
            ;; The first operator may not sit directly beside any of the others, whatever
            ;; their precedence: `a ?? b || c` is a syntax error.
            (dsl/accept! (mut c) "nomix")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.nomix g)) (.text (dsl/name! (mut c) "a kind"))))
            ;; A literal that is no token before certain bytes: JavaScript's `?.` before a digit
            ;; is `?` and a number (`a?.5:b`).
            (dsl/accept! (mut c) "notbefore")
              (let [l (dsl/string! (mut c) "a punctuation literal")
                    bytes (dsl/string! (mut c) "the bytes it may not stand before")]
                (push! (mut (.not-before g)) (.text l))
                (push! (mut (.not-before g)) (.text bytes))
                (dsl/expect! (mut c) ";"))
            (dsl/accept! (mut c) "keeplevel")
              (set! (.keep-min g) (.text (dsl/name! (mut c) "a rule")))
            (dsl/accept! (mut c) "keepforbid")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.keep-forbid g))
                       (.text (dsl/name! (mut c) "a kind"))))
            (dsl/accept! (mut c) "opaque")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.opaque g)) (.text (dsl/name! (mut c) "a kind"))))
            (dsl/accept! (mut c) "precedence")
              (while (not (dsl/accept! (mut c) ";"))
                (push! (mut (.precedence g))
                       (.text (dsl/name! (mut c) "a rule"))))
            :else (set! go false)))
    (while (not (dsl/eof? (mut c)))
      (push! (mut (.decls g)) (read-decl (mut c))))
    (analyse! (mut g) (mut c))
    (Loaded :grammar g :cursor c)))

(defn read-grammar [(source (slice u8)) (path (slice u8))] (-> (slice u8))
  (let [l (load-grammar source path)
        (mut g) (.grammar l)
        (mut c) (.cursor l)
        (mut levels) (ArrayList::new [Named] (rt/value-allocator))]
    (add-lit! (mut g) ",")
    (assign-levels! (mut g) (mut c) (mut levels))
    ;; Code generation order: bodies first, so literals and reps are all known.
    (let [(mut firsts) (first-memo-new)]
      (for d (.decls g)
        (let [k (.kind d)]
          (cond (or (= k (DFragment)) (= k (DToken)))
                  (emit-token! (mut g) (mut c) d)
                (= k (DHidden)) (emit-hidden! (mut g) (mut c) d)
                (= k (DRule)) (emit-rule! (mut g) (mut c) d (mut firsts))
                (= k (DPostfix)) (emit-chain! (mut g) (mut c) d true (mut firsts))
                (= k (DSuffix)) (emit-chain! (mut g) (mut c) d false (mut firsts))
                (= k (DInfix)) (emit-infix! (mut g) (mut c) d (mut firsts))
                :else 0))))
    (emit-reps! (mut g))
    (for l (.lits g) (emit-lit! (mut g) (mut c) l))
    (let [shell (dsl/render (emit-module! (mut g) (mut c) levels))]
      (splice-aux shell (.aux g)))))

;;; The module's text with every generated function where the marker stands.
(defn splice-aux [(shell (slice u8)) (aux (ArrayList (slice u8)))]
  (-> (slice u8))
  (let [marker "@@AUX@@"
        (mut b) (str/StrBuf::new (rt/value-allocator))
        (mut at) -1]
    (for i (range 0 (- (len shell) (len marker)))
      (when (and (< at 0) (rt/at? shell i marker)) (set! at i)))
    (when (< at 0) (panic "generated module is missing its marker"))
    (for i (range 0 at) (push! (mut (.bytes b)) (get shell i)))
    (let [(mut seen) (empty-strs)]
      (byte-tables shell (mut seen) (mut b))
      (for form aux (byte-tables form (mut seen) (mut b))))
    (for form aux
      (push-str! (mut b) form)
      (push-str! (mut b) "\n"))
    (for i (range (+ at (len marker)) (len shell))
      (push! (mut (.bytes b)) (get shell i)))
    (finish! (mut b))))

(defn read-syntax [(context Code)] (-> Code)
  (primitive/code-read (read-grammar (dsl/source-of context)
                                     (dsl/path-of context))
                       `(reader-config)))

;;; The same compiler as a generator, for grammars a reader must call at compile
;;; time: a provider image is built with no readers active, so it cannot import a
;;; .syntax module. An ordinary module expands a macro that calls this.
(defn define-from [(source (slice u8)) (path (slice u8))] (-> Code)
  (primitive/code-read (read-grammar source path) `(reader-config)))
