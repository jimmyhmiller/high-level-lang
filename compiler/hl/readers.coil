;;; Every language's reader, as one provider. Coil sets a provider up by compiling it with all it
;;; imports, and keeps what each setup allocates until the build ends; the languages share most
;;; of their code (the runtime, the grammar language, the DSL helpers), so one provider for all of
;;; them compiles that once instead of once for each.
;;;
;;; It asks each language for its module's text: a function from `Code` to `Code`, such as
;;; another reader's entry, would be expanded as a macro where it is called.
(module hl.readers)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :as str)
(import "hl.dsl" :as dsl)
(import "hl.rt" :as rt)
(import "hl.syntax" :as syntax)
(import "hl.rules" :as rules)
(import "hl.facts" :as facts)
(import "hl.rewrite" :as rewrite)
(import "hl.scopes" :as scopes)
(import "hl.pipeline" :as pipeline)

(reader-provider "hl.readers" read-any)

;;; A reading's values are its own: they are made in a region of the reading's, let go once its
;;; module's text is copied out of it. A build reads every file of its program in one process, and
;;; each reading reads the modules its file uses again, so what readings keep would add up.
(defn read-any [(context Code)] (-> Code)
  (let [r (rt/region-new)]
    (rt/region-enter! r)
    (let [made (module-text context)
          (mut copy) (str/StrBuf::new (malloc-allocator))]
      (push-str! (mut copy) made)
      (let [text (finish! (mut copy))]
        (rt/region-leave!)
        (rt/region-release! r)
        (let [(mut gone) (rt/regions-let-go!)] (free! (mut gone)))
        (primitive/code-read text `(reader-config))))))

;;; A file's module, made by the language its extension names.
(defn module-text [(context Code)] (-> (slice u8))
  (let [path (dsl/path-of context)]
    (cond (rt/ends-with path ".syntax")
            (syntax/read-grammar (dsl/source-of context) path)
          (or (rt/ends-with path ".rules") (rt/ends-with path ".attrs"))
            (rules/rules-text context)
          (rt/ends-with path ".facts") (facts/module-text context)
          (rt/ends-with path ".rewrite") (rewrite/module-text context)
          (rt/ends-with path ".scopes") (scopes/module-text context)
          (rt/ends-with path ".pipeline") (pipeline/module-text context)
          :else
            (dsl/fail-at path
                         1
                         1
                         "no language reads a file with this extension"))))
