;;; `.scopes`: the binding-structure language. A table saying which nodes open scopes
;;; and where bindings land compiles to a resolver: a walker generated for one
;;; grammar's node types, recording which symbol each identifier leaf means.
;;;
;;;   scopes bundle.js          # the grammar
;;;   ref Ident ;               # leaves that refer to a name
;;;   bind BindName ;           # leaves that introduce one
;;;   function FuncDecl Arrow ; # open a function scope
;;;   block Block For ;         # open a block scope
;;;   var VarDecl ;             # names beneath hoist to the function scope
;;;   lexical LetDecl Import ;  # names beneath land in the current block scope
;;;   param Params ;            # names beneath land in the function's own scope
;;;   hoist-name FuncDecl ;     # the node's first child: function scope
;;;   block-name ClassDecl ;    # the node's first child: current block scope
;;;   self-name FuncExpr Arrow ;# the node's first child: its own new scope
;;;   key-first Method ;        # the node's first child resolves outside its scope
;;;   inside Let name body ;    # of a node that opens a scope, the children in it: the
;;;                             # others resolve in the scope around it (ML's `let`)
;;;   sequential LetStmt ;      # a node whose scope also holds the siblings after it
;;;                             # (`let` in a block, where each one shadows the last)
;;;   dynamic-kind With ;       # names in and around this cannot be renamed
;;;   dynamic-name eval ;       # nor around a reference to this name
;;;
;;; Generated: `analyze TREE TABLE SCOPE BINDINGS`, where BINDINGS maps a leaf's start
;;; offset to its symbol. Free names go to the table.
(module hl.scopes)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.syntax" :as syntax)
(import "coil.meta" :as meta)
(import "hl.grammars.scopes" :as g)

(reader-provider "hl.scopes" read-scopes)

(defn kind-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "syn/K" n))

;;; (match k (syn/KA [] true) … (_ false))
(defn kind-test [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for n names (push! (mut arms) `(~(kind-sym n) [] true)))
    `(match k ~@arms (_ false))))

(defn name-test [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut parts) (primitive/code-list-new)]
    (for n names (push! (mut parts) `(= name ~n)))
    `(or false ~@parts)))

;;; A table entry's error, at the entry.
(defn fail-on [(src (slice u8)) (path (slice u8)) (n g/Node) (msg (slice u8))] (-> never)
  (let [at (rt/line-col src (.lo n))]
    (dsl/fail-at path (.line at) (.col at) msg)))

(defn kind-entry [(kinds (ArrayList syntax/KindEntry)) (name (slice u8))]
  (-> (Option syntax/KindEntry))
  (let [(mut out) (None [syntax/KindEntry])]
    (for k kinds (when (= (.name k) name) (set! out (Some k))))
    out))

(defn has-name? [(names (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for n names (when (= n name) (set! hit true)))
    hit))

;;; The node table of the grammar the tables are for, through the manifest.
(defn grammar-kinds [(context Code) (src (slice u8)) (path (slice u8)) (at g/Node)]
  (-> (ArrayList syntax/KindEntry))
  (match (dsl/module-file (dsl/manifest-entries (meta/read-context-manifest context)) (.text at))
    (Some [file] (syntax/grammar-table (rt/read-all file) file))
    (None [] (fail-on src path at (dsl/join3 "the manifest names no module " (.text at) "")))))

;;; `inside KIND CHILD… ;`: the arm saying which of a KIND node's children are in its scope.
(defn inside-arm [(kinds (ArrayList syntax/KindEntry))
                  (src (slice u8))
                  (path (slice u8))
                  (table g/Node)
                  (opening (ArrayList (slice u8)))] (-> Code)
  (let [names (.kids (get (.kids table) 1))]
    (when (= (len names) 0)
      (fail-on src path table "inside names a node and the children of it in its scope"))
    (let [kind (get names 0)
          entry
            (match (kind-entry kinds (.text kind))
              (Some [e] e)
              (None [] (fail-on src path kind (dsl/join2 "the grammar has no node named " (.text kind)))))
          (mut tests) (primitive/code-list-new)]
      (unless (has-name? opening (.text kind))
        (fail-on src path kind
                 (dsl/join3 (.text kind) " opens no scope: name it under block or function" "")))
      (for i (range 1 (len names))
        (let [child (get names i)
              (mut at) -1]
          (for j (range 0 (len (.fields entry)))
            (when (= (get (.fields entry) j) (.text child)) (set! at j)))
          (when (< at 0)
            (fail-on src path child
                     (dsl/join3 (.text kind) " has no child named " (.text child))))
          (push! (mut tests) `(= i ~at))))
      `(~(kind-sym (.text kind)) [] (or false ~@tests)))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        tree
          (match (g/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (dsl/join2 "expected " (.want e)))))
        grammar (.text (get (.kids tree) 0))
        (mut ref) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut bind) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut function) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut block) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut var) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut lexical) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut param) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut hoist-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut block-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut self-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut key-first) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut dynamic-kind) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut dynamic-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut insides) (ArrayList::new [g/Node] (malloc-allocator))
        (mut sequential) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut sequential-nodes) (ArrayList::new [g/Node] (malloc-allocator))
        kinds (grammar-kinds context src path (get (.kids tree) 0))]
    (for table (.kids (get (.kids tree) 1))
      (let [t (get (.kids table) 0)
            w (.text t)
            (mut names) (ArrayList::new [(slice u8)] (malloc-allocator))]
        (for n (.kids (get (.kids table) 1)) (push! (mut names) (.text n)))
        ;; Every table but `dynamic-name` and `inside` lists the grammar's nodes.
        (unless (or (= w "dynamic-name") (= w "inside"))
          (for n (.kids (get (.kids table) 1))
            (match (kind-entry kinds (.text n))
              (Some [_] 0)
              (None []
                    (fail-on src path n
                             (dsl/join3 "the grammar " grammar (dsl/join2 " has no node named " (.text n))))))))
        (cond (= w "inside") (push! (mut insides) table)
              (= w "sequential")
                (do (set! sequential names)
                    (for n (.kids (get (.kids table) 1)) (push! (mut sequential-nodes) n)))
              (= w "ref") (set! ref names)
              (= w "bind") (set! bind names)
              (= w "function") (set! function names)
              (= w "block") (set! block names)
              (= w "var") (set! var names)
              (= w "lexical") (set! lexical names)
              (= w "param") (set! param names)
              (= w "hoist-name") (set! hoist-name names)
              (= w "block-name") (set! block-name names)
              (= w "self-name") (set! self-name names)
              (= w "key-first") (set! key-first names)
              (= w "dynamic-kind") (set! dynamic-kind names)
              (= w "dynamic-name") (set! dynamic-name names)
              :else
                (let [at (rt/line-col src (.lo t))]
                  (dsl/fail-at path
                               (.line at)
                               (.col at)
                               (dsl/join2 "unknown table: " w))))))
    (let [(mut opening) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut inside-arms) (primitive/code-list-new)]
      (for n function (push! (mut opening) n))
      (for n block (push! (mut opening) n))
      (for t insides (push! (mut inside-arms) (inside-arm kinds src path t opening)))
      (for n sequential-nodes
        (unless (has-name? opening (.text n))
          (fail-on src path n
                   (dsl/join3 (.text n) " opens no scope: name it under block or function" ""))))
      (dsl/render `(do
                     (import "hl.symtab" :as sym)
                     (import "coil.hashmap" :use [HashMap i64-keyops])
                     (import "coil.arraylist" :use [ArrayList])
                     (import "coil.alloc" :use [malloc-allocator])
                     (import ~grammar :as syn)

                     (defn ref? [(k syn/Kind)] (-> bool)
                       ~(kind-test ref))
                     (defn bind? [(k syn/Kind)] (-> bool)
                       ~(kind-test bind))
                     (defn function? [(k syn/Kind)] (-> bool)
                       ~(kind-test function))
                     (defn block? [(k syn/Kind)] (-> bool)
                       ~(kind-test block))
                     (defn var? [(k syn/Kind)] (-> bool)
                       ~(kind-test var))
                     (defn lexical? [(k syn/Kind)] (-> bool)
                       ~(kind-test lexical))
                     (defn param? [(k syn/Kind)] (-> bool)
                       ~(kind-test param))
                     (defn hoist-name? [(k syn/Kind)] (-> bool)
                       ~(kind-test hoist-name))
                     (defn block-name? [(k syn/Kind)] (-> bool)
                       ~(kind-test block-name))
                     (defn self-name? [(k syn/Kind)] (-> bool)
                       ~(kind-test self-name))
                     (defn key-first? [(k syn/Kind)] (-> bool)
                       ~(kind-test key-first))
                     (defn dynamic-kind? [(k syn/Kind)] (-> bool)
                       ~(kind-test dynamic-kind))
                     (defn dynamic-name? [(name (slice u8))] (-> bool)
                       ~(name-test dynamic-name))
                     ;;; Whether child `i` of a node of kind `k` that opens a scope is in that scope.
                     (defn inside? [(k syn/Kind) (i i64)] (-> bool)
                       (match k ~@inside-arms (_ true)))
                     (defn sequential? [(k syn/Kind)] (-> bool)
                       ~(kind-test sequential))

                     (defn opens? [(k syn/Kind)] (-> bool)
                       (or (function? k) (block? k)))

                     ;;; Declare every binding beneath `n`, stopping at anything with its own scope.
                     (defn declare-beneath! [(n syn/Node)
                                             (t (mut sym/Table))
                                             (scope i64)] (-> void)
                       (if (bind? (.kind n))
                           (do (sym/declare! (mut t) scope (.text n)) 0)
                           (unless (opens? (.kind n))
                             (for (ref k) (.kids n)
                               (declare-beneath! k (mut t) scope)))))

                     (defn declare-first! [(n syn/Node)
                                           (t (mut sym/Table))
                                           (scope i64)] (-> void)
                       (when (> (len (.kids n)) 0)
                         (let [first (get (.kids n) 0)]
                           (when (bind? (.kind first))
                             (sym/declare! (mut t) scope (.text first))
                             0))))

                     ;;; `var`s and hoisted names, through nested blocks but not nested functions.
                     (defn hoist-scan! [(n syn/Node)
                                        (t (mut sym/Table))
                                        (scope i64)] (-> void)
                       (for (ref k) (.kids n) (hoist-kid! k (mut t) scope)))

                     (defn hoist-kid! [(k syn/Node)
                                       (t (mut sym/Table))
                                       (scope i64)] (-> void)
                       (cond (var? (.kind k)) (declare-beneath! k (mut t) scope)
                             (hoist-name? (.kind k))
                               (declare-first! k (mut t) scope)
                             (function? (.kind k)) 0
                             :else (hoist-scan! k (mut t) scope)))

                     ;;; Lexical names of this block, not of blocks inside it.
                     (defn lexical-scan! [(n syn/Node)
                                          (t (mut sym/Table))
                                          (scope i64)] (-> void)
                       (for (ref k) (.kids n) (lexical-kid! k (mut t) scope)))

                     (defn lexical-kid! [(k syn/Node)
                                         (t (mut sym/Table))
                                         (scope i64)] (-> void)
                       (cond (lexical? (.kind k))
                               (declare-beneath! k (mut t) scope)
                             (block-name? (.kind k))
                               (declare-first! k (mut t) scope)
                             (opens? (.kind k)) 0
                             :else (lexical-scan! k (mut t) scope)))

                     ;;; What a node that opens a scope declares in it, from the children in it: a
                     ;;; function's parameters, then what hoists to it, then each scope's lexical names.
                     (defn scope-scan! [(n syn/Node)
                                        (t (mut sym/Table))
                                        (inner i64)] (-> void)
                       (let [k (.kind n)
                             count (len (.kids n))]
                         (when (function? k)
                           (for i (range 0 count)
                             (let [c (get (.kids n) i)]
                               (when (and (inside? k i) (param? (.kind c)))
                                 (declare-beneath! c (mut t) inner))))
                           (for i (range 0 count)
                             (when (inside? k i) (hoist-kid! (get (.kids n) i) (mut t) inner))))
                         (for i (range 0 count)
                           (when (inside? k i) (lexical-kid! (get (.kids n) i) (mut t) inner)))))

                     ;;; Walk a node; the scope it opened, or -1.
                     (defn walk [(n syn/Node)
                                 (t (mut sym/Table))
                                 (scope i64)
                                 (b (mut (HashMap i64 i64)))] (-> i64)
                       (let [k (.kind n)]
                         (cond (ref? k)
                                 (do
                                   (when (dynamic-name? (.text n))
                                     (sym/mark-dynamic! (mut t) scope))
                                   (match (sym/resolve (mut t) scope (.text n))
                                     (Some [s]
                                           (sym/add-use! (mut t) s)
                                           (set! (mut b) (.lo n) s))
                                     (None [] (sym/add-free! (mut t) (.text n))))
                                   -1)
                               (bind? k)
                                 (do
                                   (match (sym/resolve (mut t) scope (.text n))
                                     (Some [s]
                                           (sym/add-use! (mut t) s)
                                           (set! (mut b) (.lo n) s))
                                     (None []
                                           (panic "binding {} was not declared by the scope tables"
                                                  (.text n))))
                                   -1)
                               (opens? k)
                                 (let [inner
                                         (sym/new-scope! (mut t)
                                                         scope
                                                         (function? k))
                                       (mut start) 0]
                                   (when (dynamic-kind? k)
                                     (sym/mark-dynamic! (mut t) inner))
                                   (when (self-name? k)
                                     (declare-first! n (mut t) inner))
                                   (scope-scan! n (mut t) inner)
                                   ;; A declaration's own name belongs to the enclosing scope, even when
                                   ;; its body declares the same name again.
                                   (when (or (key-first? k) (hoist-name? k))
                                     (walk (get (.kids n) 0)
                                           (mut t)
                                           scope
                                           (mut b))
                                     (set! start 1))
                                   ;; A sequential child's scope holds the siblings after it, on its side.
                                   (let [(mut in) inner
                                         (mut out) scope]
                                     (for i (range start (len (.kids n)))
                                       (let [kid (get (.kids n) i)
                                             opened (walk kid (mut t) (if (inside? k i) in out) (mut b))]
                                         (when (and (sequential? (.kind kid)) (>= opened 0))
                                           (if (inside? k i)
                                               (do (set! in opened) 0)
                                               (do (set! out opened) 0))))))
                                   inner)
                               :else
                                 (do
                                   (when (dynamic-kind? k)
                                     (sym/mark-dynamic! (mut t) scope))
                                   (let [(mut cur) scope]
                                     (for (ref child) (.kids n)
                                       (let [opened (walk child (mut t) cur (mut b))]
                                         (when (and (sequential? (.kind child)) (>= opened 0))
                                           (set! cur opened)))))
                                   -1))))

                     ;;; Analyse a whole program in its own new function-level scope.
                     (defn analyze [(tree syn/Node)
                                    (t (mut sym/Table))
                                    (parent i64)
                                    (b (mut (HashMap i64 i64)))] (-> i64)
                       (let [root (sym/new-scope! (mut t) parent true)]
                         (declare-program! tree (mut t) root)
                         ;; The program itself may open a scope: a `let` can be a whole program.
                         (walk tree (mut t) root (mut b))
                         root))

                     ;;; What `analyze` does before it walks: the program's own names, declared in `root`.
                     (defn declare-program! [(tree syn/Node)
                                             (t (mut sym/Table))
                                             (root i64)] (-> void)
                       (hoist-scan! tree (mut t) root)
                       (lexical-scan! tree (mut t) root))

                     ;;; What it then does for each part of the program, in a table whose scope 0 stands for
                     ;;; the program's (`table-under`): so parts can be walked at once, and grafted in order.
                     ;;; A sequential part's scope would hold the parts after it, which are walked apart.
                     (defn walk-part [(n syn/Node)
                                      (t (mut sym/Table))
                                      (b (mut (HashMap i64 i64)))] (-> void)
                       (when (sequential? (.kind n))
                         (panic "a sequential statement at the top level needs the program analysed whole, not in parts"))
                       (walk n (mut t) 0 (mut b))
                       0)

                     ;;; Under a function scope, and with `outer` names, under one more function scope that
                     ;;; declares them: a wrapper's parameters, say.
                     (defn outer-scope! [(t (mut sym/Table))
                                         (outer (ArrayList (slice u8)))] (-> i64)
                       (let [top (sym/new-scope! (mut t) -1 true)]
                         (if (= (len outer) 0)
                             top
                             (let [w (sym/new-scope! (mut t) top true)]
                               (for (ref name) outer
                                 (sym/declare! (mut t) w name))
                               w))))

                     (defn no-bindings [] (-> (HashMap i64 i64))
                       (HashMap::new [i64 i64] (malloc-allocator) (i64-keyops)))

                     ;;; A whole program analysed in a table of its own.
                     (defn analysis [(tree syn/Node)
                                     (outer (ArrayList (slice u8)))]
                       (-> sym/Analysis)
                       (let [(mut t) (sym/table-new)
                             scope (outer-scope! (mut t) outer)
                             (mut b) (no-bindings)
                             root (analyze tree (mut t) scope (mut b))]
                         (sym/Analysis
                           :table t
                           :root root
                           :bindings b
                           :free (sym/free-names t))))

                     ;;; Only the program's own names, declared in its root scope before any of it is walked.
                     (defn declarations [(tree syn/Node)
                                         (outer (ArrayList (slice u8)))]
                       (-> sym/Analysis)
                       (let [(mut t) (sym/table-new)
                             root
                               (sym/new-scope! (mut t)
                                               (outer-scope! (mut t) outer)
                                               true)]
                         (declare-program! tree (mut t) root)
                         (sym/Analysis
                           :table t
                           :root root
                           :bindings (no-bindings)
                           :free (ArrayList::new [(slice u8)] (malloc-allocator)))))

                     ;;; Parts of a program walked in a table of their own under `scope` of `t` (`table-under`),
                     ;;; at once with others walked the same way; `grafted` puts the tables back.
                     (defn part-analysis [(t sym/Table)
                                          (scope i64)
                                          (parts (ArrayList syn/Node))]
                       (-> sym/Analysis)
                       (let [(mut own) (sym/table-under t scope)
                             (mut b) (no-bindings)]
                         (for (ref part) parts (walk-part part (mut own) (mut b)))
                         (sym/Analysis
                           :table own
                           :root 0
                           :bindings b
                           :free (ArrayList::new [(slice u8)] (malloc-allocator))))))))))

(defn read-scopes [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
