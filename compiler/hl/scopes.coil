;;; `.scopes`: the binding-structure language. Tables saying which nodes open scopes, of
;;; which kind, and where bindings land compile to a resolver: a walker generated for one
;;; grammar's node types, recording which symbol each identifier leaf means. Every kind of scope
;;; is the file's own; nothing here knows any language's.
;;;
;;;   scopes bundle.js                  # the grammar
;;;   ref Ident ;                       # leaves that refer to a name
;;;   bind BindName ;                   # leaves that introduce one
;;;   scope function FuncDecl Arrow ;   # nodes that open a scope, and its kind
;;;   scope block Block For ;
;;;   program function ;                # the kind of scope a whole program is
;;;   names VarDecl Params in function ;# every binding beneath the node, up to anything that
;;;                                     # opens a scope, lands in the nearest scope around of a
;;;                                     # kind named: here through blocks, to the function's
;;;   names LetDecl in block function ; # here in whatever scope is nearest
;;;   name FuncDecl in function ;       # the node's first child, so
;;;   name FuncExpr in own ;            # `own`: the scope the node opens itself
;;;   outside name of FuncDecl ;        # children of a node that opens a scope that resolve
;;;                                     # in the scope around it (ML's `let`'s value)
;;;   sequential LetStmt ;              # a node whose scope also holds the siblings after it
;;;                                     # (`let` in a block, where each one shadows the last)
;;;   dynamic With ;                    # names in and around this cannot be renamed
;;;   dynamic-name eval ;               # nor around a reference to this name
;;;   dynamic-name eval in Call through Paren ;
;;;                                     # or only around one that is a Call's first child,
;;;                                     # itself or inside any number of Parens
;;;
;;; A scope's names are declared when it opens: the node's own (`in own`), then, for each set of
;;; kinds the placements name in the order they first do, those landing in it, in the order they
;;; are written.
;;;
;;; Generated: `analyze TREE TABLE SCOPE BINDINGS`, where BINDINGS maps a leaf's start
;;; offset to its symbol. Free names go to the table.
(module hl.scopes)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.syntax" :as syntax)
(import "coil.meta" :as meta)
(import "hl.grammars.scopes" :as g)
(import "hl.pipeline" :as pl)

(reader-provider "hl.scopes" read-scopes)

(defn kind-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "syn/K" n))

;;; (match k (syn/KA [] true) … (_ false))
(defn kind-test [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for n names (push! (mut arms) `(~(kind-sym n) [] true)))
    `(match k ~@arms (_ false))))

(defn name-test [(names (ArrayList (slice u8)))] (-> Code)
  (let [(mut parts) (primitive/code-list-new)]
    (for n names (push! (mut parts) `(= name ~n)))
    `(or false ~@parts)))

;;; A table entry's error, at the entry.
(defn fail-on [(src (slice u8)) (path (slice u8)) (n g/Node) (msg (slice u8))]
  (-> never)
  (let [at (rt/line-col src (.lo n))]
    (dsl/fail-at path (.line at) (.col at) msg)))

(defn kind-entry [(kinds (ArrayList syntax/KindEntry)) (name (slice u8))]
  (-> (Option syntax/KindEntry))
  (let [(mut out) (None [syntax/KindEntry])]
    (for k kinds (when (= (.name k) name) (set! out (Some k))))
    out))

(defn has-name? [(names (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for n names (when (= n name) (set! hit true)))
    hit))

;;; The node table of the grammar the tables are for, through the manifest.
(defn grammar-kinds [(context Code)
                     (src (slice u8))
                     (path (slice u8))
                     (at g/Node)]
  (-> (ArrayList syntax/KindEntry))
  (match (dsl/module-file (dsl/manifest-entries (meta/read-context-manifest context))
                          (.text at))
    (Some [file] (syntax/grammar-table (rt/read-all file) file))
    (None []
          (fail-on src
                   path
                   at
                   (dsl/join3 "the manifest names no module " (.text at) "")))))

;;; The texts of a list of names.
(defn texts [(list g/Node)] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (for n (.kids list) (push! (mut out) (.text n)))
    out))

;;; Every name of a list is a node of the grammar.
(defn check-nodes! [(kinds (ArrayList syntax/KindEntry))
                    (src (slice u8))
                    (path (slice u8))
                    (grammar (slice u8))
                    (list g/Node)] (-> void)
  (for n (.kids list)
    (match (kind-entry kinds (.text n))
      (Some [_] 0)
      (None []
            (fail-on src
                     path
                     n
                     (dsl/join3 "the grammar "
                                grammar
                                (dsl/join2 " has no node named " (.text n))))))))

;;; Every name of a list is a node that opens a scope.
(defn check-opens! [(src (slice u8))
                    (path (slice u8))
                    (opener (ArrayList (slice u8)))
                    (list g/Node)] (-> void)
  (for n (.kids list)
    (unless (has-name? opener (.text n))
      (fail-on src
               path
               n
               (dsl/join3 (.text n) " opens no scope: name it under scope" "")))))

;;; The kinds a placement names, in the order the file declares them, one space between: the
;;; same for the same set, in whatever order it was written.
(defn group-key [(declared (ArrayList (slice u8)))
                 (named (ArrayList (slice u8)))] (-> (slice u8))
  (let [(mut out) ""]
    (for k declared
      (when (has-name? named k)
        (set! out (if (= (len out) 0) k (dsl/join3 out " " k)))))
    out))

(defn index-of-name [(names (ArrayList (slice u8))) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len names))
      (when (and (< at 0) (= (get names i) name)) (set! at i)))
    at))

(defn group-sym [(what (slice u8)) (g i64) (end (slice u8))] (-> Code)
  (primitive/code-symbol what (dsl/join2 (rt/num-text g) end)))

;;; `outside CHILD… of NODE… ;`: the arm saying which of one NODE's children are in its scope.
(defn outside-arm [(kinds (ArrayList syntax/KindEntry))
                   (src (slice u8))
                   (path (slice u8))
                   (children g/Node)
                   (node g/Node)] (-> Code)
  (let [entry
          (match (kind-entry kinds (.text node))
            (Some [e] e)
            (None []
                  (fail-on src
                           path
                           node
                           (dsl/join2 "the grammar has no node named "
                                      (.text node)))))
        (mut tests) (primitive/code-list-new)]
    (for child (.kids children)
      (let [(mut at) -1]
        (for j (range 0 (len (.fields entry)))
          (when (= (get (.fields entry) j) (.text child)) (set! at j)))
        (when (< at 0)
          (fail-on src
                   path
                   child
                   (dsl/join3 (.text node) " has no child named " (.text child))))
        (push! (mut tests) `(= i ~at))))
    `(~(kind-sym (.text node)) [] (not (or false ~@tests)))))

;;; (match k (syn/KA [] "a") … (_ ""))
(defn text-of-kind [(nodes (ArrayList (slice u8)))
                    (texts (ArrayList (slice u8)))] (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for i (range 0 (len nodes))
      (push! (mut arms) `(~(kind-sym (get nodes i)) [] ~(get texts i))))
    `(match k ~@arms (_ ""))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        tree
          (match (g/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (dsl/join2 "expected " (.want e)))))
        grammar (.text (get (.kids tree) 0))
        tables (.kids (get (.kids tree) 1))
        ;; A stage of the program's pipeline that names this module (`inside`) has it divide a big
        ;; program's analysis itself, in parts of about `part-bytes` of source.
        manifest (meta/read-context-manifest context)
        stage (pl/inside-stage manifest path)
        part-bytes
          (pl/size-given manifest (dsl/join2 (pl/module-named manifest path) "/part-bytes") 8192)
        kinds (grammar-kinds context src path (get (.kids tree) 0))
        (mut ref) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut bind) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut sequential) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut dynamic) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut dynamic-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        ;; Names dynamic only as what a call calls: the names, the calls, and what they may be
        ;; wrapped in between.
        (mut call-name) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut caller) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut callee-wrapper) (ArrayList::new [(slice u8)] (malloc-allocator))
        ;; Nodes that open a scope, and the kind of each; the kinds, in the order declared.
        (mut opener) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut opener-kind) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut declared) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut program) ""
        ;; Placements: the node, whether its first child or every binding beneath it, and the
        ;; group of kinds it lands in, -1 for its own scope.
        (mut place-node) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut place-first) (ArrayList::new [bool] (malloc-allocator))
        (mut place-group) (ArrayList::new [i64] (malloc-allocator))
        (mut groups) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut beneath-node) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut beneath-text) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut outside-seen) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut inside-arms) (primitive/code-list-new)]
    ;; First the scopes, which the other tables name.
    (for table tables
      (cond (= (.kind table) (g/KOpens))
              (let [kind (.text (get (.kids table) 0))
                    nodes (get (.kids table) 1)]
                (check-nodes! kinds src path grammar nodes)
                (when (= kind "own")
                  (fail-on src
                           path
                           (get (.kids table) 0)
                           "own is the scope a node opens itself, not a kind"))
                (unless (has-name? declared kind) (push! (mut declared) kind))
                (for n (.kids nodes)
                  (when (has-name? opener (.text n))
                    (fail-on src
                             path
                             n
                             (dsl/join2 "a second scope for " (.text n))))
                  (push! (mut opener) (.text n))
                  (push! (mut opener-kind) kind)))
            (= (.kind table) (g/KProgram))
              (do
                (when (> (len program) 0)
                  (fail-on src path table "a second program table"))
                (set! program (.text (get (.kids table) 0)))
                (unless (has-name? declared program)
                  (push! (mut declared) program))
                0)
            :else 0))
    (when (= (len program) 0)
      (fail-on src
               path
               tree
               "say which kind of scope a whole program is: program KIND ;"))
    (for table tables
      (let [k (.kind table)]
        (cond (= k (g/KRefs))
                (do
                  (check-nodes! kinds src path grammar (get (.kids table) 0))
                  (for n (texts (get (.kids table) 0)) (push! (mut ref) n))
                  0)
              (= k (g/KBinds))
                (do
                  (check-nodes! kinds src path grammar (get (.kids table) 0))
                  (for n (texts (get (.kids table) 0)) (push! (mut bind) n))
                  0)
              (= k (g/KSequential))
                (do
                  (check-nodes! kinds src path grammar (get (.kids table) 0))
                  (check-opens! src path opener (get (.kids table) 0))
                  (for n (texts (get (.kids table) 0))
                    (push! (mut sequential) n))
                  0)
              (= k (g/KDynamic))
                (do
                  (check-nodes! kinds src path grammar (get (.kids table) 0))
                  (for n (texts (get (.kids table) 0)) (push! (mut dynamic) n))
                  0)
              (= k (g/KDynamicName))
                (do
                  (for n (texts (get (.kids table) 0))
                    (push! (mut dynamic-name) n))
                  0)
              (= k (g/KDynamicCall))
                (do
                  (check-nodes! kinds src path grammar (get (.kids table) 1))
                  (check-nodes! kinds src path grammar (get (.kids table) 2))
                  (for n (texts (get (.kids table) 0)) (push! (mut call-name) n))
                  (for n (texts (get (.kids table) 1)) (push! (mut caller) n))
                  (for n (texts (get (.kids table) 2))
                    (push! (mut callee-wrapper) n))
                  0)
              (= k (g/KOutside))
                (do
                  (check-opens! src path opener (get (.kids table) 1))
                  (for node (.kids (get (.kids table) 1))
                    (when (has-name? outside-seen (.text node))
                      (fail-on src
                               path
                               node
                               (dsl/join2 "a second outside table for "
                                          (.text node))))
                    (push! (mut outside-seen) (.text node))
                    (push! (mut inside-arms)
                           (outside-arm kinds
                                        src
                                        path
                                        (get (.kids table) 0)
                                        node)))
                  0)
              (or (= k (g/KBeneath)) (= k (g/KFirst)))
                (let [nodes (get (.kids table) 0)
                      named (texts (get (.kids table) 1))
                      first? (= k (g/KFirst))]
                  (check-nodes! kinds src path grammar nodes)
                  (for n (.kids (get (.kids table) 1))
                    (unless (or (= (.text n) "own")
                                (has-name? declared (.text n)))
                      (fail-on src
                               path
                               n
                               (dsl/join3 "no scope is of the kind "
                                          (.text n)
                                          ": declare it with scope or program"))))
                  (let [own? (has-name? named "own")
                        key (group-key declared named)]
                    (when (and own? (> (len named) 1))
                      (fail-on src
                               path
                               (get (.kids table) 1)
                               "own is a scope of its own: name no kind beside it"))
                    (when own? (check-opens! src path opener nodes))
                    (let [group
                            (if own?
                                -1
                                (let [at (index-of-name groups key)]
                                  (if (>= at 0)
                                      at
                                      (do
                                        (push! (mut groups) key)
                                        (- (len groups) 1)))))]
                      (for n (.kids nodes)
                        (when (has-name? place-node (.text n))
                          (fail-on src
                                   path
                                   n
                                   (dsl/join2 "a second placement for "
                                              (.text n))))
                        (push! (mut place-node) (.text n))
                        (push! (mut place-first) first?)
                        (push! (mut place-group) group)
                        (unless first?
                          (push! (mut beneath-node) (.text n))
                          (push! (mut beneath-text) (if own? "own" key))))))
                  0)
              :else 0)))
    (let [(mut own-first) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut own-beneath) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut group-fns) (primitive/code-list-new)
          (mut group-scans) (primitive/code-list-new)
          (mut program-scans) (primitive/code-list-new)]
      (for i (range 0 (len place-node))
        (when (< (get place-group i) 0)
          (if (get place-first i)
              (push! (mut own-first) (get place-node i))
              (push! (mut own-beneath) (get place-node i)))))
      (for g (range 0 (len groups))
        (let [in-group (dsl/words (get groups g))
              (mut beneath) (ArrayList::new [(slice u8)] (malloc-allocator))
              (mut firsts) (ArrayList::new [(slice u8)] (malloc-allocator))
              (mut stops) (ArrayList::new [(slice u8)] (malloc-allocator))
              beneath? (group-sym "beneath-" g "?")
              first? (group-sym "first-" g "?")
              stops? (group-sym "stops-" g "?")
              scan! (group-sym "scan-" g "!")
              scan-kid! (group-sym "scan-kid-" g "!")]
          (for i (range 0 (len place-node))
            (when (= (get place-group i) g)
              (if (get place-first i)
                  (push! (mut firsts) (get place-node i))
                  (push! (mut beneath) (get place-node i)))))
          (for i (range 0 (len opener))
            (when (has-name? in-group (get opener-kind i))
              (push! (mut stops) (get opener i))))
          (push! (mut group-fns)
                 `(defn ~beneath? [(k syn/Kind)] (-> bool)
                    ~(kind-test beneath)))
          (push! (mut group-fns)
                 `(defn ~first? [(k syn/Kind)] (-> bool)
                    ~(kind-test firsts)))
          ;; A node that opens a scope of a kind of the group, which the names beneath land in.
          (push! (mut group-fns)
                 `(defn ~stops? [(k syn/Kind)] (-> bool)
                    ~(kind-test stops)))
          (push! (mut group-fns)
                 `(defn ~scan! [(n syn/Node) (t (mut sym/Table)) (scope i64)]
                    (-> void)
                    (for (ref k) (.kids n) (~scan-kid! k (mut t) scope))))
          (push! (mut group-fns)
                 `(defn ~scan-kid! [(k syn/Node)
                                    (t (mut sym/Table))
                                    (scope i64)] (-> void)
                    (cond (~beneath? (.kind k))
                            (declare-beneath! k (mut t) scope)
                          (~first? (.kind k)) (declare-first! k (mut t) scope)
                          (~stops? (.kind k)) 0
                          :else (~scan! k (mut t) scope))))
          (push! (mut group-scans)
                 `(when (~stops? k)
                    (for i (range 0 count)
                      (when (inside? k i)
                        (~scan-kid! (get (.kids n) i) (mut t) inner)))))
          (when (has-name? in-group program)
            (push! (mut program-scans) `(~scan! tree (mut t) root)))))
      (dsl/render `(do
                     (import "hl.symtab" :as sym)
                     (import "coil.hashmap" :use [HashMap i64-keyops])
                     (import "coil.arraylist" :use [ArrayList])
                     (import "hl.rt" :as rt)
                     (import "coil.atomic" :as atomic)
                     (import ~grammar :as syn)

                     (defn ref? [(k syn/Kind)] (-> bool)
                       ~(kind-test ref))
                     (defn bind? [(k syn/Kind)] (-> bool)
                       ~(kind-test bind))
                     (defn opens? [(k syn/Kind)] (-> bool)
                       ~(kind-test opener))
                     ;;; The kind of scope a node opens, or "".
                     (defn scope-kind [(k syn/Kind)] (-> (slice u8))
                       ~(text-of-kind opener opener-kind))
                     ;;; Where every binding beneath a node lands: the kinds of scope, one space
                     ;;; between, in the order the file declares them; "own"; or "".
                     (defn names-in [(k syn/Kind)] (-> (slice u8))
                       ~(text-of-kind beneath-node beneath-text))
                     (defn sequential? [(k syn/Kind)] (-> bool)
                       ~(kind-test sequential))
                     (defn dynamic? [(k syn/Kind)] (-> bool)
                       ~(kind-test dynamic))
                     (defn dynamic-name? [(name (slice u8))] (-> bool)
                       ~(name-test dynamic-name))
                     (defn caller? [(k syn/Kind)] (-> bool)
                       ~(kind-test caller))
                     (defn callee-wrapper? [(k syn/Kind)] (-> bool)
                       ~(kind-test callee-wrapper))
                     (defn call-name? [(name (slice u8))] (-> bool)
                       ~(name-test call-name))
                     ;;; Whether a call calls a name that makes it dynamic, through any wrappers.
                     (defn dynamic-call? [(n syn/Node)] (-> bool)
                       (and (caller? (.kind n))
                            (> (len (.kids n)) 0)
                            (let [(mut at) (get (.kids n) 0)]
                              (while (and (callee-wrapper? (.kind at)) (> (len (.kids at)) 0))
                                (set! at (get (.kids at) 0)))
                              (and (ref? (.kind at)) (call-name? (.text at))))))
                     (defn own-first? [(k syn/Kind)] (-> bool)
                       ~(kind-test own-first))
                     (defn own-beneath? [(k syn/Kind)] (-> bool)
                       ~(kind-test own-beneath))
                     ;;; Whether child `i` of a node of kind `k` that opens a scope is in that scope.
                     (defn inside? [(k syn/Kind) (i i64)] (-> bool)
                       (match k ~@inside-arms (_ true)))

                     ;;; Declare every binding beneath `n`, stopping at anything with its own scope.
                     (defn declare-beneath! [(n syn/Node)
                                             (t (mut sym/Table))
                                             (scope i64)] (-> void)
                       (if (bind? (.kind n))
                           (do (sym/declare! (mut t) scope (.text n)) 0)
                           (unless (opens? (.kind n))
                             (for (ref k) (.kids n)
                               (declare-beneath! k (mut t) scope)))))

                     (defn declare-first! [(n syn/Node)
                                           (t (mut sym/Table))
                                           (scope i64)] (-> void)
                       (when (> (len (.kids n)) 0)
                         (let [first (get (.kids n) 0)]
                           (when (bind? (.kind first))
                             (sym/declare! (mut t) scope (.text first))
                             0))))

                     ;; For each group of kinds the placements name: a scan declaring what lands in
                     ;; the nearest scope of one, through scopes of other kinds.
                     ~@group-fns

                     ;;; What a node that opens a scope declares in it, from the children in it: its
                     ;;; own names, then each group's that the scope's kind is in.
                     (defn scope-scan! [(n syn/Node)
                                        (t (mut sym/Table))
                                        (inner i64)] (-> void)
                       (let [k (.kind n)
                             count (len (.kids n))]
                         (when (own-first? k) (declare-first! n (mut t) inner))
                         (when (own-beneath? k)
                           (for i (range 0 count)
                             (when (inside? k i)
                               (declare-beneath! (get (.kids n) i)
                                                 (mut t)
                                                 inner))))
                         ~@group-scans
                         0))

                     ;;; Walk a node; the scope it opened, or -1.
                     (defn walk [(n syn/Node)
                                 (t (mut sym/Table))
                                 (scope i64)
                                 (b (mut (HashMap i64 i64)))] (-> i64)
                       (let [k (.kind n)]
                         (cond (ref? k)
                                 (do
                                   (when (dynamic-name? (.text n))
                                     (sym/mark-dynamic! (mut t) scope))
                                   (match (sym/resolve (mut t) scope (.text n))
                                     (Some [s]
                                           (sym/add-use! (mut t) s)
                                           (set! (mut b) (.lo n) s))
                                     (None [] (sym/add-free! (mut t) (.text n))))
                                   -1)
                               (bind? k)
                                 (do
                                   (match (sym/resolve (mut t) scope (.text n))
                                     (Some [s]
                                           (sym/add-use! (mut t) s)
                                           (set! (mut b) (.lo n) s))
                                     (None []
                                           (panic "binding {} was not declared by the scope tables"
                                                  (.text n))))
                                   -1)
                               (opens? k)
                                 (let [inner (sym/new-scope! (mut t) scope)]
                                   (when (dynamic? k)
                                     (sym/mark-dynamic! (mut t) inner))
                                   (when (dynamic-call? n)
                                     (sym/mark-dynamic! (mut t) scope))
                                   (scope-scan! n (mut t) inner)
                                   ;; A child outside the scope resolves in the scope around, and a
                                   ;; sequential child's scope holds the siblings after it, on its side.
                                   (let [(mut in) inner
                                         (mut out) scope]
                                     (for i (range 0 (len (.kids n)))
                                       (let [kid (get (.kids n) i)
                                             opened
                                               (walk kid
                                                     (mut t)
                                                     (if (inside? k i) in out)
                                                     (mut b))]
                                         (when (and (sequential? (.kind kid))
                                                    (>= opened 0))
                                           (if (inside? k i)
                                               (do (set! in opened) 0)
                                               (do (set! out opened) 0))))))
                                   inner)
                               :else
                                 (do
                                   (when (or (dynamic? k) (dynamic-call? n))
                                     (sym/mark-dynamic! (mut t) scope))
                                   (walk-all! n (mut t) scope (mut b))
                                   -1))))

                     ;;; Walk a node's children, or a program's parts, in turn from `scope`: a
                     ;;; sequential one's scope holds those after it. The scope the last are in.
                     (defn walk-all! [(n syn/Node)
                                      (t (mut sym/Table))
                                      (scope i64)
                                      (b (mut (HashMap i64 i64)))] (-> i64)
                       (let [(mut cur) scope]
                         (for (ref child) (.kids n)
                           (let [opened (walk child (mut t) cur (mut b))]
                             (when (and (sequential? (.kind child))
                                        (>= opened 0))
                               (set! cur opened))))
                         cur))

                     ;;; Analyse a whole program in its own new scope.
                     (defn analyze [(tree syn/Node)
                                    (t (mut sym/Table))
                                    (parent i64)
                                    (b (mut (HashMap i64 i64)))] (-> i64)
                       (let [root (sym/new-scope! (mut t) parent)]
                         (declare-program! tree (mut t) root)
                         ;; The program itself may open a scope: a `let` can be a whole program.
                         (walk tree (mut t) root (mut b))
                         root))

                     ;;; What `analyze` does before it walks: the program's own names, declared in `root`.
                     (defn declare-program! [(tree syn/Node)
                                             (t (mut sym/Table))
                                             (root i64)] (-> void)
                       ~@program-scans
                       0)

                     ;;; Under a scope, and with `outer` names, under one more that declares them: a
                     ;;; wrapper's parameters, say.
                     (defn outer-scope! [(t (mut sym/Table))
                                         (outer (ArrayList (slice u8)))]
                       (-> i64)
                       (let [top (sym/new-scope! (mut t) -1)]
                         (if (= (len outer) 0)
                             top
                             (let [w (sym/new-scope! (mut t) top)]
                               (for (ref name) outer
                                 (sym/declare! (mut t) w name))
                               w))))

                     (defn no-bindings [] (-> (HashMap i64 i64))
                       (HashMap::new [i64 i64] (rt/value-allocator) (i64-keyops)))

                     ;;; A whole program analysed in a table of its own. A big one is analysed
                     ;;; in parts (see `analysis-apart`), when a stage of the pipeline says so.
                     (defn analysis [(tree syn/Node)
                                     (outer (ArrayList (slice u8)))]
                       (-> sym/Analysis)
                       ~(if (< stage 0)
                            `(analysis-whole tree outer)
                            `(let [runs (apart-runs tree)]
                               (if (< (len runs) 2)
                                   (analysis-whole tree outer)
                                   (analysis-apart tree outer runs)))))

                     ;;; The runs of a program's parts that can be analysed apart: the items of
                     ;;; its last child, a list, about `part-bytes` of source to a run, with its
                     ;;; other children before the first. None when the stage works on one
                     ;;; thread, when the program's own node does anything a walk would see, or
                     ;;; when an item is sequential, its scope holding the items after it.
                     (defn apart-runs [(tree syn/Node)] (-> (ArrayList (ArrayList syn/Node)))
                       (let [(mut runs) (ArrayList::new [(ArrayList syn/Node)] (rt/tree-allocator))
                             k (.kind tree)
                             count (len (.kids tree))]
                         (when (and (not (rt/alone? ~(if (< stage 0) 0 stage)))
                                    (> count 0)
                                    (not (or (ref? k) (bind? k) (opens? k) (dynamic? k) (dynamic-call? tree))))
                           (let [body (get (.kids tree) (- count 1))
                                 bk (.kind body)
                                 ;; How much source the items span: a list made by a rewrite has
                                 ;; no place of its own, so by its items' places.
                                 (mut low) -1
                                 (mut high) 0
                                 _ (for (ref item) (.kids body)
                                     (when (or (< low 0) (< (.lo item) low)) (set! low (.lo item)))
                                     (when (> (.hi item) high) (set! high (.hi item))))
                                 (mut ok)
                                   (and (> (- high low) ~(* 2 part-bytes))
                                        (not (or (ref? bk) (bind? bk) (opens? bk) (dynamic? bk) (dynamic-call? body))))]
                             (when ok
                               (for (ref item) (.kids body)
                                 (when (sequential? (.kind item)) (set! ok false))))
                             (when ok
                               (let [(mut run) (ArrayList::new [syn/Node] (rt/tree-allocator))
                                     (mut from) -1]
                                 (for i (range 0 (- count 1)) (push! (mut run) (get (.kids tree) i)))
                                 (for (ref item) (.kids body)
                                   (when (< from 0) (set! from (.lo item)))
                                   (push! (mut run) item)
                                   (when (>= (- (.hi item) from) ~part-bytes)
                                     (push! (mut runs) run)
                                     (set! run (ArrayList::new [syn/Node] (rt/tree-allocator)))
                                     (set! from -1)))
                                 (when (> (len run) 0) (push! (mut runs) run))))))
                         runs))

                     (defstruct ApartJob
                       [(next i64)
                        (table sym/Table)
                        (root i64)
                        (runs (ArrayList (ArrayList syn/Node)))
                        (out (ArrayList (Option sym/Analysis)))])

                     (defn apart-body [(arg (ptr i8))] (-> (ptr i8))
                       (let [j (cast (ptr ApartJob) arg)
                             runs (.runs j)
                             (mut out) (.out j)
                             (mut go) true]
                         (while go
                           (let [i (atomic/add (cast (ptr i64) j) 1)]
                             (if (< i (len runs))
                                 (do
                                   (rt/item-begin! i)
                                   (set! (mut out) i (Some (part-analysis (.table j) (.root j) (get runs i)))))
                                 (set! go false))))
                         arg))

                     ;;; A program analysed in parts: its own names declared first, each run of
                     ;;; parts walked in a table of its own under them, on the stage's threads,
                     ;;; and the tables grafted back in order. The table, the root and every
                     ;;; binding are what one walk of the whole would have made, ids and all.
                     (defn analysis-apart [(tree syn/Node)
                                           (outer (ArrayList (slice u8)))
                                           (runs (ArrayList (ArrayList syn/Node)))]
                       (-> sym/Analysis)
                       (let [d (declarations tree outer)
                             (mut out) (ArrayList::new [(Option sym/Analysis)] (rt/value-allocator))]
                         (for _ runs (push! (mut out) (None [sym/Analysis])))
                         (let [(mut job) (ApartJob :next 0 :table (.table d) :root (.root d) :runs runs :out out)]
                           (rt/run-map-workers (fnptr-of apart-body)
                                               (cast (ptr i8) (mut job))
                                               (rt/stage-threads ~(if (< stage 0) 0 stage)))
                           (let [(mut tables) (ArrayList::new [sym/Table] (rt/tree-allocator))
                                 (mut b) (no-bindings)
                                 (mut shift) (sym/symbol-count (.table d))]
                             (for o (.out job)
                               (match o
                                 (Some [a]
                                       (let [(mut own) (.bindings a)]
                                         ;; A part's symbols move by how many the table holds
                                         ;; before it is grafted; one of the table it was made
                                         ;; under is -(id + 1).
                                         (for at own
                                           (match (get own at)
                                             (Some [v]
                                                   (set! (mut b) at (if (< v 0) (- -1 v) (+ v shift))))
                                             (None [] 0))))
                                       (set! shift (+ shift (sym/symbol-count (.table a))))
                                       (push! (mut tables) (.table a)))
                                 (None [] (panic "a part of a program's analysis left no answer"))))
                             (let [table (sym/grafted (.table d) tables (.root d))]
                               (sym/Analysis
                                 :table table
                                 :root (.root d)
                                 :bindings b
                                 :free (sym/free-names table)))))))

                     (defn analysis-whole [(tree syn/Node)
                                           (outer (ArrayList (slice u8)))]
                       (-> sym/Analysis)
                       (let [(mut t) (sym/table-new)
                             scope (outer-scope! (mut t) outer)
                             (mut b) (no-bindings)
                             root (analyze tree (mut t) scope (mut b))]
                         (sym/Analysis
                           :table t
                           :root root
                           :bindings b
                           :free (sym/free-names t))))

                     ;;; Only the program's own names, declared in its root scope before any of it is walked.
                     (defn declarations [(tree syn/Node)
                                         (outer (ArrayList (slice u8)))]
                       (-> sym/Analysis)
                       (let [(mut t) (sym/table-new)
                             root
                               (sym/new-scope! (mut t)
                                               (outer-scope! (mut t) outer))]
                         (declare-program! tree (mut t) root)
                         (sym/Analysis
                           :table t
                           :root root
                           :bindings (no-bindings)
                           :free
                             (ArrayList::new [(slice u8)] (rt/value-allocator)))))

                     ;;; Parts of a program walked in turn in a table of their own under `scope` of `t`
                     ;;; (`table-under`), whose scope 0 stands for the program's, at once with others
                     ;;; walked the same way; `grafted` puts the tables back in order. A sequential
                     ;;; part's scope holds the parts after it, so those must be in the same call:
                     ;;; `sequential?` says which parts are.
                     (defn part-analysis [(t sym/Table)
                                          (scope i64)
                                          (parts (ArrayList syn/Node))]
                       (-> sym/Analysis)
                       (let [(mut own) (sym/table-under t scope)
                             (mut b) (no-bindings)
                             (mut cur) 0]
                         (for (ref part) parts
                           (let [opened (walk part (mut own) cur (mut b))]
                             (when (and (sequential? (.kind part))
                                        (>= opened 0))
                               (set! cur opened))))
                         (sym/Analysis
                           :table own
                           :root 0
                           :bindings b
                           :free
                             (ArrayList::new [(slice u8)] (rt/value-allocator))))))))))

(defn read-scopes [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
