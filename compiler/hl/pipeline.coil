;;; `.pipeline`: how a build divides its work, said once, and checked. A pipeline names its stages,
;;; whether each works per file, per part or on the whole program, and the functions that do it.
;;; Plans then choose, stage by stage, serial or parallel, on how many threads, in how many parts.
;;;
;;;   pipeline app.pipelines
;;;   stage load     per file bundle.modules/visit-file bundle.modules/next-files
;;;   stage optimize per group bundle.api/group-optimized
;;;   stage link     whole    bundle.analysis/link
;;;
;;;   plan quick
;;;     threads auto
;;;     load parallel
;;;     optimize parallel 4
;;;   end
;;;
;;; The rules that do the work say nothing of threads. Where they make a list of one of a `per`
;;; stage's functions' answers, the rules compiler has the list made on as many threads as the run's
;;; plan gives the stage (see "a stage's work" there, and `rt/stage-threads`).
;;;
;;; A plan may run a stage in parallel only if every function the stage names, and everything
;;; they call, writes no state shared between threads. That is decided here, from the `.rules`
;;; sources: an assignment to a `state` (not a `task state`, which each thread has its own of),
;;; an `assert` into a relation held in one, or a `mut` argument that is one. A call of a
;;; function value is a call of any function the program names as a value (a program is all its
;;; manifest names), so a hook a caller hands in is checked like the rest. A grammar or a rewrite is pure by
;;; construction; a `.facts` or `.scopes` call may change what it is given. A plan that breaks
;;; this does not compile, and the error says what was written, and where.
;;;
;;; The output is `use-plan!(name)`, which gives each stage the threads that plan says,
;;; `use-threads!(n)`, which gives n to every stage that could be shown to share no state (and one
;;; to any other), and `plan-names()`.
(module hl.pipeline)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.meta" :as meta)
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.grammars.pipeline" :as g)
(import "hl.grammars.rules" :as gr)
(import "coil.cc" :as cc)

(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(reader-provider "hl.pipeline" read-pipeline)

(defn texts [] (-> (ArrayList (slice u8)))
  (ArrayList::new [(slice u8)] (rt/value-allocator)))

(defn has? [(xs (ArrayList (slice u8))) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x xs (when (= x s) (set! hit true)))
    hit))

(defn add-unique! [(xs (mut (ArrayList (slice u8)))) (s (slice u8))] (-> void)
  (unless (has? xs s) (push! (mut xs) s)))

;; ---------------------------------------------------------------- what a module declares

(defsum Kind (KindRules) (KindPure) (KindMutating) (KindForeign))

(derive Eq Kind)

(defstruct Fun
  [(name (slice u8))
   (body gr/Node)
   (params (ArrayList (slice u8)))
   (muts (ArrayList bool))])

(defstruct Info
  [(name (slice u8))
   (kind Kind)
   (shared (ArrayList (slice u8)))
   (task (ArrayList (slice u8)))
   (consts (ArrayList (slice u8)))
   (alias-names (ArrayList (slice u8)))
   (alias-modules (ArrayList (slice u8)))
   (funs (ArrayList Fun))
   ;; States whose type is a module's record, and the alias of that module: a database's queries
   ;; read it.
   (typed-names (ArrayList (slice u8)))
   (typed-aliases (ArrayList (slice u8)))
   (facts bool)
   ;; Its settings: what a function reads of them is what binding one again may change.
   (settings (ArrayList (slice u8)))])

(defn info-new [(name (slice u8)) (kind Kind)] (-> Info)
  (Info
    :name name
    :kind kind
    :shared (texts)
    :task (texts)
    :consts (texts)
    :alias-names (texts)
    :alias-modules (texts)
    :funs (ArrayList::new [Fun] (rt/value-allocator))
    :typed-names (texts)
    :typed-aliases (texts)
    :facts false
    :settings (texts)))

;;; A state declared with a type `alias.Record`: remember which module it comes from.
(defn note-typed! [(info (mut Info)) (d gr/Node)] (-> void)
  (let [ty (kid d 1)]
    (when (= (.kind ty) (gr/KTQual))
      (push! (mut (.typed-names info)) (.text (kid d 0)))
      (push! (mut (.typed-aliases info)) (.text (kid ty 0))))
    0))

(defn kid [(n gr/Node) (i i64)] (-> gr/Node)
  (get (.kids n) i))

(defn params-of [(list gr/Node)] (-> Fun)
  (let [(mut names) (texts)
        (mut muts) (ArrayList::new [bool] (rt/value-allocator))]
    (for p (.kids list)
      (push! (mut names) (.text (kid p 0)))
      (push! (mut muts) (= (.kind (kid p 1)) (gr/KTMut))))
    (Fun
      :name ""
      :body list
      :params names
      :muts muts)))

(defn alias-of [(info Info) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for i (range 0 (len (.alias-names info)))
      (when (= (get (.alias-names info) i) name)
        (set! out (Some (get (.alias-modules info) i)))))
    out))

(defn fun-of [(info Info) (name (slice u8))] (-> (Option Fun))
  (let [(mut out) (None [Fun])]
    (for f (.funs info) (when (= (.name f) name) (set! out (Some f))))
    out))

(defn parse-rules [(src (slice u8)) (path (slice u8))] (-> gr/Node)
  (match (gr/parse-result src path 0)
    (Ok [t] t)
    (Err [e]
         (dsl/fail-at path (.line e) (.col e) (dsl/join2 "expected " (.want e))))))

(defn prelude-text [] (-> (slice u8))
  (include-str "../../src/languages/rules_prelude.rules"))

;;; The foreign modules every `.rules` file can call: `rt.f` and bare `f` are hl.rt, `sym.f` is
;;; hl.symtab. What they change is what their `mut` parameters say.
(defn foreign-infos [] (-> (ArrayList Info))
  (let [tree (parse-rules (prelude-text) "rules_prelude.rules")
        (mut out) (ArrayList::new [Info] (rt/value-allocator))]
    (for d (.kids (kid tree 2))
      (when (= (.kind d) (gr/KForeign))
        (let [(mut info) (info-new (.text (kid d 0)) (KindForeign))]
          (for item (.kids (kid d 2))
            (when (= (.kind item) (gr/KFFn))
              (let [ps (params-of (kid item 2))]
                (push! (mut (.funs info))
                       (Fun
                         :name (.text (kid item 0))
                         :body item
                         :params (.params ps)
                         :muts (.muts ps))))))
          (push! (mut out) info))))
    out))

(defn rules-info [(name (slice u8)) (src (slice u8)) (path (slice u8))]
  (-> Info)
  (let [tree (parse-rules src path)
        (mut info) (info-new name (KindRules))]
    (push! (mut (.alias-names info)) "rt")
    (push! (mut (.alias-modules info)) "hl.rt")
    (push! (mut (.alias-names info)) "sym")
    (push! (mut (.alias-modules info)) "hl.symtab")
    (for d (.kids (kid tree 2))
      (match (.kind d)
        (gr/KUse []
                 (push! (mut (.alias-names info)) (.text (kid d 1)))
                 (push! (mut (.alias-modules info)) (.text (kid d 0))))
        (gr/KState []
                   (do
                     (push! (mut (.shared info)) (.text (kid d 0)))
                     (note-typed! (mut info) d)))
        (gr/KTaskState []
                       (do
                         (push! (mut (.task info)) (.text (kid d 0)))
                         (note-typed! (mut info) d)))
        ;; A setting is given by `with`, and only read: a database in one is queried.
        (gr/KSetting []
                     (do
                       (push! (mut (.settings info)) (.text (kid d 0)))
                       (note-typed! (mut info) d)))
        (gr/KContext [] (push! (mut (.task info)) (.text (kid d 0))))
        ;; An attribute grammar's attributes live in its task state, one copy to a worker.
        (gr/KInh [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KGiven [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KInput [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KCollect [] (push! (mut (.task info)) (.text (kid d 0))))
        (gr/KConst [] (push! (mut (.consts info)) (.text (kid d 0))))
        (gr/KSized [] (push! (mut (.consts info)) (.text (kid d 0))))
        ;; A memo's caching is invisible: what it does is what its body does.
        (gr/KMemoFn []
                    (let [ps (params-of (kid d 1))]
                      (push! (mut (.funs info))
                             (Fun
                               :name (.text (kid d 0))
                               :body (kid d 3)
                               :params (.params ps)
                               :muts (.muts ps)))))
        ;; An everywhere function's walk into the children only calls itself.
        (gr/KEverywhereFn []
                          (let [ps (params-of (kid d 1))]
                            (push! (mut (.funs info))
                                   (Fun
                                     :name (.text (kid d 0))
                                     :body (kid d 3)
                                     :params (.params ps)
                                     :muts (.muts ps)))))
        (gr/KFn []
                (let [ps (params-of (kid d 1))]
                  (push! (mut (.funs info))
                         (Fun
                           :name (.text (kid d 0))
                           :body (kid d 3)
                           :params (.params ps)
                           :muts (.muts ps)))))
        (_ 0)))
    ;; Its `run` does what its `on` blocks and rewrites do.
    (when (= (.kind tree) (gr/KAttrsFile))
      (let [(mut rules) (gr/new-kids)]
        (for d (.kids (kid tree 2))
          (when (or (= (.kind d) (gr/KOn)) (= (.kind d) (gr/KRewrite)))
            (push! (mut rules) d)))
        (push! (mut (.funs info))
               (Fun
                 :name "run"
                 :body (gr/mk (gr/KList) rules 0 0)
                 :params (texts)
                 :muts (ArrayList::new [bool] (rt/value-allocator))))))
    info))

;; ---------------------------------------------------------------- effects

;;; A write to shared state: which, and the function that does it.
(defstruct Write [(what (slice u8)) (where (slice u8))])

(defstruct Effect
  [(writes (ArrayList Write))
   (muts (ArrayList i64))  ; parameters of this function it changes
   (hooks (ArrayList (slice u8)))  ; function values it calls
   ;; Settings it reads, as `module.name`, through anything it calls. A function value adds none: a
   ;; function a build is given is a function of its arguments.
   (reads (ArrayList (slice u8)))
   ;; Functions a stage makes that it asks for, which it only reads (see `makes`).
   (made (ArrayList (slice u8)))])

(defn effect-new [] (-> Effect)
  (Effect
    :writes (ArrayList::new [Write] (rt/value-allocator))
    :muts (ArrayList::new [i64] (rt/value-allocator))
    :hooks (texts)
    :reads (texts)
    :made (texts)))

;;; A function named as a value somewhere in the program: where a function value is called, it
;;; may be this one.
(defstruct Value [(module (slice u8)) (name (slice u8)) (arity i64)])

(defstruct Checker
  [(entries (ArrayList dsl/Entry))
   (infos (ArrayList Info))
   (memo-keys (ArrayList (slice u8)))
   (memo (ArrayList Effect))
   (visiting (ArrayList (slice u8)))
   (depends (ArrayList (slice u8)))
   ;; Functions some stage makes: asked for by another stage, each is only read. What a stage makes
   ;; is kept, as if the pipeline said so: the stages after it read what it made.
   (made (ArrayList (slice u8)))
   ;; Every function the program names as a value (see `values-of`), once it has looked.
   (values (ArrayList Value))
   (values-known bool)])

(defn checker-new [(entries (ArrayList dsl/Entry))] (-> Checker)
  (Checker
    :entries entries
    :infos (ArrayList::new [Info] (rt/value-allocator))
    :memo-keys (texts)
    :memo (ArrayList::new [Effect] (rt/value-allocator))
    :visiting (texts)
    :depends (texts)
    :made (texts)
    :values (ArrayList::new [Value] (rt/value-allocator))
    :values-known false))

;;; The settings `module/name` reads, through everything it calls.
(defn reads-of [(c (mut Checker)) (module (slice u8)) (name (slice u8))]
  (-> (ArrayList (slice u8)))
  (.reads (fun-effect (mut c) module name)))

;;; The files read to know it.
(defn checker-depends [(c (mut Checker))] (-> (ArrayList (slice u8)))
  (.depends c))

(defn info-index [(c (mut Checker)) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.infos c)))
      (when (= (.name (get (.infos c) i)) name) (set! at i)))
    at))

(defn file-of [(c (mut Checker)) (name (slice u8))] (-> (Option (slice u8)))
  (dsl/module-file (.entries c) name))

(defn info-of [(c (mut Checker)) (name (slice u8))] (-> Info)
  (let [at (info-index (mut c) name)]
    (if (>= at 0)
        (get (.infos c) at)
        (let [info
                (match (file-of (mut c) name)
                  (None [] (info-new name (KindPure)))
                  (Some [path]
                        (add-unique! (mut (.depends c)) path)
                        (cond (or (rt/ends-with path ".rules")
                                  (rt/ends-with path ".attrs"))
                                (rules-info name (rt/read-all path) path)
                              (rt/ends-with path ".facts")
                                (let [(mut i) (info-new name (KindMutating))]
                                  (set! (.facts i) true)
                                  i)
                              (rt/ends-with path ".scopes")
                                (info-new name (KindMutating))
                              :else (info-new name (KindPure)))))]
          (push! (mut (.infos c)) info)
          info))))

(defn add-write! [(e (mut Effect)) (what (slice u8)) (where (slice u8))]
  (-> void)
  (let [(mut seen) false]
    (for w (.writes e) (when (= (.what w) what) (set! seen true)))
    (unless seen (push! (mut (.writes e)) (Write :what what :where where)))))

;;; What an expression is a part of, for a write to it.
(defsum Root
  (RNone)
  (RParam [(i i64)])
  (RState [(what (slice u8)) (shared bool)]))

(defn param-index [(f Fun) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.params f)))
      (when (= (get (.params f) i) name) (set! at i)))
    at))

(defn state-root [(info Info) (name (slice u8))] (-> Root)
  (cond (has? (.shared info) name)
          (RState (dsl/join3 (.name info) "." name) true)
        (has? (.task info) name)
          (RState (dsl/join3 (.name info) "." name) false)
        :else (RNone)))

(defn root-of [(c (mut Checker))
               (info Info)
               (f Fun)
               (locals (ArrayList (slice u8)))
               (e gr/Node)] (-> Root)
  (match (.kind e)
    (gr/KName []
              (let [n (.text e)
                    p (param-index f n)]
                (cond (>= p 0) (RParam p)
                      (has? locals n) (RNone)
                      :else (state-root info n))))
    (gr/KFieldE []
                (let [base (kid e 0)]
                  (match (if (= (.kind base) (gr/KName))
                             (alias-of info (.text base))
                             (None [(slice u8)]))
                    (Some [module]
                          (if (or (has? locals (.text base))
                                  (>= (param-index f (.text base)) 0))
                              (root-of (mut c) info f locals base)
                              (state-root (info-of (mut c) module)
                                          (.text (kid e 1)))))
                    (None [] (root-of (mut c) info f locals base)))))
    (gr/KIndex [] (root-of (mut c) info f locals (kid e 0)))
    (gr/KSlice [] (root-of (mut c) info f locals (kid e 0)))
    (gr/KGroup [] (root-of (mut c) info f locals (kid e 0)))
    (_ (RNone))))

(defn write-root! [(out (mut Effect)) (f Fun) (r Root) (where (slice u8))]
  (-> void)
  (match r
    (RState [what shared] (when shared (add-write! (mut out) what where)))
    (RParam [i] (when (get (.muts f) i) (push! (mut (.muts out)) i)))
    (RNone [] 0)))

(defn arg-expr [(a gr/Node)] (-> gr/Node)
  (if (= (.kind a) (gr/KNamed)) (kid a 1) a))

;;; A callee's effects, as they land on this call's arguments.
(defn merge-call! [(c (mut Checker))
                   (info Info)
                   (f Fun)
                   (locals (ArrayList (slice u8)))
                   (out (mut Effect))
                   (callee Effect)
                   (args (ArrayList gr/Node))
                   (where (slice u8))] (-> void)
  (for w (.writes callee) (add-write! (mut out) (.what w) (.where w)))
  (for h (.hooks callee) (add-unique! (mut (.hooks out)) h))
  (for r (.reads callee) (add-unique! (mut (.reads out)) r))
  (for x (.made callee) (add-unique! (mut (.made out)) x))
  (for i (.muts callee)
    (when (< i (len args))
      (write-root! (mut out)
                   f
                   (root-of (mut c) info f locals (arg-expr (get args i)))
                   where))))

(defn foreign-mut-writes! [(c (mut Checker))
                           (info Info)
                           (f Fun)
                           (locals (ArrayList (slice u8)))
                           (out (mut Effect))
                           (target Fun)
                           (args (ArrayList gr/Node))
                           (where (slice u8))] (-> void)
  (for i (range 0 (len args))
    (when (and (< i (len (.muts target))) (get (.muts target) i))
      (write-root! (mut out)
                   f
                   (root-of (mut c) info f locals (arg-expr (get args i)))
                   where))))

(defn foreign-fun [(c (mut Checker)) (module (slice u8)) (name (slice u8))]
  (-> (Option Fun))
  (let [(mut out) (None [Fun])]
    (for info (foreign-infos)
      (when (= (.name info) module)
        (set! out (fun-of info name))))
    out))

;;; A program is all its manifest names, so a function value is one of the functions some module
;;; names as a value: other than as what a call calls. Every such function of the program's
;;; `.rules` and `.attrs` modules, found once. (A grammar's or a rewrite's function is pure by
;;; construction, and a foreign one changes only what it is handed, which the call that hands it
;;; says.) A name a function binds for itself that is also a function's counts too: more than
;;; can be called, never less.
(defn values-of [(c (mut Checker))] (-> (ArrayList Value))
  (unless (.values-known c)
    (set! (.values-known c) true)
    (let [(mut found) (ArrayList::new [Value] (rt/value-allocator))]
      (for e (.entries c)
        (when (or (rt/ends-with (.file e) ".rules") (rt/ends-with (.file e) ".attrs"))
          (let [info (info-of (mut c) (.name e))]
            (for f (.funs info) (values! (mut c) info f (.body f) (mut found))))))
      (set! (.values c) found)))
  (.values c))

(defn value-add! [(out (mut (ArrayList Value))) (module (slice u8)) (g Fun)] (-> void)
  (let [(mut seen) false]
    (for v out (when (and (= (.module v) module) (= (.name v) (.name g))) (set! seen true)))
    (unless seen
      (push! (mut out) (Value :module module :name (.name g) :arity (len (.params g)))))))

(defn values! [(c (mut Checker)) (info Info) (f Fun) (n gr/Node) (out (mut (ArrayList Value)))]
  (-> void)
  (match (.kind n)
    (gr/KCall []
              (let [callee (kid n 0)]
                ;; What is called is not a value; what it is a field of may hold one.
                (when (and (= (.kind callee) (gr/KFieldE))
                           (match (callee-of info f callee) (Some [_] false) (None [] true)))
                  (values! (mut c) info f (kid callee 0) (mut out)))
                (unless (or (= (.kind callee) (gr/KName)) (= (.kind callee) (gr/KFieldE)))
                  (values! (mut c) info f callee (mut out)))
                (for i (range 1 (len (.kids n)))
                  (values! (mut c) info f (kid n i) (mut out)))))
    (gr/KName []
              (when (< (param-index f (.text n)) 0)
                (match (fun-of info (.text n))
                  (Some [g] (value-add! (mut out) (.name info) g))
                  (None [] 0))))
    (gr/KFieldE []
                (match (if (and (= (.kind (kid n 0)) (gr/KName))
                                (< (param-index f (.text (kid n 0))) 0))
                           (alias-of info (.text (kid n 0)))
                           (None [(slice u8)]))
                  (Some [m]
                        (let [target (info-of (mut c) m)]
                          (match (fun-of target (.text (kid n 1)))
                            (Some [g]
                                  (when (= (.kind target) (KindRules))
                                    (value-add! (mut out) m g)))
                            (None [] 0))))
                  (None [] (values! (mut c) info f (kid n 0) (mut out)))))
    (_ (for i (range 0 (len (.kids n)))
         (unless (label? n i) (values! (mut c) info f (kid n i) (mut out))))))
  0)

;;; A call of a function value: of any function the program names as a value that takes as many
;;; arguments, with what each of those does.
(defn value-call! [(c (mut Checker))
                   (info Info)
                   (f Fun)
                   (locals (ArrayList (slice u8)))
                   (out (mut Effect))
                   (args (ArrayList gr/Node))
                   (where (slice u8))] (-> void)
  ;; What it may write, not what it reads: a function a build is given is a function of its
  ;; arguments (see `Effect`), and a kept answer is made from what its own code reads.
  (for v (values-of (mut c))
    (when (= (.arity v) (len args))
      (let [callee (fun-effect (mut c) (.module v) (.name v))]
        (for w (.writes callee) (add-write! (mut out) (.what w) (.where w)))
        (for h (.hooks callee) (add-unique! (mut (.hooks out)) h))
        (for i (.muts callee)
          (when (< i (len args))
            (write-root! (mut out)
                         f
                         (root-of (mut c) info f locals (arg-expr (get args i)))
                         where))))))
  0)

(defn call! [(c (mut Checker))
             (info Info)
             (f Fun)
             (locals (ArrayList (slice u8)))
             (out (mut Effect))
             (n gr/Node)] (-> void)
  (let [callee (kid n 0)
        args (.kids (kid n 1))
        where (dsl/join3 (.name info) "/" (.name f))]
    ;; A function named as a value may be called.
    (for a args
      (let [e (arg-expr a)]
        (when (and (= (.kind e) (gr/KName))
                   (not (has? locals (.text e)))
                   (< (param-index f (.text e)) 0))
          (match (fun-of info (.text e))
            (Some [_]
                  (merge-call! (mut c)
                               info
                               f
                               locals
                               (mut out)
                               (fun-effect (mut c) (.name info) (.text e))
                               args
                               where))
            (None [] 0)))))
    (match (.kind callee)
      (gr/KName []
                (let [name (.text callee)]
                  (cond (or (has? locals name)
                            (>= (param-index f name) 0)
                            (has? (.shared info) name)
                            (has? (.task info) name))
                          (value-call! (mut c) info f locals (mut out) args where)
                        (= name "forget-memos!")
                          (add-write! (mut out)
                                      (dsl/join2 (.name info) ".memos")
                                      where)
                        (or (= name "clear") (= name "pop"))
                          (when (> (len args) 0)
                            (write-root! (mut out)
                                         f
                                         (root-of (mut c)
                                                  info
                                                  f
                                                  locals
                                                  (arg-expr (get args 0)))
                                         where))
                        :else
                          (match (fun-of info name)
                            (Some [_]
                                  (merge-call! (mut c)
                                               info
                                               f
                                               locals
                                               (mut out)
                                               (fun-effect (mut c)
                                                           (.name info)
                                                           name)
                                               args
                                               where))
                            (None []
                                  (match (foreign-fun (mut c) "hl.rt" name)
                                    (Some [t]
                                          (foreign-mut-writes! (mut c)
                                                               info
                                                               f
                                                               locals
                                                               (mut out)
                                                               t
                                                               args
                                                               where))
                                    (None [] 0)))))))
      (gr/KFieldE []
                  (if (database-query? (mut c) info f locals (kid callee 0))
                      0
                      (let [base (kid callee 0)
                            fname (.text (kid callee 1))
                            module
                              (if (and (= (.kind base) (gr/KName))
                                       (not (has? locals (.text base)))
                                       (< (param-index f (.text base)) 0))
                                  (alias-of info (.text base))
                                  (None [(slice u8)]))]
                        (match module
                          (Some [m]
                                (let [target (info-of (mut c) m)]
                                  (match (.kind target)
                                    (KindRules []
                                               (merge-call! (mut c)
                                                            info
                                                            f
                                                            locals
                                                            (mut out)
                                                            (fun-effect (mut c)
                                                                        m
                                                                        fname)
                                                            args
                                                            where))
                                    (KindPure [] 0)
                                    (KindMutating []
                                                  (for a args
                                                    (write-root! (mut out)
                                                                 f
                                                                 (root-of (mut c)
                                                                          info
                                                                          f
                                                                          locals
                                                                          (arg-expr a))
                                                                 where)))
                                    (KindForeign []
                                                 (match (foreign-fun (mut c)
                                                                     m
                                                                     fname)
                                                   (Some [t]
                                                         (foreign-mut-writes! (mut c)
                                                                              info
                                                                              f
                                                                              locals
                                                                              (mut out)
                                                                              t
                                                                              args
                                                                              where))
                                                   (None [] 0))))))
                          (None [] (value-call! (mut c) info f locals (mut out) args where))))))
      ;; `module.Record(…)` builds a value.
      (gr/KMember [] 0)
      (_ (value-call! (mut c) info f locals (mut out) args where)))))

;;; `db.relation(…)` or `m.db.relation(…)`, where `db` is a state or a setting whose type a `.facts`
;;; module defines: a query, which reads. (`assert` is the write, and `link.solve!(db)` another.)
(defn database-query? [(c (mut Checker))
                       (info Info)
                       (f Fun)
                       (locals (ArrayList (slice u8)))
                       (base gr/Node)] (-> bool)
  (let [own
          (and (= (.kind base) (gr/KName))
               (not (has? locals (.text base)))
               (< (param-index f (.text base)) 0))
        other
          (and (= (.kind base) (gr/KFieldE))
               (= (.kind (kid base 0)) (gr/KName))
               (not (has? locals (.text (kid base 0))))
               (< (param-index f (.text (kid base 0))) 0))]
    (cond own (facts-typed? (mut c) info (.text base))
          other
            (match (alias-of info (.text (kid base 0)))
              (Some [m]
                    (let [holder (info-of (mut c) m)]
                      (facts-typed? (mut c) holder (.text (kid base 1)))))
              (None [] false))
          :else false)))

(defn facts-typed? [(c (mut Checker)) (info Info) (state (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for i (range 0 (len (.typed-names info)))
      (when (= (get (.typed-names info) i) state)
        (match (alias-of info (get (.typed-aliases info) i))
          (Some [m] (when (.facts (info-of (mut c) m)) (set! hit true)))
          (None [] 0))))
    hit))

(defn walk! [(c (mut Checker))
             (info Info)
             (f Fun)
             (locals (ArrayList (slice u8)))
             (out (mut Effect))
             (n gr/Node)] (-> void)
  (let [where (dsl/join3 (.name info) "/" (.name f))]
    (match (.kind n)
      (gr/KAssign []
                  (write-root! (mut out)
                               f
                               (root-of (mut c) info f locals (kid n 0))
                               where))
      (gr/KAppend []
                  (write-root! (mut out)
                               f
                               (root-of (mut c) info f locals (kid n 0))
                               where))
      (gr/KExtend []
                  (write-root! (mut out)
                               f
                               (root-of (mut c) info f locals (kid n 0))
                               where))
      (gr/KAssert []
                  (let [e (kid n 0)]
                    (when (and (= (.kind e) (gr/KCall))
                               (= (.kind (kid e 0)) (gr/KFieldE)))
                      (write-root! (mut out)
                                   f
                                   (root-of (mut c)
                                            info
                                            f
                                            locals
                                            (kid (kid e 0) 0))
                                   where))))
      (gr/KCall [] (call! (mut c) info f locals (mut out) n))
      ;; A setting read: one of its own, or `alias.name` of another module's.
      (gr/KName []
                (let [name (.text n)]
                  (when (and (not (has? locals name))
                             (< (param-index f name) 0)
                             (has? (.settings info) name))
                    (do
                      (unless (= (primitive/cast i64 (getenv c"HL_SHOW_READS"))
                                 0)
                        (println "[direct] {}: {}.{}" where (.name info) name))
                      (add-unique! (mut (.reads out))
                                   (dsl/join3 (.name info) "." name))))))
      (gr/KFieldE []
                  (let [base (kid n 0)]
                    (when (and (= (.kind base) (gr/KName))
                               (not (has? locals (.text base)))
                               (< (param-index f (.text base)) 0))
                      (match (alias-of info (.text base))
                        (Some [module]
                              (when (has? (.settings (info-of (mut c) module))
                                          (.text (kid n 1)))
                                (do
                                  (unless (= (primitive/cast i64
                                                             (getenv c"HL_SHOW_READS"))
                                             0)
                                    (println "[direct] {}: {}.{}"
                                             where
                                             module
                                             (.text (kid n 1))))
                                  (add-unique! (mut (.reads out))
                                               (dsl/join3 module
                                                          "."
                                                          (.text (kid n 1)))))))
                        (None [] 0)))))
      (_ 0))
    (for i (range 0 (len (.kids n)))
      (unless (label? n i)
        (walk! (mut c) info f locals (mut out) (kid n i))))))

;;; Whether a node's child names something rather than reads it: the field after `.`, a record
;;; field's label, a named argument's name, the setting a `with` binds. A name there is no read,
;;; whatever it is called.
(defn label? [(n gr/Node) (i i64)] (-> bool)
  (match (.kind n)
    (gr/KFieldE [] (= i 1))
    (gr/KFieldInit [] (= i 0))
    (gr/KNamed [] (= i 0))
    (gr/KWithBind [] (= i 0))
    (_ false)))

;;; Names a function binds for itself: these are not the module's state, whatever they are called.
(defn locals! [(n gr/Node) (out (mut (ArrayList (slice u8)))) (in-pattern bool)]
  (-> void)
  (match (.kind n)
    (gr/KLet [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KVar [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KRangeHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KInHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KFromHead [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KSort [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KFold [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KScan [] (add-unique! (mut out) (.text (kid n 0))))
    (gr/KPAs [] (add-unique! (mut out) (.text (kid n 1))))
    (gr/KQvar [] (add-unique! (mut out) (subslice (.text n) 1 (len (.text n)))))
    (gr/KName [] (when in-pattern (add-unique! (mut out) (.text n))))
    (_ 0))
  (match (.kind n)
    (gr/KArm []
             (do
               (locals! (kid n 0) (mut out) true)
               (for i (range 1 (len (.kids n)))
                 (locals! (kid n i) (mut out) in-pattern))))
    (gr/KArmN []
              (do
                (locals! (kid n 0) (mut out) true)
                (locals! (kid n 1) (mut out) true)
                (for i (range 2 (len (.kids n)))
                  (locals! (kid n i) (mut out) in-pattern))))
    ;; `field: pattern`: the field's name is the record's, not a binding.
    (gr/KPField [] (locals! (kid n 1) (mut out) in-pattern))
    (gr/KWhereE []
                (do
                  (for i (.kids (kid n 1))
                    (add-unique! (mut out) (.text (kid i 0))))
                  (for c (.kids n) (locals! c (mut out) in-pattern))))
    (gr/KIfLet []
               (do
                 (locals! (kid n 0) (mut out) true)
                 (for i (range 1 (len (.kids n)))
                   (locals! (kid n i) (mut out) in-pattern))))
    (gr/KIsE []
             (do
               (locals! (kid n 0) (mut out) in-pattern)
               (locals! (kid n 1) (mut out) true)))
    (gr/KPatHead []
                 (do
                   (locals! (kid n 0) (mut out) true)
                   (locals! (kid n 1) (mut out) in-pattern)))
    (gr/KLetClause []
                   (do
                     (locals! (kid n 0) (mut out) true)
                     (locals! (kid n 1) (mut out) in-pattern)))
    ;; `cm.Scan(…)`: the first name is a module, not a binding.
    (gr/KPNodeQ []
                (for i (range 1 (len (.kids n)))
                  (locals! (kid n i) (mut out) in-pattern)))
    (gr/KPEnumQ [] 0)
    (_ (for k (.kids n) (locals! k (mut out) in-pattern)))))

(defn memo-index [(c (mut Checker)) (key (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.memo-keys c)))
      (when (= (get (.memo-keys c) i) key) (set! at i)))
    at))

;;; What a function, and all it calls, writes. A call back into a function still being worked out
;;; adds nothing: its effects are being gathered already.
(defn fun-effect [(c (mut Checker)) (module (slice u8)) (name (slice u8))]
  (-> Effect)
  (let [key (dsl/join3 module "/" name)
        at (memo-index (mut c) key)]
    (cond (>= at 0) (get (.memo c) at)
          (has? (.visiting c) key) (effect-new)
          :else
            (let [info (info-of (mut c) module)
                  (mut out) (effect-new)]
              (push! (mut (.visiting c)) key)
              (if (= name "forget-memos!")
                  (add-write! (mut out) (dsl/join2 module ".memos") key)
                  (match (fun-of info name)
                    (Some [f]
                          (let [(mut locals) (texts)]
                            (locals! (.body f) (mut locals) false)
                            (walk! (mut c) info f locals (mut out) (.body f))))
                    (None []
                          (push! (mut (.hooks out))
                                 (dsl/join2 "no function named " key)))))
              (push! (mut (.memo-keys c)) key)
              (push! (mut (.memo c)) out)
              ;; What a stage makes is only read by the stages after it: of it, they see what it
              ;; reads, and that they ask for it.
              (if (has? (.made c) key)
                  (let [(mut seen) (effect-new)]
                    (for r (.reads out) (push! (mut (.reads seen)) r))
                    (push! (mut (.made seen)) key)
                    seen)
                  out)))))

;; ---------------------------------------------------------------- what a function reads of its arguments

;;; What a function reads of one of its parameters: its fields, each `.name`, through everything it
;;; passes the value to; or the whole value, where it keeps it, gives it back, or passes it where
;;; nothing says what is read of it.
(defstruct Paths [(whole bool) (fields (ArrayList (slice u8)))])

(defn paths-new [] (-> Paths)
  (Paths :whole false :fields (texts)))

(defn paths-whole [] (-> Paths)
  (Paths :whole true :fields (texts)))

(defn paths-same? [(a Paths) (b Paths)] (-> bool)
  (and (= (.whole a) (.whole b))
       (= (len (.fields a)) (len (.fields b)))
       (let [(mut ok) true]
         (for x (.fields a) (unless (has? (.fields b) x) (set! ok false)))
         ok)))

(defn paths-add! [(out (mut Paths)) (more Paths)] (-> void)
  (when (.whole more) (set! (.whole out) true))
  (for x (.fields more) (add-unique! (mut (.fields out)) x)))

;;; One question's work: what each parameter reached so far reads, as known yet, and those being
;;; worked out now. A function calling itself, at once or round about, reads what was known of it;
;;; the question is asked again until nothing it knows grows.
(defstruct PathWork
  [(keys (ArrayList (slice u8)))
   (known (ArrayList Paths))
   (open (ArrayList (slice u8)))
   (grew bool)])

(defn known-of [(w PathWork) (key (slice u8))] (-> Paths)
  (let [(mut out) (paths-new)]
    (for i (range 0 (len (.keys w)))
      (when (= (get (.keys w) i) key) (set! out (get (.known w) i))))
    out))

(defn know! [(w (mut PathWork)) (key (slice u8)) (p Paths)] (-> void)
  (let [(mut at) -1]
    (for i (range 0 (len (.keys w)))
      (when (= (get (.keys w) i) key) (set! at i)))
    (if (< at 0)
        (do
          (push! (mut (.keys w)) key)
          (push! (mut (.known w)) p)
          (set! (.grew w) true))
        (unless (paths-same? (get (.known w) at) p)
          (set! (mut (.known w)) at p)
          (set! (.grew w) true)))))

;;; What `module/name` reads of its parameter `index`.
(defn param-paths [(c (mut Checker))
                   (module (slice u8))
                   (name (slice u8))
                   (index i64)] (-> Paths)
  (let [(mut w)
          (PathWork
            :keys (texts)
            :known (ArrayList::new [Paths] (rt/value-allocator))
            :open (texts)
            :grew true)
        (mut out) (paths-new)]
    (while (.grew w)
      (set! (.grew w) false)
      (set! out (param-paths-in (mut c) (mut w) module name index)))
    out))

(defn param-paths-in [(c (mut Checker))
                      (w (mut PathWork))
                      (module (slice u8))
                      (name (slice u8))
                      (index i64)]
  (-> Paths)
  (let [key (dsl/join3 (dsl/join3 module "/" name) "#" (rt/num-text index))]
    (if (has? (.open w) key)
        (known-of w key)
        (match (fun-of (info-of (mut c) module) name)
          (None [] (paths-whole))
          (Some [f]
                (if (>= index (len (.params f)))
                    (paths-whole)
                    (let [p (get (.params f) index)
                          (mut locals) (texts)]
                      (locals! (.body f) (mut locals) false)
                      (if (has? locals p)
                          (paths-whole)
                          (let [(mut out) (paths-new)]
                            (push! (mut (.open w)) key)
                            (uses! (mut c)
                                   (mut w)
                                   (info-of (mut c) module)
                                   f
                                   p
                                   (mut out)
                                   (.body f))
                            (pop! (mut (.open w)))
                            (know! (mut w) key out)
                            out)))))))))

;;; The functions the rules make a list of the answers of, `[f(x, …) for …]`, or ask what they
;;; reach, `reach(roots, f)`, in `n`: each as `module/name`.
(defn sites! [(info Info) (f Fun) (n gr/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (when (and (= (.kind n) (gr/KComp)) (= (.kind (kid n 0)) (gr/KCall)))
    (let [callee (kid (kid n 0) 0)]
      (match (callee-of info f callee)
        (Some [module] (add-unique! (mut out) (dsl/join3 module "/" (callee-name callee))))
        (None [] 0))))
  (when (and (= (.kind n) (gr/KCall))
             (= (.kind (kid n 0)) (gr/KName))
             (= (.text (kid n 0)) "reach")
             (= (len (.kids (kid n 1))) 2))
    (let [target (arg-expr (get (.kids (kid n 1)) 1))]
      (match (callee-of info f target)
        (Some [module] (add-unique! (mut out) (dsl/join3 module "/" (callee-name target))))
        (None [] 0))))
  (for x (.kids n) (sites! info f x (mut out)))
  0)

;;; The function a call calls, when it is one of a module's: its module and name.
(defn callee-of [(info Info) (f Fun) (callee gr/Node)] (-> (Option (slice u8)))
  (cond (and (= (.kind callee) (gr/KName)) (< (param-index f (.text callee)) 0))
          (match (fun-of info (.text callee))
            (Some [_] (Some (.name info)))
            (None [] (None [(slice u8)])))
        (and (= (.kind callee) (gr/KFieldE))
             (= (.kind (kid callee 0)) (gr/KName)))
          (alias-of info (.text (kid callee 0)))
        :else (None [(slice u8)])))

(defn callee-name [(callee gr/Node)] (-> (slice u8))
  (if (= (.kind callee) (gr/KName)) (.text callee) (.text (kid callee 1))))

(defn uses! [(c (mut Checker))
             (w (mut PathWork))
             (info Info)
             (f Fun)
             (p (slice u8))
             (out (mut Paths))
             (n gr/Node)]
  (-> void)
  (match (.kind n)
    (gr/KName [] (when (= (.text n) p) (set! (.whole out) true)))
    (gr/KFieldE []
                (if (and (= (.kind (kid n 0)) (gr/KName))
                         (= (.text (kid n 0)) p))
                    (add-unique! (mut (.fields out))
                                 (dsl/join2 "." (.text (kid n 1))))
                    (uses! (mut c) (mut w) info f p (mut out) (kid n 0))))
    (gr/KCall []
              (let [callee (kid n 0)
                    args (.kids (kid n 1))
                    target (callee-of info f callee)]
                (uses! (mut c) (mut w) info f p (mut out) callee)
                (for j (range 0 (len args))
                  (let [a (get args j)
                        e (arg-expr a)]
                    (if (and (= (.kind e) (gr/KName)) (= (.text e) p))
                        (match target
                          (Some [module]
                                (let [name (callee-name callee)
                                      at
                                        (if (= (.kind a) (gr/KNamed))
                                            (match (fun-of (info-of (mut c)
                                                                    module)
                                                           name)
                                              (Some [g]
                                                    (param-index g
                                                                 (.text (kid a
                                                                             0))))
                                              (None [] -1))
                                            j)]
                                  (if (< at 0)
                                      (set! (.whole out) true)
                                      (paths-add! (mut out)
                                                  (param-paths-in (mut c)
                                                                  (mut w)
                                                                  module
                                                                  name
                                                                  at)))))
                          (None [] (set! (.whole out) true)))
                        (uses! (mut c) (mut w) info f p (mut out) e))))))
    (_ (for i (range 0 (len (.kids n)))
         (unless (label? n i)
           (uses! (mut c) (mut w) info f p (mut out) (kid n i)))))))

;; ---------------------------------------------------------------- strategies

;;; A strategy as the file declares it.
(defstruct StrategyDecl
  [(name (slice u8))
   (from (slice u8))
   (tracks bool)
   (persists bool)
   (default bool)
   (watching bool)
   (own (ArrayList (slice u8)))
   ;; `uses`: the mechanism of what it keeps ("" for its `from`'s, or the mechanism of old); `keep
   ;; with`: functions by a mechanism of their own; and the inputs it trusts, and rechecks.
   (uses (slice u8))
   (with-names (ArrayList (slice u8)))
   (with-mechanisms (ArrayList (slice u8)))
   (trust (ArrayList (slice u8)))
   (recheck (ArrayList (slice u8)))
   ;; The functions it has work apart (see `apart` in the pipeline language): its own alone.
   (apart (ArrayList (slice u8)))])

;;; A mechanism as the file declares it: each policy, or -1 where it says nothing (its `from`'s, or
;;; the mechanism of old's).
(defstruct MechanismDecl
  [(name (slice u8))
   (from (slice u8))
   (store-by (slice u8))
   (check-by (slice u8))
   (cutoff-by (slice u8))
   (evict-by (slice u8))
   (update-by (slice u8))
   (disk i64)
   (check i64)
   (cutoff i64)
   (evict i64)])

;;; How a function is kept: saved with the cache (where `store-by` says, when it names a function);
;;; checked by what it read (0), by no input changing (1), never (2), by a version (3, `check-by`);
;;; an answer made again changing nothing when it is the same (1), never (0), when `cutoff-by` says
;;; (2); at most so many answers (0: all, -1: as `evict-by` says).
(defstruct Policy
  [(disk bool)
   (store-by (slice u8))
   (check i64)
   (check-by (slice u8))
   (cutoff i64)
   (cutoff-by (slice u8))
   (evict i64)
   (evict-by (slice u8))
   (update-by (slice u8))])

;;; The mechanism of old's policy: saved, checked by reads, cut off when equal, every answer kept.
(defn old-policy [] (-> Policy)
  (Policy
    :disk true
    :store-by ""
    :check 0
    :check-by ""
    :cutoff 1
    :cutoff-by ""
    :evict 0
    :evict-by ""
    :update-by ""))

;;; Every strategy: what each keeps, what is kept by any (each function's place in that list is its
;;; number, the same for every compiler that reads the file), and which are used when a run does not
;;; say; and the mechanisms.
(defstruct Strategies
  [(decls (ArrayList StrategyDecl))
   (kept (ArrayList (slice u8)))
   ;; What any strategy has work apart: each function's place here is its number.
   (apart (ArrayList (slice u8)))
   ;; Those whose answers last when asked for from inside another computation apart.
   (lasting (ArrayList (slice u8)))
   (default (slice u8))
   (watching (slice u8))
   (mechanisms (ArrayList MechanismDecl))])

(defn find-mechanism [(ms (ArrayList MechanismDecl)) (name (slice u8))]
  (-> (Option MechanismDecl))
  (let [(mut out) (None [MechanismDecl])]
    (for m ms (when (= (.name m) name) (set! out (Some m))))
    out))

;;; The mechanisms of a pipeline file's tree, checked: each named once, `from` one before it.
(defn mechanisms-of [(src (slice u8)) (path (slice u8)) (tree g/Node)]
  (-> (ArrayList MechanismDecl))
  (let [(mut out) (ArrayList::new [MechanismDecl] (rt/value-allocator))]
    (for d (.kids (kid-of tree 1))
      (let [name (.text (kid-of d 0))
            (mut m)
              (MechanismDecl
                :name name
                :from ""
                :store-by ""
                :check-by ""
                :cutoff-by ""
                :evict-by ""
                :update-by ""
                :disk -1
                :check -1
                :cutoff -1
                :evict -1)]
        (match (find-mechanism out name)
          (Some [_]
                (strategy-fail src
                               path
                               d
                               (dsl/join2 "a second mechanism named " name)))
          (None [] 0))
        (for item (.kids (kid-of d 1))
          (match (.kind item)
            (g/KFrom []
                     (let [f (.text (kid-of item 0))]
                       (match (find-mechanism out f)
                         (Some [_] (set! (.from m) f))
                         (None []
                               (strategy-fail src
                                              path
                                              item
                                              (dsl/join3 "no mechanism named "
                                                         f
                                                         " before this one"))))))
            (g/KStore [] (set! (.disk m) (store-disk src path item)))
            (g/KStoreBy []
                        (do
                          (unless (= (store-disk src path item) 1)
                            (strategy-fail src
                                           path
                                           item
                                           "`store … by F` says which answers are saved: it is for `store memory disk`"))
                          (set! (.disk m) 1)
                          (set! (.store-by m) (.text (kid-of item 1)))))
            (g/KCheck []
                      (let [how (kid-of item 0)]
                        (set! (.check m)
                              (match (.kind how)
                                (g/KReads [] 0)
                                (g/KAnyChange [] 1)
                                (g/KNever [] 2)
                                (_ 3)))
                        (when (= (.kind how) (g/KCheckBy))
                          (set! (.check-by m) (.text (kid-of how 0))))))
            (g/KCutoff []
                       (let [how (kid-of item 0)]
                         (set! (.cutoff m)
                               (match (.kind how)
                                 (g/KEqual [] 1)
                                 (g/KNoCutoff [] 0)
                                 (_ 2)))
                         (when (= (.kind how) (g/KCutoffBy))
                           (set! (.cutoff-by m) (.text (kid-of how 0))))))
            (g/KEvict []
                      (let [how (kid-of item 0)]
                        (set! (.evict m)
                              (match (.kind how)
                                (g/KLru []
                                        (let [n
                                                (rt/parse-int (.text (kid-of how
                                                                             0)))]
                                          (when (< n 1)
                                            (strategy-fail src
                                                           path
                                                           item
                                                           "a bound of at least one answer"))
                                          n))
                                (g/KEvictBy [] -1)
                                (_ 0)))
                        (when (= (.kind how) (g/KEvictBy))
                          (set! (.evict-by m) (.text (kid-of how 0))))))
            (g/KUpdateBy [] (set! (.update-by m) (.text (kid-of item 0))))
            (_ (strategy-fail src path item "not a mechanism's item"))))
        (push! (mut out) m)))
    out))

;;; Whether a `store` item saves answers (1) or keeps them in memory only (0).
(defn store-disk [(src (slice u8)) (path (slice u8)) (item g/Node)] (-> i64)
  (let [(mut memory) false
        (mut disk) false]
    (for w (.kids (kid-of item 0))
      (if (= (.kind w) (g/KDisk)) (set! disk true) (set! memory true)))
    (unless memory
      (strategy-fail src
                     path
                     item
                     "answers are kept in memory, and on disk besides or not"))
    (if disk 1 0)))

;;; A mechanism's policies: the mechanism of old's, then each `from`'s in turn, then its own.
(defn mechanism-policy [(ms (ArrayList MechanismDecl)) (name (slice u8))]
  (-> Policy)
  (let [(mut chain) (ArrayList::new [MechanismDecl] (rt/value-allocator))
        (mut at) name
        (mut p) (old-policy)]
    (while (> (len at) 0)
      (match (find-mechanism ms at)
        (Some [m] (do (push! (mut chain) m) (set! at (.from m))))
        (None [] (panic "no mechanism named {}" at))))
    (for i (range 0 (len chain))
      (let [m (get chain (- (- (len chain) 1) i))]
        (when (>= (.disk m) 0)
          (set! (.disk p) (= (.disk m) 1))
          (set! (.store-by p) (.store-by m)))
        (when (>= (.check m) 0)
          (set! (.check p) (.check m))
          (set! (.check-by p) (.check-by m)))
        (when (>= (.cutoff m) 0)
          (set! (.cutoff p) (.cutoff m))
          (set! (.cutoff-by p) (.cutoff-by m)))
        ;; Unsaid is -1 with no function; `evict by F` is -1 with F.
        (when (or (>= (.evict m) 0) (> (len (.evict-by m)) 0))
          (set! (.evict p) (.evict m))
          (set! (.evict-by p) (.evict-by m)))
        (when (> (len (.update-by m)) 0) (set! (.update-by p) (.update-by m)))))
    p))

;;; The mechanism strategy `name` keeps function `f` by: a `keep with` naming it, here or in a
;;; strategy it is `from`; else the nearest `uses`; else "" (the mechanism of old).
(defn strategy-mechanism [(all Strategies) (name (slice u8)) (f (slice u8))]
  (-> (slice u8))
  (let [(mut at) name
        (mut with) ""
        (mut uses) ""]
    (while (> (len at) 0)
      (match (find-strategy (.decls all) at)
        (Some [d]
              (do
                (for i (range 0 (len (.with-names d)))
                  (when (and (= (len with) 0) (= (get (.with-names d) i) f))
                    (set! with (get (.with-mechanisms d) i))))
                (when (and (= (len uses) 0) (> (len (.uses d)) 0))
                  (set! uses (.uses d)))
                (set! at (.from d))))
        (None [] (panic "no strategy named {}" at))))
    (if (> (len with) 0) with uses)))

(defn strategy-policy [(all Strategies) (name (slice u8)) (f (slice u8))]
  (-> Policy)
  (let [m (strategy-mechanism all name f)]
    (if (= (len m) 0)
        (old-policy)
        (mechanism-policy (.mechanisms all) m))))

;;; A policy's function for one of its parts (`… by F`): 0 store, 1 check, 2 cutoff, 3 evict, 4
;;; update; "" for none.
(defn policy-hook [(p Policy) (role i64)] (-> (slice u8))
  (cond (= role 0) (.store-by p)
        (= role 1) (.check-by p)
        (= role 2) (.cutoff-by p)
        (= role 3) (.evict-by p)
        :else (.update-by p)))

;;; The functions any strategy gives kept function `f` for one part of its policy (see
;;; `policy-hook`), in order: a strategy's choice among them is its place in this list.
(defn hooks-of [(all Strategies)
                (made (ArrayList (slice u8)))
                (f (slice u8))
                (role i64)] (-> (ArrayList (slice u8)))
  (let [(mut out) (texts)]
    (for d (.decls all)
      (when (has? (strategy-keeps all (.name d) made) f)
        (let [h (policy-hook (strategy-policy all (.name d) f) role)]
          (when (> (len h) 0) (add-unique! (mut out) h)))))
    out))

;;; Where a policy's function for `role` is in the list of those for `f`, or -1 for none.
(defn hook-index [(all Strategies)
                  (made (ArrayList (slice u8)))
                  (f (slice u8))
                  (p Policy)
                  (role i64)] (-> i64)
  (let [h (policy-hook p role)
        hooks (hooks-of all made f role)
        (mut at) -1]
    (when (> (len h) 0)
      (for i (range 0 (len hooks)) (when (= (get hooks i) h) (set! at i))))
    at))

;;; A policy's check as the runtime has it: 0 reads, 1 any-change, 2 never, and 3 + i for the i-th
;;; of the function's check functions.
(defn policy-check [(all Strategies)
                    (made (ArrayList (slice u8)))
                    (f (slice u8))
                    (p Policy)] (-> i64)
  (if (= (.check p) 3) (+ 3 (hook-index all made f p 1)) (.check p)))

;;; A policy's cutoff as the runtime has it: 0 none, 1 equal, and 2 + i for the i-th of the
;;; function's cutoff functions.
(defn policy-cutoff [(all Strategies)
                     (made (ArrayList (slice u8)))
                     (f (slice u8))
                     (p Policy)] (-> i64)
  (if (= (.cutoff p) 2) (+ 2 (hook-index all made f p 2)) (.cutoff p)))

;;; The paths strategy `name` trusts, or rechecks, with those of every strategy it is `from`.
(defn strategy-paths [(all Strategies) (name (slice u8)) (trusting bool)]
  (-> (ArrayList (slice u8)))
  (let [(mut out) (texts)
        (mut at) name]
    (while (> (len at) 0)
      (match (find-strategy (.decls all) at)
        (Some [d]
              (do
                (for x (if trusting (.trust d) (.recheck d))
                  (add-unique! (mut out) x))
                (set! at (.from d))))
        (None [] (panic "no strategy named {}" at))))
    out))

(defn unquoted [(t (slice u8))] (-> (slice u8))
  (subslice t 1 (- (len t) 1)))

(defn strategy-fail [(src (slice u8))
                     (path (slice u8))
                     (n g/Node)
                     (msg (slice u8))] (-> never)
  (let [at (rt/line-col src (.lo n))]
    (dsl/fail-at path (.line at) (.col at) msg)))

(defn find-strategy [(decls (ArrayList StrategyDecl)) (name (slice u8))]
  (-> (Option StrategyDecl))
  (let [(mut out) (None [StrategyDecl])]
    (for d decls (when (= (.name d) name) (set! out (Some d))))
    out))

;;; What `name` keeps: its own, and through `from`, what those keep. `made`, what stages make, is
;;; kept by every strategy.
(defn strategy-keeps [(all Strategies)
                      (name (slice u8))
                      (made (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) (texts)
        (mut at) name]
    (for m made (add-unique! (mut out) m))
    (while (> (len at) 0)
      (match (find-strategy (.decls all) at)
        (Some [d]
              (do
                (for x (.own d) (add-unique! (mut out) x))
                (set! at (.from d))))
        (None [] (panic "no strategy named {}" at))))
    out))

(defn texts-sorted [(xs (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) (texts)]
    (for i (rt/sort-order-text xs false) (push! (mut out) (get xs i)))
    out))

;;; The strategies of a pipeline file's tree, checked: each named once, `from` one before it, one
;;; marked `default`, one marked `watching`, and that one tracks.
(defn strategies-of [(src (slice u8))
                     (path (slice u8))
                     (tree g/Node)
                     (made (ArrayList (slice u8)))] (-> Strategies)
  (let [mechanisms (mechanisms-of src path tree)
        (mut decls) (ArrayList::new [StrategyDecl] (rt/value-allocator))
        (mut default) ""
        (mut watching) ""
        (mut union) (texts)
        (mut apart-union) (texts)
        (mut lasting-union) (texts)]
    (for d (.kids (kid-of tree 2))
      (let [name (.text (kid-of d 0))
            (mut from) ""
            (mut tracks) false
            (mut persists) false
            (mut is-default) false
            (mut is-watching) false
            (mut own) (texts)
            (mut uses) ""
            (mut with-names) (texts)
            (mut with-mechanisms) (texts)
            (mut trust) (texts)
            (mut recheck) (texts)
            (mut apart) (texts)]
        (match (find-strategy decls name)
          (Some [_]
                (strategy-fail src
                               path
                               d
                               (dsl/join2 "a second strategy named " name)))
          (None [] 0))
        (for item (.kids (kid-of d 1))
          (match (.kind item)
            (g/KFrom []
                     (let [f (.text (kid-of item 0))]
                       (match (find-strategy decls f)
                         (Some [_] (set! from f))
                         (None []
                               (strategy-fail src
                                              path
                                              item
                                              (dsl/join3 "no strategy named "
                                                         f
                                                         " before this one"))))))
            (g/KTracks [] (set! tracks true))
            (g/KPersists [] (set! persists true))
            (g/KDefault [] (set! is-default true))
            (g/KWatching [] (set! is-watching true))
            (g/KKeep []
                     (for t (.kids (kid-of item 0))
                       (add-unique! (mut own) (.text t))))
            (g/KUses []
                     (let [m (.text (kid-of item 0))]
                       (match (find-mechanism mechanisms m)
                         (Some [_] (set! uses m))
                         (None []
                               (strategy-fail src
                                              path
                                              item
                                              (dsl/join2 "no mechanism named "
                                                         m))))))
            (g/KKeepWith []
                         (let [m (.text (kid-of item 0))]
                           (match (find-mechanism mechanisms m)
                             (Some [_] 0)
                             (None []
                                   (strategy-fail src
                                                  path
                                                  item
                                                  (dsl/join2 "no mechanism named "
                                                             m))))
                           (for t (.kids (kid-of item 1))
                             (add-unique! (mut own) (.text t))
                             (push! (mut with-names) (.text t))
                             (push! (mut with-mechanisms) m))))
            (g/KTrust [] (push! (mut trust) (unquoted (.text (kid-of item 0)))))
            (g/KRecheck []
                        (push! (mut recheck) (unquoted (.text (kid-of item 0)))))
            (g/KApart []
                      (for t (.kids (kid-of item 0))
                        (add-unique! (mut apart) (.text t))))
            (g/KApartLasting []
                             (for t (.kids (kid-of item 0))
                               (add-unique! (mut apart) (.text t))
                               (add-unique! (mut lasting-union) (.text t))))
            (_ (strategy-fail src path item "not a strategy's item"))))
        (when is-default
          (when (> (len default) 0)
            (strategy-fail src path d "a second strategy marked default"))
          (set! default name))
        (when is-watching
          (when (> (len watching) 0)
            (strategy-fail src path d "a second strategy marked watching"))
          (unless (or tracks
                      (match (find-strategy decls from)
                        (Some [p] (.tracks p))
                        (None [] false)))
            (strategy-fail src
                           path
                           d
                           "the strategy used while watching must track: answers kept from one build to the next are checked by what they were made from"))
          (set! watching name))
        ;; From a strategy that tracks, or persists, so does this one.
        (when (and (> (len from) 0)
                   (match (find-strategy decls from)
                     (Some [p] (.tracks p))
                     (None [] false)))
          (set! tracks true))
        (when (and (> (len from) 0)
                   (match (find-strategy decls from)
                     (Some [p] (.persists p))
                     (None [] false)))
          (set! persists true))
        (when (and persists (not tracks))
          (strategy-fail src
                         path
                         d
                         "a strategy that persists must track: an answer read back is checked by what it was made from"))
        (when (and tracks (> (len apart) 0))
          (strategy-fail src
                         path
                         d
                         "a strategy that tracks has nothing work apart: each answer it keeps has storage of its own already"))
        (for x own (add-unique! (mut union) x))
        (for x apart (add-unique! (mut apart-union) x))
        (push! (mut decls)
               (StrategyDecl
                 :name name
                 :from from
                 :tracks tracks
                 :persists persists
                 :default is-default
                 :watching is-watching
                 :own own
                 :uses uses
                 :with-names with-names
                 :with-mechanisms with-mechanisms
                 :trust trust
                 :recheck recheck
                 :apart apart))))
    (when (and (> (len decls) 0) (= (len default) 0))
      (strategy-fail src path tree "no strategy is marked default"))
    (when (and (> (len decls) 0) (= (len watching) 0))
      (strategy-fail src path tree "no strategy is marked watching"))
    (for m made (add-unique! (mut union) m))
    (Strategies
      :decls decls
      :kept (texts-sorted union)
      :apart (texts-sorted apart-union)
      :lasting lasting-union
      :default default
      :watching watching
      :mechanisms mechanisms)))

;;; Each function's number among those any strategy has work apart; -1 for one none does.
(defn apart-index [(all Strategies) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.apart all)))
      (when (= (get (.apart all) i) name) (set! at i)))
    at))

;;; Each function's number among those any strategy keeps; -1 for one none does.
(defn kept-index [(all Strategies) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.kept all)))
      (when (= (get (.kept all) i) name) (set! at i)))
    at))

;;; The functions stages make, which every strategy keeps.
(defn made-of [(tree g/Node)] (-> (ArrayList (slice u8)))
  (let [(mut out) (texts)]
    (for d (.kids (kid-of tree 3))
      (let [makes (if (= (.kind d) (g/KPerStage)) (kid-of d 4) (kid-of d 2))]
        (unless (= (.kind makes) (g/KNone))
          (for t (.kids (kid-of makes 0)) (add-unique! (mut out) (.text t))))))
    out))

;; ---------------------------------------------------------------- the pipeline

(defstruct Stage
  [(name (slice u8))
   (unit (slice u8))
   (functions (ArrayList (slice u8)))
   (makes (ArrayList (slice u8)))
   ;; Its functions give settings by `with` (`gives settings`).
   (gives bool)
   ;; What its functions' names are given to, in order (`names by`), or "".
   (namer (slice u8))
   ;; How many of its units a thread takes at a time (`per N units`); 1 when it does not say.
   (run i64)
   ;; A list of fewer units than this is made alone (`per N of M units`); one more than `run`
   ;; when it does not say.
   (least i64)
   ;; Whether the names its function reaches are files its work reads (`reads files`).
   (reads bool)
   ;; On one thread `whole` answers for `divided` (`alone F is G`); "" when it does not say.
   (divided (slice u8))
   (whole (slice u8))
   ;; Functions its threads may be the first to make an answer of, besides its work (`also`).
   (also (ArrayList (slice u8)))
   ;; Language modules that divide what they are given themselves, as this stage's work (`inside`).
   (inside (ArrayList (slice u8)))
   (lo i64)])

;;; For a language module that divides its own work, compiled from `file`: the number of the
;;; stage of the program's pipeline that names it (`inside`), or -1 when none does and its work
;;; stays whole. The program is the manifest's.
(defn inside-stage [(manifest (slice u8)) (file (slice u8))] (-> i64)
  (let [entries (dsl/manifest-entries manifest)
        (mut module) ""
        (mut at) -1]
    (for e entries
      (when (or (= (.file e) file) (rt/ends-with (.file e) file) (rt/ends-with file (.file e)))
        (set! module (.name e))))
    (for e entries
      (when (rt/ends-with (.file e) ".pipeline")
        (let [src (rt/read-all (.file e))]
          (match (g/parse-result src (.file e) 0)
            (Ok [tree]
                (let [stages (stages-of tree)]
                  (for i (range 0 (len stages))
                    (when (has? (.inside (get stages i)) module) (set! at i)))))
            (Err [_] 0)))))
    at))

;;; The number the program's pipeline gives a size, or `otherwise` when it gives none.
(defn size-given [(manifest (slice u8)) (name (slice u8)) (otherwise i64)] (-> i64)
  (let [(mut out) otherwise]
    (for e (dsl/manifest-entries manifest)
      (when (rt/ends-with (.file e) ".pipeline")
        (let [src (rt/read-all (.file e))]
          (match (g/parse-result src (.file e) 0)
            (Ok [tree]
                (for s (sizes-of tree)
                  (when (= (.name s) name) (set! out (rt/parse-int (.value s)))))
                0)
            (Err [_] 0)))))
    out))

;;; The name the manifest gives the module compiled from `file`, or "".
(defn module-named [(manifest (slice u8)) (file (slice u8))] (-> (slice u8))
  (let [(mut module) ""]
    (for e (dsl/manifest-entries manifest)
      (when (or (= (.file e) file) (rt/ends-with (.file e) file) (rt/ends-with file (.file e)))
        (set! module (.name e))))
    module))

;;; The sizes a pipeline file gives (`size module/name N`): each name, and its number as written.
(defstruct Size [(name (slice u8)) (value (slice u8))])

(defn sizes-of [(tree g/Node)] (-> (ArrayList Size))
  (let [(mut out) (ArrayList::new [Size] (rt/value-allocator))]
    (for d (.kids (kid-of tree 4))
      (push! (mut out) (Size :name (.text (kid-of d 0)) :value (.text (kid-of d 1)))))
    out))

;;; A pipeline file's stages, in order: a stage's place is its number, the same for every compiler
;;; that reads the file.
(defn stages-of [(tree g/Node)] (-> (ArrayList Stage))
  (let [(mut stages) (ArrayList::new [Stage] (rt/value-allocator))]
    (for d (.kids (kid-of tree 3))
      (let [(mut fns) (texts)
            (mut makes) (texts)
            (mut also) (texts)
            (mut inside) (texts)
            per (= (.kind d) (g/KPerStage))
            fn-list (if per (kid-of d 3) (kid-of d 1))
            makes-node (if per (kid-of d 4) (kid-of d 2))]
        (when (and per (not (= (.kind (kid-of d 9)) (g/KNone))))
          (for t (.kids (kid-of (kid-of d 9) 0)) (push! (mut also) (.text t))))
        (when (and per (not (= (.kind (kid-of d 10)) (g/KNone))))
          (for t (.kids (kid-of (kid-of d 10) 0)) (push! (mut inside) (.text t))))
        (for t (.kids fn-list) (push! (mut fns) (.text t)))
        (unless (= (.kind makes-node) (g/KNone))
          (for t (.kids (kid-of makes-node 0)) (push! (mut makes) (.text t))))
        (push! (mut stages)
               (Stage
                 :name (.text (kid-of d 0))
                 :unit (if per (.text (kid-of d 2)) "whole")
                 :functions fns
                 :makes makes
                 :gives (and per (not (= (.kind (kid-of d 5)) (g/KNone))))
                 :namer (if (and per (not (= (.kind (kid-of d 6)) (g/KNone))))
                            (.text (kid-of (kid-of d 6) 0))
                            "")
                 :run (if (and per (not (= (.kind (kid-of d 1)) (g/KNone))))
                          (let [n (rt/parse-int (.text (kid-of (kid-of d 1) 0)))]
                            (if (< n 1) 1 n))
                          1)
                 :least (if (and per
                                 (not (= (.kind (kid-of d 1)) (g/KNone)))
                                 (not (= (.kind (kid-of (kid-of d 1) 1)) (g/KNone))))
                            (rt/parse-int (.text (kid-of (kid-of (kid-of d 1) 1) 0)))
                            (if (and per (not (= (.kind (kid-of d 1)) (g/KNone))))
                                (+ 1 (let [n (rt/parse-int (.text (kid-of (kid-of d 1) 0)))] (if (< n 1) 1 n)))
                                2))
                 :reads (and per (not (= (.kind (kid-of d 7)) (g/KNone))))
                 :divided (if (and per (not (= (.kind (kid-of d 8)) (g/KNone))))
                              (.text (kid-of (kid-of d 8) 0))
                              "")
                 :whole (if (and per (not (= (.kind (kid-of d 8)) (g/KNone))))
                            (.text (kid-of (kid-of d 8) 1))
                            "")
                 :also also
                 :inside inside
                 :lo (.lo d)))))
    stages))

(defn tok-of [(src (slice u8)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col src (.lo n))]
    (rt/Tok
      :kind (rt/TIdent)
      :text (.text n)
      :line (.line at)
      :col (.col at))))

(defn split-fn [(c (mut dsl/Cur)) (t rt/Tok)] (-> (ArrayList (slice u8)))
  (let [s (.text t)
        (mut cut) -1
        (mut out) (texts)]
    (for i (range 0 (len s)) (when (= (get s i) #\/) (set! cut i)))
    (when (< cut 0) (dsl/die (mut c) t "expected module/function"))
    (push! (mut out) (subslice s 0 cut))
    (push! (mut out) (subslice s (+ cut 1) (len s)))
    out))

(defn find-stage [(stages (ArrayList Stage)) (name (slice u8))]
  (-> (Option Stage))
  (let [(mut out) (None [Stage])]
    (for s stages (when (= (.name s) name) (set! out (Some s))))
    out))

;;; A count in a plan: a number, or `auto`, the machine's cores.
(defn count-code [(n g/Node)] (-> Code)
  (if (= (.kind n) (g/KAuto))
      `(rt/cores)
      `~(rt/parse-int (.text n))))

;;; Whether every function stage `s` names, and all they call, writes no shared state: what a plan
;;; must show before it runs the stage on many threads.
(defn stage-safe? [(chk (mut Checker)) (s Stage)] (-> bool)
  (let [(mut safe) true]
    (for full (.functions s)
      (let [slash
              (let [(mut cut) -1]
                (for i (range 0 (len full))
                  (when (= (get full i) #\/) (set! cut i)))
                cut)
            e (fun-effect (mut chk) (subslice full 0 slash) (subslice full (+ slash 1) (len full)))]
        (when (or (> (len (.writes e)) 0) (> (len (.hooks e)) 0))
          (set! safe false))))
    safe))

(defn check-stage! [(chk (mut Checker))
                    (c (mut dsl/Cur))
                    (src (slice u8))
                    (plan-name (slice u8))
                    (s Stage)
                    (at g/Node)] (-> void)
  (for full (.functions s)
    (let [slash
            (let [(mut cut) -1]
              (for i (range 0 (len full))
                (when (= (get full i) #\/) (set! cut i)))
              cut)
          module (subslice full 0 slash)
          name (subslice full (+ slash 1) (len full))
          e (fun-effect (mut chk) module name)]

      (when (or (> (len (.writes e)) 0) (> (len (.hooks e)) 0))
        (let [(mut msg)
                (dsl/join3 "plan "
                           plan-name
                           (dsl/join3 " runs " (.name s) " in parallel, but "))]
          (set! msg (dsl/join3 msg full ""))
          (for w (.writes e)
            (set! msg
                  (dsl/join3 msg
                             (dsl/join2 "\n  writes shared state " (.what w))
                             (dsl/join2 ", in " (.where w)))))
          (for h (.hooks e)
            (set! msg
                  (dsl/join3 msg
                             "\n  "
                             (dsl/join2 h
                                        ", whose effects cannot be known here"))))
          (dsl/die (mut c) (tok-of src at) msg))))))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree
          (match (g/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (dsl/join2 "expected " (.want e)))))
        (mut chk)
          (checker-new (dsl/manifest-entries (meta/read-context-manifest context)))
        stages (stages-of tree)
        (mut every) (primitive/code-list-new)
        (mut size-arms) (primitive/code-list-new)
        (mut arms) (primitive/code-list-new)
        (mut names) (primitive/code-list-new)]
    ;; What is kept is the rules compiler's to apply (see `keep` in the rules compiler): here each is
    ;; only a function's name, and a run's choice of strategy is a switch for each.
    (for d (.kids (kid-of tree 2))
      (for item (.kids (kid-of d 1))
        (when (= (.kind item) (g/KKeep))
          (for t (.kids (kid-of item 0))
            (split-fn (mut c) (tok-of src t))))
        (when (= (.kind item) (g/KKeepWith))
          (for t (.kids (kid-of item 1))
            (split-fn (mut c) (tok-of src t))))
        (when (or (= (.kind item) (g/KApart)) (= (.kind item) (g/KApartLasting)))
          (for t (.kids (kid-of item 0))
            (split-fn (mut c) (tok-of src t))))))
    ;; Each stage's functions named as `module/function`; what it makes is kept by every strategy.
    (for d (.kids (kid-of tree 3))
      (let [per (= (.kind d) (g/KPerStage))
            fn-list (if per (kid-of d 3) (kid-of d 1))
            makes-node (if per (kid-of d 4) (kid-of d 2))]
        (for t (.kids fn-list) (split-fn (mut c) (tok-of src t)))
        (unless (= (.kind makes-node) (g/KNone))
          (for t (.kids (kid-of makes-node 0))
            (split-fn (mut c) (tok-of src t))
            (push! (mut (.made chk)) (.text t))))
        (when (and per (not (= (.kind (kid-of d 6)) (g/KNone))))
          (split-fn (mut c) (tok-of src (kid-of (kid-of d 6) 0))))
        (when (and per (not (= (.kind (kid-of d 8)) (g/KNone))))
          (split-fn (mut c) (tok-of src (kid-of (kid-of d 8) 0)))
          (split-fn (mut c) (tok-of src (kid-of (kid-of d 8) 1))))
        (when (and per (not (= (.kind (kid-of d 9)) (g/KNone))))
          (for t (.kids (kid-of (kid-of d 9) 0)) (split-fn (mut c) (tok-of src t))))))
    ;; Each function that is a stage's work has a list of its answers, or a walk of what it
    ;; reaches, somewhere in the rules: a stage with none does nothing, whatever a plan gives it.
    (let [(mut used) (texts)]
      (for e (.entries chk)
        (when (or (rt/ends-with (.file e) ".rules") (rt/ends-with (.file e) ".attrs"))
          (let [info (info-of (mut chk) (.name e))]
            (for f (.funs info) (sites! info f (.body f) (mut used))))))
      (for s stages
        (unless (= (.unit s) "whole")
          (for f (.functions s)
            (unless (has? used f)
              (let [at (rt/line-col src (.lo s))]
                (dsl/fail-at path
                             (.line at)
                             (.col at)
                             (dsl/join3 f
                                        " is the work of stage "
                                        (dsl/join2 (.name s)
                                                   ", but the rules make no list of its answers, `[f(x) for x in xs]`, and ask nothing of what it reaches: the stage would do nothing (a function its threads only make on the way is named after `also`)")))))))))
    (for d (.kids (kid-of tree 4)) (split-fn (mut c) (tok-of src (kid-of d 0))))
    ;; A function is one stage's work: the list the rules make of its answers runs on that
    ;; stage's threads.
    (for i (range 0 (len stages))
      (for j (range 0 i)
        (when (and (not (= (.unit (get stages i)) "whole"))
                   (not (= (.unit (get stages j)) "whole")))
          (for f (.functions (get stages i))
            (when (has? (.functions (get stages j)) f)
              (let [at (rt/line-col src (.lo (get stages i)))]
                (dsl/fail-at path
                             (.line at)
                             (.col at)
                             (dsl/join3 f
                                        " is the work of two stages: "
                                        (dsl/join3 (.name (get stages j))
                                                   " and "
                                                   (.name (get stages i)))))))))))
    ;; `--threads=N` gives N only to a stage shown to share no state, as a plan's `parallel` is
    ;; checked; any other stage stays on one thread.
    (for i (range 0 (len stages))
      (unless (= (.unit (get stages i)) "whole")
        (if (stage-safe? (mut chk) (get stages i))
            (push! (mut every) `(rt/stage-threads! ~i n))
            (push! (mut every) `(rt/stage-threads! ~i 1)))))
    (let [given (sizes-of tree)]
      (for i (range 0 (len given))
        (push! (mut size-arms) `(= name ~(.name (get given i))))
        (push! (mut size-arms) `(rt/size-given! ~i n))))
    (for p (.kids (kid-of tree 5))
      (let [plan-name (.text (kid-of p 0))
            (mut threads) `1
            (mut sets) (primitive/code-list-new)
            (mut plan-sizes) (primitive/code-list-new)
            (mut parallel) (texts)
            (mut counts) (ArrayList::new [Code] (rt/value-allocator))]
        (for item (.kids (kid-of p 1))
          (when (= (.kind item) (g/KThreads))
            (set! threads (count-code (kid-of item 0)))))
        (for item (.kids (kid-of p 1))
          (match (.kind item)
            (g/KThreads [] 0)
            (g/KPlanSize []
                         (let [given (sizes-of tree)
                               (mut at) -1]
                           (for i (range 0 (len given))
                             (when (= (.name (get given i)) (.text (kid-of item 0))) (set! at i)))
                           (when (< at 0)
                             (dsl/die (mut c)
                                      (tok-of src (kid-of item 0))
                                      (dsl/join2 "the pipeline gives no size named " (.text (kid-of item 0)))))
                           (push! (mut plan-sizes)
                                  `(rt/size-given! ~at ~(rt/parse-int (.text (kid-of item 1)))))
                           0))
            (_ (let [sname (.text (kid-of item 0))]
                 (match (find-stage stages sname)
                   (None []
                         (dsl/die (mut c)
                                  (tok-of src (kid-of item 0))
                                  (dsl/join2 "no stage named " sname)))
                   (Some [s]
                         (when (= (.kind item) (g/KParallel))
                           (when (= (.unit s) "whole")
                             (dsl/die (mut c)
                                      (tok-of src (kid-of item 0))
                                      (dsl/join3 sname
                                                 " works on the whole program: it has no files or parts to run at once"
                                                 "")))
                           (check-stage! (mut chk)
                                         (mut c)
                                         src
                                         plan-name
                                         s
                                         (kid-of item 0))
                           (push! (mut parallel) sname)
                           (push! (mut counts)
                                  (if (= (.kind (kid-of item 1)) (g/KNone))
                                      threads
                                      (count-code (kid-of item 1)))))))))))
        ;; Every stage that works in units has a thread count: one, unless the plan says.
        (for i (range 0 (len stages))
          (unless (= (.unit (get stages i)) "whole")
            (let [(mut at) -1]
              (for j (range 0 (len parallel))
                (when (= (get parallel j) (.name (get stages i))) (set! at j)))
              (push! (mut sets)
                     `(rt/stage-threads! ~i ~(if (>= at 0) (get counts at) `1))))))
        (push! (mut names) `(push! (mut out) ~plan-name))
        (push! (mut arms) `(= name ~plan-name))
        (push! (mut arms) `(do ~@sets ~@plan-sizes 0))))
    (let [(mut deps) (primitive/code-list-new)
          all (strategies-of src path tree (made-of tree))
          (mut uses) (primitive/code-list-new)
          (mut tracking) (primitive/code-list-new)
          (mut persisting) (primitive/code-list-new)
          (mut strategy-names) (primitive/code-list-new)
          (mut hook-modules) (texts)
          (mut hook-imports) (primitive/code-list-new)
          (mut hook-registers) (primitive/code-list-new)]
      ;; The modules of the functions the strategies' mechanisms name, each registering them.
      (for d (.decls all)
        (for x (strategy-keeps all (.name d) (made-of tree))
          (let [p (strategy-policy all (.name d) x)]
            (for role (range 0 5)
              (let [h (policy-hook p role)]
                (when (> (len h) 0)
                  (add-unique! (mut hook-modules)
                               (subslice h 0 (rt/name-end-at h 47)))))))))
      (for m hook-modules
        (let [alias (dsl/join2 "hooks-" (rt/joined (rt/split m ".") "-"))]
          (push! (mut hook-imports)
                 `(import ~m :as ~(primitive/code-symbol alias)))
          (push! (mut hook-registers)
                 `(~(primitive/code-symbol alias "/register-hooks!")))))
      (for d (.decls all)
        (let [(mut ons) (primitive/code-list-new)]
          (for x (strategy-keeps all (.name d) (made-of tree))
            (push! (mut ons) `(push! (mut on) ~(kept-index all x))))
          (let [(mut policies) (primitive/code-list-new)
                (mut trusts) (primitive/code-list-new)
                (mut rechecks) (primitive/code-list-new)
                (mut aparts) (primitive/code-list-new)]
            (for x (.apart d)
              (push! (mut aparts) `(push! (mut apart) ~(apart-index all x))))
            (for x (strategy-keeps all (.name d) (made-of tree))
              (let [p (strategy-policy all (.name d) x)]
                (push! (mut policies)
                       `(rt/keep-policy! ~(kept-index all x)
                                         ~(if (.disk p) `true `false)
                                         ~(hook-index all (made-of tree) x p 0)
                                         ~(policy-check all (made-of tree) x p)
                                         ~(policy-cutoff all (made-of tree) x p)
                                         ~(.evict p)
                                         ~(hook-index all (made-of tree) x p 3)
                                         ~(hook-index all (made-of tree) x p 4)))))
            (for x (strategy-paths all (.name d) true)
              (push! (mut trusts) `(push! (mut trust) ~x)))
            (for x (strategy-paths all (.name d) false)
              (push! (mut rechecks) `(push! (mut recheck) ~x)))
            (push! (mut uses) `(= name ~(.name d)))
            (push! (mut uses)
                   `(let [(mut on) (ArrayList::new [i64] (malloc-allocator))
                          (mut trust)
                            (ArrayList::new [(slice u8)] (malloc-allocator))
                          (mut recheck)
                            (ArrayList::new [(slice u8)] (malloc-allocator))
                          (mut apart) (ArrayList::new [i64] (malloc-allocator))]
                      ~@ons
                      ~@aparts
                      (rt/keep-only! ~(len (.kept all)) on)
                      (rt/apart-only! ~(len (.apart all)) apart)
                      ~@policies
                      ~@trusts
                      ~@rechecks
                      (rt/trust-paths! trust)
                      (rt/recheck-paths! recheck)
                      ~(if (.tracks d) `(rt/dep-track!) `0)
                      0)))
          (push! (mut tracking) `(= name ~(.name d)))
          (push! (mut tracking) (if (.tracks d) `true `false))
          (push! (mut persisting) `(= name ~(.name d)))
          (push! (mut persisting) (if (.persists d) `true `false))
          (push! (mut strategy-names) `(push! (mut out) ~(.name d)))))
      (for d (.depends chk) (push! (mut deps) `~d))
      (dsl/render `(do
                     ~@hook-imports
                     (import "hl.rt" :as rt)
                     (import "coil.arraylist" :use [ArrayList])
                     (import "coil.alloc" :use [malloc-allocator])
                     ~(if (> (len (.depends chk)) 0) `(depends-on ~@deps) `(do))
                     ;; The run gives each stage the threads this plan says.
                     (defn use-plan! [(name (slice u8))] (-> void)
                       (cond ~@arms :else
                             (panic "no plan named {}: the pipeline has {}"
                                    name
                                    (rt/joined (plan-names) ", "))))
                     ;; The run gives a size a number of its own.
                     (defn use-size! [(name (slice u8)) (n i64)] (-> void)
                       (cond ~@size-arms :else
                             (panic "the pipeline gives no size named {}" name)))
                     ;; The run gives every stage that works in units `n` threads.
                     (defn use-threads! [(n i64)] (-> void)
                       ~@every
                       0)
                     (defn plan-names [] (-> (ArrayList (slice u8)))
                       (let [(mut out)
                               (ArrayList::new [(slice u8)] (rt/tree-allocator))]
                         ~@names
                         out))
                     ;; The run keeps what this strategy keeps, and tracks dependencies if it does.
                     (defn use-strategy! [(name (slice u8))] (-> void)
                       ;; The strategies' functions, for the code they serve to call.
                       ~@hook-registers
                       (cond ~@uses :else
                             (panic "no strategy named {}: the pipeline has {}"
                                    name
                                    (rt/joined (strategy-names) ", "))))
                     (defn strategy-tracks? [(name (slice u8))] (-> bool)
                       (cond ~@tracking :else
                             (panic "no strategy named {}" name)))
                     (defn strategy-persists? [(name (slice u8))] (-> bool)
                       (cond ~@persisting :else
                             (panic "no strategy named {}" name)))
                     ;; A run's start: its strategy used, and with a cache, what that strategy kept
                     ;; loaded from it, when it persists. Whether there was one to load. A run that
                     ;; watches lets go of what its builds no longer need (see `rt/reclaim!`).
                     (defn run-started! [(name (slice u8)) (cache (slice u8)) (watching bool)]
                       (-> bool)
                       (use-strategy! name)
                       (when watching (rt/reclaim!))
                       (if (= (len cache) 0)
                           false
                           (do
                             (unless (strategy-persists? name)
                               (panic "strategy {} keeps nothing from one run to the next, and the run asks for a cache"
                                      name))
                             ;; There before anything is built: made later, it would change a
                             ;; listing a build read.
                             (rt/make-dirs! (rt/dir-of-path cache))
                             (rt/cache-load! cache))))
                     ;; After each build: with a cache, what the strategy keeps saved to it, on a
                     ;; thread of its own when `later` (a watcher waits meanwhile).
                     (defn build-done! [(name (slice u8))
                                        (cache (slice u8))
                                        (later bool)
                                        (timing bool)] (-> void)
                       ;; What a mechanism lets go after each build (`evict by`), before anything is saved;
                       ;; then, while watching, the memory of everything nothing holds any more.
                       (rt/sweep-kept!)
                       (rt/regions-safe-point!)
                       (when (> (len cache) 0)
                         (if later
                             (rt/cache-save-later! cache timing)
                             (rt/cache-save! cache)))
                       0)
                     (defn default-strategy [] (-> (slice u8))
                       ~(.default all))
                     (defn watching-strategy [] (-> (slice u8))
                       ~(.watching all))
                     (defn strategy-names [] (-> (ArrayList (slice u8)))
                       (let [(mut out)
                               (ArrayList::new [(slice u8)] (rt/tree-allocator))]
                         ~@strategy-names
                         out)))))))

(defn kid-of [(n g/Node) (i i64)] (-> g/Node)
  (get (.kids n) i))

(defn read-pipeline [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
