;;; The `.pipeline` grammar as ordinary compile-time Coil: see facts.coil beside it.
(module hl.grammars.pipeline)
(import "coil.primitive" :as primitive)
(import "hl.syntax" :as syntax)
(import "coil.alloc" :use [malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])
(import "hl.rt" :as rt)
(import "hl.quote" :as hq)

(defn generate [] (-> Code)
  (primitive/code-read (syntax/read-grammar (include-str "../../../src/languages/pipeline.syntax")
                                            "src/languages/pipeline.syntax")
                       `(reader-config)))

(generate)
