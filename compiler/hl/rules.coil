;;; `.rules`: the language for everything between a grammar and a Datalog program.
;;;
;;;   rules bundle.graph over bundle.js   # the file's module, and the grammar it works on
;;;   use bundle.link as link             # another module of any language
;;;   quote stmt at 1 0 ;                 # stmt`…` is the template's first statement
;;;
;;;   record Module { path: Text, deps: [Int] }
;;;   enum Sort { Esm, Cjs }
;;;   state modules: [Module] = []        # lives as long as the build
;;;   context strict: Bool = false        # rebound for a dynamic extent by `with`
;;;
;;;   fn pure?(n: Node) -> Bool = match n {
;;;     Num(_) | Str(_) => true
;;;     Paren(x) | Not(x) => pure?(x)
;;;     ArrayLit(List(xs...)) => all x in xs: pure?(x)
;;;     _ => false
;;;   }
;;;   fn wrap(name: Text, body: [Node]) -> Node = stmt`var $name = $helper(() => { $$body });`
;;;   main run on big stack               # this file is a program, and `run` is where it starts
;;;   for db.declares(p, ?s) { names[s] = final(s) }     # a query over a relation
;;;
;;; Node patterns and constructors are checked against the grammar, and everything is
;;; type-checked here, across modules, so mistakes are located in the guest file. There is
;;; no runtime: this compiles to the Coil a person would have written.
(module hl.rules)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.str" :as str)
(import "coil.meta" :as meta)
(import "coil.fs" :as fs)
(import "coil.cc" :as cc)
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.pipeline" :as pl)
(import "hl.syntax" :as syntax)
(import "hl.grammars.rules" :as g)
(import "hl.grammars.facts" :as gf)
(import "hl.grammars.rewrite" :as grw)
(import "hl.grammars.scopes" :as gsc)
(import "hl.grammars.pipeline" :as gpl)

(reader-provider "hl.rules" read-rules)

;; ---------------------------------------------------------------- what modules offer

(defstruct Param [(name (slice u8)) (ty (slice u8)) (by-ref bool)])

(defstruct Mutator [(key (slice u8)) (calls (ArrayList g/Node))])

;;; A kept function's functions for one part of how strategies keep it (`store by`, `check by`,
;;; `cutoff by`, `evict by`: role 0 to 3), as `module/function`, in the order the pipeline numbers
;;; them (see `pl/hooks-of`).
(defstruct Hooks [(key (slice u8)) (role i64) (fns (ArrayList (slice u8)))])

(defstruct Func
  [(name (slice u8))
   (coil (slice u8))
   (params (ArrayList Param))
   (ret (slice u8))])

(defstruct FieldDef [(name (slice u8)) (ty (slice u8))])

(defstruct RecDef [(name (slice u8)) (fields (ArrayList FieldDef)) (boxed bool)])

(defstruct EnumDef [(name (slice u8)) (variants (ArrayList (slice u8)))])

(defstruct Global
  [(name (slice u8))
   (ty (slice u8))
   (assignable bool)
   (task bool)
   (attr i64)])  ; an attribute: 1 inherited, 2 an input, 3 collected, 4 given;

; else 0
(defstruct RelDef [(name (slice u8)) (arity i64)])

(defstruct QuoteDef [(name (slice u8)) (path (ArrayList i64))])

(defstruct Alias [(name (slice u8)) (module (slice u8))])

(defsum Sort (SRules) (SForeign) (SGrammar) (SFacts) (SRewrite) (SScopes))

(derive Eq Sort)

(defstruct Mod
  [(name (slice u8))
   (sort Sort)
   (funcs (ArrayList Func))
   (recs (ArrayList RecDef))
   (enums (ArrayList EnumDef))
   (globals (ArrayList Global))
   (types (ArrayList (slice u8)))
   (kinds (ArrayList syntax/KindEntry))
   (rels (ArrayList RelDef))
   (quotes (ArrayList QuoteDef))
   (aliases (ArrayList Alias))
   (over (slice u8))
   ;; Its memo functions' names.
   (memos (ArrayList (slice u8)))])

(defstruct Local
  [(name (slice u8)) (ty (slice u8)) (sym (slice u8)) (mutable bool)
   ;; How many loops with a region of their own enclose it (see `scoped-loop?`).
   (depth i64)])

(defstruct Comp
  [;; The marks of the loops with a region of their own around what is being compiled, outermost
   ;; first; and the `var`s given a value from inside one, which hold a region for it.
   (loop-marks (ArrayList (slice u8)))
   (escaped (ArrayList (slice u8)))
   (mods (ArrayList Mod))
   (self (slice u8))
   (table (ArrayList Alias))  ; module name -> file, from the manifest
   (base (slice u8))  ; the manifest's directory
   (depends (ArrayList (slice u8)))
   (src (slice u8))
   (path (slice u8))
   (locals (ArrayList Local))
   (counter i64)
   (in-with i64)
   (returned bool)
   (ret (slice u8))
   (aux (ArrayList Code))
   (in-fn bool)  ; compiling a function body, which finds its task state once
   (task-used bool)
   (in-on bool)  ; compiling an `on` block of an attribute grammar
   (eq-slots (ArrayList EqSlot))  ; where its equations for children put their values
   (ovr-slots (ArrayList OvrSlot))
   (givens (ArrayList Given))
   (outs (ArrayList Out))  ; in a rewrite, the names whose rewritten form `.out` reads
   (sames (ArrayList (slice u8)))  ; the types `same-code` has made a comparison of, in this module
   (quiet i64)  ; inside a read of part of a setting, which notes that part and not the whole
   (attrs-from (slice u8))  ; the attribute grammar whose blocks are being read; "" for this one
   ;; The functions some strategy of the program's pipeline keeps, and those a stage makes, as
   ;; `module/function` (see `read-keeps!`): each one's place in `keeps` is its number, by which a
   ;; run's strategy turns it on; `default-keeps`, those the default strategy keeps. And what reads
   ;; what, to know what a setting given again changes.
   (keeps (ArrayList (slice u8)))
   (default-keeps (ArrayList (slice u8)))
   (made (ArrayList (slice u8)))
   ;; The functions some strategy has work apart (`apart` in the pipeline language), as
   ;; `module/function`: each one's place is its number, by which a run's strategy turns it on.
   (aparts (ArrayList (slice u8)))
   ;; Those whose answers last when another computation apart asks (`apart lasting`).
   (lastings (ArrayList (slice u8)))
   ;; Foreign functions that change their first argument in place, as `module/function`, and the
   ;; calls of the module's functions that say what may change (`changes` in a foreign block).
   (mutators (ArrayList Mutator))
   ;; Each kept function's functions for how strategies keep it (`… by F`).
   (hooks (ArrayList Hooks))
   ;; Modules read only for the signatures of those functions: not imported, since a strategy's
   ;; functions may read the module whose code they serve (see `rt/hook-cell`).
   (sig-only (ArrayList (slice u8)))
   ;; The sizes the program's pipeline gives, as `module/name` (see `with-sizes`).
   (sizes (ArrayList pl/Size))
   (staged (ArrayList (slice u8)))  ; every stage's own functions
   ;; The program's pipeline's stages, in order (see "a stage's work").
   (stages (ArrayList pl/Stage))
   (checker pl/Checker)])

;;; A name a rewrite's pattern binds to a child, or to its node, and that one's rewritten form.
(defstruct Out [(sym (slice u8)) (code Code)])

;;; A `given` attribute and the value a child has when its parent's equations give it none.
(defstruct Given [(attr (slice u8)) (default Code)])

;;; An equation `child.attr = value` of an `on` block: the value waits in `sym` until the child
;;; is visited. `target` is a child the pattern names, or `kids` for all of them.
(defstruct EqSlot
  [(target (slice u8)) (attr (slice u8)) (sym (slice u8)) (ty (slice u8))])

;;; A collected attribute some `on` block gives a node's whole value, `c = value`: what the
;;; node's subtree added is taken back, and the value added instead. `mark` is how far the
;;; collection had got when the node was reached.
(defstruct OvrSlot
  [(attr (slice u8)) (sym (slice u8)) (ty (slice u8)) (mark (slice u8))])  ; top-level forms expressions need, such as a parallel map's job

;;; A compiled expression.
(defstruct TE [(code Code) (ty (slice u8))])

(defn te [(code Code) (ty (slice u8))] (-> TE)
  (TE :code code :ty ty))

(defn kid [(n g/Node) (i i64)] (-> g/Node)
  (get (.kids n) i))

(defn list-kids [(n g/Node)] (-> (ArrayList g/Node))
  (.kids n))

(defn none? [(n g/Node)] (-> bool)
  (= (.kind n) (g/KNone)))

(defn text-list [] (-> (ArrayList (slice u8)))
  (ArrayList::new [(slice u8)] (malloc-allocator)))

(defn sym [(s (slice u8))] (-> Code)
  (primitive/code-symbol s))

(defn cat [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (rt/join a b))

(defn cat3 [(a (slice u8)) (b (slice u8)) (c (slice u8))] (-> (slice u8))
  (rt/join (rt/join a b) c))

(defn cat4 [(a (slice u8)) (b (slice u8)) (c (slice u8)) (d (slice u8))]
  (-> (slice u8))
  (rt/join (cat3 a b c) d))

(defn die [(k (mut Comp)) (n g/Node) (msg (slice u8))] (-> never)
  (let [at (rt/line-col (.src k) (.lo n))]
    (dsl/fail-at (.path k) (.line at) (.col at) msg)))

(defn fresh [(k (mut Comp)) (base (slice u8))] (-> (slice u8))
  (set! (.counter k) (+ (.counter k) 1))
  (cat3 base "-" (rt/num-text (.counter k))))

;; ---------------------------------------------------------------- types, as text
;; Int Bool Text Void Never [T] T? {K:V} Fn(A,B)->R, or module.Type: a type is its own
;; canonical name, so equality is text equality.

(defn opt? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t (- (len t) 1)) #\?) (not (rt/at? t 0 "Fn("))))

(defn list? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t 0) #\[) (not (opt? t))))

(defn map? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t 0) #\{) (not (opt? t))))

(defn fn? [(t (slice u8))] (-> bool)
  (rt/at? t 0 "Fn("))

;;; `T?`; an optional function is `(Fn(A)->R)?`, since `Fn(A)->R?` returns an option.
(defn opt-type [(t (slice u8))] (-> (slice u8))
  (if (fn? t) (cat3 "(" t ")?") (cat t "?")))

(defn opt-of [(t (slice u8))] (-> (slice u8))
  (if (rt/at? t 0 "(Fn(")
      (subslice t 1 (- (len t) 2))
      (subslice t 0 (- (len t) 1))))

(defn elem-of [(t (slice u8))] (-> (slice u8))
  (subslice t 1 (- (len t) 1)))

;;; Position of a top-level `c` in a type, past `from`.
(defn top-level-at [(t (slice u8)) (from i64) (c u8)] (-> i64)
  (let [(mut depth) 0
        (mut out) -1
        (mut i) from]
    (while (and (< out 0) (< i (len t)))
      (let [x (get t i)]
        (cond (and (= x c) (= depth 0)) (set! out i)
              (or (= x #\[) (= x #\{) (= x #\()) (set! depth (+ depth 1))
              (or (= x #\]) (= x #\}) (= x #\))) (set! depth (- depth 1))
              :else 0))
      (set! i (+ i 1)))
    out))

(defn map-key [(t (slice u8))] (-> (slice u8))
  (subslice t 1 (top-level-at t 1 #\:)))

(defn map-val [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (top-level-at t 1 #\:) 1) (- (len t) 1)))

(defn fn-params [(t (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (text-list)
        close (top-level-at t 3 #\))
        (mut from) 3
        (mut go) (> close 3)]
    (while go
      (let [next (top-level-at t from #\,)]
        (if (and (>= next 0) (< next close))
            (do (push! (mut out) (subslice t from next)) (set! from (+ next 1)))
            (do (push! (mut out) (subslice t from close)) (set! go false)))))
    out))

(defn fn-ret [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (top-level-at t 3 #\)) 3) (len t)))

(defn builtin-type? [(t (slice u8))] (-> bool)
  (or (= t "Int") (= t "Bool") (= t "Text") (= t "Void") (= t "Never")))

;;; The dot before a named type's own name.
(defn last-dot [(t (slice u8))] (-> i64)
  (let [(mut cut) -1]
    (for i (range 0 (len t)) (when (= (get t i) #\.) (set! cut i)))
    cut))

(defn type-module [(t (slice u8))] (-> (slice u8))
  (subslice t 0 (last-dot t)))

(defn type-name [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (last-dot t) 1) (len t)))

(defn alias-of [(module (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (for c module (push! (mut (.bytes b)) (if (= c #\.) #\- c)))
    (finish! (mut b))))

(defn qualified [(k (mut Comp)) (module (slice u8)) (name (slice u8))]
  (-> (slice u8))
  (if (= module (.self k)) name (cat3 (alias-of module) "/" name)))

(defn coil-type [(k (mut Comp)) (t (slice u8))] (-> Code)
  (cond (= t "Int") `i64
        (= t "Bool") `bool
        (= t "Text") `(slice u8)
        (= t "Void") `void
        (= t "Never") `never
        (opt? t) `(Option ~(coil-type (mut k) (opt-of t)))
        (list? t) `(ArrayList ~(coil-type (mut k) (elem-of t)))
        (map? t)
          `(HashMap ~(coil-type (mut k) (map-key t))
                    ~(coil-type (mut k) (map-val t)))
        (fn? t)
          (let [(mut ps) (primitive/code-list-new)]
            (for p (fn-params t) (push! (mut ps) (coil-type (mut k) p)))
            `(fnptr (cc/C) [~@ps] ~(coil-type (mut k) (fn-ret t))))
        :else
          (let [native (sym (qualified (mut k) (type-module t) (type-name t)))]
            (if (boxed-record? (mut k) t) `(ptr ~native) native))))

;;; Representation is a source-level declaration, independent of any client's types.
(defn boxed-record? [(k (mut Comp)) (t (slice u8))] (-> bool)
  (if (< (mod-index (mut k) (type-module t)) 0)
      false
      (match (find-rec (mod-at (mut k) (type-module t)) (type-name t))
        (Some [r] (.boxed r))
        (None [] false))))

;;; An enclosing value must not expose a child's pointer representation in equality.
(defn has-boxed-value? [(k (mut Comp)) (t (slice u8))] (-> bool)
  (cond (list? t) (has-boxed-value? (mut k) (elem-of t))
        (opt? t) (has-boxed-value? (mut k) (opt-of t))
        (map? t) (or (has-boxed-value? (mut k) (map-key t)) (has-boxed-value? (mut k) (map-val t)))
        (fn? t) false
        (< (mod-index (mut k) (type-module t)) 0) false
        :else
          (match (find-rec (mod-at (mut k) (type-module t)) (type-name t))
            (Some [r]
                  (or (.boxed r)
                      (let [(mut found) false]
                        (for f (.fields r)
                          (when (has-boxed-value? (mut k) (.ty f)) (set! found true)))
                        found)))
            (None [] false))))

(defn record-value [(k (mut Comp)) (t (slice u8)) (value Code)] (-> Code)
  (if (boxed-record? (mut k) t)
      `(box! (rt/value-allocator) ~(sym (qualified (mut k) (type-module t) (type-name t))) ~value)
      value))

(defn record-copy [(k (mut Comp)) (t (slice u8)) (value Code)] (-> Code)
  (if (boxed-record? (mut k) t)
      (record-value (mut k) t `(load (: ~value ~(coil-type (mut k) t))))
      value))

;; ---------------------------------------------------------------- finding things

(defn mod-index [(k (mut Comp)) (name (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len (.mods k)))
      (when (= (.name (get (.mods k) i)) name) (set! out i)))
    out))

(defn mod-at [(k (mut Comp)) (name (slice u8))] (-> Mod)
  (let [i (mod-index (mut k) name)]
    (when (< i 0) (panic "rules: module {} was not loaded" name))
    (get (.mods k) i)))

(defn self-mod [(k (mut Comp))] (-> Mod)
  (mod-at (mut k) (.self k)))

(defn alias-target [(m Mod) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for a (.aliases m) (when (= (.name a) name) (set! out (Some (.module a)))))
    out))

(defn find-func [(m Mod) (name (slice u8))] (-> (Option Func))
  (let [(mut out) (None [Func])]
    (for f (.funcs m) (when (= (.name f) name) (set! out (Some f))))
    out))

(defn find-rec [(m Mod) (name (slice u8))] (-> (Option RecDef))
  (let [(mut out) (None [RecDef])]
    (for r (.recs m) (when (= (.name r) name) (set! out (Some r))))
    out))

(defn find-enum-of [(m Mod) (variant (slice u8))] (-> (Option EnumDef))
  (let [(mut out) (None [EnumDef])]
    (for e (.enums m)
      (for v (.variants e) (when (= v variant) (set! out (Some e)))))
    out))

(defn find-global [(m Mod) (name (slice u8))] (-> (Option Global))
  (let [(mut out) (None [Global])]
    (for x (.globals m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-kind [(m Mod) (name (slice u8))] (-> (Option syntax/KindEntry))
  (let [(mut out) (None [syntax/KindEntry])]
    (for x (.kinds m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-rel [(m Mod) (name (slice u8))] (-> (Option RelDef))
  (let [(mut out) (None [RelDef])]
    (for x (.rels m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-enum-named [(m Mod) (name (slice u8))] (-> (Option EnumDef))
  (let [(mut out) (None [EnumDef])]
    (for e (.enums m) (when (= (.name e) name) (set! out (Some e))))
    out))

(defn has-type? [(m Mod) (name (slice u8))] (-> bool)
  (or (match (find-rec m name) (Some [_] true) (None [] false))
      (match (find-enum-named m name) (Some [_] true) (None [] false))
      (let [(mut hit) false]
        (for t (.types m) (when (= t name) (set! hit true)))
        hit)))

;;; A type written in module `m`'s file.
(defn resolve-type [(k (mut Comp)) (m (slice u8)) (n g/Node)] (-> (slice u8))
  (let [mo (mod-at (mut k) m)]
    (match (.kind n)
      (g/KUpper []
                (let [name (.text n)]
                  (cond (builtin-type? name) name
                        (has-type? mo name) (cat3 m "." name)
                        (and (> (len (.over mo)) 0)
                             (has-type? (mod-at (mut k) (.over mo)) name))
                          (cat3 (.over mo) "." name)
                        (has-type? (mod-at (mut k) "hl.rt") name)
                          (cat "hl.rt." name)
                        :else (die (mut k) n (cat "no type named " name)))))
      (g/KTQual []
                (match (alias-target mo (.text (kid n 0)))
                  (None []
                        (die (mut k)
                             n
                             (cat "no module imported as " (.text (kid n 0)))))
                  (Some [target]
                        (let [name (.text (kid n 1))]
                          (unless (has-type? (mod-at (mut k) target) name)
                            (die (mut k)
                                 n
                                 (cat4 target " has no type named " name "")))
                          (cat3 target "." name)))))
      (g/KTOpt [] (opt-type (resolve-type (mut k) m (kid n 0))))
      (g/KTList [] (cat3 "[" (resolve-type (mut k) m (kid n 0)) "]"))
      (g/KTMap []
               (cat4 "{"
                     (resolve-type (mut k) m (kid n 0))
                     ":"
                     (cat (resolve-type (mut k) m (kid n 1)) "}")))
      (g/KTFn []
              (let [(mut b) (str/StrBuf::new (malloc-allocator))
                    (mut first) true]
                (push-str! (mut b) "Fn(")
                (for p (list-kids (kid n 0))
                  (unless first (push-str! (mut b) ","))
                  (set! first false)
                  (push-str! (mut b) (resolve-type (mut k) m p)))
                (push-str! (mut b) ")->")
                (push-str! (mut b) (resolve-type (mut k) m (kid n 1)))
                (finish! (mut b))))
      (g/KTMut [] (resolve-type (mut k) m (kid n 0)))
      (_ (die (mut k) n "expected a type")))))

;; ---------------------------------------------------------------- reading signatures

(defn mod-new [(name (slice u8)) (sort Sort) (over (slice u8))] (-> Mod)
  (Mod
    :name name
    :sort sort
    :funcs (ArrayList::new [Func] (malloc-allocator))
    :recs (ArrayList::new [RecDef] (malloc-allocator))
    :enums (ArrayList::new [EnumDef] (malloc-allocator))
    :globals (ArrayList::new [Global] (malloc-allocator))
    :types (text-list)
    :kinds (ArrayList::new [syntax/KindEntry] (malloc-allocator))
    :rels (ArrayList::new [RelDef] (malloc-allocator))
    :quotes (ArrayList::new [QuoteDef] (malloc-allocator))
    :aliases (ArrayList::new [Alias] (malloc-allocator))
    :over over
    :memos (text-list)))

(defn func-of [(name (slice u8)) (ret (slice u8))] (-> Func)
  (Func
    :name name
    :coil name
    :params (ArrayList::new [Param] (malloc-allocator))
    :ret ret))

(defn param [(f (mut Func)) (name (slice u8)) (ty (slice u8)) (by-ref bool)]
  (-> void)
  (push! (mut (.params f))
         (Param
           :name name
           :ty ty
           :by-ref by-ref)))

(defn parse-file [(k (mut Comp)) (src (slice u8)) (path (slice u8))] (-> g/Node)
  (match (g/parse-result src path 0)
    ;; Kept first: a kept function is a memo, which a caller asks, never split into a twin that adds
    ;; its answer to the caller's list (`with-accumulators`), which would go round the memo.
    (Ok [t]
        (with-accumulators (with-keeps (mut k)
                                       (with-sizes (mut k) (with-everywhere src path t) src path)
                                       src
                                       path)))
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

;; ---------------------------------------------------------------- sizes

;;; How big a unit of work is is no part of the code that cuts the work: the rules declare a
;;; constant with no value, `const piece-bytes: Int`, and the program's pipeline gives the number,
;;; `size bundle.modules/piece-bytes 8192`. A module's tree with each such constant given its
;;; number: a constant like any other from here on. One the pipeline gives no number, and a
;;; number for a constant the module does not declare so, are errors.
(defn with-sizes [(k (mut Comp)) (tree g/Node) (src (slice u8)) (path (slice u8))] (-> g/Node)
  (if (and (!= (.kind tree) (g/KFile)) (!= (.kind tree) (g/KAttrsFile)))
      tree
      (let [module (.text (kid tree 0))
            prefix (cat module "/")
            (mut found) (text-list)
            (mut decls) (ArrayList::new [g/Node] (malloc-allocator))]
        (for d (list-kids (kid tree 2))
          (if (= (.kind d) (g/KSized))
              (let [name (.text (kid d 0))
                    full (cat prefix name)
                    (mut value) ""]
                (for s (.sizes k) (when (= (.name s) full) (set! value (.value s))))
                (when (= (len value) 0)
                  (let [at (rt/line-col src (.lo d))]
                    (dsl/fail-at path
                                 (.line at)
                                 (.col at)
                                 (cat3 "the constant "
                                       name
                                       (cat3 " has no value: the program's pipeline gives it, `size "
                                             full
                                             " N`")))))
                (push! (mut found) name)
                (let [(mut kids) (g/new-kids)]
                  (push! (mut kids) (kid d 0))
                  (push! (mut kids) (kid d 1))
                  (push! (mut kids) (g/leaf (g/KInt) value (.lo d) (.lo d)))
                  (push! (mut decls) (g/mk (g/KConst) kids (.lo d) (.hi d)))))
              (push! (mut decls) d)))
        (for s (.sizes k)
          (when (and (rt/starts-with (.name s) prefix)
                     (not (has-text? found (subslice (.name s) (len prefix) (len (.name s))))))
            (dsl/fail-at path
                         1
                         1
                         (cat3 "a pipeline gives the size "
                               (.name s)
                               (cat3 ", which "
                                     module
                                     " does not declare as a constant with no value")))))
        (let [(mut out) tree
              (mut list) (kid tree 2)]
          (set! (.kids list) decls)
          (set! (mut (.kids out)) 2 list)
          out))))

;; ---------------------------------------------------------------- what is kept

;;; What a build keeps is no part of the code that does the work: a pipeline says it, by function
;;; (`keep bundle.modules/loaded …`), and every function it names is compiled as one whose answers
;;; are kept by their arguments (see `compile-memo!`), as `memo fn` would be. Every `.pipeline` file
;;; of the program's manifest says what it keeps, and a module is compiled again when one changes.
(defn read-keeps! [(k (mut Comp))] (-> void)
  (let [(mut seen) false]
    (for a (.table k)
      (when (rt/ends-with (.module a) ".pipeline")
        (let [path (cat3 (.base k) "/" (.module a))
              src (rt/read-all path)
              tree (pipeline-tree path)
              made (pl/made-of tree)
              all (pl/strategies-of src path tree made)]
          (push! (mut (.depends k)) path)
          (when (> (len (.decls all)) 0)
            (when seen
              (dsl/fail-at path
                           1
                           1
                           "a second pipeline with strategies: one program has one numbering of what it keeps"))
            (set! seen true)
            (set! (.keeps k) (.kept all))
            (set! (.aparts k) (.apart all))
            (set! (.lastings k) (.lasting all))
            (set! (.default-keeps k)
                  (pl/strategy-keeps all (.default all) made))
            (for x (.kept all)
              (for role (range 0 5)
                (let [hooks (pl/hooks-of all made x role)]
                  (when (> (len hooks) 0)
                    (push! (mut (.hooks k))
                           (Hooks
                             :key x
                             :role role
                             :fns hooks)))))))
          (for m made (push! (mut (.made k)) m))
          (for s (pl/sizes-of tree) (push! (mut (.sizes k)) s))
          (let [stages (pl/stages-of tree)]
            (when (> (len stages) 0)
              (when (> (len (.stages k)) 0)
                (dsl/fail-at path
                             1
                             1
                             "a second pipeline with stages: one program has one numbering of its stages"))
              (set! (.stages k) stages))
            (for s stages
              (for f (.functions s) (push! (mut (.staged k)) f))
              (for f (.also s) (push! (mut (.staged k)) f))))
          (for m made
            (unless (has-text? (.keeps k) m)
              (push! (mut (.keeps k)) m)
              (push! (mut (.default-keeps k)) m)))))))
  0)

;;; A kept function's number, and whether the default strategy keeps it; -1 for a `memo fn` the
;;; source declares, which is always kept.
(defn kept-number [(k (mut Comp)) (name (slice u8))] (-> i64)
  (let [(mut at) -1
        full (cat3 (.self k) "/" name)]
    (for i (range 0 (len (.keeps k)))
      (when (= (get (.keeps k) i) full) (set! at i)))
    at))

;;; A module's tree with each function a pipeline keeps a kept one. A kept name it has no function of
;;; is an error.
(defn with-keeps [(k (mut Comp))
                  (tree g/Node)
                  (src (slice u8))
                  (path (slice u8))] (-> g/Node)
  (if (or (and (!= (.kind tree) (g/KFile)) (!= (.kind tree) (g/KAttrsFile)))
          (= (len (.keeps k)) 0))
      tree
      (let [module (.text (kid tree 0))
            prefix (cat module "/")
            (mut found) (text-list)
            (mut decls) (ArrayList::new [g/Node] (malloc-allocator))]
        (for d (list-kids (kid tree 2))
          (if (and (= (.kind d) (g/KFn))
                   (has-text? (.keeps k) (cat prefix (.text (kid d 0)))))
              (let [(mut kept) d]
                (set! (.kind kept) (g/KMemoFn))
                (push! (mut found) (.text (kid d 0)))
                (push! (mut decls) kept))
              (push! (mut decls) d)))
        (for name (.keeps k)
          (when (and (rt/starts-with name prefix)
                     (not (has-text? found
                                     (subslice name (len prefix) (len name)))))
            (dsl/fail-at path
                         1
                         1
                         (cat3 "a pipeline keeps "
                               name
                               (cat ", which is no function of " module)))))
        (let [(mut out) tree
              (mut list) (kid tree 2)]
          (set! (.kids list) decls)
          (set! (mut (.kids out)) 2 list)
          out))))

;; ---------------------------------------------------------------- everywhere functions

;;; `everywhere fn f(n: Node, …) -> Node = match n { cases }`: a function over a whole tree, whose
;;; cases say only where it does something. Anywhere else it is `f` of each child: the node rebuilt
;;; from them, shared when none changed; for `-> Void`, each child visited; for `-> Bool`, whether
;;; any child's is true; for a list, the children's lists one after another. Read as the plain function with that last case, which is what everything
;;; after the parse sees.
(defn with-everywhere [(src (slice u8)) (path (slice u8)) (tree g/Node)]
  (-> g/Node)
  (let [decls (kid tree 2)
        (mut any) false]
    (for d (.kids decls) (when (= (.kind d) (g/KEverywhereFn)) (set! any true)))
    (if (not any)
        tree
        (let [(mut out) (g/new-kids)]
          (for d (.kids decls)
            (cond (not (= (.kind d) (g/KEverywhereFn))) (push! (mut out) d)
                  (= (.kind (kid d 2)) (g/KTList))
                    (for f (everywhere-list-fns src path d) (push! (mut out) f))
                  :else (push! (mut out) (everywhere-fn src path d))))
          (let [(mut t) tree
                (mut kids) (g/new-kids)]
            (push! (mut kids) (kid tree 0))
            (push! (mut kids) (kid tree 1))
            (push! (mut kids) (g/mk (g/KList) out (.lo decls) (.hi decls)))
            (set! (.kids t) kids)
            t)))))

(defn sugar-fail [(src (slice u8))
                  (path (slice u8))
                  (n g/Node)
                  (msg (slice u8))] (-> never)
  (dsl/fail-at path (rt/line-of src (.lo n)) (rt/col-of src (.lo n)) msg))

(defn name-node [(text (slice u8)) (at g/Node)] (-> g/Node)
  (g/leaf (g/KName) text (.lo at) (.lo at)))

(defn list-node [(xs (ArrayList g/Node)) (at g/Node)] (-> g/Node)
  (g/mk (g/KList) xs (.lo at) (.hi at)))

(defn one [(x g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)] (push! (mut out) x) out))

(defn three [(a g/Node) (b g/Node) (c g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)]
    (push! (mut out) a)
    (push! (mut out) b)
    (push! (mut out) c)
    out))

;;; The child, then the function's other parameters as they were given.
(defn passed-on [(each (slice u8)) (params (ArrayList g/Node)) (at g/Node)]
  (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)]
    (push! (mut out) (name-node each at))
    (for i (range 1 (len params))
      (push! (mut out) (name-node (.text (kid (get params i) 0)) at)))
    out))

(defn everywhere-fn [(src (slice u8)) (path (slice u8)) (d g/Node)] (-> g/Node)
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)]
    (when (= (len params) 0)
      (sugar-fail src path d "an everywhere function takes the node first"))
    (let [node (.text (kid (get params 0) 0))]
      (unless (and (= (.kind body) (g/KMatch))
                   (= (.kind (kid body 0)) (g/KName))
                   (= (.text (kid body 0)) node))
        (sugar-fail src
                    path
                    body
                    (cat3 "an everywhere function is a match on its node, "
                          node
                          "")))
      (for arm (.kids (kid body 1))
        (let [p (kid arm 0)]
          (when (and (= (.kind p) (g/KName))
                     (= (.text p) "_")
                     (= (.kind (kid arm 1)) (g/KNone)))
            (sugar-fail src
                        path
                        arm
                        "an everywhere function's last case is its children, so it has no `_` of its own"))))
      (let [each "each-kid"
            call
              (g/node2 (g/KCall)
                       (name-node (.text fname) body)
                       (list-node (passed-on each params body) body))
            kids-of
              (g/node2 (g/KFieldE)
                       (name-node node body)
                       (name-node "kids" body))
            head (g/node2 (g/KInHead) (name-node each body) kids-of)
            void
              (or (= (.kind ret) (g/KNone))
                  (and (= (.kind ret) (g/KUpper)) (= (.text ret) "Void")))
            bool (and (= (.kind ret) (g/KUpper)) (= (.text ret) "Bool"))
            walk
              (cond void
                      (g/node2 (g/KFor)
                               head
                               (g/mk (g/KBlock)
                                     (one (list-node (one call) body))
                                     (.lo body)
                                     (.hi body)))
                    bool
                      (g/mk (g/KAny)
                            (three head (list-node (g/new-kids) body) call)
                            (.lo body)
                            (.hi body))
                    :else
                      (let [(mut ck) (g/new-kids)]
                        (push! (mut ck) call)
                        (push! (mut ck) (list-node (one head) body))
                        (g/node2 (g/KWithE)
                                 (name-node node body)
                                 (list-node (one (g/node2 (g/KFieldInit)
                                                          (name-node "kids"
                                                                     body)
                                                          (g/mk (g/KComp)
                                                                ck
                                                                (.lo body)
                                                                (.hi body))))
                                            body))))
            (mut arms) (g/new-kids)]
        (for a (.kids (kid body 1)) (push! (mut arms) a))
        (push! (mut arms)
               (g/mk (g/KArm)
                     (three (name-node "_" body) (g/none-node) walk)
                     (.lo body)
                     (.hi body)))
        (let [(mut fn-kids) (g/new-kids)]
          (push! (mut fn-kids) fname)
          (push! (mut fn-kids) (kid d 1))
          (push! (mut fn-kids) ret)
          (push! (mut fn-kids)
                 (g/node2 (g/KMatch) (kid body 0) (list-node arms (kid body 1))))
          (g/mk (g/KFn) fn-kids (.lo d) (.hi d)))))))

;;; The cases' checks: a match on the node, with no `_` of its own.
(defn everywhere-check [(src (slice u8)) (path (slice u8)) (d g/Node)] (-> void)
  (let [params (.kids (kid d 1))
        body (kid d 3)]
    (when (= (len params) 0)
      (sugar-fail src path d "an everywhere function takes the node first"))
    (let [node (.text (kid (get params 0) 0))]
      (unless (and (= (.kind body) (g/KMatch))
                   (= (.kind (kid body 0)) (g/KName))
                   (= (.text (kid body 0)) node))
        (sugar-fail src
                    path
                    body
                    (cat3 "an everywhere function is a match on its node, "
                          node
                          "")))
      (for arm (.kids (kid body 1))
        (let [p (kid arm 0)]
          (when (and (= (.kind p) (g/KName))
                     (= (.text p) "_")
                     (= (.kind (kid arm 1)) (g/KNone)))
            (sugar-fail src
                        path
                        arm
                        "an everywhere function's last case is its children, so it has no `_` of its own")))))))

;;; `everywhere fn f(n: Node, …) -> [T]`: each case's list, and elsewhere the children's in order.
;;; It is two functions: `f-into!`, which adds to one list it is handed, so a walk makes one list
;;; and not one per node, and `f`, which hands it an empty one.
(defn everywhere-list-fns [(src (slice u8)) (path (slice u8)) (d g/Node)]
  (-> (ArrayList g/Node))
  (everywhere-check src path d)
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)
        node (.text (kid (get params 0) 0))
        into (cat (.text fname) "-into!")
        acc "everywhere-out"
        each "each-kid"
        acc-type (g/mk (g/KTMut) (one ret) (.lo ret) (.hi ret))
        (mut into-params) (g/new-kids)
        (mut into-args) (passed-on each params body)
        (mut wrap-args) (passed-on node params body)
        (mut arms) (g/new-kids)]
    (for p params (push! (mut into-params) p))
    (push! (mut into-params) (g/node2 (g/KParam) (name-node acc body) acc-type))
    (push! (mut into-args) (name-node acc body))
    (push! (mut wrap-args) (name-node acc body))
    (for a (.kids (kid body 1))
      (push! (mut arms)
             (g/mk (g/KArm)
                   (three (kid a 0)
                          (kid a 1)
                          (g/node2 (g/KExtend) (name-node acc a) (kid a 2)))
                   (.lo a)
                   (.hi a))))
    (let [call
            (g/node2 (g/KCall) (name-node into body) (list-node into-args body))
          kids-of
            (g/node2 (g/KFieldE) (name-node node body) (name-node "kids" body))
          head (g/node2 (g/KInHead) (name-node each body) kids-of)
          walk
            (g/node2 (g/KFor)
                     head
                     (g/mk (g/KBlock)
                           (one (list-node (one call) body))
                           (.lo body)
                           (.hi body)))
          (mut into-kids) (g/new-kids)
          (mut wrap-kids) (g/new-kids)
          (mut stmts) (g/new-kids)
          (mut out) (g/new-kids)]
      (push! (mut arms)
             (g/mk (g/KArm)
                   (three (name-node "_" body) (g/none-node) walk)
                   (.lo body)
                   (.hi body)))
      (push! (mut into-kids) (name-node into fname))
      (push! (mut into-kids) (list-node into-params (kid d 1)))
      (push! (mut into-kids) (g/none-node))
      (push! (mut into-kids)
             (g/node2 (g/KMatch) (kid body 0) (list-node arms (kid body 1))))
      (push! (mut out) (g/mk (g/KFn) into-kids (.lo d) (.hi d)))
      (push! (mut stmts)
             (g/mk (g/KVar)
                   (three (name-node acc body)
                          ret
                          (g/mk (g/KListLit)
                                (one (list-node (g/new-kids) body))
                                (.lo body)
                                (.lo body)))
                   (.lo body)
                   (.hi body)))
      (push! (mut stmts)
             (g/node2 (g/KCall)
                      (name-node into body)
                      (list-node wrap-args body)))
      (push! (mut stmts) (name-node acc body))
      (push! (mut wrap-kids) fname)
      (push! (mut wrap-kids) (kid d 1))
      (push! (mut wrap-kids) ret)
      (push! (mut wrap-kids)
             (g/mk (g/KBlock)
                   (one (list-node stmts body))
                   (.lo body)
                   (.hi body)))
      (push! (mut out) (g/mk (g/KFn) wrap-kids (.lo d) (.hi d)))
      out)))

;;; A function that gives a list partly made of what it gives itself, `fn f(…) -> [T]` calling `f`, is
;;; two functions, as a list-giving everywhere function is: `f-into!`, adding its answer to a list it
;;; is handed, which its own calls add to as well, and `f`, handing it an empty one. A recursion
;;; then makes one list, not one per call copied into the next. So is one whose list a caller adds
;;; to its own (spread, after `++`, or by `++=`), or that a function with a twin answers with: its
;;; list goes straight into the caller's. Only one with no `return` and an answer at its end.
(defn with-accumulators [(tree g/Node)] (-> g/Node)
  (let [decls (kid tree 2)
        twinned (twinned-names (.kids decls))
        (mut out) (g/new-kids)
        (mut any) false]
    (for d (.kids decls)
      (if (and (accumulates? d) (has-name? twinned (.text (kid d 0))))
          (do
            (set! any true)
            (for f (accumulator-fns d) (push! (mut out) f)))
          (push! (mut out) d)))
    (if (not any)
        tree
        (let [(mut t) tree
              (mut kids) (g/new-kids)]
          (push! (mut kids) (kid tree 0))
          (push! (mut kids) (kid tree 1))
          (push! (mut kids) (g/mk (g/KList) out (.lo decls) (.hi decls)))
          (set! (.kids t) kids)
          t))))

(defn calls-named? [(n g/Node) (name (slice u8))] (-> bool)
  (or (and (= (.kind n) (g/KCall))
           (= (.kind (kid n 0)) (g/KName))
           (= (.text (kid n 0)) name))
      (let [(mut hit) false]
        (for c (.kids n)
          (when (and (not hit) (calls-named? c name)) (set! hit true)))
        hit)))

(defn has-kind? [(n g/Node) (kind g/Kind)] (-> bool)
  (or (= (.kind n) kind)
      (let [(mut hit) false]
        (for c (.kids n)
          (when (and (not hit) (has-kind? c kind)) (set! hit true)))
        hit)))

;;; What a function answers with: its body, or its block's last statement when that is an expression.
(defn answer-of [(body g/Node)] (-> (Option g/Node))
  (if (= (.kind body) (g/KBlock))
      (let [stmts (.kids (kid body 0))]
        (if (= (len stmts) 0)
            (None [g/Node])
            (let [last (get stmts (- (len stmts) 1))
                  kd (.kind last)]
              (if (or (= kd (g/KLet))
                      (= kd (g/KVar))
                      (= kd (g/KFor))
                      (= kd (g/KWhile))
                      (= kd (g/KAssign))
                      (= kd (g/KAppend))
                      (= kd (g/KExtend))
                      (= kd (g/KWithCtx))
                      (= kd (g/KPrint))
                      (= kd (g/KAssert)))
                  (None [g/Node])
                  (Some last)))))
      (Some body)))

(defn accumulates? [(d g/Node)] (-> bool)
  (and (= (.kind d) (g/KFn))
       (= (.kind (kid d 2)) (g/KTList))
       (> (len (.kids (kid d 1))) 0)
       (not (any-mut-param? (.kids (kid d 1))))
       (not (has-kind? (kid d 3) (g/KReturn)))
       (match (answer-of (kid d 3))
         (Some [a]
               (or (calls-named? (kid d 3) (.text (kid d 0))) (builds-list? a)))
         (None [] false))))

(defn has-name? [(names (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x names (when (= x name) (set! hit true)))
    hit))

(defn add-name! [(names (mut (ArrayList (slice u8)))) (name (slice u8))]
  (-> void)
  (unless (has-name? names name) (push! (mut names) name))
  0)

;;; The functions of a module that get twins: those that call themselves, those whose lists a caller
;;; adds to its own, and then those a function with a twin answers with, until there are no more.
(defn twinned-names [(decls (ArrayList g/Node))] (-> (ArrayList (slice u8)))
  (let [(mut wanted) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut changed) true]
    (for d decls (spread-calls! d (mut wanted)))
    (for d decls
      (when (and (accumulates? d)
                 (or (calls-named? (kid d 3) (.text (kid d 0)))
                     (has-name? wanted (.text (kid d 0)))))
        (add-name! (mut out) (.text (kid d 0)))))
    (while changed
      (set! changed false)
      (for d decls
        (when (and (accumulates? d) (has-name? out (.text (kid d 0))))
          (match (answer-of (kid d 3))
            (Some [a]
                  (let [(mut called)
                          (ArrayList::new [(slice u8)] (malloc-allocator))]
                    (answer-calls! a (mut called))
                    (for d2 decls
                      (when (and (has-name? called (.text (kid d2 0)))
                                 (not (has-name? out (.text (kid d2 0))))
                                 (accumulates? d2))
                        (add-name! (mut out) (.text (kid d2 0)))
                        (set! changed true)))))
            (None [] 0)))))
    out))

;;; Calls whose lists are added to another: spread, after or before `++`, or by `++=`.
(defn spread-calls! [(n g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind n)
    (g/KSpread [] (note-call! (kid n 0) (mut out)))
    (g/KCompSpread [] (note-call! (kid n 0) (mut out)))
    (g/KConcat []
               (do
                 (note-call! (kid n 0) (mut out))
                 (note-call! (kid n 1) (mut out))))
    (g/KExtend [] (note-call! (kid n 1) (mut out)))
    (_ 0))
  (for c (.kids n) (spread-calls! c (mut out)))
  0)

(defn note-call! [(e g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (cond (= (.kind e) (g/KGroup)) (note-call! (kid e 0) (mut out))
        (and (= (.kind e) (g/KCall)) (= (.kind (kid e 0)) (g/KName)))
          (add-name! (mut out) (.text (kid e 0)))
        :else 0))

;;; The calls an answer gives its list from, which a twin hands its list on to.
(defn answer-calls! [(e g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind e)
    (g/KCall [] (note-call! e (mut out)))
    (g/KConcat []
               (do
                 (answer-calls! (kid e 0) (mut out))
                 (answer-calls! (kid e 1) (mut out))))
    (g/KCompSpread [] (note-call! (kid e 0) (mut out)))
    (g/KMatch []
              (for a (list-kids (kid e 1)) (answer-calls! (kid a 2) (mut out))))
    (g/KMatchN []
               (for a (list-kids (kid e 2)) (answer-calls! (kid a 3) (mut out))))
    (g/KWhereE [] (answer-calls! (kid e 0) (mut out)))
    (g/KGroup [] (answer-calls! (kid e 0) (mut out)))
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [a] (answer-calls! a (mut out)))
                  (None [] 0)))
    (_ 0))
  0)

;;; A twin's arguments are values, so a function given something to change has none.
(defn any-mut-param? [(params (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for p params (when (= (.kind (kid p 1)) (g/KTMut)) (set! hit true)))
    hit))

;;; Whether an answer makes its list from parts, through its matches, `where`s and `with`s: a list
;;; written out, a comprehension, a concatenation or a call. Its twin adds the parts to the list it is
;;; handed as it makes them, and a caller that spreads it makes no list of its own to copy.
(defn builds-list? [(e g/Node)] (-> bool)
  (match (.kind e)
    (g/KListLit [] true)
    (g/KConcat [] true)
    (g/KComp [] true)
    (g/KCompSpread [] true)
    ;; A call hands the list on: to its own function's twin, when it has one.
    (g/KCall [] true)
    (g/KMatch []
              (let [(mut hit) false]
                (for a (list-kids (kid e 1))
                  (when (builds-list? (kid a 2)) (set! hit true)))
                hit))
    (g/KMatchN []
               (let [(mut hit) false]
                 (for a (list-kids (kid e 2))
                   (when (builds-list? (kid a 3)) (set! hit true)))
                 hit))
    (g/KWhereE [] (builds-list? (kid e 0)))
    (g/KGroup [] (builds-list? (kid e 0)))
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [a] (builds-list? a))
                  (None [] false)))
    (_ false)))

(defn accumulator-fns [(d g/Node)] (-> (ArrayList g/Node))
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)
        into (cat (.text fname) "-into!")
        acc "accumulated"
        acc-type (g/mk (g/KTMut) (one ret) (.lo ret) (.hi ret))
        (mut into-params) (g/new-kids)
        (mut wrap-args) (g/new-kids)
        (mut stmts) (g/new-kids)
        (mut wrap-stmts) (g/new-kids)
        (mut into-kids) (g/new-kids)
        (mut wrap-kids) (g/new-kids)
        (mut out) (g/new-kids)
        answer
          (match (answer-of body)
            (Some [a] a)
            (None [] (panic "accumulator-fns of a function with no answer")))]
    (for p params (push! (mut into-params) p))
    (push! (mut into-params) (g/node2 (g/KParam) (name-node acc body) acc-type))
    (for p params (push! (mut wrap-args) (name-node (.text (kid p 0)) body)))
    (push! (mut wrap-args) (name-node acc body))
    (when (= (.kind body) (g/KBlock))
      (let [all (.kids (kid body 0))]
        (for i (range 0 (- (len all) 1)) (push! (mut stmts) (get all i)))))
    (push! (mut stmts) (pushed-extend acc answer))
    (push! (mut into-kids) (name-node into fname))
    (push! (mut into-kids) (list-node into-params (kid d 1)))
    (push! (mut into-kids) (g/none-node))
    (push! (mut into-kids)
           (g/mk (g/KBlock) (one (list-node stmts body)) (.lo body) (.hi body)))
    (push! (mut out) (g/mk (g/KFn) into-kids (.lo d) (.hi d)))
    (push! (mut wrap-stmts)
           (g/mk (g/KVar)
                 (three (name-node acc body)
                        ret
                        (g/mk (g/KListLit)
                              (one (list-node (g/new-kids) body))
                              (.lo body)
                              (.lo body)))
                 (.lo body)
                 (.hi body)))
    (push! (mut wrap-stmts)
           (g/node2 (g/KCall) (name-node into body) (list-node wrap-args body)))
    (push! (mut wrap-stmts) (name-node acc body))
    (push! (mut wrap-kids) fname)
    (push! (mut wrap-kids) (kid d 1))
    (push! (mut wrap-kids) ret)
    (push! (mut wrap-kids)
           (g/mk (g/KBlock)
                 (one (list-node wrap-stmts body))
                 (.lo body)
                 (.hi body)))
    (push! (mut out) (g/mk (g/KFn) wrap-kids (.lo d) (.hi d)))
    out))

;;; `acc ++= e`, pushed into `e`'s matches and through its `where`s, so that each arm adds what it
;;; makes as it makes it: an arm that recurses adds through its own accumulator, and nothing is
;;; built only to be copied.
(defn pushed-extend [(acc (slice u8)) (e g/Node)] (-> g/Node)
  (match (.kind e)
    (g/KMatch []
              (let [(mut arms) (g/new-kids)]
                (for a (list-kids (kid e 1))
                  (let [(mut t) a
                        (mut ks) (g/new-kids)]
                    (push! (mut ks) (kid a 0))
                    (push! (mut ks) (kid a 1))
                    (push! (mut ks) (pushed-extend acc (kid a 2)))
                    (set! (.kids t) ks)
                    (push! (mut arms) t)))
                (g/node2 (g/KMatch) (kid e 0) (list-node arms (kid e 1)))))
    (g/KMatchN []
               (let [(mut arms) (g/new-kids)]
                 (for a (list-kids (kid e 2))
                   (let [(mut t) a
                         (mut ks) (g/new-kids)]
                     (push! (mut ks) (kid a 0))
                     (push! (mut ks) (kid a 1))
                     (push! (mut ks) (kid a 2))
                     (push! (mut ks) (pushed-extend acc (kid a 3)))
                     (set! (.kids t) ks)
                     (push! (mut arms) t)))
                 (g/mk (g/KMatchN)
                       (three (kid e 0) (kid e 1) (list-node arms (kid e 2)))
                       (.lo e)
                       (.hi e))))
    (g/KWhereE [] (g/node2 (g/KWhereE) (pushed-extend acc (kid e 0)) (kid e 1)))
    (g/KGroup [] (pushed-extend acc (kid e 0)))
    ;; `with x = v { … e }`: `e` goes in while `x` is `v`.
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [_]
                        (let [block (kid e 1)
                              stmts (list-kids (kid block 0))
                              (mut ks) (g/new-kids)]
                          (for i (range 0 (- (len stmts) 1))
                            (push! (mut ks) (get stmts i)))
                          (push! (mut ks)
                                 (pushed-extend acc
                                                (get stmts (- (len stmts) 1))))
                          (g/node2 (g/KWithCtx)
                                   (kid e 0)
                                   (g/mk (g/KBlock)
                                         (one (list-node ks block))
                                         (.lo block)
                                         (.hi block)))))
                  (None [] (g/node2 (g/KExtend) (name-node acc e) e))))
    (g/KPanic [] e)
    (_ (g/node2 (g/KExtend) (name-node acc e) e))))

;;; `"bundle.js" = "src/bundle/js.syntax"` lines under [modules].
(defn read-manifest! [(k (mut Comp)) (manifest (slice u8))] (-> void)
  (set! (.base k) (rt/dir-of manifest))
  (let [text (rt/read-all manifest)
        (mut start) 0
        (mut in-modules) false]
    (for i (range 0 (+ (len text) 1))
      (when (or (= i (len text)) (= (get text i) #\newline))
        (let [line (subslice text start i)]
          (set! start (+ i 1))
          (cond (rt/at? line 0 "[") (set! in-modules (= line "[modules]"))
                (and in-modules (rt/at? line 0 "\""))
                  (let [(mut quotes) (ArrayList::new [i64] (malloc-allocator))]
                    (for j (range 0 (len line))
                      (when (= (get line j) #\") (push! (mut quotes) j)))
                    (when (= (len quotes) 4)
                      (push! (mut (.table k))
                             (Alias
                               :name
                                 (subslice line
                                           (+ (get quotes 0) 1)
                                           (get quotes 1))
                               :module
                                 (subslice line
                                           (+ (get quotes 2) 1)
                                           (get quotes 3))))))
                :else 0))))))

(defn file-of [(k (mut Comp)) (module (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for a (.table k)
      (when (= (.name a) module)
        (set! out (Some (cat3 (.base k) "/" (.module a))))))
    out))

(defn grammar-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SGrammar) "")
        node (cat module ".Node")]
    (set! (.kinds m) (syntax/grammar-table (rt/read-all path) path))
    (push! (mut (.types m)) "Node")
    (push! (mut (.types m)) "Kind")
    (let [(mut f) (func-of "parse" node)]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-tries" node)]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "base" "Int" false)
      (param (mut f) "more" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-opt" (cat node "?"))]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "flags" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-piece" (cat node "?"))]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "flags" "Int" false)
      (param (mut f) "from" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "flag-bit" "Int")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "render" "Text")]
      (param (mut f) "n" node false)
      (param (mut f) "pretty" "Bool" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "render-tracked" "hl.rt.Rendered")]
      (param (mut f) "n" node false)
      (param (mut f) "pretty" "Bool" false)
      (param (mut f) "tracking" "Bool" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "opaque-spine?" "Bool")]
      (param (mut f) "n" node false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "kind-name" "Text")]
      (param (mut f) "k" (cat module ".Kind") false)
      (push! (mut (.funcs m)) f))
    m))

(defn facts-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))] (-> Mod)
  (let [(mut m) (mod-new module (SFacts) "")
        src (rt/read-all path)
        db (cat module ".Db")
        tree
          (match (gf/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (cat "expected " (.want e)))))]
    (push! (mut (.types m)) "Db")
    (push! (mut (.types m)) "Fact")
    (for item (.kids (get (.kids tree) 0))
      (when (= (.kind item) (gf/KRelation))
        (push! (mut (.rels m))
               (RelDef
                 :name (.text (get (.kids item) 0))
                 :arity (len (.kids (get (.kids item) 1)))))
        ;; `link.fact-REL(a, b)`: the row as a value.
        (let [(mut f)
                (func-of (cat "fact-" (.text (get (.kids item) 0)))
                         (cat module ".Fact"))]
          (for c (range 0 (len (.kids (get (.kids item) 1))))
            (param (mut f) (cat "a" (rt/num-text c)) "Int" false))
          (push! (mut (.funcs m)) f))))
    (let [(mut f) (func-of "add-facts!" "Void")]
      (param (mut f) "db" db true)
      (param (mut f) "facts" (cat3 "[" module ".Fact]") false)
      (push! (mut (.funcs m)) f))
    (push! (mut (.funcs m)) (func-of "new-db" db))
    (let [(mut f) (func-of "solved" db)]
      (param (mut f) "facts" (cat3 "[" module ".Fact]") false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "solved-blocks" db)]
      (param (mut f) "blocks" (cat3 "[[" module ".Fact]]") false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "solved-from" db)]
      (param (mut f) "last" db false)
      (param (mut f) "blocks" (cat3 "[[" module ".Fact]]") false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "solve!" "Int")]
      (param (mut f) "db" db true)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "reserve!" "Void")]
      (param (mut f) "db" db true)
      (param (mut f) "name" "Text" false)
      (param (mut f) "n" "Int" false)
      (push! (mut (.funcs m)) f))
    m))

;;; A `.rewrite`, `.scopes` or `.pipeline` file read by its own grammar, for what its header names.
(defn rewrite-tree [(path (slice u8))] (-> grw/Node)
  (match (grw/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn scopes-tree [(path (slice u8))] (-> gsc/Node)
  (match (gsc/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn pipeline-tree [(path (slice u8))] (-> gpl/Node)
  (match (gpl/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn rewrite-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SRewrite) "")
        ;; The file's own header names its grammar.
        grammar (.text (get (.kids (rewrite-tree path)) 0))]
    (let [node (cat grammar ".Node")
          (mut f) (func-of "run" node)]
      (ensure-loaded! (mut k) grammar)
      (param (mut f) "n" node false)
      (push! (mut (.funcs m)) f))
    m))

;;; A `.pipeline` module: what a run asks of it.
(defn pipeline-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SRewrite) "")]
    ;; Its plans: which a run uses (see `plan` in the pipeline language).
    (let [(mut f) (func-of "use-plan!" "Void")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "use-threads!" "Void")]
      (param (mut f) "n" "Int" false)
      (push! (mut (.funcs m)) f))
    (push! (mut (.funcs m)) (func-of "plan-names" "[Text]"))
    ;; Its strategies: which a run uses (see `strategy` in the pipeline language).
    (let [(mut f) (func-of "use-strategy!" "Void")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "strategy-tracks?" "Bool")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "strategy-persists?" "Bool")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "run-started!" "Bool")]
      (param (mut f) "name" "Text" false)
      (param (mut f) "cache" "Text" false)
      (param (mut f) "watching" "Bool" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "build-done!" "Void")]
      (param (mut f) "name" "Text" false)
      (param (mut f) "cache" "Text" false)
      (param (mut f) "later" "Bool" false)
      (param (mut f) "timing" "Bool" false)
      (push! (mut (.funcs m)) f))
    (push! (mut (.funcs m)) (func-of "default-strategy" "Text"))
    (push! (mut (.funcs m)) (func-of "watching-strategy" "Text"))
    (push! (mut (.funcs m)) (func-of "strategy-names" "[Text]"))
    m))

(defn scopes-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))] (-> Mod)
  (let [(mut m) (mod-new module (SScopes) "")
        grammar (.text (get (.kids (scopes-tree path)) 0))]
    (let [node (cat grammar ".Node")
          kind (cat grammar ".Kind")]
      (ensure-loaded! (mut k) grammar)
      (let [(mut f) (func-of "analyze" "Int")]
        (param (mut f) "tree" node false)
        (param (mut f) "table" "hl.symtab.Table" true)
        (param (mut f) "parent" "Int" false)
        (param (mut f) "bindings" "{Int:Int}" true)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "declare-program!" "Void")]
        (param (mut f) "tree" node false)
        (param (mut f) "table" "hl.symtab.Table" true)
        (param (mut f) "root" "Int" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "analysis" "hl.symtab.Analysis")]
        (param (mut f) "tree" node false)
        (param (mut f) "outer" "[Text]" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "declarations" "hl.symtab.Analysis")]
        (param (mut f) "tree" node false)
        (param (mut f) "outer" "[Text]" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "part-analysis" "hl.symtab.Analysis")]
        (param (mut f) "table" "hl.symtab.Table" false)
        (param (mut f) "scope" "Int" false)
        (param (mut f) "parts" (cat3 "[" node "]") false)
        (push! (mut (.funcs m)) f))
      (for name ["opens?" "sequential?" "ref?" "bind?"]
        (let [(mut f) (func-of name "Bool")]
          (param (mut f) "k" kind false)
          (push! (mut (.funcs m)) f)))
      (for name ["scope-kind" "names-in"]
        (let [(mut f) (func-of name "Text")]
          (param (mut f) "k" kind false)
          (push! (mut (.funcs m)) f))))
    m))

(defn ensure-loaded! [(k (mut Comp)) (module (slice u8))] (-> void)
  (when (< (mod-index (mut k) module) 0)
    (match (file-of (mut k) module)
      (None []
            (dsl/fail-at (.path k)
                         1
                         1
                         (cat3 "no file for the module "
                               module
                               "; list it under [modules]")))
      (Some [path]
            (push! (mut (.depends k)) path)
            (cond (or (rt/ends-with path ".rules") (rt/ends-with path ".attrs"))
                    (load-rules-file! (mut k) path (rt/read-all path) false)
                  (rt/ends-with path ".syntax")
                    (push! (mut (.mods k)) (grammar-mod (mut k) module path))
                  (rt/ends-with path ".facts")
                    (push! (mut (.mods k)) (facts-mod (mut k) module path))
                  (rt/ends-with path ".rewrite")
                    (let [m (rewrite-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  (rt/ends-with path ".scopes")
                    (let [m (scopes-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  (rt/ends-with path ".pipeline")
                    (let [m (pipeline-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  :else
                    (dsl/fail-at (.path k)
                                 1
                                 1
                                 (cat "cannot read the signatures of " path)))))))

(defn add-foreign! [(k (mut Comp)) (decl g/Node) (owner (slice u8))] (-> void)
  (let [module (.text (kid decl 0))
        alias (.text (kid decl 1))
        items (list-kids (kid decl 2))]
    (when (< (mod-index (mut k) module) 0)
      (push! (mut (.mods k)) (mod-new module (SForeign) "")))
    (let [ix (mod-index (mut k) module)]
      ;; Names first, so items can mention each other in any order.
      (for item items
        (match (.kind item)
          (g/KFType []
                    (unless (has-type? (get (.mods k) ix) (.text (kid item 0)))
                      (push! (mut (.types (elem (mut (.mods k)) ix)))
                             (.text (kid item 0)))))
          (g/KFRecord []
                      (unless (has-type? (get (.mods k) ix)
                                         (.text (kid item 0)))
                        (push! (mut (.recs (elem (mut (.mods k)) ix)))
                               (RecDef
                                 :boxed false
                                 :name (.text (kid item 0))
                                 :fields
                                   (ArrayList::new [FieldDef]
                                                   (malloc-allocator))))))
          (_ 0)))
      (for item items
        (match (.kind item)
          (g/KFRecord []
                      (let [rec-name (.text (kid item 0))
                            (mut rec-at) -1]
                        (for i (range 0 (len (.recs (get (.mods k) ix))))
                          (when (= (.name (get (.recs (get (.mods k) ix)) i))
                                   rec-name)
                            (set! rec-at i)))
                        (when (= (len (.fields (get (.recs (get (.mods k) ix))
                                                    rec-at)))
                                 0)
                          (for f (list-kids (kid item 1))
                            (let [ty (resolve-type (mut k) module (kid f 1))]
                              (push! (mut (.fields (elem (mut (.recs (elem (mut (.mods k))
                                                                           ix)))
                                                         rec-at)))
                                     (FieldDef :name (.text (kid f 0)) :ty ty)))))))
          (g/KFFn []
                  (let [name (.text (kid item 0))
                        coil-name
                          (if (none? (kid item 1)) name (.text (kid item 1)))
                        (mut f)
                          (Func
                            :name name
                            :coil coil-name
                            :params (ArrayList::new [Param] (malloc-allocator))
                            :ret
                              (if (none? (kid item 3))
                                  "Void"
                                  (resolve-type (mut k) module (kid item 3))))]
                    (for p (list-kids (kid item 2))
                      (push! (mut (.params f))
                             (Param
                               :name (.text (kid p 0))
                               :ty (resolve-type (mut k) module (kid p 1))
                               :by-ref (= (.kind (kid p 1)) (g/KTMut)))))
                    (when (and (> (len (.kids item)) 4)
                               (not (none? (kid item 4))))
                      (unless (and (> (len (.params f)) 0)
                                   (.by-ref (get (.params f) 0)))
                        (die (mut k)
                             item
                             "a function that changes something takes it first, as mut"))
                      (push! (mut (.mutators k))
                             (Mutator
                               :key (cat3 module "/" name)
                               :calls (list-kids (kid item 4)))))
                    (match (find-func (get (.mods k) ix) name)
                      (None []
                            (push! (mut (.funcs (elem (mut (.mods k)) ix))) f))
                      (Some [_] 0))))
          (_ 0))))
    (let [(mut at) (mod-index (mut k) owner)]
      (push! (mut (.aliases (elem (mut (.mods k)) at)))
             (Alias :name alias :module module)))))

;;; Read a file's declarations. The body is compiled only for the module being read.
(defn load-rules-file! [(k (mut Comp))
                        (path (slice u8))
                        (src (slice u8))
                        (is-self bool)] (-> g/Node)
  (let [saved-src (.src k)
        saved-path (.path k)
        tree (parse-file (mut k) src path)
        name (.text (kid tree 0))
        over (if (none? (kid tree 1)) "" (.text (kid tree 1)))
        decls (list-kids (kid tree 2))]
    (set! (.src k) src)
    (set! (.path k) path)
    (when (> (len over) 0) (ensure-loaded! (mut k) over))
    (for d decls
      (when (or (= (.kind d) (g/KUse)) (= (.kind d) (g/KInclude)))
        (ensure-loaded! (mut k) (.text (kid d 0)))))
    (push! (mut (.mods k)) (mod-new name (SRules) over))
    (let [ix (- (len (.mods k)) 1)]
      (push! (mut (.aliases (elem (mut (.mods k)) ix)))
             (Alias :name "rt" :module "hl.rt"))
      (push! (mut (.aliases (elem (mut (.mods k)) ix)))
             (Alias :name "sym" :module "hl.symtab"))
      (for d decls
        (when (= (.kind d) (g/KUse))
          (push! (mut (.aliases (elem (mut (.mods k)) ix)))
                 (Alias :name (.text (kid d 1)) :module (.text (kid d 0))))))
      (push! (mut (.funcs (elem (mut (.mods k)) ix)))
             (func-of "reset-state!" "Void"))
      ;; Type names before anything that mentions them.
      (for d decls
        (when (or (= (.kind d) (g/KRecord)) (= (.kind d) (g/KBoxedRecord)))
                     (push! (mut (.recs (elem (mut (.mods k)) ix)))
                            (RecDef
                              :name (.text (kid d 0))
                              :boxed (= (.kind d) (g/KBoxedRecord))
                              :fields
                                (ArrayList::new [FieldDef] (malloc-allocator)))))
        (match (.kind d)
          (g/KEnum []
                   (let [(mut vs) (text-list)]
                     (for v (list-kids (kid d 1)) (push! (mut vs) (.text v)))
                     (push! (mut (.enums (elem (mut (.mods k)) ix)))
                            (EnumDef :name (.text (kid d 0)) :variants vs))))
          (g/KQuoteDecl []
                        (let [(mut path-out)
                                (ArrayList::new [i64] (malloc-allocator))]
                          (for step (list-kids (kid d 1))
                            (push! (mut path-out) (rt/parse-int (.text step))))
                          (push! (mut (.quotes (elem (mut (.mods k)) ix)))
                                 (QuoteDef
                                   :name (.text (kid d 0))
                                   :path path-out))))
          (_ 0)))
      ;; A record's name is its constructor's, so no other record or enum value may have it.
      (let [(mut names) (text-list)]
        (for d decls
          (when (= (.kind d) (g/KEnum))
            (for v (list-kids (kid d 1)) (push! (mut names) (.text v)))))
        (for d decls
          (when (or (= (.kind d) (g/KRecord)) (= (.kind d) (g/KBoxedRecord)))
            (let [name (.text (kid d 0))]
              (for x names
                (when (= x name)
                  (die (mut k)
                       d
                       (cat3 "the record "
                             name
                             " has the name of a value of an enum, or of a record before it"))))
              (push! (mut names) name)))))
      ;; An attribute grammar's answer is a record its own functions may name, after the
      ;; records written, whose fields are filled in by position.
      (when (= (.kind tree) (g/KAttrsFile))
        (push! (mut (.recs (elem (mut (.mods k)) ix)))
               (RecDef
                 :name "Attrs"
                 :boxed false
                 :fields (ArrayList::new [FieldDef] (malloc-allocator)))))
      (for d decls
        (when (= (.kind d) (g/KForeign)) (add-foreign! (mut k) d name)))
      ;; add-foreign! may have added modules after this one, but never before it.
      (let [ix2 (mod-index (mut k) name)
            (mut rec-index) 0]
        (for d decls
          (when (or (= (.kind d) (g/KRecord)) (= (.kind d) (g/KBoxedRecord)))
                       (for f (list-kids (kid d 1))
                         (let [ty (resolve-type (mut k) name (kid f 1))]
                           (push! (mut (.fields (elem (mut (.recs (elem (mut (.mods k))
                                                                        ix2)))
                                                      rec-index)))
                                  (FieldDef :name (.text (kid f 0)) :ty ty))))
                       (set! rec-index (+ rec-index 1)))
          (match (.kind d)
            (g/KState [] (add-global! (mut k) ix2 name d true))
            (g/KTaskState [] (add-global! (mut k) ix2 name d true))
            (g/KContext [] (add-global! (mut k) ix2 name d true))
            (g/KInh []
                    (attrs-only! (mut k) tree d)
                    (add-global! (mut k) ix2 name d true))
            (g/KGiven []
                      (attrs-only! (mut k) tree d)
                      (add-global! (mut k) ix2 name d true))
            ;; An input is given to an attribute grammar's `run`; a setting is the module's, given by
            ;; `with` for the extent of a call.
            (g/KInput []
                      (attrs-only! (mut k) tree d)
                      (add-global! (mut k) ix2 name d true))
            (g/KSetting [] (add-module-input! (mut k) ix2 name d))
            (g/KCollect []
                        (attrs-only! (mut k) tree d)
                        (add-global! (mut k) ix2 name d true))
            (g/KOn [] (attrs-only! (mut k) tree d))
            (g/KRewrite [] (attrs-only! (mut k) tree d))
            (g/KInclude [] (attrs-only! (mut k) tree d))
            (g/KConst [] (add-global! (mut k) ix2 name d false))
            (g/KMemoFn []
                       (do
                         (collect-fn! (mut k) ix2 name d)
                         (push! (mut (.memos (elem (mut (.mods k)) ix2)))
                                (.text (kid d 0)))))
            (g/KFn [] (collect-fn! (mut k) ix2 name d))
            (_ 0)))
        (when (= (.kind tree) (g/KAttrsFile))
          (attrs-signature! (mut k) ix2 name over decls))))
    (set! (.src k) saved-src)
    (set! (.path k) saved-path)
    tree))

(defn any-memo? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KMemoFn)) (set! hit true)))
    hit))

(defn collect-fn! [(k (mut Comp)) (ix2 i64) (name (slice u8)) (d g/Node)]
  (-> void)
  (let [(mut f)
          (Func
            :name (.text (kid d 0))
            :coil (.text (kid d 0))
            :params (ArrayList::new [Param] (malloc-allocator))
            :ret
              (if (none? (kid d 2))
                  "Void"
                  (resolve-type (mut k) name (kid d 2))))]
    (for p (list-kids (kid d 1))
      (push! (mut (.params f))
             (Param
               :name (.text (kid p 0))
               :ty (resolve-type (mut k) name (kid p 1))
               :by-ref (= (.kind (kid p 1)) (g/KTMut)))))
    (push! (mut (.funcs (elem (mut (.mods k)) ix2))) f)))

;;; A module's input: one value for the whole program, not a worker's, which only `with` gives it, and
;;; which nothing reads while it has none.
(defn add-module-input! [(k (mut Comp)) (ix i64) (module (slice u8)) (d g/Node)]
  (-> void)
  (let [ty (resolve-type (mut k) module (kid d 1))]
    (push! (mut (.globals (elem (mut (.mods k)) ix)))
           (Global
             :name (.text (kid d 0))
             :ty ty
             :assignable false
             :task false
             :attr 5))))

(defn bound-field [(name (slice u8))] (-> (slice u8))
  (cat name "--bound"))

;;; A module input's value, read where it has one: where a binding gives it, or else the value last
;;; given it, which it holds (see `held-field`). So an answer made in an earlier build, checked or
;;; made again before what gives the setting runs, reads what that build gave, as an input of an
;;; incremental computation keeps its value from one revision to the next. Read where nothing ever
;;; gave it a value, it is an error. The check is on the storage, which the field is then read
;;; through, so a field of the value is read without copying the rest.
(defn input-read [(k (mut Comp)) (module (slice u8)) (x Global) (storage Code)]
  (-> Code)
  (let [st (fresh (mut k) "storage")]
    `(~(primitive/code-symbol "." (.name x)) (let [~(sym st) ~storage]
                                               (when (and (= (~(primitive/code-symbol "."
                                                                                      (bound-field (.name x))) ~(sym st))
                                                             0)
                                                          (= (~(primitive/code-symbol "."
                                                                                      (held-field (.name x))) ~(sym st))
                                                             0))
                                                 (panic ~(cat3 "the input "
                                                               (.name x)
                                                               " was read where nothing gave it a value")))
                                               ;; A memo computing now is made from it, unless
                                               ;; only part of it is read, which notes that part.
                                               ~(if (> (.quiet k) 0)
                                                    `0
                                                    `(when (rt/dep-in-frame?)
                                                       (rt/dep-note-literal! ~(cat4 "s:"
                                                                                    module
                                                                                    "."
                                                                                    (.name x)))))
                                               ;; What reads it may hold some of it.
                                               (rt/region-uses-id! (~(primitive/code-symbol "."
                                                                                           (region-field (.name x))) ~(sym st)))
                                               ~(sym st)))))

(defn add-global! [(k (mut Comp))
                   (ix i64)
                   (module (slice u8))
                   (d g/Node)
                   (assignable bool)] (-> void)
  (let [ty (resolve-type (mut k) module (kid d 1))
        ;; A context is rebound for a dynamic extent, which is one thread's.
        task
          (or (= (.kind d) (g/KTaskState))
              (= (.kind d) (g/KContext))
              (= (.kind d) (g/KInh))
              (= (.kind d) (g/KInput))
              (= (.kind d) (g/KCollect))
              (= (.kind d) (g/KGiven)))
        attr
          (cond (= (.kind d) (g/KInh)) 1
                (= (.kind d) (g/KInput)) 2
                (= (.kind d) (g/KCollect)) 3
                (= (.kind d) (g/KGiven)) 4
                :else 0)]
    (push! (mut (.globals (elem (mut (.mods k)) ix)))
           (Global
             :name (.text (kid d 0))
             :ty ty
             :assignable assignable
             :task task
             :attr attr))))

;;; Where a global lives: once per program, or once per worker slot for `task state` and contexts.
;;; A function runs on one thread from start to end, so inside one the slot is looked up once.
(defn storage-call [(k (mut Comp)) (x Global)] (-> Code)
  (cond (= (.attr x) 5) `(~(sym (cat "setting-state--" (.name x))))
        (not (.task x)) `(rules-state)
        (.in-fn k) (do (set! (.task-used k) true) `rules-task-here)
        :else `(rules-task)))

;;; A global's value. An input has one only while `run` runs: read at any other time it would be
;;; the empty value, silently, so that stops.
(defn global-read [(k (mut Comp)) (x Global)] (-> Code)
  (let [field
          `(~(primitive/code-symbol "." (.name x)) ~(storage-call (mut k) x))]
    (cond (= (.attr x) 5)
            (input-read (mut k) (.self k) x (storage-call (mut k) x))
          (= (.attr x) 2)
            `(do
               (when (= (.attrs-depth ~(storage-call (mut k) x)) 0)
                 (panic ~(cat3 "the input "
                               (.name x)
                               " was read outside run, where it has no value")))
               ~field)
          :else field)))

(defn storage-of [(k (mut Comp)) (module (slice u8)) (x Global)] (-> Code)
  (if (= (.attr x) 5)
      `(~(sym (qualified (mut k) module (cat "setting-state--" (.name x)))))
      `(~(sym (qualified (mut k)
                         module
                         (if (.task x) "rules-task" "rules-state"))))))

;; ---------------------------------------------------------------- locals

(defn bind-local! [(k (mut Comp))
                   (name (slice u8))
                   (ty (slice u8))
                   (mutable bool)] (-> (slice u8))
  (let [s (fresh (mut k) (cat "v-" name))]
    (push! (mut (.locals k))
           (Local
             :name name
             :ty ty
             :sym s
             :mutable mutable
             :depth (len (.loop-marks k))))
    s))

(defn find-local [(k (mut Comp)) (name (slice u8))] (-> (Option Local))
  (let [(mut out) (None [Local])]
    (for l (.locals k) (when (= (.name l) name) (set! out (Some l))))
    out))

(defn locals-mark [(k (mut Comp))] (-> i64)
  (len (.locals k)))

(defn locals-reset! [(k (mut Comp)) (mark i64)] (-> void)
  (while (> (len (.locals k)) mark) (pop! (mut (.locals k))))
  0)

;; ---------------------------------------------------------------- literals

(defn str-literal [(n g/Node)] (-> (slice u8))
  (dsl/unescape (subslice (.text n) 1 (- (len (.text n)) 1))))

(defn char-value [(n g/Node)] (-> i64)
  (let [s (dsl/unescape (subslice (.text n) 1 (- (len (.text n)) 1)))]
    (cast i64 (get s 0))))

;; ---------------------------------------------------------------- checks

(defn expect [(k (mut Comp)) (n g/Node) (e TE) (want (slice u8))] (-> TE)
  (when (and (> (len want) 0)
             (!= want "Void")
             (!= (.ty e) want)
             (!= (.ty e) "Never"))
    (die (mut k) n (cat4 "expected " want ", found " (.ty e))))
  e)

(defn unify [(k (mut Comp)) (n g/Node) (a (slice u8)) (b (slice u8))]
  (-> (slice u8))
  (cond (= a b) a
        (= a "Never") b
        (= b "Never") a
        (or (= a "Void") (= b "Void")) "Void"
        :else (die (mut k) n (cat4 "these branches disagree: " a " and " b))))

;;; A form whose type must come from elsewhere: `none`, `[]` and `{}`.
(defn needs-want? [(n g/Node)] (-> bool)
  (match (.kind n)
    (g/KNoneE [] true)
    (g/KListLit [] (= (len (list-kids (kid n 0))) 0))
    (g/KBlock [] (= (len (list-kids (kid n 0))) 0))
    (_ false)))

(defn new-list [(k (mut Comp)) (elem (slice u8))] (-> Code)
  `(ArrayList::new [~(coil-type (mut k) elem)] (rt/tree-allocator)))

;;; A map that is a value: in the region values go to now.
(defn new-map [(k (mut Comp)) (t (slice u8))] (-> Code)
  (map-in (mut k) t `(rt/value-allocator)))

;;; A map the generated code keeps for itself (a memo's tables): on malloc, let go explicitly.
(defn runtime-map [(k (mut Comp)) (t (slice u8))] (-> Code)
  (map-with (mut k) t `(malloc-allocator) `(rt/memo-keyops)))

(defn map-in [(k (mut Comp)) (t (slice u8)) (allocator Code)] (-> Code)
  (map-with (mut k) t allocator `(rt/text-keyops)))

;;; A map whose Text keys are held as `text-keys` says: its own copies, or views of kept texts
;;; for a table of kept answers (see `rt/memo-keyops`).
(defn map-with [(k (mut Comp)) (t (slice u8)) (allocator Code) (text-keys Code)] (-> Code)
  (when (boxed-record? (mut k) (map-key t))
    (panic "rules: boxed records are values, not scalar map keys; use an Int or Text key"))
  (cond (= (map-key t) "Text")
          `(HashMap::new [~(coil-type (mut k) (map-key t))
                          ~(coil-type (mut k) (map-val t))]
                         ~allocator
                         ~text-keys)
        ;; An Int is its own hash, near enough: one multiply, not eight bytes of FNV.
        (= (map-key t) "Int")
          `(HashMap::new [i64 ~(coil-type (mut k) (map-val t))]
                         ~allocator
                         (i64-keyops))
        :else
          `(HashMap::new-scalar [~(coil-type (mut k) (map-key t))
                                 ~(coil-type (mut k) (map-val t))]
                                ~allocator)))

;; ---------------------------------------------------------------- patterns

(defsum Step
  (STest [(code Code)])
  (SBind [(sym (slice u8)) (code Code)])
  (SSome [(sym (slice u8)) (code Code)]))

(defn wrap-steps [(steps (ArrayList Step)) (i i64) (inner Code)] (-> Code)
  (if (>= i (len steps))
      inner
      (let [rest (wrap-steps steps (+ i 1) inner)]
        (match (get steps i)
          (STest [c] `(when ~c ~rest))
          (SBind [s c] `(let [~(sym s) ~c] ~rest))
          (SSome [s c] `(match ~c (Some [~(sym s)] ~rest) (_ 0)))))))

;;; The grammar a Node type belongs to.
(defn grammar-of-type [(k (mut Comp)) (n g/Node) (ty (slice u8))] (-> Mod)
  (unless (and (not (builtin-type? ty))
               (> (last-dot ty) 0)
               (= (type-name ty) "Node"))
    (die (mut k) n (cat "a node pattern needs a node, but this is " ty)))
  (mod-at (mut k) (type-module ty)))

(defn kind-code [(gr Mod) (name (slice u8))] (-> Code)
  (primitive/code-symbol (alias-of (.name gr)) "/K" name))

;;; The children of a node pattern.
(defn pat-kids! [(k (mut Comp))
                 (p g/Node)
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (arity i64)
                 (steps (mut (ArrayList Step)))] (-> void)
  (let [(mut rest-at) -1
        n (len args)]
    (for i (range 0 n)
      (let [a (get args i)]
        (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
          (when (>= rest-at 0) (die (mut k) a "a pattern has at most one rest"))
          (set! rest-at i))))
    (let [fixed (if (>= rest-at 0) (- n 1) n)]
      (cond (and (>= arity 0) (< rest-at 0) (!= fixed arity))
              (die (mut k)
                   p
                   (cat4 "this node has "
                         (rt/num-text arity)
                         " children, this pattern has "
                         (rt/num-text fixed)))
            (and (>= arity 0) (> fixed arity))
              (die (mut k)
                   p
                   (cat4 "this node has "
                         (rt/num-text arity)
                         " children, this pattern has "
                         (rt/num-text fixed)))
            (and (< arity 0) (< rest-at 0))
              (push! (mut steps) (STest `(= (len (.kids ~subject)) ~fixed)))
            (and (< arity 0) (>= rest-at 0) (> fixed 0))
              (push! (mut steps) (STest `(>= (len (.kids ~subject)) ~fixed)))
            :else 0))
    (for i (range 0 n)
      (let [a (get args i)]
        (cond (= (.kind a) (g/KPAny)) 0
              (= (.kind a) (g/KRest))
                (let [name (subslice (.text a) 0 (- (len (.text a)) 3))
                      after (- n (+ i 1))
                      s (bind-local! (mut k) name (cat3 "[" ty "]") false)
                      whole (and (= i 0) (= after 0))]
                  (push! (mut steps)
                         (SBind s
                                (if whole
                                    `(.kids ~subject)
                                    `(~(primitive/code-symbol (alias-of (type-module ty))
                                                              "/sublist") (.kids ~subject)
                                        ~i
                                        (- (len (.kids ~subject)) ~after))))))
              :else
                (let [index
                        (if (or (< rest-at 0) (< i rest-at))
                            `~i
                            `(- (len (.kids ~subject)) ~(- n i)))]
                  (if (and (= (.kind a) (g/KName)) (= (.text a) "_"))
                      0
                      (if (= (.kind a) (g/KName))
                          (let [s (bind-local! (mut k) (.text a) ty false)]
                            (push! (mut steps)
                                   (SBind s `(get (.kids ~subject) ~index))))
                          (let [t (fresh (mut k) "s")]
                            (push! (mut steps)
                                   (SBind t `(get (.kids ~subject) ~index)))
                            (pat! (mut k) a (sym t) ty (mut steps) ""))))))))))

;;; A node pattern. `known` is the kind a dispatch has already established.
(defn pat-node! [(k (mut Comp))
                 (p g/Node)
                 (name (slice u8))
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))
                 (known (slice u8))] (-> void)
  (let [gr (grammar-of-type (mut k) p ty)]
    (match (find-kind gr name)
      (None []
            (die (mut k)
                 p
                 (cat4 "the grammar " (.name gr) " has no node named " name)))
      (Some [entry]
            (when (!= known name)
              (push! (mut steps)
                     (STest `(= (.kind ~subject) (~(kind-code gr name))))))
            (if (.leaf entry)
                (do
                  (unless (= (len args) 1)
                    (die (mut k)
                         p
                         (cat name
                              " is a token: its pattern has one argument, its text")))
                  (let [a (get args 0)]
                    (match (.kind a)
                      (g/KStr []
                              (push! (mut steps)
                                     (STest `(rt/leaf-is? (.text ~subject)
                                                          ~(str-literal a)))))
                      (g/KName []
                               (unless (= (.text a) "_")
                                 (let [s
                                         (bind-local! (mut k)
                                                      (.text a)
                                                      "Text"
                                                      false)]
                                   (push! (mut steps)
                                          (SBind s `(.text ~subject))))))
                      (g/KPAny [] 0)
                      (_ (die (mut k)
                              a
                              "a token's pattern is a name, _ or a string")))))
                (pat-kids! (mut k) p args subject ty (.arity entry) (mut steps)))))))

;;; A record type of the program's, which a pattern takes apart by its fields' names.
(defn record-type? [(k (mut Comp)) (ty (slice u8))] (-> bool)
  (and (not (builtin-type? ty))
       (not (list? ty))
       (not (map? ty))
       (not (opt? ty))
       (not (fn? ty))
       (> (last-dot ty) 0)
       (!= (type-name ty) "Node")
       (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
         (Some [_] true)
         (None [] false))))

;;; `Options(explicit: true, ...)`: each named field matches its pattern. Without `...` every field
;;; is named, so adding a field to the record is noticed where it is taken apart.
(defn pat-record! [(k (mut Comp))
                   (p g/Node)
                   (name (slice u8))
                   (args (ArrayList g/Node))
                   (subject Code)
                   (ty (slice u8))
                   (steps (mut (ArrayList Step)))] (-> void)
  (unless (= name (type-name ty))
    (die (mut k) p (cat4 "this pattern is a " name ", but the value is a " ty)))
  (let [(mut open) false
        (mut named) 0]
    (for a args
      (cond (= (.kind a) (g/KPAny)) (set! open true)
            (= (.kind a) (g/KPField))
              (let [field (.text (kid a 0))
                    fty (field-type (mut k) a ty field)
                    t (fresh (mut k) "f")]
                (set! named (+ named 1))
                (push! (mut steps)
                       (SBind t `(~(primitive/code-symbol "." field) ~subject)))
                (pat! (mut k) (kid a 1) (sym t) fty (mut steps) ""))
            :else
              (die (mut k)
                   a
                   "a record's pattern names its fields: `field: pattern`, or `...` for the rest")))
    (unless open
      (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
        (Some [r]
              (unless (= named (len (.fields r)))
                (die (mut k)
                     p
                     (cat3 "this pattern leaves out fields of "
                           ty
                           "; end it with `...` to say so"))))
        (None [] 0)))))

;;; `"./" ++ rest`, `stem ++ ".js"`: text that starts, or ends, with a literal, and the rest of it.
(defn pat-text! [(k (mut Comp))
                 (p g/Node)
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))] (-> void)
  (unless (= ty "Text")
    (die (mut k) p (cat "a pattern with ++ takes text apart, but this is " ty)))
  (let [a (kid p 0)
        b (kid p 1)
        rest (fresh (mut k) "rest")]
    (cond (= (.kind a) (g/KStr))
            (let [lit (str-literal a)]
              (push! (mut steps) (STest `(rt/starts-with ~subject ~lit)))
              (push! (mut steps)
                     (SBind rest `(subslice ~subject ~(len lit) (len ~subject))))
              (pat! (mut k) b (sym rest) "Text" (mut steps) ""))
          (= (.kind b) (g/KStr))
            (let [lit (str-literal b)]
              (push! (mut steps) (STest `(rt/ends-with ~subject ~lit)))
              (push! (mut steps)
                     (SBind rest
                            `(subslice ~subject 0 (- (len ~subject) ~(len lit)))))
              (pat! (mut k) a (sym rest) "Text" (mut steps) ""))
          ;; `m ++ "e" ++ x`: split where the literal first appears.
          (and (= (.kind b) (g/KPCat)) (= (.kind (kid b 0)) (g/KStr)))
            (let [lit (str-literal (kid b 0))
                  at (fresh (mut k) "at")
                  before (fresh (mut k) "before")]
              (push! (mut steps) (SSome at `(rt/index-of ~subject ~lit)))
              (push! (mut steps)
                     (SBind before `(subslice ~subject 0 ~(sym at))))
              (push! (mut steps)
                     (SBind rest
                            `(subslice ~subject
                                       (+ ~(sym at) ~(len lit))
                                       (len ~subject))))
              (pat! (mut k) a (sym before) "Text" (mut steps) "")
              (pat! (mut k) (kid b 1) (sym rest) "Text" (mut steps) ""))
          :else
            (die (mut k)
                 p
                 "a text pattern's ++ has a string at one end, or between two patterns"))))

;;; `[]`, `[x, y]`, `[x, rest...]`, `[..., last]`: a list of so many items, each matching.
(defn pat-list! [(k (mut Comp))
                 (p g/Node)
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))] (-> void)
  (unless (list? ty)
    (die (mut k) p (cat "a list pattern takes a list apart, but this is " ty)))
  (let [(mut rest-at) -1
        n (len args)
        elem (elem-of ty)]
    (for i (range 0 n)
      (let [a (get args i)]
        (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
          (when (>= rest-at 0) (die (mut k) a "a pattern has at most one rest"))
          (set! rest-at i))))
    (let [fixed (if (>= rest-at 0) (- n 1) n)]
      (push! (mut steps)
             (STest (if (>= rest-at 0)
                        `(>= (len ~subject) ~fixed)
                        `(= (len ~subject) ~fixed))))
      (for i (range 0 n)
        (let [a (get args i)
              after (- n (+ i 1))]
          (cond (= (.kind a) (g/KPAny)) 0
                (= (.kind a) (g/KRest))
                  (let [name (subslice (.text a) 0 (- (len (.text a)) 3))
                        s (bind-local! (mut k) name ty false)
                        o (fresh (mut k) "out")
                        j (fresh (mut k) "j")]
                    (push! (mut steps)
                           (SBind s
                                  `(let [(mut ~(sym o)) ~(new-list (mut k) elem)]
                                     (for ~(sym j) (range ~i
                                                          (- (len ~subject)
                                                             ~after))
                                       (push! (mut ~(sym o))
                                              (get ~subject ~(sym j))))
                                     ~(sym o)))))
                :else
                  (let [t (fresh (mut k) "e")
                        index
                          (if (or (< rest-at 0) (< i rest-at))
                              `~i
                              `(- (len ~subject) ~(- n i)))]
                    (push! (mut steps) (SBind t `(get ~subject ~index)))
                    (pat! (mut k) a (sym t) elem (mut steps) ""))))))))

;;; `p` against `subject`, adding tests and bindings. Locals stay bound for the caller.
(defn pat! [(k (mut Comp))
            (p g/Node)
            (subject Code)
            (ty (slice u8))
            (steps (mut (ArrayList Step)))
            (known (slice u8))] (-> void)
  (match (.kind p)
    (g/KName []
             (unless (= (.text p) "_")
               (let [s (bind-local! (mut k) (.text p) ty false)]
                 (push! (mut steps) (SBind s subject)))))
    (g/KPAs []
            (pat! (mut k) (kid p 0) subject ty (mut steps) known)
            (let [s (bind-local! (mut k) (.text (kid p 1)) ty false)]
              (push! (mut steps) (SBind s subject))))
    (g/KPOr []
            (let [(mut tests) (primitive/code-list-new)]
              (for alt (list-kids (kid p 1))
                (push! (mut tests) (pat-test (mut k) alt subject ty)))
              (push! (mut steps)
                     (STest `(or ~(pat-test (mut k) (kid p 0) subject ty)
                                 ~@tests)))))
    (g/KPNode []
              (if (record-type? (mut k) ty)
                  (pat-record! (mut k)
                               p
                               (.text (kid p 0))
                               (list-kids (kid p 1))
                               subject
                               ty
                               (mut steps))
                  (pat-node! (mut k)
                             p
                             (.text (kid p 0))
                             (list-kids (kid p 1))
                             subject
                             ty
                             (mut steps)
                             known)))
    (g/KPCat [] (pat-text! (mut k) p subject ty (mut steps)))
    (g/KPList []
              (pat-list! (mut k) p (list-kids (kid p 0)) subject ty (mut steps)))
    (g/KPNodeQ []
               (if (record-type? (mut k) ty)
                   (pat-record! (mut k)
                                p
                                (.text (kid p 1))
                                (list-kids (kid p 2))
                                subject
                                ty
                                (mut steps))
                   (pat-node! (mut k)
                              p
                              (.text (kid p 1))
                              (list-kids (kid p 2))
                              subject
                              ty
                              (mut steps)
                              known)))
    (g/KPSome []
              (unless (opt? ty)
                (die (mut k)
                     p
                     (cat "some(…) needs an option, but this is " ty)))
              (let [t (fresh (mut k) "s")]
                (push! (mut steps) (SSome t subject))
                (pat! (mut k) (kid p 0) (sym t) (opt-of ty) (mut steps) "")))
    (g/KPNone []
              (unless (opt? ty)
                (die (mut k) p (cat "none needs an option, but this is " ty)))
              (push! (mut steps)
                     (STest `(match ~subject (None [] true) (_ false)))))
    (g/KPTrue [] (push! (mut steps) (STest subject)))
    (g/KPFalse [] (push! (mut steps) (STest `(not ~subject))))
    (g/KInt []
            (push! (mut steps) (STest `(= ~subject ~(rt/parse-int (.text p))))))
    (g/KChar [] (push! (mut steps) (STest `(= ~subject ~(char-value p)))))
    (g/KStr [] (push! (mut steps) (STest `(= ~subject ~(str-literal p)))))
    (g/KUpper []
              (let [m (mod-at (mut k) (type-module ty))]
                (match (find-enum-named m (type-name ty))
                  (None []
                        (die (mut k)
                             p
                             (cat4 (.text p)
                                   " is not a value of "
                                   ty
                                   ", which is no enum")))
                  (Some [_]
                        (push! (mut steps)
                               (STest `(= ~subject
                                          (~(sym (qualified (mut k)
                                                            (type-module ty)
                                                            (.text p)))))))))))
    (g/KPEnumQ []
               (push! (mut steps)
                      (STest `(= ~subject
                                 (~(sym (qualified (mut k)
                                                   (type-module ty)
                                                   (.text (kid p 1)))))))))
    (_ (die (mut k) p "this cannot be a pattern"))))

;;; Does `subject` match? The pattern's names are bound only inside this test.
(defn pat-test [(k (mut Comp)) (p g/Node) (subject Code) (ty (slice u8))]
  (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))
        label (primitive/code-symbol ":" (fresh (mut k) "t"))]
    (pat! (mut k) p subject ty (mut steps) "")
    (locals-reset! (mut k) mark)
    `(block ~label ~(wrap-steps steps 0 `(return-from ~label true)) false)))

;; ---------------------------------------------------------------- match

;;; One alternative of one arm: or-patterns at the top become several.
(defstruct Alt [(pat g/Node) (as-name g/Node) (guard g/Node) (body g/Node)])

(defn alts-of [(arms (ArrayList g/Node))] (-> (ArrayList Alt))
  (let [(mut out) (ArrayList::new [Alt] (malloc-allocator))]
    (for arm arms
      (let [p0 (kid arm 0)
            as-name (if (= (.kind p0) (g/KPAs)) (kid p0 1) (kid arm 1))
            p (if (= (.kind p0) (g/KPAs)) (kid p0 0) p0)
            has-as (= (.kind p0) (g/KPAs))]
        (if (= (.kind p) (g/KPOr))
            (do
              (push! (mut out)
                     (Alt
                       :pat (kid p 0)
                       :as-name (if has-as as-name (g/none-node))
                       :guard (kid arm 1)
                       :body (kid arm 2)))
              (for q (list-kids (kid p 1))
                (push! (mut out)
                       (Alt
                         :pat q
                         :as-name (if has-as as-name (g/none-node))
                         :guard (kid arm 1)
                         :body (kid arm 2)))))
            (push! (mut out)
                   (Alt
                     :pat p
                     :as-name (if has-as as-name (g/none-node))
                     :guard (kid arm 1)
                     :body (kid arm 2))))))
    out))

;;; A node pattern's kind, or "" for one that matches anything.
(defn alt-head [(a Alt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

(defn alt-code [(k (mut Comp))
                (a Alt)
                (subject Code)
                (ty (slice u8))
                (want (slice u8))
                (label Code)
                (known (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) known)
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))))
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [body (stmt (mut k) (.body a) want)
          inner
            (cond (= (.ty body) "Never") (.code body)
                  (or (= (.ty body) "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          out (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (te out (.ty body)))))

(defn no-case [(k (mut Comp)) (n g/Node)] (-> Code)
  (let [at (rt/line-col (.src k) (.lo n))]
    `(panic "{}:{}: no case of this match applies" ~(.path k) ~(.line at))))

;;; The type a match or if yields, when nothing says: its first arm with a type of its own.
(defn arms-want [(k (mut Comp))
                 (alts (ArrayList Alt))
                 (subject Code)
                 (ty (slice u8))] (-> (slice u8))
  (let [(mut out) ""
        label (primitive/code-symbol ":none")]
    (for a alts
      (when (and (= (len out) 0) (not (needs-want? (.body a))))
        (let [t (.ty (alt-code (mut k) a subject ty "" label ""))]
          (unless (= t "Never") (set! out t)))))
    out))

(defn match-code [(k (mut Comp))
                  (n g/Node)
                  (subject-node g/Node)
                  (arms (ArrayList g/Node))
                  (want0 (slice u8))] (-> TE)
  (let [subject (expr (mut k) subject-node "")
        ty (.ty subject)
        s (fresh (mut k) "m")
        ss (sym s)
        alts (alts-of arms)
        label (primitive/code-symbol ":" (fresh (mut k) "m"))
        want (if (> (len want0) 0) want0 (arms-want (mut k) alts ss ty))
        (mut result) "Never"
        node-subject
          (and (not (builtin-type? ty))
               (> (last-dot ty) 0)
               (= (type-name ty) "Node"))
        (mut dispatch) false]
    (when node-subject
      (for a alts (when (> (len (alt-head a)) 0) (set! dispatch true))))
    (let [body
            (if dispatch
                (let [gr (grammar-of-type (mut k) n ty)
                      (mut heads) (text-list)
                      (mut arms-out) (primitive/code-list-new)
                      (mut wild) (primitive/code-list-new)]
                  (for a alts
                    (let [h (alt-head a)
                          (mut seen) (= (len h) 0)]
                      (for x heads (when (= x h) (set! seen true)))
                      (unless seen (push! (mut heads) h))))
                  (for h heads
                    (let [(mut forms) (primitive/code-list-new)]
                      (for a alts
                        (when (or (= (alt-head a) h) (= (len (alt-head a)) 0))
                          (let [c (alt-code (mut k) a ss ty want label h)]
                            (set! result (unify (mut k) n result (.ty c)))
                            (push! (mut forms) (.code c)))))
                      (unless (match (find-kind gr h)
                                (Some [_] true)
                                (None [] false))
                        (die (mut k)
                             n
                             (cat4 "the grammar "
                                   (.name gr)
                                   " has no node named "
                                   h)))
                      (push! (mut arms-out) `(~(kind-code gr h) [] ~@forms 0))))
                  (for a alts
                    (when (= (len (alt-head a)) 0)
                      (let [c (alt-code (mut k) a ss ty want label "")]
                        (set! result (unify (mut k) n result (.ty c)))
                        (push! (mut wild) (.code c)))))
                  `(match (.kind ~ss) ~@arms-out (_ ~@wild 0)))
                (let [(mut forms) (primitive/code-list-new)]
                  (for a alts
                    (let [c (alt-code (mut k) a ss ty want label "")]
                      (set! result (unify (mut k) n result (.ty c)))
                      (push! (mut forms) (.code c))))
                  `(do ~@forms)))]
      (te `(let [~ss ~(.code subject)]
             (block ~label ~body ~(no-case (mut k) n)))
          result))))

;;; `match a, b { p, q => … }`: several values, each arm a pattern for each. An or-pattern at the top
;;; of one of them is an arm of its own for each alternative, so each can bind.
(defn match-n-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [(mut subject-nodes) (ArrayList::new [g/Node] (malloc-allocator))
        (mut subjects) (ArrayList::new [TE] (malloc-allocator))
        (mut syms) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut lets) (primitive/code-list-new)
        label (primitive/code-symbol ":" (fresh (mut k) "m"))]
    (push! (mut subject-nodes) (kid n 0))
    (for e (list-kids (kid n 1)) (push! (mut subject-nodes) e))
    (for e subject-nodes
      (let [t (expr (mut k) e "")
            s (fresh (mut k) "m")]
        (push! (mut subjects) t)
        (push! (mut syms) s)
        (push! (mut lets) (sym s))
        (push! (mut lets) (.code t))))
    (let [(mut rows) (ArrayList::new [AltN] (malloc-allocator))]
      (for arm (list-kids (kid n 2))
        (let [(mut pats) (ArrayList::new [g/Node] (malloc-allocator))]
          (push! (mut pats) (kid arm 0))
          (for p (list-kids (kid arm 1)) (push! (mut pats) p))
          (unless (= (len pats) (len subjects))
            (die (mut k)
                 arm
                 (cat4 "this match is on "
                       (rt/num-text (len subjects))
                       " values, this arm has patterns for "
                       (rt/num-text (len pats)))))
          (for combo (pattern-combos pats)
            (push! (mut rows)
                   (AltN
                     :pats combo
                     :guard (kid arm 2)
                     :body (kid arm 3))))))
      (let [want
              (if (> (len want0) 0)
                  want0
                  (let [(mut out) ""]
                    (for r rows
                      (when (and (= (len out) 0) (not (needs-want? (.body r))))
                        (let [t
                                (.ty (alt-n-code (mut k)
                                                 r
                                                 subjects
                                                 syms
                                                 ""
                                                 label))]
                          (unless (= t "Never") (set! out t)))))
                    out))
            (mut result) "Never"
            (mut forms) (primitive/code-list-new)]
        (for r rows
          (let [c (alt-n-code (mut k) r subjects syms want label)]
            (set! result (unify (mut k) n result (.ty c)))
            (push! (mut forms) (.code c))))
        (te `(let [~@lets] (block ~label ~@forms ~(no-case (mut k) n))) result)))))

(defstruct AltN [(pats (ArrayList g/Node)) (guard g/Node) (body g/Node)])

;;; Each way of picking one top-level alternative from every pattern.
(defn pattern-combos [(pats (ArrayList g/Node))]
  (-> (ArrayList (ArrayList g/Node)))
  (let [(mut out) (ArrayList::new [(ArrayList g/Node)] (malloc-allocator))]
    (push! (mut out) (ArrayList::new [g/Node] (malloc-allocator)))
    (for p pats
      (let [(mut next) (ArrayList::new [(ArrayList g/Node)] (malloc-allocator))
            as-name (if (= (.kind p) (g/KPAs)) (Some (kid p 1)) (None [g/Node]))
            bare (if (= (.kind p) (g/KPAs)) (kid p 0) p)]
        (for prefix out
          (for alt (top-alternatives bare)
            (let [(mut row) (ArrayList::new [g/Node] (malloc-allocator))]
              (for x prefix (push! (mut row) x))
              (push! (mut row)
                     (match as-name
                       (Some [nm] (g/node2 (g/KPAs) alt nm))
                       (None [] alt)))
              (push! (mut next) row))))
        (set! out next)))
    out))

(defn alt-n-code [(k (mut Comp))
                  (a AltN)
                  (subjects (ArrayList TE))
                  (syms (ArrayList (slice u8)))
                  (want (slice u8))
                  (label Code)] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (for i (range 0 (len subjects))
      (pat! (mut k)
            (get (.pats a) i)
            (sym (get syms i))
            (.ty (get subjects i))
            (mut steps)
            ""))
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [body (stmt (mut k) (.body a) want)
          inner
            (cond (= (.ty body) "Never") (.code body)
                  (or (= (.ty body) "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          out (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (te out (.ty body)))))

;;; A guard's tests, `and`-ed: a conjunct `x is P` binds P's names for the conjuncts after it, and for
;;; what the guard guards.
(defn guard-steps! [(k (mut Comp))
                    (guard g/Node)
                    (steps (mut (ArrayList Step)))] (-> void)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))]
    (conjuncts! guard (mut parts))
    (for c parts
      (if (= (.kind c) (g/KIsE))
          (let [subject (expr (mut k) (kid c 0) "")
                t (fresh (mut k) "m")]
            (push! (mut steps) (SBind t (.code subject)))
            (pat! (mut k) (kid c 1) (sym t) (.ty subject) (mut steps) ""))
          (push! (mut steps)
                 (STest (.code (expect (mut k) c (expr (mut k) c "Bool") "Bool"))))))))

;;; `a and b and …`. A conjunct `x is P` binds P's names for the conjuncts after it:
;;; `s is [_, rest...] and glob?(p, rest)`.
(defn and-code [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))]
    (conjuncts! n (mut parts))
    (let [(mut binding) false]
      (for c parts (when (= (.kind c) (g/KIsE)) (set! binding true)))
      (if (not binding)
          (let [a
                  (expect (mut k)
                          (kid n 0)
                          (expr (mut k) (kid n 0) "Bool")
                          "Bool")
                b
                  (expect (mut k)
                          (kid n 1)
                          (expr (mut k) (kid n 1) "Bool")
                          "Bool")]
            (te `(and ~(.code a) ~(.code b)) "Bool"))
          (let [mark (locals-mark (mut k))
                label (primitive/code-symbol ":" (fresh (mut k) "and"))
                (mut steps) (ArrayList::new [Step] (malloc-allocator))]
            (for c parts
              (if (= (.kind c) (g/KIsE))
                  (let [subject (expr (mut k) (kid c 0) "")
                        t (fresh (mut k) "m")]
                    (push! (mut steps) (SBind t (.code subject)))
                    (pat! (mut k)
                          (kid c 1)
                          (sym t)
                          (.ty subject)
                          (mut steps)
                          ""))
                  (push! (mut steps)
                         (STest (.code (expect (mut k)
                                               c
                                               (expr (mut k) c "Bool")
                                               "Bool"))))))
            (locals-reset! (mut k) mark)
            (te `(block
                   ~label
                   ~(wrap-steps steps 0 `(return-from ~label true))
                   false)
                "Bool"))))))

(defn conjuncts! [(n g/Node) (out (mut (ArrayList g/Node)))] (-> void)
  (if (= (.kind n) (g/KAnd))
      (do (conjuncts! (kid n 0) (mut out)) (conjuncts! (kid n 1) (mut out)))
      (if (= (.kind n) (g/KGroup))
          (if (= (.kind (kid n 0)) (g/KAnd))
              (conjuncts! (kid n 0) (mut out))
              (push! (mut out) n))
          (push! (mut out) n))))

;;; `e where x = …, y = …`: each name an equation, which may use the others in any order but not
;;; itself; each is worked out once, before `e`, in an order where what it uses comes first.
(defn where-code [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        lets (where-open! (mut k) n)
        body (stmt (mut k) (kid n 0) want)]
    (locals-reset! (mut k) mark)
    (te `(let [~@lets] ~(.code body)) (.ty body))))

;;; The order to work out equations in: each after the others it mentions. A circle stops.
(defn where-order [(inits (ArrayList g/Node))] (-> (ArrayList i64))
  (let [count (len inits)
        (mut names) (text-list)
        (mut done) (ArrayList::new [bool] (malloc-allocator))
        (mut order) (ArrayList::new [i64] (malloc-allocator))
        (mut uses) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
    (for i inits
      (do (push! (mut names) (.text (kid i 0))) (push! (mut done) false)))
    (for i inits
      (let [(mut mentioned) (text-list)
            (mut idx) (ArrayList::new [i64] (malloc-allocator))]
        (names-in! (kid i 1) (mut mentioned))
        (for j (range 0 count)
          (let [(mut hit) false]
            (for m mentioned (when (= m (get names j)) (set! hit true)))
            (when hit (push! (mut idx) j))))
        (push! (mut uses) idx)))
    (while (< (len order) count)
      (let [(mut progressed) false]
        (for j (range 0 count)
          (when (not (get done j))
            (let [(mut ready) true]
              (for u (get uses j)
                (unless (and (!= u j) (get done u)) (set! ready false)))
              (when ready
                (set! (mut done) j true)
                (push! (mut order) j)
                (set! progressed true)))))
        (unless progressed
          (panic "where: equations that use each other in a circle, or one that uses itself"))))
    order))

;;; A `where`'s equations, bound for what follows, as the bindings of a `let`.
(defn where-open! [(k (mut Comp)) (n g/Node)] (-> Code)
  (let [inits (list-kids (kid n 1))
        count (len inits)
        (mut names) (text-list)
        (mut done) (ArrayList::new [bool] (malloc-allocator))
        (mut order) (ArrayList::new [i64] (malloc-allocator))]
    (for i inits
      (let [nm (.text (kid i 0))]
        (for x names
          (when (= x nm)
            (die (mut k) i (cat3 "`" nm "` is defined twice here"))))
        (push! (mut names) nm)
        (push! (mut done) false)))
    ;; What each equation mentions of the others.
    (let [(mut uses) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
      (for i inits
        (let [(mut mentioned) (text-list)
              (mut idx) (ArrayList::new [i64] (malloc-allocator))]
          (names-in! (kid i 1) (mut mentioned))
          (for j (range 0 count)
            (let [(mut hit) false]
              (for m mentioned (when (= m (get names j)) (set! hit true)))
              (when hit (push! (mut idx) j))))
          (push! (mut uses) idx)))
      (while (< (len order) count)
        (let [(mut progressed) false]
          (for j (range 0 count)
            (when (not (get done j))
              (let [(mut ready) true]
                (for u (get uses j)
                  (unless (and (!= u j) (get done u)) (set! ready false)))
                (when ready
                  (set! (mut done) j true)
                  (push! (mut order) j)
                  (set! progressed true)))))
          (unless progressed
            (die (mut k)
                 n
                 "these equations use each other in a circle, or one uses itself"))))
      (let [(mut lets) (primitive/code-list-new)]
        (for j order
          (let [i (get inits j)
                v (expr (mut k) (kid i 1) "")
                s (bind-local! (mut k) (get names j) (.ty v) false)]
            (push! (mut lets) (sym s))
            (push! (mut lets) (.code v))))
        `(~@lets)))))

;;; Every name an expression mentions, whatever it means there: not a field's name, `p.at`'s `at`
;;; or the `at:` of `Place(at: …)`.
(defn names-in! [(n g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (cond (= (.kind n) (g/KName)) (push! (mut out) (.text n))
        (= (.kind n) (g/KFieldE)) (names-in! (kid n 0) (mut out))
        (or (= (.kind n) (g/KFieldInit)) (= (.kind n) (g/KNamed)))
          (names-in! (kid n 1) (mut out))
        :else (for c (.kids n) (names-in! c (mut out)))))

;; ---------------------------------------------------------------- loops

(defstruct HeadInfo
  [(wrap-kind i64)  ; 0 list, 1 map keys, 2 text, 3 range, 4 query, 5 list by pattern, 6 from n up,
   ; 11 an option's value
   (alts (ArrayList PatAlt))
   (var (slice u8))
   (seq Code)
   (hi Code)
   (lets Code)
   (row (slice u8))
   (tests Code)
   (binds Code)])

(defn empty-code [] (-> Code)
  `())

;;; One alternative of a pattern loop head: its tests and bindings, then `moves`, which give the
;;; names it bound to the symbols the loop's body was compiled against.
(defstruct PatAlt [(steps (ArrayList Step)) (moves Code)])

(defstruct Bound [(name (slice u8)) (ty (slice u8)) (sym (slice u8))])

(defn no-alts [] (-> (ArrayList PatAlt))
  (ArrayList::new [PatAlt] (malloc-allocator)))

(defn top-alternatives [(p g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (ArrayList::new [g/Node] (malloc-allocator))]
    (if (= (.kind p) (g/KPOr))
        (do
          (push! (mut out) (kid p 0))
          (for q (list-kids (kid p 1)) (push! (mut out) q)))
        (push! (mut out) p))
    out))

;;; `for Pat in xs`: the items that match.
(defn pat-head-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (let [e (expr (mut k) (kid h 1) "")
        t (.ty e)
        _
          (unless (list? t)
            (die (mut k)
                 h
                 (cat "a pattern can only take the items of a list, not of " t)))
        v (fresh (mut k) "item")]
    (HeadInfo
      :wrap-kind 5
      :alts (pattern-alts! (mut k) h (kid h 0) v (elem-of t))
      :var v
      :seq (.code e)
      :hi `0
      :lets (empty-code)
      :row ""
      :tests (empty-code)
      :binds (empty-code))))

;;; `if let Pat = e` in a comprehension: on only when `e` matches.
(defn let-clause-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (let [e (expr (mut k) (kid h 1) "")
        v (fresh (mut k) "value")]
    (HeadInfo
      :wrap-kind 8
      :alts (pattern-alts! (mut k) h (kid h 0) v (.ty e))
      :var v
      :seq (.code e)
      :hi `0
      :lets (empty-code)
      :row ""
      :tests (empty-code)
      :binds (empty-code))))

;;; A pattern's alternatives against the value in `v`, each alternative of an or-pattern in turn.
;;; Every alternative must bind the same names, with the same types; they are bound for what follows.
(defn pattern-alts! [(k (mut Comp))
                     (h g/Node)
                     (pattern g/Node)
                     (v (slice u8))
                     (elem (slice u8))] (-> (ArrayList PatAlt))
  (let [(mut shapes) (ArrayList::new [(ArrayList Bound)] (malloc-allocator))
        (mut steps-of) (ArrayList::new [(ArrayList Step)] (malloc-allocator))]
    (for alt (top-alternatives pattern)
      (let [mark (locals-mark (mut k))
            (mut steps) (ArrayList::new [Step] (malloc-allocator))
            (mut bound) (ArrayList::new [Bound] (malloc-allocator))]
        (pat! (mut k) alt (sym v) elem (mut steps) "")
        (for i (range mark (len (.locals k)))
          (let [l (get (.locals k) i)]
            (push! (mut bound)
                   (Bound
                     :name (.name l)
                     :ty (.ty l)
                     :sym (.sym l)))))
        (locals-reset! (mut k) mark)
        (push! (mut shapes) bound)
        (push! (mut steps-of) steps)))
    (let [first-shape (get shapes 0)
          (mut shared) (ArrayList::new [Bound] (malloc-allocator))
          (mut alts) (no-alts)]
      (for b first-shape
        (push! (mut shared)
               (Bound
                 :name (.name b)
                 :ty (.ty b)
                 :sym (bind-local! (mut k) (.name b) (.ty b) false))))
      (for i (range 0 (len shapes))
        (let [shape (get shapes i)
              (mut moves) (primitive/code-list-new)]
          (unless (= (len shape) (len shared))
            (die (mut k)
                 h
                 "each alternative of this pattern must bind the same names"))
          (for b shared
            (let [(mut found) false]
              (for x shape
                (when (= (.name x) (.name b))
                  (unless (= (.ty x) (.ty b))
                    (die (mut k)
                         h
                         (cat4 (.name b)
                               " is a "
                               (.ty x)
                               (cat " in one alternative and a " (.ty b)))))
                  (set! found true)
                  (push! (mut moves) (sym (.sym b)))
                  (push! (mut moves) (sym (.sym x)))))
              (unless found
                (die (mut k)
                     h
                     (cat4 "one alternative of this pattern does not bind "
                           (.name b)
                           ""
                           "")))))
          (push! (mut alts) (PatAlt :steps (get steps-of i) :moves `(~@moves)))))
      alts)))

;;; `n..` has no end: only what stops at an answer, `first`, `any` and `all`, may count up forever.
(defn bounded! [(k (mut Comp)) (h g/Node)] (-> bool)
  (when (= (.kind h) (g/KFromHead))
    (die (mut k)
         h
         "`x in n..` has no end, so only first, any and all, which stop at an answer, can take it"))
  true)

(defn head-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (match (.kind h)
    (g/KRangeHead []
                  (let [lo
                          (expect (mut k)
                                  (kid h 1)
                                  (expr (mut k) (kid h 1) "Int")
                                  "Int")
                        hi
                          (expect (mut k)
                                  (kid h 2)
                                  (expr (mut k) (kid h 2) "Int")
                                  "Int")
                        v (bind-local! (mut k) (.text (kid h 0)) "Int" false)]
                    (HeadInfo
                      :wrap-kind 3
                      :alts (no-alts)
                      :var v
                      :seq (.code lo)
                      :hi (.code hi)
                      :lets (empty-code)
                      :row ""
                      :tests (empty-code)
                      :binds (empty-code))))
    (g/KFromHead []
                 (let [lo
                         (expect (mut k)
                                 (kid h 1)
                                 (expr (mut k) (kid h 1) "Int")
                                 "Int")
                       v (bind-local! (mut k) (.text (kid h 0)) "Int" false)]
                   (HeadInfo
                     :wrap-kind 6
                     :alts (no-alts)
                     :var v
                     :seq (.code lo)
                     :hi `0
                     :lets (empty-code)
                     :row ""
                     :tests (empty-code)
                     :binds (empty-code))))
    (g/KPatHead [] (pat-head-open! (mut k) h))
    ;; `x in [e]`: a list of one, which is only `e`; nothing is made.
    (g/KInHead []
               (if (and (= (.kind (kid h 1)) (g/KListLit))
                        (= (len (list-kids (kid (kid h 1) 0))) 1)
                        (not (spread-arg? (get (list-kids (kid (kid h 1) 0)) 0))))
                   (let [e
                           (expr (mut k)
                                 (get (list-kids (kid (kid h 1) 0)) 0)
                                 "")
                         v (bind-local! (mut k) (.text (kid h 0)) (.ty e) false)]
                     (HeadInfo
                       :wrap-kind 12
                       :alts (no-alts)
                       :var v
                       :seq (.code e)
                       :hi `0
                       :lets (empty-code)
                       :row ""
                       :tests (empty-code)
                       :binds (empty-code)))
                   (let [e (expr (mut k) (kid h 1) "")
                         t (.ty e)
                         kind
                           (cond (list? t) 0
                                 (map? t) 1
                                 (= t "Text") 2
                                 (opt? t) 11
                                 :else
                                   (die (mut k) h (cat "cannot loop over " t)))
                         v
                           (bind-local! (mut k)
                                        (.text (kid h 0))
                                        (cond (list? t) (elem-of t)
                                              (map? t) (map-key t)
                                              (opt? t) (opt-of t)
                                              :else "Int")
                                        false)]
                     (HeadInfo
                       :wrap-kind kind
                       :alts (no-alts)
                       :var v
                       :seq (.code e)
                       :hi `0
                       :lets (empty-code)
                       :row ""
                       :tests (empty-code)
                       :binds (empty-code)))))
    (g/KQueryHead [] (query-open! (mut k) (kid h 0)))
    (_ (die (mut k) h "expected a loop head"))))

;;; `db.rel(a, ?x, _)`: rows matching the known columns, binding the `?` ones.
;;; A query of a database setting: noted as the rows of `rel` it can see, by the columns it gives
;;; (`parts`, each a value or `_`).
(defn query-note [(k (mut Comp)) (base g/Node) (rel (slice u8)) (parts Code)]
  (-> Code)
  (match (setting-part (mut k) base)
    (Some [p]
          (if (> (len (.fields p)) 0)
              (setting-note (mut k) base)
              (let [node (cat4 "s:" (.module p) "." (.name (.x p)))]
                `(do
                   (when (and (rt/dep-in-frame?) (rt/dep-wants-path? ~node))
                     (rt/dep-note-path! ~node (rt/query-path ~rel ~parts)))
                   0))))
    (None [] `0)))

;;; A query giving one column, `at` of `arity`, the value `v`: noted by number, as an element is.
(defn query-note-one [(k (mut Comp))
                      (base g/Node)
                      (rel (slice u8))
                      (arity i64)
                      (at i64)
                      (v Code)] (-> Code)
  (match (setting-part (mut k) base)
    (Some [p]
          (if (> (len (.fields p)) 0)
              (setting-note (mut k) base)
              (let [node (cat4 "s:" (.module p) "." (.name (.x p)))
                    (mut prefix) (cat3 "." rel "(")
                    (mut suffix) ")"]
                (for _ (range 0 at) (set! prefix (cat prefix "_,")))
                (for _ (range (+ at 1) arity) (set! suffix (cat ",_" suffix)))
                `(do
                   (when (rt/dep-in-frame?)
                     (rt/dep-note-numbered! (primitive/alloc-static i64)
                                            ~node
                                            ~prefix
                                            ~suffix
                                            ~v))
                   0))))
    (None [] `0)))

;;; A read of a setting through its place, as a query of a database setting reads it: noted, as
;;; any read of a setting is, for the memo computing now. Nothing for a base that is no setting.
(defn setting-note [(k (mut Comp)) (base g/Node)] (-> Code)
  (match (setting-part (mut k) base)
    (Some [p]
          (let [node (cat4 "s:" (.module p) "." (.name (.x p)))]
            `(do
               (when (rt/dep-in-frame?)
                 ~(if (= (len (.fields p)) 0)
                      `(rt/dep-note-literal! ~node)
                      `(rt/dep-note-fixed! (primitive/alloc-static i64)
                                           ~node
                                           ~(fields-path (.fields p)))))
               0)))
    (None [] `0)))

(defn query-open! [(k (mut Comp)) (call g/Node)] (-> HeadInfo)
  (unless (and (= (.kind call) (g/KCall)) (= (.kind (kid call 0)) (g/KFieldE)))
    (die (mut k) call "a query is db.relation(columns)"))
  (let [rel-name (.text (kid (kid call 0) 1))
        base (kid (kid call 0) 0)
        db (if (is-place? base) (place (mut k) base) (expr (mut k) base ""))
        rel-of `(~(primitive/code-symbol "." rel-name) ~(.code db))
        held (writable? (mut k) base)
        copy (fresh (mut k) "rel")
        rel-code (if held `(mut ~rel-of) `(mut ~(sym copy)))
        args (list-kids (kid call 1))
        (mut lets) (primitive/code-list-new)
        (mut tests) (primitive/code-list-new)
        (mut binds) (primitive/code-list-new)
        row (fresh (mut k) "row")
        rowsym (sym row)
        (mut key-col) -1
        (mut key-sym) ""
        (mut specs) (primitive/code-list-new)
        (mut bound-count) 0
        (mut bound-at) -1
        (mut bound-sym) `0]
    (rel-check (mut k) call (.ty db) rel-name (len args))
    ;; A query only reads, though it may build an index as it goes. A relation's indexes live in
    ;; storage its copies share, so one held by `let` (or made by a call) is read through a copy.
    (unless held
      (push! (mut lets) `(mut ~(sym copy)))
      (push! (mut lets) rel-of))
    (for i (range 0 (len args))
      (let [a (get args i)]
        (cond (= (.kind a) (g/KQvar))
                (do (push! (mut specs) `(push! (mut parts) "_")) 0)
              (and (= (.kind a) (g/KName)) (= (.text a) "_"))
                (do (push! (mut specs) `(push! (mut parts) "_")) 0)
              :else
                (let [v (expect (mut k) a (expr (mut k) a "Int") "Int")
                      t (fresh (mut k) "key")]
                  (push! (mut specs)
                         `(push! (mut parts) (rt/num-text ~(sym t))))
                  (set! bound-count (+ bound-count 1))
                  (set! bound-at i)
                  (set! bound-sym (sym t))
                  (push! (mut lets) (sym t))
                  (push! (mut lets) (.code v))
                  (if (< key-col 0)
                      (do (set! key-col i) (set! key-sym t))
                      (push! (mut tests)
                             `(= (rt/rel-at ~rel-code ~rowsym ~i) ~(sym t))))))))
    (for i (range 0 (len args))
      (let [a (get args i)]
        (when (= (.kind a) (g/KQvar))
          (let [v
                  (bind-local! (mut k)
                               (subslice (.text a) 1 (len (.text a)))
                               "Int"
                               false)]
            (push! (mut binds) (sym v))
            (push! (mut binds) `(rt/rel-at ~rel-code ~rowsym ~i))))))
    ;; The rows it can see are what it reads: its relation, by the columns it gives.
    (push! (mut lets) (sym (fresh (mut k) "noted")))
    (push! (mut lets)
           (if (= bound-count 1)
               (query-note-one (mut k)
                               base
                               rel-name
                               (len args)
                               bound-at
                               bound-sym)
               (query-note (mut k)
                           base
                           rel-name
                           `(let [(mut parts)
                                    (ArrayList::new [(slice u8)]
                                                    (rt/value-allocator))]
                              ~@specs
                              parts))))
    ;; A row an update took out stays where it was until the relation is made again: passed by.
    (push! (mut tests) `(rt/rel-live-row? ~rel-code ~rowsym))
    (HeadInfo
      :wrap-kind 4
      :alts (no-alts)
      :var ""
      :seq
        (if (>= key-col 0)
            `(rt/rel-bucket ~rel-code ~key-col ~(sym key-sym))
            `(range 0 (.count ~(if held rel-of (sym copy)))))
      :hi `0
      :lets `(~@lets)
      :row row
      :tests `(~@tests)
      :binds `(~@binds))))

(defn rel-check [(k (mut Comp))
                 (n g/Node)
                 (db-ty (slice u8))
                 (rel (slice u8))
                 (count i64)] (-> void)
  (unless (and (> (last-dot db-ty) 0) (= (type-name db-ty) "Db"))
    (die (mut k)
         n
         (cat "a relation is read from a fact database, but this is " db-ty)))
  (match (find-rel (mod-at (mut k) (type-module db-ty)) rel)
    (None []
          (die (mut k)
               n
               (cat4 (type-module db-ty) " has no relation named " rel "")))
    (Some [r]
          (unless (= (.arity r) count)
            (die (mut k)
                 n
                 (cat4 rel " has " (rt/num-text (.arity r)) " columns"))))))

;;; `inner` under the first alternative that matches.
(defn alts-code [(k (mut Comp)) (alts (ArrayList PatAlt)) (inner Code)]
  (-> Code)
  (if (= (len alts) 1)
      (let [a (get alts 0)]
        (wrap-steps (.steps a) 0 `(let [~@(.moves a)] ~inner)))
      (let [label (primitive/code-symbol ":" (fresh (mut k) "alt"))
            (mut tries) (primitive/code-list-new)]
        (for a alts
          (push! (mut tries)
                 (wrap-steps (.steps a)
                             0
                             `(let [~@(.moves a)] ~inner (return-from ~label 0)))))
        `(block ~label ~@tries 0))))

;;; A comprehension's clause, opened in order: a loop, a test, or a pattern.
(defn clause-open! [(k (mut Comp)) (c g/Node)] (-> HeadInfo)
  (match (.kind c)
    (g/KIfClause []
                 (let [t
                         (expect (mut k)
                                 (kid c 0)
                                 (expr (mut k) (kid c 0) "Bool")
                                 "Bool")]
                   (HeadInfo
                     :wrap-kind 7
                     :alts (no-alts)
                     :var ""
                     :seq (.code t)
                     :hi `0
                     :lets (empty-code)
                     :row ""
                     :tests (empty-code)
                     :binds (empty-code))))
    (g/KLetClause [] (let-clause-open! (mut k) c))
    (g/KWhileClause []
                    (let [t
                            (expect (mut k)
                                    (kid c 0)
                                    (expr (mut k) (kid c 0) "Bool")
                                    "Bool")]
                      (HeadInfo
                        :wrap-kind 9
                        :alts (no-alts)
                        :var ""
                        :seq (.code t)
                        :hi `0
                        :lets (empty-code)
                        :row ""
                        :tests (empty-code)
                        :binds (empty-code))))
    ;; A key that is none always passes: `distinct` then sees only the items that have one.
    (g/KDistinctClause []
                       (let [key (expr (mut k) (kid c 0) "")
                             t
                               (if (opt? (.ty key))
                                   (opt-of (.ty key))
                                   (.ty key))]
                         (unless (or (= t "Int") (= t "Text"))
                           (die (mut k)
                                (kid c 0)
                                (cat "distinct keys are Int or Text, or optionally one, not "
                                     (.ty key))))
                         (HeadInfo
                           :wrap-kind 10
                           :alts (no-alts)
                           :var (fresh (mut k) "seen")
                           :seq (.code key)
                           :hi `0
                           :lets (empty-code)
                           :row (.ty key)
                           :tests (empty-code)
                           :binds (empty-code))))
    (_ (do (bounded! (mut k) c) (head-open! (mut k) c)))))

(defn loop-kind? [(w i64)] (-> bool)
  (or (and (>= w 0) (<= w 6)) (= w 11) (= w 12)))

;;; A comprehension's opened clauses around `inner`, the first outermost. A `while` leaves the
;;; nearest loop before it; a `distinct` remembers, across the whole comprehension, the keys it let by.
(defn clauses-code [(k (mut Comp))
                    (cs (ArrayList g/Node))
                    (opened (ArrayList HeadInfo))
                    (inner Code)] (-> Code)
  (let [(mut labels) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut stops) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut seen) (primitive/code-list-new)]
    (for _ opened (do (push! (mut labels) "") (push! (mut stops) "")))
    (for i (range 0 (len opened))
      (let [h (get opened i)]
        (when (= (.wrap-kind h) 9)
          (let [(mut j) (- i 1)]
            (while (and (>= j 0) (not (loop-kind? (.wrap-kind (get opened j)))))
              (set! j (- j 1)))
            (when (< j 0)
              (die (mut k)
                   (get cs i)
                   "a `while` stops the loop before it, and there is none"))
            (when (= (len (get labels j)) 0)
              (set! (mut labels) j (fresh (mut k) "stop")))
            (set! (mut stops) i (get labels j))))
        (when (= (.wrap-kind h) 10)
          (push! (mut seen) `(mut ~(sym (.var h))))
          ;; Int keys are mostly few: kept in place, with no table (see `rt/int-seen`).
          (push! (mut seen)
                 (if (= (if (opt? (.row h)) (opt-of (.row h)) (.row h)) "Int")
                     `(rt/int-seen)
                     (new-map (mut k)
                              (cat3 "{"
                                    (if (opt? (.row h)) (opt-of (.row h)) (.row h))
                                    ":Bool}")))))))
    (let [(mut body) inner
          (mut i) (- (len opened) 1)]
      (while (>= i 0)
        (let [h (get opened i)]
          (cond (= (.wrap-kind h) 9)
                  (set! body
                        `(do
                           (unless ~(.seq h)
                             (return-from ~(primitive/code-symbol ":"
                                                                  (get stops i))
                                          0))
                           ~body))
                (= (.wrap-kind h) 10)
                  (let [kv (fresh (mut k) "key")
                        once
                          (if (= (if (opt? (.row h)) (opt-of (.row h)) (.row h)) "Int")
                              `(when (rt/int-seen-add! (mut ~(sym (.var h))) ~(sym kv))
                                 ~body)
                              `(unless (match (get ~(sym (.var h)) ~(sym kv))
                                         (Some [_] true)
                                         (None [] false))
                                 (set! (mut ~(sym (.var h))) ~(sym kv) true)
                                 ~body))]
                    (set! body
                          (if (opt? (.row h))
                              `(match ~(.seq h)
                                 (Some [~(sym kv)] (do ~once 0))
                                 (None [] (do ~body 0)))
                              `(let [~(sym kv) ~(.seq h)] ~once))))
                :else (set! body (head-wrap (mut k) h body)))
          (when (> (len (get labels i)) 0)
            (set! body
                  `(block ~(primitive/code-symbol ":" (get labels i)) ~body 0))))
        (set! i (- i 1)))
      `(let [~@seen] ~body))))

(defn head-wrap [(k (mut Comp)) (h HeadInfo) (inner Code)] (-> Code)
  (let [v (if (> (len (.var h)) 0) (sym (.var h)) `_)]
    (cond (= (.wrap-kind h) 0) `(for (ref ~v) ~(.seq h) ~inner)
          (= (.wrap-kind h) 1) `(for ~v ~(.seq h) ~inner)
          (= (.wrap-kind h) 2)
            (let [t (fresh (mut k) "c")]
              `(for ~(sym t) ~(.seq h) (let [~v (cast i64 ~(sym t))] ~inner)))
          (= (.wrap-kind h) 3) `(for ~v (range ~(.seq h) ~(.hi h)) ~inner)
          ;; An option is a list of none or one.
          (= (.wrap-kind h) 11)
            `(match ~(.seq h) (Some [~v] (do ~inner 0)) (None [] 0))
          (= (.wrap-kind h) 12) `(let [~v ~(.seq h)] ~inner)
          (= (.wrap-kind h) 5)
            `(for (ref ~v) ~(.seq h) ~(alts-code (mut k) (.alts h) inner))
          (= (.wrap-kind h) 7) `(when ~(.seq h) ~inner)
          (= (.wrap-kind h) 8)
            `(let [~v ~(.seq h)] ~(alts-code (mut k) (.alts h) inner))
          (= (.wrap-kind h) 6)
            `(let [(mut ~v) ~(.seq h)] (while true ~inner (set! ~v (+ ~v 1))))
          :else
            `(let [~@(.lets h)]
               (for ~(sym (.row h)) ~(.seq h)
                 (when (and ~@(.tests h) true)
                   (let [~@(.binds h)] ~inner)))))))

;; ---------------------------------------------------------------- places

;;; An expression as an addressable path, for `(mut …)`.
(defn place [(k (mut Comp)) (e g/Node)] (-> TE)
  (match (.kind e)
    (g/KName []
             (match (find-local (mut k) (.text e))
               (Some [l] (te (sym (.sym l)) (.ty l)))
               (None []
                     (let [m (self-mod (mut k))]
                       (match (find-global m (.text e))
                         (Some [x]
                               (te `(~(primitive/code-symbol "." (.name x)) ~(storage-call (mut k)
                                                                                           x))
                                   (.ty x)))
                         (None []
                               (die (mut k) e (cat "nothing named " (.text e)))))))))
    (g/KGroup [] (place (mut k) (kid e 0)))
    (g/KFieldE []
               (let [base (kid e 0)
                     field (.text (kid e 1))]
                 (match (module-prefix (mut k) base)
                   (Some [module]
                         (match (find-global (mod-at (mut k) module) field)
                           (Some [x]
                                 (te `(~(primitive/code-symbol "." field) ~(storage-of (mut k)
                                                                                       module
                                                                                       x))
                                     (.ty x)))
                           (None []
                                 (die (mut k)
                                      e
                                      (cat4 module
                                            " has no state named "
                                            field
                                            "")))))
                   (None []
                         (let [b (place (mut k) base)]
                           (when (boxed-record? (mut k) (.ty b))
                             (die (mut k) e "boxed records are immutable; replace the value with `with { ... }`"))
                           (when (named-child? (mut k) (.ty b) field)
                             (die (mut k)
                                  e
                                  (cat3 "a node's children do not change in place; make a new node with `with { "
                                        field
                                        ": ... }`")))
                           (te `(~(primitive/code-symbol "." field) ~(.code b))
                               (field-type (mut k) e (.ty b) field)))))))
    (g/KIndex []
              (let [b (place (mut k) (kid e 0))]
                (unless (list? (.ty b))
                  (die (mut k)
                       e
                       (cat "only a list's element is a place, not one of "
                            (.ty b))))
                (let [i
                        (expect (mut k)
                                (kid e 1)
                                (expr (mut k) (kid e 1) "Int")
                                "Int")]
                  (te `(elem (mut ~(.code b)) ~(.code i)) (elem-of (.ty b))))))
    (_ (die (mut k) e "this cannot be assigned or passed by reference"))))

;;; A named child: each kind that names a child `field`, and where that child is.
(defstruct Slot [(kind (slice u8)) (index i64)])

(defn child-slots [(gr Mod) (field (slice u8))] (-> (ArrayList Slot))
  (let [(mut out) (ArrayList::new [Slot] (malloc-allocator))]
    (for e (.kinds gr)
      (for i (range 0 (len (.fields e)))
        (when (= (get (.fields e) i) field)
          (push! (mut out) (Slot :kind (.name e) :index i)))))
    out))

(defn node-builtin-field? [(field (slice u8))] (-> bool)
  (or (= field "text")
      (= field "lo")
      (= field "hi")
      (= field "gen")
      (= field "kids")
      (= field "kind")))

(defn named-child? [(k (mut Comp)) (ty (slice u8)) (field (slice u8))] (-> bool)
  (and (not (builtin-type? ty))
       (> (last-dot ty) 0)
       (= (type-name ty) "Node")
       (not (node-builtin-field? field))
       (> (len (child-slots (mod-at (mut k) (type-module ty)) field)) 0)))

;;; `n.field`: the child of that name, wherever this node's kind keeps it. A kind with no child of
;;; that name is a mistake in the program, so it stops.
(defn child-code [(k (mut Comp)) (ty (slice u8)) (field (slice u8)) (code Code)]
  (-> Code)
  (let [gr (mod-at (mut k) (type-module ty))
        x (sym (fresh (mut k) "n"))]
    `(let [~x ~code]
       (get (.kids ~x) ~(child-index-code (mut k) gr field x)))))

;;; Whether `base` is a name a rewrite's pattern bound, with a rewritten form.
(defn out-bound? [(k (mut Comp)) (base g/Node)] (-> bool)
  (and (= (.kind base) (g/KName))
       (match (find-local (mut k) (.text base))
         (Some [l]
               (let [(mut hit) false]
                 (for o (.outs k) (when (= (.sym o) (.sym l)) (set! hit true)))
                 hit))
         (None [] false))))

;;; `x.out` in a rewrite: what the child `x` became, or with the rule's `as` name, the node rebuilt
;;; from its children's.
(defn out-of [(k (mut Comp)) (n g/Node) (base g/Node)] (-> Code)
  (let [(mut hit) (None [Code])]
    (when (= (.kind base) (g/KName))
      (match (find-local (mut k) (.text base))
        (Some [l]
              (for o (.outs k)
                (when (= (.sym o) (.sym l)) (set! hit (Some (.code o))))))
        (None [] 0)))
    (match hit
      (Some [c] c)
      (None []
            (die (mut k)
                 n
                 "only in a rewrite, of its node or of a child its pattern names, is there an `out`")))))

;;; Where node `x` keeps its child `field`.
(defn child-index-code [(k (mut Comp)) (gr Mod) (field (slice u8)) (x Code)]
  (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for s (child-slots gr field)
      (push! (mut arms) `(~(kind-code gr (.kind s)) [] ~(.index s))))
    `(match (.kind ~x)
       ~@arms
       (_ (panic ~(cat "a {} node has no child named " field)
                 (~(primitive/code-symbol (alias-of (.name gr)) "/kind-name") (.kind ~x)))))))

;;; `base` names an imported module, rather than a value.
(defn module-prefix [(k (mut Comp)) (base g/Node)] (-> (Option (slice u8)))
  (if (and (= (.kind base) (g/KName))
           (match (find-local (mut k) (.text base))
             (Some [_] false)
             (None [] true)))
      (alias-target (self-mod (mut k)) (.text base))
      (None [(slice u8)])))

(defn field-type [(k (mut Comp)) (n g/Node) (ty (slice u8)) (field (slice u8))]
  (-> (slice u8))
  (cond (builtin-type? ty)
          (die (mut k) n (cat4 ty " has no field named " field ""))
        (or (list? ty) (map? ty) (opt? ty) (fn? ty))
          (die (mut k) n (cat4 ty " has no field named " field ""))
        (= (type-name ty) "Node")
          (cond (= field "text") "Text"
                (= field "lo") "Int"
                (= field "hi") "Int"
                (= field "gen") "Int"
                (= field "kids") (cat3 "[" ty "]")
                (= field "kind") (cat (type-module ty) ".Kind")
                (> (len (child-slots (mod-at (mut k) (type-module ty)) field))
                   0)
                  ty
                :else
                  (die (mut k)
                       n
                       (cat4 "a node has text, lo, hi, kids, kind and its grammar's named children, not "
                             field
                             ""
                             "")))
        :else
          (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
            (None [] (die (mut k) n (cat4 ty " has no field named " field "")))
            (Some [r]
                  (let [(mut out) ""]
                    (for f (.fields r)
                      (when (= (.name f) field) (set! out (.ty f))))
                    (when (= (len out) 0)
                      (die (mut k) n (cat4 ty " has no field named " field "")))
                    out)))))

;; ---------------------------------------------------------------- calls

(defn args-code [(k (mut Comp))
                 (n g/Node)
                 (module (slice u8))
                 (f Func)
                 (args (ArrayList g/Node))]
  (-> Code)
  (unless (= (len args) (len (.params f)))
    (die (mut k)
         n
         (cat4 (.name f)
               " takes "
               (rt/num-text (len (.params f)))
               (cat " arguments, this has " (rt/num-text (len args))))))
  (let [(mut out) (primitive/code-list-new)]
    (for i (range 0 (len args))
      (let [p (get (.params f) i)
            a (get args i)]
        (if (.by-ref p)
            (let [x (place (mut k) a)]
              (unless (= (.ty x) (.ty p))
                (die (mut k) a (cat4 "expected " (.ty p) ", found " (.ty x))))
              (push! (mut out) `(mut ~(.code x))))
            (match (narrowed-arg (mut k) a module f i)
              (Some [x] (push! (mut out) x))
              (None []
                    (let [x (expect (mut k) a (expr (mut k) a (.ty p)) (.ty p))]
                      (push! (mut out) (.code x))))))))
    `(~@out)))

;;; A setting, or a part of one, passed to a function of the program that reads only some fields of
;;; that parameter, through all it passes it to: while dependencies are tracked, a memo that calls it
;;; is made from those fields only, as if it had read each itself.
(defn narrowed-arg [(k (mut Comp))
                    (a g/Node)
                    (module (slice u8))
                    (f Func)
                    (i i64)] (-> (Option Code))
  (if (or (> (.quiet k) 0) (not (= (.sort (mod-at (mut k) module)) (SRules))))
      (None [Code])
      (match (setting-part (mut k) a)
        (None [] (None [Code]))
        (Some [sp]
              (let [read (pl/param-paths (mut (.checker k)) module (.name f) i)]
                (if (.whole read)
                    (None [Code])
                    (let [node (cat4 "s:" (.module sp) "." (.name (.x sp)))
                          base (fields-path (.fields sp))
                          v (fresh (mut k) "narrowed")
                          (mut notes) (primitive/code-list-new)]
                      (for field (.fields read)
                        (push! (mut notes)
                               `(rt/dep-note-fixed! (primitive/alloc-static i64)
                                                    ~node
                                                    ~(cat base field))))
                      (set! (.quiet k) (+ (.quiet k) 1))
                      (let [x
                              (expect (mut k)
                                      a
                                      (expr (mut k) a (.ty (get (.params f) i)))
                                      (.ty (get (.params f) i)))]
                        (set! (.quiet k) (- (.quiet k) 1))
                        (Some `(let [~(sym v) ~(.code x)]
                                 (when (rt/dep-in-frame?) ~@notes 0)
                                 ~(sym v)))))))))))

(defn call-func [(k (mut Comp))
                 (n g/Node)
                 (module (slice u8))
                 (f Func)
                 (args (ArrayList g/Node))] (-> TE)
  (match (accessor-read (mut k) n module f args)
    (Some [t] t)
    (None []
          (match (mutated-setting (mut k) n module f args)
            (Some [t] t)
            (None []
                  (let [cs (args-code (mut k) n module f args)]
                    (te `(~(sym (qualified (mut k) module (.coil f))) ~@cs)
                        (.ret f))))))))

;;; A foreign function that changes a setting in place, one whose declaration says what it may
;;; change (`changes`): each of those read before and after, and what is not the same changed, as a
;;; setting given again changes what read it (see `setting-changed-code`); the setting is to be saved
;;; again. Which of the module's functions read it are named with the mutator's parameters.
(defn mutated-setting [(k (mut Comp))
                       (n g/Node)
                       (module (slice u8))
                       (f Func)
                       (args (ArrayList g/Node))]
  (-> (Option TE))
  (let [key (cat3 module "/" (.name f))
        (mut calls) (None [(ArrayList g/Node)])]
    (for m (.mutators k) (when (= (.key m) key) (set! calls (Some (.calls m)))))
    (match calls
      (None [] (None [TE]))
      (Some [cs]
            (match (if (> (len args) 0)
                       (setting-part (mut k) (get args 0))
                       (None [SettingPart]))
              (None [] (None [TE]))
              (Some [sp]
                    (if (> (len (.fields sp)) 0)
                        (None [TE])
                        (let [node (cat4 "s:" (.module sp) "." (.name (.x sp)))
                              target (place (mut k) (get args 0))
                              storage
                                (if (= (.module sp) (.self k))
                                    (storage-call (mut k) (.x sp))
                                    (storage-of (mut k) (.module sp) (.x sp)))
                              (mut binds) (primitive/code-list-new)
                              (mut arg-syms)
                                (ArrayList::new [Code] (malloc-allocator))
                              (mut call-args) (primitive/code-list-new)
                              (mut befores) (primitive/code-list-new)
                              (mut afters) (primitive/code-list-new)
                              (mut checks) (primitive/code-list-new)
                              result (fresh (mut k) "mutated")
                              any (fresh (mut k) "changed")]
                          (push! (mut call-args) `(mut ~(.code target)))
                          (for i (range 1 (len args))
                            (let [p (get (.params f) i)
                                  v (fresh (mut k) "arg")]
                              (push! (mut binds) (sym v))
                              (push! (mut binds)
                                     (.code (expect (mut k)
                                                    (get args i)
                                                    (expr (mut k)
                                                          (get args i)
                                                          (.ty p))
                                                    (.ty p))))
                              (push! (mut arg-syms) (sym v))
                              (push! (mut call-args) (sym v))))
                          (for c cs
                            (unless (and (= (.kind c) (g/KCall))
                                         (= (.kind (kid c 0)) (g/KName)))
                              (die (mut k)
                                   c
                                   "changes names calls of the module's functions"))
                            (let [g
                                    (match (find-func (mod-at (mut k) module)
                                                      (.text (kid c 0)))
                                      (Some [g] g)
                                      (None []
                                            (die (mut k)
                                                 c
                                                 (cat "no function named "
                                                      (.text (kid c 0))))))
                                  b (fresh (mut k) "before")
                                  a (fresh (mut k) "after")
                                  (mut gargs) (primitive/code-list-new)
                                  (mut parts) (primitive/code-list-new)
                                  cargs (list-kids (kid c 1))]
                              (when (and (= (len (.params g)) 2)
                                         (= (.ty (get (.params g) 1)) "Int"))
                                (die (mut k)
                                     c
                                     "changes cannot name a function read by number"))
                              (for j (range 0 (len cargs))
                                (let [at (param-at f (.text (get cargs j)))]
                                  (when (< at 0)
                                    (die (mut k)
                                         (get cargs j)
                                         "changes names the function's own parameters"))
                                  (if (= j 0)
                                      (do
                                        (unless (= at 0)
                                          (die (mut k)
                                               (get cargs j)
                                               "what changes is the first argument"))
                                        (push! (mut gargs) (.code target)))
                                      (let [v (get arg-syms (- at 1))]
                                        (push! (mut gargs) v)
                                        (push! (mut parts)
                                               `(push! (mut parts)
                                                       ~(plain-text-code (.ty (get (.params g)
                                                                                   j))
                                                                         v)))))))
                              (let [fcall
                                      `(~(sym (qualified (mut k)
                                                         module
                                                         (.coil g))) ~@gargs)
                                    path
                                      `(~(if (any-text-param? g)
                                             `rt/call-path-text
                                             `rt/call-path) ~(.name g)
                                          (let [(mut parts)
                                                  (ArrayList::new [(slice u8)]
                                                                  (rt/value-allocator))]
                                            ~@parts
                                            parts))]
                                (push! (mut befores) (sym b))
                                (push! (mut befores) fcall)
                                (push! (mut afters) (sym a))
                                (push! (mut afters) fcall)
                                (push! (mut checks)
                                       `(unless ~(same-code (mut k)
                                                            (.ret g)
                                                            (sym b)
                                                            (sym a))
                                          (set! ~(sym any) true)
                                          (when (rt/dep-tracking?)
                                            (rt/dep-changed! (rt/join ~node
                                                                      ~path))))))))
                          (Some (te `(let [~@binds ~@befores
                                           ~(sym result)
                                             (~(sym (qualified (mut k)
                                                               module
                                                               (.coil f))) ~@call-args)
                                           ~@afters (mut ~(sym any))
                                           false]
                                       ~@checks
                                       (when ~(sym any)
                                         (set! (~(primitive/code-symbol "."
                                                                        (dirty-field (.name (.x sp)))) ~storage)
                                               1)
                                         (if (rt/dep-tracking?)
                                             (rt/dep-changed! ~node)
                                             (rt/forget-readers! ~(cat3 (.module sp)
                                                                        "."
                                                                        (.name (.x sp))))))
                                       ~(sym result))
                                    (.ret f)))))))))))

(defn param-at [(f Func) (name (slice u8))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.params f)))
      (when (= (.name (get (.params f) i)) name) (set! at i)))
    at))

;;; A foreign module's function that looks into one value, given plain values besides: what
;;; `sym.symbol-at(table, s)` is. Applied to a setting, it reads just what it answers.
(defn accessor? [(k (mut Comp)) (module (slice u8)) (f Func)] (-> bool)
  (and (= (.sort (mod-at (mut k) module)) (SForeign))
       (> (len (.params f)) 0)
       (not (.by-ref (get (.params f) 0)))
       (not (= (.ret f) "Void"))
       (let [(mut ok) true]
         (for i (range 1 (len (.params f)))
           (let [p (get (.params f) i)]
             (unless (and (not (.by-ref p))
                          (or (= (.ty p) "Int")
                              (= (.ty p) "Text")
                              (= (.ty p) "Bool")))
               (set! ok false))))
         ok)))

(defn any-text-param? [(f Func)] (-> bool)
  (let [(mut hit) false]
    (for i (range 1 (len (.params f)))
      (when (= (.ty (get (.params f) i)) "Text") (set! hit true)))
    hit))

(defn plain-text-code [(t (slice u8)) (v Code)] (-> Code)
  (cond (= t "Int") `(rt/num-text ~v)
        (= t "Bool") `(if ~v "1" "0")
        :else v))

;;; While dependencies are tracked, a memo that calls an accessor on a setting is made from what the
;;; call answers: binding the setting again changes it only if the call answers otherwise.
(defn accessor-read [(k (mut Comp))
                     (n g/Node)
                     (module (slice u8))
                     (f Func)
                     (args (ArrayList g/Node))]
  (-> (Option TE))
  (if (or (> (.quiet k) 0)
          (= (len args) 0)
          (!= (len args) (len (.params f)))
          (not (accessor? (mut k) module f)))
      (None [TE])
      (match (setting-part (mut k) (get args 0))
        (Some [sp]
              (if (> (len (.fields sp)) 0)
                  (None [TE])
                  (let [node (cat4 "s:" (.module sp) "." (.name (.x sp)))
                        (mut binds) (primitive/code-list-new)
                        (mut call-args) (primitive/code-list-new)
                        (mut texts) (primitive/code-list-new)
                        (mut arg1) `0]
                    (set! (.quiet k) (+ (.quiet k) 1))
                    (let [first
                            (expect (mut k)
                                    (get args 0)
                                    (expr (mut k)
                                          (get args 0)
                                          (.ty (get (.params f) 0)))
                                    (.ty (get (.params f) 0)))
                          v0 (fresh (mut k) "of")]
                      (set! (.quiet k) (- (.quiet k) 1))
                      (push! (mut binds) (sym v0))
                      (push! (mut binds) (.code first))
                      (push! (mut call-args) (sym v0))
                      (for i (range 1 (len args))
                        (let [p (get (.params f) i)
                              a
                                (expect (mut k)
                                        (get args i)
                                        (expr (mut k) (get args i) (.ty p))
                                        (.ty p))
                              v (fresh (mut k) "arg")]
                          (push! (mut binds) (sym v))
                          (push! (mut binds) (.code a))
                          (push! (mut call-args) (sym v))
                          (when (= i 1) (set! arg1 (sym v)))
                          (push! (mut texts)
                                 `(push! (mut parts)
                                         ~(plain-text-code (.ty p) (sym v))))))
                      (let [texty (any-text-param? f)
                            note
                              (if (and (= (len (.params f)) 2)
                                       (= (.ty (get (.params f) 1)) "Int"))
                                  `(rt/dep-note-numbered! (primitive/alloc-static i64)
                                                          ~node
                                                          ~(cat3 "@"
                                                                 (.name f)
                                                                 "(")
                                                          ")"
                                                          ~arg1)
                                  `(rt/dep-note-path! ~node
                                                      (~(if texty
                                                            `rt/call-path-text
                                                            `rt/call-path) ~(.name f)
                                                         (let [(mut parts)
                                                                 (ArrayList::new [(slice u8)]
                                                                                 (rt/value-allocator))]
                                                           ~@texts
                                                           parts))))]
                        (Some (te `(let [~@binds]
                                     (when (and (rt/dep-in-frame?)
                                                (rt/dep-wants-path? ~node))
                                       ~note)
                                     (~(sym (qualified (mut k) module (.coil f))) ~@call-args))
                                  (.ret f))))))))
        (None [] (None [TE])))))

;;; Calls the language itself understands, for any element type.
(defn builtin-call [(k (mut Comp))
                    (n g/Node)
                    (name (slice u8))
                    (args (ArrayList g/Node))] (-> (Option TE))
  (let [count (len args)]
    (cond (and (= name "len") (= count 1))
            (Some (te `(len ~(.code (expr (mut k) (get args 0) ""))) "Int"))
          (and (= name "is-some") (= count 1))
            (Some (te `(match ~(.code (expr (mut k) (get args 0) ""))
                         (Some [_] true)
                         (None [] false))
                      "Bool"))
          (and (= name "is-none") (= count 1))
            (Some (te `(match ~(.code (expr (mut k) (get args 0) ""))
                         (Some [_] false)
                         (None [] true))
                      "Bool"))
          (and (= name "pop") (= count 1))
            (let [p (place (mut k) (get args 0))]
              (Some (te `(pop! (mut ~(.code p))) "Void")))
          (and (= name "clear") (= count 1))
            (let [p (place (mut k) (get args 0))]
              (Some (te `(clear! (mut ~(.code p))) "Void")))
          (and (= name "last") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "l")]
              (unless (list? (.ty e)) (die (mut k) n "last needs a list"))
              (Some (te `(let [~(sym t) ~(.code e)]
                           (get ~(sym t) (- (len ~(sym t)) 1)))
                        (elem-of (.ty e)))))
          (and (or (= name "max") (= name "min")) (= count 2))
            (let [a
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Int")
                            "Int")
                  b
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "Int")
                            "Int")
                  x (fresh (mut k) "a")
                  y (fresh (mut k) "b")]
              (Some (te `(let [~(sym x) ~(.code a)
                               ~(sym y) ~(.code b)]
                           (if ~(if (= name "max")
                                    `(> ~(sym x) ~(sym y))
                                    `(< ~(sym x) ~(sym y)))
                               ~(sym x)
                               ~(sym y)))
                        "Int")))
          ;; `tally(keys)`: how many times each key is in the list. `tally(keys, weights)`: the sum of the
          ;; weights at each key's places.
          ;; `updated(xs, {k: v for …})`: `xs` with each value at its key's place, as the comprehension
          ;; makes them, a later one over an earlier one; no map is made.
          (and (= name "updated")
               (= count 2)
               (= (.kind (get args 1)) (g/KMapComp)))
            (let [xs (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty xs))
                      (die (mut k)
                           n
                           (cat "updated takes a list, not " (.ty xs))))
                  comp (get args 1)
                  o (fresh (mut k) "out")
                  key-v (fresh (mut k) "key")
                  mark (locals-mark (mut k))
                  (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
                  _
                    (for c (list-kids (kid comp 2))
                      (push! (mut opened) (clause-open! (mut k) c)))
                  key
                    (expect (mut k)
                            (kid comp 0)
                            (expr (mut k) (kid comp 0) "Int")
                            "Int")
                  val
                    (expect (mut k)
                            (kid comp 1)
                            (expr (mut k) (kid comp 1) (elem-of (.ty xs)))
                            (elem-of (.ty xs)))
                  body
                    (clauses-code (mut k)
                                  (list-kids (kid comp 2))
                                  opened
                                  `(let [~(sym key-v) ~(.code key)]
                                     (when (or (< ~(sym key-v) 0)
                                               (>= ~(sym key-v) (len ~(sym o))))
                                       (panic "updated: key {} is outside 0 to {}"
                                              ~(sym key-v)
                                              (len ~(sym o))))
                                     (set! (mut ~(sym o))
                                           ~(sym key-v)
                                           ~(.code val))))]
              (locals-reset! (mut k) mark)
              (Some (te `(let [(mut ~(sym o))
                                 ~(if (match (.kind (get args 0))
                                        (g/KName [] true)
                                        (g/KFieldE [] true)
                                        (g/KIndex [] true)
                                        (_ false))
                                      (list-copy (mut k) xs)
                                      (.code xs))]
                           ~body
                           ~(sym o))
                        (.ty xs))))
          ;; `updated(xs, keys, values)`: `xs` with each value at its key's place, a later one over an
          ;; earlier one at the same place: a list with some of its items replaced.
          (and (= name "updated") (= count 3))
            (let [xs (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty xs))
                      (die (mut k)
                           n
                           (cat "updated takes a list, not " (.ty xs))))
                  ks
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "[Int]")
                            "[Int]")
                  vs
                    (expect (mut k)
                            (get args 2)
                            (expr (mut k) (get args 2) (.ty xs))
                            (.ty xs))
                  o (fresh (mut k) "out")
                  kv (fresh (mut k) "keys")
                  vv (fresh (mut k) "values")
                  i (fresh (mut k) "i")
                  key-v (fresh (mut k) "key")]
              (Some (te `(let [(mut ~(sym o))
                                 ~(if (match (.kind (get args 0))
                                        (g/KName [] true)
                                        (g/KFieldE [] true)
                                        (g/KIndex [] true)
                                        (_ false))
                                      (list-copy (mut k) xs)
                                      (.code xs))
                               ~(sym kv) ~(.code ks)
                               ~(sym vv) ~(.code vs)]
                           (unless (= (len ~(sym kv)) (len ~(sym vv)))
                             (panic "updated needs a value for each key"))
                           (for ~(sym i) (range 0 (len ~(sym kv)))
                             (let [~(sym key-v) (get ~(sym kv) ~(sym i))]
                               (when (or (< ~(sym key-v) 0)
                                         (>= ~(sym key-v) (len ~(sym o))))
                                 (panic "updated: key {} is outside 0 to {}"
                                        ~(sym key-v)
                                        (len ~(sym o))))
                               (set! (mut ~(sym o))
                                     ~(sym key-v)
                                     (get ~(sym vv) ~(sym i)))))
                           ~(sym o))
                        (.ty xs))))
          ;; `histogram(n, keys)`: for keys from 0 below `n`, how many times each is in the list, as a list
          ;; of `n`; `histogram(n, keys, weights)` adds up the weights instead. Over a comprehension of
          ;; keys, each is counted as it is made.
          (and (= name "histogram") (or (= count 2) (= count 3)))
            (let [size
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Int")
                            "Int")
                  o (fresh (mut k) "bins")
                  n-v (fresh (mut k) "n")
                  key-v (fresh (mut k) "key")]
              (if (and (= count 2) (= (.kind (get args 1)) (g/KComp)))
                  (let [comp (get args 1)
                        mark (locals-mark (mut k))
                        (mut opened)
                          (ArrayList::new [HeadInfo] (malloc-allocator))
                        _
                          (for c (list-kids (kid comp 1))
                            (push! (mut opened) (clause-open! (mut k) c)))
                        key
                          (expect (mut k)
                                  (kid comp 0)
                                  (expr (mut k) (kid comp 0) "Int")
                                  "Int")
                        body
                          (clauses-code (mut k)
                                        (list-kids (kid comp 1))
                                        opened
                                        `(let [~(sym key-v) ~(.code key)]
                                           ~(histogram-add o key-v n-v `1)))]
                    (locals-reset! (mut k) mark)
                    (Some (te `(let [~(sym n-v) ~(.code size)
                                     (mut ~(sym o)) ~(zeros-code (mut k) n-v)]
                                 ~body
                                 ~(sym o))
                              "[Int]")))
                  (let [ks
                          (expect (mut k)
                                  (get args 1)
                                  (expr (mut k) (get args 1) "[Int]")
                                  "[Int]")
                        ws
                          (if (= count 3)
                              (.code (expect (mut k)
                                             (get args 2)
                                             (expr (mut k) (get args 2) "[Int]")
                                             "[Int]"))
                              `0)
                        kv (fresh (mut k) "keys")
                        wv (fresh (mut k) "weights")
                        i (fresh (mut k) "i")]
                    (Some (te `(let [~(sym n-v) ~(.code size)
                                     ~(sym kv) ~(.code ks)
                                     ~(sym wv) ~ws
                                     (mut ~(sym o)) ~(zeros-code (mut k) n-v)]
                                 ~(if (= count 3)
                                      `(unless (= (len ~(sym kv))
                                                  (len ~(sym wv)))
                                         (panic "histogram needs a weight for each key"))
                                      `0)
                                 (for ~(sym i) (range 0 (len ~(sym kv)))
                                   (let [~(sym key-v) (get ~(sym kv) ~(sym i))]
                                     ~(histogram-add o
                                                     key-v
                                                     n-v
                                                     (if (= count 3)
                                                         `(get ~(sym wv)
                                                               ~(sym i))
                                                         `1))))
                                 ~(sym o))
                              "[Int]")))))
          ;; Over a comprehension, each key is counted as it is made: no list of them.
          (and (= name "tally") (= count 1) (= (.kind (get args 0)) (g/KComp)))
            (let [comp (get args 0)
                  mark (locals-mark (mut k))
                  (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
                  _
                    (for c (list-kids (kid comp 1))
                      (push! (mut opened) (clause-open! (mut k) c)))
                  key (expr (mut k) (kid comp 0) "")
                  kt (.ty key)
                  _
                    (unless (or (= kt "Int") (= kt "Text"))
                      (die (mut k)
                           n
                           (cat "tally's keys are Int or Text, not " kt)))
                  ty (cat3 "{" kt ":Int}")
                  o (fresh (mut k) "tally")
                  kv (fresh (mut k) "key")
                  body
                    (clauses-code (mut k)
                                  (list-kids (kid comp 1))
                                  opened
                                  `(let [~(sym kv) ~(.code key)]
                                     (set! (mut ~(sym o))
                                           ~(sym kv)
                                           (+ (match (get ~(sym o) ~(sym kv))
                                                (Some [v] v)
                                                (None [] 0))
                                              1))))]
              (locals-reset! (mut k) mark)
              (Some (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)]
                           ~body
                           ~(sym o))
                        ty)))
          (and (= name "tally") (or (= count 1) (= count 2)))
            (let [ks (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty ks))
                      (die (mut k) n "tally counts the keys of a list"))
                  kt (elem-of (.ty ks))
                  _
                    (unless (or (= kt "Int") (= kt "Text"))
                      (die (mut k)
                           n
                           (cat "tally's keys are Int or Text, not " kt)))
                  ws
                    (if (= count 2)
                        (.code (expect (mut k)
                                       (get args 1)
                                       (expr (mut k) (get args 1) "[Int]")
                                       "[Int]"))
                        `0)
                  ty (cat3 "{" kt ":Int}")
                  o (fresh (mut k) "tally")
                  kv (fresh (mut k) "keys")
                  wv (fresh (mut k) "weights")
                  i (fresh (mut k) "i")
                  key (fresh (mut k) "key")]
              (Some (te `(let [~(sym kv) ~(.code ks)
                               ~(sym wv) ~ws
                               (mut ~(sym o)) ~(new-map (mut k) ty)]
                           ~(if (= count 2)
                                `(unless (= (len ~(sym kv)) (len ~(sym wv)))
                                   (panic "tally needs a weight for each key"))
                                `0)
                           (for ~(sym i) (range 0 (len ~(sym kv)))
                             (let [~(sym key) (get ~(sym kv) ~(sym i))]
                               (set! (mut ~(sym o))
                                     ~(sym key)
                                     (+ (match (get ~(sym o) ~(sym key))
                                          (Some [v] v)
                                          (None [] 0))
                                        ~(if (= count 2)
                                             `(get ~(sym wv) ~(sym i))
                                             `1)))))
                           ~(sym o))
                        ty)))
          (and (= name "reversed") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "xs")
                  o (fresh (mut k) "out")
                  i (fresh (mut k) "i")]
              (unless (list? (.ty e)) (die (mut k) n "reversed needs a list"))
              (Some (te `(let [~(sym t) ~(.code e)
                               (mut ~(sym o))
                                 ~(new-list (mut k) (elem-of (.ty e)))
                               (mut ~(sym i)) (len ~(sym t))]
                           (while (> ~(sym i) 0)
                             (set! ~(sym i) (- ~(sym i) 1))
                             (push! (mut ~(sym o)) (get ~(sym t) ~(sym i))))
                           ~(sym o))
                        (.ty e))))
          (and (= name "keys") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "k")
                  o (fresh (mut k) "out")]
              (unless (map? (.ty e)) (die (mut k) n "keys needs a map"))
              (Some (te `(let [(mut ~(sym o))
                                 ~(new-list (mut k) (map-key (.ty e)))]
                           (for ~(sym t) ~(.code e)
                             (push! (mut ~(sym o)) ~(sym t)))
                           ~(sym o))
                        (cat3 "[" (map-key (.ty e)) "]"))))
          ;; `parallel-map(xs, f, n)`: `f` of each element on `n` threads, results in the order of `xs`.
          ;; Each thread takes the next index it finds free, so uneven work evens out. For a program
          ;; with no pipeline: one with a pipeline makes a plain list of a stage's function's
          ;; answers, and its plan says how many threads (see "a stage's work").
          (and (= name "parallel-map") (= count 3))
            (let [xs (expr (mut k) (get args 0) "")
                  f (expr (mut k) (get args 1) "")
                  threads
                    (expect (mut k)
                            (get args 2)
                            (expr (mut k) (get args 2) "Int")
                            "Int")]
              (unless (list? (.ty xs))
                (die (mut k) n "parallel-map needs a list"))
              (unless (fn? (.ty f))
                (die (mut k) n "parallel-map needs a function"))
              (let [t (elem-of (.ty xs))
                    ps (fn-params (.ty f))
                    r (fn-ret (.ty f))]
                (unless (and (= (len ps) 1) (= (get ps 0) t))
                  (die (mut k)
                       n
                       (cat4 "parallel-map's function must take one "
                             t
                             ", not "
                             (.ty f))))
                (let [ct (coil-type (mut k) t)
                      cr (coil-type (mut k) r)
                      job (fresh (mut k) "PJob")
                      body (fresh (mut k) "pjob-body")
                      xs-v (fresh (mut k) "pxs")
                      out-v (fresh (mut k) "pout")
                      job-v (fresh (mut k) "pjob")
                      res-v (fresh (mut k) "pres")
                      o-v (fresh (mut k) "po")
                      v-v (fresh (mut k) "pv")]
                  (push! (mut (.aux k))
                         `(defstruct ~(sym job)
                            [(next i64)
                             (xs (ArrayList ~ct))
                             (out (ArrayList (Option ~cr)))
                             (f (fnptr (cc/C) [~ct] ~cr))]))
                  (push! (mut (.aux k))
                         `(defn ~(sym body) [(arg (ptr i8))] (-> (ptr i8))
                            (let [j (cast (ptr ~(sym job)) arg)
                                  f (.f j)
                                  xs (.xs j)
                                  (mut out) (.out j)
                                  (mut go) true]
                              (while go
                                (let [i (atomic/add (cast (ptr i64) j) 1)]
                                  (if (< i (len xs))
                                      (do
                                        (rt/item-begin! i)
                                        (set! (mut out) i (Some (f (get xs i)))))
                                      (set! go false))))
                              arg)))
                  (Some (te `(let [~(sym xs-v) ~(.code xs)
                                   (mut ~(sym out-v))
                                     (ArrayList::new [(Option ~cr)]
                                                     (rt/value-allocator))]
                               (for _ ~(sym xs-v)
                                 (push! (mut ~(sym out-v)) (None [~cr])))
                               (let [(mut ~(sym job-v))
                                       (~(sym job)
                                         :next 0
                                         :xs ~(sym xs-v)
                                         :out ~(sym out-v)
                                         :f ~(.code f))]
                                 (rt/run-map-workers (fnptr-of ~(sym body))
                                                 (cast (ptr i8)
                                                       (mut ~(sym job-v)))
                                                 ~(.code threads))
                                 (let [(mut ~(sym res-v))
                                         (ArrayList::new [~cr]
                                                         (rt/tree-allocator))]
                                   (for ~(sym o-v) (.out ~(sym job-v))
                                     (match ~(sym o-v)
                                       (Some [~(sym v-v)]
                                             (push! (mut ~(sym res-v))
                                                    ~(sym v-v)))
                                       (None []
                                             (panic "a parallel task left no result"))))
                                   ~(sym res-v))))
                            (cat3 "[" r "]"))))))
          ;; `reach(roots, next)`: how many names can be reached from `roots`, where `next` of a name
          ;; says which names it leads to. `next` is a stage's function (see `stage` in the
          ;; pipeline language): each name is given to it once, on whichever of the stage's threads
          ;; takes it, and a thread that finds work waiting never waits for a whole wave to finish.
          ;; When the stage says the names are files its work reads (`reads files`), they are read
          ;; ahead by a few threads of their own (see "files read ahead" in hl.rt) and names are
          ;; taken in the order they were found, which is the order they are read in; otherwise
          ;; the name found last is taken first.
          (and (= name "reach") (= count 2))
            (let [roots
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "[Text]")
                            "[Text]")
                  sc
                    (match (stage-fn (mut k) (get args 1))
                      (Some [sc] sc)
                      (None []
                            (die (mut k)
                                 (get args 1)
                                 "reach follows a stage's function: no stage of the pipeline names this one")))
                  f (.f sc)
                  threads `(rt/stage-threads ~(.number sc))
                  has-ahead (.reads (.stage sc))]
              (unless (= (func-type f) "Fn(Text)->[Text]")
                (die (mut k)
                     (get args 1)
                     "reach follows names: its function takes a Text and gives [Text]"))
              (let [visit (sym (qualified (mut k) (.module sc) (.coil f)))
                    ahead `x
                    job (fresh (mut k) "WJob")
                    body (fresh (mut k) "wjob-body")
                    job-v (fresh (mut k) "wjob")
                    root-v (fresh (mut k) "wroot")]
                (push! (mut (.aux k))
                       `(defstruct ~(sym job)
                          [(gate (ptr rt/Gate))
                           ;; Names found and not yet taken are `found` from `head` on.
                           (head i64)
                           (busy i64)
                           (waiting i64)
                           (done i64)
                           ;; How many workers sleep at the gate, for whoever adds work to wake.
                           (asleep i64)
                           (lock i64)
                           (count i64)
                           (found (ArrayList (slice u8)))
                           (seen (HashMap (slice u8) bool))]))
                (push! (mut (.aux k))
                       `(defn ~(sym body) [(arg (ptr i8))] (-> (ptr i8))
                          ;; A worker with nothing to do sleeps until another adds work or finishes
                          ;; the last of it. The names and all that goes with them are under a
                          ;; lock held for a few instructions at a time (`lk`); the gate is
                          ;; only for sleeping at, and is never asked for while that is held.
                          (let [j (cast (ptr ~(sym job)) arg)
                                g (.gate j)
                                lk (field j lock)
                                (mut go) true]
                            (rt/spin-lock! lk)
                            (while go
                              ;; A name's work that makes a list of its own (a big file's
                              ;; pieces) offers it to the others, who take part before
                              ;; anything new.
                              (when (rt/help-wanted?)
                                (rt/spin-unlock! lk)
                                (rt/help-now!)
                                (rt/spin-lock! lk))
                              (if (> (- (len (.found j)) (.head j)) 0)
                                  (let [item
                                          ~(if has-ahead
                                               `(let [x (get (.found j) (.head j))]
                                                  (set! (.head j) (+ (.head j) 1))
                                                  x)
                                               `(match (pop! (mut (.found j)))
                                                  (Some [x] x)
                                                  (None [] (panic "a walk's names ran out under its lock"))))]
                                    (set! (.busy j) (+ (.busy j) 1))
                                    (rt/spin-unlock! lk)
                                    (let [began (if (rt/walk-trace-on?) (rt/now-ns) 0)
                                          more (~visit item)
                                          traced (if (rt/walk-trace-on?) (do (rt/walk-trace! item began) 0) 0)
                                          (mut added) false]
                                      (rt/spin-lock! lk)
                                      (set! (.count j) (+ (.count j) 1))
                                      (for x more
                                        (unless (match (get (.seen j) x)
                                                  (Some [_] true)
                                                  (None [] false))
                                          (set! (mut (.seen j)) x true)
                                          (push! (mut (.found j)) x)
                                          ~(if has-ahead `(rt/read-ahead! ~ahead) `0)
                                          (set! added true)))
                                      (set! (.busy j) (- (.busy j) 1))
                                      (atomic/store (field j waiting)
                                                    (- (len (.found j)) (.head j)))
                                      (when (= (.busy j) 0)
                                        (atomic/store (field j done) 1))
                                      ;; Whoever sleeps is woken: all of them when the walk is
                                      ;; over, else one for each name that waits. A worker still
                                      ;; looking for work finds it without being told.
                                      (let [over (= (.busy j) 0)
                                            waits (- (len (.found j)) (.head j))]
                                        (when (and (or over added) (> (atomic/read (field j asleep)) 0))
                                          (rt/spin-unlock! lk)
                                          (rt/gate-lock! g)
                                          (if over
                                              (rt/gate-wake-all! g)
                                              (for _ (range 0 (min (atomic/read (field j asleep)) waits))
                                                (rt/gate-wake-one! g)))
                                          (rt/gate-unlock! g)
                                          (rt/spin-lock! lk)))))
                                  (if (= (.busy j) 0)
                                      (do
                                        (atomic/store (field j done) 1)
                                        (set! go false))
                                      ;; A while looking for new work, then asleep until some comes.
                                      (do
                                        (atomic/store (field j waiting)
                                                      (- (len (.found j)) (.head j)))
                                        (rt/spin-unlock! lk)
                                        (let [(mut spins) 0]
                                          (while (and (< spins 20000)
                                                      (= (atomic/read (field j waiting)) 0)
                                                      (= (atomic/read (field j done)) 0)
                                                      (not (rt/help-wanted?)))
                                            (set! spins (+ spins 1)))
                                          ;; To sleep: say so, then look once more, at the gate. Work
                                          ;; added before this said so is seen here; whoever adds
                                          ;; after sees a sleeper, and wakes it from the gate.
                                          (when (= spins 20000)
                                            (rt/gate-lock! g)
                                            (atomic/add (field j asleep) 1)
                                            (rt/spin-lock! lk)
                                            (let [idle (and (= (- (len (.found j)) (.head j)) 0)
                                                            (> (.busy j) 0)
                                                            (not (rt/help-wanted?)))]
                                              (rt/spin-unlock! lk)
                                              (when idle (rt/gate-wait! g)))
                                            (atomic/add (field j asleep) -1)
                                            (rt/gate-unlock! g))
                                          (rt/spin-lock! lk))))))
                            (rt/spin-unlock! lk)
                            arg)))
                (Some (te `(let [(mut ~(sym job-v))
                                   (~(sym job)
                                     :gate (rt/gate-new)
                                     :head 0
                                     :busy 0
                                     :waiting 0
                                     :done 0
                                     :asleep 0
                                     :lock 0
                                     :count 0
                                     :found
                                       (ArrayList::new [(slice u8)]
                                                       (rt/owned-allocator))
                                     :seen
                                       (HashMap::new [(slice u8) bool]
                                                     (rt/owned-allocator)
                                                     (rt/text-keyops)))]
                             ;; What arrives where (`arrive!`) is counted afresh for each walk.
                             (rt/arrivals-reset!)
                             ;; Files are read ahead for a walk on many threads; one thread reads
                             ;; each as it comes to it.
                             ~(if has-ahead `(when (> ~threads 1) (rt/read-ahead-begin!)) `0)
                             (for ~(sym root-v) ~(.code roots)
                               (unless (match (get (.seen ~(sym job-v))
                                                   ~(sym root-v))
                                         (Some [_] true)
                                         (None [] false))
                                 (set! (mut (.seen ~(sym job-v)))
                                       ~(sym root-v)
                                       true)
                                 (push! (mut (.found ~(sym job-v)))
                                        ~(sym root-v))
                                 ~(if has-ahead `(let [x ~(sym root-v)] (rt/read-ahead! ~ahead) 0) `0)))
                             (rt/idle-gate! (.gate ~(sym job-v)))
                             (rt/run-workers (fnptr-of ~(sym body))
                                             (cast (ptr i8)
                                                   (mut ~(sym job-v)))
                                             ~threads)
                             (rt/idle-gate! (primitive/cast (ptr rt/Gate) 0))
                             ~(if has-ahead `(rt/read-ahead-end!) `0)
                             (.count ~(sym job-v)))
                          "Int"))))
          ;; `timed(on, label, e)`: `e`, and when `on`, how long it has been since the last lap said.
          (and (= name "timed") (= count 3))
            (let [on
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Bool")
                            "Bool")
                  label
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "Text")
                            "Text")
                  v (expr (mut k) (get args 2) "")
                  x (fresh (mut k) "timed")]
              (Some (if (= (.ty v) "Void")
                        (te `(do
                               ~(.code v)
                               (when ~(.code on) (rt/lap! ~(.code label)))
                               0)
                            "Void")
                        (te `(let [~(sym x) ~(.code v)]
                               (when ~(.code on) (rt/lap! ~(.code label)))
                               ~(sym x))
                            (.ty v)))))
          (and (= name "include-text")
               (= count 1)
               (= (.kind (get args 0)) (g/KStr)))
            (Some (te `(~(sym "include-str") ~(str-literal (get args 0)))
                      "Text"))
          :else (None [TE]))))

(defn call-expr [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [callee (kid n 0)
        args (list-kids (kid n 1))]
    (match (.kind callee)
      (g/KName []
               (let [name (.text callee)]
                 (match (find-local (mut k) name)
                   (Some [l]
                         (unless (fn? (.ty l))
                           (die (mut k)
                                n
                                (cat4 name " is a " (.ty l) ", not a function")))
                         (fn-value-call (mut k) n (sym (.sym l)) (.ty l) args))
                   (None []
                         (match (builtin-call (mut k) n name args)
                           (Some [b] b)
                           (None []
                                 (match (find-func (self-mod (mut k)) name)
                                   (Some [f]
                                         (call-func (mut k) n (.self k) f args))
                                   (None []
                                         (match (find-global (self-mod (mut k))
                                                             name)
                                           (Some [x]
                                                 (unless (fn? (.ty x))
                                                   (die (mut k)
                                                        n
                                                        (cat4 name
                                                              " is a "
                                                              (.ty x)
                                                              ", not a function")))
                                                 (fn-value-call (mut k)
                                                                n
                                                                `(~(primitive/code-symbol "."
                                                                                          name) ~(storage-call (mut k)
                                                                                                               x))
                                                                (.ty x)
                                                                args))
                                           (None []
                                                 (match (find-func (mod-at (mut k)
                                                                           "hl.rt")
                                                                   name)
                                                   (Some [f]
                                                         (if (and (= name
                                                                     "join")
                                                                  (= (len args)
                                                                     2)
                                                                  (= (.kind (get args
                                                                                 0))
                                                                     (g/KComp))
                                                                  (= (.kind (get args
                                                                                 1))
                                                                     (g/KStr)))
                                                             (join-comprehension (mut k)
                                                                                 (get args
                                                                                      0)
                                                                                 (get args
                                                                                      1))
                                                             (call-func (mut k)
                                                                        n
                                                                        "hl.rt"
                                                                        f
                                                                        args)))
                                                   (None []
                                                         (die (mut k)
                                                              callee
                                                              (cat "no function named "
                                                                   name))))))))))))))
      (g/KFieldE []
                 (let [base (kid callee 0)
                       name (.text (kid callee 1))]
                   (match (module-prefix (mut k) base)
                     (Some [module]
                           (match (find-func (mod-at (mut k) module) name)
                             (Some [f] (call-func (mut k) n module f args))
                             (None []
                                   (die (mut k)
                                        callee
                                        (cat4 module
                                              " has no function named "
                                              name
                                              "")))))
                     (None []
                           (let [b
                                   (if (is-place? base)
                                       (place (mut k) base)
                                       (expr (mut k) base ""))]
                             (if (and (> (last-dot (.ty b)) 0)
                                      (= (type-name (.ty b)) "Db")
                                      (not (builtin-type? (.ty b))))
                                 (relation-test (mut k) n b name args)
                                 (let [ft
                                         (field-type (mut k)
                                                     callee
                                                     (.ty b)
                                                     name)]
                                   (unless (fn? ft)
                                     (die (mut k)
                                          n
                                          (cat name " is not a function")))
                                   (fn-value-call (mut k)
                                                  n
                                                  `(~(primitive/code-symbol "."
                                                                            name) ~(.code b))
                                                  ft
                                                  args))))))))
      (g/KMember []
                 (ctor-qualified (mut k) n callee args want))
      (_ (die (mut k) n "this cannot be called")))))

;;; Whether `(mut e)` may be taken: a `var`, a setting or state, or a field of one.
(defn writable? [(k (mut Comp)) (e g/Node)] (-> bool)
  (match (.kind e)
    (g/KName []
             (match (find-local (mut k) (.text e))
               (Some [l] (.mutable l))
               (None [] true)))
    (g/KFieldE []
               (match (module-prefix (mut k) (kid e 0))
                 (Some [_] true)
                 (None [] (writable? (mut k) (kid e 0)))))
    (g/KGroup [] (writable? (mut k) (kid e 0)))
    (_ false)))

(defn is-place? [(e g/Node)] (-> bool)
  (match (.kind e)
    (g/KName [] true)
    (g/KFieldE [] (is-place? (kid e 0)))
    (g/KIndex [] (is-place? (kid e 0)))
    (g/KGroup [] (is-place? (kid e 0)))
    (_ false)))

;;; A named function as a value, as the pointer its type says. A Coil function takes a struct by
;;; reference, and `fnptr-of` gives the entry that takes it by value only when it knows the pointer
;;; type wanted: a map or list of functions would otherwise hold the other kind.
(defn fn-value [(k (mut Comp)) (ptr Code) (f Func)] (-> Code)
  `(: ~ptr ~(coil-type (mut k) (func-type f))))

(defn fn-value-call [(k (mut Comp))
                     (n g/Node)
                     (f Code)
                     (ty (slice u8))
                     (args (ArrayList g/Node))] (-> TE)
  (let [ps (fn-params ty)
        (mut out) (primitive/code-list-new)]
    (unless (= (len ps) (len args))
      (die (mut k)
           n
           (cat "wrong number of arguments for a function of type " ty)))
    (for i (range 0 (len args))
      (let [x
              (expect (mut k)
                      (get args i)
                      (expr (mut k) (get args i) (get ps i))
                      (get ps i))]
        (push! (mut out) (.code x))))
    ;; A call's head must be a name.
    (let [t (fresh (mut k) "f")]
      (te `(let [~(sym t) ~f] (~(sym t) ~@out)) (fn-ret ty)))))

;;; `db.rel(a, b)` as a question: is there such a row? `_` matches anything.
(defn relation-test [(k (mut Comp))
                     (n g/Node)
                     (db TE)
                     (rel (slice u8))
                     (args (ArrayList g/Node))] (-> TE)
  (rel-check (mut k) n (.ty db) rel (len args))
  (let [module (type-module (.ty db))
        (mut wild) false
        (mut cs) (primitive/code-list-new)]
    (for a args
      (when (and (= (.kind a) (g/KName)) (= (.text a) "_")) (set! wild true)))
    (if wild
        (let [mark (locals-mark (mut k))
              label (primitive/code-symbol ":" (fresh (mut k) "q"))
              h (query-open! (mut k) n)
              code (head-wrap (mut k) h `(return-from ~label true))]
          (locals-reset! (mut k) mark)
          (te `(block ~label ~code false) "Bool"))
        (let [(mut vs) (primitive/code-list-new)
              (mut binds) (primitive/code-list-new)
              (mut specs) (primitive/code-list-new)
              (mut first-v) `0
              (mut seen-first) false]
          (for a args
            (let [x (expect (mut k) a (expr (mut k) a "Int") "Int")
                  v (fresh (mut k) "col")]
              (unless seen-first (set! first-v (sym v)) (set! seen-first true))
              (push! (mut cs) (.code x))
              (push! (mut binds) (sym v))
              (push! (mut binds) (.code x))
              (push! (mut vs) (sym v))
              (push! (mut specs) `(push! (mut parts) (rt/num-text ~(sym v))))))
          (let [has (sym (qualified (mut k) module (cat3 "has-" rel "?")))]
            (if (writable? (mut k) (kid (kid n 0) 0))
                (te `(let [~@binds noted
                           ~(if (= (len args) 1)
                                (query-note-one (mut k)
                                                (kid (kid n 0) 0)
                                                rel
                                                1
                                                0
                                                first-v)
                                (query-note (mut k)
                                            (kid (kid n 0) 0)
                                            rel
                                            `(let [(mut parts)
                                                     (ArrayList::new [(slice u8)]
                                                                     (rt/value-allocator))]
                                               ~@specs
                                               parts)))]
                       (~has (mut ~(.code db)) ~@vs))
                    "Bool")
                ;; Read through a copy, as a query does: the copies share their indexes.
                (let [copy (sym (fresh (mut k) "db"))]
                  (te `(let [(mut ~copy) ~(.code db)] (~has (mut ~copy) ~@cs))
                      "Bool"))))))))

;; ---------------------------------------------------------------- constructors

(defn build-record [(k (mut Comp))
                    (n g/Node)
                    (module (slice u8))
                    (r RecDef)
                    (args (ArrayList g/Node))] (-> TE)
  (let [(mut inits) (primitive/code-list-new)]
    (for a args
      (unless (= (.kind a) (g/KNamed))
        (die (mut k) a (cat3 "the fields of " (.name r) " are given by name"))))
    (for f (.fields r)
      (let [(mut found) false]
        (for a args
          (when (= (.text (kid a 0)) (.name f))
            (set! found true)
            (push! (mut inits) (primitive/code-symbol ":" (.name f)))
            (push! (mut inits)
                   (.code (expect (mut k)
                                  (kid a 1)
                                  (expr (mut k) (kid a 1) (.ty f))
                                  (.ty f))))))
        (unless found
          (die (mut k) n (cat4 (.name r) " needs its field " (.name f) "")))))
    (for a args
      (let [(mut known) false]
        (for f (.fields r)
          (when (= (.name f) (.text (kid a 0))) (set! known true)))
        (unless known
          (die (mut k)
               a
               (cat4 (.name r) " has no field named " (.text (kid a 0)) "")))))
    (te (record-value (mut k) (cat3 module "." (.name r))
                      `(~(sym (qualified (mut k) module (.name r))) ~@inits))
        (cat3 module "." (.name r)))))

(defn build-node [(k (mut Comp))
                  (n g/Node)
                  (gr Mod)
                  (entry syntax/KindEntry)
                  (args (ArrayList g/Node))] (-> TE)
  (let [alias (alias-of (.name gr))
        ty (cat (.name gr) ".Node")
        kind (kind-code gr (.name entry))]
    (cond (.leaf entry)
            (do
              (unless (= (len args) 1)
                (die (mut k)
                     n
                     (cat (.name entry) " is a token: it holds one text")))
              (let [t
                      (expect (mut k)
                              (get args 0)
                              (expr (mut k) (get args 0) "Text")
                              "Text")]
                (te `(~(primitive/code-symbol alias "/leaf") (~kind)
                        ~(.code t)
                        0
                        0)
                    ty)))
          (= (.name entry) "None")
            (te `(~(primitive/code-symbol alias "/none-node")) ty)
          :else
            (let [(mut pushes) (primitive/code-list-new)
                  (mut count) 0
                  (mut spread) false
                  kids (fresh (mut k) "kids")]
              (for a args
                (if (spread-arg? a)
                    (let [xs (spread-list (mut k) a (cat3 "[" ty "]"))
                          each (fresh (mut k) "each")]
                      (set! spread true)
                      (push! (mut pushes)
                             `(for (ref ~(sym each)) ~xs
                                (push! (mut ~(sym kids)) ~(sym each)))))
                    (let [x (expect (mut k) a (expr (mut k) a ty) ty)]
                      (set! count (+ count 1))
                      (push! (mut pushes) `(push! (mut ~(sym kids)) ~(.code x))))))
              (when (and (>= (.arity entry) 0)
                         (not spread)
                         (!= count (.arity entry)))
                (die (mut k)
                     n
                     (cat4 (.name entry)
                           " has "
                           (rt/num-text (.arity entry))
                           (cat " children, this gives it " (rt/num-text count)))))
              (te `(let [(mut ~(sym kids))
                           (~(primitive/code-symbol alias "/new-kids"))]
                     (reserve! (mut ~(sym kids)) ~count)
                     ~@pushes
                     (~(primitive/code-symbol alias "/mk") (~kind)
                        ~(sym kids)
                        0
                        0))
                  ty)))))

(defn spread-arg? [(a g/Node)] (-> bool)
  (or (= (.kind a) (g/KRest)) (= (.kind a) (g/KSpread))))

;;; `xs...` or `e...` in a list or a node: the list whose items go in, which must be a `want`.
(defn spread-list [(k (mut Comp)) (a g/Node) (want (slice u8))] (-> Code)
  (if (= (.kind a) (g/KRest))
      (let [name (subslice (.text a) 0 (- (len (.text a)) 3))]
        (match (find-local (mut k) name)
          (None [] (die (mut k) a (cat "nothing named " name)))
          (Some [l]
                (unless (= (.ty l) want)
                  (die (mut k)
                       a
                       (cat4 "only a " want " can be spread here, not " (.ty l))))
                (sym (.sym l)))))
      (.code (expect (mut k) (kid a 0) (expr (mut k) (kid a 0) want) want))))

(defn ctor [(k (mut Comp))
            (n g/Node)
            (name (slice u8))
            (args (ArrayList g/Node))] (-> TE)
  (let [m (self-mod (mut k))]
    (match (find-rec m name)
      (Some [r] (build-record (mut k) n (.self k) r args))
      (None []
            (match (find-rec (mod-at (mut k) "hl.rt") name)
              (Some [r] (build-record (mut k) n "hl.rt" r args))
              (None []
                    (when (= (len (.over m)) 0)
                      (die (mut k)
                           n
                           (cat3 "no record named "
                                 name
                                 ", and this file names no grammar")))
                    (let [gr (mod-at (mut k) (.over m))]
                      (match (find-kind gr name)
                        (Some [entry] (build-node (mut k) n gr entry args))
                        (None []
                              (die (mut k)
                                   n
                                   (cat4 "nothing named "
                                         name
                                         " here, nor in the grammar "
                                         (.name gr))))))))))))

(defn ctor-qualified [(k (mut Comp))
                      (n g/Node)
                      (callee g/Node)
                      (args (ArrayList g/Node))
                      (want (slice u8))] (-> TE)
  (let [base (kid callee 0)
        name (.text (kid callee 1))]
    (match (module-prefix (mut k) base)
      (None [] (die (mut k) callee "expected module.Name"))
      (Some [module]
            (let [m (mod-at (mut k) module)]
              (match (find-rec m name)
                (Some [r] (build-record (mut k) n module r args))
                (None []
                      (match (find-kind m name)
                        (Some [entry] (build-node (mut k) n m entry args))
                        (None []
                              (die (mut k)
                                   callee
                                   (cat4 module " has nothing named " name "")))))))))))

;; ---------------------------------------------------------------- templates

(defn hole-name? [(c u8)] (-> bool)
  (or (rt/name-char? c)))

(defn template [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [raw (.text n)
        (mut tick) 0]
    (while (!= (get raw tick) #\`) (set! tick (+ tick 1)))
    (let [tag (subslice raw 0 tick)
          src (subslice raw (+ tick 1) (- (len raw) 1))
          m (self-mod (mut k))
          (mut path-code) (primitive/code-list-new)
          (mut known) false
          (mut holes) (primitive/code-list-new)
          (mut seen) (text-list)
          (mut i) 0]
      (when (= (len (.over m)) 0)
        (die (mut k) n "a template needs `over GRAMMAR` in the header"))
      (for q (.quotes m)
        (when (= (.name q) tag)
          (set! known true)
          (for s (.path q) (push! (mut path-code) `~s))))
      (unless known
        (die (mut k)
             n
             (cat3 "no template form named " tag "; declare it with `quote`")))
      ;; Each `$name` is a variable in scope, with `_` standing for `-`: JavaScript
      ;; names have no hyphen.
      (while (< i (len src))
        (if (= (get src i) #\$)
            (let [splice (and (< (+ i 1) (len src)) (= (get src (+ i 1)) #\$))
                  from (if splice (+ i 2) (+ i 1))
                  (mut j) from]
              (while (and (< j (len src)) (hole-name? (get src j)))
                (set! j (+ j 1)))
              (when (> j from)
                (let [name (subslice src from j)
                      (mut dashed) (str/StrBuf::new (malloc-allocator))
                      (mut dup) false]
                  (for c name
                    (push! (mut (.bytes dashed)) (if (= c #\_) #\- c)))
                  (for s seen (when (= s name) (set! dup true)))
                  (unless dup
                    (push! (mut seen) name)
                    (let [var-name (finish! (mut dashed))]
                      (match (find-local (mut k) var-name)
                        (None []
                              (die (mut k)
                                   n
                                   (cat "this template's hole has no variable named "
                                        var-name)))
                        (Some [l]
                              (let [sort
                                      (cond (= (.ty l) "Text") "text"
                                            (= (.ty l) (cat (.over m) ".Node"))
                                              "node"
                                            (= (.ty l)
                                               (cat3 "[" (.over m) ".Node]"))
                                              "list"
                                            :else
                                              (die (mut k)
                                                   n
                                                   (cat4 "a hole holds text, a node or a list of nodes, but "
                                                         var-name
                                                         " is "
                                                         (.ty l))))]
                                (push! (mut holes)
                                       `(~name ~(sym (.sym l)) ~sort))))))))
                (set! i j))
              (when (<= j from) (set! i (+ i 1))))
            (set! i (+ i 1))))
      (te `(~(primitive/code-symbol (alias-of (.over m)) "/quote-template") ~(alias-of (.over m))
              ~(unescape-template src)
              (~@path-code)
              (~@holes))
          (cat (.over m) ".Node")))))

(defn unescape-template [(src (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))
        (mut i) 0]
    (while (< i (len src))
      (if (and (= (get src i) #\\)
               (< (+ i 1) (len src))
               (= (get src (+ i 1)) #\`))
          (do (push! (mut (.bytes b)) #\`) (set! i (+ i 2)))
          (do (push! (mut (.bytes b)) (get src i)) (set! i (+ i 1)))))
    (finish! (mut b))))

;; ---------------------------------------------------------------- expressions

;;; Whether a concatenation of lists is made in one list: one of more than two, or one with a part that
;;; is being made (a comprehension or a list written out), which can go straight in.
(defn one-buffer? [(n g/Node)] (-> bool)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))
        (mut made) false]
    (concat-operands! n (mut parts))
    (for p parts
      (let [q (if (= (.kind p) (g/KGroup)) (kid p 0) p)]
        (when (or (= (.kind q) (g/KComp))
                  (= (.kind q) (g/KCompSpread))
                  (= (.kind q) (g/KListLit)))
          (set! made true))))
    (or made (> (len parts) 2))))

(defn concat-operands! [(n g/Node) (out (mut (ArrayList g/Node)))] (-> void)
  (if (= (.kind n) (g/KConcat))
      (do
        (concat-operands! (kid n 0) (mut out))
        (concat-operands! (kid n 1) (mut out)))
      (push! (mut out) n)))

(defn binary-int [(k (mut Comp)) (n g/Node) (op Code)] (-> TE)
  (let [a (expect (mut k) (kid n 0) (expr (mut k) (kid n 0) "Int") "Int")
        b (expect (mut k) (kid n 1) (expr (mut k) (kid n 1) "Int") "Int")]
    (te `(~op ~(.code a) ~(.code b)) "Int")))

(defn compare [(k (mut Comp)) (n g/Node) (op Code)] (-> TE)
  (let [a (expr (mut k) (kid n 0) "")
        b (expr (mut k) (kid n 1) (.ty a))]
    (unless (= (.ty a) (.ty b))
      (die (mut k) n (cat4 "cannot compare " (.ty a) " with " (.ty b))))
    (if (= (.ty a) "Text")
        (te `(~op (str/cmp ~(.code a) ~(.code b)) 0) "Bool")
        (do
          (unless (= (.ty a) "Int")
            (die (mut k) n (cat "cannot order " (.ty a))))
          (te `(~op ~(.code a) ~(.code b)) "Bool")))))

(defn equality [(k (mut Comp)) (n g/Node) (negate bool)] (-> TE)
  (let [left (kid n 0)
        right (kid n 1)]
    (if (= (.kind right) (g/KNoneE))
        (let [a (expr (mut k) left "")]
          (te (if negate
                  `(match ~(.code a) (Some [_] true) (None [] false))
                  `(match ~(.code a) (Some [_] false) (None [] true)))
              "Bool"))
        (let [a (expr (mut k) left "")
              b (expr (mut k) right (.ty a))]
          (unless (= (.ty a) (.ty b))
            (die (mut k) n (cat4 "cannot compare " (.ty a) " with " (.ty b))))
          (when (or (list? (.ty a)) (map? (.ty a)) (opt? (.ty a)))
            (die (mut k) n (cat "cannot compare values of " (.ty a))))
          (te (if (has-boxed-value? (mut k) (.ty a))
                  (let [same (same-code (mut k) (.ty a) (.code a) (.code b))]
                    (if negate `(not ~same) same))
                  (if negate `(!= ~(.code a) ~(.code b)) `(= ~(.code a) ~(.code b))))
              "Bool")))))

(defn in-test [(k (mut Comp)) (n g/Node)] (-> TE)
  (match (keyed-in-test (mut k) n)
    (Some [x] x)
    (None [] (in-test-whole (mut k) n))))

;;; `key in S` for a part of a setting that is a map by Int or Text: a read of that key, as `S[key]`
;;; is, not of the whole map.
(defn keyed-in-test [(k (mut Comp)) (n g/Node)] (-> (Option TE))
  (match (if (> (.quiet k) 0)
             (None [SettingPart])
             (setting-part (mut k) (kid n 1)))
    (Some [p]
          (set! (.quiet k) (+ (.quiet k) 1))
          (let [b (plain-expr (mut k) (kid n 1) "")
                t (.ty b)]
            (set! (.quiet k) (- (.quiet k) 1))
            (if (and (map? t) (or (= (map-key t) "Int") (= (map-key t) "Text")))
                (let [node (cat4 "s:" (.module p) "." (.name (.x p)))
                      path (cat (fields-path (.fields p)) "#")
                      a
                        (expect (mut k)
                                (kid n 0)
                                (expr (mut k) (kid n 0) (map-key t))
                                (map-key t))
                      kv (fresh (mut k) "key")]
                  (Some (te `(let [~(sym kv) ~(.code a)]
                               ~(if (= (map-key t) "Int")
                                    `(when (rt/dep-in-frame?)
                                       (rt/dep-note-element! (primitive/alloc-static i64)
                                                             ~node
                                                             ~path
                                                             ~(sym kv)))
                                    `(when (rt/dep-in-frame?)
                                       (rt/dep-note-keyed! (primitive/alloc-static i64)
                                                           ~node
                                                           ~path
                                                           ~(sym kv))))
                               (match (get ~(.code b) ~(sym kv))
                                 (Some [_] true)
                                 (None [] false)))
                            "Bool")))
                (None [TE]))))
    (None [] (None [TE]))))

(defn in-test-whole [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [right (expr (mut k) (kid n 1) "")
        t (.ty right)]
    (cond (list? t)
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) (elem-of t))
                            (elem-of t))
                  x (fresh (mut k) "x")
                  e (fresh (mut k) "e")
                  label (primitive/code-symbol ":" (fresh (mut k) "in"))]
              (te `(let [~(sym x) ~(.code a)]
                     (block
                       ~label
                       (for ~(sym e) ~(.code right)
                         (when (= ~(sym e) ~(sym x)) (return-from ~label true)))
                       false))
                  "Bool"))
          (map? t)
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) (map-key t))
                            (map-key t))]
              (te `(match (get ~(.code right) ~(.code a))
                     (Some [_] true)
                     (None [] false))
                  "Bool"))
          (= t "Text")
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Text")
                            "Text")]
              (te `(rt/contains-text? ~(.code right) ~(.code a)) "Bool"))
          :else (die (mut k) n (cat "cannot look inside " t)))))

(defn if-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [c (expect (mut k) (kid n 0) (expr (mut k) (kid n 0) "Bool") "Bool")
        then-node (kid n 1)
        else-node (kid n 2)]
    (if (none? else-node)
        (te `(when ~(.code c) ~(.code (stmt (mut k) then-node "Void"))) "Void")
        (let [want
                (cond (> (len want0) 0) want0
                      (needs-want? then-node) (.ty (stmt (mut k) else-node ""))
                      :else "")
              a (stmt (mut k) then-node want)
              b
                (stmt (mut k)
                      else-node
                      (if (and (= (len want) 0) (!= (.ty a) "Never"))
                          (.ty a)
                          want))
              ty (unify (mut k) n (.ty a) (.ty b))]
          (te (if (= ty "Void")
                  `(if ~(.code c) (do ~(.code a) 0) (do ~(.code b) 0))
                  `(if ~(.code c) ~(.code a) ~(.code b)))
              ty)))))

(defn if-let-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [pattern (kid n 0)
        subject (expr (mut k) (kid n 1) "")
        s (fresh (mut k) "m")
        label (primitive/code-symbol ":" (fresh (mut k) "if"))
        mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) pattern (sym s) (.ty subject) (mut steps) "")
    (let [else-node (kid n 3)
          want
            (if (> (len want0) 0)
                want0
                (if (none? else-node) "Void" ""))
          body (expr (mut k) (kid n 2) want)
          ty0 (.ty body)
          inner
            (cond (= ty0 "Never") (.code body)
                  (or (= ty0 "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          wrapped (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (if (none? else-node)
          (te `(let [~(sym s) ~(.code subject)] (block ~label ~wrapped 0))
              "Void")
          (let [b
                  (stmt (mut k)
                        else-node
                        (if (> (len want) 0) want (if (= ty0 "Never") "" ty0)))
                ty (unify (mut k) n ty0 (.ty b))]
            (te `(let [~(sym s) ~(.code subject)]
                   (block
                     ~label
                     ~wrapped
                     ~(if (= ty "Void") `(do ~(.code b) 0) (.code b))))
                ty))))))

;;; `[e for …]`, or with `spread`, `[e... for …]`: each `e` a list whose items all go in.
;;; A stage's work: a list of one of a `per` stage's functions' answers, `[f(x, a) for x in xs]`
;;; (see `stage` in the pipeline language). The rules say only what the list holds. It is made on
;;; as many threads as the run's plan gives the stage (`rt/stage-threads`): what `f` is given is
;;; worked out for every item first, here, in the list's order, by the thread that asks for the
;;; list; then each thread takes the next item it finds free and calls `f`, so uneven work evens
;;; out; the answers are in the items' order. A stage of small units (`per N units`) has a thread
;;; take N at a time, and a list of N or fewer made by the thread that asks for it, alone.
;;; A stage that `gives settings` has one call run at a time while what answers were made from is
;;; tracked (`rt/own-threads`). One with `names by` meets names that get ids in the order they are
;;; met: the calls run once only to say which names they need, the namer is given those in the
;;; items' order, and they run again, every name known (see `rt/names-record-begin!`).
(defstruct StageCall [(module (slice u8)) (f Func) (number i64) (stage pl/Stage)])

(defn stage-call [(k (mut Comp)) (value g/Node)] (-> (Option StageCall))
  (if (!= (.kind value) (g/KCall))
      (None [StageCall])
      (stage-fn (mut k) (kid value 0))))

;;; The stage a name is the work of, when it names a function one works per unit by.
(defn stage-fn [(k (mut Comp)) (callee g/Node)] (-> (Option StageCall))
  (if (= (len (.stages k)) 0)
      (None [StageCall])
      (let [(mut module) ""
            (mut name) ""]
        (match (.kind callee)
          (g/KName []
                   (match (find-local (mut k) (.text callee))
                     (Some [_] 0)
                     (None []
                           (set! module (.self k))
                           (set! name (.text callee))
                           0)))
          (g/KFieldE []
                     (match (module-prefix (mut k) (kid callee 0))
                       (Some [m]
                             (set! module m)
                             (set! name (.text (kid callee 1)))
                             0)
                       (None [] 0)))
          (_ 0))
        (if (= (len name) 0)
            (None [StageCall])
            (let [full (cat3 module "/" name)
                  (mut out) (None [StageCall])]
              (for i (range 0 (len (.stages k)))
                (let [st (get (.stages k) i)]
                  (when (and (!= (.unit st) "whole") (has-text? (.functions st) full))
                    (match (find-func (mod-at (mut k) module) name)
                      (Some [f]
                            (set! out
                                  (Some (StageCall
                                          :module module
                                          :f f
                                          :number i
                                          :stage st))))
                      (None [] 0)))))
              out)))))

;;; Whether a comprehension is a stage's work, which is made as a list of its own.
(defn stage-work? [(k (mut Comp)) (comp g/Node)] (-> bool)
  (match (stage-call (mut k) (kid comp 0))
    (Some [_] true)
    (None [] false)))

(defn stage-comprehension [(k (mut Comp)) (n g/Node) (sc StageCall)] (-> TE)
  ;; HL_SHOW_STAGES set: each list that is a stage's work, where it is, as the compiler found it.
  (unless (= (primitive/cast i64 (getenv c"HL_SHOW_STAGES")) 0)
    (let [at (rt/line-col (.src k) (.lo n))]
      (println "[stage] {}: {}/{} at {}:{}"
               (.name (.stage sc))
               (.module sc)
               (.name (.f sc))
               (.path k)
               (.line at))))
  (let [mark (locals-mark (mut k))
        value (kid n 0)
        args (list-kids (kid value 1))
        f (.f sc)
        clauses (list-kids (kid n 1))
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c clauses (push! (mut opened) (clause-open! (mut k) c)))
    (unless (= (len args) (len (.params f)))
      (die (mut k)
           value
           (cat4 (.name f)
                 " takes "
                 (rt/num-text (len (.params f)))
                 (cat " arguments, this has " (rt/num-text (len args))))))
    (when (= (len args) 0)
      (die (mut k) value (cat (.name f) " is a stage's work, done for each of something: it takes what it is done for")))
    (let [tuple (fresh (mut k) "SArgs")
          job (fresh (mut k) "SJob")
          body (fresh (mut k) "sjob-body")
          items (fresh (mut k) "sitems")
          out-v (fresh (mut k) "sout")
          job-v (fresh (mut k) "sjob")
          res-v (fresh (mut k) "sres")
          o-v (fresh (mut k) "so")
          v-v (fresh (mut k) "sv")
          single (= (len args) 1)
          (mut fields) (primitive/code-list-new)
          (mut inits) (primitive/code-list-new)
          (mut reads) (primitive/code-list-new)
          (mut first) `0]
      (for i (range 0 (len args))
        (let [p (get (.params f) i)
              a (get args i)
              field (cat "a" (rt/num-text i))]
          (when (.by-ref p)
            (die (mut k)
                 a
                 (cat (.name f) " is a stage's work and changes what it is given: it cannot be done for many at once")))
          (when (or (= (.kind a) (g/KNamed)) (= (.kind a) (g/KSpread)))
            (die (mut k) a "a stage's work is given plain arguments"))
          (let [x (expect (mut k) a (expr (mut k) a (.ty p)) (.ty p))]
            (when (= i 0) (set! first (.code x)))
            (push! (mut fields) `(~(sym field) ~(coil-type (mut k) (.ty p))))
            (push! (mut inits) (primitive/code-symbol ":" field))
            (push! (mut inits) (.code x))
            (push! (mut reads) `(~(primitive/code-symbol "." field) t)))))
      (let [ct (if single (coil-type (mut k) (.ty (get (.params f) 0))) (sym tuple))
            cr (coil-type (mut k) (.ret f))
            item (if single first `(~(sym tuple) ~@inits))
            fill (clauses-code (mut k) clauses opened `(push! (mut ~(sym items)) ~item))
            callee (sym (qualified (mut k) (.module sc) (.coil f)))
            call (if single `(~callee t) `(~callee ~@reads))
            asked `(rt/stage-threads ~(.number sc))
            naming (> (len (.namer (.stage sc))) 0)
            step (.run (.stage sc))
            threads (if (or naming (.gives (.stage sc))) `(rt/own-threads ~asked) asked)
            once
              `(let [(mut ~(sym out-v))
                       (ArrayList::new [(Option ~cr)] (rt/value-allocator))]
                 (reserve! (mut ~(sym out-v)) (len ~(sym items)))
                 (for _ ~(sym items) (push! (mut ~(sym out-v)) (None [~cr])))
                 (let [(mut ~(sym job-v))
                         (~(sym job) :next 0 :xs ~(sym items) :out ~(sym out-v))]
                   (if (< (len ~(sym items)) ~(.least (.stage sc)))
                       (do (~(sym body) (cast (ptr i8) (mut ~(sym job-v)))) 0)
                       (do
                         (rt/run-map-workers (fnptr-of ~(sym body))
                                             (cast (ptr i8) (mut ~(sym job-v)))
                                             ~threads)
                         0))
                   (let [(mut ~(sym res-v)) (ArrayList::new [~cr] (rt/tree-allocator))]
                     (reserve! (mut ~(sym res-v)) (len ~(sym items)))
                     (for ~(sym o-v) (.out ~(sym job-v))
                       (match ~(sym o-v)
                         (Some [~(sym v-v)] (push! (mut ~(sym res-v)) ~(sym v-v)))
                         (None [] (panic "a stage's work left no answer for an item"))))
                     ~(sym res-v))))
            run
              (if (not naming)
                  once
                  (let [full (.namer (.stage sc))
                        slash (rt/name-end-at full 47)
                        nm (subslice full 0 slash)
                        nf (subslice full (+ slash 1) (len full))]
                    (when (< (mod-index (mut k) nm) 0)
                      (die (mut k)
                           n
                           (cat4 "this list is the work of a stage whose names go to "
                                 full
                                 ": the module that makes it must use "
                                 nm)))
                    (match (find-func (mod-at (mut k) nm) nf)
                      (None [] (die (mut k) n (cat4 nm " has no function named " nf "")))
                      (Some [g]
                            (unless (= (func-type g) "Fn(Text)->Int")
                              (die (mut k)
                                   n
                                   (cat full " is given names: it takes a Text and answers its Int")))
                            ;; While answers are tracked the calls run one at a time, and meet
                            ;; their names in order.
                            `(if (rt/dep-tracking?)
                                 ~once
                                 (do
                                   (rt/names-record-begin!)
                                   ~once
                                   (rt/names-record-end! ~(fn-value (mut k)
                                                                    `(fnptr-of ~(sym (qualified (mut k)
                                                                                                nm
                                                                                                (.coil g))))
                                                                    g)
                                                         (len ~(sym items)))
                                   ~once))))))]
        (locals-reset! (mut k) mark)
        (unless single (push! (mut (.aux k)) `(defstruct ~(sym tuple) [~@fields])))
        (push! (mut (.aux k))
               `(defstruct ~(sym job)
                  [(next i64) (xs (ArrayList ~ct)) (out (ArrayList (Option ~cr)))]))
        (push! (mut (.aux k))
               `(defn ~(sym body) [(arg (ptr i8))] (-> (ptr i8))
                  (let [j (cast (ptr ~(sym job)) arg)
                        xs (.xs j)
                        (mut out) (.out j)
                        (mut go) true]
                    (while go
                      (let [from (atomic/add (cast (ptr i64) j) ~step)
                            to (if (< (+ from ~step) (len xs)) (+ from ~step) (len xs))]
                        (if (< from (len xs))
                            (for i (range from to)
                              (rt/item-begin! i)
                              (let [t (get xs i)]
                                (set! (mut out) i (Some ~call))))
                            (set! go false))))
                    arg)))
        (te `(let [(mut ~(sym items)) (ArrayList::new [~ct] (rt/tree-allocator))]
               ~fill
               ~run)
            (cat3 "[" (.ret f) "]"))))))

(defn comprehension [(k (mut Comp)) (n g/Node) (want (slice u8)) (spread bool)]
  (-> TE)
  (match (if spread (None [StageCall]) (stage-call (mut k) (kid n 0)))
    (Some [sc] (stage-comprehension (mut k) n sc))
    (None [] (plain-comprehension (mut k) n want spread))))

(defn plain-comprehension [(k (mut Comp)) (n g/Node) (want (slice u8)) (spread bool)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        value (kid n 0)
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 1)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [twin (if spread (into-twin (mut k) value) (None [Func]))
          v
            (match twin
              (Some [f]
                    (te `0
                        (.ty (get (.params f) (len (list-kids (kid value 1)))))))
              (None []
                    (expr (mut k)
                          value
                          (if spread want (if (list? want) (elem-of want) "")))))
          _
            (when (and spread (not (list? (.ty v))))
              (die (mut k)
                   value
                   (cat "only a list can be spread, not " (.ty v))))
          elem (if spread (elem-of (.ty v)) (.ty v))
          o (fresh (mut k) "out")
          each (fresh (mut k) "each")
          push-code
            (match twin
              (Some [_] (spread-into (mut k) value (sym o) (.ty v)))
              (None []
                    (if spread
                        `(for (ref ~(sym each)) ~(.code v)
                           (push! (mut ~(sym o)) ~(sym each)))
                        `(push! (mut ~(sym o)) ~(.code v)))))
          clauses (list-kids (kid n 1))
          ;; One loop over a list or a range, with nothing that skips an item: as many items as it
          ;; has, made room for at once, so the list never moves as it grows.
          sized
            (and (not spread)
                 (= (len clauses) 1)
                 (or (= (.kind (get clauses 0)) (g/KInHead))
                     (= (.kind (get clauses 0)) (g/KRangeHead)))
                 (or (= (.wrap-kind (get opened 0)) 0)
                     (= (.wrap-kind (get opened 0)) 3)))]
      (if sized
          (let [h (get opened 0)
                seq (fresh (mut k) "seq")
                hi (fresh (mut k) "hi")
                (mut held) h]
            (set! (.seq held) (sym seq))
            (when (= (.wrap-kind h) 3) (set! (.hi held) (sym hi)))
            (let [loop (head-wrap (mut k) held push-code)
                  code
                    (if (= (.wrap-kind h) 3)
                        `(let [~(sym seq) ~(.seq h)
                               ~(sym hi) ~(.hi h)
                               (mut ~(sym o)) ~(new-list (mut k) elem)]
                           (when (> ~(sym hi) ~(sym seq))
                             (reserve! (mut ~(sym o)) (- ~(sym hi) ~(sym seq))))
                           ~loop
                           ~(sym o))
                        `(let [~(sym seq) ~(.seq h)
                               (mut ~(sym o)) ~(new-list (mut k) elem)]
                           (reserve! (mut ~(sym o)) (len ~(sym seq)))
                           ~loop
                           ~(sym o)))]
              (locals-reset! (mut k) mark)
              (te code (cat3 "[" elem "]"))))
          (let [body (clauses-code (mut k) clauses opened push-code)]
            (locals-reset! (mut k) mark)
            (te `(let [(mut ~(sym o)) ~(new-list (mut k) elem)] ~body ~(sym o))
                (cat3 "[" elem "]")))))))

;;; `{key: value for …}`: a later key replaces an earlier one, as assigning would.
(defn map-comprehension [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 2)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [key (expr (mut k) (kid n 0) (if (map? want) (map-key want) ""))
          val (expr (mut k) (kid n 1) (if (map? want) (map-val want) ""))
          ty (cat4 "{" (.ty key) ":" (cat (.ty val) "}"))
          o (fresh (mut k) "out")
          clauses (list-kids (kid n 2))
          put `(set! (mut ~(sym o)) ~(.code key) ~(.code val))
          ;; One loop over a list or a range, with nothing that skips an item: room for as many
          ;; keys as it has items, at once. A map that grows as it fills leaves each smaller
          ;; table behind it, and places every key again each time.
          sized
            (and (= (len clauses) 1)
                 (or (= (.kind (get clauses 0)) (g/KInHead))
                     (= (.kind (get clauses 0)) (g/KRangeHead)))
                 (or (= (.wrap-kind (get opened 0)) 0)
                     (= (.wrap-kind (get opened 0)) 3)))]
      (if sized
          (let [h (get opened 0)
                seq (fresh (mut k) "seq")
                hi (fresh (mut k) "hi")
                count (fresh (mut k) "count")
                (mut held) h]
            (set! (.seq held) (sym seq))
            (when (= (.wrap-kind h) 3) (set! (.hi held) (sym hi)))
            (let [loop (head-wrap (mut k) held put)
                  code
                    `(let [~(sym seq) ~(.seq h)
                           ~@(if (= (.wrap-kind h) 3)
                                 (let [(mut more) (primitive/code-list-new)]
                                   (push! (mut more) (sym hi))
                                   (push! (mut more) (.hi h))
                                   more)
                                 (primitive/code-list-new))
                           ~(sym count) ~(if (= (.wrap-kind h) 3)
                                             `(- ~(sym hi) ~(sym seq))
                                             `(len ~(sym seq)))
                           (mut ~(sym o)) ~(new-map (mut k) ty)]
                       (when (> ~(sym count) 5)
                         (HashMap::grow! (mut ~(sym o)) (+ (/ (* ~(sym count) 4) 3) 2)))
                       ~loop
                       ~(sym o))]
              (locals-reset! (mut k) mark)
              (te code ty)))
          (let [body (clauses-code (mut k) clauses opened put)]
            (locals-reset! (mut k) mark)
            (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)] ~body ~(sym o)) ty))))))

;;; `{k: v, …}`: typed by what is wanted, or else by its first entry.
(defn map-literal [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [entries (list-kids (kid n 0))
        e0 (get entries 0)
        ty
          (if (map? want)
              want
              (cat4 "{"
                    (.ty (expr (mut k) (kid e0 0) ""))
                    ":"
                    (cat (.ty (expr (mut k) (kid e0 1) "")) "}")))
        o (fresh (mut k) "out")]
    (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)]
           ~(map-extend-code (mut k) n (sym o) ty)
           ~(sym o))
        ty)))

;;; `m ++= e`, as a fold accumulating a map does it: a literal's entries, or a comprehension's, go
;;; straight into `m`; the right of `a ++ b` wins.
(defn map-extend-code [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (match (.kind e)
    (g/KMapLit []
               (let [(mut sets) (primitive/code-list-new)]
                 (for x (list-kids (kid e 0))
                   (let [key
                           (expect (mut k)
                                   (kid x 0)
                                   (expr (mut k) (kid x 0) (map-key t))
                                   (map-key t))
                         val
                           (expect (mut k)
                                   (kid x 1)
                                   (expr (mut k) (kid x 1) (map-val t))
                                   (map-val t))]
                     (push! (mut sets)
                            `(set! (mut ~target) ~(.code key) ~(.code val)))))
                 `(do ~@sets 0)))
    (g/KConcat []
               `(do
                  ~(map-extend-code (mut k) (kid e 0) target t)
                  ~(map-extend-code (mut k) (kid e 1) target t)
                  0))
    (g/KMapComp []
                (let [mark (locals-mark (mut k))
                      (mut opened)
                        (ArrayList::new [HeadInfo] (malloc-allocator))]
                  (for c (list-kids (kid e 2))
                    (push! (mut opened) (clause-open! (mut k) c)))
                  (let [key
                          (expect (mut k)
                                  (kid e 0)
                                  (expr (mut k) (kid e 0) (map-key t))
                                  (map-key t))
                        val
                          (expect (mut k)
                                  (kid e 1)
                                  (expr (mut k) (kid e 1) (map-val t))
                                  (map-val t))
                        body
                          (clauses-code (mut k)
                                        (list-kids (kid e 2))
                                        opened
                                        `(set! (mut ~target)
                                               ~(.code key)
                                               ~(.code val)))]
                    (locals-reset! (mut k) mark)
                    `(do ~body 0))))
    (_ (let [v (expect (mut k) e (expr (mut k) e t) t)]
         (map-copy-into (mut k) (.code v) target)))))

(defn map-copy-into [(k (mut Comp)) (from Code) (target Code)] (-> Code)
  (let [m (fresh (mut k) "m")
        x (fresh (mut k) "key")
        v (fresh (mut k) "v")]
    `(let [~(sym m) ~from]
       (for ~(sym x) ~(sym m)
         (match (get ~(sym m) ~(sym x))
           (Some [~(sym v)] (set! (mut ~target) ~(sym x) ~(sym v)))
           (None [] 0)))
       0)))

;;; `join([a ++ b for …], ", ")`: each item's pieces go straight into one buffer, with no list and no
;;; text for each item. The separator is a literal, so nothing it does can move.
(defn join-comprehension [(k (mut Comp)) (comp g/Node) (sep-node g/Node)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        b (fresh (mut k) "b")
        first (fresh (mut k) "first")
        sep (expect (mut k) sep-node (expr (mut k) sep-node "Text") "Text")
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
        (mut parts) (ArrayList::new [g/Node] (malloc-allocator))
        (mut pushes) (primitive/code-list-new)]
    (for c (list-kids (kid comp 1))
      (push! (mut opened) (clause-open! (mut k) c)))
    (if (= (.kind (kid comp 0)) (g/KConcat))
        (concat-operands! (kid comp 0) (mut parts))
        (push! (mut parts) (kid comp 0)))
    (for p parts
      (let [x (expect (mut k) p (expr (mut k) p "Text") "Text")]
        (push! (mut pushes) `(push-str! (mut ~(sym b)) ~(.code x)))))
    (let [each
            `(do
               (unless ~(sym first) (push-str! (mut ~(sym b)) ~(.code sep)))
               (set! ~(sym first) false)
               ~@pushes)
          body (clauses-code (mut k) (list-kids (kid comp 1)) opened each)]
      (locals-reset! (mut k) mark)
      (te `(let [(mut ~(sym b)) (str/StrBuf::new (rt/value-allocator))
                 (mut ~(sym first)) true]
             ~body
             (finish! (mut ~(sym b))))
          "Text"))))

(defn zeros-code [(k (mut Comp)) (n-v (slice u8))] (-> Code)
  `(let [(mut z) ~(new-list (mut k) "Int")]
     (reserve! (mut z) ~(sym n-v))
     (for _ (range 0 ~(sym n-v)) (push! (mut z) 0))
     z))

(defn histogram-add [(o (slice u8))
                     (key-v (slice u8))
                     (n-v (slice u8))
                     (w Code)] (-> Code)
  `(do
     (when (or (< ~(sym key-v) 0) (>= ~(sym key-v) ~(sym n-v)))
       (panic "histogram key {} is outside 0 to {}" ~(sym key-v) ~(sym n-v)))
     (set! (mut ~(sym o)) ~(sym key-v) (+ (get ~(sym o) ~(sym key-v)) ~w))))

;;; `fold acc = init for …: e`: `acc` starts as `init`, and each time round becomes `e`. With
;;; `scan`, the list of what it became each time.
;;; Whether `more` can go into the accumulator `name` as it is made: when nothing in it reads the
;;; accumulator, or when all of it is made before any of it goes in. `extend-code` and
;;; `map-extend-code` add a literal's items, a comprehension's and the two sides of `++` one at a
;;; time, so those must not read it unless one item is all there is; anything they add whole is
;;; made first.
(defn added-whole? [(more g/Node) (name (slice u8))] (-> bool)
  (if (not (mentions-name? more name))
      true
      (match (.kind more)
        (g/KListLit []
                    (or (= (len (list-kids (kid more 0))) 0)
                        (and (= (len (list-kids (kid more 0))) 1)
                             (not (spread-arg? (kid (kid more 0) 0))))))
        (g/KMapLit [] (= (len (list-kids (kid more 0))) 1))
        (g/KIf []
               (or (none? (kid more 2))
                   (= (.kind (kid more 1)) (g/KBlock))
                   (= (.kind (kid more 2)) (g/KBlock))
                   (and (added-whole? (kid more 1) name)
                        (added-whole? (kid more 2) name))))
        (g/KConcat [] false)
        (g/KComp [] false)
        (g/KCompSpread [] false)
        (g/KMapComp [] false)
        (g/KCall [] false)
        (_ true))))

;;; A record accumulator's first value, its own: a list or map field that came from a name is copied,
;;; so changing it in place changes nothing else.
(defn record-start [(k (mut Comp)) (init-node g/Node) (init TE)] (-> Code)
  (let [r (fresh (mut k) "start")
        rec
          (match (find-rec (mod-at (mut k) (type-module (.ty init)))
                           (type-name (.ty init)))
            (Some [x] x)
            (None [] (die (mut k) init-node "no such record")))
        (mut copies) (primitive/code-list-new)]
    (for f (.fields rec)
      (when (and (or (list? (.ty f)) (map? (.ty f)))
                 (record-field-shared? init-node (.name f)))
        (let [field `(~(primitive/code-symbol "." (.name f)) ~(sym r))]
          (push! (mut copies)
                 `(set! ~field ~(list-copy (mut k) (te field (.ty f))))))))
    `(let [(mut ~(sym r)) ~(.code init)] ~@copies ~(sym r))))

;;; Whether a constructor's field may share its list or map with something else: anything but a
;;; constructor whose argument for the field makes a new one.
(defn record-field-shared? [(init g/Node) (field (slice u8))] (-> bool)
  (if (not (= (.kind init) (g/KCtor)))
      true
      (let [(mut shared) true]
        (for a (list-kids (kid init 1))
          (when (and (= (.kind a) (g/KNamed)) (= (.text (kid a 0)) field))
            (set! shared
                  (match (.kind (kid a 1))
                    (g/KName [] true)
                    (g/KFieldE [] true)
                    (g/KIndex [] true)
                    (_ false)))))
        shared)))

;;; One step of a record fold: every new value worked out from the accumulator as it stands, then
;;; each field changed. `acc.f ++ more` adds to the field in place: `more` worked out first when it is
;;; one entry or item, or in place when it does not read the accumulator; any other value replaces.
(defn record-step [(k (mut Comp))
                   (step g/Node)
                   (acc Code)
                   (acc-name (slice u8))
                   (ty (slice u8))] (-> Code)
  (let [(mut lets) (primitive/code-list-new)
        (mut applies) (primitive/code-list-new)]
    (for fi (list-kids (kid step 1))
      (let [field (.text (kid fi 0))
            v (kid fi 1)
            fty (field-type (mut k) fi ty field)
            target `(~(primitive/code-symbol "." field) ~acc)
            extends
              (and (or (list? fty) (map? fty))
                   (= (.kind v) (g/KConcat))
                   (= (.kind (kid v 0)) (g/KFieldE))
                   (= (.kind (kid (kid v 0) 0)) (g/KName))
                   (= (.text (kid (kid v 0) 0)) acc-name)
                   (= (.text (kid (kid v 0) 1)) field))
            more (if extends (kid v 1) v)
            reads (mentions-name? more acc-name)]
        (cond (and extends
                   (map? fty)
                   (= (.kind more) (g/KMapLit))
                   (= (len (list-kids (kid more 0))) 1))
                (let [entry (get (list-kids (kid more 0)) 0)
                      key
                        (expect (mut k)
                                (kid entry 0)
                                (expr (mut k) (kid entry 0) (map-key fty))
                                (map-key fty))
                      val
                        (expect (mut k)
                                (kid entry 1)
                                (expr (mut k) (kid entry 1) (map-val fty))
                                (map-val fty))
                      tk (fresh (mut k) "key")
                      tv (fresh (mut k) "val")]
                  (push! (mut lets) (sym tk))
                  (push! (mut lets) (.code key))
                  (push! (mut lets) (sym tv))
                  (push! (mut lets) (.code val))
                  (push! (mut applies)
                         `(set! (mut ~target) ~(sym tk) ~(sym tv))))
              (and extends
                   (list? fty)
                   (= (.kind more) (g/KListLit))
                   (= (len (list-kids (kid more 0))) 1)
                   (not (spread-arg? (get (list-kids (kid more 0)) 0))))
                (let [item (get (list-kids (kid more 0)) 0)
                      x
                        (expect (mut k)
                                item
                                (expr (mut k) item (elem-of fty))
                                (elem-of fty))
                      tx (fresh (mut k) "item")]
                  (push! (mut lets) (sym tx))
                  (push! (mut lets) (.code x))
                  (push! (mut applies) `(push! (mut ~target) ~(sym tx))))
              (and extends (not reads))
                (push! (mut applies)
                       (if (map? fty)
                           (map-extend-code (mut k) more target fty)
                           (extend-code (mut k) more target fty)))
              :else
                (let [x (expect (mut k) v (expr (mut k) v fty) fty)
                      t (fresh (mut k) "new")]
                  (push! (mut lets) (sym t))
                  (push! (mut lets) (.code x))
                  (push! (mut applies) `(set! ~target ~(sym t)))))))
    `(let [~@lets] ~@applies 0)))

(defn mentions-name? [(n g/Node) (name (slice u8))] (-> bool)
  (if (and (= (.kind n) (g/KName)) (= (.text n) name))
      true
      (let [(mut found) false]
        (for c (.kids n)
          (when (and (not found) (mentions-name? c name)) (set! found true)))
        found)))

(defn fold-expr [(k (mut Comp)) (n g/Node) (want (slice u8)) (scan bool)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        init
          (expr (mut k)
                (kid n 1)
                (if scan (if (list? want) (elem-of want) "") want))
        ty (.ty init)
        acc (bind-local! (mut k) (.text (kid n 0)) ty false)
        o (fresh (mut k) "steps")
        step-node (kid n 3)
        ;; `fold xs = … : xs ++ more`: `more` goes into the accumulator, which is its own, as a
        ;; `var`'s is, and the list or map is never copied.
        in-place
          (and (not scan)
               (or (list? ty) (map? ty))
               (= (.kind step-node) (g/KConcat))
               (= (.kind (kid step-node 0)) (g/KName))
               (= (.text (kid step-node 0)) (.text (kid n 0)))
               (added-whole? (kid step-node 1) (.text (kid n 0))))
        ;; `fold r = R(…) …: r with { names: r.names ++ more, count: r.count + 1 }`: a record's
        ;; fields changed where they are, each new value worked out before any changes.
        ;; Also `(r with { … } where x = …)`: the equations are worked out first, from `r` as it stands.
        step-where
          (if (and (= (.kind step-node) (g/KGroup))
                   (= (.kind (kid step-node 0)) (g/KWhereE)))
              (Some (kid step-node 0))
              (None [g/Node]))
        with-node (match step-where (Some [w] (kid w 0)) (None [] step-node))
        in-record
          (and (not scan)
               (not in-place)
               (record-type? (mut k) ty)
               (not (boxed-record? (mut k) ty))
               (= (.kind with-node) (g/KWithE))
               (= (.kind (kid with-node 0)) (g/KName))
               (= (.text (kid with-node 0)) (.text (kid n 0))))
        start
          (cond (and in-place
                     (match (.kind (kid n 1))
                       (g/KName [] true)
                       (g/KFieldE [] true)
                       (g/KIndex [] true)
                       (_ false)))
                  (list-copy (mut k) init)
                in-record (record-start (mut k) (kid n 1) init)
                :else (.code init))
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 2)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [each
            (cond in-record
                    (match step-where
                      (Some [w]
                            (let [lets (where-open! (mut k) w)]
                              `(let [~@lets]
                                 ~(record-step (mut k)
                                               with-node
                                               (sym acc)
                                               (.text (kid n 0))
                                               ty))))
                      (None []
                            (record-step (mut k)
                                         with-node
                                         (sym acc)
                                         (.text (kid n 0))
                                         ty)))
                  in-place
                    (if (map? ty)
                        (map-extend-code (mut k) (kid step-node 1) (sym acc) ty)
                        (extend-code (mut k) (kid step-node 1) (sym acc) ty))
                  scan
                    (let [step
                            (expect (mut k)
                                    step-node
                                    (expr (mut k) step-node ty)
                                    ty)]
                      `(do
                         (set! ~(sym acc) ~(.code step))
                         (push! (mut ~(sym o)) ~(sym acc))))
                  :else
                    (let [step
                            (expect (mut k)
                                    step-node
                                    (expr (mut k) step-node ty)
                                    ty)]
                      `(set! ~(sym acc) ~(.code step))))
          body (clauses-code (mut k) (list-kids (kid n 2)) opened each)]
      (locals-reset! (mut k) mark)
      (if scan
          (te `(let [(mut ~(sym acc)) ~(.code init)
                     (mut ~(sym o)) ~(new-list (mut k) ty)]
                 ~body
                 ~(sym o))
              (cat3 "[" ty "]"))
          (te `(let [(mut ~(sym acc)) ~start] ~body ~(sym acc)) ty)))))

(defn loop-all [(k (mut Comp)) (n g/Node) (negate-empty bool)] (-> TE)
  (let [mark (locals-mark (mut k))
        opened (quant-open! (mut k) n)
        c (expect (mut k) (kid n 2) (expr (mut k) (kid n 2) "Bool") "Bool")
        label (primitive/code-symbol ":" (fresh (mut k) "q"))
        inner
          (if negate-empty
              `(when ~(.code c) (return-from ~label true))
              `(unless ~(.code c) (return-from ~label false)))
        code (quant-wrap (mut k) n opened inner)]
    (locals-reset! (mut k) mark)
    (te `(block ~label ~code ~(if negate-empty `false `true)) "Bool")))

;;; A quantifier's loop and the clauses after it, `first x in xs if p(x) for y in ys: …`, opened in
;;; order.
(defn quant-open! [(k (mut Comp)) (n g/Node)] (-> (ArrayList HeadInfo))
  (let [(mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (push! (mut opened) (head-open! (mut k) (kid n 0)))
    (for c (list-kids (kid n 1)) (push! (mut opened) (clause-open! (mut k) c)))
    opened))

(defn quant-wrap [(k (mut Comp))
                  (n g/Node)
                  (opened (ArrayList HeadInfo))
                  (inner Code)] (-> Code)
  (if (= (len opened) 1)
      (head-wrap (mut k) (get opened 0) inner)
      (let [(mut cs) (ArrayList::new [g/Node] (malloc-allocator))]
        (push! (mut cs) (kid n 0))
        (for c (list-kids (kid n 1)) (push! (mut cs) c))
        (clauses-code (mut k) cs opened inner))))

(defn expr [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (match (part-read (mut k) n want)
    (Some [read] read)
    (None [] (plain-expr (mut k) n want))))

;;; A read of part of a setting: the setting, its module, and the fields read through, from the
;;; outside in. `an.linked.wrapped` is `linked` of `bundle.analysis` through `wrapped`.
(defstruct SettingPart
  [(module (slice u8)) (x Global) (fields (ArrayList (slice u8)))])

(defn setting-part [(k (mut Comp)) (e g/Node)] (-> (Option SettingPart))
  (match (.kind e)
    (g/KGroup [] (setting-part (mut k) (kid e 0)))
    (g/KName []
             (match (find-local (mut k) (.text e))
               (Some [_] (None [SettingPart]))
               (None []
                     (match (find-global (self-mod (mut k)) (.text e))
                       (Some [x]
                             (if (= (.attr x) 5)
                                 (Some (SettingPart
                                         :module (.self k)
                                         :x x
                                         :fields (text-list)))
                                 (None [SettingPart])))
                       (None [] (None [SettingPart]))))))
    (g/KFieldE []
               (match (module-prefix (mut k) (kid e 0))
                 (Some [module]
                       (match (find-global (mod-at (mut k) module)
                                           (.text (kid e 1)))
                         (Some [x]
                               (if (= (.attr x) 5)
                                   (Some (SettingPart
                                           :module module
                                           :x x
                                           :fields (text-list)))
                                   (None [SettingPart])))
                         (None [] (None [SettingPart]))))
                 (None []
                       (match (setting-part (mut k) (kid e 0))
                         (Some [p]
                               (let [(mut fields) (.fields p)]
                                 (push! (mut fields) (.text (kid e 1)))
                                 (Some (SettingPart
                                         :module (.module p)
                                         :x (.x p)
                                         :fields fields))))
                         (None [] (None [SettingPart]))))))
    (_ (None [SettingPart]))))

(defn fields-path [(fields (ArrayList (slice u8)))] (-> (slice u8))
  (let [(mut out) ""]
    (for f fields (set! out (cat3 out "." f)))
    out))

;;; While dependencies are tracked, a memo that reads a setting's field (`linked.wrapped`) or one
;;; element of it (`modules[id]`, `linked.cjs-imports[s]`) is made from that part only: binding the
;;; setting again changes only what differs (see `setting-changed-code`).
(defn part-read [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> (Option TE))
  (if (> (.quiet k) 0)
      (None [TE])
      (match (.kind n)
        (g/KFieldE []
                   (match (setting-part (mut k) n)
                     (Some [p]
                           (if (= (len (.fields p)) 0)
                               (None [TE])
                               (let [node
                                       (cat4 "s:"
                                             (.module p)
                                             "."
                                             (.name (.x p)))
                                     path (fields-path (.fields p))
                                     v (fresh (mut k) "part")]
                                 (set! (.quiet k) (+ (.quiet k) 1))
                                 (let [read (plain-expr (mut k) n want)]
                                   (set! (.quiet k) (- (.quiet k) 1))
                                   (Some (te `(let [~(sym v) ~(.code read)]
                                                (when (rt/dep-in-frame?)
                                                  (rt/dep-note-fixed! (primitive/alloc-static i64)
                                                                      ~node
                                                                      ~path))
                                                ~(sym v))
                                             (.ty read)))))))
                     (None [] (None [TE]))))
        (g/KIndex []
                  (match (setting-part (mut k) (kid n 0))
                    (Some [p]
                          (let [node (cat4 "s:" (.module p) "." (.name (.x p)))
                                path (cat (fields-path (.fields p)) "#")
                                kv (fresh (mut k) "key")]
                            (set! (.quiet k) (+ (.quiet k) 1))
                            (let [b (plain-expr (mut k) (kid n 0) "")
                                  t (.ty b)]
                              (set! (.quiet k) (- (.quiet k) 1))
                              (cond (list? t)
                                      (let [i
                                              (expect (mut k)
                                                      (kid n 1)
                                                      (expr (mut k)
                                                            (kid n 1)
                                                            "Int")
                                                      "Int")]
                                        (Some (te `(let [~(sym kv) ~(.code i)]
                                                     (when (rt/dep-in-frame?)
                                                       (rt/dep-note-element! (primitive/alloc-static i64)
                                                                             ~node
                                                                             ~path
                                                                             ~(sym kv)))
                                                     (get ~(.code b) ~(sym kv)))
                                                  (elem-of t))))
                                    (and (map? t)
                                         (or (= (map-key t) "Int")
                                             (= (map-key t) "Text")))
                                      (let [i
                                              (expect (mut k)
                                                      (kid n 1)
                                                      (expr (mut k)
                                                            (kid n 1)
                                                            (map-key t))
                                                      (map-key t))]
                                        (Some (te `(let [~(sym kv) ~(.code i)]
                                                     ~(if (= (map-key t) "Int")
                                                          `(when (rt/dep-in-frame?)
                                                             (rt/dep-note-element! (primitive/alloc-static i64)
                                                                                   ~node
                                                                                   ~path
                                                                                   ~(sym kv)))
                                                          `(when (rt/dep-in-frame?)
                                                             (rt/dep-note-keyed! (primitive/alloc-static i64)
                                                                                 ~node
                                                                                 ~path
                                                                                 ~(sym kv))))
                                                     (get ~(.code b) ~(sym kv)))
                                                  (opt-type (map-val t)))))
                                    :else (None [TE])))))
                    (None [] (None [TE]))))
        (_ (None [TE])))))

;;; What binding setting `name` of `module`, of type `ty`, from `old` to `new` changes. While
;;; dependencies are tracked: each part of it some memo read that is not the same in both, and the
;;; whole. Otherwise every memo answer of the module's starts over.
(defn facts-db? [(k (mut Comp)) (t (slice u8))] (-> bool)
  (and (> (last-dot t) 0)
       (> (mod-index (mut k) (type-module t)) -1)
       (= (.sort (mod-at (mut k) (type-module t))) (SFacts))
       (= (type-name t) "Db")))

(defn setting-changed-code [(k (mut Comp))
                            (module (slice u8))
                            (name (slice u8))
                            (ty (slice u8))
                            (old Code)
                            (new Code)
                            (both-given Code)]
  (-> Code)
  (let [node (cat4 "s:" module "." name)
        o (fresh (mut k) "old")
        n (fresh (mut k) "new")
        ;; While nothing is tracked, the answers that read it start over.
        untracked `(rt/forget-readers! ~(cat3 module "." name))]
    ;; A value nothing gave is no value to look into: going from or to one changes everything read.
    `(if (rt/dep-tracking?)
         (if ~both-given
             (let [~(sym o) ~old
                   ~(sym n) ~new]
               (unless ~(same-code (mut k) ty (sym o) (sym n))
                 ~(if (facts-db? (mut k) ty)
                      ;; A database: the queries that see a row one relation gained or lost. One made
                      ;; from the other in place says which those are; any other is compared.
                      (let [(mut calls) (primitive/code-list-new)
                            (mut said) (primitive/code-list-new)
                            (mut at) 0
                            module (type-module ty)]
                        (for r (.rels (mod-at (mut k) module))
                          (push! (mut said)
                                 `(rt/dep-rows-changed! ~node
                                                        ~(.name r)
                                                        (~(sym (qualified (mut k) module "rows-gone")) ~(sym n)
                                                           ~at)
                                                        (~(sym (qualified (mut k) module "rows-come")) ~(sym n)
                                                           ~at)
                                                        ~(.arity r)))
                          (push! (mut calls)
                                 `(let [(mut x)
                                          (~(primitive/code-symbol "."
                                                                   (.name r)) ~(sym o))
                                        (mut y)
                                          (~(primitive/code-symbol "."
                                                                   (.name r)) ~(sym n))]
                                    (rt/dep-rel-changed! ~node
                                                         ~(.name r)
                                                         (mut x)
                                                         (mut y))))
                          (set! at (+ at 1)))
                        `(if (~(sym (qualified (mut k) module "made-from?")) ~(sym o)
                                ~(sym n))
                             (do ~@said 0)
                             (do ~@calls 0)))
                      `(do
                         (for path (rt/dep-paths ~node)
                           (when (~(diff-helper (mut k) ty) ~(sym o)
                                    ~(sym n)
                                    path)
                             (rt/dep-changed! (rt/join ~node path))))
                         ;; Parts read by number: compared by number, no text made.
                         (for site (rt/dep-sites ~node)
                           (let [prefix (rt/site-prefix site)
                                 suffix (rt/site-suffix site)
                                 keys (rt/site-keys site)
                                 ranges ~(changes-code (mut k) ty (sym o) (sym n) `prefix `suffix)]
                             (for r (range 0 (/ (len ranges) 2))
                               (let [pairs
                                       (if (< (get ranges 0) 0)
                                           (rt/site-nodes site)
                                           (rt/site-nodes-in site
                                                             (get ranges (* 2 r))
                                                             (get ranges (+ (* 2 r) 1))))]
                                 (for i (range 0 (/ (len pairs) 2))
                                   (let [index (get pairs (* 2 i))]
                                     (when (~(diffn-helper (mut k) ty) ~(sym o)
                                              ~(sym n)
                                              prefix
                                              index
                                              (if (< index (len keys))
                                                  (get keys index)
                                                  "")
                                              suffix)
                                       (rt/dep-changed-id! (get pairs (+ (* 2 i) 1))))))))))
                         0))
                 (rt/dep-changed! ~node)))
             (do
               (for path (rt/dep-paths ~node)
                 (rt/dep-changed! (rt/join ~node path)))
               (for site (rt/dep-sites ~node)
                 (let [pairs (rt/site-nodes site)]
                   (for i (range 0 (/ (len pairs) 2))
                     (rt/dep-changed-id! (get pairs (+ (* 2 i) 1))))))
               (rt/dep-changed! ~node)))
         ~untracked)))

;;; Where a setting of type `t` going from `a` to `b` may differ, for a site reading it by number
;;; between `prefix` and `suffix`: ranges of those numbers, `lo` then `hi` for each, or one range
;;; whose `lo` is -1 for every number read. A foreign module's opaque type that knows where it
;;; changed says so, by `changes-T(a, b, accessor)`, for a site applying an accessor to it
;;; (`@scope-at(` 3 `)`); for anything else every number read is looked at.
(defn changes-code [(k (mut Comp))
                    (t (slice u8))
                    (a Code)
                    (b Code)
                    (prefix Code)
                    (suffix Code)] (-> Code)
  (let [every `(rt/ints-of -1 -1)]
    (if (and (> (len (type-module t)) 0)
             (> (mod-index (mut k) (type-module t)) -1)
             (= (.sort (mod-at (mut k) (type-module t))) (SForeign)))
        (match (find-func (mod-at (mut k) (type-module t))
                          (cat "changes-" (type-name t)))
          (None [] every)
          (Some [f]
                `(if (and (rt/starts-with ~prefix "@") (= ~suffix ")"))
                     (~(sym (qualified (mut k) (type-module t) (.coil f))) ~a
                        ~b
                        (subslice ~prefix 1 (- (len ~prefix) 1)))
                     ~every)))
        every)))

;;; The helper saying whether two values of a type differ at a part read by number: the path
;;; `prefix` `index` `suffix` (`#` 3, `.field#` 3, `@symbol-at(` 3 `)`), without the text made. A
;;; map by Text is read at `key`, which its site numbered `index`.
(defn diffn-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (cat "diffn" (subslice (same-name t) 4 (len (same-name t))))
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (let [body
              (cond (opt? t) `true
                    (list? t)
                      `(if (or (!= prefix "#") (!= suffix ""))
                           true
                           (let [in-a (< index (len a))
                                 in-b (< index (len b))]
                             (if (and in-a in-b)
                                 (not ~(same-code (mut k)
                                                  (elem-of t)
                                                  `(get a index)
                                                  `(get b index)))
                                 (!= in-a in-b))))
                    (and (map? t) (= (map-key t) "Int"))
                      `(if (or (!= prefix "#") (!= suffix ""))
                           true
                           (not ~(same-code (mut k)
                                            (opt-type (map-val t))
                                            `(get a index)
                                            `(get b index))))
                    (and (map? t) (= (map-key t) "Text"))
                      `(if (or (!= prefix "#") (!= suffix ""))
                           true
                           (not ~(same-code (mut k)
                                            (opt-type (map-val t))
                                            `(get a key)
                                            `(get b key))))
                    (and (not (map? t))
                         (not (fn? t))
                         (not (list? t))
                         (> (len (type-module t)) 0)
                         (> (mod-index (mut k) (type-module t)) -1)
                         (is-some? (find-rec (mod-at (mut k) (type-module t))
                                             (type-name t))))
                      (let [r
                              (match (find-rec (mod-at (mut k) (type-module t))
                                               (type-name t))
                                (Some [r] r)
                                (None [] (panic "rules: no record {}" t)))
                            (mut arms) (primitive/code-list-new)]
                        (for f (.fields r)
                          (push! (mut arms) `(= field ~(.name f)))
                          (push! (mut arms)
                                 `(~(diffn-helper (mut k) (.ty f)) (~(primitive/code-symbol "."
                                                                                            (.name f)) a)
                                     (~(primitive/code-symbol "." (.name f)) b)
                                     more
                                     index
                                     key
                                     suffix)))
                        `(if (or (= (len prefix) 0)
                                 (!= (cast i64 (get prefix 0)) 46))
                             true
                             (let [rest (subslice prefix 1 (len prefix))
                                   cut (rt/name-end rest)
                                   field (subslice rest 0 cut)
                                   more (subslice rest cut (len rest))]
                               (cond ~@arms :else true))))
                    (and (> (len (type-module t)) 0)
                         (> (mod-index (mut k) (type-module t)) -1)
                         (= (.sort (mod-at (mut k) (type-module t))) (SForeign)))
                      (let [module (type-module t)
                            (mut arms) (primitive/code-list-new)]
                        (for f (.funcs (mod-at (mut k) module))
                          (when (and (accessor? (mut k) module f)
                                     (= (.ty (get (.params f) 0)) t)
                                     (= (len (.params f)) 2)
                                     (= (.ty (get (.params f) 1)) "Int"))
                            (push! (mut arms)
                                   `(= prefix ~(cat3 "@" (.name f) "(")))
                            (push! (mut arms)
                                   `(not ~(same-code (mut k)
                                                     (.ret f)
                                                     `(~(sym (qualified (mut k)
                                                                        module
                                                                        (.coil f))) a
                                                         index)
                                                     `(~(sym (qualified (mut k)
                                                                        module
                                                                        (.coil f))) b
                                                         index))))))
                        `(cond ~@arms :else true))
                    :else `true)]
        (push! (mut (.aux k))
               `(defn ~(sym name) [(a ~ty)
                                   (b ~ty)
                                   (prefix (slice u8))
                                   (index i64)
                                   (key (slice u8))
                                   (suffix (slice u8))] (-> bool)
                  ~body))))
    (sym name)))

;;; The helper saying whether two values of a type differ at a path: `.field` into a record, `#key`
;;; into a list or map, nothing for the whole. A path it cannot follow differs.
(defn diff-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (cat "diff" (subslice (same-name t) 4 (len (same-name t))))
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (let [body
              (cond (opt? t) `true
                    (list? t)
                      `(if (!= (cast i64 (get path 0)) 35)
                           true
                           (let [i (rt/parse-int (subslice path 1 (len path)))
                                 in-a (< i (len a))
                                 in-b (< i (len b))]
                             (if (and in-a in-b)
                                 (not ~(same-code (mut k)
                                                  (elem-of t)
                                                  `(get a i)
                                                  `(get b i)))
                                 (!= in-a in-b))))
                    (and (map? t)
                         (or (= (map-key t) "Int") (= (map-key t) "Text")))
                      `(if (!= (cast i64 (get path 0)) 35)
                           true
                           (let [text (subslice path 1 (len path))
                                 key
                                   ~(if (= (map-key t) "Int")
                                        `(rt/parse-int text)
                                        `text)]
                             (not ~(same-code (mut k)
                                              (opt-type (map-val t))
                                              `(get a key)
                                              `(get b key)))))
                    (and (not (opt? t))
                         (not (map? t))
                         (not (fn? t))
                         (not (list? t))
                         (> (len (type-module t)) 0)
                         (is-some? (find-rec (mod-at (mut k) (type-module t))
                                             (type-name t))))
                      (let [r
                              (match (find-rec (mod-at (mut k) (type-module t))
                                               (type-name t))
                                (Some [r] r)
                                (None [] (panic "rules: no record {}" t)))
                            (mut arms) (primitive/code-list-new)]
                        (for f (.fields r)
                          (push! (mut arms) `(= field ~(.name f)))
                          (push! (mut arms)
                                 `(~(diff-helper (mut k) (.ty f)) (~(primitive/code-symbol "."
                                                                                           (.name f)) a)
                                     (~(primitive/code-symbol "." (.name f)) b)
                                     more)))
                        `(if (!= (cast i64 (get path 0)) 46)
                             true
                             (let [rest (subslice path 1 (len path))
                                   cut (rt/name-end rest)
                                   field (subslice rest 0 cut)
                                   more (subslice rest cut (len rest))]
                               (cond ~@arms :else true))))
                    (and (> (mod-index (mut k) (type-module t)) -1)
                         (= (.sort (mod-at (mut k) (type-module t))) (SFacts)))
                      (let [mo (mod-at (mut k) (type-module t))
                            (mut arms) (primitive/code-list-new)]
                        (for r (.rels mo)
                          (push! (mut arms) `(= rel ~(.name r)))
                          (push! (mut arms)
                                 `(let [(mut x)
                                          (~(primitive/code-symbol "."
                                                                   (.name r)) a)
                                        (mut y)
                                          (~(primitive/code-symbol "."
                                                                   (.name r)) b)]
                                    (not (rt/rel-rows-same? (mut x)
                                                            (mut y)
                                                            spec)))))
                        `(if (!= (cast i64 (get path 0)) 46)
                             true
                             (let [open (rt/name-end-at path 40)
                                   rel (subslice path 1 open)
                                   spec
                                     (subslice path (+ open 1) (- (len path) 1))]
                               (cond ~@arms :else true))))
                    (and (> (mod-index (mut k) (type-module t)) -1)
                         (= (.sort (mod-at (mut k) (type-module t))) (SForeign)))
                      (let [module (type-module t)
                            (mut arms) (primitive/code-list-new)]
                        (for f (.funcs (mod-at (mut k) module))
                          (when (and (accessor? (mut k) module f)
                                     (= (.ty (get (.params f) 0)) t))
                            (let [(mut call-a) (primitive/code-list-new)
                                  (mut call-b) (primitive/code-list-new)]
                              (push! (mut call-a) `a)
                              (push! (mut call-b) `b)
                              (for i (range 1 (len (.params f)))
                                (let [pt (.ty (get (.params f) i))
                                      raw `(get parts ~(- i 1))
                                      v
                                        (cond (= pt "Int") `(rt/parse-int ~raw)
                                              (= pt "Bool") `(= ~raw "1")
                                              :else raw)]
                                  (push! (mut call-a) v)
                                  (push! (mut call-b) v)))
                              (push! (mut arms) `(= name ~(.name f)))
                              (push! (mut arms)
                                     `(not ~(same-code (mut k)
                                                       (.ret f)
                                                       `(~(sym (qualified (mut k)
                                                                          module
                                                                          (.coil f))) ~@call-a)
                                                       `(~(sym (qualified (mut k)
                                                                          module
                                                                          (.coil f))) ~@call-b)))))))
                        `(if (!= (cast i64 (get path 0)) 64)
                             true
                             (let [open (rt/name-end-at path 40)
                                   name (subslice path 1 open)
                                   inside
                                     (subslice path (+ open 1) (- (len path) 1))
                                   parts
                                     (if (rt/contains-text? inside ":")
                                         (rt/memo-key-parts inside)
                                         (rt/split inside ","))]
                               (cond ~@arms :else true))))
                    :else `true)]
        (push! (mut (.aux k))
               `(defn ~(sym name) [(a ~ty) (b ~ty) (path (slice u8))] (-> bool)
                  (if (= (len path) 0)
                      (not ~(same-code (mut k) t `a `b))
                      ~body)))))
    (sym name)))

(defn plain-expr [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (match (.kind n)
    (g/KInt [] (te `~(rt/parse-int (.text n)) "Int"))
    (g/KStr [] (te `~(str-literal n) "Text"))
    (g/KChar [] (te `~(char-value n) "Int"))
    (g/KTrue [] (te `true "Bool"))
    (g/KFalse [] (te `false "Bool"))
    (g/KNoneE []
              (unless (opt? want)
                (die (mut k) n "this `none` needs a known type"))
              (te `(None [~(coil-type (mut k) (opt-of want))]) want))
    (g/KSomeE []
              (let [inner
                      (expr (mut k) (kid n 0) (if (opt? want) (opt-of want) ""))]
                (te `(Some ~(.code inner)) (opt-type (.ty inner)))))
    (g/KGroup [] (expr (mut k) (kid n 0) want))
    (g/KName []
             (match (find-local (mut k) (.text n))
               (Some [l] (te (sym (.sym l)) (.ty l)))
               (None []
                     (let [m (self-mod (mut k))]
                       (match (find-global m (.text n))
                         (Some [x] (te (global-read (mut k) x) (.ty x)))
                         (None []
                               (match (find-func m (.text n))
                                 (Some [f]
                                       (te (fn-value (mut k)
                                                     `(fnptr-of ~(sym (.coil f)))
                                                     f)
                                           (func-type f)))
                                 (None []
                                       (die (mut k)
                                            n
                                            (cat "nothing named " (.text n)))))))))))
    (g/KQvar [] (die (mut k) n "a `?name` only binds in a loop's query"))
    (g/KUpper [] (enum-value (mut k) n (.text n) want))
    (g/KMember []
               (let [base (kid n 0)
                     name (.text (kid n 1))]
                 (match (module-prefix (mut k) base)
                   (None [] (die (mut k) n "expected module.Name"))
                   (Some [module]
                         (match (find-enum-of (mod-at (mut k) module) name)
                           (None []
                                 (die (mut k)
                                      n
                                      (cat4 module
                                            " has no value named "
                                            name
                                            "")))
                           (Some [e]
                                 (te `(~(sym (qualified (mut k) module name)))
                                     (cat3 module "." (.name e)))))))))
    (g/KFieldE []
               (let [base (kid n 0)
                     field (.text (kid n 1))]
                 (match (module-prefix (mut k) base)
                   (Some [module]
                         (let [mo (mod-at (mut k) module)]
                           (match (find-global mo field)
                             (Some [x]
                                   (if (= (.attr x) 5)
                                       (te (input-read (mut k)
                                                       module
                                                       x
                                                       (storage-of (mut k)
                                                                   module
                                                                   x))
                                           (.ty x))
                                       (place (mut k) n)))
                             (None []
                                   (match (find-func mo field)
                                     (Some [f]
                                           (te (fn-value (mut k)
                                                         `(fnptr-of ~(sym (qualified (mut k)
                                                                                     module
                                                                                     (.coil f))))
                                                         f)
                                               (func-type f)))
                                     (None []
                                           (die (mut k)
                                                n
                                                (cat4 module
                                                      " has nothing named "
                                                      field
                                                      ""))))))))
                   (None []
                         (let [b (expr (mut k) base "")]
                           (if (and (= field "out") (out-bound? (mut k) base))
                               (te (out-of (mut k) n base) (.ty b))
                               (if (named-child? (mut k) (.ty b) field)
                                   (te (child-code (mut k)
                                                   (.ty b)
                                                   field
                                                   (.code b))
                                       (.ty b))
                                   (te `(~(primitive/code-symbol "." field) ~(.code b))
                                       (field-type (mut k) n (.ty b) field)))))))))
    (g/KCall [] (call-expr (mut k) n want))
    (g/KCtor [] (ctor (mut k) n (.text (kid n 0)) (list-kids (kid n 1))))
    (g/KIndex []
              (let [b (expr (mut k) (kid n 0) "")
                    t (.ty b)]
                (cond (list? t)
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) "Int")
                                        "Int")]
                          (te `(get ~(.code b) ~(.code i)) (elem-of t)))
                      (map? t)
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) (map-key t))
                                        (map-key t))]
                          (te `(get ~(.code b) ~(.code i))
                              (opt-type (map-val t))))
                      (= t "Text")
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) "Int")
                                        "Int")]
                          (te `(cast i64 (get ~(.code b) ~(.code i))) "Int"))
                      :else (die (mut k) n (cat "cannot index " t)))))
    (g/KSlice []
              (let [b (expr (mut k) (kid n 0) "")
                    lo
                      (expect (mut k)
                              (kid n 1)
                              (expr (mut k) (kid n 1) "Int")
                              "Int")
                    hi
                      (expect (mut k)
                              (kid n 2)
                              (expr (mut k) (kid n 2) "Int")
                              "Int")]
                (cond (= (.ty b) "Text")
                        (te `(subslice ~(.code b) ~(.code lo) ~(.code hi))
                            "Text")
                      (list? (.ty b))
                        (let [o (fresh (mut k) "out")
                              s (fresh (mut k) "src")
                              start (fresh (mut k) "start")
                              stop (fresh (mut k) "stop")
                              i (fresh (mut k) "i")]
                          (te `(let [~(sym s) ~(.code b)
                                     ~(sym start) ~(.code lo)
                                     ~(sym stop) ~(.code hi)
                                     (mut ~(sym o))
                                       ~(new-list (mut k) (elem-of (.ty b)))]
                                 (reserve! (mut ~(sym o)) (if (> ~(sym stop) ~(sym start)) (- ~(sym stop) ~(sym start)) 0))
                                 (for ~(sym i) (range ~(sym start) ~(sym stop))
                                   (push! (mut ~(sym o))
                                          (get ~(sym s) ~(sym i))))
                                 ~(sym o))
                              (.ty b)))
                      :else (die (mut k) n (cat "cannot slice " (.ty b))))))
    (g/KListLit []
                (let [args (list-kids (kid n 0))
                      elem
                        (cond (list? want) (elem-of want)
                              (> (len args) 0)
                                (.ty (first-elem-type (mut k) (get args 0)))
                              :else
                                (die (mut k) n "this `[]` needs a known type"))
                      o (fresh (mut k) "out")
                      (mut pushes) (primitive/code-list-new)]
                  (for a args
                    (if (spread-arg? a)
                        (let [xs (spread-list (mut k) a (cat3 "[" elem "]"))
                              each (fresh (mut k) "each")]
                          (push! (mut pushes)
                                 `(for (ref ~(sym each)) ~xs
                                    (push! (mut ~(sym o)) ~(sym each)))))
                        (let [x (expect (mut k) a (expr (mut k) a elem) elem)]
                          (push! (mut pushes)
                                 `(push! (mut ~(sym o)) ~(.code x))))))
                  (te `(let [(mut ~(sym o)) ~(new-list (mut k) elem)]
                         (reserve! (mut ~(sym o)) ~(let [(mut count) 0]
                                                    (for a args (unless (spread-arg? a) (set! count (+ count 1))))
                                                    count))
                         ~@pushes
                         ~(sym o))
                      (cat3 "[" elem "]"))))
    (g/KComp [] (comprehension (mut k) n want false))
    (g/KCompSpread [] (comprehension (mut k) n want true))
    (g/KMapComp [] (map-comprehension (mut k) n want))
    (g/KMapLit [] (map-literal (mut k) n want))
    (g/KFold [] (fold-expr (mut k) n want false))
    (g/KScan [] (fold-expr (mut k) n want true))
    (g/KSum []
            (let [_ (bounded! (mut k) (kid n 0))
                  mark (locals-mark (mut k))
                  opened (quant-open! (mut k) n)
                  c
                    (expect (mut k)
                            (kid n 2)
                            (expr (mut k) (kid n 2) "Int")
                            "Int")
                  total (fresh (mut k) "n")
                  code
                    (quant-wrap (mut k)
                                n
                                opened
                                `(set! ~(sym total) (+ ~(sym total) ~(.code c))))]
              (locals-reset! (mut k) mark)
              (te `(let [(mut ~(sym total)) 0] ~code ~(sym total)) "Int")))
    (g/KAll [] (loop-all (mut k) n false))
    (g/KAny [] (loop-all (mut k) n true))
    (g/KCount []
              (let [_ (bounded! (mut k) (kid n 0))
                    mark (locals-mark (mut k))
                    opened (quant-open! (mut k) n)
                    c
                      (expect (mut k)
                              (kid n 2)
                              (expr (mut k) (kid n 2) "Bool")
                              "Bool")
                    total (fresh (mut k) "n")
                    code
                      (quant-wrap (mut k)
                                  n
                                  opened
                                  `(when ~(.code c)
                                     (set! ~(sym total) (+ ~(sym total) 1))))]
                (locals-reset! (mut k) mark)
                (te `(let [(mut ~(sym total)) 0] ~code ~(sym total)) "Int")))
    ;; The first some(…), or with a value that is no option, the first value the clauses let by.
    ;; Over `n..`, which has no end, it finds an answer or runs forever: it is the answer itself.
    (g/KFirst []
              (let [endless (= (.kind (kid n 0)) (g/KFromHead))
                    mark (locals-mark (mut k))
                    opened (quant-open! (mut k) n)
                    v
                      (expr (mut k)
                            (kid n 2)
                            (if (and endless (> (len want) 0) (not (opt? want)))
                                (opt-type want)
                                want))
                    label (primitive/code-symbol ":" (fresh (mut k) "q"))
                    x (fresh (mut k) "x")
                    optional (opt? (.ty v))
                    inner
                      (cond (not optional)
                              `(return-from ~label
                                            ~(if endless
                                                 (.code v)
                                                 `(Some ~(.code v))))
                            :else
                              `(match ~(.code v)
                                 (Some [~(sym x)]
                                       (return-from ~label
                                                    ~(if endless
                                                         (sym x)
                                                         `(Some ~(sym x)))))
                                 (None [] 0)))
                    found (if optional (opt-of (.ty v)) (.ty v))]
                (let [code (quant-wrap (mut k) n opened inner)]
                  (locals-reset! (mut k) mark)
                  (if endless
                      (te `(block
                             ~label
                             ~code
                             (panic "a range with no end came to an end"))
                          found)
                      (te `(block
                             ~label
                             ~code
                             (None [~(coil-type (mut k) found)]))
                          (opt-type found))))))
    ;; The last some(…), or value, every item looked at.
    (g/KLast []
             (let [_ (bounded! (mut k) (kid n 0))
                   mark (locals-mark (mut k))
                   opened (quant-open! (mut k) n)
                   v (expr (mut k) (kid n 2) want)
                   o (fresh (mut k) "found")
                   x (fresh (mut k) "x")
                   optional (opt? (.ty v))
                   found (if optional (opt-of (.ty v)) (.ty v))]
               (let [code
                       (quant-wrap (mut k)
                                   n
                                   opened
                                   (if optional
                                       `(match ~(.code v)
                                          (Some [~(sym x)]
                                                (do
                                                  (set! ~(sym o)
                                                        (Some ~(sym x)))
                                                  0))
                                          (None [] 0))
                                       `(set! ~(sym o) (Some ~(.code v)))))]
                 (locals-reset! (mut k) mark)
                 (te `(let [(mut ~(sym o)) (None [~(coil-type (mut k) found)])]
                        ~code
                        ~(sym o))
                     (opt-type found)))))
    (g/KSort []
             (let [mark (locals-mark (mut k))
                   items (expr (mut k) (kid n 1) "")
                   _
                     (unless (list? (.ty items))
                       (die (mut k) n "sort needs a list"))
                   v
                     (bind-local! (mut k)
                                  (.text (kid n 0))
                                  (elem-of (.ty items))
                                  false)
                   key (expr (mut k) (kid n 2) "")
                   all (fresh (mut k) "items")
                   keys (fresh (mut k) "keys")
                   o (fresh (mut k) "out")
                   i (fresh (mut k) "i")
                   desc (if (none? (kid n 3)) `false `true)
                   order
                     (if (= (.ty key) "Text")
                         `(rt/sort-order-text ~(sym keys) ~desc)
                         `(rt/sort-order-int ~(sym keys) ~desc))]
               (unless (or (= (.ty key) "Int") (= (.ty key) "Text"))
                 (die (mut k)
                      n
                      (cat "sort keys are Int or Text, not " (.ty key))))
               (locals-reset! (mut k) mark)
               (te `(let [~(sym all) ~(.code items)
                          (mut ~(sym keys)) ~(new-list (mut k) (.ty key))
                          (mut ~(sym o))
                            ~(new-list (mut k) (elem-of (.ty items)))]
                      (for (ref ~(sym v)) ~(sym all)
                        (push! (mut ~(sym keys)) ~(.code key)))
                      (for ~(sym i) ~order
                        (push! (mut ~(sym o)) (get ~(sym all) ~(sym i))))
                      ~(sym o))
                   (.ty items))))
    (g/KIf [] (if-code (mut k) n want))
    (g/KIfLet [] (if-let-code (mut k) n want))
    (g/KMatch [] (match-code (mut k) n (kid n 0) (list-kids (kid n 1)) want))
    (g/KMatchN [] (match-n-code (mut k) n want))
    (g/KWhereE [] (where-code (mut k) n want))
    (g/KWithCtx [] (stmt (mut k) n want))
    (g/KBlock []
              (let [stmts (list-kids (kid n 0))]
                (if (and (= (len stmts) 0) (map? want))
                    (te (new-map (mut k) want) want)
                    (let [mark (locals-mark (mut k))
                          r (block-from (mut k) stmts 0 want)]
                      (locals-reset! (mut k) mark)
                      r))))
    (g/KTmpl [] (template (mut k) n))
    (g/KNot []
            (let [x
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Bool")
                            "Bool")]
              (te `(not ~(.code x)) "Bool")))
    (g/KNeg []
            (let [x
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Int")
                            "Int")]
              (te `(- 0 ~(.code x)) "Int")))
    (g/KOr []
           (let [a
                   (expect (mut k)
                           (kid n 0)
                           (expr (mut k) (kid n 0) "Bool")
                           "Bool")
                 b
                   (expect (mut k)
                           (kid n 1)
                           (expr (mut k) (kid n 1) "Bool")
                           "Bool")]
             (te `(or ~(.code a) ~(.code b)) "Bool")))
    (g/KAnd [] (and-code (mut k) n))
    (g/KEq [] (equality (mut k) n false))
    (g/KNe [] (equality (mut k) n true))
    (g/KLt [] (compare (mut k) n `<))
    (g/KLe [] (compare (mut k) n `<=))
    (g/KGt [] (compare (mut k) n `>))
    (g/KGe [] (compare (mut k) n `>=))
    (g/KIn [] (in-test (mut k) n))
    (g/KAdd [] (binary-int (mut k) n `+))
    (g/KSub [] (binary-int (mut k) n `-))
    (g/KMul [] (binary-int (mut k) n `*))
    (g/KDiv [] (binary-int (mut k) n `/))
    (g/KMod [] (binary-int (mut k) n `%))
    (g/KConcat []
               (let [first-ty (.ty (expr (mut k) (kid n 0) want))]
                 (if (map? first-ty)
                     (let [o (fresh (mut k) "out")]
                       (te `(let [(mut ~(sym o)) ~(new-map (mut k) first-ty)]
                              ~(map-extend-code (mut k) n (sym o) first-ty)
                              ~(sym o))
                           first-ty))
                     (if (and (list? first-ty) (one-buffer? n))
                         ;; Several lists, or one being made: each goes straight into one list, with no list
                         ;; for a part, nor for the parts so far, copied into the next.
                         (let [o (fresh (mut k) "out")]
                           (te `(let [(mut ~(sym o))
                                        ~(new-list (mut k) (elem-of first-ty))]
                                  ~(extend-code (mut k) n (sym o) first-ty)
                                  ~(sym o))
                               first-ty))
                         (if (list? first-ty)
                             (let [a (expr (mut k) (kid n 0) want)
                                   b
                                     (expect (mut k)
                                             (kid n 1)
                                             (expr (mut k) (kid n 1) first-ty)
                                             first-ty)
                                   o (fresh (mut k) "out")
                                   e (fresh (mut k) "e")
                                   x (fresh (mut k) "left")
                                   y (fresh (mut k) "right")]
                               (te `(let [~(sym x) ~(.code a)
                                          ~(sym y) ~(.code b)
                                          (mut ~(sym o))
                                            ~(new-list (mut k)
                                                       (elem-of first-ty))]
                                      (reserve! (mut ~(sym o))
                                                (+ (len ~(sym x))
                                                   (len ~(sym y))))
                                      (for (ref ~(sym e)) ~(sym x)
                                        (push! (mut ~(sym o)) ~(sym e)))
                                      (for (ref ~(sym e)) ~(sym y)
                                        (push! (mut ~(sym o)) ~(sym e)))
                                      ~(sym o))
                                   first-ty))
                             ;; The operands, in order, then one buffer of their whole length: no growing.
                             (let [(mut parts)
                                     (ArrayList::new [g/Node]
                                                     (malloc-allocator))
                                   b (fresh (mut k) "b")
                                   (mut binds) (primitive/code-list-new)
                                   (mut lens) (primitive/code-list-new)
                                   (mut pushes) (primitive/code-list-new)]
                               (concat-operands! n (mut parts))
                               (for p parts
                                 (let [x
                                         (expect (mut k)
                                                 p
                                                 (expr (mut k) p "Text")
                                                 "Text")
                                       v (fresh (mut k) "part")]
                                   (push! (mut binds) (sym v))
                                   (push! (mut binds) (.code x))
                                   (push! (mut lens) `(len ~(sym v)))
                                   (push! (mut pushes)
                                          `(push-str! (mut ~(sym b)) ~(sym v)))))
                               (te `(let [~@binds (mut ~(sym b))
                                          (str/StrBuf::new (rt/value-allocator))]
                                      (reserve! (mut (.bytes ~(sym b)))
                                                (+ ~@lens 0))
                                      ~@pushes
                                      (finish! (mut ~(sym b))))
                                   "Text")))))))
    (g/KDefault []
                (let [a
                        (expr (mut k)
                              (kid n 0)
                              (if (> (len want) 0)
                                  (if (opt? want) want (opt-type want))
                                  ""))]
                  (unless (opt? (.ty a))
                    (die (mut k)
                         n
                         (cat "`??` needs an option on its left, but this is "
                              (.ty a))))
                  (let [x (fresh (mut k) "x")
                        b
                          (expr (mut k)
                                (kid n 1)
                                (if (> (len want) 0) want (opt-of (.ty a))))]
                    (cond (= (.ty b) (.ty a))
                            (te `(match ~(.code a)
                                   (Some [~(sym x)] (Some ~(sym x)))
                                   (None [] ~(.code b)))
                                (.ty a))
                          (or (= (.ty b) (opt-of (.ty a))) (= (.ty b) "Never"))
                            (te `(match ~(.code a)
                                   (Some [~(sym x)] ~(sym x))
                                   (None [] ~(.code b)))
                                (opt-of (.ty a)))
                          :else
                            (die (mut k)
                                 n
                                 (cat4 "`??` has " (.ty a) " and " (.ty b)))))))
    (g/KIsE []
            (let [s (expr (mut k) (kid n 0) "")
                  t (fresh (mut k) "m")]
              (te `(let [~(sym t) ~(.code s)]
                     ~(pat-test (mut k) (kid n 1) (sym t) (.ty s)))
                  "Bool")))
    (g/KWithE []
              (match (kids-mapped (mut k) n)
                (Some [shared] shared)
                (None [] (with-fields (mut k) n want))))
    (g/KPanic []
              (let [(mut args) (primitive/code-list-new)]
                (for a (list-kids (kid n 1))
                  (push! (mut args) (.code (expr (mut k) a ""))))
                (te `(panic ~(str-literal (kid n 0)) ~@args) "Never")))
    (g/KReturn []
               (when (> (.in-with k) 0)
                 (die (mut k)
                      n
                      "cannot return from inside `with`: its context would not be restored"))
               (set! (.returned k) true)
               (let [adopts (return-adopts (mut k))
                     adopting (any-escaped? (mut k))]
                 (if (none? (kid n 0))
                     (te `(do ~@adopts (return-from :fn 0)) "Never")
                     (let [v
                             (expect (mut k)
                                     (kid n 0)
                                     (expr (mut k) (kid n 0) (.ret k))
                                     (.ret k))]
                       (if (not adopting)
                           (te `(return-from :fn ~(.code v)) "Never")
                           (te `(let [returned ~(.code v)] ~@adopts (return-from :fn returned)) "Never"))))))
    (_ (die (mut k)
            n
            (cat "this is not an expression: " (g/kind-name (.kind n)))))))

;;; `n with { … }`: a copy of `n` with the given fields.
(defn with-fields [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [base (expr (mut k) (kid n 0) want)
        t (fresh (mut k) "w")
        (mut sets) (primitive/code-list-new)]
    (for f (list-kids (kid n 1))
      (let [name (.text (kid f 0))
            ft (field-type (mut k) f (.ty base) name)
            v (expect (mut k) (kid f 1) (expr (mut k) (kid f 1) ft) ft)]
        (if (named-child? (mut k) (.ty base) name)
            (let [gr (mod-at (mut k) (type-module (.ty base)))]
              (push! (mut sets)
                     `(set! (.kids ~(sym t))
                            (~(primitive/code-symbol (alias-of (.name gr))
                                                     "/kids-with") (.kids ~(sym t))
                               ~(child-index-code (mut k) gr name (sym t))
                               ~(.code v)))))
            (push! (mut sets)
                   `(set! (~(primitive/code-symbol "." name) ~(sym t))
                          ~(.code v))))))
    (te `(let [(mut ~(sym t)) ~(record-copy (mut k) (.ty base) (.code base))] ~@sets ~(sym t)) (.ty base))))

;;; Whether `e` is `name.field`.
(defn field-of? [(e g/Node) (name (slice u8)) (field (slice u8))] (-> bool)
  (and (= (.kind e) (g/KFieldE))
       (= (.kind (kid e 0)) (g/KName))
       (= (.text (kid e 0)) name)
       (= (.text (kid e 1)) field)))

;;; `n with { kids: [f(c) for c in n.kids if p(c)] }` on a node. Nodes are values that never change,
;;; so when every child is kept and each `f(c)` is `c`, the result is `n` itself: an unchanged tree is
;;; shared, not copied. A new list starts at the first child that changes or is left out.
(defn kids-mapped [(k (mut Comp)) (n g/Node)] (-> (Option TE))
  (let [base-n (kid n 0)
        fields (list-kids (kid n 1))]
    (if (not (and (= (.kind base-n) (g/KName))
                  (= (len fields) 1)
                  (= (.text (kid (get fields 0) 0)) "kids")
                  (= (.kind (kid (get fields 0) 1)) (g/KComp))))
        (None [TE])
        (let [comp (kid (get fields 0) 1)
              heads (list-kids (kid comp 1))]
          (if (not (and (or (= (len heads) 1)
                            (and (= (len heads) 2)
                                 (= (.kind (get heads 1)) (g/KIfClause))))
                        (= (.kind (get heads 0)) (g/KInHead))
                        (field-of? (kid (get heads 0) 1) (.text base-n) "kids")))
              (None [TE])
              (match (find-local (mut k) (.text base-n))
                (None [] (None [TE]))
                (Some [l]
                      (let [ty (.ty l)]
                        (if (not (and (not (builtin-type? ty))
                                      (> (last-dot ty) 0)
                                      (= (type-name ty) "Node")))
                            (None [TE])
                            (Some (shared-kids-code (mut k)
                                                    comp
                                                    (get heads 0)
                                                    (sym (.sym l))
                                                    ty)))))))))))

(defn shared-kids-code [(k (mut Comp))
                        (comp g/Node)
                        (head g/Node)
                        (base Code)
                        (ty (slice u8))] (-> TE)
  (let [gr (grammar-of-type (mut k) comp ty)
        same (primitive/code-symbol (alias-of (.name gr)) "/same-node?")
        mark (locals-mark (mut k))
        v (bind-local! (mut k) (.text (kid head 0)) ty false)
        value (expect (mut k) (kid comp 0) (expr (mut k) (kid comp 0) ty) ty)
        clauses (list-kids (kid comp 1))
        keep
          (if (= (len clauses) 1)
              `true
              (let [filter (kid (get clauses 1) 0)]
                (.code (expect (mut k)
                               filter
                               (expr (mut k) filter "Bool")
                               "Bool"))))
        w (fresh (mut k) "w")
        src (fresh (mut k) "src")
        o (fresh (mut k) "out")
        changed (fresh (mut k) "changed")
        i (fresh (mut k) "i")
        j (fresh (mut k) "j")
        r (fresh (mut k) "r")
        start
          `(do
             (set! ~(sym changed) true)
             (set! ~(sym o) ~(new-list (mut k) ty))
             (reserve! (mut ~(sym o)) (len ~(sym src)))
             (for ~(sym j) (range 0 ~(sym i))
               (push! (mut ~(sym o)) (get ~(sym src) ~(sym j)))))]
    (locals-reset! (mut k) mark)
    ;; `out` starts as the old list only to have a value: nothing is pushed before a change
    ;; replaces it with a new one.
    (te `(let [~(sym w) ~base
               ~(sym src) (.kids ~(sym w))
               (mut ~(sym o)) ~(sym src)
               (mut ~(sym changed)) false]
           (for ~(sym i) (range 0 (len ~(sym src)))
             (let [~(sym v) (get ~(sym src) ~(sym i))]
               (if ~keep
                   (let [~(sym r) ~(.code value)]
                     (when (and (not ~(sym changed))
                                (not (~same ~(sym r) ~(sym v))))
                       ~start)
                     (when ~(sym changed) (push! (mut ~(sym o)) ~(sym r))))
                   (unless ~(sym changed) ~start))))
           (if ~(sym changed)
               (let [(mut ~(sym w)) ~(sym w)]
                 (set! (.kids ~(sym w)) ~(sym o))
                 ~(sym w))
               ~(sym w)))
        ty)))

(defn first-elem-type [(k (mut Comp)) (a g/Node)] (-> TE)
  (expr (mut k) a ""))

(defn func-type [(f Func)] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))
        (mut first) true]
    (push-str! (mut b) "Fn(")
    (for p (.params f)
      (unless first (push-str! (mut b) ","))
      (set! first false)
      (push-str! (mut b) (.ty p)))
    (push-str! (mut b) ")->")
    (push-str! (mut b) (.ret f))
    (finish! (mut b))))

;;; A bare capitalised name: a value of the enum that's wanted, or of this module's.
(defn enum-value [(k (mut Comp)) (n g/Node) (name (slice u8)) (want (slice u8))]
  (-> TE)
  (let [from-want
          (if (and (> (len want) 0)
                   (not (builtin-type? want))
                   (> (last-dot want) 0)
                   (not (list? want))
                   (not (map? want))
                   (not (opt? want))
                   (not (fn? want)))
              (match (find-enum-named (mod-at (mut k) (type-module want))
                                      (type-name want))
                (Some [e]
                      (let [(mut hit) false]
                        (for v (.variants e) (when (= v name) (set! hit true)))
                        hit))
                (None [] false))
              false)]
    (if from-want
        (te `(~(sym (qualified (mut k) (type-module want) name))) want)
        (match (find-enum-of (self-mod (mut k)) name)
          (Some [e] (te `(~(sym name)) (cat3 (.self k) "." (.name e))))
          (None [] (die (mut k) n (cat "nothing named " name)))))))

;; ---------------------------------------------------------------- statements

;;; A list or a map of its own, for a `var` or an accumulator that will change in place.
(defn list-copy [(k (mut Comp)) (e TE)] (-> Code)
  (if (map? (.ty e))
      (let [o (fresh (mut k) "out")]
        `(let [(mut ~(sym o)) ~(new-map (mut k) (.ty e))]
           ~(map-copy-into (mut k) (.code e) (sym o))
           ~(sym o)))
      (if (list? (.ty e))
          (let [o (fresh (mut k) "out")
                x (fresh (mut k) "x")]
            `(let [(mut ~(sym o)) ~(new-list (mut k) (elem-of (.ty e)))]
               (for (ref ~(sym x)) ~(.code e) (push! (mut ~(sym o)) ~(sym x)))
               ~(sym o)))
          (.code e))))

(defn stmt [(k (mut Comp)) (s g/Node) (want (slice u8))] (-> TE)
  (match (.kind s)
    (g/KFor []
            (let [_ (bounded! (mut k) (kid s 0))
                  scoped (scoped-loop? (mut k) (kid s 1))
                  it (loop-open! (mut k) scoped)
                  mark (locals-mark (mut k))
                  h (head-open! (mut k) (kid s 0))
                  body (expr (mut k) (kid s 1) "Void")
                  code (head-wrap (mut k) h (loop-turn it (.code body)))]
              (locals-reset! (mut k) mark)
              (loop-close! (mut k) it)
              (te (loop-around it code) "Void")))
    (g/KWhile []
              (let [scoped (scoped-loop? (mut k) (kid s 1))
                    c
                      (expect (mut k)
                              (kid s 0)
                              (expr (mut k) (kid s 0) "Bool")
                              "Bool")
                    it (loop-open! (mut k) scoped)
                    body (expr (mut k) (kid s 1) "Void")]
                (loop-close! (mut k) it)
                (te (loop-around it `(while ~(.code c) ~(loop-turn it (.code body)))) "Void")))
    (g/KAssert []
               (let [call-node (kid s 0)]
                 (unless (and (= (.kind call-node) (g/KCall))
                              (= (.kind (kid call-node 0)) (g/KFieldE)))
                   (die (mut k) s "assert takes db.relation(columns)"))
                 (let [db (place (mut k) (kid (kid call-node 0) 0))
                       rel (.text (kid (kid call-node 0) 1))
                       args (list-kids (kid call-node 1))
                       (mut cs) (primitive/code-list-new)]
                   (rel-check (mut k) s (.ty db) rel (len args))
                   (for a args
                     (push! (mut cs)
                            (.code (expect (mut k)
                                           a
                                           (expr (mut k) a "Int")
                                           "Int"))))
                   (te `(~(sym (qualified (mut k)
                                          (type-module (.ty db))
                                          (cat3 "add-" rel "!"))) (mut ~(.code db))
                           ~@cs)
                       "Void"))))
    (g/KWithCtx []
                (let [inits (list-kids (kid s 0))
                      (mut saves) (primitive/code-list-new)
                      (mut sets) (primitive/code-list-new)
                      (mut restores) (primitive/code-list-new)
                      ;; A setting given while this thread does one of several jobs at once is
                      ;; given to the job alone (see `settings-own-enter!`).
                      (mut enters) (primitive/code-list-new)
                      (mut leaves) (primitive/code-list-new)
                      m (self-mod (mut k))]
                  (for init inits
                    (let [qname (.text (kid init 0))
                          dot (last-dot qname)
                          module
                            (if (> dot 0)
                                (match (alias-target m (subslice qname 0 dot))
                                  (Some [mo] mo)
                                  (None []
                                        (die (mut k)
                                             init
                                             (cat "no module named "
                                                  (subslice qname 0 dot)))))
                                (.self k))
                          name
                            (if (> dot 0)
                                (subslice qname (+ dot 1) (len qname))
                                qname)
                          owner (mod-at (mut k) module)]
                      (match (find-global owner name)
                        (None []
                              (die (mut k)
                                   init
                                   (cat "no context or input named " qname)))
                        (Some [x]
                              (unless (or (= (.attr x) 5)
                                          (and (<= dot 0)
                                               (.task x)
                                               (= (.attr x) 0)))
                                (die (mut k)
                                     init
                                     (cat3 "only a context or a module's input is given by `with`, and "
                                           qname
                                           " is neither")))
                              (let [saved (fresh (mut k) "saved")
                                    storage
                                      (if (> dot 0)
                                          (storage-of (mut k) module x)
                                          (storage-call (mut k) x))
                                    field
                                      `(~(primitive/code-symbol "." name) ~storage)
                                    v
                                      (expect (mut k)
                                              (kid init 1)
                                              (expr (mut k)
                                                    (kid init 1)
                                                    (.ty x))
                                              (.ty x))
                                    ;; Memo answers made from the value it had are dead, now and after.
                                    bound-now
                                      `(~(primitive/code-symbol "."
                                                                (bound-field name)) ~storage)
                                    held
                                      `(~(primitive/code-symbol "."
                                                                (held-field name)) ~storage)
                                    ;; After the binding counts itself, it had one before if more than one, or
                                    ;; holds what the last binding gave it.
                                    changed-in
                                      (setting-changed-code (mut k)
                                                            module
                                                            name
                                                            (.ty x)
                                                            (sym saved)
                                                            field
                                                            `(or (> ~bound-now
                                                                    1)
                                                                 (> ~held 0)))
                                    ;; Before it uncounts itself, the value it goes back to was given if more than one.
                                    changed-out
                                      (setting-changed-code (mut k)
                                                            module
                                                            name
                                                            (.ty x)
                                                            field
                                                            (sym saved)
                                                            `(> ~bound-now 1))]
                                (push! (mut saves) (sym saved))
                                (push! (mut saves) field)
                                (when (= (.attr x) 5)
                                  (push! (mut enters)
                                         `(~(sym (qualified (mut k) module "settings-own-enter!"))))
                                  (push! (mut leaves)
                                         `(~(sym (qualified (mut k) module "settings-own-leave!")))))
                                (if (= (.attr x) 5)
                                    (let [bound
                                            `(~(primitive/code-symbol "."
                                                                      (bound-field name)) ~storage)
                                          region-at
                                            `(~(primitive/code-symbol "."
                                                                      (region-field name)) ~storage)
                                          saved-region (fresh (mut k) "saved-region")
                                          made-in (fresh (mut k) "made-in")
                                          given (fresh (mut k) "given")]
                                      (push! (mut saves) (sym saved-region))
                                      (push! (mut saves) region-at)
                                      ;; The value made in a region of its own (while the run
                                      ;; reclaims memory), which the setting holds from now on.
                                      (push! (mut sets)
                                             `(let [~(sym made-in) (rt/answer-region-open! ~(cat "with " name))
                                                    ;; Given by a computation working apart, the
                                                    ;; setting's own: the next is compared with it.
                                                    ~(sym given) ~(lasting-code (mut k) (.ty x) (.code v))]
                                                (rt/answer-region-close! ~(sym made-in))
                                                (set! ~field ~(sym given))
                                                (set! ~region-at ~(sym made-in))))
                                      (push! (mut sets)
                                             `(set! (~(primitive/code-symbol "."
                                                                             (dirty-field name)) ~storage)
                                                    1))
                                      (push! (mut sets)
                                             `(set! ~bound (+ ~bound 1)))
                                      (push! (mut sets) changed-in)
                                      (push! (mut sets) `(set! ~held 1))
                                      ;; Back to what an outer binding gave it; or, with none, its own
                                      ;; value held for the next to be compared with (see `held-field`).
                                      (push! (mut restores)
                                             `(when (> ~bound-now 1)
                                                ~changed-out
                                                (set! ~field ~(sym saved))
                                                (set! (~(primitive/code-symbol "."
                                                                               (dirty-field name)) ~storage)
                                                      1)))
                                      ;; Back to an outer binding: its value's region held again,
                                      ;; this one's let go. Else this one's value stays, held, and
                                      ;; the one it replaced is let go.
                                      (push! (mut restores)
                                             `(if (> ~bound-now 1)
                                                  (do (rt/region-release-id! ~region-at)
                                                      (set! ~region-at ~(sym saved-region)))
                                                  (rt/region-release-id! ~(sym saved-region))))
                                      (push! (mut restores)
                                             `(set! ~bound (- ~bound 1))))
                                    (do
                                      (push! (mut sets)
                                             `(set! ~field ~(.code v)))
                                      (push! (mut restores)
                                             `(set! ~field ~(sym saved))))))))))
                  (set! (.in-with k) (+ (.in-with k) 1))
                  ;; Its value is its block's, taken before the context is put back.
                  (let [body
                          (expr (mut k)
                                (kid s 1)
                                (if (= (len want) 0) "Void" want))
                        r (fresh (mut k) "r")]
                    (set! (.in-with k) (- (.in-with k) 1))
                    (if (or (= (.ty body) "Void") (= (.ty body) "Never"))
                        (te `(do
                               ~@enters
                               (let [~@saves] ~@sets ~(.code body) ~@restores 0)
                               ~@leaves
                               0)
                            "Void")
                        (te `(do
                               ~@enters
                               (let [~@saves]
                                 ~@sets
                                 (let [~(sym r) ~(.code body)]
                                   ~@restores
                                   ~@leaves
                                   ~(sym r))))
                            (.ty body))))))
    (g/KPrint []
              (let [(mut args) (primitive/code-list-new)]
                (for a (list-kids (kid s 1))
                  (push! (mut args) (.code (expr (mut k) a ""))))
                (te `(println ~(str-literal (kid s 0)) ~@args) "Void")))
    (g/KAssign []
               (match (attr-assign (mut k) s)
                 (Some [done] done)
                 (None [] (plain-assign (mut k) s))))
    (g/KAppend []
               (match (first-collect (mut k) s)
                 (Some [done] done)
                 (None [] (plain-append (mut k) s))))
    (g/KExtend []
               (let [p (place (mut k) (kid s 0))
                     t (.ty p)]
                 (check-assignable! (mut k) (kid s 0))
                 (unless (list? t)
                   (die (mut k) s (cat "++= extends a list, not " t)))
                 (te (extend-code (mut k) (kid s 1) (.code p) t) "Void")))
    (_ (expr (mut k) s want))))

;; ---------------------------------------------------------------- loops with regions of their own

;;; A statement loop run where no memo is computing (the top of a program that watches) makes each
;;; turn's values in a region of the turn's own, let go when the next turn starts: what one build
;;; made at the top is gone by the next. What a turn keeps is copied out when it gives a `var` from
;;; before the loop a value (`escape-assign`). A loop gets one only when nothing else leaves a turn:
;;; no `return` in it, and nothing changed in place that it did not make (a list grown, an element
;;; or field set, a module's state given a value).
(defn scoped-loop? [(k (mut Comp)) (body g/Node)] (-> bool)
  (and (not (has-kind? body (g/KReturn)))
       (not (outer-change? (mut k) body))))

(defn outer-change? [(k (mut Comp)) (n g/Node)] (-> bool)
  (or (match (.kind n)
        (g/KAssign []
                   (let [target (kid n 0)]
                     (if (= (.kind target) (g/KName))
                         ;; A local from before the loop is given a copy; a module's state is kept
                         ;; as it is given; a local of the loop's own is the loop's.
                         (match (find-local (mut k) (.text target))
                           (Some [_] false)
                           (None []
                                 (match (find-global (self-mod (mut k)) (.text target))
                                   (Some [_] true)
                                   (None [] false))))
                         (outer-base? (mut k) target))))
        (g/KAppend []
                   (let [target (kid n 0)]
                     (if (= (.kind target) (g/KName))
                         (match (find-local (mut k) (.text target))
                           (Some [l] (not (scalar-type? (.ty l))))
                           (None [] (outer-base? (mut k) target)))
                         (outer-base? (mut k) target))))
        (g/KExtend [] (outer-base? (mut k) (kid n 0)))
        (_ false))
      (let [(mut hit) false]
        (for c (.kids n) (when (and (not hit) (outer-change? (mut k) c)) (set! hit true)))
        hit)))

;;; Whether a place is in something from before the loop: a local declared before it (they are all
;;; that `find-local` knows while the loop is looked at), this module's state, or another module's
;;; (`m.x`). Any other name is one the loop declares.
(defn outer-base? [(k (mut Comp)) (target g/Node)] (-> bool)
  (match (.kind target)
    (g/KName []
             (match (find-local (mut k) (.text target))
               (Some [_] true)
               (None []
                     (match (find-global (self-mod (mut k)) (.text target))
                       (Some [_] true)
                       (None [] false)))))
    (g/KFieldE []
               (match (module-prefix (mut k) (kid target 0))
                 (Some [_] true)
                 (None [] (outer-base? (mut k) (kid target 0)))))
    (g/KIndex [] (outer-base? (mut k) (kid target 0)))
    (g/KGroup [] (outer-base? (mut k) (kid target 0)))
    (_ true)))

(defn scalar-type? [(t (slice u8))] (-> bool)
  (or (= t "Int") (= t "Bool") (= t "Float") (= t "Char")))

;;; A loop being compiled: whether it has regions of its own, and its mark's name.
(defstruct LoopInfo [(scoped bool) (mark (slice u8))])

(defn loop-open! [(k (mut Comp)) (scoped bool)] (-> LoopInfo)
  (if scoped
      (let [m (fresh (mut k) "loop-mark")]
        (push! (mut (.loop-marks k)) m)
        (LoopInfo :scoped true :mark m))
      (LoopInfo :scoped false :mark "")))

(defn loop-close! [(k (mut Comp)) (it LoopInfo)] (-> void)
  (when (.scoped it) (pop! (mut (.loop-marks k))))
  0)

;;; Each turn starts by letting the last turn's region go and making its own (see `rt/iteration-begin!`).
(defn loop-turn [(it LoopInfo) (body Code)] (-> Code)
  (if (.scoped it)
      `(do (rt/iteration-begin! ~(sym (.mark it))) ~body)
      body))

(defn loop-around [(it LoopInfo) (loop Code)] (-> Code)
  (if (.scoped it)
      `(let [~(sym (.mark it)) (rt/iteration-mark)]
         ~loop
         (rt/iteration-end! ~(sym (.mark it)))
         0)
      loop))

;;; `x = v`, `x` a `var` from before a loop with a region of its own: while the loop's turns have
;;; regions, `v` is copied into a region of the var's own, which it holds until it is given another.
(defn escape-assign [(k (mut Comp)) (l Local) (v TE)] (-> Code)
  (if (or (>= (.depth l) (len (.loop-marks k))) (scalar-type? (.ty l)))
      `(set! ~(sym (.sym l)) ~(.code v))
      (let [mark (get (.loop-marks k) (.depth l))
            region (sym (cat (.sym l) "--region"))
            given (fresh (mut k) "given")
            made-in (fresh (mut k) "made-in")]
        (unless (has-text? (.escaped k) (.sym l)) (push! (mut (.escaped k)) (.sym l)))
        `(let [~(sym given) ~(.code v)]
           (if (rt/iterating-since? ~(sym mark))
               (let [~(sym made-in) (rt/answer-region-open! ~"var")
                     copied ~(own-code (mut k) (.ty l) (sym given))]
                 (rt/answer-region-close! ~(sym made-in))
                 (rt/region-release-id! ~region)
                 (set! ~region ~(sym made-in))
                 (set! ~(sym (.sym l)) copied))
               (set! ~(sym (.sym l)) ~(sym given)))
           0))))

;;; Whether a `var` in scope holds a region (see `escape-assign`).
(defn any-escaped? [(k (mut Comp))] (-> bool)
  (let [(mut hit) false]
    (for l (.locals k) (when (has-text? (.escaped k) (.sym l)) (set! hit true)))
    hit))

;;; Before a `return`: the regions of the `var`s in scope that hold one taken over by what the
;;; function returns to, since what it returns may be one of theirs.
(defn return-adopts [(k (mut Comp))] (-> CodeBuilder)
  (let [(mut out) (primitive/code-list-new)]
    (for l (.locals k)
      (when (has-text? (.escaped k) (.sym l))
        (push! (mut out) `(rt/region-adopt-id! ~(sym (cat (.sym l) "--region"))))))
    out))

;;; `xs ++= e`: a list literal's items, or a comprehension's, go straight into `xs`, with no list
;;; made for them on the way.
(defn extend-code [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (let [elem (elem-of t)]
    (match (.kind e)
      (g/KListLit []
                  (let [(mut pushes) (primitive/code-list-new)]
                    (for a (list-kids (kid e 0))
                      (if (spread-arg? a)
                          (push! (mut pushes)
                                 (if (= (.kind a) (g/KSpread))
                                     (spread-into (mut k) (kid a 0) target t)
                                     (let [each (fresh (mut k) "each")]
                                       `(for (ref ~(sym each)) ~(spread-list (mut k)
                                                                             a
                                                                             t)
                                          (push! (mut ~target) ~(sym each))))))
                          (let [x (expect (mut k) a (expr (mut k) a elem) elem)]
                            (push! (mut pushes)
                                   `(push! (mut ~target) ~(.code x))))))
                    `(do ~@pushes 0)))
      ;; `a ++ b` of lists: each in turn.
      (g/KConcat []
                 `(do
                    ~(extend-code (mut k) (kid e 0) target t)
                    ~(extend-code (mut k) (kid e 1) target t)
                    0))
      (g/KCompSpread []
                     (let [mark (locals-mark (mut k))
                           (mut opened)
                             (ArrayList::new [HeadInfo] (malloc-allocator))]
                       (for c (list-kids (kid e 1))
                         (push! (mut opened) (clause-open! (mut k) c)))
                       (let [body
                               (clauses-code (mut k)
                                             (list-kids (kid e 1))
                                             opened
                                             (spread-into (mut k)
                                                          (kid e 0)
                                                          target
                                                          t))]
                         (locals-reset! (mut k) mark)
                         `(do ~body 0))))
      ;; `if c then a else b`: whichever it is goes in.
      (g/KIf []
             (if (or (none? (kid e 2))
                     (= (.kind (kid e 1)) (g/KBlock))
                     (= (.kind (kid e 2)) (g/KBlock)))
                 (extend-whole (mut k) e target t)
                 (let [c
                         (expect (mut k)
                                 (kid e 0)
                                 (expr (mut k) (kid e 0) "Bool")
                                 "Bool")]
                   `(if ~(.code c)
                        (do ~(extend-code (mut k) (kid e 1) target t) 0)
                        (do ~(extend-code (mut k) (kid e 2) target t) 0)))))
      ;; A stage's work is made as a list of its own (see `stage-comprehension`), then goes in.
      (g/KComp []
               (if (stage-work? (mut k) e)
                   (extend-whole (mut k) e target t)
                   (let [mark (locals-mark (mut k))
                         (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
                     (for c (list-kids (kid e 1))
                       (push! (mut opened) (clause-open! (mut k) c)))
                     (let [v
                             (expect (mut k)
                                     (kid e 0)
                                     (expr (mut k) (kid e 0) elem)
                                     elem)
                           body
                             (clauses-code (mut k)
                                           (list-kids (kid e 1))
                                           opened
                                           `(push! (mut ~target) ~(.code v)))]
                       (locals-reset! (mut k) mark)
                       `(do ~body 0)))))
      (g/KCall [] (spread-into (mut k) e target t))
      ;; `e where x = …`: the equations, then `e` goes in.
      (g/KWhereE []
                 (let [mark (locals-mark (mut k))
                       lets (where-open! (mut k) e)
                       inner (extend-code (mut k) (kid e 0) target t)]
                   (locals-reset! (mut k) mark)
                   `(let [~@lets] ~inner 0)))
      (g/KGroup [] (extend-code (mut k) (kid e 0) target t))
      (_ (extend-whole (mut k) e target t)))))

(defn extend-whole [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (let [v (expect (mut k) e (expr (mut k) e t) t)
        x (fresh (mut k) "e")]
    (if (= (.ty v) "Never")
        (.code v)
        `(for (ref ~(sym x)) ~(.code v) (push! (mut ~target) ~(sym x))))))

;;; The function `g` of a call `g(…)`, when it has a twin `g-into!` that adds its answer to a list it
;;; is handed: a list-giving `everywhere fn`, or a function that gives a list partly made of its own.
(defn into-twin [(k (mut Comp)) (call g/Node)] (-> (Option Func))
  (if (and (= (.kind call) (g/KCall))
           (= (.kind (kid call 0)) (g/KName))
           (match (find-local (mut k) (.text (kid call 0)))
             (Some [_] false)
             (None [] true)))
      (match (find-func (self-mod (mut k)) (cat (.text (kid call 0)) "-into!"))
        (Some [f]
              (let [n (len (list-kids (kid call 1)))]
                (if (and (= (len (.params f)) (+ n 1))
                         (.by-ref (get (.params f) n))
                         (all-plain-args? (list-kids (kid call 1))))
                    (Some f)
                    (None [Func]))))
        (None [] (None [Func])))
      (None [Func])))

(defn all-plain-args? [(args (ArrayList g/Node))] (-> bool)
  (let [(mut ok) true]
    (for a args
      (when (or (spread-arg? a) (= (.kind a) (g/KNamed))) (set! ok false)))
    ok))

;;; A list's items into `target`: by the twin of a call that has one, else one at a time.
(defn spread-into [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (match (into-twin (mut k) e)
    (Some [f]
          (let [args (list-kids (kid e 1))
                (mut codes) (primitive/code-list-new)]
            (unless (= (.ty (get (.params f) (len args))) t)
              (die (mut k)
                   e
                   (cat4 "this adds to a "
                         t
                         ", but its function makes a "
                         (.ty (get (.params f) (len args))))))
            (for i (range 0 (len args))
              (let [p (get (.params f) i)
                    a (get args i)]
                (when (.by-ref p)
                  (die (mut k) a "a twin's arguments are values"))
                (push! (mut codes)
                       (.code (expect (mut k)
                                      a
                                      (expr (mut k) a (.ty p))
                                      (.ty p))))))
            `(~(sym (qualified (mut k) (.self k) (.coil f))) ~@codes
                (mut ~target))))
    (None []
          (let [v (expect (mut k) e (expr (mut k) e t) t)
                x (fresh (mut k) "each")]
            (if (= (.ty v) "Never")
                (.code v)
                `(for (ref ~(sym x)) ~(.code v) (push! (mut ~target) ~(sym x))))))))

;;; In an `on` block, `child.attr = value` for an inherited attribute, and `c = value` for a
;;; collected one. Anywhere else a collected attribute is only added to.
(defn attr-assign [(k (mut Comp)) (s g/Node)] (-> (Option TE))
  (let [target (kid s 0)]
    (cond (and (.in-on k) (child-equation? (mut k) s))
            (let [who (.text (kid target 0))
                  attr (.text (kid target 1))
                  (mut out) (None [TE])]
              (for e (.eq-slots k)
                (when (and (= (.target e) who) (= (.attr e) attr))
                  (let [v
                          (expect (mut k)
                                  (kid s 1)
                                  (expr (mut k) (kid s 1) (.ty e))
                                  (.ty e))]
                    (set! out
                          (Some (te `(set! ~(sym (.sym e)) ~(.code v)) "Void"))))))
              (match out
                (Some [_] out)
                (None []
                      (die (mut k)
                           s
                           "this equation is not one this block gives its children"))))
          (= (.kind target) (g/KName))
            (match (attr-global (mut k) (.text target) 3)
              (None [] (None [TE]))
              (Some [x]
                    (unless (.in-on k)
                      (die (mut k)
                           s
                           (cat3 "a collected attribute is added to with +=; only an `on` block gives "
                                 (.name x)
                                 " a node's whole value")))
                    (let [v
                            (expect (mut k)
                                    (kid s 1)
                                    (expr (mut k) (kid s 1) (.ty x))
                                    (.ty x))
                          (mut out) (None [TE])]
                      (for o (.ovr-slots k)
                        (when (= (.attr o) (.name x))
                          (set! out
                                (Some (te `(set! ~(sym (.sym o))
                                                 (Some ~(.code v)))
                                          "Void")))))
                      (match out
                        (Some [_] out)
                        (None []
                              (die (mut k)
                                   s
                                   "this collected attribute was not found among the whole values"))))))
          :else (None [TE]))))

;;; `c += x` on a collected option keeps the first some.
(defn first-collect [(k (mut Comp)) (s g/Node)] (-> (Option TE))
  (let [target (kid s 0)]
    (if (not (= (.kind target) (g/KName)))
        (None [TE])
        (match (attr-global (mut k) (.text target) 3)
          (None [] (None [TE]))
          (Some [x]
                (if (not (opt? (.ty x)))
                    (None [TE])
                    ;; `problem += p` keeps the first; with `p` an option, the first some.
                    (let [p (place (mut k) target)
                          v0 (expr (mut k) (kid s 1) (.ty x))
                          y (fresh (mut k) "y")]
                      (if (= (.ty v0) (.ty x))
                          (Some (te `(match ~(.code v0)
                                       (Some [~(sym y)]
                                             (match ~(.code p)
                                               (None []
                                                     (set! ~(.code p)
                                                           (Some ~(sym y))))
                                               (_ 0)))
                                       (None [] 0))
                                    "Void"))
                          (let [v (expect (mut k) (kid s 1) v0 (opt-of (.ty x)))]
                            (Some (te `(match ~(.code p)
                                         (None []
                                               (set! ~(.code p)
                                                     (Some ~(.code v))))
                                         (_ 0))
                                      "Void")))))))))))

(defn plain-assign [(k (mut Comp)) (s g/Node)] (-> TE)
  (let [target (kid s 0)]
    (if (and (= (.kind target) (g/KIndex))
             (let [b (place (mut k) (kid target 0))]
               (or (list? (.ty b)) (map? (.ty b)))))
        (let [b (place (mut k) (kid target 0))]
          (if (map? (.ty b))
              (let [i
                      (expect (mut k)
                              (kid target 1)
                              (expr (mut k) (kid target 1) (map-key (.ty b)))
                              (map-key (.ty b)))
                    v
                      (expect (mut k)
                              (kid s 1)
                              (expr (mut k) (kid s 1) (map-val (.ty b)))
                              (map-val (.ty b)))]
                (te `(set! (mut ~(.code b)) ~(.code i) ~(.code v)) "Void"))
              (let [i
                      (expect (mut k)
                              (kid target 1)
                              (expr (mut k) (kid target 1) "Int")
                              "Int")
                    v
                      (expect (mut k)
                              (kid s 1)
                              (expr (mut k) (kid s 1) (elem-of (.ty b)))
                              (elem-of (.ty b)))]
                (te `(set! (mut ~(.code b)) ~(.code i) ~(.code v)) "Void"))))
        (let [p (place (mut k) target)
              v
                (expect (mut k)
                        (kid s 1)
                        (expr (mut k) (kid s 1) (.ty p))
                        (.ty p))]
          (check-assignable! (mut k) target)
          (match (setting-part (mut k) target)
            ;; A setting given a new value for good, as a cell is: what memos read of the old value
            ;; that differs in the new is changed, and the setting has a value from here on.
            (Some [sp]
                  (if (> (len (.fields sp)) 0)
                      (die (mut k)
                           target
                           "a setting is given a whole new value, not part of one")
                      (let [old (fresh (mut k) "was")
                            storage
                              (if (= (.module sp) (.self k))
                                  (storage-call (mut k) (.x sp))
                                  (storage-of (mut k) (.module sp) (.x sp)))
                            bound
                              `(~(primitive/code-symbol "."
                                                        (bound-field (.name (.x sp)))) ~storage)
                            held
                              `(~(primitive/code-symbol "."
                                                        (held-field (.name (.x sp)))) ~storage)]
                        (te `(let [~(sym old) ~(.code p)
                                   given (or (> ~bound 0) (> ~held 0))
                                   ;; Made in a region of its own, which the setting holds from
                                   ;; now on in place of the one it held.
                                   made-in (rt/answer-region-open! ~(cat "set " (.name (.x sp))))
                                   value ~(lasting-code (mut k) (.ty (.x sp)) (.code v))
                                   closed (rt/answer-region-close! made-in)]
                               (set! ~(.code p) value)
                               (rt/region-release-id! (~(primitive/code-symbol "."
                                                                                (region-field (.name (.x sp)))) ~storage))
                               (set! (~(primitive/code-symbol "."
                                                              (region-field (.name (.x sp)))) ~storage)
                                     made-in)
                               (set! (~(primitive/code-symbol "."
                                                              (dirty-field (.name (.x sp)))) ~storage)
                                     1)
                               (when (= ~bound 0) (set! ~bound 1))
                               (set! ~held 1)
                               ~(setting-changed-code (mut k)
                                                      (.module sp)
                                                      (.name (.x sp))
                                                      (.ty (.x sp))
                                                      (sym old)
                                                      (.code p)
                                                      `given)
                               0)
                            "Void"))))
            (None []
                  (if (= (.kind target) (g/KName))
                      (match (find-local (mut k) (.text target))
                        (Some [l] (te (escape-assign (mut k) l v) "Void"))
                        (None [] (te `(set! ~(.code p) ~(.code v)) "Void")))
                      (te `(set! ~(.code p) ~(.code v)) "Void"))))))))

(defn plain-append [(k (mut Comp)) (s g/Node)] (-> TE)
  (let [p (place (mut k) (kid s 0))
        t (.ty p)]
    (check-assignable! (mut k) (kid s 0))
    (cond (list? t)
            (let [v
                    (expect (mut k)
                            (kid s 1)
                            (expr (mut k) (kid s 1) (elem-of t))
                            (elem-of t))]
              (te `(push! (mut ~(.code p)) ~(.code v)) "Void"))
          (= t "Int")
            (let [v
                    (expect (mut k)
                            (kid s 1)
                            (expr (mut k) (kid s 1) "Int")
                            "Int")]
              (te `(set! ~(.code p) (+ ~(.code p) ~(.code v))) "Void"))
          :else (die (mut k) s (cat "cannot add to " t)))))

;;; A plain local is assignable only when declared with `var`.
(defn check-assignable! [(k (mut Comp)) (target g/Node)] (-> void)
  (match (.kind target)
    (g/KName []
             (match (find-local (mut k) (.text target))
               (Some [l]
                     (unless (.mutable l)
                       (die (mut k)
                            target
                            (cat3 "cannot change "
                                  (.text target)
                                  ": declare it with `var`"))))
               (None [] 0)))
    (g/KFieldE [] (check-assignable! (mut k) (kid target 0)))
    (g/KIndex [] (check-assignable! (mut k) (kid target 0)))
    (_ 0)))

(defn let-like? [(s g/Node)] (-> bool)
  (or (= (.kind s) (g/KLet)) (= (.kind s) (g/KVar))))

;;; A block, kept as flat as it can be: Coil's expander pays for depth, so a run of `let`s
;;; shares one binding vector rather than each nesting the rest of the block.
(defn block-from [(k (mut Comp))
                  (stmts (ArrayList g/Node))
                  (i i64)
                  (want (slice u8))] (-> TE)
  (let [(mut forms) (primitive/code-list-new)
        (mut ty) "Void"
        (mut j) i
        n (len stmts)
        (mut go) (< j n)]
    (while go
      (let [s (get stmts j)
            at-end (= j (- n 1))]
        (if (let-like? s)
            (let [(mut binds) (primitive/code-list-new)
                  (mut var-syms) (text-list)]
              (while (and (< j n) (let-like? (get stmts j)))
                (let [b (get stmts j)
                      is-var (= (.kind b) (g/KVar))
                      declared
                        (if (none? (kid b 1))
                            ""
                            (resolve-type (mut k) (.self k) (kid b 1)))
                      v
                        (expect (mut k)
                                (kid b 2)
                                (expr (mut k) (kid b 2) declared)
                                declared)
                      fresh-value
                        (match (.kind (kid b 2))
                          (g/KName [] false)
                          (g/KFieldE [] false)
                          (g/KIndex [] false)
                          (_ true))
                      init
                        (if (or (not is-var) fresh-value)
                            (.code v)
                            (list-copy (mut k) v))
                      local
                        (bind-local! (mut k) (.text (kid b 0)) (.ty v) is-var)]
                  (if is-var
                      (do (push! (mut binds) `(mut ~(sym local)))
                          (push! (mut var-syms) local))
                      (push! (mut binds) (sym local)))
                  (push! (mut binds) init))
                (set! j (+ j 1)))
              (let [rest (block-from (mut k) stmts j want)
                    ;; A `var` given a value from inside a loop with a region of its own holds a
                    ;; region for it (see `escape-assign`); when its block ends, whatever the block
                    ;; is in takes it over, since the block's value may be the var's.
                    (mut adopts) (primitive/code-list-new)
                    (mut adopting) false]
                (for name var-syms
                  (when (has-text? (.escaped k) name)
                    (let [region (cat name "--region")]
                      (set! adopting true)
                      (push! (mut binds) `(mut ~(sym region)))
                      (push! (mut binds) `0)
                      (push! (mut adopts) `(rt/region-adopt-id! ~(sym region))))))
                (push! (mut forms)
                       (cond (not adopting) `(let [~@binds] ~(.code rest))
                             (= (.ty rest) "Never") `(let [~@binds] ~(.code rest))
                             (= (.ty rest) "Void") `(let [~@binds] ~(.code rest) ~@adopts 0)
                             :else `(let [~@binds] (let [block-value ~(.code rest)] ~@adopts block-value))))
                (set! ty (.ty rest))
                (set! go false)))
            (let [e (stmt (mut k) s (if at-end want "Void"))]
              (push! (mut forms) (.code e))
              (when at-end (set! ty (.ty e)))
              (set! j (+ j 1))
              (when (>= j n) (set! go false))))))
    (when (>= i n) (push! (mut forms) `0))
    (te `(do ~@forms) ty)))

;; ---------------------------------------------------------------- declarations

(defn reserved-name? [(s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for w ["field"
            "len"
            "get"
            "set"
            "elem"
            "for"
            "let"
            "if"
            "do"
            "block"
            "match"
            "when"
            "unless"
            "while"
            "not"
            "and"
            "or"
            "range"
            "cond"
            "push!"
            "pop!"
            "clear!"
            "reserve!"
            "set!"
            "cast"
            "load"
            "store!"
            "slice"
            "panic"
            "print"
            "println"
            "join"
            "call"
            "rules-state"
            "rules-state-first"
            "rules-init!"
            "main"
            "rules-worker"
            "mut"
            "ref"
            "fn"
            "defn"
            "const"
            "def"
            "import"
            "module"
            "export"
            "impl"
            "defstruct"
            "defsum"]
      (when (= w s) (set! hit true)))
    hit))

;;; Built with HL_AUDIT_ALL set, every plain function that could be kept (its arguments make a key,
;;; none is mut, it answers something) counts its calls by their arguments while HL_MEMO_AUDIT is
;;; set (see the memo audit in hl.rt): which functions no strategy keeps a build asks the same of
;;; again and again. Built without it, nothing changes.
(defn auditable? [(k (mut Comp)) (d g/Node)] (-> bool)
  (and (!= (primitive/cast i64 (getenv c"HL_AUDIT_ALL")) 0)
       (match (find-func (self-mod (mut k)) (.text (kid d 0)))
         (None [] false)
         (Some [f]
               (and (> (len (.params f)) 0)
                    (!= (.ret f) "Void")
                    (let [(mut ok) true]
                      (for p (.params f)
                        (when (or (.by-ref p) (not (keyable? (mut k) (.ty p))))
                          (set! ok false)))
                      ok))))))

(defn compile-audited! [(k (mut Comp)) (d g/Node) (out (mut str/StrBuf))]
  (-> void)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))
        inner (sym (cat "audited--" name))
        (mut params) (primitive/code-list-new)
        (mut args) (primitive/code-list-new)]
    (for i (range 0 (len (.params f)))
      (push! (mut params)
             `(~(memo-arg i) ~(coil-type (mut k) (.ty (get (.params f) i)))))
      (push! (mut args) (memo-arg i)))
    (emit! (mut out) (compile-fn-as (mut k) d (cat "audited--" name)))
    (emit! (mut out)
           `(defn ~(sym name) [~@params] (-> ~(coil-type (mut k) (.ret f)))
              (if (and (rt/auditing?) (not (rt/names-recording?)))
                  ;; Not the pass of a naming map that only notes names: it is run on purpose, and
                  ;; nothing kept would have answered it.
                  ;; Its own time: from its start to its end, less what the audit of the calls it
                  ;; made took; the audit's own work, before and after, added to that.
                  (let [entered (rt/now-ns)
                        key ~(memo-key-code (mut k) f)
                        text
                          ~(if (= (memo-key-type f) "Int")
                               `(rt/num-text key)
                               `key)
                        before (rt/audit-overhead-now)
                        started (rt/now-ns)
                        v (~inner ~@args)
                        ended (rt/now-ns)
                        nested (- (rt/audit-overhead-now) before)]
                    (rt/audit-call-ns! ~(cat3 (.self k) "/" name)
                                       text
                                       (- (- ended started) nested))
                    (rt/audit-overhead-add! (+ (- started entered)
                                               (- (rt/now-ns) ended)))
                    v)
                  (~inner ~@args))))
    0))

(defn compile-fn [(k (mut Comp)) (d g/Node)] (-> Code)
  (compile-fn-as (mut k) d (.text (kid d 0))))

;; ---------------------------------------------------------------- working apart

;;; A function's number among those some strategy has work apart; -1 for one none does.
(defn apart-number [(k (mut Comp)) (name (slice u8))] (-> i64)
  (let [(mut at) -1
        full (cat3 (.self k) "/" name)]
    (for i (range 0 (len (.aparts k)))
      (when (= (get (.aparts k) i) full) (set! at i)))
    at))

;;; Every function a pipeline has work apart is one of its module's.
(defn check-aparts! [(k (mut Comp)) (path (slice u8)) (decls (ArrayList g/Node))] (-> void)
  (let [prefix (cat (.self k) "/")]
    (for name (.aparts k)
      (when (rt/starts-with name prefix)
        (let [(mut found) false]
          (for d decls
            (when (and (or (= (.kind d) (g/KFn)) (= (.kind d) (g/KMemoFn)))
                       (= (.text (kid d 0)) (subslice name (len prefix) (len name))))
              (set! found true)))
          (unless found
            (dsl/fail-at path
                         1
                         1
                         (cat3 "a pipeline has "
                               name
                               (cat " work apart, which is no function of " (.self k)))))))))
  0)

;;; A function a strategy has work apart (see "working apart" in hl.rt), compiled as `coil-name`:
;;; the function as written under another name, and this one, which a run whose strategy says so
;;; has call it in storage of its own, copy the answer out to where values went before, and let
;;; the rest go. Any other run calls it as it is.
(defn compile-apart! [(k (mut Comp))
                      (d g/Node)
                      (coil-name (slice u8))
                      (number i64)
                      (out (mut str/StrBuf))] (-> void)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))
        working (cat coil-name "--working")
        (mut params) (primitive/code-list-new)
        (mut args) (primitive/code-list-new)]
    (when (= (.ret f) "Void")
      (die (mut k) d "a function that works apart answers a value: its answer is all that is kept of its work"))
    (for i (range 0 (len (.params f)))
      (when (.by-ref (get (.params f) i))
        (die (mut k) d "a function that works apart takes nothing by reference: what it changed would be let go"))
      (push! (mut params)
             `(~(memo-arg i) ~(coil-type (mut k) (.ty (get (.params f) i)))))
      (push! (mut args) (memo-arg i)))
    (emit! (mut out) (compile-fn-as (mut k) d working))
    (emit! (mut out)
           `(defn ~(sym coil-name) [~@params] (-> ~(coil-type (mut k) (.ret f)))
              (if (rt/apart? ~number)
                  (let [apart-storage (rt/apart-enter!)
                        apart-made (~(sym working) ~@args)]
                    (rt/apart-leave!)
                    ;; Asked for from inside another computation apart, one whose answers last
                    ;; (`apart lasting`) has its answer made where what lasts is made, and the
                    ;; other's copy out leaves it where it is.
                    (let [apart-outer ~(if (has-text? (.lastings k) (cat3 (.self k) "/" name))
                                           `(rt/lasting-enter!)
                                           `0)]
                      (rt/own-begin!)
                      ;; What lasts holds nothing of any storage that is let go: not this
                      ;; computation's, and not that of whoever asked (the text it was handed).
                      (let [apart-answer
                              ~(own-in-code (mut k)
                                            (.ret f)
                                            `apart-made
                                            (if (has-text? (.lastings k) (cat3 (.self k) "/" name))
                                                `(if (> apart-outer 0)
                                                     (primitive/cast (ptr rt/Region) 0)
                                                     apart-storage)
                                                `apart-storage))]
                        (rt/own-end!)
                        (rt/lasting-leave! apart-outer)
                        (rt/scratch-dispose! apart-storage)
                        apart-answer)))
                  (~(sym working) ~@args))))
    0))

;;; A value that must outlive a computation working apart: while one is open on this thread, its
;;; own copy in the thread's lasting storage; else the value itself.
(defn lasting-code [(k (mut Comp)) (t (slice u8)) (v Code)] (-> Code)
  (if (own-in-plain? t)
      v
      `(let [lasting-given ~v]
         (if (rt/apart-open?)
             (let [lasting-open (rt/lasting-enter!)
                   lasting-began (rt/own-begin!)
                   lasting-own ~(own-in-code (mut k) t `lasting-given `(rt/any-scratch))]
               (rt/own-end!)
               (rt/lasting-leave! lasting-open)
               lasting-own)
             lasting-given))))

(defn compile-fn-as [(k (mut Comp)) (d g/Node) (coil-name (slice u8))] (-> Code)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))
        (mut params) (primitive/code-list-new)
        (mut args) (primitive/code-list-new)
        body-node (kid d 3)]
    (when (reserved-name? name)
      (die (mut k) (kid d 0) (cat3 "the name " name " is reserved")))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) (.ret f))
    (for p (.params f)
      (let [local (bind-local! (mut k) (.name p) (.ty p) (.by-ref p))]
        (push! (mut args) (sym local))
        (push! (mut params)
               (if (.by-ref p)
                   `(~(sym local) (mut ~(coil-type (mut k) (.ty p))))
                   `(~(sym local) ~(coil-type (mut k) (.ty p)))))))
    (set! (.in-fn k) true)
    (set! (.task-used k) false)
    (let [body
            (expect (mut k)
                    body-node
                    (expr (mut k) body-node (.ret f))
                    (.ret f))
          inner (if (.returned k) `(block :fn ~(.code body)) (.code body))
          worked
            (if (.task-used k)
                `(let [rules-task-here (rules-task)] ~inner)
                inner)
          code
            (match (alone-answer (mut k) d f)
              (Some [alone] `(if ~(.test alone) (~(.call alone) ~@args) ~worked))
              (None [] worked))]
      (set! (.in-fn k) false)
      (when (and (!= (.ret f) "Void") (= (.ty body) "Void"))
        (die (mut k) body-node (cat "this function must answer " (.ret f))))
      `(defn ~(sym coil-name) [~@params] (-> ~(coil-type (mut k) (.ret f)))
         ~code))))

;;; A function that divides work into a stage's units, when the pipeline names another that gives
;;; the same answer undivided (`alone F is G`): the test that the stage works on one thread, and
;;; that function, which then answers for this one.
(defstruct Alone [(test Code) (call Code)])

(defn alone-answer [(k (mut Comp)) (d g/Node) (f Func)] (-> (Option Alone))
  (let [full (cat3 (.self k) "/" (.name f))
        (mut out) (None [Alone])]
    (for i (range 0 (len (.stages k)))
      (let [st (get (.stages k) i)]
        (when (= (.divided st) full)
          (let [slash (rt/name-end-at (.whole st) 47)
                wm (subslice (.whole st) 0 slash)
                wf (subslice (.whole st) (+ slash 1) (len (.whole st)))]
            (unless (= wm (.self k))
              (die (mut k)
                   d
                   (cat4 (.whole st) " answers for " full ", alone: they are functions of one module")))
            (match (find-func (self-mod (mut k)) wf)
              (None [] (die (mut k) d (cat4 (.self k) " has no function named " wf "")))
              (Some [g]
                    (unless (= (func-type g) (func-type f))
                      (die (mut k)
                           d
                           (cat4 (.whole st)
                                 " answers for "
                                 full
                                 (cat4 ", alone: it must take and give the same, " (func-type f) ", not " (func-type g)))))
                    (for p (.params f)
                      (when (.by-ref p)
                        (die (mut k) d (cat full " changes what it is given: nothing else can answer for it"))))
                    (set! out
                          (Some (Alone
                                  :test `(rt/alone? ~i)
                                  :call (sym (.coil g)))))))))))
    out))

;; ---------------------------------------------------------------- attribute grammars

;;; `.attrs`: an attribute grammar over a grammar's trees. No walk is written: attributes are
;;; declared, `on` blocks give equations for the nodes their patterns match, and the compiler
;;; makes one traversal that computes them all.
;;;
;;;   attrs bundle.calls over bundle.js
;;;   inh in-loop: Bool = false       # inherited: a child has its parent's, unless an equation
;;;                                   #   of the parent's says otherwise
;;;   given role: Role = Plain        # inherited, not copied: a child has this, unless an
;;;                                   #   equation of its parent's says otherwise
;;;   input bindings: {Int:Int}       # given to `run`, the same everywhere
;;;   collect requires: [Text]        # synthesized: what the nodes add, in tree order; an
;;;                                   #   option keeps the first some
;;;   on For(init, test, update, body) { body.in-loop = true }
;;;   on CallExpr(Ident("require"), Args(List(Str(raw)))) { requires += unquote(raw) }
;;;   on FuncDecl(...) { declares = [] }   # a node's whole value: its subtree adds nothing
;;;
;;; `run(tree, inputs...)` answers a record `Attrs` with each collected attribute at the root.
;;; A node's own additions come before its children's. Only one block may give a node's
;;; children attributes: the first, in the file, whose pattern matches it.

(defn attrs-only! [(k (mut Comp)) (tree g/Node) (d g/Node)] (-> void)
  (unless (= (.kind tree) (g/KAttrsFile))
    (die (mut k) d "attributes and `on` blocks belong in an `attrs` file")))

;;; The record of results, and `run`, as other modules see them.
(defn attrs-signature! [(k (mut Comp))
                        (ix2 i64)
                        (name (slice u8))
                        (over (slice u8))
                        (decls (ArrayList g/Node))] (-> void)
  (let [(mut fields) (ArrayList::new [FieldDef] (malloc-allocator))
        (mut f) (func-of "run" (cat name ".Attrs"))]
    (param (mut f) "tree" (cat over ".Node") false)
    (for d decls
      (when (= (.kind d) (g/KCollect))
        (let [ty (resolve-type (mut k) name (kid d 1))]
          (unless (or (list? ty) (opt? ty))
            (die (mut k)
                 d
                 (cat "a collected attribute is a list or an option, not " ty)))
          (push! (mut fields) (FieldDef :name (.text (kid d 0)) :ty ty))))
      (when (= (.kind d) (g/KInput))
        (param (mut f)
               (.text (kid d 0))
               (resolve-type (mut k) name (kid d 1))
               false))
      (when (and (= (.kind d) (g/KFn)) (= (.text (kid d 0)) "run"))
        (die (mut k) d "an attribute grammar's `run` is its own")))
    (when (rewrites? decls)
      (for f2 fields
        (when (= (.name f2) "tree")
          (die (mut k)
               (g/none-node)
               "`tree` is the rewritten tree; a collection cannot be named so")))
      (push! (mut fields) (FieldDef :name "tree" :ty (cat over ".Node"))))
    ;; An included grammar's equations run in this one's traversal, and what it collects is
    ;; this one's answer too.
    (for d decls
      (when (= (.kind d) (g/KInclude))
        (let [m (mod-at (mut k) (.text (kid d 0)))]
          (unless (= (.over m) over)
            (die (mut k)
                 d
                 (cat "an included attribute grammar is over the same grammar; this one is over "
                      (.over m))))
          (for x (.globals m)
            (when (= (.attr x) 2)
              (die (mut k)
                   d
                   (cat3 "an included attribute grammar takes no inputs, not yet: "
                         (.name x)
                         " is one")))
            (when (= (.attr x) 3)
              (for f2 fields
                (when (= (.name f2) (.name x))
                  (die (mut k)
                       d
                       (cat3 "two collected attributes are named " (.name x) ""))))
              (push! (mut fields) (FieldDef :name (.name x) :ty (.ty x))))))))
    (for i (range 0 (len (.recs (get (.mods k) ix2))))
      (when (= (.name (get (.recs (get (.mods k) ix2)) i)) "Attrs")
        (set! (.fields (elem (mut (.recs (elem (mut (.mods k)) ix2))) i))
              fields)))
    (push! (mut (.funcs (elem (mut (.mods k)) ix2))) f)))

;;; Whether a grammar rewrites trees as well as computing attributes.
;;; Whether a grammar takes inputs: they hold only while `run` runs, which `attrs-depth` counts.
(defn inputs? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KInput)) (set! hit true)))
    hit))

(defn rewrites? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KRewrite)) (set! hit true)))
    hit))

;;; The attribute grammar whose attributes a block's names mean: this module's, or while an
;;; included one's blocks are read, that one's.
(defn attrs-mod [(k (mut Comp))] (-> Mod)
  (if (= (len (.attrs-from k)) 0)
      (self-mod (mut k))
      (mod-at (mut k) (.attrs-from k))))

(defn attr-global [(k (mut Comp)) (name (slice u8)) (attr i64)]
  (-> (Option Global))
  (match (find-global (attrs-mod (mut k)) name)
    (Some [x] (if (= (.attr x) attr) (Some x) (None [Global])))
    (None [] (None [Global]))))

;;; The empty value of a type, for an input before `run` and a collection at its start.
(defn default-of [(k (mut Comp)) (at g/Node) (ty (slice u8))] (-> Code)
  (cond (list? ty) (new-list (mut k) (elem-of ty))
        (opt? ty) `(None [~(coil-type (mut k) (opt-of ty))])
        (map? ty) (new-map (mut k) ty)
        (= ty "Int") `0
        (= ty "Bool") `false
        (= ty "Text") `""
        ;; A record's is its fields' empty values, and an enum's its first value.
        (> (last-dot ty) 0)
          (let [m (mod-at (mut k) (type-module ty))]
            (match (find-rec m (type-name ty))
              (Some [r]
                    (let [(mut inits) (primitive/code-list-new)]
                      (for f (.fields r)
                        (push! (mut inits)
                               (primitive/code-symbol ":" (.name f)))
                        (push! (mut inits) (default-of (mut k) at (.ty f))))
                      (record-value (mut k) ty `(~(sym (qualified (mut k) (type-module ty) (.name r))) ~@inits))))
              (None []
                    (match (find-enum-named m (type-name ty))
                      (Some [e]
                            `(~(sym (qualified (mut k)
                                               (type-module ty)
                                               (get (.variants e) 0)))))
                      (None [] (die (mut k) at (cat "no empty value of " ty)))))))
        :else (die (mut k) at (cat "no empty value of " ty))))

;;; A global's first value: its own expression, or the empty one for an input or a collection. A
;;; setting has the value its root gives (`setting names: Names = names-new()`), as a dynamic var's
;;; root binding; one with none is never read before a `with` or an assignment gives it one, so a
;;; type with no empty value of its own, such as a foreign one, is held as zeroes until then.
(defn global-init [(k (mut Comp)) (d g/Node) (x Global)] (-> Code)
  (cond (setting-root? d)
          (.code (expect (mut k)
                         (kid d 2)
                         (expr (mut k) (kid d 2) (.ty x))
                         (.ty x)))
        (and (= (.kind d) (g/KSetting)) (not (has-default? (mut k) (.ty x))))
          `(primitive/zeroed ~(coil-type (mut k) (.ty x)))
        (or (= (.kind d) (g/KInput))
            (= (.kind d) (g/KCollect))
            (= (.kind d) (g/KSetting)))
          (default-of (mut k) d (.ty x))
        :else
          (.code (expect (mut k)
                         (kid d 2)
                         (expr (mut k) (kid d 2) (.ty x))
                         (.ty x)))))

;;; Whether a setting has a root value: one it has wherever nothing has given it another.
(defn setting-root? [(d g/Node)] (-> bool)
  (and (= (.kind d) (g/KSetting)) (> (len (.kids d)) 2) (not (none? (kid d 2)))))

;;; Whether `default-of` has an empty value for the type.
(defn has-default? [(k (mut Comp)) (ty (slice u8))] (-> bool)
  (cond (or (list? ty)
            (opt? ty)
            (map? ty)
            (= ty "Int")
            (= ty "Bool")
            (= ty "Text"))
          true
        (fn? ty) false
        (> (last-dot ty) 0)
          (let [m (mod-at (mut k) (type-module ty))]
            (match (find-rec m (type-name ty))
              (Some [r]
                    (let [(mut ok) true]
                      (for f (.fields r)
                        (unless (has-default? (mut k) (.ty f)) (set! ok false)))
                      ok))
              (None []
                    (match (find-enum-named m (type-name ty))
                      (Some [_] true)
                      (None [] false)))))
        :else false))

(defn task-field [(name (slice u8)) (task Code)] (-> Code)
  `(~(primitive/code-symbol "." name) ~task))

;;; One alternative of an `on` block: or-patterns at the top become several. `block` is which
;;; block, in the file's order.
(defstruct OnAlt
  [(pat g/Node)
   (as-name g/Node)
   (guard g/Node)
   (body g/Node)
   (owner bool)
   (block i64)])

;;; An `on` block's body, with its `where` equations first, each after those it uses.
(defn on-body-with-where [(d g/Node)] (-> g/Node)
  (let [body (kid d 2)
        w (kid d 3)]
    (if (none? w)
        body
        (let [inits (list-kids (kid w 0))
              (mut stmts) (g/new-kids)]
          (for j (where-order inits)
            (let [i (get inits j)]
              (push! (mut stmts)
                     (g/mk (g/KLet)
                           (three (kid i 0) (g/none-node) (kid i 1))
                           (.lo i)
                           (.hi i)))))
          (for s (list-kids (kid body 0)) (push! (mut stmts) s))
          (g/mk (g/KBlock)
                (one (list-node stmts (kid body 0)))
                (.lo body)
                (.hi body))))))

(defn on-alts [(k (mut Comp)) (decls (ArrayList g/Node))] (-> (ArrayList OnAlt))
  (let [(mut out) (ArrayList::new [OnAlt] (malloc-allocator))
        (mut b) 0]
    (for d decls
      (when (= (.kind d) (g/KOn))
        (let [p0 (kid d 0)
              has-as (= (.kind p0) (g/KPAs))
              as-name (if has-as (kid p0 1) (g/none-node))
              p (if has-as (kid p0 0) p0)
              body (on-body-with-where d)
              owner (gives-children? (mut k) body)
              guard (kid d 1)]
          (if (= (.kind p) (g/KPOr))
              (do
                (push! (mut out)
                       (OnAlt
                         :pat (kid p 0)
                         :as-name as-name
                         :guard guard
                         :body body
                         :owner owner
                         :block b))
                (for q (list-kids (kid p 1))
                  (push! (mut out)
                         (OnAlt
                           :pat q
                           :as-name as-name
                           :guard guard
                           :body body
                           :owner owner
                           :block b))))
              (push! (mut out)
                     (OnAlt
                       :pat p
                       :as-name as-name
                       :guard guard
                       :body body
                       :owner owner
                       :block b)))
          (set! b (+ b 1)))))
    out))

;;; A block's body, compiled once as a function of the node, the names its pattern binds and, for
;;; the children its equations give attributes, where they are; each alternative of its pattern
;;; only tests and calls. A block that gives a collected attribute a node's whole value stays
;;; inline, since what it gives waits in the traversal's frame.
(defstruct OnVar [(name (slice u8)) (ty (slice u8))])

;;; `task` is the task state its attributes live in: this module's, or an included one's.
(defstruct OnBlock
  [(body g/Node)
   (owner bool)
   (inline bool)
   (vars (ArrayList OnVar))
   (targets (ArrayList (slice u8)))
   (fname (slice u8))
   (task Code)])

(defn on-head [(a OnAlt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

;;; Is `s` an equation for a child, `x.attr = value` with `attr` inherited?
(defn child-equation? [(k (mut Comp)) (s g/Node)] (-> bool)
  (and (= (.kind s) (g/KAssign))
       (= (.kind (kid s 0)) (g/KFieldE))
       (= (.kind (kid (kid s 0) 0)) (g/KName))
       (inherited? (mut k) (.text (kid (kid s 0) 1)))))

(defn inherited? [(k (mut Comp)) (name (slice u8))] (-> bool)
  (match (find-global (attrs-mod (mut k)) name)
    (Some [x] (or (= (.attr x) 1) (= (.attr x) 4)))
    (None [] false)))

(defn gives-children? [(k (mut Comp)) (n g/Node)] (-> bool)
  (let [(mut hit) (child-equation? (mut k) n)]
    (for c (.kids n) (when (gives-children? (mut k) c) (set! hit true)))
    hit))

(defn find-eqs! [(k (mut Comp)) (n g/Node) (out (mut (ArrayList EqSlot)))]
  (-> void)
  (when (child-equation? (mut k) n)
    (let [target (.text (kid (kid n 0) 0))
          attr (.text (kid (kid n 0) 1))
          (mut seen) false]
      (for e out
        (when (and (= (.target e) target) (= (.attr e) attr)) (set! seen true)))
      (unless seen
        (match (find-global (attrs-mod (mut k)) attr)
          (Some [x]
                (push! (mut out)
                       (EqSlot
                         :target target
                         :attr attr
                         :sym (fresh (mut k) "eq")
                         :ty (.ty x))))
          (None [] 0)))))
  (for c (.kids n) (find-eqs! (mut k) c (mut out))))

;;; Collected attributes some block gives a whole value, `c = value`.
(defn find-ovrs! [(k (mut Comp)) (n g/Node) (out (mut (ArrayList OvrSlot)))]
  (-> void)
  (when (and (= (.kind n) (g/KAssign)) (= (.kind (kid n 0)) (g/KName)))
    (match (attr-global (mut k) (.text (kid n 0)) 3)
      (Some [x]
            (let [(mut seen) false]
              (for e out (when (= (.attr e) (.name x)) (set! seen true)))
              (unless seen
                (push! (mut out)
                       (OvrSlot
                         :attr (.name x)
                         :sym (fresh (mut k) "whole")
                         :ty (.ty x)
                         :mark (fresh (mut k) "mark"))))))
      (None [] 0)))
  (for c (.kids n) (find-ovrs! (mut k) c (mut out))))

;;; Which child the pattern's top-level name `name` is: an index, or one counted from the end
;;; past a rest.
(defn child-index [(p g/Node) (name (slice u8)) (subject Code)]
  (-> (Option Code))
  (let [args
          (match (.kind p)
            (g/KPNode [] (Some (list-kids (kid p 1))))
            (g/KPNodeQ [] (Some (list-kids (kid p 2))))
            (_ (None [(ArrayList g/Node)])))]
    (match args
      (None [] (None [Code]))
      (Some [xs]
            (let [n (len xs)
                  (mut rest-at) -1
                  (mut out) (None [Code])]
              (for i (range 0 n)
                (let [a (get xs i)]
                  (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
                    (set! rest-at i))))
              (for i (range 0 n)
                (let [a (get xs i)
                      bound
                        (cond (= (.kind a) (g/KName)) (.text a)
                              (= (.kind a) (g/KPAs)) (.text (kid a 1))
                              :else "")]
                  (when (= bound name)
                    (set! out
                          (Some (if (or (< rest-at 0) (< i rest-at))
                                    `~i
                                    `(- (len (.kids ~subject)) ~(- n i))))))))
              out)))))

;;; Visit `call`'s child with these inherited attributes, and the `given` ones no equation gives
;;; at their defaults, then put back the parent's.
(defn with-attrs-code [(k (mut Comp))
                       (slots (ArrayList EqSlot))
                       (task Code)
                       (call Code)] (-> Code)
  (let [(mut saves) (primitive/code-list-new)
        (mut sets) (primitive/code-list-new)
        (mut restores) (primitive/code-list-new)
        (mut count) 0]
    (for s slots
      (let [saved (fresh (mut k) "saved")
            field (task-field (.attr s) task)]
        (set! count (+ count 1))
        (push! (mut saves) (sym saved))
        (push! (mut saves) field)
        (push! (mut sets) `(set! ~field ~(sym (.sym s))))
        (push! (mut restores) `(set! ~field ~(sym saved)))))
    (for gv (.givens k)
      (let [(mut covered) false]
        (for s slots (when (= (.attr s) (.attr gv)) (set! covered true)))
        (unless covered
          (let [saved (fresh (mut k) "saved")
                field (task-field (.attr gv) task)]
            (set! count (+ count 1))
            (push! (mut saves) (sym saved))
            (push! (mut saves) field)
            (push! (mut sets) `(set! ~field ~(.default gv)))
            (push! (mut restores) `(set! ~field ~(sym saved)))))))
    (if (= count 0)
        call
        `(let [~@saves] ~@sets ~call ~@restores 0))))

(defn default-traverse [(k (mut Comp)) (subject Code) (task Code) (visit Code)]
  (-> Code)
  (let [c (sym (fresh (mut k) "c"))]
    `(for (ref ~c) (.kids ~subject)
       ~(with-attrs-code (mut k)
                         (ArrayList::new [EqSlot] (malloc-allocator))
                         task
                         `(~visit ~c ~task)))))

;;; The children of a node an owner block matched, each with what the equations give it.
;;; `indices` says where each of `targets` is among them.
(defn owner-traverse [(k (mut Comp))
                      (at g/Node)
                      (slots (ArrayList EqSlot))
                      (targets (ArrayList (slice u8)))
                      (indices (ArrayList Code))
                      (subject Code)
                      (task Code)
                      (visit Code)] (-> Code)
  (let [ci (sym (fresh (mut k) "ci"))
        c (sym (fresh (mut k) "c"))
        call `(~visit ~c ~task)
        (mut arms) (primitive/code-list-new)
        (mut all-kids) (ArrayList::new [EqSlot] (malloc-allocator))]
    (for s slots (when (= (.target s) "kids") (push! (mut all-kids) s)))
    (for i (range 0 (len targets))
      (let [t (get targets i)
            (mut mine) (ArrayList::new [EqSlot] (malloc-allocator))]
        (for s slots (when (= (.target s) t) (push! (mut mine) s)))
        (for s all-kids
          (let [(mut shadowed) false]
            (for m slots
              (when (and (= (.target m) t) (= (.attr m) (.attr s)))
                (set! shadowed true)))
            (unless shadowed (push! (mut mine) s))))
        (push! (mut arms) `(= ~ci ~(get indices i)))
        (push! (mut arms) (with-attrs-code (mut k) mine task call))))
    (if (= (len targets) 0)
        `(for (ref ~c) (.kids ~subject)
           ~(with-attrs-code (mut k) all-kids task call))
        `(for ~ci (range 0 (len (.kids ~subject)))
           (let [~c (get (.kids ~subject) ~ci)]
             (cond ~@arms :else ~(with-attrs-code (mut k) all-kids task call)))))))

;;; The children a block's equations name, `kids` aside, in the order first named.
(defn eq-targets [(slots (ArrayList EqSlot))] (-> (ArrayList (slice u8)))
  (let [(mut out) (text-list)]
    (for s slots
      (unless (= (.target s) "kids")
        (let [(mut seen) false]
          (for x out (when (= x (.target s)) (set! seen true)))
          (unless seen (push! (mut out) (.target s))))))
    out))

(defn target-indices [(k (mut Comp))
                      (a OnAlt)
                      (targets (ArrayList (slice u8)))
                      (subject Code)] (-> (ArrayList Code))
  (let [(mut out) (ArrayList::new [Code] (malloc-allocator))]
    (for t targets
      (match (child-index (.pat a) t subject)
        (Some [index] (push! (mut out) index))
        (None []
              (die (mut k)
                   (.body a)
                   (cat3 "an equation gives an attribute to a child, and "
                         t
                         " is not one this pattern names at its top")))))
    out))

;;; The block's statements, with the slots its equations fill; then, for an owner, the children.
(defn on-body-code [(k (mut Comp))
                    (body-node g/Node)
                    (owner bool)
                    (slots (ArrayList EqSlot))
                    (targets (ArrayList (slice u8)))
                    (indices (ArrayList Code))
                    (subject Code)
                    (task Code)
                    (visit Code)
                    (label Code)
                    (leave bool)] (-> Code)
  (set! (.eq-slots k) slots)
  (set! (.in-on k) true)
  (let [body (expr (mut k) body-node "Void")]
    (set! (.in-on k) false)
    (set! (.eq-slots k) (ArrayList::new [EqSlot] (malloc-allocator)))
    (when (.returned k) (die (mut k) body-node "an `on` block cannot return"))
    (let [(mut decls) (primitive/code-list-new)]
      (for s slots
        (push! (mut decls) `(mut ~(sym (.sym s))))
        (push! (mut decls) (task-field (.attr s) task)))
      (if owner
          `(let [~@decls]
             ~(.code body)
             ~(owner-traverse (mut k)
                              body-node
                              slots
                              targets
                              indices
                              subject
                              task
                              visit)
             ~(if leave `(return-from ~label 0) `0))
          `(do ~(.code body) 0)))))

;;; The names an alternative's pattern binds, its own included, with their types.
(defn alt-vars [(k (mut Comp)) (a OnAlt) (subject Code) (ty (slice u8))]
  (-> (ArrayList OnVar))
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))
        (mut out) (ArrayList::new [OnVar] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) (on-head a))
    (unless (none? (.as-name a))
      (bind-local! (mut k) (.text (.as-name a)) ty false))
    ;; What the guard's `is` patterns bind, the block sees too.
    (unless (none? (.guard a)) (guard-steps! (mut k) (.guard a) (mut steps)))
    (for i (range mark (len (.locals k)))
      (let [l (get (.locals k) i)]
        (push! (mut out) (OnVar :name (.name l) :ty (.ty l)))))
    (locals-reset! (mut k) mark)
    out))

(defn on-blocks [(k (mut Comp))
                 (alts (ArrayList OnAlt))
                 (count i64)
                 (subject Code)
                 (ty (slice u8))] (-> (ArrayList OnBlock))
  (let [(mut out) (ArrayList::new [OnBlock] (malloc-allocator))]
    (for b (range 0 count)
      (let [(mut first) (None [OnAlt])]
        (for a alts
          (when (and (= (.block a) b)
                     (match first (None [] true) (Some [_] false)))
            (set! first (Some a))))
        (match first
          (None [] (die (mut k) (g/none-node) "an `on` block with no pattern"))
          (Some [a0]
                (let [vars (alt-vars (mut k) a0 subject ty)
                      (mut ovrs) (ArrayList::new [OvrSlot] (malloc-allocator))
                      (mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
                  (for a alts
                    (when (= (.block a) b)
                      (let [mine (alt-vars (mut k) a subject ty)
                            (mut same) (= (len mine) (len vars))]
                        (for v vars
                          (let [(mut hit) false]
                            (for w mine
                              (when (and (= (.name w) (.name v))
                                         (= (.ty w) (.ty v)))
                                (set! hit true)))
                            (unless hit (set! same false))))
                        (unless same
                          (die (mut k)
                               (.pat a)
                               "every alternative of an `on` pattern binds the same names, of the same types")))))
                  (find-ovrs! (mut k) (.body a0) (mut ovrs))
                  (when (.owner a0) (find-eqs! (mut k) (.body a0) (mut slots)))
                  (push! (mut out)
                         (OnBlock
                           :body (.body a0)
                           :owner (.owner a0)
                           :inline (> (len ovrs) 0)
                           :vars vars
                           :targets (eq-targets slots)
                           :fname (cat "attrs-block-" (rt/num-text b))
                           :task `rules-task-here)))))))
    out))

(defn on-block-fn [(k (mut Comp))
                   (b OnBlock)
                   (subject Code)
                   (node-coil Code)
                   (task Code)
                   (visit Code)] (-> Code)
  (clear! (mut (.locals k)))
  (set! (.returned k) false)
  (let [(mut params) (primitive/code-list-new)
        (mut indices) (ArrayList::new [Code] (malloc-allocator))
        (mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
    (for v (.vars b)
      (let [s (bind-local! (mut k) (.name v) (.ty v) false)]
        (push! (mut params) `(~(sym s) ~(coil-type (mut k) (.ty v))))))
    (for t (.targets b)
      (let [s (fresh (mut k) "at")]
        (push! (mut indices) (sym s))
        (push! (mut params) `(~(sym s) i64))))
    (when (.owner b) (find-eqs! (mut k) (.body b) (mut slots)))
    (let [code
            (on-body-code (mut k)
                          (.body b)
                          (.owner b)
                          slots
                          (.targets b)
                          indices
                          subject
                          task
                          visit
                          `0
                          false)]
      (clear! (mut (.locals k)))
      `(defn ~(sym (.fname b)) [(~subject ~node-coil)
                                (~task (ptr RulesTask))
                                ~@params] (-> void)
         ~code
         0))))

;;; One alternative at a node of kind `head` ("" when the dispatch knows none): its pattern's
;;; test, then its block, called or inline. An owner visits the children and leaves `label`.
(defn on-alt-code [(k (mut Comp))
                   (a OnAlt)
                   (b OnBlock)
                   (subject Code)
                   (ty (slice u8))
                   (head (slice u8))
                   (label Code)
                   (task Code)
                   (visit Code)] (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) head)
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))))
    ;; `on Pat if cond { … }`: the block holds only where the condition does.
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [indices (target-indices (mut k) a (.targets b) subject)
          code
            (if (.inline b)
                (let [(mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
                  (when (.owner b) (find-eqs! (mut k) (.body b) (mut slots)))
                  (on-body-code (mut k)
                                (.body b)
                                (.owner b)
                                slots
                                (.targets b)
                                indices
                                subject
                                task
                                visit
                                label
                                true))
                (let [(mut args) (primitive/code-list-new)]
                  (for v (.vars b)
                    (match (find-local (mut k) (.name v))
                      (Some [l] (push! (mut args) (sym (.sym l))))
                      (None []
                            (die (mut k)
                                 (.pat a)
                                 (cat "this pattern does not bind " (.name v))))))
                  (for i indices (push! (mut args) i))
                  (let [call `(~(sym (.fname b)) ~subject ~(.task b) ~@args)]
                    (if (.owner b) `(do ~call (return-from ~label 0)) call))))]
      (locals-reset! (mut k) mark)
      (wrap-steps steps 0 code))))

;;; At a node of kind `head`: the blocks that only add, in the file's order, then the first
;;; owner that matches visits the children; with none, they are visited as they are.
(defn on-arm-code [(k (mut Comp))
                   (alts (ArrayList OnAlt))
                   (blocks (ArrayList OnBlock))
                   (head (slice u8))
                   (subject Code)
                   (ty (slice u8))
                   (task Code)
                   (visit Code)] (-> Code)
  (let [(mut adds) (primitive/code-list-new)
        (mut owners) (primitive/code-list-new)
        label (primitive/code-symbol ":" (fresh (mut k) "own"))]
    (for a alts
      (let [h (on-head a)
            b (get blocks (.block a))]
        (when (or (= h head) (= (len h) 0))
          (if (.owner a)
              (push! (mut owners)
                     (on-alt-code (mut k) a b subject ty head label task visit))
              (push! (mut adds)
                     (on-alt-code (mut k) a b subject ty head label task visit))))))
    `(do
       ~@adds
       (block ~label ~@owners ~(default-traverse (mut k) subject task visit) 0)
       0)))

;;; The field of this grammar's task state that holds an included one's.
(defn include-field [(m Mod)] (-> (slice u8))
  (cat "attrs-in-" (alias-of (.name m))))

;;; An included grammar's blocks, added to this traversal's: each alternative calls the block's
;;; function in the included module, with that module's task state. Its blocks only add what
;;; they collect; giving children attributes, or a collection a node's whole value, would need its
;;; equations merged with this grammar's, which is not built yet.
(defn included-blocks! [(k (mut Comp))
                        (d g/Node)
                        (subject Code)
                        (ty (slice u8))
                        (task Code)
                        (alts (mut (ArrayList OnAlt)))
                        (blocks (mut (ArrayList OnBlock)))
                        (heads (mut (ArrayList (slice u8))))
                        (gr Mod)
                        (over (slice u8))] (-> void)
  (let [name (.text (kid d 0))
        m (mod-at (mut k) name)
        path
          (match (file-of (mut k) name)
            (Some [p] p)
            (None [] (die (mut k) d (cat "no file for " name))))
        saved-src (.src k)
        saved-path (.path k)
        src (rt/read-all path)
        mtree (parse-file (mut k) src path)
        mdecls (list-kids (kid mtree 2))
        offset (len blocks)
        its (task-field (include-field m) task)
        (mut count) 0]
    (unless (= (.kind mtree) (g/KAttrsFile))
      (die (mut k) d (cat name " is not an attribute grammar")))
    (for x (.globals m)
      (when (= (.attr x) 4)
        (die (mut k)
             d
             (cat3 "an included attribute grammar gives no attributes, not yet: "
                   (.name x)
                   " is given"))))
    (set! (.src k) src)
    (set! (.path k) path)
    (set! (.attrs-from k) name)
    (for md mdecls (when (= (.kind md) (g/KOn)) (set! count (+ count 1))))
    (let [malts (on-alts (mut k) mdecls)
          mblocks (on-blocks (mut k) malts count subject ty)]
      (for b mblocks
        (when (or (.owner b) (.inline b))
          (die (mut k)
               (.body b)
               "an included attribute grammar's blocks only add what they collect, not yet more"))
        (push! (mut blocks)
               (OnBlock
                 :body (.body b)
                 :owner false
                 :inline false
                 :vars (.vars b)
                 :targets (.targets b)
                 :fname (cat3 (alias-of (.name m)) "/" (.fname b))
                 :task its)))
      (for a malts
        (let [h (on-head a)
              (mut seen) (= (len h) 0)]
          (for x heads (when (= x h) (set! seen true)))
          (unless seen
            (unless (match (find-kind gr h) (Some [_] true) (None [] false))
              (die (mut k)
                   (.pat a)
                   (cat4 "the grammar " over " has no node named " h)))
            (push! (mut heads) h)))
        (push! (mut alts)
               (OnAlt
                 :pat (.pat a)
                 :as-name (.as-name a)
                 :guard (.guard a)
                 :body (.body a)
                 :owner false
                 :block (+ (.block a) offset)))))
    (set! (.attrs-from k) "")
    (set! (.src k) saved-src)
    (set! (.path k) saved-path)
    (clear! (mut (.locals k)))))

;;; `rewrite Pattern if guard => value`: what a node becomes. The pattern and the guard see the node
;;; as it was; `x.out` is what a child the pattern names became, and with the rule's `as` name, the
;;; node rebuilt from its children's. Tried in the file's order; the first that matches gives the
;;; node, or a list of nodes in a list's place, and a node no rule matches is rebuilt.
(defstruct RwAlt [(pat g/Node) (as-name g/Node) (guard g/Node) (body g/Node)])

(defn rewrite-alts [(decls (ArrayList g/Node))] (-> (ArrayList RwAlt))
  (let [(mut out) (ArrayList::new [RwAlt] (malloc-allocator))]
    (for d decls
      (when (= (.kind d) (g/KRewrite))
        (let [p0 (kid d 0)
              has-as (= (.kind p0) (g/KPAs))
              as-name (if has-as (kid p0 1) (g/none-node))
              p (if has-as (kid p0 0) p0)]
          (for q (top-alternatives p)
            (push! (mut out)
                   (RwAlt
                     :pat q
                     :as-name as-name
                     :guard (kid d 1)
                     :body (kid d 2)))))))
    out))

(defn rw-head [(a RwAlt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

(defn results-field [(task Code)] (-> Code)
  `(.attrs-results ~task))

;;; One rule at a node of kind `head`: on a match, its value goes where the node was.
(defn rw-alt-code [(k (mut Comp))
                   (a RwAlt)
                   (subject Code)
                   (rebuilt Code)
                   (ty (slice u8))
                   (head (slice u8))
                   (label Code)
                   (task Code)
                   (same Code)] (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) head)
    (clear! (mut (.outs k)))
    ;; The children the pattern names at its top, and its node, have rewritten forms.
    (for i (range mark (len (.locals k)))
      (let [l (get (.locals k) i)]
        (match (child-index (.pat a) (.name l) subject)
          (Some [index]
                (push! (mut (.outs k))
                       (Out :sym (.sym l) :code `(get (.kids ~rebuilt) ~index))))
          (None [] 0))))
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))
        (push! (mut (.outs k)) (Out :sym s :code rebuilt))))
    (set! (.in-on k) true)
    (let [guard
            (if (none? (.guard a))
                `true
                (.code (expect (mut k)
                               (.guard a)
                               (expr (mut k) (.guard a) "Bool")
                               "Bool")))
          many (cat3 "[" ty "]")
          ;; `[…]` is the nodes that go in the node's place; anything else, the one node.
          v
            (expr (mut k)
                  (.body a)
                  (if (= (.kind (.body a)) (g/KListLit)) many ty))
          each (fresh (mut k) "each")
          got (fresh (mut k) "got")
          changed `(set! (.attrs-changes ~task) (+ (.attrs-changes ~task) 1))
          push
            (cond (= (.ty v) ty)
                    `(let [~(sym got) ~(.code v)]
                       (unless (~same ~(sym got) ~subject) ~changed)
                       (push! (mut ~(results-field task)) ~(sym got)))
                  (= (.ty v) many)
                    `(do
                       ~changed
                       (for (ref ~(sym each)) ~(.code v)
                         (push! (mut ~(results-field task)) ~(sym each))))
                  :else
                    (die (mut k)
                         (.body a)
                         (cat4 "a rewrite gives a "
                               ty
                               " or a "
                               (cat3 many ", not " (.ty v)))))]
      (set! (.in-on k) false)
      (clear! (mut (.outs k)))
      (when (.returned k) (die (mut k) (.body a) "a rewrite cannot return"))
      (locals-reset! (mut k) mark)
      (wrap-steps steps 0 `(when ~guard ~push (return-from ~label 0))))))

;;; The rules for a node of kind `head`, then the node as rebuilt.
(defn rw-arm-code [(k (mut Comp))
                   (alts (ArrayList RwAlt))
                   (head (slice u8))
                   (subject Code)
                   (rebuilt Code)
                   (ty (slice u8))
                   (task Code)
                   (same Code)] (-> Code)
  (let [label (primitive/code-symbol ":" (fresh (mut k) "rw"))
        (mut tries) (primitive/code-list-new)]
    (for a alts
      (let [h (rw-head a)]
        (when (or (= h head) (= (len h) 0))
          (push! (mut tries)
                 (rw-alt-code (mut k) a subject rebuilt ty head label task same)))))
    `(block ~label ~@tries (push! (mut ~(results-field task)) ~rebuilt) 0)))

;;; The traversal's rewriting: each visit leaves what its node became on `attrs-results`, so a
;;; node finds its children's past `mark`. A node is itself when no rewrite under it changed
;;; anything, which `attrs-changes` counts, so a node that stayed costs no comparing.
(defn rewrite-fns [(k (mut Comp))
                   (decls (ArrayList g/Node))
                   (gr Mod)
                   (over (slice u8))
                   (ty (slice u8))
                   (node-coil Code)
                   (task Code)] (-> Code)
  (let [alts (rewrite-alts decls)
        n (sym "rw-node")
        rebuilt (sym "rw-rebuilt")
        (mut heads) (text-list)
        (mut arms) (primitive/code-list-new)
        alias (alias-of (.name gr))
        same (primitive/code-symbol alias "/same-node?")
        sublist (primitive/code-symbol alias "/sublist")
        kind-name (primitive/code-symbol alias "/kind-name")]
    (for a alts
      (let [h (rw-head a)
            (mut seen) (= (len h) 0)]
        (for x heads (when (= x h) (set! seen true)))
        (unless seen
          (unless (match (find-kind gr h) (Some [_] true) (None [] false))
            (die (mut k)
                 (.pat a)
                 (cat4 "the grammar " over " has no node named " h)))
          (push! (mut heads) h))))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) "Void")
    (set! (.in-fn k) true)
    (for h heads
      (push! (mut arms)
             `(~(kind-code gr h) []
                 ~(rw-arm-code (mut k) alts h n rebuilt ty task same))))
    (let [wild (rw-arm-code (mut k) alts "" n rebuilt ty task same)]
      (set! (.in-fn k) false)
      (clear! (mut (.locals k)))
      `(do
         (defn attrs-rebuilt [(~n ~node-coil)
                              (~task (ptr RulesTask))
                              (mark i64)
                              (before i64)] (-> ~node-coil)
           (if (= (.attrs-changes ~task) before)
               ~n
               (let [got (- (len ~(results-field task)) mark)]
                 (unless (or (= (.kind ~n) (~(kind-code gr "List")))
                             (= got (len (.kids ~n))))
                   (panic "a rewrite gave {} nodes in place of one child of a {} node"
                          got
                          (~kind-name (.kind ~n))))
                 (let [(mut x) ~n]
                   (set! (.kids x)
                         (~sublist ~(results-field task)
                            mark
                            (len ~(results-field task))))
                   x))))
         (defn attrs-rewrite! [(~n ~node-coil)
                               (~rebuilt ~node-coil)
                               (~task (ptr RulesTask))] (-> void)
           (match (.kind ~n) ~@arms (_ ~wild))
           0)
         (defn attrs-truncate! [(~task (ptr RulesTask)) (mark i64)] (-> void)
           (set! (.len ~(results-field task)) mark)
           0)))))

;;; The traversal, and `run`.
(defn compile-attrs [(k (mut Comp)) (tree g/Node) (decls (ArrayList g/Node))]
  (-> Code)
  (let [over (.text (kid tree 1))
        ty (cat over ".Node")
        gr (mod-at (mut k) over)
        node-coil (coil-type (mut k) ty)
        visit (sym "attrs-visit")
        n (sym "attrs-node")
        task (sym "rules-task-here")
        (mut alts) (on-alts (mut k) decls)
        (mut ovrs) (ArrayList::new [OvrSlot] (malloc-allocator))
        (mut heads) (text-list)]
    (for d decls
      (when (= (.kind d) (g/KOn))
        (find-ovrs! (mut k) (on-body-with-where d) (mut ovrs))))
    (let [(mut givens) (ArrayList::new [Given] (malloc-allocator))]
      (for d decls
        (when (= (.kind d) (g/KGiven))
          (let [x
                  (match (attr-global (mut k) (.text (kid d 0)) 4)
                    (Some [g] g)
                    (None [] (die (mut k) d "this was not collected")))]
            (push! (mut givens)
                   (Given
                     :attr (.name x)
                     :default
                       (.code (expect (mut k)
                                      (kid d 2)
                                      (expr (mut k) (kid d 2) (.ty x))
                                      (.ty x))))))))
      (set! (.givens k) givens))
    (for a alts
      (let [h (on-head a)
            (mut seen) (= (len h) 0)]
        (for x heads (when (= x h) (set! seen true)))
        (unless seen
          (unless (match (find-kind gr h) (Some [_] true) (None [] false))
            (die (mut k)
                 (.pat a)
                 (cat4 "the grammar " over " has no node named " h)))
          (push! (mut heads) h))))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) "Void")
    (set! (.in-fn k) true)
    (set! (.ovr-slots k) ovrs)
    (let [(mut arms) (primitive/code-list-new)
          (mut block-fns) (primitive/code-list-new)
          (mut marks) (primitive/code-list-new)
          (mut fixups) (primitive/code-list-new)
          (mut count) 0]
      (for d decls (when (= (.kind d) (g/KOn)) (set! count (+ count 1))))
      (let [own-blocks (on-blocks (mut k) alts count n ty)
            (mut blocks) (ArrayList::new [OnBlock] (malloc-allocator))]
        (for b own-blocks
          (push! (mut blocks) b)
          (unless (.inline b)
            (push! (mut block-fns)
                   (on-block-fn (mut k) b n node-coil task visit))))
        (clear! (mut (.locals k)))
        (for d decls
          (when (= (.kind d) (g/KInclude))
            (included-blocks! (mut k)
                              d
                              n
                              ty
                              task
                              (mut alts)
                              (mut blocks)
                              (mut heads)
                              gr
                              over)))
        (for h heads
          (push! (mut arms)
                 `(~(kind-code gr h) []
                     ~(on-arm-code (mut k) alts blocks h n ty task visit))))
        (let [wild (on-arm-code (mut k) alts blocks "" n ty task visit)]
          (set! (.in-fn k) false)
          (set! (.ovr-slots k) (ArrayList::new [OvrSlot] (malloc-allocator)))
          (for o ovrs
            (let [field (task-field (.attr o) task)
                  v (sym (fresh (mut k) "v"))
                  e (sym (fresh (mut k) "e"))]
              (push! (mut marks) `(mut ~(sym (.sym o))))
              (push! (mut marks) `(None [~(coil-type (mut k) (.ty o))]))
              (push! (mut marks) (sym (.mark o)))
              (push! (mut marks) (if (list? (.ty o)) `(len ~field) field))
              (push! (mut fixups)
                     (if (list? (.ty o))
                         `(match ~(sym (.sym o))
                            (Some [~v]
                                  (while (> (len ~field) ~(sym (.mark o)))
                                    (pop! (mut ~field)))
                                  (for (ref ~e) ~v (push! (mut ~field) ~e))
                                  0)
                            (None [] 0))
                         `(match ~(sym (.sym o))
                            (Some [~v]
                                  (set! ~field ~(sym (.mark o)))
                                  (match ~(sym (.mark o))
                                    (None [] (set! ~field ~v))
                                    (_ 0))
                                  0)
                            (None [] 0))))))
          (let [(mut params) (primitive/code-list-new)
                (mut saves) (primitive/code-list-new)
                (mut sets) (primitive/code-list-new)
                (mut restores) (primitive/code-list-new)
                (mut fields) (primitive/code-list-new)
                t (sym "attrs-task")
                root (sym "attrs-tree")]
            (for d decls
              (when (= (.kind d) (g/KInput))
                (let [name (.text (kid d 0))
                      x
                        (match (attr-global (mut k) name 2)
                          (Some [g] g)
                          (None [] (die (mut k) d "this was not collected")))
                      p (fresh (mut k) "in")
                      saved (fresh (mut k) "saved")]
                  (push! (mut params) `(~(sym p) ~(coil-type (mut k) (.ty x))))
                  (push! (mut saves) (sym saved))
                  (push! (mut saves) (task-field name t))
                  (push! (mut sets) `(set! ~(task-field name t) ~(sym p)))
                  (push! (mut restores)
                         `(set! ~(task-field name t) ~(sym saved)))))
              (when (= (.kind d) (g/KCollect))
                (let [name (.text (kid d 0))
                      x
                        (match (attr-global (mut k) name 3)
                          (Some [g] g)
                          (None [] (die (mut k) d "this was not collected")))]
                  (push! (mut sets)
                         `(set! ~(task-field name t)
                                ~(default-of (mut k) d (.ty x))))
                  (push! (mut fields) (primitive/code-symbol ":" name))
                  (push! (mut fields) (task-field name t))))
              ;; An included grammar's task state, found once, and what it collects, from empty.
              (when (= (.kind d) (g/KInclude))
                (let [m (mod-at (mut k) (.text (kid d 0)))
                      its (task-field (include-field m) t)]
                  (push! (mut sets)
                         `(set! ~its
                                (~(primitive/code-symbol (alias-of (.name m))
                                                         "/rules-task"))))
                  (for x (.globals m)
                    (when (= (.attr x) 3)
                      (push! (mut sets)
                             `(set! ~(task-field (.name x) its)
                                    ~(default-of (mut k) d (.ty x))))
                      (push! (mut fields) (primitive/code-symbol ":" (.name x)))
                      (push! (mut fields) (task-field (.name x) its)))))))
            (let [rw (rewrites? decls)
                  rw-mark (sym "rw-mark")
                  rw-fns
                    (if rw
                        (rewrite-fns (mut k) decls gr over ty node-coil task)
                        `(do))
                  rw-before (sym "rw-before")
                  visit-marks
                    (if rw
                        `(~@marks ~rw-mark
                            (len ~(results-field task))
                            ~rw-before
                            (.attrs-changes ~task))
                        `(~@marks))
                  post
                    (if rw
                        `(let [rebuilt
                                 (attrs-rebuilt ~n ~task ~rw-mark ~rw-before)]
                           (attrs-truncate! ~task ~rw-mark)
                           (attrs-rewrite! ~n rebuilt ~task))
                        `0)
                  start (sym "rw-start")]
              (when rw
                (push! (mut fields) `:tree)
                (push! (mut fields) `(get ~(results-field t) ~start)))
              `(do
                 ~@block-fns
                 ~rw-fns
                 (defn ~visit [(~n ~node-coil) (~task (ptr RulesTask))]
                   (-> void)
                   (let [~@visit-marks]
                     (match (.kind ~n) ~@arms (_ ~wild))
                     ~@fixups
                     ~post
                     0))
                 (defn run [(~root ~node-coil) ~@params] (-> Attrs)
                   (let [~t (rules-task)
                         ~start ~(if rw `(len ~(results-field t)) `0)
                         ~@saves]
                     ~@sets
                     ~(if (inputs? decls)
                          `(set! (.attrs-depth ~t) (+ (.attrs-depth ~t) 1))
                          `0)
                     (~visit ~root ~t)
                     (let [result (Attrs ~@fields)]
                       ~(if rw `(attrs-truncate! ~t ~start) `0)
                       ~(if (inputs? decls)
                            `(set! (.attrs-depth ~t) (- (.attrs-depth ~t) 1))
                            `0)
                       ~@restores
                       result)))))))))))

;; ---------------------------------------------------------------- memo functions

;;; `memo fn f(k: K) -> R`: each answer is computed once, by whichever worker asks first, and
;;; every worker shares it; one that asks while another computes it waits. Each keeps a table of
;;; its own in front of the shared one, so a question asked again costs no lock. The answer must not
;;; be changed by whoever gets it. While dependencies are tracked it is kept until something it
;;; was made from changes: a file it read, a setting, another memo's answer (see the dependencies in
;;; hl.rt), so a long-running program computes again only what an edit reaches. Otherwise binding a
;;; setting of the module starts all its memos over.
(defn memo-check! [(k (mut Comp)) (d g/Node)] (-> Func)
  (let [f
          (match (find-func (self-mod (mut k)) (.text (kid d 0)))
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))]
    (for p (.params f)
      (when (.by-ref p)
        (die (mut k) d "a memo function's argument cannot be mut"))
      (unless (keyable? (mut k) (.ty p))
        (die (mut k)
             d
             (cat3 "a memo function cannot remember by a "
                   (.ty p)
                   ": its arguments are Int, Text, Bool, enums, trees, and lists and records of those"))))
    (when (= (.ret f) "Void")
      (die (mut k) d "a memo function must answer something"))
    f))

;;; What a memo can remember by: values whose text says which they are. A tree is remembered by
;;; its identity, not its contents: trees are never changed, so the same tree is the same value, and
;;; one an earlier answer kept is found again.
(defn keyable? [(k (mut Comp)) (t (slice u8))] (-> bool)
  (cond (or (= t "Int") (= t "Text") (= t "Bool")) true
        (list? t) (keyable? (mut k) (elem-of t))
        (or (opt? t) (map? t) (fn? t)) false
        (< (mod-index (mut k) (type-module t)) 0) false
        :else
          (let [mo (mod-at (mut k) (type-module t))]
            (cond (and (= (.sort mo) (SGrammar)) (= (type-name t) "Node")) true
                  (is-some? (find-enum-named mo (type-name t))) true
                  :else
                    (match (find-rec mo (type-name t))
                      (Some [r]
                            (let [(mut ok) true]
                              (for fd (.fields r)
                                (unless (keyable? (mut k) (.ty fd))
                                  (set! ok false)))
                              ok))
                      (None [] false))))))

;;; A value's text, as a key: see `keyable?`.
;;; What a memo is looked up by: its one argument when that is an Int or Text, or else its
;;; arguments' text joined.
(defn memo-key-type [(f Func)] (-> (slice u8))
  (if (and (= (len (.params f)) 1)
           (or (= (.ty (get (.params f) 0)) "Int")
               (= (.ty (get (.params f) 0)) "Text")))
      (.ty (get (.params f) 0))
      "Text"))

;;; The memo's own name for its argument `i`.
(defn memo-arg [(i i64)] (-> Code)
  (sym (cat "memo-arg-" (rt/num-text i))))

(defn memo-key-code [(k (mut Comp)) (f Func)] (-> Code)
  (if (!= (memo-key-type f) "Text")
      (memo-arg 0)
      (if (and (= (len (.params f)) 1) (= (.ty (get (.params f) 0)) "Text"))
          (memo-arg 0)
          (let [(mut writes) (primitive/code-list-new)]
            (for i (range 0 (len (.params f)))
              (push! (mut writes)
                     (key-write-code (mut k)
                                     (.ty (get (.params f) i))
                                     (memo-arg i))))
            `(let [(mut memo-key-buf) (rt/key-buf-new)]
               ~@writes
               (rt/key-done! (mut memo-key-buf)))))))

;;; A value of type `t` written into the key being made (see `rt/key-buf-new`).
(defn key-write-code [(k (mut Comp)) (t (slice u8)) (v Code)] (-> Code)
  (cond (= t "Int") `(rt/key-int! (mut memo-key-buf) ~v)
        (= t "Text") `(rt/key-text! (mut memo-key-buf) ~v)
        (= t "Bool") `(rt/key-int! (mut memo-key-buf) (if ~v 1 0))
        (list? t)
          (let [e (fresh (mut k) "e")
                xs (fresh (mut k) "xs")]
            `(let [~(sym xs) ~v]
               (rt/key-count! (mut memo-key-buf) (len ~(sym xs)))
               (for ~(sym e) ~(sym xs)
                 ~(key-write-code (mut k) (elem-of t) (sym e)))))
        :else
          (let [mo (mod-at (mut k) (type-module t))]
            (cond (= (.sort mo) (SGrammar))
                    `(rt/key-text! (mut memo-key-buf)
                                   (~(sym (qualified (mut k)
                                                     (type-module t)
                                                     "node-key")) ~v))
                  (is-some? (find-enum-named mo (type-name t)))
                    `(rt/key-int! (mut memo-key-buf)
                       (~(sym (qualified (mut k) (type-module t)
                                         (cat "enum-tag-" (type-name t)))) ~v))
                  :else
                    (let [r
                            (match (find-rec mo (type-name t))
                              (Some [r] r)
                              (None [] (panic "rules: no record {}" t)))
                          x (fresh (mut k) "rec")
                          (mut writes) (primitive/code-list-new)]
                      (for fd (.fields r)
                        (push! (mut writes)
                               (key-write-code (mut k)
                                               (.ty fd)
                                               `(~(primitive/code-symbol "."
                                                                         (.name fd)) ~(sym x)))))
                      `(let [~(sym x) ~v] ~@writes 0))))))

(defn memo-map-type [(f Func)] (-> (slice u8))
  (cat4 "{" (memo-key-type f) ":" (cat (.ret f) "}")))

;;; Who is computing an answer: the worker's slot plus one.
(defn memo-busy-type [(f Func)] (-> (slice u8))
  (cat3 "{" (memo-key-type f) ":Int}"))

(defn memo-near [(name (slice u8))] (-> (slice u8))
  (cat "memo-near--" name))

(defn memo-near-gen [(name (slice u8))] (-> (slice u8))
  (cat "memo-near-gen--" name))

;;; The task struct's fields for a memo: its near table and the generation that table is of.
(defn memo-storage-type [(k (mut Comp)) (f Func)] (-> Code)
  `(rt/MemoMap ~(coil-type (mut k) (memo-key-type f)) ~(coil-type (mut k) (.ret f))))

(defn memo-storage-new [(k (mut Comp)) (f Func)] (-> Code)
  `(rt/MemoMap::new [~(coil-type (mut k) (memo-key-type f)) ~(coil-type (mut k) (.ret f))]
                    ~(if (= (memo-key-type f) "Int") `(i64-keyops) `(rt/memo-keyops))))

(defn memo-new-map [(k (mut Comp)) (d g/Node)] (-> Code)
  (memo-storage-new (mut k) (memo-check! (mut k) d)))

(defn memo-near-field [(k (mut Comp)) (d g/Node)] (-> Code)
  `(~(sym (memo-near (.text (kid d 0)))) ~(memo-storage-type (mut k) (memo-check! (mut k) d))))

(defn memo-gen-field [(d g/Node)] (-> Code)
  `(~(sym (memo-near-gen (.text (kid d 0)))) i64))

(defn memo-near-init [(k (mut Comp)) (d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near (.text (kid d 0)))) s)
         ~(memo-new-map (mut k) d)))

(defn memo-gen-init [(d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near-gen (.text (kid d 0)))) s) -1))

;;; Beside a memo's near table, the region each answer in it is held by: what asks for one holds a
;;; value of that region's.
(defn memo-near-regions [(name (slice u8))] (-> (slice u8))
  (cat "memo-near-regions--" name))

(defn memo-key-int-type [(k (mut Comp)) (d g/Node)] (-> (slice u8))
  (cat3 "{" (memo-key-type (memo-check! (mut k) d)) ":Int}"))

(defn memo-near-regions-field [(k (mut Comp)) (d g/Node)] (-> Code)
  `(~(sym (memo-near-regions (.text (kid d 0)))) ~(coil-type (mut k) (memo-key-int-type (mut k) d))))

(defn memo-near-regions-init [(k (mut Comp)) (d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near-regions (.text (kid d 0)))) s)
         ~(runtime-map (mut k) (memo-key-int-type (mut k) d))))

(defn memo-near-rev [(name (slice u8))] (-> (slice u8))
  (cat "memo-near-rev--" name))

(defn memo-rev-field [(d g/Node)] (-> Code)
  `(~(sym (memo-near-rev (.text (kid d 0)))) i64))

(defn memo-rev-init [(d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near-rev (.text (kid d 0)))) s) -1))

;;; Whether two values of a rules type are the same, as code: what keeps a memo's recomputed answer
;;; from counting as changed. Lists, maps and records are compared by helpers made once per type;
;;; a list whose buffer is the other's is the same without a look inside. Functions, and a foreign
;;; module's opaque types, cannot be looked into: two of them are never the same.
(defn same-code [(k (mut Comp)) (t (slice u8)) (a Code) (b Code)] (-> Code)
  (cond (or (= t "Int") (= t "Bool") (= t "Text")) `(= ~a ~b)
        (fn? t) `(~(identity-helper (mut k) t) ~a ~b)
        (opt? t)
          (let [x (fresh (mut k) "x")
                y (fresh (mut k) "y")]
            `(match ~a
               (Some [~(sym x)]
                     (match ~b
                       (Some [~(sym y)]
                             ~(same-code (mut k) (opt-of t) (sym x) (sym y)))
                       (None [] false)))
               (None [] (match ~b (Some [_] false) (None [] true)))))
        (or (list? t) (map? t)) `(~(same-helper (mut k) t) ~a ~b)
        (< (mod-index (mut k) (type-module t)) 0)
          (panic "rules: cannot compare values of type {}" t)
        :else
          (let [mo (mod-at (mut k) (type-module t))]
            (cond (and (= (.sort mo) (SGrammar)) (= (type-name t) "Node"))
                    `(~(sym (qualified (mut k) (type-module t) "node-same?")) ~a
                        ~b)
                  (is-some? (find-enum-named mo (type-name t))) `(= ~a ~b)
                  (is-some? (find-rec mo (type-name t)))
                    `(~(same-helper (mut k) t) ~a ~b)
                  ;; An opaque type its module says how to compare: `same-T?(a, b)`.
                  (is-some? (find-func mo (cat3 "same-" (type-name t) "?")))
                    (let [f
                            (match (find-func mo
                                              (cat3 "same-" (type-name t) "?"))
                              (Some [f] f)
                              (None [] (panic "rules: lost {}" t)))]
                      `(or (~(identity-helper (mut k) t) ~a ~b)
                           (~(sym (qualified (mut k) (type-module t) (.coil f))) ~a
                              ~b)))
                  ;; What cannot be looked into is the same only as itself: the same bytes.
                  :else `(~(identity-helper (mut k) t) ~a ~b)))))

;;; Whether two values are the very same one: the same bytes, which for a value holding its parts
;;; by pointer means the same parts.
(defn identity-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (cat "ident" (subslice (same-name t) 4 (len (same-name t))))
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (push! (mut (.aux k))
             `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                (let [(mut x) a
                      (mut y) b]
                  (rt/same-bytes? (cast (ptr u8) (mut x))
                                  (cast (ptr u8) (mut y))
                                  (sizeof ~ty))))))
    (sym name)))

(defn is-some? [T] [(o (Option T))] (-> bool)
  (match o (Some [_] true) (None [] false)))

(defn same-name [(t (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut b) "same--")
    (for i (range 0 (len t))
      (let [c (get t i)]
        (push-str! (mut b)
                   (cond (= c #\[) "L"
                         (= c #\]) "E"
                         (= c #\{) "M"
                         (= c #\}) "N"
                         (= c #\:) "C"
                         (= c #\?) "O"
                         (= c #\.) "_"
                         (= c #\,) "S"
                         (= c #\-) "h"
                         (= c #\() "P"
                         (= c #\)) "Q"
                         (= c #\>) "G"
                         (= c #\space) "_"
                         :else (subslice t i (+ i 1))))))
    (finish! (mut b))))

;;; The helper comparing two values of a list, map or record type, made the first time it is asked for.
(defn same-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (same-name t)
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (push! (mut (.aux k))
             (cond (list? t)
                     `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                        (and (= (len a) (len b))
                             (or (= (primitive/cast i64 (data (slice a)))
                                    (primitive/cast i64 (data (slice b))))
                                 (block :same
                                   (for i (range 0 (len a))
                                     (unless ~(same-code (mut k)
                                                         (elem-of t)
                                                         `(get a i)
                                                         `(get b i))
                                       (return-from :same false)))
                                   true))))
                   (map? t)
                     `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                        (or (~(identity-helper (mut k) t) a b)
                            (and (= (len a) (len b))
                                 (block :same
                                   (for key a
                                     (match (get b key)
                                       (Some [y]
                                             (match (get a key)
                                               (Some [x]
                                                     (unless ~(same-code (mut k)
                                                                         (map-val t)
                                                                         `x
                                                                         `y)
                                                       (return-from :same false)))
                                               (None []
                                                     (return-from :same false))))
                                       (None [] (return-from :same false))))
                                   true))))
                   :else
                     (let [r
                             (match (find-rec (mod-at (mut k) (type-module t))
                                              (type-name t))
                               (Some [r] r)
                               (None [] (panic "rules: no record {}" t)))
                           (mut tests) (primitive/code-list-new)]
                       (for f (.fields r)
                         (push! (mut tests)
                                (same-code (mut k)
                                           (.ty f)
                                           `(~(primitive/code-symbol "."
                                                                     (.name f)) a)
                                           `(~(primitive/code-symbol "."
                                                                     (.name f)) b))))
                       `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                          (or (~(identity-helper (mut k) t) a b)
                              (and true ~@tests)))))))
    (sym name)))

(defn has-text? [(xs (ArrayList (slice u8))) (x (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for y xs (when (= y x) (set! hit true)))
    hit))

;; ---------------------------------------------------------------- the cache on disk

;;; What a module keeps (see the cache in hl.rt) is written and read by helpers made from its
;;; types, one for each type the first time it is asked for: `w` is the Writer and `r` the Reader
;;; in all of them.
(defn persist-name [(prefix (slice u8)) (t (slice u8))] (-> (slice u8))
  (let [n (same-name t)]
    (cat prefix (subslice n 6 (len n)))))

;;; Code writing `v`, of type `t`.
(defn enc-code [(k (mut Comp)) (t (slice u8)) (v Code)] (-> Code)
  (cond (= t "Int") `(rt/put-int! w ~v)
        (= t "Bool") `(rt/put-bool! w ~v)
        (= t "Text") `(rt/put-text! w ~v)
        ;; A function value's bits, read as an integer.
        (fn? t)
          (let [f (fresh (mut k) "f")]
            `(rt/put-fn! w
                         (let [(mut ~(sym f)) ~v]
                           (load (cast (ptr i64) (mut ~(sym f)))))))
        (opt? t)
          (let [x (fresh (mut k) "x")]
            `(match ~v
               (Some [~(sym x)]
                     (do
                       (rt/put-bool! w true)
                       ~(enc-code (mut k) (opt-of t) (sym x))))
               (None [] (rt/put-bool! w false))))
        :else `(~(enc-helper (mut k) t) w ~v)))

;;; Code reading a value of type `t`.
(defn dec-code [(k (mut Comp)) (t (slice u8))] (-> Code)
  (cond (= t "Int") `(rt/take-int r)
        (= t "Bool") `(rt/take-bool r)
        (= t "Text") `(rt/take-text r)
        (fn? t)
          (let [f (fresh (mut k) "f")]
            `(let [(mut ~(sym f)) (rt/take-fn r)]
               (load (cast (ptr ~(coil-type (mut k) t)) (mut ~(sym f))))))
        (opt? t)
          `(if (rt/take-bool r)
               (Some ~(dec-code (mut k) (opt-of t)))
               (None [~(coil-type (mut k) (opt-of t))]))
        :else `(~(dec-helper (mut k) t) r)))

;;; How a value of a module's own kind of type is kept: "node", "db", "fact", "enum", "record", or
;;; "foreign" for an opaque type its foreign module writes and reads itself.
(defn persist-kind [(k (mut Comp)) (t (slice u8))] (-> (slice u8))
  (when (< (mod-index (mut k) (type-module t)) 0)
    (panic "rules: a value of type {} cannot be kept in the cache: its module is not known"
           t))
  (let [mo (mod-at (mut k) (type-module t))]
    (cond (and (= (.sort mo) (SGrammar)) (= (type-name t) "Node")) "node"
          (and (= (.sort mo) (SFacts)) (= (type-name t) "Db")) "db"
          (and (= (.sort mo) (SFacts)) (= (type-name t) "Fact")) "fact"
          (is-some? (find-enum-named mo (type-name t))) "enum"
          (is-some? (find-rec mo (type-name t))) "record"
          (= (.sort mo) (SForeign)) "foreign"
          :else
            (panic "rules: a value of type {} cannot be kept in the cache" t))))

;;; A value compared only by its bytes (an opaque one, or a database) is an object of the cache's:
;;; written once and shared when read back, so a value two settings or answers held, in any modules,
;;; is still one value, and the same as itself.
(defn shared-enc [(k (mut Comp)) (t (slice u8)) (inner Code)] (-> Code)
  `(let [(mut vv) v]
     (when (rt/put-object-bytes! w
                                 ~t
                                 (cast (ptr u8) (mut vv))
                                 (sizeof ~(coil-type (mut k) t)))
       ~inner
       (rt/put-object-end! w))))

(defn shared-dec [(k (mut Comp)) (t (slice u8)) (inner Code)] (-> Code)
  (let [ty (coil-type (mut k) t)]
    `(let [id (rt/take-object r)]
       (if (rt/object-ready? r id)
           (do
             (rt/object-skip! r)
             (load (cast (ptr ~ty) (rt/object-value r id))))
           (do
             (rt/object-enter! r)
             (let [(mut v) ~inner]
               (rt/object-leave! r (cast (ptr u8) (mut v)) (sizeof ~ty))
               (rt/writer-know-bytes! ~t
                                      (cast (ptr u8) (mut v))
                                      (sizeof ~ty)
                                      id)
               v))))))

;;; Whether a value of the type holds a tree, whose identity is where its parts are: a memo whose
;;; key does makes its keys again when the cache is read.
(defn tree-type? [(k (mut Comp)) (t (slice u8))] (-> bool)
  (cond (or (= t "Int") (= t "Bool") (= t "Text")) false
        (list? t) (tree-type? (mut k) (elem-of t))
        (opt? t) (tree-type? (mut k) (opt-of t))
        (map? t)
          (or (tree-type? (mut k) (map-key t)) (tree-type? (mut k) (map-val t)))
        (fn? t) false
        :else
          (let [mo (mod-at (mut k) (type-module t))]
            (cond (and (= (.sort mo) (SGrammar)) (= (type-name t) "Node")) true
                  :else
                    (match (find-rec mo (type-name t))
                      (Some [r]
                            (let [(mut any) false]
                              (for f (.fields r)
                                (when (tree-type? (mut k) (.ty f))
                                  (set! any true)))
                              any))
                      (None [] false))))))

(defn tree-keyed? [(k (mut Comp)) (f Func)] (-> bool)
  (let [(mut any) false]
    (for p (.params f) (when (tree-type? (mut k) (.ty p)) (set! any true)))
    any))

(defn enc-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (persist-name "enc--" t)
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (let [body
              (cond (list? t)
                      `(do
                         (rt/put-varint! w (len v))
                         (for e v ~(enc-code (mut k) (elem-of t) `e)))
                    (map? t)
                      `(do
                         (rt/put-varint! w (len v))
                         (for key v
                           ~(enc-code (mut k) (map-key t) `key)
                           (match (get v key)
                             (Some [x] ~(enc-code (mut k) (map-val t) `x))
                             (None []
                                   (panic "a map lost a key while it was written")))))
                    :else
                      (let [kind (persist-kind (mut k) t)
                            module (type-module t)
                            mo (mod-at (mut k) module)]
                        (cond (= kind "node")
                                `(~(sym (qualified (mut k)
                                                   module
                                                   "node-encode!")) w
                                    v)
                              (= kind "db")
                                (shared-enc (mut k)
                                            t
                                            `(~(sym (qualified (mut k) module "db-encode!")) w
                                                v))
                              (= kind "fact")
                                `(do
                                   (rt/put-int! w (cast i64 (.rel v)))
                                   (rt/put-int! w (cast i64 (.a v)))
                                   (rt/put-int! w (cast i64 (.b v)))
                                   (rt/put-int! w (cast i64 (.c v)))
                                   (rt/put-int! w (cast i64 (.d v))))
                              (= kind "enum")
                                `(rt/put-varint! w
                                                 (~(sym (qualified (mut k)
                                                                   module
                                                                   (cat "enum-tag-"
                                                                        (type-name t)))) v))
                              (= kind "record")
                                (let [r
                                        (match (find-rec mo (type-name t))
                                          (Some [r] r)
                                          (None []
                                                (panic "rules: no record {}" t)))
                                      (mut puts) (primitive/code-list-new)]
                                  (for f (.fields r)
                                    (push! (mut puts)
                                           (enc-code (mut k)
                                                     (.ty f)
                                                     `(~(primitive/code-symbol "."
                                                                               (.name f)) v))))
                                  `(do ~@puts))
                              :else
                                (shared-enc (mut k)
                                            t
                                            `(~(sym (qualified (mut k)
                                                               module
                                                               (cat "persist-encode-"
                                                                    (type-name t)))) w
                                                v)))))]
        (push! (mut (.aux k))
               `(defn ~(sym name) [(w (ptr rt/Writer)) (v ~ty)] (-> void)
                  ~body
                  0))))
    (sym name)))

(defn dec-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (persist-name "dec--" t)
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (let [body
              (cond (list? t)
                      `(let [n (rt/take-varint r)
                             (mut out) ~(new-list (mut k) (elem-of t))]
                         (reserve! (mut out) n)
                         (for _ (range 0 n)
                           (push! (mut out) ~(dec-code (mut k) (elem-of t))))
                         out)
                    (map? t)
                      `(let [n (rt/take-varint r)
                             (mut out) ~(new-map (mut k) t)]
                         (for _ (range 0 n)
                           (let [key ~(dec-code (mut k) (map-key t))
                                 x ~(dec-code (mut k) (map-val t))]
                             (set! (mut out) key x)))
                         out)
                    :else
                      (let [kind (persist-kind (mut k) t)
                            module (type-module t)
                            mo (mod-at (mut k) module)]
                        (cond (= kind "node")
                                `(~(sym (qualified (mut k) module "node-decode")) r)
                              (= kind "db")
                                (shared-dec (mut k)
                                            t
                                            `(~(sym (qualified (mut k) module "db-decode")) r))
                              (= kind "fact")
                                `(let [rel (rt/take-int r)
                                       a (rt/take-int r)
                                       b (rt/take-int r)
                                       c (rt/take-int r)
                                       d (rt/take-int r)]
                                   (~(sym (qualified (mut k) module "Fact"))
                                     :rel (cast i32 rel)
                                     :a (cast i32 a)
                                     :b (cast i32 b)
                                     :c (cast i32 c)
                                     :d (cast i32 d)))
                              (= kind "enum")
                                (let [e
                                        (match (find-enum-named mo
                                                                (type-name t))
                                          (Some [e] e)
                                          (None []
                                                (panic "rules: no enum {}" t)))
                                      (mut arms) (primitive/code-list-new)]
                                  (for i (range 0 (len (.variants e)))
                                    (push! (mut arms) `(= i ~i))
                                    (push! (mut arms)
                                           `(~(sym (qualified (mut k)
                                                              module
                                                              (get (.variants e)
                                                                   i))))))
                                  `(let [i (rt/take-varint r)]
                                     (cond ~@arms :else
                                           (panic "the cache has variant {} of an enum with fewer"
                                                  i))))
                              (= kind "record")
                                (let [r
                                        (match (find-rec mo (type-name t))
                                          (Some [r] r)
                                          (None []
                                                (panic "rules: no record {}" t)))
                                      (mut binds) (primitive/code-list-new)
                                      (mut inits) (primitive/code-list-new)]
                                  (for f (.fields r)
                                    (let [v (fresh (mut k) "f")]
                                      (push! (mut binds) (sym v))
                                      (push! (mut binds)
                                             (dec-code (mut k) (.ty f)))
                                      (push! (mut inits)
                                             (primitive/code-symbol ":"
                                                                    (.name f)))
                                      (push! (mut inits) (sym v))))
                                  `(let [~@binds]
                                     ~(record-value (mut k) t
                                        `(~(sym (qualified (mut k) module (type-name t))) ~@inits))))
                              :else
                                (shared-dec (mut k)
                                            t
                                            `(~(sym (qualified (mut k)
                                                               module
                                                               (cat "persist-decode-"
                                                                    (type-name t)))) r)))))]
        (push! (mut (.aux k))
               `(defn ~(sym name) [(r (ptr rt/Reader))] (-> ~ty)
                  ~body))))
    (sym name)))

;;; A memo's answers, for the cache. A save writes each answer new since the last (or every one,
;;; when the log is written whole): its arguments and answer as data, and in the index its key, node
;;; and where the data is. Reading the index notes where each is; an answer is read when its key is
;;; first asked for. A memo whose keys hold where trees are writes no key: its arguments are read when
;;; it is first used, and its keys made again from them, and its nodes' texts to match.
(defn memo-persist-code [(k (mut Comp)) (f Func) (name (slice u8))] (-> Code)
  (let [store (sym (cat "MemoStore--" name))
        store-fn (sym (cat "memo-store--" name))
        whole-fn (sym (cat "memo-whole--" name))
        args-ty (sym (cat "MemoArgs--" name))
        save (sym (cat "memo-save--" name))
        load-index (sym (cat "memo-load--" name))
        prepare (sym (cat "memo-prepare--" name))
        fault (sym (cat "memo-fault--" name))
        fault-slow (sym (cat "memo-fault-slow--" name))
        force (sym (cat "memo-force--" name))
        qname (cat3 (.self k) "." name)
        keyty (coil-type (mut k) (memo-key-type f))
        int-key (= (memo-key-type f) "Int")
        tree (tree-keyed? (mut k) f)
        key-text (if int-key `(rt/num-text key) `key)
        number (kept-number (mut k) name)
        ;; Whether this run's mechanism for it saves its answers (`store memory disk`).
        disk (if (>= number 0) `(rt/kept-disk? ~number) `true)
        ;; One kept while no input changes is marked by any change, as it is read back too.
        any-change
          (if (>= number 0)
              `(let [c (rt/kept-check ~number)] (or (= c 1) (>= c 3)))
              `false)
        ;; Whether the answer for `key` is saved, as the run's `store … by` says.
        stored
          (if (>= number 0) `(~(sym (cat "memo-stored?--" name)) s key) `true)
        (mut puts) (primitive/code-list-new)
        (mut binds) (primitive/code-list-new)
        (mut inits) (primitive/code-list-new)]
    (for i (range 0 (len (.params f)))
      (let [ty (.ty (get (.params f) i))
            field (cat "memo-arg-" (rt/num-text i))]
        (push! (mut puts)
               (enc-code (mut k) ty `(~(primitive/code-symbol "." field) a)))
        (push! (mut binds) (memo-arg i))
        (push! (mut binds) (dec-code (mut k) ty))
        (push! (mut inits) (primitive/code-symbol ":" field))
        (push! (mut inits) (memo-arg i))))
    `(do
       (defn ~save [(w (ptr rt/Writer)) (x (ptr rt/Writer)) (full bool)]
         (-> void)
         (let [s (~whole-fn)
               (mut keys) (ArrayList::new [~keyty] (malloc-allocator))]
           (when (and full (or (> (len (.lazy s)) 0) (> (len (.pending s)) 0)))
             (panic "memo fn {} is written whole with answers still unread"
                    ~name))
           (cond (not ~disk) 0
                 full (for key (.table (.main s)) (when ~stored (push! (mut keys) key)))
                 :else
                   (for key (.dirty s)
                     (match (get (.table (.main s)) key)
                       (Some [_] (when ~stored (push! (mut keys) key)))
                       (None [] 0))))
           (rt/put-varint! x (len keys))
           (for key keys
             (match (get (.args s) key)
               (Some [a]
                     (do
                       ~(if tree
                            `0
                            (if int-key
                                `(rt/put-int! x key)
                                `(rt/put-text! x key)))
                       (match (get (.node-ids s) key)
                         (Some [id]
                               (do
                                 (rt/put-int! x id)
                                 (rt/put-varint! x (rt/writer-at w))
                                 ;; Its `check by` version, read back with the index.
                                 (rt/put-text! x (rt/version-of id))))
                         (None []
                               (panic "memo fn {} kept arguments with no node"
                                      ~name)))
                       ~@puts
                       (match (get (.table (.main s)) key)
                         (Some [answer] ~(enc-code (mut k) (.ret f) `answer))
                         (None []
                               (panic "memo fn {} kept arguments with no answer"
                                      ~name)))))
               (None []
                     (panic "memo fn {} kept an answer with no arguments" ~name))))
           ;; The last answer's arguments, when its answer is saved, for an `update by` function in
           ;; the next run (see `memo-last--`).
           (let [last-saved
                   (and (.has-last s)
                        ~disk
                        ~(if tree `false `true)
                        (match (get (.table (.main s)) (.last-key s))
                          (Some [_]
                                ~(if (>= number 0)
                                     `(~(sym (cat "memo-stored?--" name)) s
                                         (.last-key s))
                                     `true))
                          ;; Read from the cache and not asked for since: saved already.
                          (None []
                                (match (get (.lazy s) (.last-key s))
                                  (Some [_] true)
                                  (None [] false)))))]
             (rt/put-bool! x last-saved)
             (when last-saved
               ~(if tree
                    `0
                    (if int-key
                        `(rt/put-int! x (.last-key s))
                        `(rt/put-text! x (.last-key s))))))
           (HashMap::clear! (mut (.dirty s))))
         0)
       (defn ~load-index [(r (ptr rt/Reader))] (-> void)
         (let [s (~store-fn)
               n (rt/take-varint r)]
           ~(if tree
                `(do
                   (when (> n 0) (rt/memo-pending-name! ~qname))
                   (for _ (range 0 n)
                     (let [id (rt/take-int r)
                           at (rt/take-varint r)]
                       (rt/version-set! id (rt/take-text r))
                       (when ~any-change (rt/dep-any-change-node! id))
                       (push! (mut (.pending s)) id)
                       (push! (mut (.pending s)) at))))
                `(for _ (range 0 n)
                   (let [key ~(if int-key `(rt/take-int r) `(rt/take-text r))
                         id (rt/take-int r)
                         at (rt/take-varint r)]
                     (rt/version-set! id (rt/take-text r))
                     (when ~any-change (rt/dep-any-change-node! id))
                     (set! (mut (.lazy s)) key at)
                     (set! (mut (.node-ids s)) key id)
                     (rt/dep-claim! id))))
           (when (rt/take-bool r)
             ~(if tree
                  `(panic "memo fn {} saved a last answer by a key that holds trees"
                          ~name)
                  `(do
                     ~(if int-key
                          `(set! (.last-key s) (rt/take-int r))
                          `(rt/last-key-set! (field s last-key) (rt/take-text r)))
                     (set! (.has-last s) true)))))
         0)
       ;; A memo whose keys hold trees: each answer's arguments read, its key made, its node's text
       ;; made to match. Once, when first used.
       (defn ~prepare [(s (ptr ~store))] (-> i64)
         ~(if tree
              `(let [word (cast (ptr i64) s)]
                 (rt/spin-lock! word)
                 (let [pending (len (.pending s))]
                   (rt/spin-unlock! word)
                   (when (> pending 0)
                     (rt/cache-lock!)
                     (rt/spin-lock! word)
                     (let [todo (.pending s)]
                       (rt/spin-unlock! word)
                       (when (> (len todo) 0)
                         (let [r (rt/the-reader)]
                           (for i (range 0 (/ (len todo) 2))
                             (let [id (get todo (* 2 i))
                                   at (get todo (+ (* 2 i) 1))]
                               (rt/reader-seek! r at)
                               (let [~@binds key
                                     ~(memo-key-code (mut k) f) answer-at
                                     (.at r)]
                                 (rt/reader-return! r)
                                 (rt/spin-lock! word)
                                 (set! (mut (.lazy s)) key answer-at)
                                 (set! (mut (.args s))
                                       key
                                       ~(if (= (len (.params f)) 0)
                                            `(zeroed ~args-ty)
                                            `(~args-ty ~@inits)))
                                 (set! (mut (.node-ids s)) key id)
                                 (rt/spin-unlock! word)
                                 (rt/dep-retext! id
                                                 (rt/memo-node ~qname ~key-text))))))
                         (rt/spin-lock! word)
                         (set! (.pending s)
                               (ArrayList::new [i64] (malloc-allocator)))
                         (rt/spin-unlock! word)
                         (rt/dep-unclaimed-of! ~qname)))
                     (rt/cache-unlock!))))
              `0)
         0)
       ;; An answer the cache holds and this run has not read, read now that it is asked for.
       (defn ~fault [(s (ptr ~store)) (key ~keyty)] (-> i64)
         (~prepare s)
         (let [word (cast (ptr i64) s)]
           (rt/spin-lock! word)
           (let [lazy
                   (match (get (.lazy s) key) (Some [_] true) (None [] false))]
             (rt/spin-unlock! word)
             (when lazy (~fault-slow s key))))
         0)
       (defn ~fault-slow [(s (ptr ~store)) (key ~keyty)] (-> void)
         (rt/cache-lock!)
         (let [word (cast (ptr i64) s)
               r (rt/the-reader)]
           (rt/spin-lock! word)
           (let [found (get (.lazy s) key)]
             (rt/spin-unlock! word)
             (match found
               (Some [at]
                     (do
                       (rt/reader-seek! r at)
                       ;; Read into regions of their own while the run reclaims memory: the
                       ;; arguments into the key's, the answer into the answer's, which the table
                       ;; holds from then on.
                       ~(if tree
                            `(let [answer-region (rt/answer-region-open! ~name)
                                   answer ~(dec-code (mut k) (.ret f))
                                   closed (rt/answer-region-close! answer-region)]
                               (rt/reader-return! r)
                               (rt/spin-lock! word)
                               (set! (mut (.table (.main s))) key answer)
                               (when (!= answer-region 0)
                                 (match (get (.regions s) key) (Some [old] (rt/region-release-id! old)) (None [] 0))
                                 (set! (mut (.regions s)) key answer-region))
                               (HashMap::remove! (mut (.lazy s)) key)
                               (rt/spin-unlock! word))
                            `(let [entered (rt/keys-region-enter! (field s keys-region) word)
                                   ~@binds
                                   left (rt/keys-region-leave! entered)
                                   answer-region (rt/answer-region-open! ~name)
                                   answer ~(dec-code (mut k) (.ret f))
                                   closed (rt/answer-region-close! answer-region)]
                               (rt/reader-return! r)
                               (rt/spin-lock! word)
                               (set! (mut (.args s))
                                     key
                                     ~(if (= (len (.params f)) 0)
                                          `(zeroed ~args-ty)
                                          `(~args-ty ~@inits)))
                               (set! (mut (.table (.main s))) key answer)
                               (when (!= answer-region 0)
                                 (match (get (.regions s) key) (Some [old] (rt/region-release-id! old)) (None [] 0))
                                 (set! (mut (.regions s)) key answer-region))
                               (HashMap::remove! (mut (.lazy s)) key)
                               (rt/spin-unlock! word)))
                       0))
               (None [] 0))))
         (rt/cache-unlock!)
         0)
       ;; Every answer the cache holds read, before the log is written whole.
       (defn ~force [] (-> void)
         (let [s (~whole-fn)
               word (cast (ptr i64) s)]
           (~prepare s)
           (rt/spin-lock! word)
           (let [(mut keys) (ArrayList::new [~keyty] (malloc-allocator))]
             (for key (.lazy s) (push! (mut keys) key))
             (rt/spin-unlock! word)
             (for key keys (~fault-slow s key))))
         0))))

;;; A module's part of the cache: first the parts of the modules it uses, each once, then its own.
;;; A save writes each setting given a value since the last (whether it has one, and the value),
;;; every state, and its memos' new answers; reading the index notes where each setting is, reads
;;; the states, and notes where its memos' answers are. A setting is read when first used: each is
;;; reached through its own function, which reads it first if it must (`setting-state--NAME`).
(defn compile-persist [(k (mut Comp)) (decls (ArrayList g/Node))] (-> Code)
  (let [self (self-mod (mut k))
        name (.self k)
        (mut others-save) (primitive/code-list-new)
        (mut others-load) (primitive/code-list-new)
        (mut others-force) (primitive/code-list-new)
        (mut puts) (primitive/code-list-new)
        (mut gets) (primitive/code-list-new)
        (mut forces) (primitive/code-list-new)
        (mut accessors) (primitive/code-list-new)]
    (for m (.mods k)
      (when (and (= (.sort m) (SRules))
                 (!= (.name m) name)
                 (!= (.name m) "hl.prelude")
                 (not (has-text? (.sig-only k) (.name m))))
        (push! (mut others-save)
               `(~(sym (qualified (mut k) (.name m) "persist-save!")) w x full))
        (push! (mut others-load)
               `(~(sym (qualified (mut k) (.name m) "persist-load!")) r))
        (push! (mut others-force)
               `(~(sym (qualified (mut k) (.name m) "persist-force!"))))))
    (for d decls
      (when (or (= (.kind d) (g/KSetting)) (= (.kind d) (g/KState)))
        (let [g-name (.text (kid d 0))
              x
                (match (find-global self g-name)
                  (Some [v] v)
                  (None [] (die (mut k) d "this was not collected")))
              field (primitive/code-symbol "." g-name)]
          (when (not (.task x))
            (if (= (.kind d) (g/KSetting))
                (let [bound (primitive/code-symbol "." (bound-field g-name))
                      lazy (primitive/code-symbol "." (lazy-field g-name))
                      lazy-name (sym (lazy-field g-name))
                      dirty (primitive/code-symbol "." (dirty-field g-name))
                      accessor (sym (cat "setting-state--" g-name))
                      forcer (sym (cat "setting-force--" g-name))]
                  (push! (mut accessors)
                         `(defn ~accessor [] (-> (ptr RulesState))
                            (let [st (rules-settings)]
                              (when (> (atomic/read (field st ~lazy-name)) 0)
                                (~forcer st))
                              st)))
                  (push! (mut accessors)
                         `(defn ~forcer [(st (ptr RulesState))] (-> void)
                            (rt/cache-lock!)
                            (let [at (atomic/read (field st ~lazy-name))]
                              (when (> at 0)
                                (let [r (rt/the-reader)
                                      made-in (rt/answer-region-open! ~(cat "load " g-name))]
                                  (rt/reader-seek! r (- at 1))
                                  (set! (~field st) ~(dec-code (mut k) (.ty x)))
                                  (rt/answer-region-close! made-in)
                                  (rt/region-release-id! (~(primitive/code-symbol "." (region-field g-name)) st))
                                  (set! (~(primitive/code-symbol "." (region-field g-name)) st) made-in)
                                  (rt/reader-return! r)
                                  (atomic/store (field st ~lazy-name) 0))))
                            (rt/cache-unlock!)
                            0))
                  (push! (mut puts)
                         `(if (or full (> (~dirty st) 0))
                              (let [given
                                      (or (> (~bound st) 0)
                                          (> (~(primitive/code-symbol "."
                                                                      (held-field g-name)) st)
                                             0))]
                                (when (> (atomic/read (field st ~lazy-name)) 0)
                                  (panic "setting {} is written while still unread"
                                         ~g-name))
                                (rt/put-bool! x true)
                                (rt/put-bool! x given)
                                (rt/put-bool! x (> (~bound st) 0))
                                (rt/put-varint! x (rt/writer-at w))
                                (when given
                                  ~(enc-code (mut k) (.ty x) `(~field st)))
                                (set! (~dirty st) 0))
                              (rt/put-bool! x false)))
                  (push! (mut gets)
                         `(when (rt/take-bool r)
                            (let [given (rt/take-bool r)
                                  bound-then (rt/take-bool r)
                                  at (rt/take-varint r)]
                              (set! (~bound st) (if bound-then 1 0))
                              (set! (~(primitive/code-symbol "."
                                                             (held-field g-name)) st)
                                    (if given 1 0))
                              (set! (~dirty st) 0)
                              (atomic/store (field st ~lazy-name)
                                            (if given (+ at 1) 0)))))
                  (push! (mut forces) `(~accessor)))
                (do
                  (push! (mut puts)
                         `(do
                            (rt/put-varint! x (rt/writer-at w))
                            ~(enc-code (mut k) (.ty x) `(~field st))))
                  (push! (mut gets)
                         `(let [at (rt/take-varint r)]
                            (rt/reader-seek! r at)
                            (rt/state-region-enter!)
                            (set! (~field st) ~(dec-code (mut k) (.ty x)))
                            (rt/region-leave!)
                            (rt/reader-return! r)))))))))
    (for d decls
      (when (= (.kind d) (g/KMemoFn))
        (push! (mut puts) `(rt/put-part! w ~(cat3 name "." (.text (kid d 0)))))
        (push! (mut puts)
               `(~(sym (cat "memo-save--" (.text (kid d 0)))) w x full))
        (push! (mut gets) `(~(sym (cat "memo-load--" (.text (kid d 0)))) r))
        (push! (mut forces) `(~(sym (cat "memo-force--" (.text (kid d 0))))))))
    `(do
       ~@accessors
       (defn persist-save! [(w (ptr rt/Writer)) (x (ptr rt/Writer)) (full bool)]
         (-> void)
         (when (rt/put-module! x ~name)
           ~@others-save
           (rt/put-part! w ~(cat name " settings and states"))
           (rt/put-mark! x ~name)
           (let [st (rules-state)]
             ~@puts
             0))
         0)
       (defn persist-load! [(r (ptr rt/Reader))] (-> void)
         (when (rt/take-module! r ~name)
           ~@others-load
           (rt/take-mark! r ~name)
           (let [st (rules-state)]
             ~@gets
             0))
         0)
       (defn persist-force! [] (-> void)
         (when (rt/force-module! ~name)
           ~@others-force
           ~@forces
           0)
         0))))

(defn lazy-field [(name (slice u8))] (-> (slice u8))
  (cat name "--lazy"))

;;; Whether a setting holds a value given it, bound now or not: what the next value given it is
;;; compared with, and what it reads where no binding gives it one (see `input-read`). A `with` that
;;; ends where no outer one gives the setting a value leaves its own there, held, so the next
;;; build's `with` changes only what differs from it.
(defn held-field [(name (slice u8))] (-> (slice u8))
  (cat name "--held"))

(defn dirty-field [(name (slice u8))] (-> (slice u8))
  (cat name "--dirty"))

;;; The region a setting's value was made in, which the setting holds while its value is given
;;; or held; 0 for one that lives as long as the program.
(defn region-field [(name (slice u8))] (-> (slice u8))
  (cat name "--region"))

;;; A function a stage makes is made there, and read after: asked for at once by many threads, its
;;; answer is there already, or the pipeline is wrong (see `makes`), which this says rather than make
;;; it, there, with what making it may do. One of a stage's own functions is made by many threads at
;;; once, in that stage.
(defn made-check [(k (mut Comp)) (name (slice u8))] (-> Code)
  (if (and (has-text? (.made k) (cat3 (.self k) "/" name))
           (not (has-text? (.staged k) (cat3 (.self k) "/" name))))
      `(when (rt/in-parallel?)
         (panic "{}: a stage makes this, and many threads at once asked for it before it was made"
                ~(cat3 (.self k) "/" name)))
      `0))

;;; A kept function's functions for one part of how strategies keep it (see `Hooks`).
(defn hook-fns [(k (mut Comp)) (name (slice u8)) (role i64)]
  (-> (ArrayList (slice u8)))
  (let [full (cat3 (.self k) "/" name)
        (mut fns) (text-list)]
    (for h (.hooks k)
      (when (and (= (.key h) full) (= (.role h) role)) (set! fns (.fns h))))
    fns))

;;; The calls of a kept function's functions for one part of how strategies keep it (role 0 store,
;;; 1 check, 2 cutoff, 3 evict; see `Hooks`), as `cond` arms: the i-th when `sel` is `base` + i.
;;; Each must take `want` and answer `ret`; it is called with `args`.
(defn hook-arms [(k (mut Comp))
                 (d g/Node)
                 (name (slice u8))
                 (role i64)
                 (base i64)
                 (sel Code)
                 (want (ArrayList (slice u8)))
                 (ret (slice u8))
                 (args CodeBuilder)] (-> CodeBuilder)
  (let [full (cat3 (.self k) "/" name)
        what
          (cond (= role 0) "store by "
                (= role 1) "check by "
                (= role 2) "cutoff by "
                (= role 3) "evict by "
                :else "update by ")
        fns (hook-fns (mut k) name role)
        (mut arms) (primitive/code-list-new)]
    (for i (range 0 (len fns))
      (let [hook (get fns i)
            slash (rt/name-end-at hook 47)
            module (subslice hook 0 slash)
            fname (subslice hook (+ slash 1) (len hook))
            g
              (match (find-func (mod-at (mut k) module) fname)
                (Some [g] g)
                (None [] (die (mut k) d (cat3 what "no function named " hook))))]
        (unless (= (.ret g) ret)
          (die (mut k)
               d
               (cat4 what hook (cat ": it answers " ret) (cat ", for " full))))
        (unless (and (= (len (.params g)) (len want))
                     (let [(mut same) true]
                       (for j (range 0 (len want))
                         (unless (= (.ty (get (.params g) j)) (get want j))
                           (set! same false)))
                       same))
          (die (mut k)
               d
               (cat4 what
                     hook
                     (cat ": it takes " (rt/joined want ", "))
                     (cat ", for " full))))
        (push! (mut arms) `(= ~sel ~(+ base i)))
        (push! (mut arms)
               (if (= module (.self k))
                   `(~(sym (.coil g)) ~@args)
                   ;; Through its registered value: its module is not imported (see `sig-only`).
                   `(let [hook-fn
                            (load (cast (ptr ~(coil-type (mut k) (func-type g)))
                                        (rt/hook-cell ~hook
                                                      (primitive/alloc-static i64))))]
                      (hook-fn ~@args))))))
    arms))

;;; `register-hooks!`: each function of this module a strategy names for a kept function (`… by F`)
;;; registered by name as its value, for the code it serves to call through `rt/hook-cell`. The
;;; pipeline's `use-strategy!` calls it.
(defn register-hooks-code [(k (mut Comp)) (name (slice u8))] (-> Code)
  (let [(mut done) (text-list)
        (mut regs) (primitive/code-list-new)]
    (for h (.hooks k)
      (for hook (.fns h)
        (let [slash (rt/name-end-at hook 47)
              module (subslice hook 0 slash)
              fname (subslice hook (+ slash 1) (len hook))]
          (when (and (= module name) (not (has-text? done hook)))
            (push! (mut done) hook)
            (match (find-func (self-mod (mut k)) fname)
              (Some [g]
                    (push! (mut regs)
                           `(rt/hook-register! ~hook
                                               (let [(mut v)
                                                       ~(fn-value (mut k)
                                                                  `(fnptr-of ~(sym (.coil g)))
                                                                  g)]
                                                 (load (cast (ptr i64) (mut v)))))))
              (None []
                    (panic "rules: the strategy names {}, and {} has no such function"
                           hook
                           name)))))))
    `(defn register-hooks! [] (-> void)
       ~@regs
       0)))

;;; The types of a kept function's parameters.
(defn param-types [(f Func)] (-> (ArrayList (slice u8)))
  (let [(mut out) (text-list)]
    (for p (.params f) (push! (mut out) (.ty p)))
    out))

;;; A kept function's version, as the run's `check by` function for it gives it (see `check by` in the
;;; pipeline language): the i-th of its check functions when its check is 3 + i, else "".
(defn check-version-code [(k (mut Comp)) (d g/Node) (f Func) (name (slice u8))]
  (-> Code)
  (let [(mut args) (primitive/code-list-new)]
    (for i (range 0 (len (.params f))) (push! (mut args) (memo-arg i)))
    (let [arms (hook-arms (mut k) d name 1 3 `check (param-types f) "Text" args)]
      (if (= (len (hook-fns (mut k) name 1)) 0) `"" `(cond ~@arms :else "")))))

;;; Whether an answer made again counts as the one it replaces, as the run's cutoff for the function
;;; says: never (0), when equal (1), when its `cutoff by` function says (2 + i).
(defn cutoff-code [(k (mut Comp))
                   (d g/Node)
                   (f Func)
                   (name (slice u8))
                   (old Code)
                   (fresh Code)] (-> Code)
  (let [(mut want) (text-list)
        (mut args) (primitive/code-list-new)]
    (push! (mut want) (.ret f))
    (push! (mut want) (.ret f))
    (push! (mut args) old)
    (push! (mut args) fresh)
    (let [arms (hook-arms (mut k) d name 2 2 `cutoff want "Bool" args)]
      `(cond (= cutoff 1) ~(same-code (mut k) (.ret f) old fresh)
             ~@arms :else
             false))))

;;; An answer made from the last (`update by`) holds what it shares with it: a database, exactly its
;;; relations (each a region of its own), so the last is let go once replaced, but for those; any
;;; other value, the last's whole region.
(defn update-holds [(k (mut Comp)) (f Func) (name (slice u8))] (-> Code)
  (if (= (persist-kind (mut k) (.ret f)) "db")
      `(~(sym (qualified (mut k) (type-module (.ret f)) "regions-held!")) made)
      `(rt/region-uses-id! (~(sym (cat "memo-last-region--" name)) s))))

;;; An answer made: by the run's `update by` function for it from the arguments and the last answer
;;; made, when it has one and there is a last answer; else computed as written.
(defn made-code [(k (mut Comp)) (d g/Node) (f Func) (name (slice u8))] (-> Code)
  (let [compute (sym (cat "memo-compute--" name))
        (mut args) (primitive/code-list-new)
        (mut call) (primitive/code-list-new)
        (mut want) (param-types f)]
    (for i (range 0 (len (.params f)))
      (push! (mut args) (memo-arg i))
      (push! (mut call) (memo-arg i)))
    (push! (mut call) `last)
    (push! (mut want) (.ret f))
    (let [arms (hook-arms (mut k) d name 4 0 `update want (.ret f) call)]
      (if (= (len (hook-fns (mut k) name 4)) 0)
          `(~compute ~@args)
          `(match (if (>= update 0)
                      (~(sym (cat "memo-last--" name)) s)
                      (None [~(coil-type (mut k) (.ret f))]))
             (Some [last]
                   (let [made (cond ~@arms :else (~compute ~@args))]
                     ~(update-holds (mut k) f name)
                     made))
             (None [] (~compute ~@args)))))))

;;; A value's own copy, in the region values go to now: numbers and truths as they are, a text's
;;; bytes copied, anything else written and read back (the cache's own code for it), so the copy
;;; points at nothing the original does.
(defn own-code [(k (mut Comp)) (t (slice u8)) (v Code)] (-> Code)
  (cond (or (= t "Int") (= t "Bool") (= t "Float")) v
        (= t "Text") `(rt/text-copy ~v)
        :else
          `(let [w (rt/copy-writer-new)]
             ~(enc-code (mut k) t v)
             (let [r (rt/copy-reader w)
                   copied ~(dec-code (mut k) t)]
               (rt/copy-reader-done! r)
               copied))))

;;; A value out of scratch storage (see "values out of scratch storage" in hl.rt): its own copy,
;;; where values go now, of whatever part of it lies in scratch region `from` (in any, for
;;; `(rt/any-scratch)`), sharing the rest. Numbers, truths and functions are as they are.
(defn own-in-code [(k (mut Comp)) (t (slice u8)) (v Code) (from Code)] (-> Code)
  (cond (or (= t "Int") (= t "Bool") (= t "Float") (fn? t)) v
        (= t "Text") `(rt/text-own-in ~from ~v)
        (opt? t)
          (let [x (fresh (mut k) "x")]
            `(match ~v
               (Some [~(sym x)] (Some ~(own-in-code (mut k) (opt-of t) (sym x) from)))
               (None [] (None [~(coil-type (mut k) (opt-of t))]))))
        :else `(~(own-in-helper (mut k) t) ~from ~v)))

;;; Whether a value of type `t` can hold anything in scratch storage at all.
(defn own-in-plain? [(t (slice u8))] (-> bool)
  (or (= t "Int") (= t "Bool") (= t "Float") (fn? t)))

(defn own-in-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (persist-name "ownin--" t)
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (let [body
              (cond (list? t)
                      `(if (rt/storage-in? from (rt/list-storage v) (cap v))
                           ;; Reached before in this copy: the same list again. A short list
                           ;; of numbers is as cheap to copy again as to look up.
                           (let [noted ~(if (own-in-plain? (elem-of t)) `(>= (len v) 64) `true)
                                 seen (if noted (rt/own-seen (rt/list-storage v)) (primitive/cast (ptr u8) 0))]
                             (if (and (!= (primitive/cast i64 seen) 0)
                                      (= (len (load (primitive/cast (ptr ~ty) seen))) (len v)))
                                 (load (primitive/cast (ptr ~ty) seen))
                                 (let [(mut out) ~(new-list (mut k) (elem-of t))]
                                   (reserve! (mut out) (len v))
                                   (for e v (push! (mut out) ~(own-in-code (mut k) (elem-of t) `e `from)))
                                   (when noted
                                     (rt/own-keep! (rt/list-storage v) (primitive/cast (ptr u8) (mut out)) (sizeof ~ty)))
                                   out)))
                           v)
                    (map? t)
                      `(if (rt/storage-in? from (rt/map-storage v) (rt/map-capacity v))
                           (let [seen (rt/own-seen (rt/map-storage v))]
                             (if (!= (primitive/cast i64 seen) 0)
                                 (load (primitive/cast (ptr ~ty) seen))
                                 (let [(mut out)
                                         ~(if (and (own-in-plain? (map-key t)) (own-in-plain? (map-val t)))
                                              ;; Nothing in it to copy but the map itself: its slots whole.
                                              `(rt/map-copy-plain v (rt/value-allocator))
                                              `(let [(mut made) ~(new-map (mut k) t)]
                                                 ;; As much room as the first has, at once: a map
                                                 ;; that grows leaves each smaller table behind.
                                                 (when (> (rt/map-capacity v) 0)
                                                   (HashMap::grow! (mut made) (rt/map-capacity v)))
                                                 (for key v
                                                   (match (get v key)
                                                     ;; A Text key is copied by the map that takes it.
                                                     (Some [x] (set! (mut made) key ~(own-in-code (mut k) (map-val t) `x `from)))
                                                     (None [] (panic "a map lost a key while it was copied"))))
                                                 made))]
                                   (rt/own-keep! (rt/map-storage v) (primitive/cast (ptr u8) (mut out)) (sizeof ~ty))
                                   out)))
                           v)
                    :else
                      (let [kind (persist-kind (mut k) t)
                            module (type-module t)
                            mo (mod-at (mut k) module)]
                        (cond (= kind "node")
                                `(~(sym (qualified (mut k) module "node-own-in")) from v)
                              ;; A database's relations keep their own memory; a fact and an
                              ;; enum's value are numbers.
                              (or (= kind "db") (= kind "fact") (= kind "enum")) `v
                              (= kind "record")
                                (let [r
                                        (match (find-rec mo (type-name t))
                                          (Some [r] r)
                                          (None [] (panic "rules: no record {}" t)))
                                      (mut inits) (primitive/code-list-new)]
                                  (for f (.fields r)
                                    (push! (mut inits) (primitive/code-symbol ":" (.name f)))
                                    (push! (mut inits)
                                           (own-in-code (mut k)
                                                        (.ty f)
                                                        `(~(primitive/code-symbol "." (.name f)) v)
                                                        `from)))
                                  (let [made `(~(sym (qualified (mut k) module (type-name t))) ~@inits)]
                                    (if (boxed-record? (mut k) t)
                                        ;; A boxed record outside scratch storage holds nothing in it.
                                        `(if (rt/scratch-holds? from (primitive/cast i64 v))
                                             (let [seen (rt/own-seen (primitive/cast i64 v))]
                                               (if (!= (primitive/cast i64 seen) 0)
                                                   (load (primitive/cast (ptr ~ty) seen))
                                                   (let [(mut boxed) ~(record-value (mut k) t made)]
                                                     (rt/own-keep! (primitive/cast i64 v)
                                                                   (primitive/cast (ptr u8) (mut boxed))
                                                                   (sizeof ~ty))
                                                     boxed)))
                                             v)
                                        made)))
                              :else
                                `(~(sym (qualified (mut k)
                                                   module
                                                   (cat "apart-own-" (type-name t)))) from
                                    v))))]
        (push! (mut (.aux k))
               `(defn ~(sym name) [(from (ptr rt/Region)) (v ~ty)] (-> ~ty)
                  ~body))))
    (sym name)))

(defn compile-memo! [(k (mut Comp)) (d g/Node) (out (mut str/StrBuf))] (-> void)
  (let [f (memo-check! (mut k) d)
        name (.text (kid d 0))
        mt (memo-map-type f)
        store (sym (cat "MemoStore--" name))
        store-fn (sym (cat "memo-store--" name))
        whole-fn (sym (cat "memo-whole--" name))
        part (sym (cat "MemoPart--" name))
        front-fn (sym (cat "memo-front--" name))
        settle (sym (cat "memo-settle--" name))
        forgotten (sym (cat "memo-forgotten--" name))
        compute (cat "memo-compute--" name)
        ensure (sym (cat "memo-ensure--" name))
        ;; A function a strategy keeps is kept only in a run whose strategy does: `entry` is the
        ;; kept one, and `name` asks which (see `rt/kept?`).
        number (kept-number (mut k) name)
        entry (if (>= number 0) (sym (cat "memo-kept--" name)) (sym name))
        version-code (check-version-code (mut k) d f name)
        same-now (cutoff-code (mut k) d f name `old `fresh)
        made-code (made-code (mut k) d f name)
        near (primitive/code-symbol "." (memo-near name))
        near-gen (primitive/code-symbol "." (memo-near-gen name))
        near-rev (primitive/code-symbol "." (memo-near-rev name))
        near-regions (primitive/code-symbol "." (memo-near-regions name))
        qname (cat3 (.self k) "." name)
        key-text (if (= (memo-key-type f) "Int") `(rt/num-text key) `key)
        (mut params) (primitive/code-list-new)
        (mut args) (primitive/code-list-new)
        (mut arg-fields) (primitive/code-list-new)
        (mut arg-inits) (primitive/code-list-new)
        (mut stored) (primitive/code-list-new)
        args-ty (sym (cat "MemoArgs--" name))
        rt (coil-type (mut k) (.ret f))]
    (for i (range 0 (len (.params f)))
      (push! (mut params)
             `(~(memo-arg i) ~(coil-type (mut k) (.ty (get (.params f) i)))))
      (push! (mut args) (memo-arg i))
      (push! (mut arg-fields)
             `(~(memo-arg i) ~(coil-type (mut k) (.ty (get (.params f) i)))))
      (push! (mut arg-inits)
             (primitive/code-symbol ":" (cat "memo-arg-" (rt/num-text i))))
      (push! (mut arg-inits) (memo-arg i))
      (push! (mut stored)
             `(~(primitive/code-symbol "." (cat "memo-arg-" (rt/num-text i))) a)))
    (if (>= (apart-number (mut k) name) 0)
        (compile-apart! (mut k) d compute (apart-number (mut k) name) (mut out))
        (emit! (mut out) (compile-fn-as (mut k) d compute)))
    ;; The lock word comes first, so the store's address is the word's.
    (emit! (mut out)
           `(defstruct ~args-ty [~@arg-fields]))
    ;; Answers and who is making which, under a lock of their own. A store has one such part for
    ;; all of its answers (`main`, under the store's lock), and, in a run that only makes answers
    ;; and reads them (see `simple` in the entry), many: each key's answer in the part its hash
    ;; picks, so threads asking for different keys seldom wait for each other. Whatever reads a
    ;; store whole first has the many put back into the one (`memo-settle--`).
    (emit! (mut out)
           `(defstruct ~part
              [(lock i64)
               (table ~(memo-storage-type (mut k) f))
               (busy ~(coil-type (mut k) (memo-busy-type f)))]))
    (emit! (mut out)
           `(defstruct ~store
              [(lock i64)
               (ready bool)
               (gen i64)
               (main ~part)
               ;; The many parts; whether they are made (see `rt/once-mine?`); whether any holds
               ;; an answer.
               (fronts (ArrayList (ptr ~part)))
               (fronts-made i64)
               (fronted i64)
               ;; Whether its answers are to be forgotten before the next is looked for.
               (stale i64)
               (args (HashMap ~(coil-type (mut k) (memo-key-type f)) ~args-ty))
               (node-ids (HashMap ~(coil-type (mut k) (memo-key-type f)) i64))
               ;; Answers the cache holds that this run has not read, by where their data is;
               ;; answers new since the last save; and, for a memo whose keys hold trees, the nodes
               ;; and data of answers whose keys are not made yet.
               (lazy (HashMap ~(coil-type (mut k) (memo-key-type f)) i64))
               (dirty (HashMap ~(coil-type (mut k) (memo-key-type f)) i64))
               (pending (ArrayList i64))
               ;; When each answer was last asked for, by `clock`: what an eviction bound lets go first.
               (uses ~(coil-type (mut k) (cat3 "{" (memo-key-type f) ":Int}")))
               (clock i64)
               ;; The arguments of the last answer made, for an `update by` function to make the next
               ;; from (see `memo-last--`).
               (last-key ~(coil-type (mut k) (memo-key-type f)))
               (has-last bool)
               ;; While the run reclaims memory: the region each answer was made in, which the
               ;; table holds; and the region its keys' arguments are copied into, which lasts as
               ;; long as the store, as its keys do.
               (regions (HashMap ~(coil-type (mut k) (memo-key-type f)) i64))
               (keys-region i64)]))
    (emit! (mut out)
           `(defstruct ~(sym (cat "MemoOwned--" name)) [(args ~args-ty)]))
    ;; A key's arguments, the store's own: copied into the store's region the first time the key is
    ;; computed, so an answer made from them points at nothing its caller made.
    (emit! (mut out)
           `(defn ~(sym (cat "memo-own--" name)) [(s (ptr ~store)) (key ~(coil-type (mut k) (memo-key-type f))) ~@params]
              (-> ~(sym (cat "MemoOwned--" name)))
              (let [word (cast (ptr i64) s)]
                (rt/spin-lock! word)
                (let [known (get (.args s) key)]
                  (rt/spin-unlock! word)
                  (match known
                    (Some [a] (~(sym (cat "MemoOwned--" name)) :args a))
                    (None []
                          (let [entered (rt/keys-region-enter! (field s keys-region) word)
                                a ~(if (= (len (.params f)) 0)
                                       `(zeroed ~args-ty)
                                       `(~args-ty ~@(let [(mut inits) (primitive/code-list-new)]
                                                      (for i (range 0 (len (.params f)))
                                                        (push! (mut inits)
                                                               (primitive/code-symbol ":" (cat "memo-arg-" (rt/num-text i))))
                                                        (push! (mut inits)
                                                               (own-code (mut k) (.ty (get (.params f) i)) (memo-arg i))))
                                                      inits)))]
                            (rt/keys-region-leave! entered)
                            (rt/spin-lock! word)
                            (set! (mut (.args s)) key a)
                            (rt/spin-unlock! word)
                            (~(sym (cat "MemoOwned--" name)) :args a))))))))
    ;; The last answer made, when there is one and the cache or the table still holds it.
    (emit! (mut out)
           `(defn ~(sym (cat "memo-last--" name)) [(s (ptr ~store))]
              (-> (Option ~(coil-type (mut k) (.ret f))))
              (let [word (cast (ptr i64) s)]
                (rt/spin-lock! word)
                (let [has (.has-last s)
                      key (.last-key s)]
                  (rt/spin-unlock! word)
                  (if has
                      (do
                        (~(sym (cat "memo-fault--" name)) s key)
                        (rt/spin-lock! word)
                        (let [found (get (.table (.main s)) key)]
                          (rt/spin-unlock! word)
                          found))
                      (None [~(coil-type (mut k) (.ret f))]))))))
    ;; The region the last answer made is in, or 0.
    (emit! (mut out)
           `(defn ~(sym (cat "memo-last-region--" name)) [(s (ptr ~store))] (-> i64)
              (let [word (cast (ptr i64) s)]
                (rt/spin-lock! word)
                (let [r (if (.has-last s)
                            (match (get (.regions s) (.last-key s)) (Some [r] r) (None [] 0))
                            0)]
                  (rt/spin-unlock! word)
                  r))))
    ;; An answer asked for by its node, as checking an answer that read it asks: its key from the
    ;; node's text, once the store has made its keys, and the arguments it was computed from, which
    ;; its store keeps.
    (emit! (mut out)
           `(defn ~ensure [(id i64)] (-> i64)
              (let [s (~whole-fn)
                    word (cast (ptr i64) s)
                    prepared (~(sym (cat "memo-prepare--" name)) s)
                    text (rt/dep-memo-key id)
                    key
                      ~(if (= (memo-key-type f) "Int")
                           `(rt/parse-int text)
                           `text)
                    unread
                      (do
                        (rt/spin-lock! word)
                        (let [l
                                (match (get (.lazy s) key)
                                  (Some [_] true)
                                  (None [] false))]
                          (rt/spin-unlock! word)
                          l))]
                ;; Checking an answer asks only whether it is current: one the cache holds and this
                ;; run has not read, all of whose inputs are unchanged, is, and stays unread. Only
                ;; an answer checked by its reads has them noted; any other the entry checks.
                (if (and unread
                         (or (rt/dep-current-id? id)
                             (and ~(if (>= (kept-number (mut k) name) 0)
                                       `(= (rt/kept-check ~(kept-number (mut k)
                                                                        name))
                                           0)
                                       `true)
                                  (rt/dep-still-id? id))))
                    0
                    (do
                      (~(sym (cat "memo-fault--" name)) s key)
                      (rt/spin-lock! word)
                      (let [found (get (.args s) key)]
                        (rt/spin-unlock! word)
                        (match found
                          (Some [a] (do (~entry ~@stored) 0))
                          (None []
                                (panic "memo fn {} has no arguments for {}"
                                       ~name
                                       text)))))))))
    ;; Its answers forgotten, when a setting it reads is given again while nothing is tracked:
    ;; said now (`stale`), and done when the store is next asked or read whole (`memo-forgotten--`),
    ;; so a build's last answers, which nothing asks for again, are not emptied one by one as its
    ;; settings are let go. A run that reclaims memory lets them go at once.
    (emit! (mut out)
           `(defn ~(sym (cat "memo-forget--" name)) [] (-> void)
              (let [s (~store-fn)]
                (atomic/store (field s stale) 1)
                (when (rt/reclaiming?) (~forgotten s)))
              0))
    (emit! (mut out)
           `(defn ~forgotten [(s (ptr ~store))] (-> void)
              (let [word (cast (ptr i64) s)]
                (rt/spin-lock! word)
                (when (!= (atomic/read (field s stale)) 0)
                  (for key (.regions s)
                    (match (get (.regions s) key) (Some [r] (rt/region-release-id! r)) (None [] 0)))
                  (free! (mut (.regions s)))
                  (set! (.regions s) ~(runtime-map (mut k) (memo-busy-type f)))
                  (free! (mut (.table (.main s))))
                  (set! (.table (.main s)) ~(memo-storage-new (mut k) f))
                  (free! (mut (.busy (.main s))))
                  (set! (.busy (.main s)) ~(runtime-map (mut k) (memo-busy-type f)))
                  ;; The many parts' answers go with the rest, not into the one first.
                  (when (!= (atomic/read (field s fronted)) 0)
                    (for h (.fronts s)
                      (rt/spin-lock! (cast (ptr i64) h))
                      (free! (mut (.table h)))
                      (set! (.table h) ~(memo-storage-new (mut k) f))
                      (free! (mut (.busy h)))
                      (set! (.busy h) ~(runtime-map (mut k) (memo-busy-type f)))
                      (rt/spin-unlock! (cast (ptr i64) h)))
                    (atomic/store (field s fronted) 0))
                  (set! (.gen s) (rt/next-pass!))
                  (atomic/store (field s stale) 0))
                (rt/spin-unlock! word))
              0))
    ;; The part of the many that holds `key`'s answer: picked by bits of its hash the part's own
    ;; table does not place it by.
    (emit! (mut out)
           `(defn ~front-fn [(s (ptr ~store)) (key ~(coil-type (mut k) (memo-key-type f)))] (-> (ptr ~part))
              (when (rt/once-mine? (field s fronts-made))
                (let [(mut all) (ArrayList::new [(ptr ~part)] (malloc-allocator))]
                  (for _ (range 0 (rt/memo-parts))
                    (let [h (coil.alloc/unwrap-ptr (coil.alloc/create [~part] (malloc-allocator)))]
                      (store! h
                              (~part :lock 0
                                     :table ~(memo-storage-new (mut k) f)
                                     :busy ~(runtime-map (mut k) (memo-busy-type f))))
                      (push! (mut all) h)))
                  (set! (.fronts s) all))
                (rt/once-made! (field s fronts-made)))
              (get (.fronts s)
                   (rt/memo-part-of ~(if (= (memo-key-type f) "Int")
                                         `(rt/memo-hash key)
                                         `(rt/text-hash key))))))
    ;; The many parts' answers put into the one, and the many left empty: before anything reads the
    ;; store whole, or makes answers in a way the many do not serve. Only while nothing asks.
    (emit! (mut out)
           `(defn ~settle [(s (ptr ~store))] (-> void)
              (when (!= (atomic/read (field s fronted)) 0)
                (let [word (cast (ptr i64) s)]
                  (rt/spin-lock! word)
                  (when (!= (atomic/read (field s fronted)) 0)
                    (for h (.fronts s)
                      (rt/spin-lock! (cast (ptr i64) h))
                      (for key (.table h)
                        (match (get (.table h) key)
                          (Some [v] (do (set! (mut (.table (.main s))) key v) 0))
                          (None [] 0)))
                      (free! (mut (.table h)))
                      (set! (.table h) ~(memo-storage-new (mut k) f))
                      (free! (mut (.busy h)))
                      (set! (.busy h) ~(runtime-map (mut k) (memo-busy-type f)))
                      (rt/spin-unlock! (cast (ptr i64) h)))
                    (atomic/store (field s fronted) 0))
                  (rt/spin-unlock! word)))
              0))
    (emit! (mut out)
           `(defn ~whole-fn [] (-> (ptr ~store))
              (let [s (~store-fn)]
                (when (!= (atomic/read (field s stale)) 0) (~forgotten s))
                (~settle s)
                s)))
    (emit! (mut out)
           `(defn ~store-fn [] (-> (ptr ~store))
              (let [s (primitive/alloc-static ~store)]
                (unless (.ready s)
                  (rt/init-lock!)
                  (unless (.ready s)
                    (set! (.table (.main s)) ~(memo-storage-new (mut k) f))
                    (set! (.args s)
                          ~(if (= (memo-key-type f) "Int")
                               `(HashMap::new [i64 ~args-ty]
                                              (malloc-allocator)
                                              (i64-keyops))
                               `(HashMap::new [(slice u8) ~args-ty]
                                              (malloc-allocator)
                                              (rt/memo-keyops))))
                    (set! (.node-ids s)
                          ~(if (= (memo-key-type f) "Int")
                               `(HashMap::new [i64 i64]
                                              (malloc-allocator)
                                              (i64-keyops))
                               `(HashMap::new [(slice u8) i64]
                                              (malloc-allocator)
                                              (rt/memo-keyops))))
                    (set! (.busy (.main s)) ~(runtime-map (mut k) (memo-busy-type f)))
                    (set! (.lazy s)
                          ~(runtime-map (mut k)
                                    (cat3 "{" (memo-key-type f) ":Int}")))
                    (set! (.dirty s)
                          ~(runtime-map (mut k)
                                    (cat3 "{" (memo-key-type f) ":Int}")))
                    (set! (.pending s)
                          (ArrayList::new [i64] (malloc-allocator)))
                    (set! (.uses s)
                          ~(runtime-map (mut k)
                                    (cat3 "{" (memo-key-type f) ":Int}")))
                    (set! (.regions s) ~(runtime-map (mut k) (memo-busy-type f)))
                    (set! (.keys-region s) 0)
                    (set! (.gen s) (rt/next-pass!))
                    (set! (.ready s) true))
                  (rt/init-unlock!)
                  (rt/dep-ensurer! ~qname (fnptr-of ~ensure))
                  ~(if (>= number 0)
                       `(rt/sweeper! ~qname
                                     (fnptr-of ~(sym (cat "memo-sweep--" name))))
                       `0)
                  ~@(let [(mut regs) (primitive/code-list-new)]
                      (for r (pl/reads-of (mut (.checker k)) (.self k) name)
                        (push! (mut regs)
                               `(rt/forget-when! ~r
                                                 (fnptr-of ~(sym (cat "memo-forget--"
                                                                      name))))))
                      regs))
                s)))
    ;; Whether an answer is saved with the cache, as the run's `store … by` function says, given what
    ;; the answer was made from.
    (when (>= number 0)
      (let [(mut fields) (primitive/code-list-new)]
        (for i (range 0 (len (.params f)))
          (push! (mut fields)
                 `(~(primitive/code-symbol "."
                                           (cat "memo-arg-" (rt/num-text i))) a)))
        (let [arms
                (hook-arms (mut k) d name 0 0 `by (param-types f) "Bool" fields)]
          (emit! (mut out)
                 `(defn ~(sym (cat "memo-stored?--" name)) [(s (ptr ~store))
                                                            (key ~(coil-type (mut k)
                                                                             (memo-key-type f)))]
                    (-> bool)
                    (let [by (rt/kept-store-by ~number)]
                      (if (< by 0)
                          true
                          (match (get (.args s) key)
                            (Some [a]
                                  ~(if (= (len (hook-fns (mut k) name 0)) 0)
                                       `true
                                       `(cond ~@arms :else true)))
                            (None []
                                  (panic "memo fn {} kept an answer with no arguments"
                                         ~name))))))))))
    (emit! (mut out) (memo-persist-code (mut k) f name))
    ;; Down to `keep` answers, those asked for longest ago let go, under the store's lock. One let go
    ;; is made again when it is next asked for; what read it then counts it changed.
    (emit! (mut out)
           `(defn ~(sym (cat "memo-evict--" name)) [(s (ptr ~store)) (keep i64)]
              (-> void)
              (let [(mut keys)
                      (ArrayList::new [~(coil-type (mut k) (memo-key-type f))]
                                      (malloc-allocator))
                    (mut stamps) (ArrayList::new [i64] (malloc-allocator))]
                (for key (.table (.main s))
                  (push! (mut keys) key)
                  (push! (mut stamps)
                         (match (get (.uses s) key) (Some [n] n) (None [] 0))))
                (let [order (rt/sort-order-int stamps false)
                      drop (- (len keys) keep)]
                  (for i (range 0 drop)
                    (let [key (get keys (get order i))]
                      (match (get (.regions s) key)
                        (Some [r] (do (rt/region-release-id! r) (HashMap::remove! (mut (.regions s)) key)))
                        (None [] 0))
                      (rt/MemoMap::remove! (mut (.table (.main s))) key)
                      (HashMap::remove! (mut (.uses s)) key)))
                  ;; Every worker's table in front of this one forgets what it had.
                  (set! (.gen s) (rt/next-pass!))
                  (let [(mut o) order] (free! (mut o))))
                (free! (mut keys))
                (free! (mut stamps)))
              0))
    ;; After each build, each answer the run's `evict by` function says to let go, given how many
    ;; builds since the answer was last asked for (0: this one), and how many answers it keeps. One
    ;; let go is made again when it is next asked for.
    (when (>= number 0)
      (let [arms
              (hook-arms (mut k)
                         d
                         name
                         3
                         0
                         `by
                         (let [(mut w) (text-list)]
                           (push! (mut w) "Int")
                           (push! (mut w) "Int")
                           w)
                         "Bool"
                         (let [(mut a) (primitive/code-list-new)]
                           (push! (mut a) `idle)
                           (push! (mut a) `kept)
                           a))]
        (emit! (mut out)
               `(defn ~(sym (cat "memo-sweep--" name)) [] (-> i64)
                  (let [by (rt/kept-evict-by ~number)]
                    (when (>= by 0)
                      (let [s (~whole-fn)
                            word (cast (ptr i64) s)
                            (mut drop)
                              (ArrayList::new [~(coil-type (mut k)
                                                           (memo-key-type f))]
                                              (malloc-allocator))]
                        (rt/spin-lock! word)
                        (let [kept (len (.table (.main s)))]
                          (for key (.table (.main s))
                            (let [idle
                                    (- (rt/builds-swept)
                                       (match (get (.uses s) key)
                                         (Some [n] n)
                                         (None [] 0)))]
                              (when ~(if (= (len (hook-fns (mut k) name 3)) 0)
                                         `false
                                         `(cond ~@arms :else false))
                                (push! (mut drop) key))))
                          (for key drop
                            (match (get (.regions s) key)
                              (Some [r] (do (rt/region-release-id! r) (HashMap::remove! (mut (.regions s)) key)))
                              (None [] 0))
                            (rt/MemoMap::remove! (mut (.table (.main s))) key)
                            (HashMap::remove! (mut (.uses s)) key))
                          (when (> (len drop) 0)
                            (set! (.gen s) (rt/next-pass!))
                            (when (rt/dep-tracing?)
                              (println "[deps] let go {} of {} answers of {}"
                                       (len drop)
                                       kept
                                       ~qname))))
                        (rt/spin-unlock! word)
                        (free! (mut drop)))))
                  0))))
    ;; While dependencies are tracked, an answer from an earlier revision is current only once each
    ;; thing it read is shown unchanged, and an answer computed again that is the same as the one
    ;; it replaces is kept, and does not count as changed.
    (emit! (mut out)
           `(defn ~entry [~@params] (-> ~rt)
              (let [key ~(memo-key-code (mut k) f)
                    ;; How this run keeps it (see `mechanism` in the pipeline language): checked by
                    ;; what it read (0), by no input changing (1), never (2); whether an answer made
                    ;; again the same changes nothing; at most how many answers.
                    check ~(if (>= number 0) `(rt/kept-check ~number) `0)
                    cutoff ~(if (>= number 0) `(rt/kept-cutoff ~number) `1)
                    evict ~(if (>= number 0) `(rt/kept-evict ~number) `0)
                    ;; Which `update by` function makes its answers from the last, or -1.
                    update ~(if (>= number 0) `(rt/kept-update-by ~number) `-1)
                    ;; When each answer was last asked for, for a bound (by asks) and for an `evict by`
                    ;; function (by builds; see `memo-sweep--`).
                    counted
                      (or (> evict 0)
                          ~(if (>= number 0)
                               `(>= (rt/kept-evict-by ~number) 0)
                               `false))
                    t (rules-task)
                    s (~store-fn)
                    word (cast (ptr i64) s)
                    reclaim (rt/reclaiming?)
                    ;; An answer the cache holds is read before anything looks for it.
                    ;; Answers a setting's change said to forget go now, before any is looked for.
                    fresh-store (if (!= (atomic/read (field s stale)) 0) (do (~forgotten s) 0) 0)
                    faulted (~(sym (cat "memo-fault--" name)) s key)
                    tracking (rt/dep-tracking?)
                    node
                      (if tracking
                          (do
                            (rt/spin-lock! word)
                            (let [known (get (.node-ids s) key)]
                              (rt/spin-unlock! word)
                              (match known
                                (Some [i] i)
                                (None []
                                      (let [i (rt/dep-memo-id! ~qname ~key-text)]
                                        (rt/spin-lock! word)
                                        (set! (mut (.node-ids s)) key i)
                                        (rt/spin-unlock! word)
                                        i)))))
                          -1)]
                ;; A memo computing now is made from this answer.
                (when (and tracking (rt/dep-in-frame?)) (rt/dep-note-id! node))
                (when (!= (~near-gen t) (.gen s))
                  (free! (mut (~near t)))
                  (set! (~near t) ~(memo-storage-new (mut k) f))
                  (free! (mut (~near-regions t)))
                  (set! (~near-regions t) ~(runtime-map (mut k) (memo-busy-type f)))
                  (set! (~near-gen t) (.gen s)))
                (when tracking
                  (let [rev (rt/dep-revision)]
                    (when (!= (~near-rev t) rev)
                      (free! (mut (~near t)))
                      (set! (~near t) ~(memo-storage-new (mut k) f))
                      (free! (mut (~near-regions t)))
                      (set! (~near-regions t) ~(runtime-map (mut k) (memo-busy-type f)))
                      (set! (~near-rev t) rev))))
                (match (get (~near t) key)
                  (Some [v]
                        (do
                          ;; What asks holds a value of the answer's region.
                          (rt/region-uses-id! (match (get (~near-regions t) key) (Some [r] r) (None [] 0)))
                          v))
                  (None []
                        (let [me (+ (rt/worker-slot) 1)
                              (mut answer) (None [~rt])
                              (mut answer-region) 0
                              (mut new-answer) false
                              (mut go) true
                              ;; A run that only makes answers and reads them keeps each in the
                              ;; part its key picks, under that part's lock: nothing of what the
                              ;; store keeps for a tracked answer, a counted one, one read from
                              ;; the cache, or one made from the last, is touched.
                              simple
                                (and (not tracking)
                                     (not counted)
                                     (not reclaim)
                                     (< update 0)
                                     (= (len (.lazy s)) 0)
                                     (= (len (.pending s)) 0))
                              h (if simple (~front-fn s key) (field s main))
                              ;; The one part is under the store's lock, as all else of the store.
                              hw (if simple (cast (ptr i64) h) word)]
                          (unless simple (~settle s))
                          ;; An answer another thread made is read beside whoever else reads:
                          ;; only making one, or checking one a run tracks, takes its part whole.
                          ;; One the store's one part holds (read from the cache, or put back
                          ;; there) is found there.
                          (unless (or tracking counted reclaim)
                            (rt/read-lock! hw)
                            (let [early (get (.table h) key)]
                              (rt/read-unlock! hw)
                              (match early
                                (Some [_] (do (set! answer early) (set! go false)))
                                (None [] 0)))
                            (when (and go simple (> (len (.table (.main s))) 0))
                              (rt/read-lock! word)
                              (let [early (get (.table (.main s)) key)]
                                (rt/read-unlock! word)
                                (match early
                                  (Some [_] (do (set! answer early) (set! go false)))
                                  (None [] 0)))))
                          (while go
                            (rt/spin-lock! hw)
                            (let [found (get (.table h) key)
                                  current
                                    (match found
                                      (Some [_]
                                            (or (not tracking)
                                                (= check 2)
                                                (rt/dep-current-id? node)))
                                      (None [] false))]
                              (if current
                                  (do
                                    (when counted
                                      (set! (.clock s) (+ (.clock s) 1))
                                      (set! (mut (.uses s))
                                            key
                                            (if (> evict 0)
                                                (.clock s)
                                                (rt/builds-swept))))
                                    (set! answer-region
                                          (if simple
                                              0
                                              (match (get (.regions s) key) (Some [r] r) (None [] 0))))
                                    (rt/spin-unlock! hw)
                                    (set! answer found)
                                    (set! go false))
                                  (let [owner
                                          (match (get (.busy h) key)
                                            (Some [o] o)
                                            (None [] 0))]
                                    (cond (= owner me)
                                            (do
                                              (rt/spin-unlock! hw)
                                              (panic "memo fn {} asks for its own answer"
                                                     ~name))
                                          (> owner 0)
                                            (do
                                              (rt/spin-unlock! hw)
                                              (rt/pause!))
                                          :else
                                            (do
                                              (set! (mut (.busy h)) key me)
                                              (rt/spin-unlock! hw)
                                              ;; Made from the store's own copy of the arguments, in a
                                              ;; region of its own, when the run reclaims memory. Asked
                                              ;; for by a computation working apart, made in lasting
                                              ;; storage, from the store's own copy too: the answer
                                              ;; outlives what asked.
                                              (let [apart-open (rt/lasting-enter!)
                                                    ;; An answer made while names are only noted
                                                    ;; (`rt/name-record!`) may hold a name's -1:
                                                    ;; it is given to whoever asked and not kept.
                                                    noted-before (rt/name-notes)
                                                    owned
                                                      (cond reclaim (~(sym (cat "memo-own--" name)) s key ~@args)
                                                            ;; Asked for by a computation working apart:
                                                            ;; whatever of the arguments lies in scratch
                                                            ;; storage, the answer's own copy of.
                                                            (> apart-open 0)
                                                              (~(sym (cat "MemoOwned--" name))
                                                                :args ~(if (= (len (.params f)) 0)
                                                                           `(zeroed ~args-ty)
                                                                           `(~args-ty ~@(let [(mut owns) (primitive/code-list-new)]
                                                                                          (for i (range 0 (len (.params f)))
                                                                                            (push! (mut owns)
                                                                                                   (primitive/code-symbol ":" (cat "memo-arg-" (rt/num-text i))))
                                                                                            (push! (mut owns)
                                                                                                   (own-in-code (mut k)
                                                                                                                (.ty (get (.params f) i))
                                                                                                                (memo-arg i)
                                                                                                                `(rt/any-scratch))))
                                                                                          owns))))
                                                            :else
                                                              (~(sym (cat "MemoOwned--" name))
                                                                :args ~(if (= (len (.params f)) 0)
                                                                           `(zeroed ~args-ty)
                                                                           `(~args-ty ~@arg-inits))))
                                                    ~@(let [(mut rebinds) (primitive/code-list-new)]
                                                        (for i (range 0 (len (.params f)))
                                                          (push! (mut rebinds) (memo-arg i))
                                                          (push! (mut rebinds)
                                                                 `(~(primitive/code-symbol "." (cat "memo-arg-" (rt/num-text i))) (.args owned))))
                                                        rebinds)
                                                    (mut fresh-region) 0
                                                    (mut kept-old) false
                                                    made
                                                      (match found
                                                        (Some [old]
                                                              (if (and (= check
                                                                          0)
                                                                       (rt/dep-still-id? node))
                                                                  (do (set! kept-old true) old)
                                                                  (do
                                                                    ~(made-check (mut k)
                                                                                 name)
                                                                    (rt/dep-begin!)
                                                                    ;; Checked by a function of its own: the same version, the
                                                                    ;; same answer, not made again.
                                                                    (let [version
                                                                            (if (>= check
                                                                                    3)
                                                                                ~version-code
                                                                                "")]
                                                                      (if (and (>= check
                                                                                   3)
                                                                               (> (len version)
                                                                                  0)
                                                                               (= version
                                                                                  (rt/version-of node)))
                                                                          (do
                                                                            (rt/dep-end-same-version! node)
                                                                            (set! kept-old true)
                                                                            old)
                                                                          (let [region (rt/answer-region-open! ~qname)
                                                                                fresh
                                                                                  ~made-code
                                                                                closed (rt/answer-region-close! region)
                                                                                same
                                                                                  ~same-now]
                                                                            (set! fresh-region region)
                                                                            (when same (set! kept-old true))
                                                                            (if (= check
                                                                                   0)
                                                                                (rt/dep-end-id! node
                                                                                                same)
                                                                                (rt/dep-end-ignoring-reads! node
                                                                                                            same
                                                                                                            (or (= check
                                                                                                                   1)
                                                                                                                (>= check
                                                                                                                    3))))
                                                                            (when (>= check
                                                                                      3)
                                                                              (rt/version-set! node
                                                                                               version))
                                                                            (unless same
                                                                              (set! new-answer
                                                                                    true))
                                                                            (if same
                                                                                old
                                                                                fresh)))))))
                                                        (None []
                                                              (do
                                                                ~(made-check (mut k)
                                                                             name)
                                                                (when tracking
                                                                  (rt/dep-begin!))
                                                                (let [version
                                                                        (if (and tracking
                                                                                 (>= check
                                                                                     3))
                                                                            ~version-code
                                                                            "")
                                                                      region (rt/answer-region-open! ~qname)
                                                                      fresh
                                                                        ~made-code
                                                                      closed (rt/answer-region-close! region)]
                                                                  (set! fresh-region region)
                                                                  (when tracking
                                                                    (if (= check
                                                                           0)
                                                                        (rt/dep-end-id! node
                                                                                        false)
                                                                        (rt/dep-end-ignoring-reads! node
                                                                                                    false
                                                                                                    (or (= check
                                                                                                           1)
                                                                                                        (>= check
                                                                                                            3))))
                                                                    (when (>= check
                                                                              3)
                                                                      (rt/version-set! node
                                                                                       version)))
                                                                  (rt/dep-untracked!)
                                                                  (set! new-answer
                                                                        true)
                                                                  fresh))))
                                                    apart-left (rt/lasting-leave! apart-open)
                                                    noted (!= (rt/name-notes) noted-before)]
                                                (rt/spin-lock! hw)
                                                (when tracking
                                                  ;; Its arguments: the store's own copy already, while the run
                                                  ;; reclaims memory (see `memo-own--`).
                                                  (unless reclaim
                                                    (set! (mut (.args s))
                                                          key
                                                          ~(if (= (len (.params f))
                                                                  0)
                                                               `(zeroed ~args-ty)
                                                               `(~args-ty ~@arg-inits))))
                                                  ;; What the cache does not hold yet.
                                                  (when new-answer
                                                    (set! (mut (.dirty s))
                                                          key
                                                          1)))
                                                (unless noted
                                                  (set! (mut (.table h))
                                                        key
                                                        made))
                                                ;; The table holds the region its answer was made in: a new
                                                ;; one's, the one it replaces let go; or, when the answer
                                                ;; kept is the one it had, the new region let go.
                                                (when reclaim
                                                  (let [had (match (get (.regions s) key) (Some [r] r) (None [] 0))]
                                                    (if kept-old
                                                        (do (rt/region-release-id! fresh-region)
                                                            (set! answer-region had))
                                                        (do (set! (mut (.regions s)) key fresh-region)
                                                            (rt/region-release-id! had)
                                                            (set! answer-region fresh-region)))))
                                                ;; The last answer made is for an `update by` function,
                                                ;; which a simple run has none of.
                                                (if simple
                                                    (when (= (atomic/read (field s fronted)) 0)
                                                      (atomic/store (field s fronted) 1))
                                                    (do
                                                      ~(if (= (memo-key-type f) "Text")
                                                           `(rt/last-key-set! (field s last-key) key)
                                                           `(set! (.last-key s) key))
                                                      (set! (.has-last s) true)))
                                                (set! (mut (.busy h)) key 0)
                                                ;; At most `evict` answers: once there are a quarter more, those
                                                ;; asked for longest ago let go.
                                                (when counted
                                                  (set! (.clock s)
                                                        (+ (.clock s) 1))
                                                  (set! (mut (.uses s))
                                                        key
                                                        (if (> evict 0)
                                                            (.clock s)
                                                            (rt/builds-swept)))
                                                  (when (and (> evict 0)
                                                             (> (len (.table h))
                                                                (+ evict
                                                                   (/ evict 4)
                                                                   1)))
                                                    (~(sym (cat "memo-evict--"
                                                                name)) s
                                                       evict)))
                                                (rt/spin-unlock! hw)
                                                (set! answer (Some made))
                                                (set! go false))))))))
                          (match answer
                            (Some [v]
                                  (do
                                    ;; Not while names are only noted: see `noted` above.
                                    (unless (rt/names-recording?)
                                      (if simple
                                          ;; Only the last few asked for (see `rt/near-most`); such
                                          ;; a run's answers have no region to note.
                                          (do
                                            (when (>= (len (~near t)) (rt/near-most))
                                              (rt/MemoMap::clear! (mut (~near t))))
                                            (set! (mut (~near t)) key v)
                                            0)
                                          (do
                                            (set! (mut (~near t)) key v)
                                            (set! (mut (~near-regions t)) key answer-region)
                                            0)))
                                    (rt/region-uses-id! answer-region)
                                    v))
                            (None [] (panic "memo fn {} lost its answer" ~name)))))))))
    (when (>= number 0)
      (emit! (mut out)
             `(defn ~(sym name) [~@params] (-> ~rt)
                (if (rt/kept? ~number
                              ~(if (has-text? (.default-keeps k)
                                              (cat3 (.self k) "/" name))
                                   `true
                                   `false))
                    (~entry ~@args)
                    ;; Not kept: counted, while auditing, by its arguments (see `rt/audit-call!`).
                    (if (and (rt/auditing?) (not (rt/names-recording?)))
                        (let [key ~(memo-key-code (mut k) f)
                              started (rt/now-us)
                              v (~(sym compute) ~@args)]
                          (rt/audit-call! ~(cat3 (.self k) "/" name)
                                          ~key-text
                                          (- (rt/now-us) started))
                          v)
                        (~(sym compute) ~@args))))))))

;;; Every memo of the module starts over, when dependencies are not tracked. Only while no other
;;; worker runs.
(defn compile-record [(k (mut Comp)) (r RecDef)] (-> Code)
  (let [(mut fields) (primitive/code-list-new)]
    (for f (.fields r)
      (push! (mut fields) `(~(sym (.name f)) ~(coil-type (mut k) (.ty f)))))
    `(defstruct ~(sym (.name r)) [~@fields])))

;;; An enum, compared by its tag: one load each, where a derived comparison is a call.
(defn compile-enum [(e EnumDef)] (-> Code)
  (let [(mut variants) (primitive/code-list-new)
        (mut tags) (primitive/code-list-new)
        ty (sym (.name e))
        tag (sym (cat "enum-tag-" (.name e)))]
    (for i (range 0 (len (.variants e)))
      (let [v (get (.variants e) i)]
        (push! (mut variants) `(~(sym v)))
        (push! (mut tags) `(~(sym v) [] ~i))))
    `(do
       (defsum ~ty ~@variants)
       (defn ~tag :inline (Always) [(x ~ty)] (-> i64)
         (match x ~@tags))
       (impl Eq ~ty
         (= [(a ~ty) (b ~ty)] (-> bool)
           (= (~tag a) (~tag b)))))))

;;; Text, one form to a line, is what the generated module is.
(defn emit! [(out (mut str/StrBuf)) (form Code)] (-> void)
  (push-str! (mut out) (dsl/render form))
  (push-str! (mut out) "\n"))

(defn prelude-text [] (-> (slice u8))
  (include-str "../../src/languages/rules_prelude.rules"))

;;; Placeholder values for a fresh task struct's fields, before its own thread initialises them.
(defn task-zeroes [(k (mut Comp)) (self Mod) (decls (ArrayList g/Node))]
  (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for d decls
      (when (or (= (.kind d) (g/KTaskState))
                (= (.kind d) (g/KContext))
                (= (.kind d) (g/KInh))
                (= (.kind d) (g/KInput))
                (= (.kind d) (g/KCollect))
                (= (.kind d) (g/KGiven)))
        (let [g-name (.text (kid d 0))
              x
                (match (find-global self g-name)
                  (Some [v] v)
                  (None [] (die (mut k) d "this was not collected")))]
          (when (.task x)
            (push! (mut out) (primitive/code-symbol ":" g-name))
            (push! (mut out) (global-init (mut k) d x)))))
      (when (= (.kind d) (g/KInclude))
        (let [m (mod-at (mut k) (.text (kid d 0)))]
          (push! (mut out) (primitive/code-symbol ":" (include-field m)))
          (push! (mut out)
                 `(cast (ptr ~(primitive/code-symbol (alias-of (.name m))
                                                     "/RulesTask"))
                        0))))
      (when (= (.kind d) (g/KMemoFn))
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near (.text (kid d 0)))))
        (push! (mut out) (memo-new-map (mut k) d))
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near-regions (.text (kid d 0)))))
        (push! (mut out) (runtime-map (mut k) (memo-key-int-type (mut k) d)))
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near-gen (.text (kid d 0)))))
        (push! (mut out) `-1)
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near-rev (.text (kid d 0)))))
        (push! (mut out) `-1)))
    (when (inputs? decls)
      (push! (mut out) `:attrs-depth)
      (push! (mut out) `0))
    (when (rewrites? decls)
      (push! (mut out) `:attrs-results)
      (push! (mut out) (new-list (mut k) (cat (.over self) ".Node")))
      (push! (mut out) `:attrs-changes)
      (push! (mut out) `0))
    `(~@out)))

(defn compile-module [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut k)
          (Comp
            :loop-marks (text-list)
            :escaped (text-list)
            :mods (ArrayList::new [Mod] (malloc-allocator))
            :self ""
            :table (ArrayList::new [Alias] (malloc-allocator))
            :base ""
            :depends (text-list)
            :src src
            :path path
            :locals (ArrayList::new [Local] (malloc-allocator))
            :counter 0
            :in-with 0
            :returned false
            :ret "Void"
            :aux (ArrayList::new [Code] (malloc-allocator))
            :in-fn false
            :task-used false
            :in-on false
            :eq-slots (ArrayList::new [EqSlot] (malloc-allocator))
            :ovr-slots (ArrayList::new [OvrSlot] (malloc-allocator))
            :givens (ArrayList::new [Given] (malloc-allocator))
            :outs (ArrayList::new [Out] (malloc-allocator))
            :sames (text-list)
            :quiet 0
            :attrs-from ""
            :keeps (text-list)
            :default-keeps (text-list)
            :made (text-list)
            :aparts (text-list)
            :lastings (text-list)
            :mutators (ArrayList::new [Mutator] (malloc-allocator))
            :hooks (ArrayList::new [Hooks] (malloc-allocator))
            :sig-only (text-list)
            :sizes (ArrayList::new [pl/Size] (malloc-allocator))
            :staged (text-list)
            :stages (ArrayList::new [pl/Stage] (malloc-allocator))
            :checker
              (pl/checker-new (dsl/manifest-entries (meta/read-context-manifest context))))
        manifest (meta/read-context-manifest context)]
    (read-manifest! (mut k) manifest)
    (read-keeps! (mut k))
    (load-prelude! (mut k))
    (let [tree (load-rules-file! (mut k) path src true)
          name (.text (kid tree 0))
          decls (list-kids (kid tree 2))
          (mut out) (str/StrBuf::new (malloc-allocator))]
      (set! (.self k) name)
      (set! (.src k) src)
      (set! (.path k) path)
      ;; The modules of the `… by F` functions of what this module keeps: what a strategy says,
      ;; outside the code it keeps. Read for their signatures, and those of what they read, which
      ;; this module is not made from.
      (let [before (len (.mods k))]
        (for h (.hooks k)
          (when (= (subslice (.key h) 0 (rt/name-end-at (.key h) 47)) name)
            (for hook (.fns h)
              (let [module (subslice hook 0 (rt/name-end-at hook 47))]
                (unless (= module name) (ensure-loaded! (mut k) module))))))
        (for i (range before (len (.mods k)))
          (push! (mut (.sig-only k)) (.name (get (.mods k) i)))))
      ;; What each kept function reads is known before anything is written: the files that says it
      ;; are what this module is compiled from too.
      (for d decls
        (when (= (.kind d) (g/KMemoFn))
          (let [reads (pl/reads-of (mut (.checker k)) name (.text (kid d 0)))]
            ;; HL_SHOW_READS set: what each kept function reads, as the compiler worked it out.
            (unless (= (primitive/cast i64 (getenv c"HL_SHOW_READS")) 0)
              (println "[reads] {}/{}: {}"
                       name
                       (.text (kid d 0))
                       (rt/joined reads " "))))))
      (for f (pl/checker-depends (mut (.checker k)))
        (unless (has-text? (.depends k) f) (push! (mut (.depends k)) f)))
      ;; Every file sees the prelude's foreign modules by their aliases.
      (emit! (mut out)
             `(do
                (import "coil.primitive" :as primitive)
                (import "coil.alloc" :use [malloc-allocator box!])
                (import "coil.arraylist" :use [ArrayList])
                (import "coil.hashmap" :use [HashMap i64-keyops])
                (import "coil.slice" :use [subslice])
                (import "coil.str" :as str)
                (import "coil.cc" :as cc)
                (import "coil.control" :use [return-from])))
      (for m (.mods k)
        (unless (or (= (.name m) name)
                    (= (.name m) "hl.prelude")
                    (= (.name m) "hl.rt")
                    (has-text? (.sig-only k) (.name m)))
          (emit! (mut out) `(import ~(.name m) :as ~(sym (alias-of (.name m)))))))
      ;; The strategy's functions this module has, registered for the code they serve to call.
      (emit! (mut out) (register-hooks-code (mut k) name))
      (emit! (mut out) `(import "hl.rt" :as rt))
      (emit! (mut out) `(import "hl.rt" :as hl-rt))
      (emit! (mut out) `(import "coil.atomic" :as atomic))
      (let [(mut deps) (primitive/code-list-new)]
        (for d (.depends k) (push! (mut deps) `~d))
        (when (> (len (.depends k)) 0)
          (emit! (mut out) `(depends-on ~@deps))))
      (let [self (self-mod (mut k))
            (mut state-fields) (primitive/code-list-new)
            (mut state-inits) (primitive/code-list-new)]
        (for e (.enums self) (emit! (mut out) (compile-enum e)))
        (for r (.recs self) (emit! (mut out) (compile-record (mut k) r)))
        (let [(mut task-fields) (primitive/code-list-new)
              (mut task-inits) (primitive/code-list-new)]
          (for d decls
            (when (or (= (.kind d) (g/KState))
                      (= (.kind d) (g/KTaskState))
                      (= (.kind d) (g/KContext))
                      (= (.kind d) (g/KConst))
                      (= (.kind d) (g/KInh))
                      (= (.kind d) (g/KInput))
                      (= (.kind d) (g/KCollect))
                      (= (.kind d) (g/KGiven))
                      (= (.kind d) (g/KSetting)))
              (let [g-name (.text (kid d 0))
                    x
                      (match (find-global self g-name)
                        (Some [v] v)
                        (None [] (die (mut k) d "this was not collected")))
                    v (global-init (mut k) d x)]
                (if (.task x)
                    (do
                      (push! (mut task-fields)
                             `(~(sym g-name) ~(coil-type (mut k) (.ty x))))
                      (push! (mut task-inits)
                             `(set! (~(primitive/code-symbol "." g-name) s) ~v)))
                    (do
                      (push! (mut state-fields)
                             `(~(sym g-name) ~(coil-type (mut k) (.ty x))))
                      (push! (mut state-inits)
                             `(set! (~(primitive/code-symbol "." g-name) s) ~v))
                      (when (= (.attr x) 5)
                        (push! (mut state-fields)
                               `(~(sym (bound-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (bound-field g-name)) s)
                                      ~(if (setting-root? d) `1 `0)))
                        (push! (mut state-fields)
                               `(~(sym (held-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (held-field g-name)) s)
                                      ~(if (setting-root? d) `1 `0)))
                        ;; Where the cache holds its value, plus one, until it is read; and
                        ;; whether it was given one since the cache was last written.
                        (push! (mut state-fields)
                               `(~(sym (lazy-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (lazy-field g-name)) s)
                                      0))
                        (push! (mut state-fields)
                               `(~(sym (dirty-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (dirty-field g-name)) s)
                                      0))
                        (push! (mut state-fields)
                               `(~(sym (region-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (region-field g-name)) s)
                                      0)))))))
            (when (= (.kind d) (g/KInclude))
              (let [m (mod-at (mut k) (.text (kid d 0)))
                    rt-ty
                      `(ptr ~(primitive/code-symbol (alias-of (.name m))
                                                    "/RulesTask"))]
                (push! (mut task-fields) `(~(sym (include-field m)) ~rt-ty))
                (push! (mut task-inits)
                       `(set! (~(primitive/code-symbol "." (include-field m)) s)
                              (cast ~rt-ty 0)))))
            (when (= (.kind d) (g/KMemoFn))
              (push! (mut task-fields) (memo-near-field (mut k) d))
              (push! (mut task-fields) (memo-near-regions-field (mut k) d))
              (push! (mut task-fields) (memo-gen-field d))
              (push! (mut task-fields) (memo-rev-field d))
              (push! (mut task-inits) (memo-near-init (mut k) d))
              (push! (mut task-inits) (memo-near-regions-init (mut k) d))
              (push! (mut task-inits) (memo-gen-init d))
              (push! (mut task-inits) (memo-rev-init d))))
          (when (inputs? decls)
            (push! (mut task-fields) `(attrs-depth i64))
            (push! (mut task-inits) `(set! (.attrs-depth s) 0)))
          (when (and (= (.kind tree) (g/KAttrsFile)) (rewrites? decls))
            (let [lt (cat3 "[" (.text (kid tree 1)) ".Node]")]
              (push! (mut task-fields) `(attrs-results ~(coil-type (mut k) lt)))
              (push! (mut task-inits)
                     `(set! (.attrs-results s) ~(new-list (mut k) (elem-of lt))))
              ;; How many nodes a rewrite has changed: a node whose children changed none is itself.
              (push! (mut task-fields) `(attrs-changes i64))
              (push! (mut task-inits) `(set! (.attrs-changes s) 0))))
          ;; Program state, set up by the first thread to use it while any other waits. The flag is
          ;; read and written atomically, so a thread that sees it ready sees what was set: 0 not
          ;; set up, 2 being set up by `rules-owner`, which may use what it has set so far, 1 ready.
          (emit! (mut out)
                 `(defstruct RulesState
                    [(rules-ready i64)
                     (rules-owner i64)
                     (rules-lock i64)
                     ~@state-fields]))
          (emit! (mut out)
                 `(defn rules-init! [(s (ptr RulesState))] (-> void)
                    ~@state-inits
                    0))
          (emit! (mut out)
                 `(defn rules-state [] (-> (ptr RulesState))
                    (let [s (primitive/alloc-static RulesState)]
                      (if (= (atomic/read (field s rules-ready)) 1)
                          s
                          (rules-state-first s)))))
          (emit! (mut out)
                 `(defn rules-state-first [(s (ptr RulesState))]
                    (-> (ptr RulesState))
                    (let [me (+ (rt/worker-slot) 1)]
                      (if (and (= (atomic/read (field s rules-ready)) 2)
                               (= (atomic/read (field s rules-owner)) me))
                          s
                          (do
                            (rt/spin-lock! (field s rules-lock))
                            (when (= (atomic/read (field s rules-ready)) 0)
                              (atomic/store (field s rules-owner) me)
                              (atomic/store (field s rules-ready) 2)
                              ;; In the program's own region: the state lasts as long as it.
                              (rt/state-region-enter!)
                              (rules-init! s)
                              (rt/region-leave!)
                              (atomic/store (field s rules-ready) 1))
                            (rt/spin-unlock! (field s rules-lock))
                            s)))))
          ;; Settings a job gives itself. A `with` on a setting while this thread does one of
          ;; several jobs at once (`rt/in-job?`) gives the setting to this job alone: the thread
          ;; takes a copy of the module's state for as long as such a `with` is open, gives and
          ;; reads its settings there, and lets the copy go. The other jobs, and the program's
          ;; own state, see nothing of it. `count`: how many threads hold a copy now, so that
          ;; while none does a setting is read as ever; a thread's copy and how many of its
          ;; `with`s are open, by worker slot.
          (emit! (mut out)
                 `(defstruct SettingsOwn
                    [(count i64) (own (array i64 64)) (depth (array i64 64))]))
          (emit! (mut out)
                 `(defn settings-own [] (-> (ptr SettingsOwn))
                    (primitive/alloc-static SettingsOwn)))
          (emit! (mut out)
                 `(defn rules-settings [] (-> (ptr RulesState))
                    (let [o (settings-own)]
                      (if (= (atomic/read (field o count)) 0)
                          (rules-state)
                          ;; This thread's own; or those of the thread it helps; or the program's.
                          (let [own (get (.own o) (rt/worker-slot))]
                            (if (!= own 0)
                                (cast (ptr RulesState) own)
                                (let [view (rt/settings-view)
                                      seen (if (< view 0) 0 (get (.own o) view))]
                                  (if (= seen 0)
                                      (rules-state)
                                      (cast (ptr RulesState) seen)))))))))
          (emit! (mut out)
                 `(defn settings-own-enter! [] (-> void)
                    (when (rt/in-job?)
                      (let [o (settings-own)
                            slot (rt/worker-slot)
                            depth (get (.depth o) slot)]
                        (when (= depth 0)
                          (set! (mut (.own o))
                                slot
                                (rt/own-state-new (cast (ptr u8) (rules-settings)) (sizeof RulesState)))
                          (atomic/add (field o count) 1))
                        (set! (mut (.depth o)) slot (+ depth 1))))
                    0))
          (emit! (mut out)
                 `(defn settings-own-leave! [] (-> void)
                    (let [o (settings-own)
                          slot (rt/worker-slot)
                          depth (get (.depth o) slot)]
                      (when (> depth 0)
                        (set! (mut (.depth o)) slot (- depth 1))
                        (when (= depth 1)
                          (let [own (get (.own o) slot)]
                            (set! (mut (.own o)) slot 0)
                            (atomic/add (field o count) -1)
                            (rt/own-state-free! own)))))
                    0))
          ;; Task state: one copy per worker slot, made the first time its own thread asks. The
          ;; slots and the key are published by an atomic store of `ready`, after them.
          (emit! (mut out)
                 `(defstruct RulesTask [(rules-ready bool) ~@task-fields]))
          (emit! (mut out)
                 `(defstruct RulesTasks
                    [(ready i64) (slots (ArrayList RulesTask)) (key i64)]))
          (emit! (mut out)
                 `(defn rules-task-init! [(s (ptr RulesTask))] (-> void)
                    (set! (.rules-ready s) true)
                    ~@task-inits
                    0))
          (emit! (mut out)
                 ;; A thread finds its own copy through a thread-specific value: one lookup, after the first.
                 `(defn rules-task [] (-> (ptr RulesTask))
                    (let [all (primitive/alloc-static RulesTasks)]
                      (if (= (atomic/read (field all ready)) 1)
                          (let [found (rt/key-get (.key all))]
                            (if (= (primitive/cast i64 found) 0)
                                (rules-task-first all)
                                (cast (ptr RulesTask) found)))
                          (rules-task-first all)))))
          (emit! (mut out)
                 `(defn rules-task-first [(all (ptr RulesTasks))]
                    (-> (ptr RulesTask))
                    (unless (= (atomic/read (field all ready)) 1)
                      (rt/init-lock!)
                      (unless (= (atomic/read (field all ready)) 1)
                        (let [(mut slots)
                                (ArrayList::new [RulesTask] (malloc-allocator))]
                          (for _ (range 0 (rt/max-workers))
                            (push! (mut slots)
                                   (RulesTask :rules-ready
                                              false
                                              ~@(task-zeroes (mut k) self decls))))
                          (set! (.slots all) slots))
                        (set! (.key all) (rt/key-new))
                        (atomic/store (field all ready) 1))
                      (rt/init-unlock!))
                    (let [s (elem (mut (.slots all)) (rt/worker-slot))]
                      (unless (.rules-ready s)
                        (rt/state-region-enter!)
                        (rules-task-init! s)
                        (rt/region-leave!))
                      (rt/key-set! (.key all) (cast (ptr i8) s))
                      s)))
          ;; A module's inputs are not its state: what `with` gave them stays given.
          (let [(mut keeps) (primitive/code-list-new)
                (mut puts) (primitive/code-list-new)]
            (for x (.globals self)
              (when (= (.attr x) 5)
                (let [t (fresh (mut k) "kept")
                      field
                        `(~(primitive/code-symbol "." (.name x)) (rules-state))
                      tb (fresh (mut k) "kept")
                      bound
                        `(~(primitive/code-symbol "." (bound-field (.name x))) (rules-state))
                      tl (fresh (mut k) "kept")
                      lazy
                        `(~(primitive/code-symbol "." (lazy-field (.name x))) (rules-state))
                      td (fresh (mut k) "kept")
                      dirty
                        `(~(primitive/code-symbol "." (dirty-field (.name x))) (rules-state))
                      th (fresh (mut k) "kept")
                      held
                        `(~(primitive/code-symbol "." (held-field (.name x))) (rules-state))]
                  (push! (mut keeps) (sym t))
                  (push! (mut keeps) field)
                  (push! (mut keeps) (sym tb))
                  (push! (mut keeps) bound)
                  (push! (mut keeps) (sym tl))
                  (push! (mut keeps) lazy)
                  (push! (mut keeps) (sym td))
                  (push! (mut keeps) dirty)
                  (push! (mut keeps) (sym th))
                  (push! (mut keeps) held)
                  (push! (mut puts) `(set! ~field ~(sym t)))
                  (push! (mut puts) `(set! ~bound ~(sym tb)))
                  (push! (mut puts) `(set! ~lazy ~(sym tl)))
                  (push! (mut puts) `(set! ~dirty ~(sym td)))
                  (push! (mut puts) `(set! ~held ~(sym th))))))
            (emit! (mut out)
                   `(defn reset-state! [] (-> void)
                      (let [~@keeps]
                        (rt/state-region-enter!)
                        (rules-init! (rules-state))
                        ~@puts
                        (rules-task-init! (rules-task))
                        (rt/region-leave!)))))))
      (check-aparts! (mut k) path decls)
      (for d decls
        (when (= (.kind d) (g/KFn))
          (cond (>= (apart-number (mut k) (.text (kid d 0))) 0)
                  (compile-apart! (mut k)
                                  d
                                  (.text (kid d 0))
                                  (apart-number (mut k) (.text (kid d 0)))
                                  (mut out))
                (auditable? (mut k) d) (compile-audited! (mut k) d (mut out))
                :else (emit! (mut out) (compile-fn (mut k) d))))
        (when (= (.kind d) (g/KMemoFn))
          (compile-memo! (mut k) d (mut out))))
      (emit! (mut out) (compile-persist (mut k) decls))
      (when (= (.kind tree) (g/KAttrsFile))
        (emit! (mut out) (compile-attrs (mut k) tree decls)))
      (for a (.aux k) (emit! (mut out) a))
      (for d decls
        (when (= (.kind d) (g/KMainDecl))
          (emit! (mut out) (compile-main (mut k) d))))
      (finish! (mut out)))))

;;; `main run`: the arguments are read, then `run` starts, on a thread with room for deep
;;; trees if asked. Answers `run`'s exit status when it has one.
(defn compile-main [(k (mut Comp)) (d g/Node)] (-> Code)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d (cat "no function named " name))))
        answers (= (.ret f) "Int")]
    (unless (= (len (.params f)) 0)
      (die (mut k) d (cat name " must take no arguments")))
    (if (none? (kid d 1))
        `(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
           (rt/args-init! argc argv)
           (rt/persist-root! (fnptr-of persist-save!)
                             (fnptr-of persist-load!)
                             (fnptr-of persist-force!))
           ~(if answers `(~(sym name)) `(do (~(sym name)) 0)))
        `(do
           (defn rules-worker [(arg (ptr i8))] (-> (ptr i8))
             ~(if answers `(rt/answer! (~(sym name))) `(~(sym name)))
             arg)
           (defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
             (rt/args-init! argc argv)
             (rt/persist-root! (fnptr-of persist-save!)
                               (fnptr-of persist-load!)
                               (fnptr-of persist-force!))
             (rt/run-on-big-stack (fnptr-of rules-worker))
             (rt/answer))))))

(defn load-prelude! [(k (mut Comp))] (-> void)
  (let [text (prelude-text)
        (mut tree) (parse-file (mut k) text "rules_prelude.rules")]
    (push! (mut (.mods k)) (mod-new "hl.prelude" (SRules) ""))
    (set! (.src k) text)
    (for d (list-kids (kid tree 2))
      (when (= (.kind d) (g/KForeign)) (add-foreign! (mut k) d "hl.prelude")))))

;;; With HL_DUMP_DIR set, each module's generated Coil is also written there, for reading what a
;;; language made of a file.
(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(defn dump-generated! [(context Code) (text (slice u8))] (-> void)
  (let [dir (getenv c"HL_DUMP_DIR")]
    (unless (= (primitive/cast i64 dir) 0)
      (let [path (dsl/path-of context)
            (mut slash) -1]
        (for i (range 0 (len path)) (when (= (get path i) #\/) (set! slash i)))
        (fs/write-file (malloc-allocator)
                       (cat3 (str/from-cstr dir)
                             "/"
                             (subslice path (+ slash 1) (len path)))
                       text)
        0))))

;;; A `.rules` or `.attrs` file's module, as Coil text.
(defn rules-text [(context Code)] (-> (slice u8))
  (let [text (compile-module context)]
    (dump-generated! context text)
    text))

(defn read-rules [(context Code)] (-> Code)
  (primitive/code-read (rules-text context) `(reader-config)))
