;;; `.rules`: the language for everything between a grammar and a Datalog program.
;;;
;;;   rules bundle.graph over bundle.js   # the file's module, and the grammar it works on
;;;   use bundle.link as link             # another module of any language
;;;   quote stmt at 1 0 ;                 # stmt`…` is the template's first statement
;;;
;;;   record Module { path: Text, deps: [Int] }
;;;   enum Sort { Esm, Cjs }
;;;   state modules: [Module] = []        # lives as long as the build
;;;   context strict: Bool = false        # rebound for a dynamic extent by `with`
;;;
;;;   fn pure?(n: Node) -> Bool = match n {
;;;     Num(_) | Str(_) => true
;;;     Paren(x) | Not(x) => pure?(x)
;;;     ArrayLit(List(xs...)) => all x in xs: pure?(x)
;;;     _ => false
;;;   }
;;;   fn wrap(name: Text, body: [Node]) -> Node = stmt`var $name = $helper(() => { $$body });`
;;;   main run on big stack               # this file is a program, and `run` is where it starts
;;;   for db.declares(p, ?s) { names[s] = final(s) }     # a query over a relation
;;;
;;; Node patterns and constructors are checked against the grammar, and everything is
;;; type-checked here, across modules, so mistakes are located in the guest file. There is
;;; no runtime: this compiles to the Coil a person would have written.
(module hl.rules)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.str" :as str)
(import "coil.meta" :as meta)
(import "coil.fs" :as fs)
(import "coil.cc" :as cc)
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.syntax" :as syntax)
(import "hl.grammars.rules" :as g)
(import "hl.grammars.facts" :as gf)
(import "hl.grammars.rewrite" :as grw)
(import "hl.grammars.scopes" :as gsc)
(import "hl.grammars.pipeline" :as gpl)

(reader-provider "hl.rules" read-rules)

;; ---------------------------------------------------------------- what modules offer

(defstruct Param [(name (slice u8)) (ty (slice u8)) (by-ref bool)])

(defstruct Func
  [(name (slice u8))
   (coil (slice u8))
   (params (ArrayList Param))
   (ret (slice u8))])

(defstruct FieldDef [(name (slice u8)) (ty (slice u8))])

(defstruct RecDef [(name (slice u8)) (fields (ArrayList FieldDef))])

(defstruct EnumDef [(name (slice u8)) (variants (ArrayList (slice u8)))])

(defstruct Global
  [(name (slice u8))
   (ty (slice u8))
   (assignable bool)
   (task bool)
   (attr i64)])  ; an attribute: 1 inherited, 2 an input, 3 collected, 4 given;

; else 0
(defstruct RelDef [(name (slice u8)) (arity i64)])

(defstruct QuoteDef [(name (slice u8)) (path (ArrayList i64))])

(defstruct Alias [(name (slice u8)) (module (slice u8))])

(defsum Sort (SRules) (SForeign) (SGrammar) (SFacts) (SRewrite) (SScopes))

(derive Eq Sort)

(defstruct Mod
  [(name (slice u8))
   (sort Sort)
   (funcs (ArrayList Func))
   (recs (ArrayList RecDef))
   (enums (ArrayList EnumDef))
   (globals (ArrayList Global))
   (types (ArrayList (slice u8)))
   (kinds (ArrayList syntax/KindEntry))
   (rels (ArrayList RelDef))
   (quotes (ArrayList QuoteDef))
   (aliases (ArrayList Alias))
   (over (slice u8))])

(defstruct Local
  [(name (slice u8)) (ty (slice u8)) (sym (slice u8)) (mutable bool)])

(defstruct Comp
  [(mods (ArrayList Mod))
   (self (slice u8))
   (table (ArrayList Alias))  ; module name -> file, from the manifest
   (base (slice u8))  ; the manifest's directory
   (depends (ArrayList (slice u8)))
   (src (slice u8))
   (path (slice u8))
   (locals (ArrayList Local))
   (counter i64)
   (in-with i64)
   (returned bool)
   (ret (slice u8))
   (aux (ArrayList Code))
   (in-fn bool)  ; compiling a function body, which finds its task state once
   (task-used bool)
   (in-on bool)  ; compiling an `on` block of an attribute grammar
   (eq-slots (ArrayList EqSlot))  ; where its equations for children put their values
   (ovr-slots (ArrayList OvrSlot))
   (givens (ArrayList Given))
   (outs (ArrayList Out))  ; in a rewrite, the names whose rewritten form `.out` reads
   (sames (ArrayList (slice u8)))  ; the types `same-code` has made a comparison of, in this module
   (attrs-from (slice u8))])  ; the attribute grammar whose blocks are being read; "" for this one

;;; A name a rewrite's pattern binds to a child, or to its node, and that one's rewritten form.
(defstruct Out [(sym (slice u8)) (code Code)])

;;; A `given` attribute and the value a child has when its parent's equations give it none.
(defstruct Given [(attr (slice u8)) (default Code)])

;;; An equation `child.attr = value` of an `on` block: the value waits in `sym` until the child
;;; is visited. `target` is a child the pattern names, or `kids` for all of them.
(defstruct EqSlot
  [(target (slice u8)) (attr (slice u8)) (sym (slice u8)) (ty (slice u8))])

;;; A collected attribute some `on` block gives a node's whole value, `c = value`: what the
;;; node's subtree added is taken back, and the value added instead. `mark` is how far the
;;; collection had got when the node was reached.
(defstruct OvrSlot
  [(attr (slice u8)) (sym (slice u8)) (ty (slice u8)) (mark (slice u8))])  ; top-level forms expressions need, such as a parallel map's job

;;; A compiled expression.
(defstruct TE [(code Code) (ty (slice u8))])

(defn te [(code Code) (ty (slice u8))] (-> TE)
  (TE :code code :ty ty))

(defn kid [(n g/Node) (i i64)] (-> g/Node)
  (get (.kids n) i))

(defn list-kids [(n g/Node)] (-> (ArrayList g/Node))
  (.kids n))

(defn none? [(n g/Node)] (-> bool)
  (= (.kind n) (g/KNone)))

(defn text-list [] (-> (ArrayList (slice u8)))
  (ArrayList::new [(slice u8)] (malloc-allocator)))

(defn sym [(s (slice u8))] (-> Code)
  (primitive/code-symbol s))

(defn cat [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (rt/join a b))

(defn cat3 [(a (slice u8)) (b (slice u8)) (c (slice u8))] (-> (slice u8))
  (rt/join (rt/join a b) c))

(defn cat4 [(a (slice u8)) (b (slice u8)) (c (slice u8)) (d (slice u8))]
  (-> (slice u8))
  (rt/join (cat3 a b c) d))

(defn die [(k (mut Comp)) (n g/Node) (msg (slice u8))] (-> never)
  (let [at (rt/line-col (.src k) (.lo n))]
    (dsl/fail-at (.path k) (.line at) (.col at) msg)))

(defn fresh [(k (mut Comp)) (base (slice u8))] (-> (slice u8))
  (set! (.counter k) (+ (.counter k) 1))
  (cat3 base "-" (rt/num-text (.counter k))))

;; ---------------------------------------------------------------- types, as text
;; Int Bool Text Void Never [T] T? {K:V} Fn(A,B)->R, or module.Type: a type is its own
;; canonical name, so equality is text equality.

(defn opt? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t (- (len t) 1)) #\?) (not (rt/at? t 0 "Fn("))))

(defn list? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t 0) #\[)))

(defn map? [(t (slice u8))] (-> bool)
  (and (> (len t) 0) (= (get t 0) #\{)))

(defn fn? [(t (slice u8))] (-> bool)
  (rt/at? t 0 "Fn("))

;;; `T?`; an optional function is `(Fn(A)->R)?`, since `Fn(A)->R?` returns an option.
(defn opt-type [(t (slice u8))] (-> (slice u8))
  (if (fn? t) (cat3 "(" t ")?") (cat t "?")))

(defn opt-of [(t (slice u8))] (-> (slice u8))
  (if (rt/at? t 0 "(Fn(")
      (subslice t 1 (- (len t) 2))
      (subslice t 0 (- (len t) 1))))

(defn elem-of [(t (slice u8))] (-> (slice u8))
  (subslice t 1 (- (len t) 1)))

;;; Position of a top-level `c` in a type, past `from`.
(defn top-level-at [(t (slice u8)) (from i64) (c u8)] (-> i64)
  (let [(mut depth) 0
        (mut out) -1
        (mut i) from]
    (while (and (< out 0) (< i (len t)))
      (let [x (get t i)]
        (cond (and (= x c) (= depth 0)) (set! out i)
              (or (= x #\[) (= x #\{) (= x #\()) (set! depth (+ depth 1))
              (or (= x #\]) (= x #\}) (= x #\))) (set! depth (- depth 1))
              :else 0))
      (set! i (+ i 1)))
    out))

(defn map-key [(t (slice u8))] (-> (slice u8))
  (subslice t 1 (top-level-at t 1 #\:)))

(defn map-val [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (top-level-at t 1 #\:) 1) (- (len t) 1)))

(defn fn-params [(t (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (text-list)
        close (top-level-at t 3 #\))
        (mut from) 3
        (mut go) (> close 3)]
    (while go
      (let [next (top-level-at t from #\,)]
        (if (and (>= next 0) (< next close))
            (do (push! (mut out) (subslice t from next)) (set! from (+ next 1)))
            (do (push! (mut out) (subslice t from close)) (set! go false)))))
    out))

(defn fn-ret [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (top-level-at t 3 #\)) 3) (len t)))

(defn builtin-type? [(t (slice u8))] (-> bool)
  (or (= t "Int") (= t "Bool") (= t "Text") (= t "Void") (= t "Never")))

;;; The dot before a named type's own name.
(defn last-dot [(t (slice u8))] (-> i64)
  (let [(mut cut) -1]
    (for i (range 0 (len t)) (when (= (get t i) #\.) (set! cut i)))
    cut))

(defn type-module [(t (slice u8))] (-> (slice u8))
  (subslice t 0 (last-dot t)))

(defn type-name [(t (slice u8))] (-> (slice u8))
  (subslice t (+ (last-dot t) 1) (len t)))

(defn alias-of [(module (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (for c module (push! (mut (.bytes b)) (if (= c #\.) #\- c)))
    (finish! (mut b))))

(defn qualified [(k (mut Comp)) (module (slice u8)) (name (slice u8))]
  (-> (slice u8))
  (if (= module (.self k)) name (cat3 (alias-of module) "/" name)))

(defn coil-type [(k (mut Comp)) (t (slice u8))] (-> Code)
  (cond (= t "Int") `i64
        (= t "Bool") `bool
        (= t "Text") `(slice u8)
        (= t "Void") `void
        (= t "Never") `never
        (opt? t) `(Option ~(coil-type (mut k) (opt-of t)))
        (list? t) `(ArrayList ~(coil-type (mut k) (elem-of t)))
        (map? t)
          `(HashMap ~(coil-type (mut k) (map-key t))
                    ~(coil-type (mut k) (map-val t)))
        (fn? t)
          (let [(mut ps) (primitive/code-list-new)]
            (for p (fn-params t) (push! (mut ps) (coil-type (mut k) p)))
            `(fnptr (cc/C) [~@ps] ~(coil-type (mut k) (fn-ret t))))
        :else (sym (qualified (mut k) (type-module t) (type-name t)))))

;; ---------------------------------------------------------------- finding things

(defn mod-index [(k (mut Comp)) (name (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len (.mods k)))
      (when (= (.name (get (.mods k) i)) name) (set! out i)))
    out))

(defn mod-at [(k (mut Comp)) (name (slice u8))] (-> Mod)
  (let [i (mod-index (mut k) name)]
    (when (< i 0) (panic "rules: module {} was not loaded" name))
    (get (.mods k) i)))

(defn self-mod [(k (mut Comp))] (-> Mod)
  (mod-at (mut k) (.self k)))

(defn alias-target [(m Mod) (name (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for a (.aliases m) (when (= (.name a) name) (set! out (Some (.module a)))))
    out))

(defn find-func [(m Mod) (name (slice u8))] (-> (Option Func))
  (let [(mut out) (None [Func])]
    (for f (.funcs m) (when (= (.name f) name) (set! out (Some f))))
    out))

(defn find-rec [(m Mod) (name (slice u8))] (-> (Option RecDef))
  (let [(mut out) (None [RecDef])]
    (for r (.recs m) (when (= (.name r) name) (set! out (Some r))))
    out))

(defn find-enum-of [(m Mod) (variant (slice u8))] (-> (Option EnumDef))
  (let [(mut out) (None [EnumDef])]
    (for e (.enums m)
      (for v (.variants e) (when (= v variant) (set! out (Some e)))))
    out))

(defn find-global [(m Mod) (name (slice u8))] (-> (Option Global))
  (let [(mut out) (None [Global])]
    (for x (.globals m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-kind [(m Mod) (name (slice u8))] (-> (Option syntax/KindEntry))
  (let [(mut out) (None [syntax/KindEntry])]
    (for x (.kinds m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-rel [(m Mod) (name (slice u8))] (-> (Option RelDef))
  (let [(mut out) (None [RelDef])]
    (for x (.rels m) (when (= (.name x) name) (set! out (Some x))))
    out))

(defn find-enum-named [(m Mod) (name (slice u8))] (-> (Option EnumDef))
  (let [(mut out) (None [EnumDef])]
    (for e (.enums m) (when (= (.name e) name) (set! out (Some e))))
    out))

(defn has-type? [(m Mod) (name (slice u8))] (-> bool)
  (or (match (find-rec m name) (Some [_] true) (None [] false))
      (match (find-enum-named m name) (Some [_] true) (None [] false))
      (let [(mut hit) false]
        (for t (.types m) (when (= t name) (set! hit true)))
        hit)))

;;; A type written in module `m`'s file.
(defn resolve-type [(k (mut Comp)) (m (slice u8)) (n g/Node)] (-> (slice u8))
  (let [mo (mod-at (mut k) m)]
    (match (.kind n)
      (g/KUpper []
                (let [name (.text n)]
                  (cond (builtin-type? name) name
                        (has-type? mo name) (cat3 m "." name)
                        (and (> (len (.over mo)) 0)
                             (has-type? (mod-at (mut k) (.over mo)) name))
                          (cat3 (.over mo) "." name)
                        (has-type? (mod-at (mut k) "hl.rt") name)
                          (cat "hl.rt." name)
                        :else (die (mut k) n (cat "no type named " name)))))
      (g/KTQual []
                (match (alias-target mo (.text (kid n 0)))
                  (None []
                        (die (mut k)
                             n
                             (cat "no module imported as " (.text (kid n 0)))))
                  (Some [target]
                        (let [name (.text (kid n 1))]
                          (unless (has-type? (mod-at (mut k) target) name)
                            (die (mut k)
                                 n
                                 (cat4 target " has no type named " name "")))
                          (cat3 target "." name)))))
      (g/KTOpt [] (opt-type (resolve-type (mut k) m (kid n 0))))
      (g/KTList [] (cat3 "[" (resolve-type (mut k) m (kid n 0)) "]"))
      (g/KTMap []
               (cat4 "{"
                     (resolve-type (mut k) m (kid n 0))
                     ":"
                     (cat (resolve-type (mut k) m (kid n 1)) "}")))
      (g/KTFn []
              (let [(mut b) (str/StrBuf::new (malloc-allocator))
                    (mut first) true]
                (push-str! (mut b) "Fn(")
                (for p (list-kids (kid n 0))
                  (unless first (push-str! (mut b) ","))
                  (set! first false)
                  (push-str! (mut b) (resolve-type (mut k) m p)))
                (push-str! (mut b) ")->")
                (push-str! (mut b) (resolve-type (mut k) m (kid n 1)))
                (finish! (mut b))))
      (g/KTMut [] (resolve-type (mut k) m (kid n 0)))
      (_ (die (mut k) n "expected a type")))))

;; ---------------------------------------------------------------- reading signatures

(defn mod-new [(name (slice u8)) (sort Sort) (over (slice u8))] (-> Mod)
  (Mod
    :name name
    :sort sort
    :funcs (ArrayList::new [Func] (malloc-allocator))
    :recs (ArrayList::new [RecDef] (malloc-allocator))
    :enums (ArrayList::new [EnumDef] (malloc-allocator))
    :globals (ArrayList::new [Global] (malloc-allocator))
    :types (text-list)
    :kinds (ArrayList::new [syntax/KindEntry] (malloc-allocator))
    :rels (ArrayList::new [RelDef] (malloc-allocator))
    :quotes (ArrayList::new [QuoteDef] (malloc-allocator))
    :aliases (ArrayList::new [Alias] (malloc-allocator))
    :over over))

(defn func-of [(name (slice u8)) (ret (slice u8))] (-> Func)
  (Func
    :name name
    :coil name
    :params (ArrayList::new [Param] (malloc-allocator))
    :ret ret))

(defn param [(f (mut Func)) (name (slice u8)) (ty (slice u8)) (by-ref bool)]
  (-> void)
  (push! (mut (.params f))
         (Param
           :name name
           :ty ty
           :by-ref by-ref)))

(defn parse-file [(k (mut Comp)) (src (slice u8)) (path (slice u8))] (-> g/Node)
  (match (g/parse-result src path 0)
    (Ok [t] (with-accumulators (with-everywhere src path t)))
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

;; ---------------------------------------------------------------- everywhere functions

;;; `everywhere fn f(n: Node, …) -> Node = match n { cases }`: a function over a whole tree, whose
;;; cases say only where it does something. Anywhere else it is `f` of each child: the node rebuilt
;;; from them, shared when none changed; for `-> Void`, each child visited; for `-> Bool`, whether
;;; any child's is true; for a list, the children's lists one after another. Read as the plain function with that last case, which is what everything
;;; after the parse sees.
(defn with-everywhere [(src (slice u8)) (path (slice u8)) (tree g/Node)]
  (-> g/Node)
  (let [decls (kid tree 2)
        (mut any) false]
    (for d (.kids decls) (when (= (.kind d) (g/KEverywhereFn)) (set! any true)))
    (if (not any)
        tree
        (let [(mut out) (g/new-kids)]
          (for d (.kids decls)
            (cond (not (= (.kind d) (g/KEverywhereFn))) (push! (mut out) d)
                  (= (.kind (kid d 2)) (g/KTList))
                    (for f (everywhere-list-fns src path d) (push! (mut out) f))
                  :else (push! (mut out) (everywhere-fn src path d))))
          (let [(mut t) tree
                (mut kids) (g/new-kids)]
            (push! (mut kids) (kid tree 0))
            (push! (mut kids) (kid tree 1))
            (push! (mut kids) (g/mk (g/KList) out (.lo decls) (.hi decls)))
            (set! (.kids t) kids)
            t)))))

(defn sugar-fail [(src (slice u8))
                  (path (slice u8))
                  (n g/Node)
                  (msg (slice u8))] (-> never)
  (dsl/fail-at path (rt/line-of src (.lo n)) (rt/col-of src (.lo n)) msg))

(defn name-node [(text (slice u8)) (at g/Node)] (-> g/Node)
  (g/leaf (g/KName) text (.lo at) (.lo at)))

(defn list-node [(xs (ArrayList g/Node)) (at g/Node)] (-> g/Node)
  (g/mk (g/KList) xs (.lo at) (.hi at)))

(defn one [(x g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)] (push! (mut out) x) out))

(defn three [(a g/Node) (b g/Node) (c g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)]
    (push! (mut out) a)
    (push! (mut out) b)
    (push! (mut out) c)
    out))

;;; The child, then the function's other parameters as they were given.
(defn passed-on [(each (slice u8)) (params (ArrayList g/Node)) (at g/Node)]
  (-> (ArrayList g/Node))
  (let [(mut out) (g/new-kids)]
    (push! (mut out) (name-node each at))
    (for i (range 1 (len params))
      (push! (mut out) (name-node (.text (kid (get params i) 0)) at)))
    out))

(defn everywhere-fn [(src (slice u8)) (path (slice u8)) (d g/Node)] (-> g/Node)
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)]
    (when (= (len params) 0)
      (sugar-fail src path d "an everywhere function takes the node first"))
    (let [node (.text (kid (get params 0) 0))]
      (unless (and (= (.kind body) (g/KMatch))
                   (= (.kind (kid body 0)) (g/KName))
                   (= (.text (kid body 0)) node))
        (sugar-fail src
                    path
                    body
                    (cat3 "an everywhere function is a match on its node, "
                          node
                          "")))
      (for arm (.kids (kid body 1))
        (let [p (kid arm 0)]
          (when (and (= (.kind p) (g/KName))
                     (= (.text p) "_")
                     (= (.kind (kid arm 1)) (g/KNone)))
            (sugar-fail src
                        path
                        arm
                        "an everywhere function's last case is its children, so it has no `_` of its own"))))
      (let [each "each-kid"
            call
              (g/node2 (g/KCall)
                       (name-node (.text fname) body)
                       (list-node (passed-on each params body) body))
            kids-of
              (g/node2 (g/KFieldE)
                       (name-node node body)
                       (name-node "kids" body))
            head (g/node2 (g/KInHead) (name-node each body) kids-of)
            void
              (or (= (.kind ret) (g/KNone))
                  (and (= (.kind ret) (g/KUpper)) (= (.text ret) "Void")))
            bool (and (= (.kind ret) (g/KUpper)) (= (.text ret) "Bool"))
            walk
              (cond void
                      (g/node2 (g/KFor)
                               head
                               (g/mk (g/KBlock)
                                     (one (list-node (one call) body))
                                     (.lo body)
                                     (.hi body)))
                    bool
                      (g/mk (g/KAny)
                            (three head (list-node (g/new-kids) body) call)
                            (.lo body)
                            (.hi body))
                    :else
                      (let [(mut ck) (g/new-kids)]
                        (push! (mut ck) call)
                        (push! (mut ck) (list-node (one head) body))
                        (g/node2 (g/KWithE)
                                 (name-node node body)
                                 (list-node (one (g/node2 (g/KFieldInit)
                                                          (name-node "kids"
                                                                     body)
                                                          (g/mk (g/KComp)
                                                                ck
                                                                (.lo body)
                                                                (.hi body))))
                                            body))))
            (mut arms) (g/new-kids)]
        (for a (.kids (kid body 1)) (push! (mut arms) a))
        (push! (mut arms)
               (g/mk (g/KArm)
                     (three (name-node "_" body) (g/none-node) walk)
                     (.lo body)
                     (.hi body)))
        (let [(mut fn-kids) (g/new-kids)]
          (push! (mut fn-kids) fname)
          (push! (mut fn-kids) (kid d 1))
          (push! (mut fn-kids) ret)
          (push! (mut fn-kids)
                 (g/node2 (g/KMatch) (kid body 0) (list-node arms (kid body 1))))
          (g/mk (g/KFn) fn-kids (.lo d) (.hi d)))))))

;;; The cases' checks: a match on the node, with no `_` of its own.
(defn everywhere-check [(src (slice u8)) (path (slice u8)) (d g/Node)] (-> void)
  (let [params (.kids (kid d 1))
        body (kid d 3)]
    (when (= (len params) 0)
      (sugar-fail src path d "an everywhere function takes the node first"))
    (let [node (.text (kid (get params 0) 0))]
      (unless (and (= (.kind body) (g/KMatch))
                   (= (.kind (kid body 0)) (g/KName))
                   (= (.text (kid body 0)) node))
        (sugar-fail src
                    path
                    body
                    (cat3 "an everywhere function is a match on its node, "
                          node
                          "")))
      (for arm (.kids (kid body 1))
        (let [p (kid arm 0)]
          (when (and (= (.kind p) (g/KName))
                     (= (.text p) "_")
                     (= (.kind (kid arm 1)) (g/KNone)))
            (sugar-fail src
                        path
                        arm
                        "an everywhere function's last case is its children, so it has no `_` of its own")))))))

;;; `everywhere fn f(n: Node, …) -> [T]`: each case's list, and elsewhere the children's in order.
;;; It is two functions: `f-into!`, which adds to one list it is handed, so a walk makes one list
;;; and not one per node, and `f`, which hands it an empty one.
(defn everywhere-list-fns [(src (slice u8)) (path (slice u8)) (d g/Node)]
  (-> (ArrayList g/Node))
  (everywhere-check src path d)
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)
        node (.text (kid (get params 0) 0))
        into (cat (.text fname) "-into!")
        acc "everywhere-out"
        each "each-kid"
        acc-type (g/mk (g/KTMut) (one ret) (.lo ret) (.hi ret))
        (mut into-params) (g/new-kids)
        (mut into-args) (passed-on each params body)
        (mut wrap-args) (passed-on node params body)
        (mut arms) (g/new-kids)]
    (for p params (push! (mut into-params) p))
    (push! (mut into-params) (g/node2 (g/KParam) (name-node acc body) acc-type))
    (push! (mut into-args) (name-node acc body))
    (push! (mut wrap-args) (name-node acc body))
    (for a (.kids (kid body 1))
      (push! (mut arms)
             (g/mk (g/KArm)
                   (three (kid a 0)
                          (kid a 1)
                          (g/node2 (g/KExtend) (name-node acc a) (kid a 2)))
                   (.lo a)
                   (.hi a))))
    (let [call
            (g/node2 (g/KCall) (name-node into body) (list-node into-args body))
          kids-of
            (g/node2 (g/KFieldE) (name-node node body) (name-node "kids" body))
          head (g/node2 (g/KInHead) (name-node each body) kids-of)
          walk
            (g/node2 (g/KFor)
                     head
                     (g/mk (g/KBlock)
                           (one (list-node (one call) body))
                           (.lo body)
                           (.hi body)))
          (mut into-kids) (g/new-kids)
          (mut wrap-kids) (g/new-kids)
          (mut stmts) (g/new-kids)
          (mut out) (g/new-kids)]
      (push! (mut arms)
             (g/mk (g/KArm)
                   (three (name-node "_" body) (g/none-node) walk)
                   (.lo body)
                   (.hi body)))
      (push! (mut into-kids) (name-node into fname))
      (push! (mut into-kids) (list-node into-params (kid d 1)))
      (push! (mut into-kids) (g/none-node))
      (push! (mut into-kids)
             (g/node2 (g/KMatch) (kid body 0) (list-node arms (kid body 1))))
      (push! (mut out) (g/mk (g/KFn) into-kids (.lo d) (.hi d)))
      (push! (mut stmts)
             (g/mk (g/KVar)
                   (three (name-node acc body)
                          ret
                          (g/mk (g/KListLit)
                                (one (list-node (g/new-kids) body))
                                (.lo body)
                                (.lo body)))
                   (.lo body)
                   (.hi body)))
      (push! (mut stmts)
             (g/node2 (g/KCall)
                      (name-node into body)
                      (list-node wrap-args body)))
      (push! (mut stmts) (name-node acc body))
      (push! (mut wrap-kids) fname)
      (push! (mut wrap-kids) (kid d 1))
      (push! (mut wrap-kids) ret)
      (push! (mut wrap-kids)
             (g/mk (g/KBlock)
                   (one (list-node stmts body))
                   (.lo body)
                   (.hi body)))
      (push! (mut out) (g/mk (g/KFn) wrap-kids (.lo d) (.hi d)))
      out)))

;;; A function that gives a list partly made of what it gives itself, `fn f(…) -> [T]` calling `f`, is
;;; two functions, as a list-giving everywhere function is: `f-into!`, adding its answer to a list it
;;; is handed, which its own calls add to as well, and `f`, handing it an empty one. A recursion
;;; then makes one list, not one per call copied into the next. So is one whose list a caller adds
;;; to its own (spread, after `++`, or by `++=`), or that a function with a twin answers with: its
;;; list goes straight into the caller's. Only one with no `return` and an answer at its end.
(defn with-accumulators [(tree g/Node)] (-> g/Node)
  (let [decls (kid tree 2)
        twinned (twinned-names (.kids decls))
        (mut out) (g/new-kids)
        (mut any) false]
    (for d (.kids decls)
      (if (and (accumulates? d) (has-name? twinned (.text (kid d 0))))
          (do
            (set! any true)
            (for f (accumulator-fns d) (push! (mut out) f)))
          (push! (mut out) d)))
    (if (not any)
        tree
        (let [(mut t) tree
              (mut kids) (g/new-kids)]
          (push! (mut kids) (kid tree 0))
          (push! (mut kids) (kid tree 1))
          (push! (mut kids) (g/mk (g/KList) out (.lo decls) (.hi decls)))
          (set! (.kids t) kids)
          t))))

(defn calls-named? [(n g/Node) (name (slice u8))] (-> bool)
  (or (and (= (.kind n) (g/KCall))
           (= (.kind (kid n 0)) (g/KName))
           (= (.text (kid n 0)) name))
      (let [(mut hit) false]
        (for c (.kids n)
          (when (and (not hit) (calls-named? c name)) (set! hit true)))
        hit)))

(defn has-kind? [(n g/Node) (kind g/Kind)] (-> bool)
  (or (= (.kind n) kind)
      (let [(mut hit) false]
        (for c (.kids n)
          (when (and (not hit) (has-kind? c kind)) (set! hit true)))
        hit)))

;;; What a function answers with: its body, or its block's last statement when that is an expression.
(defn answer-of [(body g/Node)] (-> (Option g/Node))
  (if (= (.kind body) (g/KBlock))
      (let [stmts (.kids (kid body 0))]
        (if (= (len stmts) 0)
            (None [g/Node])
            (let [last (get stmts (- (len stmts) 1))
                  kd (.kind last)]
              (if (or (= kd (g/KLet))
                      (= kd (g/KVar))
                      (= kd (g/KFor))
                      (= kd (g/KWhile))
                      (= kd (g/KAssign))
                      (= kd (g/KAppend))
                      (= kd (g/KExtend))
                      (= kd (g/KWithCtx))
                      (= kd (g/KPrint))
                      (= kd (g/KAssert)))
                  (None [g/Node])
                  (Some last)))))
      (Some body)))

(defn accumulates? [(d g/Node)] (-> bool)
  (and (= (.kind d) (g/KFn))
       (= (.kind (kid d 2)) (g/KTList))
       (> (len (.kids (kid d 1))) 0)
       (not (any-mut-param? (.kids (kid d 1))))
       (not (has-kind? (kid d 3) (g/KReturn)))
       (match (answer-of (kid d 3))
         (Some [a]
               (or (calls-named? (kid d 3) (.text (kid d 0))) (builds-list? a)))
         (None [] false))))

(defn has-name? [(names (ArrayList (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x names (when (= x name) (set! hit true)))
    hit))

(defn add-name! [(names (mut (ArrayList (slice u8)))) (name (slice u8))]
  (-> void)
  (unless (has-name? names name) (push! (mut names) name))
  0)

;;; The functions of a module that get twins: those that call themselves, those whose lists a caller
;;; adds to its own, and then those a function with a twin answers with, until there are no more.
(defn twinned-names [(decls (ArrayList g/Node))] (-> (ArrayList (slice u8)))
  (let [(mut wanted) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut out) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut changed) true]
    (for d decls (spread-calls! d (mut wanted)))
    (for d decls
      (when (and (accumulates? d)
                 (or (calls-named? (kid d 3) (.text (kid d 0)))
                     (has-name? wanted (.text (kid d 0)))))
        (add-name! (mut out) (.text (kid d 0)))))
    (while changed
      (set! changed false)
      (for d decls
        (when (and (accumulates? d) (has-name? out (.text (kid d 0))))
          (match (answer-of (kid d 3))
            (Some [a]
                  (let [(mut called)
                          (ArrayList::new [(slice u8)] (malloc-allocator))]
                    (answer-calls! a (mut called))
                    (for d2 decls
                      (when (and (has-name? called (.text (kid d2 0)))
                                 (not (has-name? out (.text (kid d2 0))))
                                 (accumulates? d2))
                        (add-name! (mut out) (.text (kid d2 0)))
                        (set! changed true)))))
            (None [] 0)))))
    out))

;;; Calls whose lists are added to another: spread, after or before `++`, or by `++=`.
(defn spread-calls! [(n g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind n)
    (g/KSpread [] (note-call! (kid n 0) (mut out)))
    (g/KCompSpread [] (note-call! (kid n 0) (mut out)))
    (g/KConcat []
               (do
                 (note-call! (kid n 0) (mut out))
                 (note-call! (kid n 1) (mut out))))
    (g/KExtend [] (note-call! (kid n 1) (mut out)))
    (_ 0))
  (for c (.kids n) (spread-calls! c (mut out)))
  0)

(defn note-call! [(e g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (cond (= (.kind e) (g/KGroup)) (note-call! (kid e 0) (mut out))
        (and (= (.kind e) (g/KCall)) (= (.kind (kid e 0)) (g/KName)))
          (add-name! (mut out) (.text (kid e 0)))
        :else 0))

;;; The calls an answer gives its list from, which a twin hands its list on to.
(defn answer-calls! [(e g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (match (.kind e)
    (g/KCall [] (note-call! e (mut out)))
    (g/KConcat []
               (do
                 (answer-calls! (kid e 0) (mut out))
                 (answer-calls! (kid e 1) (mut out))))
    (g/KCompSpread [] (note-call! (kid e 0) (mut out)))
    (g/KMatch []
              (for a (list-kids (kid e 1)) (answer-calls! (kid a 2) (mut out))))
    (g/KMatchN []
               (for a (list-kids (kid e 2)) (answer-calls! (kid a 3) (mut out))))
    (g/KWhereE [] (answer-calls! (kid e 0) (mut out)))
    (g/KGroup [] (answer-calls! (kid e 0) (mut out)))
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [a] (answer-calls! a (mut out)))
                  (None [] 0)))
    (_ 0))
  0)

;;; A twin's arguments are values, so a function given something to change has none.
(defn any-mut-param? [(params (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for p params (when (= (.kind (kid p 1)) (g/KTMut)) (set! hit true)))
    hit))

;;; Whether an answer makes its list from parts, through its matches, `where`s and `with`s: a list
;;; written out, a comprehension, a concatenation or a call. Its twin adds the parts to the list it is
;;; handed as it makes them, and a caller that spreads it makes no list of its own to copy.
(defn builds-list? [(e g/Node)] (-> bool)
  (match (.kind e)
    (g/KListLit [] true)
    (g/KConcat [] true)
    (g/KComp [] true)
    (g/KCompSpread [] true)
    ;; A call hands the list on: to its own function's twin, when it has one.
    (g/KCall [] true)
    (g/KMatch []
              (let [(mut hit) false]
                (for a (list-kids (kid e 1))
                  (when (builds-list? (kid a 2)) (set! hit true)))
                hit))
    (g/KMatchN []
               (let [(mut hit) false]
                 (for a (list-kids (kid e 2))
                   (when (builds-list? (kid a 3)) (set! hit true)))
                 hit))
    (g/KWhereE [] (builds-list? (kid e 0)))
    (g/KGroup [] (builds-list? (kid e 0)))
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [a] (builds-list? a))
                  (None [] false)))
    (_ false)))

(defn accumulator-fns [(d g/Node)] (-> (ArrayList g/Node))
  (let [fname (kid d 0)
        params (.kids (kid d 1))
        ret (kid d 2)
        body (kid d 3)
        into (cat (.text fname) "-into!")
        acc "accumulated"
        acc-type (g/mk (g/KTMut) (one ret) (.lo ret) (.hi ret))
        (mut into-params) (g/new-kids)
        (mut wrap-args) (g/new-kids)
        (mut stmts) (g/new-kids)
        (mut wrap-stmts) (g/new-kids)
        (mut into-kids) (g/new-kids)
        (mut wrap-kids) (g/new-kids)
        (mut out) (g/new-kids)
        answer
          (match (answer-of body)
            (Some [a] a)
            (None [] (panic "accumulator-fns of a function with no answer")))]
    (for p params (push! (mut into-params) p))
    (push! (mut into-params) (g/node2 (g/KParam) (name-node acc body) acc-type))
    (for p params (push! (mut wrap-args) (name-node (.text (kid p 0)) body)))
    (push! (mut wrap-args) (name-node acc body))
    (when (= (.kind body) (g/KBlock))
      (let [all (.kids (kid body 0))]
        (for i (range 0 (- (len all) 1)) (push! (mut stmts) (get all i)))))
    (push! (mut stmts) (pushed-extend acc answer))
    (push! (mut into-kids) (name-node into fname))
    (push! (mut into-kids) (list-node into-params (kid d 1)))
    (push! (mut into-kids) (g/none-node))
    (push! (mut into-kids)
           (g/mk (g/KBlock) (one (list-node stmts body)) (.lo body) (.hi body)))
    (push! (mut out) (g/mk (g/KFn) into-kids (.lo d) (.hi d)))
    (push! (mut wrap-stmts)
           (g/mk (g/KVar)
                 (three (name-node acc body)
                        ret
                        (g/mk (g/KListLit)
                              (one (list-node (g/new-kids) body))
                              (.lo body)
                              (.lo body)))
                 (.lo body)
                 (.hi body)))
    (push! (mut wrap-stmts)
           (g/node2 (g/KCall) (name-node into body) (list-node wrap-args body)))
    (push! (mut wrap-stmts) (name-node acc body))
    (push! (mut wrap-kids) fname)
    (push! (mut wrap-kids) (kid d 1))
    (push! (mut wrap-kids) ret)
    (push! (mut wrap-kids)
           (g/mk (g/KBlock)
                 (one (list-node wrap-stmts body))
                 (.lo body)
                 (.hi body)))
    (push! (mut out) (g/mk (g/KFn) wrap-kids (.lo d) (.hi d)))
    out))

;;; `acc ++= e`, pushed into `e`'s matches and through its `where`s, so that each arm adds what it
;;; makes as it makes it: an arm that recurses adds through its own accumulator, and nothing is
;;; built only to be copied.
(defn pushed-extend [(acc (slice u8)) (e g/Node)] (-> g/Node)
  (match (.kind e)
    (g/KMatch []
              (let [(mut arms) (g/new-kids)]
                (for a (list-kids (kid e 1))
                  (let [(mut t) a
                        (mut ks) (g/new-kids)]
                    (push! (mut ks) (kid a 0))
                    (push! (mut ks) (kid a 1))
                    (push! (mut ks) (pushed-extend acc (kid a 2)))
                    (set! (.kids t) ks)
                    (push! (mut arms) t)))
                (g/node2 (g/KMatch) (kid e 0) (list-node arms (kid e 1)))))
    (g/KMatchN []
               (let [(mut arms) (g/new-kids)]
                 (for a (list-kids (kid e 2))
                   (let [(mut t) a
                         (mut ks) (g/new-kids)]
                     (push! (mut ks) (kid a 0))
                     (push! (mut ks) (kid a 1))
                     (push! (mut ks) (kid a 2))
                     (push! (mut ks) (pushed-extend acc (kid a 3)))
                     (set! (.kids t) ks)
                     (push! (mut arms) t)))
                 (g/mk (g/KMatchN)
                       (three (kid e 0) (kid e 1) (list-node arms (kid e 2)))
                       (.lo e)
                       (.hi e))))
    (g/KWhereE [] (g/node2 (g/KWhereE) (pushed-extend acc (kid e 0)) (kid e 1)))
    (g/KGroup [] (pushed-extend acc (kid e 0)))
    ;; `with x = v { … e }`: `e` goes in while `x` is `v`.
    (g/KWithCtx []
                (match (answer-of (kid e 1))
                  (Some [_]
                        (let [block (kid e 1)
                              stmts (list-kids (kid block 0))
                              (mut ks) (g/new-kids)]
                          (for i (range 0 (- (len stmts) 1))
                            (push! (mut ks) (get stmts i)))
                          (push! (mut ks)
                                 (pushed-extend acc
                                                (get stmts (- (len stmts) 1))))
                          (g/node2 (g/KWithCtx)
                                   (kid e 0)
                                   (g/mk (g/KBlock)
                                         (one (list-node ks block))
                                         (.lo block)
                                         (.hi block)))))
                  (None [] (g/node2 (g/KExtend) (name-node acc e) e))))
    (g/KPanic [] e)
    (_ (g/node2 (g/KExtend) (name-node acc e) e))))

;;; `"bundle.js" = "src/bundle/js.syntax"` lines under [modules].
(defn read-manifest! [(k (mut Comp)) (manifest (slice u8))] (-> void)
  (set! (.base k) (rt/dir-of manifest))
  (let [text (rt/read-all manifest)
        (mut start) 0
        (mut in-modules) false]
    (for i (range 0 (+ (len text) 1))
      (when (or (= i (len text)) (= (get text i) #\newline))
        (let [line (subslice text start i)]
          (set! start (+ i 1))
          (cond (rt/at? line 0 "[") (set! in-modules (= line "[modules]"))
                (and in-modules (rt/at? line 0 "\""))
                  (let [(mut quotes) (ArrayList::new [i64] (malloc-allocator))]
                    (for j (range 0 (len line))
                      (when (= (get line j) #\") (push! (mut quotes) j)))
                    (when (= (len quotes) 4)
                      (push! (mut (.table k))
                             (Alias
                               :name
                                 (subslice line
                                           (+ (get quotes 0) 1)
                                           (get quotes 1))
                               :module
                                 (subslice line
                                           (+ (get quotes 2) 1)
                                           (get quotes 3))))))
                :else 0))))))

(defn file-of [(k (mut Comp)) (module (slice u8))] (-> (Option (slice u8)))
  (let [(mut out) (None [(slice u8)])]
    (for a (.table k)
      (when (= (.name a) module)
        (set! out (Some (cat3 (.base k) "/" (.module a))))))
    out))

(defn grammar-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SGrammar) "")
        node (cat module ".Node")]
    (set! (.kinds m) (syntax/grammar-table (rt/read-all path) path))
    (push! (mut (.types m)) "Node")
    (push! (mut (.types m)) "Kind")
    (let [(mut f) (func-of "parse" node)]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-tries" node)]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "base" "Int" false)
      (param (mut f) "more" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-opt" (cat node "?"))]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "flags" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "parse-piece" (cat node "?"))]
      (param (mut f) "src" "Text" false)
      (param (mut f) "path" "Text" false)
      (param (mut f) "flags" "Int" false)
      (param (mut f) "from" "Int" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "flag-bit" "Int")]
      (param (mut f) "name" "Text" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "render" "Text")]
      (param (mut f) "n" node false)
      (param (mut f) "pretty" "Bool" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "render-tracked" "hl.rt.Rendered")]
      (param (mut f) "n" node false)
      (param (mut f) "pretty" "Bool" false)
      (param (mut f) "tracking" "Bool" false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "opaque-spine?" "Bool")]
      (param (mut f) "n" node false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "kind-name" "Text")]
      (param (mut f) "k" (cat module ".Kind") false)
      (push! (mut (.funcs m)) f))
    m))

(defn facts-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))] (-> Mod)
  (let [(mut m) (mod-new module (SFacts) "")
        src (rt/read-all path)
        db (cat module ".Db")
        tree
          (match (gf/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (cat "expected " (.want e)))))]
    (push! (mut (.types m)) "Db")
    (push! (mut (.types m)) "Fact")
    (for item (.kids (get (.kids tree) 0))
      (when (= (.kind item) (gf/KRelation))
        (push! (mut (.rels m))
               (RelDef
                 :name (.text (get (.kids item) 0))
                 :arity (len (.kids (get (.kids item) 1)))))
        ;; `link.fact-REL(a, b)`: the row as a value.
        (let [(mut f)
                (func-of (cat "fact-" (.text (get (.kids item) 0)))
                         (cat module ".Fact"))]
          (for c (range 0 (len (.kids (get (.kids item) 1))))
            (param (mut f) (cat "a" (rt/num-text c)) "Int" false))
          (push! (mut (.funcs m)) f))))
    (let [(mut f) (func-of "add-facts!" "Void")]
      (param (mut f) "db" db true)
      (param (mut f) "facts" (cat3 "[" module ".Fact]") false)
      (push! (mut (.funcs m)) f))
    (push! (mut (.funcs m)) (func-of "new-db" db))
    (let [(mut f) (func-of "solved" db)]
      (param (mut f) "facts" (cat3 "[" module ".Fact]") false)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "solve!" "Int")]
      (param (mut f) "db" db true)
      (push! (mut (.funcs m)) f))
    (let [(mut f) (func-of "reserve!" "Void")]
      (param (mut f) "db" db true)
      (param (mut f) "name" "Text" false)
      (param (mut f) "n" "Int" false)
      (push! (mut (.funcs m)) f))
    m))

;;; A `.rewrite`, `.scopes` or `.pipeline` file read by its own grammar, for what its header names.
(defn rewrite-tree [(path (slice u8))] (-> grw/Node)
  (match (grw/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn scopes-tree [(path (slice u8))] (-> gsc/Node)
  (match (gsc/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn pipeline-tree [(path (slice u8))] (-> gpl/Node)
  (match (gpl/parse-result (rt/read-all path) path 0)
    (Ok [t] t)
    (Err [e] (dsl/fail-at path (.line e) (.col e) (cat "expected " (.want e))))))

(defn rewrite-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SRewrite) "")
        ;; The file's own header names its grammar.
        grammar (.text (get (.kids (rewrite-tree path)) 0))]
    (let [node (cat grammar ".Node")
          (mut f) (func-of "run" node)]
      (ensure-loaded! (mut k) grammar)
      (param (mut f) "n" node false)
      (push! (mut (.funcs m)) f))
    m))

;;; A `.pipeline` module: `plan(name)` answers the record its header says it fills.
(defn pipeline-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))]
  (-> Mod)
  (let [(mut m) (mod-new module (SRewrite) "")
        fills (.text (get (.kids (pipeline-tree path)) 1))]
    (let [(mut slash) 0]
      (for i (range 0 (len fills)) (when (= (get fills i) #\/) (set! slash i)))
      (let [record-module (subslice fills 0 slash)
            record
              (cat3 record-module "." (subslice fills (+ slash 1) (len fills)))]
        (ensure-loaded! (mut k) record-module)
        (let [(mut f) (func-of "plan" record)]
          (param (mut f) "name" "Text" false)
          (push! (mut (.funcs m)) f))
        (push! (mut (.funcs m)) (func-of "plan-names" "[Text]"))))
    m))

(defn scopes-mod [(k (mut Comp)) (module (slice u8)) (path (slice u8))] (-> Mod)
  (let [(mut m) (mod-new module (SScopes) "")
        grammar (.text (get (.kids (scopes-tree path)) 0))]
    (let [node (cat grammar ".Node")
          kind (cat grammar ".Kind")]
      (ensure-loaded! (mut k) grammar)
      (let [(mut f) (func-of "analyze" "Int")]
        (param (mut f) "tree" node false)
        (param (mut f) "table" "hl.symtab.Table" true)
        (param (mut f) "parent" "Int" false)
        (param (mut f) "bindings" "{Int:Int}" true)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "declare-program!" "Void")]
        (param (mut f) "tree" node false)
        (param (mut f) "table" "hl.symtab.Table" true)
        (param (mut f) "root" "Int" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "analysis" "hl.symtab.Analysis")]
        (param (mut f) "tree" node false)
        (param (mut f) "outer" "[Text]" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "declarations" "hl.symtab.Analysis")]
        (param (mut f) "tree" node false)
        (param (mut f) "outer" "[Text]" false)
        (push! (mut (.funcs m)) f))
      (let [(mut f) (func-of "part-analysis" "hl.symtab.Analysis")]
        (param (mut f) "table" "hl.symtab.Table" false)
        (param (mut f) "scope" "Int" false)
        (param (mut f) "parts" (cat3 "[" node "]") false)
        (push! (mut (.funcs m)) f))
      (for name ["opens?" "sequential?" "ref?" "bind?"]
        (let [(mut f) (func-of name "Bool")]
          (param (mut f) "k" kind false)
          (push! (mut (.funcs m)) f)))
      (for name ["scope-kind" "names-in"]
        (let [(mut f) (func-of name "Text")]
          (param (mut f) "k" kind false)
          (push! (mut (.funcs m)) f))))
    m))

(defn ensure-loaded! [(k (mut Comp)) (module (slice u8))] (-> void)
  (when (< (mod-index (mut k) module) 0)
    (match (file-of (mut k) module)
      (None []
            (dsl/fail-at (.path k)
                         1
                         1
                         (cat3 "no file for the module "
                               module
                               "; list it under [modules]")))
      (Some [path]
            (push! (mut (.depends k)) path)
            (cond (or (rt/ends-with path ".rules") (rt/ends-with path ".attrs"))
                    (load-rules-file! (mut k) path (rt/read-all path) false)
                  (rt/ends-with path ".syntax")
                    (push! (mut (.mods k)) (grammar-mod (mut k) module path))
                  (rt/ends-with path ".facts")
                    (push! (mut (.mods k)) (facts-mod (mut k) module path))
                  (rt/ends-with path ".rewrite")
                    (let [m (rewrite-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  (rt/ends-with path ".scopes")
                    (let [m (scopes-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  (rt/ends-with path ".pipeline")
                    (let [m (pipeline-mod (mut k) module path)]
                      (push! (mut (.mods k)) m))
                  :else
                    (dsl/fail-at (.path k)
                                 1
                                 1
                                 (cat "cannot read the signatures of " path)))))))

(defn add-foreign! [(k (mut Comp)) (decl g/Node) (owner (slice u8))] (-> void)
  (let [module (.text (kid decl 0))
        alias (.text (kid decl 1))
        items (list-kids (kid decl 2))]
    (when (< (mod-index (mut k) module) 0)
      (push! (mut (.mods k)) (mod-new module (SForeign) "")))
    (let [ix (mod-index (mut k) module)]
      ;; Names first, so items can mention each other in any order.
      (for item items
        (match (.kind item)
          (g/KFType []
                    (unless (has-type? (get (.mods k) ix) (.text (kid item 0)))
                      (push! (mut (.types (elem (mut (.mods k)) ix)))
                             (.text (kid item 0)))))
          (g/KFRecord []
                      (unless (has-type? (get (.mods k) ix)
                                         (.text (kid item 0)))
                        (push! (mut (.recs (elem (mut (.mods k)) ix)))
                               (RecDef
                                 :name (.text (kid item 0))
                                 :fields
                                   (ArrayList::new [FieldDef]
                                                   (malloc-allocator))))))
          (_ 0)))
      (for item items
        (match (.kind item)
          (g/KFRecord []
                      (let [rec-name (.text (kid item 0))
                            (mut rec-at) -1]
                        (for i (range 0 (len (.recs (get (.mods k) ix))))
                          (when (= (.name (get (.recs (get (.mods k) ix)) i))
                                   rec-name)
                            (set! rec-at i)))
                        (when (= (len (.fields (get (.recs (get (.mods k) ix))
                                                    rec-at)))
                                 0)
                          (for f (list-kids (kid item 1))
                            (let [ty (resolve-type (mut k) module (kid f 1))]
                              (push! (mut (.fields (elem (mut (.recs (elem (mut (.mods k))
                                                                           ix)))
                                                         rec-at)))
                                     (FieldDef :name (.text (kid f 0)) :ty ty)))))))
          (g/KFFn []
                  (let [name (.text (kid item 0))
                        coil-name
                          (if (none? (kid item 1)) name (.text (kid item 1)))
                        (mut f)
                          (Func
                            :name name
                            :coil coil-name
                            :params (ArrayList::new [Param] (malloc-allocator))
                            :ret
                              (if (none? (kid item 3))
                                  "Void"
                                  (resolve-type (mut k) module (kid item 3))))]
                    (for p (list-kids (kid item 2))
                      (push! (mut (.params f))
                             (Param
                               :name (.text (kid p 0))
                               :ty (resolve-type (mut k) module (kid p 1))
                               :by-ref (= (.kind (kid p 1)) (g/KTMut)))))
                    (match (find-func (get (.mods k) ix) name)
                      (None []
                            (push! (mut (.funcs (elem (mut (.mods k)) ix))) f))
                      (Some [_] 0))))
          (_ 0))))
    (let [(mut at) (mod-index (mut k) owner)]
      (push! (mut (.aliases (elem (mut (.mods k)) at)))
             (Alias :name alias :module module)))))

;;; Read a file's declarations. The body is compiled only for the module being read.
(defn load-rules-file! [(k (mut Comp))
                        (path (slice u8))
                        (src (slice u8))
                        (is-self bool)] (-> g/Node)
  (let [saved-src (.src k)
        saved-path (.path k)
        tree (parse-file (mut k) src path)
        name (.text (kid tree 0))
        over (if (none? (kid tree 1)) "" (.text (kid tree 1)))
        decls (list-kids (kid tree 2))]
    (set! (.src k) src)
    (set! (.path k) path)
    (when (> (len over) 0) (ensure-loaded! (mut k) over))
    (for d decls
      (when (or (= (.kind d) (g/KUse)) (= (.kind d) (g/KInclude)))
        (ensure-loaded! (mut k) (.text (kid d 0)))))
    (push! (mut (.mods k)) (mod-new name (SRules) over))
    (let [ix (- (len (.mods k)) 1)]
      (push! (mut (.aliases (elem (mut (.mods k)) ix)))
             (Alias :name "rt" :module "hl.rt"))
      (push! (mut (.aliases (elem (mut (.mods k)) ix)))
             (Alias :name "sym" :module "hl.symtab"))
      (for d decls
        (when (= (.kind d) (g/KUse))
          (push! (mut (.aliases (elem (mut (.mods k)) ix)))
                 (Alias :name (.text (kid d 1)) :module (.text (kid d 0))))))
      (push! (mut (.funcs (elem (mut (.mods k)) ix)))
             (func-of "reset-state!" "Void"))
      ;; Type names before anything that mentions them.
      (for d decls
        (match (.kind d)
          (g/KRecord []
                     (push! (mut (.recs (elem (mut (.mods k)) ix)))
                            (RecDef
                              :name (.text (kid d 0))
                              :fields
                                (ArrayList::new [FieldDef] (malloc-allocator)))))
          (g/KEnum []
                   (let [(mut vs) (text-list)]
                     (for v (list-kids (kid d 1)) (push! (mut vs) (.text v)))
                     (push! (mut (.enums (elem (mut (.mods k)) ix)))
                            (EnumDef :name (.text (kid d 0)) :variants vs))))
          (g/KQuoteDecl []
                        (let [(mut path-out)
                                (ArrayList::new [i64] (malloc-allocator))]
                          (for step (list-kids (kid d 1))
                            (push! (mut path-out) (rt/parse-int (.text step))))
                          (push! (mut (.quotes (elem (mut (.mods k)) ix)))
                                 (QuoteDef
                                   :name (.text (kid d 0))
                                   :path path-out))))
          (_ 0)))
      ;; A record's name is its constructor's, so no other record or enum value may have it.
      (let [(mut names) (text-list)]
        (for d decls
          (when (= (.kind d) (g/KEnum))
            (for v (list-kids (kid d 1)) (push! (mut names) (.text v)))))
        (for d decls
          (when (= (.kind d) (g/KRecord))
            (let [name (.text (kid d 0))]
              (for x names
                (when (= x name)
                  (die (mut k)
                       d
                       (cat3 "the record "
                             name
                             " has the name of a value of an enum, or of a record before it"))))
              (push! (mut names) name)))))
      ;; An attribute grammar's answer is a record its own functions may name, after the
      ;; records written, whose fields are filled in by position.
      (when (= (.kind tree) (g/KAttrsFile))
        (push! (mut (.recs (elem (mut (.mods k)) ix)))
               (RecDef
                 :name "Attrs"
                 :fields (ArrayList::new [FieldDef] (malloc-allocator)))))
      (for d decls
        (when (= (.kind d) (g/KForeign)) (add-foreign! (mut k) d name)))
      ;; add-foreign! may have added modules after this one, but never before it.
      (let [ix2 (mod-index (mut k) name)
            (mut rec-index) 0]
        (for d decls
          (match (.kind d)
            (g/KRecord []
                       (for f (list-kids (kid d 1))
                         (let [ty (resolve-type (mut k) name (kid f 1))]
                           (push! (mut (.fields (elem (mut (.recs (elem (mut (.mods k))
                                                                        ix2)))
                                                      rec-index)))
                                  (FieldDef :name (.text (kid f 0)) :ty ty))))
                       (set! rec-index (+ rec-index 1)))
            (g/KState [] (add-global! (mut k) ix2 name d true))
            (g/KTaskState [] (add-global! (mut k) ix2 name d true))
            (g/KContext [] (add-global! (mut k) ix2 name d true))
            (g/KInh []
                    (attrs-only! (mut k) tree d)
                    (add-global! (mut k) ix2 name d true))
            (g/KGiven []
                      (attrs-only! (mut k) tree d)
                      (add-global! (mut k) ix2 name d true))
            ;; An input is given to an attribute grammar's `run`; a setting is the module's, given by
            ;; `with` for the extent of a call.
            (g/KInput []
                      (attrs-only! (mut k) tree d)
                      (add-global! (mut k) ix2 name d true))
            (g/KSetting [] (add-module-input! (mut k) ix2 name d))
            (g/KCollect []
                        (attrs-only! (mut k) tree d)
                        (add-global! (mut k) ix2 name d true))
            (g/KOn [] (attrs-only! (mut k) tree d))
            (g/KRewrite [] (attrs-only! (mut k) tree d))
            (g/KInclude [] (attrs-only! (mut k) tree d))
            (g/KConst [] (add-global! (mut k) ix2 name d false))
            (g/KMemoFn [] (collect-fn! (mut k) ix2 name d))
            (g/KFn [] (collect-fn! (mut k) ix2 name d))
            (_ 0)))
        (when (any-memo? decls)
          (push! (mut (.funcs (elem (mut (.mods k)) ix2)))
                 (Func
                   :name "forget-memos!"
                   :coil "forget-memos!"
                   :params (ArrayList::new [Param] (malloc-allocator))
                   :ret "Void")))
        (when (= (.kind tree) (g/KAttrsFile))
          (attrs-signature! (mut k) ix2 name over decls))))
    (set! (.src k) saved-src)
    (set! (.path k) saved-path)
    tree))

(defn any-memo? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KMemoFn)) (set! hit true)))
    hit))

(defn collect-fn! [(k (mut Comp)) (ix2 i64) (name (slice u8)) (d g/Node)]
  (-> void)
  (let [(mut f)
          (Func
            :name (.text (kid d 0))
            :coil (.text (kid d 0))
            :params (ArrayList::new [Param] (malloc-allocator))
            :ret
              (if (none? (kid d 2))
                  "Void"
                  (resolve-type (mut k) name (kid d 2))))]
    (for p (list-kids (kid d 1))
      (push! (mut (.params f))
             (Param
               :name (.text (kid p 0))
               :ty (resolve-type (mut k) name (kid p 1))
               :by-ref (= (.kind (kid p 1)) (g/KTMut)))))
    (push! (mut (.funcs (elem (mut (.mods k)) ix2))) f)))

;;; A module's input: one value for the whole program, not a worker's, which only `with` gives it, and
;;; which nothing reads while it has none.
(defn add-module-input! [(k (mut Comp)) (ix i64) (module (slice u8)) (d g/Node)]
  (-> void)
  (let [ty (resolve-type (mut k) module (kid d 1))]
    (push! (mut (.globals (elem (mut (.mods k)) ix)))
           (Global
             :name (.text (kid d 0))
             :ty ty
             :assignable false
             :task false
             :attr 5))))

(defn bound-field [(name (slice u8))] (-> (slice u8))
  (cat name "--bound"))

;;; A module input's value, read where it has one. The check is on the storage, which the field is
;;; then read through, so a field of the value is read without copying the rest.
(defn input-read [(k (mut Comp)) (module (slice u8)) (x Global) (storage Code)] (-> Code)
  (let [st (fresh (mut k) "storage")]
    `(~(primitive/code-symbol "." (.name x)) (let [~(sym st) ~storage]
                                               (when (= (~(primitive/code-symbol "."
                                                                                 (bound-field (.name x))) ~(sym st))
                                                        0)
                                                 (panic ~(cat3 "the input "
                                                               (.name x)
                                                               " was read where nothing gave it a value")))
                                               ;; A memo computing now is made from it.
                                               (when (rt/dep-in-frame?)
                                                 (rt/dep-note-literal! ~(cat4 "s:" module "." (.name x))))
                                               ~(sym st)))))

(defn add-global! [(k (mut Comp))
                   (ix i64)
                   (module (slice u8))
                   (d g/Node)
                   (assignable bool)] (-> void)
  (let [ty (resolve-type (mut k) module (kid d 1))
        ;; A context is rebound for a dynamic extent, which is one thread's.
        task
          (or (= (.kind d) (g/KTaskState))
              (= (.kind d) (g/KContext))
              (= (.kind d) (g/KInh))
              (= (.kind d) (g/KInput))
              (= (.kind d) (g/KCollect))
              (= (.kind d) (g/KGiven)))
        attr
          (cond (= (.kind d) (g/KInh)) 1
                (= (.kind d) (g/KInput)) 2
                (= (.kind d) (g/KCollect)) 3
                (= (.kind d) (g/KGiven)) 4
                :else 0)]
    (push! (mut (.globals (elem (mut (.mods k)) ix)))
           (Global
             :name (.text (kid d 0))
             :ty ty
             :assignable assignable
             :task task
             :attr attr))))

;;; Where a global lives: once per program, or once per worker slot for `task state` and contexts.
;;; A function runs on one thread from start to end, so inside one the slot is looked up once.
(defn storage-call [(k (mut Comp)) (x Global)] (-> Code)
  (cond (not (.task x)) `(rules-state)
        (.in-fn k) (do (set! (.task-used k) true) `rules-task-here)
        :else `(rules-task)))

;;; A global's value. An input has one only while `run` runs: read at any other time it would be
;;; the empty value, silently, so that stops.
(defn global-read [(k (mut Comp)) (x Global)] (-> Code)
  (let [field
          `(~(primitive/code-symbol "." (.name x)) ~(storage-call (mut k) x))]
    (cond (= (.attr x) 5) (input-read (mut k) (.self k) x (storage-call (mut k) x))
          (= (.attr x) 2)
            `(do
               (when (= (.attrs-depth ~(storage-call (mut k) x)) 0)
                 (panic ~(cat3 "the input "
                               (.name x)
                               " was read outside run, where it has no value")))
               ~field)
          :else field)))

(defn storage-of [(k (mut Comp)) (module (slice u8)) (x Global)] (-> Code)
  `(~(sym (qualified (mut k) module (if (.task x) "rules-task" "rules-state")))))

;; ---------------------------------------------------------------- locals

(defn bind-local! [(k (mut Comp))
                   (name (slice u8))
                   (ty (slice u8))
                   (mutable bool)] (-> (slice u8))
  (let [s (fresh (mut k) (cat "v-" name))]
    (push! (mut (.locals k))
           (Local
             :name name
             :ty ty
             :sym s
             :mutable mutable))
    s))

(defn find-local [(k (mut Comp)) (name (slice u8))] (-> (Option Local))
  (let [(mut out) (None [Local])]
    (for l (.locals k) (when (= (.name l) name) (set! out (Some l))))
    out))

(defn locals-mark [(k (mut Comp))] (-> i64)
  (len (.locals k)))

(defn locals-reset! [(k (mut Comp)) (mark i64)] (-> void)
  (while (> (len (.locals k)) mark) (pop! (mut (.locals k))))
  0)

;; ---------------------------------------------------------------- literals

(defn str-literal [(n g/Node)] (-> (slice u8))
  (dsl/unescape (subslice (.text n) 1 (- (len (.text n)) 1))))

(defn char-value [(n g/Node)] (-> i64)
  (let [s (dsl/unescape (subslice (.text n) 1 (- (len (.text n)) 1)))]
    (cast i64 (get s 0))))

;; ---------------------------------------------------------------- checks

(defn expect [(k (mut Comp)) (n g/Node) (e TE) (want (slice u8))] (-> TE)
  (when (and (> (len want) 0)
             (!= want "Void")
             (!= (.ty e) want)
             (!= (.ty e) "Never"))
    (die (mut k) n (cat4 "expected " want ", found " (.ty e))))
  e)

(defn unify [(k (mut Comp)) (n g/Node) (a (slice u8)) (b (slice u8))]
  (-> (slice u8))
  (cond (= a b) a
        (= a "Never") b
        (= b "Never") a
        (or (= a "Void") (= b "Void")) "Void"
        :else (die (mut k) n (cat4 "these branches disagree: " a " and " b))))

;;; A form whose type must come from elsewhere: `none`, `[]` and `{}`.
(defn needs-want? [(n g/Node)] (-> bool)
  (match (.kind n)
    (g/KNoneE [] true)
    (g/KListLit [] (= (len (list-kids (kid n 0))) 0))
    (g/KBlock [] (= (len (list-kids (kid n 0))) 0))
    (_ false)))

(defn new-list [(k (mut Comp)) (elem (slice u8))] (-> Code)
  `(ArrayList::new [~(coil-type (mut k) elem)] (rt/tree-allocator)))

(defn new-map [(k (mut Comp)) (t (slice u8))] (-> Code)
  (cond (= (map-key t) "Text")
          `(HashMap::new [~(coil-type (mut k) (map-key t))
                          ~(coil-type (mut k) (map-val t))]
                         (malloc-allocator)
                         (str/keyops))
        ;; An Int is its own hash, near enough: one multiply, not eight bytes of FNV.
        (= (map-key t) "Int")
          `(HashMap::new [i64 ~(coil-type (mut k) (map-val t))]
                         (malloc-allocator)
                         (i64-keyops))
        :else
          `(HashMap::new-scalar [~(coil-type (mut k) (map-key t))
                                 ~(coil-type (mut k) (map-val t))]
                                (malloc-allocator))))

;; ---------------------------------------------------------------- patterns

(defsum Step
  (STest [(code Code)])
  (SBind [(sym (slice u8)) (code Code)])
  (SSome [(sym (slice u8)) (code Code)]))

(defn wrap-steps [(steps (ArrayList Step)) (i i64) (inner Code)] (-> Code)
  (if (>= i (len steps))
      inner
      (let [rest (wrap-steps steps (+ i 1) inner)]
        (match (get steps i)
          (STest [c] `(when ~c ~rest))
          (SBind [s c] `(let [~(sym s) ~c] ~rest))
          (SSome [s c] `(match ~c (Some [~(sym s)] ~rest) (_ 0)))))))

;;; The grammar a Node type belongs to.
(defn grammar-of-type [(k (mut Comp)) (n g/Node) (ty (slice u8))] (-> Mod)
  (unless (and (not (builtin-type? ty))
               (> (last-dot ty) 0)
               (= (type-name ty) "Node"))
    (die (mut k) n (cat "a node pattern needs a node, but this is " ty)))
  (mod-at (mut k) (type-module ty)))

(defn kind-code [(gr Mod) (name (slice u8))] (-> Code)
  (primitive/code-symbol (alias-of (.name gr)) "/K" name))

;;; The children of a node pattern.
(defn pat-kids! [(k (mut Comp))
                 (p g/Node)
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (arity i64)
                 (steps (mut (ArrayList Step)))] (-> void)
  (let [(mut rest-at) -1
        n (len args)]
    (for i (range 0 n)
      (let [a (get args i)]
        (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
          (when (>= rest-at 0) (die (mut k) a "a pattern has at most one rest"))
          (set! rest-at i))))
    (let [fixed (if (>= rest-at 0) (- n 1) n)]
      (cond (and (>= arity 0) (< rest-at 0) (!= fixed arity))
              (die (mut k)
                   p
                   (cat4 "this node has "
                         (rt/num-text arity)
                         " children, this pattern has "
                         (rt/num-text fixed)))
            (and (>= arity 0) (> fixed arity))
              (die (mut k)
                   p
                   (cat4 "this node has "
                         (rt/num-text arity)
                         " children, this pattern has "
                         (rt/num-text fixed)))
            (and (< arity 0) (< rest-at 0))
              (push! (mut steps) (STest `(= (len (.kids ~subject)) ~fixed)))
            (and (< arity 0) (>= rest-at 0) (> fixed 0))
              (push! (mut steps) (STest `(>= (len (.kids ~subject)) ~fixed)))
            :else 0))
    (for i (range 0 n)
      (let [a (get args i)]
        (cond (= (.kind a) (g/KPAny)) 0
              (= (.kind a) (g/KRest))
                (let [name (subslice (.text a) 0 (- (len (.text a)) 3))
                      after (- n (+ i 1))
                      s (bind-local! (mut k) name (cat3 "[" ty "]") false)
                      whole (and (= i 0) (= after 0))]
                  (push! (mut steps)
                         (SBind s
                                (if whole
                                    `(.kids ~subject)
                                    `(~(primitive/code-symbol (alias-of (type-module ty))
                                                              "/sublist") (.kids ~subject)
                                        ~i
                                        (- (len (.kids ~subject)) ~after))))))
              :else
                (let [index
                        (if (or (< rest-at 0) (< i rest-at))
                            `~i
                            `(- (len (.kids ~subject)) ~(- n i)))]
                  (if (and (= (.kind a) (g/KName)) (= (.text a) "_"))
                      0
                      (if (= (.kind a) (g/KName))
                          (let [s (bind-local! (mut k) (.text a) ty false)]
                            (push! (mut steps)
                                   (SBind s `(get (.kids ~subject) ~index))))
                          (let [t (fresh (mut k) "s")]
                            (push! (mut steps)
                                   (SBind t `(get (.kids ~subject) ~index)))
                            (pat! (mut k) a (sym t) ty (mut steps) ""))))))))))

;;; A node pattern. `known` is the kind a dispatch has already established.
(defn pat-node! [(k (mut Comp))
                 (p g/Node)
                 (name (slice u8))
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))
                 (known (slice u8))] (-> void)
  (let [gr (grammar-of-type (mut k) p ty)]
    (match (find-kind gr name)
      (None []
            (die (mut k)
                 p
                 (cat4 "the grammar " (.name gr) " has no node named " name)))
      (Some [entry]
            (when (!= known name)
              (push! (mut steps)
                     (STest `(= (.kind ~subject) (~(kind-code gr name))))))
            (if (.leaf entry)
                (do
                  (unless (= (len args) 1)
                    (die (mut k)
                         p
                         (cat name
                              " is a token: its pattern has one argument, its text")))
                  (let [a (get args 0)]
                    (match (.kind a)
                      (g/KStr []
                              (push! (mut steps)
                                     (STest `(rt/leaf-is? (.text ~subject)
                                                          ~(str-literal a)))))
                      (g/KName []
                               (unless (= (.text a) "_")
                                 (let [s
                                         (bind-local! (mut k)
                                                      (.text a)
                                                      "Text"
                                                      false)]
                                   (push! (mut steps)
                                          (SBind s `(.text ~subject))))))
                      (g/KPAny [] 0)
                      (_ (die (mut k)
                              a
                              "a token's pattern is a name, _ or a string")))))
                (pat-kids! (mut k) p args subject ty (.arity entry) (mut steps)))))))

;;; A record type of the program's, which a pattern takes apart by its fields' names.
(defn record-type? [(k (mut Comp)) (ty (slice u8))] (-> bool)
  (and (not (builtin-type? ty))
       (not (list? ty))
       (not (map? ty))
       (not (opt? ty))
       (not (fn? ty))
       (> (last-dot ty) 0)
       (!= (type-name ty) "Node")
       (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
         (Some [_] true)
         (None [] false))))

;;; `Options(explicit: true, ...)`: each named field matches its pattern. Without `...` every field
;;; is named, so adding a field to the record is noticed where it is taken apart.
(defn pat-record! [(k (mut Comp))
                   (p g/Node)
                   (name (slice u8))
                   (args (ArrayList g/Node))
                   (subject Code)
                   (ty (slice u8))
                   (steps (mut (ArrayList Step)))] (-> void)
  (unless (= name (type-name ty))
    (die (mut k) p (cat4 "this pattern is a " name ", but the value is a " ty)))
  (let [(mut open) false
        (mut named) 0]
    (for a args
      (cond (= (.kind a) (g/KPAny)) (set! open true)
            (= (.kind a) (g/KPField))
              (let [field (.text (kid a 0))
                    fty (field-type (mut k) a ty field)
                    t (fresh (mut k) "f")]
                (set! named (+ named 1))
                (push! (mut steps)
                       (SBind t `(~(primitive/code-symbol "." field) ~subject)))
                (pat! (mut k) (kid a 1) (sym t) fty (mut steps) ""))
            :else
              (die (mut k)
                   a
                   "a record's pattern names its fields: `field: pattern`, or `...` for the rest")))
    (unless open
      (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
        (Some [r]
              (unless (= named (len (.fields r)))
                (die (mut k)
                     p
                     (cat3 "this pattern leaves out fields of "
                           ty
                           "; end it with `...` to say so"))))
        (None [] 0)))))

;;; `"./" ++ rest`, `stem ++ ".js"`: text that starts, or ends, with a literal, and the rest of it.
(defn pat-text! [(k (mut Comp))
                 (p g/Node)
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))] (-> void)
  (unless (= ty "Text")
    (die (mut k) p (cat "a pattern with ++ takes text apart, but this is " ty)))
  (let [a (kid p 0)
        b (kid p 1)
        rest (fresh (mut k) "rest")]
    (cond (= (.kind a) (g/KStr))
            (let [lit (str-literal a)]
              (push! (mut steps) (STest `(rt/starts-with ~subject ~lit)))
              (push! (mut steps)
                     (SBind rest `(subslice ~subject ~(len lit) (len ~subject))))
              (pat! (mut k) b (sym rest) "Text" (mut steps) ""))
          (= (.kind b) (g/KStr))
            (let [lit (str-literal b)]
              (push! (mut steps) (STest `(rt/ends-with ~subject ~lit)))
              (push! (mut steps)
                     (SBind rest
                            `(subslice ~subject 0 (- (len ~subject) ~(len lit)))))
              (pat! (mut k) a (sym rest) "Text" (mut steps) ""))
          ;; `m ++ "e" ++ x`: split where the literal first appears.
          (and (= (.kind b) (g/KPCat)) (= (.kind (kid b 0)) (g/KStr)))
            (let [lit (str-literal (kid b 0))
                  at (fresh (mut k) "at")
                  before (fresh (mut k) "before")]
              (push! (mut steps) (SSome at `(rt/index-of ~subject ~lit)))
              (push! (mut steps)
                     (SBind before `(subslice ~subject 0 ~(sym at))))
              (push! (mut steps)
                     (SBind rest
                            `(subslice ~subject
                                       (+ ~(sym at) ~(len lit))
                                       (len ~subject))))
              (pat! (mut k) a (sym before) "Text" (mut steps) "")
              (pat! (mut k) (kid b 1) (sym rest) "Text" (mut steps) ""))
          :else
            (die (mut k)
                 p
                 "a text pattern's ++ has a string at one end, or between two patterns"))))

;;; `[]`, `[x, y]`, `[x, rest...]`, `[..., last]`: a list of so many items, each matching.
(defn pat-list! [(k (mut Comp))
                 (p g/Node)
                 (args (ArrayList g/Node))
                 (subject Code)
                 (ty (slice u8))
                 (steps (mut (ArrayList Step)))] (-> void)
  (unless (list? ty)
    (die (mut k) p (cat "a list pattern takes a list apart, but this is " ty)))
  (let [(mut rest-at) -1
        n (len args)
        elem (elem-of ty)]
    (for i (range 0 n)
      (let [a (get args i)]
        (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
          (when (>= rest-at 0) (die (mut k) a "a pattern has at most one rest"))
          (set! rest-at i))))
    (let [fixed (if (>= rest-at 0) (- n 1) n)]
      (push! (mut steps)
             (STest (if (>= rest-at 0)
                        `(>= (len ~subject) ~fixed)
                        `(= (len ~subject) ~fixed))))
      (for i (range 0 n)
        (let [a (get args i)
              after (- n (+ i 1))]
          (cond (= (.kind a) (g/KPAny)) 0
                (= (.kind a) (g/KRest))
                  (let [name (subslice (.text a) 0 (- (len (.text a)) 3))
                        s (bind-local! (mut k) name ty false)
                        o (fresh (mut k) "out")
                        j (fresh (mut k) "j")]
                    (push! (mut steps)
                           (SBind s
                                  `(let [(mut ~(sym o)) ~(new-list (mut k) elem)]
                                     (for ~(sym j) (range ~i
                                                          (- (len ~subject)
                                                             ~after))
                                       (push! (mut ~(sym o))
                                              (get ~subject ~(sym j))))
                                     ~(sym o)))))
                :else
                  (let [t (fresh (mut k) "e")
                        index
                          (if (or (< rest-at 0) (< i rest-at))
                              `~i
                              `(- (len ~subject) ~(- n i)))]
                    (push! (mut steps) (SBind t `(get ~subject ~index)))
                    (pat! (mut k) a (sym t) elem (mut steps) ""))))))))

;;; `p` against `subject`, adding tests and bindings. Locals stay bound for the caller.
(defn pat! [(k (mut Comp))
            (p g/Node)
            (subject Code)
            (ty (slice u8))
            (steps (mut (ArrayList Step)))
            (known (slice u8))] (-> void)
  (match (.kind p)
    (g/KName []
             (unless (= (.text p) "_")
               (let [s (bind-local! (mut k) (.text p) ty false)]
                 (push! (mut steps) (SBind s subject)))))
    (g/KPAs []
            (pat! (mut k) (kid p 0) subject ty (mut steps) known)
            (let [s (bind-local! (mut k) (.text (kid p 1)) ty false)]
              (push! (mut steps) (SBind s subject))))
    (g/KPOr []
            (let [(mut tests) (primitive/code-list-new)]
              (for alt (list-kids (kid p 1))
                (push! (mut tests) (pat-test (mut k) alt subject ty)))
              (push! (mut steps)
                     (STest `(or ~(pat-test (mut k) (kid p 0) subject ty)
                                 ~@tests)))))
    (g/KPNode []
              (if (record-type? (mut k) ty)
                  (pat-record! (mut k)
                               p
                               (.text (kid p 0))
                               (list-kids (kid p 1))
                               subject
                               ty
                               (mut steps))
                  (pat-node! (mut k)
                             p
                             (.text (kid p 0))
                             (list-kids (kid p 1))
                             subject
                             ty
                             (mut steps)
                             known)))
    (g/KPCat [] (pat-text! (mut k) p subject ty (mut steps)))
    (g/KPList []
              (pat-list! (mut k) p (list-kids (kid p 0)) subject ty (mut steps)))
    (g/KPNodeQ []
               (if (record-type? (mut k) ty)
                   (pat-record! (mut k)
                                p
                                (.text (kid p 1))
                                (list-kids (kid p 2))
                                subject
                                ty
                                (mut steps))
                   (pat-node! (mut k)
                              p
                              (.text (kid p 1))
                              (list-kids (kid p 2))
                              subject
                              ty
                              (mut steps)
                              known)))
    (g/KPSome []
              (unless (opt? ty)
                (die (mut k)
                     p
                     (cat "some(…) needs an option, but this is " ty)))
              (let [t (fresh (mut k) "s")]
                (push! (mut steps) (SSome t subject))
                (pat! (mut k) (kid p 0) (sym t) (opt-of ty) (mut steps) "")))
    (g/KPNone []
              (unless (opt? ty)
                (die (mut k) p (cat "none needs an option, but this is " ty)))
              (push! (mut steps)
                     (STest `(match ~subject (None [] true) (_ false)))))
    (g/KPTrue [] (push! (mut steps) (STest subject)))
    (g/KPFalse [] (push! (mut steps) (STest `(not ~subject))))
    (g/KInt []
            (push! (mut steps) (STest `(= ~subject ~(rt/parse-int (.text p))))))
    (g/KChar [] (push! (mut steps) (STest `(= ~subject ~(char-value p)))))
    (g/KStr [] (push! (mut steps) (STest `(= ~subject ~(str-literal p)))))
    (g/KUpper []
              (let [m (mod-at (mut k) (type-module ty))]
                (match (find-enum-named m (type-name ty))
                  (None []
                        (die (mut k)
                             p
                             (cat4 (.text p)
                                   " is not a value of "
                                   ty
                                   ", which is no enum")))
                  (Some [_]
                        (push! (mut steps)
                               (STest `(= ~subject
                                          (~(sym (qualified (mut k)
                                                            (type-module ty)
                                                            (.text p)))))))))))
    (g/KPEnumQ []
               (push! (mut steps)
                      (STest `(= ~subject
                                 (~(sym (qualified (mut k)
                                                   (type-module ty)
                                                   (.text (kid p 1)))))))))
    (_ (die (mut k) p "this cannot be a pattern"))))

;;; Does `subject` match? The pattern's names are bound only inside this test.
(defn pat-test [(k (mut Comp)) (p g/Node) (subject Code) (ty (slice u8))]
  (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))
        label (primitive/code-symbol ":" (fresh (mut k) "t"))]
    (pat! (mut k) p subject ty (mut steps) "")
    (locals-reset! (mut k) mark)
    `(block ~label ~(wrap-steps steps 0 `(return-from ~label true)) false)))

;; ---------------------------------------------------------------- match

;;; One alternative of one arm: or-patterns at the top become several.
(defstruct Alt [(pat g/Node) (as-name g/Node) (guard g/Node) (body g/Node)])

(defn alts-of [(arms (ArrayList g/Node))] (-> (ArrayList Alt))
  (let [(mut out) (ArrayList::new [Alt] (malloc-allocator))]
    (for arm arms
      (let [p0 (kid arm 0)
            as-name (if (= (.kind p0) (g/KPAs)) (kid p0 1) (kid arm 1))
            p (if (= (.kind p0) (g/KPAs)) (kid p0 0) p0)
            has-as (= (.kind p0) (g/KPAs))]
        (if (= (.kind p) (g/KPOr))
            (do
              (push! (mut out)
                     (Alt
                       :pat (kid p 0)
                       :as-name (if has-as as-name (g/none-node))
                       :guard (kid arm 1)
                       :body (kid arm 2)))
              (for q (list-kids (kid p 1))
                (push! (mut out)
                       (Alt
                         :pat q
                         :as-name (if has-as as-name (g/none-node))
                         :guard (kid arm 1)
                         :body (kid arm 2)))))
            (push! (mut out)
                   (Alt
                     :pat p
                     :as-name (if has-as as-name (g/none-node))
                     :guard (kid arm 1)
                     :body (kid arm 2))))))
    out))

;;; A node pattern's kind, or "" for one that matches anything.
(defn alt-head [(a Alt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

(defn alt-code [(k (mut Comp))
                (a Alt)
                (subject Code)
                (ty (slice u8))
                (want (slice u8))
                (label Code)
                (known (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) known)
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))))
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [body (stmt (mut k) (.body a) want)
          inner
            (cond (= (.ty body) "Never") (.code body)
                  (or (= (.ty body) "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          out (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (te out (.ty body)))))

(defn no-case [(k (mut Comp)) (n g/Node)] (-> Code)
  (let [at (rt/line-col (.src k) (.lo n))]
    `(panic "{}:{}: no case of this match applies" ~(.path k) ~(.line at))))

;;; The type a match or if yields, when nothing says: its first arm with a type of its own.
(defn arms-want [(k (mut Comp))
                 (alts (ArrayList Alt))
                 (subject Code)
                 (ty (slice u8))] (-> (slice u8))
  (let [(mut out) ""
        label (primitive/code-symbol ":none")]
    (for a alts
      (when (and (= (len out) 0) (not (needs-want? (.body a))))
        (let [t (.ty (alt-code (mut k) a subject ty "" label ""))]
          (unless (= t "Never") (set! out t)))))
    out))

(defn match-code [(k (mut Comp))
                  (n g/Node)
                  (subject-node g/Node)
                  (arms (ArrayList g/Node))
                  (want0 (slice u8))] (-> TE)
  (let [subject (expr (mut k) subject-node "")
        ty (.ty subject)
        s (fresh (mut k) "m")
        ss (sym s)
        alts (alts-of arms)
        label (primitive/code-symbol ":" (fresh (mut k) "m"))
        want (if (> (len want0) 0) want0 (arms-want (mut k) alts ss ty))
        (mut result) "Never"
        node-subject
          (and (not (builtin-type? ty))
               (> (last-dot ty) 0)
               (= (type-name ty) "Node"))
        (mut dispatch) false]
    (when node-subject
      (for a alts (when (> (len (alt-head a)) 0) (set! dispatch true))))
    (let [body
            (if dispatch
                (let [gr (grammar-of-type (mut k) n ty)
                      (mut heads) (text-list)
                      (mut arms-out) (primitive/code-list-new)
                      (mut wild) (primitive/code-list-new)]
                  (for a alts
                    (let [h (alt-head a)
                          (mut seen) (= (len h) 0)]
                      (for x heads (when (= x h) (set! seen true)))
                      (unless seen (push! (mut heads) h))))
                  (for h heads
                    (let [(mut forms) (primitive/code-list-new)]
                      (for a alts
                        (when (or (= (alt-head a) h) (= (len (alt-head a)) 0))
                          (let [c (alt-code (mut k) a ss ty want label h)]
                            (set! result (unify (mut k) n result (.ty c)))
                            (push! (mut forms) (.code c)))))
                      (unless (match (find-kind gr h)
                                (Some [_] true)
                                (None [] false))
                        (die (mut k)
                             n
                             (cat4 "the grammar "
                                   (.name gr)
                                   " has no node named "
                                   h)))
                      (push! (mut arms-out) `(~(kind-code gr h) [] ~@forms 0))))
                  (for a alts
                    (when (= (len (alt-head a)) 0)
                      (let [c (alt-code (mut k) a ss ty want label "")]
                        (set! result (unify (mut k) n result (.ty c)))
                        (push! (mut wild) (.code c)))))
                  `(match (.kind ~ss) ~@arms-out (_ ~@wild 0)))
                (let [(mut forms) (primitive/code-list-new)]
                  (for a alts
                    (let [c (alt-code (mut k) a ss ty want label "")]
                      (set! result (unify (mut k) n result (.ty c)))
                      (push! (mut forms) (.code c))))
                  `(do ~@forms)))]
      (te `(let [~ss ~(.code subject)]
             (block ~label ~body ~(no-case (mut k) n)))
          result))))

;;; `match a, b { p, q => … }`: several values, each arm a pattern for each. An or-pattern at the top
;;; of one of them is an arm of its own for each alternative, so each can bind.
(defn match-n-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [(mut subject-nodes) (ArrayList::new [g/Node] (malloc-allocator))
        (mut subjects) (ArrayList::new [TE] (malloc-allocator))
        (mut syms) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut lets) (primitive/code-list-new)
        label (primitive/code-symbol ":" (fresh (mut k) "m"))]
    (push! (mut subject-nodes) (kid n 0))
    (for e (list-kids (kid n 1)) (push! (mut subject-nodes) e))
    (for e subject-nodes
      (let [t (expr (mut k) e "")
            s (fresh (mut k) "m")]
        (push! (mut subjects) t)
        (push! (mut syms) s)
        (push! (mut lets) (sym s))
        (push! (mut lets) (.code t))))
    (let [(mut rows) (ArrayList::new [AltN] (malloc-allocator))]
      (for arm (list-kids (kid n 2))
        (let [(mut pats) (ArrayList::new [g/Node] (malloc-allocator))]
          (push! (mut pats) (kid arm 0))
          (for p (list-kids (kid arm 1)) (push! (mut pats) p))
          (unless (= (len pats) (len subjects))
            (die (mut k)
                 arm
                 (cat4 "this match is on "
                       (rt/num-text (len subjects))
                       " values, this arm has patterns for "
                       (rt/num-text (len pats)))))
          (for combo (pattern-combos pats)
            (push! (mut rows)
                   (AltN
                     :pats combo
                     :guard (kid arm 2)
                     :body (kid arm 3))))))
      (let [want
              (if (> (len want0) 0)
                  want0
                  (let [(mut out) ""]
                    (for r rows
                      (when (and (= (len out) 0) (not (needs-want? (.body r))))
                        (let [t
                                (.ty (alt-n-code (mut k)
                                                 r
                                                 subjects
                                                 syms
                                                 ""
                                                 label))]
                          (unless (= t "Never") (set! out t)))))
                    out))
            (mut result) "Never"
            (mut forms) (primitive/code-list-new)]
        (for r rows
          (let [c (alt-n-code (mut k) r subjects syms want label)]
            (set! result (unify (mut k) n result (.ty c)))
            (push! (mut forms) (.code c))))
        (te `(let [~@lets] (block ~label ~@forms ~(no-case (mut k) n))) result)))))

(defstruct AltN [(pats (ArrayList g/Node)) (guard g/Node) (body g/Node)])

;;; Each way of picking one top-level alternative from every pattern.
(defn pattern-combos [(pats (ArrayList g/Node))]
  (-> (ArrayList (ArrayList g/Node)))
  (let [(mut out) (ArrayList::new [(ArrayList g/Node)] (malloc-allocator))]
    (push! (mut out) (ArrayList::new [g/Node] (malloc-allocator)))
    (for p pats
      (let [(mut next) (ArrayList::new [(ArrayList g/Node)] (malloc-allocator))
            as-name (if (= (.kind p) (g/KPAs)) (Some (kid p 1)) (None [g/Node]))
            bare (if (= (.kind p) (g/KPAs)) (kid p 0) p)]
        (for prefix out
          (for alt (top-alternatives bare)
            (let [(mut row) (ArrayList::new [g/Node] (malloc-allocator))]
              (for x prefix (push! (mut row) x))
              (push! (mut row)
                     (match as-name
                       (Some [nm] (g/node2 (g/KPAs) alt nm))
                       (None [] alt)))
              (push! (mut next) row))))
        (set! out next)))
    out))

(defn alt-n-code [(k (mut Comp))
                  (a AltN)
                  (subjects (ArrayList TE))
                  (syms (ArrayList (slice u8)))
                  (want (slice u8))
                  (label Code)] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (for i (range 0 (len subjects))
      (pat! (mut k)
            (get (.pats a) i)
            (sym (get syms i))
            (.ty (get subjects i))
            (mut steps)
            ""))
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [body (stmt (mut k) (.body a) want)
          inner
            (cond (= (.ty body) "Never") (.code body)
                  (or (= (.ty body) "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          out (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (te out (.ty body)))))

;;; A guard's tests, `and`-ed: a conjunct `x is P` binds P's names for the conjuncts after it, and for
;;; what the guard guards.
(defn guard-steps! [(k (mut Comp))
                    (guard g/Node)
                    (steps (mut (ArrayList Step)))] (-> void)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))]
    (conjuncts! guard (mut parts))
    (for c parts
      (if (= (.kind c) (g/KIsE))
          (let [subject (expr (mut k) (kid c 0) "")
                t (fresh (mut k) "m")]
            (push! (mut steps) (SBind t (.code subject)))
            (pat! (mut k) (kid c 1) (sym t) (.ty subject) (mut steps) ""))
          (push! (mut steps)
                 (STest (.code (expect (mut k) c (expr (mut k) c "Bool") "Bool"))))))))

;;; `a and b and …`. A conjunct `x is P` binds P's names for the conjuncts after it:
;;; `s is [_, rest...] and glob?(p, rest)`.
(defn and-code [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))]
    (conjuncts! n (mut parts))
    (let [(mut binding) false]
      (for c parts (when (= (.kind c) (g/KIsE)) (set! binding true)))
      (if (not binding)
          (let [a
                  (expect (mut k)
                          (kid n 0)
                          (expr (mut k) (kid n 0) "Bool")
                          "Bool")
                b
                  (expect (mut k)
                          (kid n 1)
                          (expr (mut k) (kid n 1) "Bool")
                          "Bool")]
            (te `(and ~(.code a) ~(.code b)) "Bool"))
          (let [mark (locals-mark (mut k))
                label (primitive/code-symbol ":" (fresh (mut k) "and"))
                (mut steps) (ArrayList::new [Step] (malloc-allocator))]
            (for c parts
              (if (= (.kind c) (g/KIsE))
                  (let [subject (expr (mut k) (kid c 0) "")
                        t (fresh (mut k) "m")]
                    (push! (mut steps) (SBind t (.code subject)))
                    (pat! (mut k)
                          (kid c 1)
                          (sym t)
                          (.ty subject)
                          (mut steps)
                          ""))
                  (push! (mut steps)
                         (STest (.code (expect (mut k)
                                               c
                                               (expr (mut k) c "Bool")
                                               "Bool"))))))
            (locals-reset! (mut k) mark)
            (te `(block
                   ~label
                   ~(wrap-steps steps 0 `(return-from ~label true))
                   false)
                "Bool"))))))

(defn conjuncts! [(n g/Node) (out (mut (ArrayList g/Node)))] (-> void)
  (if (= (.kind n) (g/KAnd))
      (do (conjuncts! (kid n 0) (mut out)) (conjuncts! (kid n 1) (mut out)))
      (if (= (.kind n) (g/KGroup))
          (if (= (.kind (kid n 0)) (g/KAnd))
              (conjuncts! (kid n 0) (mut out))
              (push! (mut out) n))
          (push! (mut out) n))))

;;; `e where x = …, y = …`: each name an equation, which may use the others in any order but not
;;; itself; each is worked out once, before `e`, in an order where what it uses comes first.
(defn where-code [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        lets (where-open! (mut k) n)
        body (stmt (mut k) (kid n 0) want)]
    (locals-reset! (mut k) mark)
    (te `(let [~@lets] ~(.code body)) (.ty body))))

;;; The order to work out equations in: each after the others it mentions. A circle stops.
(defn where-order [(inits (ArrayList g/Node))] (-> (ArrayList i64))
  (let [count (len inits)
        (mut names) (text-list)
        (mut done) (ArrayList::new [bool] (malloc-allocator))
        (mut order) (ArrayList::new [i64] (malloc-allocator))
        (mut uses) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
    (for i inits
      (do (push! (mut names) (.text (kid i 0))) (push! (mut done) false)))
    (for i inits
      (let [(mut mentioned) (text-list)
            (mut idx) (ArrayList::new [i64] (malloc-allocator))]
        (names-in! (kid i 1) (mut mentioned))
        (for j (range 0 count)
          (let [(mut hit) false]
            (for m mentioned (when (= m (get names j)) (set! hit true)))
            (when hit (push! (mut idx) j))))
        (push! (mut uses) idx)))
    (while (< (len order) count)
      (let [(mut progressed) false]
        (for j (range 0 count)
          (when (not (get done j))
            (let [(mut ready) true]
              (for u (get uses j)
                (unless (and (!= u j) (get done u)) (set! ready false)))
              (when ready
                (set! (mut done) j true)
                (push! (mut order) j)
                (set! progressed true)))))
        (unless progressed
          (panic "where: equations that use each other in a circle, or one that uses itself"))))
    order))

;;; A `where`'s equations, bound for what follows, as the bindings of a `let`.
(defn where-open! [(k (mut Comp)) (n g/Node)] (-> Code)
  (let [inits (list-kids (kid n 1))
        count (len inits)
        (mut names) (text-list)
        (mut done) (ArrayList::new [bool] (malloc-allocator))
        (mut order) (ArrayList::new [i64] (malloc-allocator))]
    (for i inits
      (let [nm (.text (kid i 0))]
        (for x names
          (when (= x nm)
            (die (mut k) i (cat3 "`" nm "` is defined twice here"))))
        (push! (mut names) nm)
        (push! (mut done) false)))
    ;; What each equation mentions of the others.
    (let [(mut uses) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
      (for i inits
        (let [(mut mentioned) (text-list)
              (mut idx) (ArrayList::new [i64] (malloc-allocator))]
          (names-in! (kid i 1) (mut mentioned))
          (for j (range 0 count)
            (let [(mut hit) false]
              (for m mentioned (when (= m (get names j)) (set! hit true)))
              (when hit (push! (mut idx) j))))
          (push! (mut uses) idx)))
      (while (< (len order) count)
        (let [(mut progressed) false]
          (for j (range 0 count)
            (when (not (get done j))
              (let [(mut ready) true]
                (for u (get uses j)
                  (unless (and (!= u j) (get done u)) (set! ready false)))
                (when ready
                  (set! (mut done) j true)
                  (push! (mut order) j)
                  (set! progressed true)))))
          (unless progressed
            (die (mut k)
                 n
                 "these equations use each other in a circle, or one uses itself"))))
      (let [(mut lets) (primitive/code-list-new)]
        (for j order
          (let [i (get inits j)
                v (expr (mut k) (kid i 1) "")
                s (bind-local! (mut k) (get names j) (.ty v) false)]
            (push! (mut lets) (sym s))
            (push! (mut lets) (.code v))))
        `(~@lets)))))

;;; Every name an expression mentions, whatever it means there: not a field's name, `p.at`'s `at`
;;; or the `at:` of `Place(at: …)`.
(defn names-in! [(n g/Node) (out (mut (ArrayList (slice u8))))] (-> void)
  (cond (= (.kind n) (g/KName)) (push! (mut out) (.text n))
        (= (.kind n) (g/KFieldE)) (names-in! (kid n 0) (mut out))
        (or (= (.kind n) (g/KFieldInit)) (= (.kind n) (g/KNamed)))
          (names-in! (kid n 1) (mut out))
        :else (for c (.kids n) (names-in! c (mut out)))))

;; ---------------------------------------------------------------- loops

(defstruct HeadInfo
  [(wrap-kind i64)  ; 0 list, 1 map keys, 2 text, 3 range, 4 query, 5 list by pattern, 6 from n up,
   ; 11 an option's value
   (alts (ArrayList PatAlt))
   (var (slice u8))
   (seq Code)
   (hi Code)
   (lets Code)
   (row (slice u8))
   (tests Code)
   (binds Code)])

(defn empty-code [] (-> Code)
  `())

;;; One alternative of a pattern loop head: its tests and bindings, then `moves`, which give the
;;; names it bound to the symbols the loop's body was compiled against.
(defstruct PatAlt [(steps (ArrayList Step)) (moves Code)])

(defstruct Bound [(name (slice u8)) (ty (slice u8)) (sym (slice u8))])

(defn no-alts [] (-> (ArrayList PatAlt))
  (ArrayList::new [PatAlt] (malloc-allocator)))

(defn top-alternatives [(p g/Node)] (-> (ArrayList g/Node))
  (let [(mut out) (ArrayList::new [g/Node] (malloc-allocator))]
    (if (= (.kind p) (g/KPOr))
        (do
          (push! (mut out) (kid p 0))
          (for q (list-kids (kid p 1)) (push! (mut out) q)))
        (push! (mut out) p))
    out))

;;; `for Pat in xs`: the items that match.
(defn pat-head-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (let [e (expr (mut k) (kid h 1) "")
        t (.ty e)
        _
          (unless (list? t)
            (die (mut k)
                 h
                 (cat "a pattern can only take the items of a list, not of " t)))
        v (fresh (mut k) "item")]
    (HeadInfo
      :wrap-kind 5
      :alts (pattern-alts! (mut k) h (kid h 0) v (elem-of t))
      :var v
      :seq (.code e)
      :hi `0
      :lets (empty-code)
      :row ""
      :tests (empty-code)
      :binds (empty-code))))

;;; `if let Pat = e` in a comprehension: on only when `e` matches.
(defn let-clause-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (let [e (expr (mut k) (kid h 1) "")
        v (fresh (mut k) "value")]
    (HeadInfo
      :wrap-kind 8
      :alts (pattern-alts! (mut k) h (kid h 0) v (.ty e))
      :var v
      :seq (.code e)
      :hi `0
      :lets (empty-code)
      :row ""
      :tests (empty-code)
      :binds (empty-code))))

;;; A pattern's alternatives against the value in `v`, each alternative of an or-pattern in turn.
;;; Every alternative must bind the same names, with the same types; they are bound for what follows.
(defn pattern-alts! [(k (mut Comp))
                     (h g/Node)
                     (pattern g/Node)
                     (v (slice u8))
                     (elem (slice u8))] (-> (ArrayList PatAlt))
  (let [(mut shapes) (ArrayList::new [(ArrayList Bound)] (malloc-allocator))
        (mut steps-of) (ArrayList::new [(ArrayList Step)] (malloc-allocator))]
    (for alt (top-alternatives pattern)
      (let [mark (locals-mark (mut k))
            (mut steps) (ArrayList::new [Step] (malloc-allocator))
            (mut bound) (ArrayList::new [Bound] (malloc-allocator))]
        (pat! (mut k) alt (sym v) elem (mut steps) "")
        (for i (range mark (len (.locals k)))
          (let [l (get (.locals k) i)]
            (push! (mut bound)
                   (Bound
                     :name (.name l)
                     :ty (.ty l)
                     :sym (.sym l)))))
        (locals-reset! (mut k) mark)
        (push! (mut shapes) bound)
        (push! (mut steps-of) steps)))
    (let [first-shape (get shapes 0)
          (mut shared) (ArrayList::new [Bound] (malloc-allocator))
          (mut alts) (no-alts)]
      (for b first-shape
        (push! (mut shared)
               (Bound
                 :name (.name b)
                 :ty (.ty b)
                 :sym (bind-local! (mut k) (.name b) (.ty b) false))))
      (for i (range 0 (len shapes))
        (let [shape (get shapes i)
              (mut moves) (primitive/code-list-new)]
          (unless (= (len shape) (len shared))
            (die (mut k)
                 h
                 "each alternative of this pattern must bind the same names"))
          (for b shared
            (let [(mut found) false]
              (for x shape
                (when (= (.name x) (.name b))
                  (unless (= (.ty x) (.ty b))
                    (die (mut k)
                         h
                         (cat4 (.name b)
                               " is a "
                               (.ty x)
                               (cat " in one alternative and a " (.ty b)))))
                  (set! found true)
                  (push! (mut moves) (sym (.sym b)))
                  (push! (mut moves) (sym (.sym x)))))
              (unless found
                (die (mut k)
                     h
                     (cat4 "one alternative of this pattern does not bind "
                           (.name b)
                           ""
                           "")))))
          (push! (mut alts) (PatAlt :steps (get steps-of i) :moves `(~@moves)))))
      alts)))

;;; `n..` has no end: only what stops at an answer, `first`, `any` and `all`, may count up forever.
(defn bounded! [(k (mut Comp)) (h g/Node)] (-> bool)
  (when (= (.kind h) (g/KFromHead))
    (die (mut k)
         h
         "`x in n..` has no end, so only first, any and all, which stop at an answer, can take it"))
  true)

(defn head-open! [(k (mut Comp)) (h g/Node)] (-> HeadInfo)
  (match (.kind h)
    (g/KRangeHead []
                  (let [lo
                          (expect (mut k)
                                  (kid h 1)
                                  (expr (mut k) (kid h 1) "Int")
                                  "Int")
                        hi
                          (expect (mut k)
                                  (kid h 2)
                                  (expr (mut k) (kid h 2) "Int")
                                  "Int")
                        v (bind-local! (mut k) (.text (kid h 0)) "Int" false)]
                    (HeadInfo
                      :wrap-kind 3
                      :alts (no-alts)
                      :var v
                      :seq (.code lo)
                      :hi (.code hi)
                      :lets (empty-code)
                      :row ""
                      :tests (empty-code)
                      :binds (empty-code))))
    (g/KFromHead []
                 (let [lo
                         (expect (mut k)
                                 (kid h 1)
                                 (expr (mut k) (kid h 1) "Int")
                                 "Int")
                       v (bind-local! (mut k) (.text (kid h 0)) "Int" false)]
                   (HeadInfo
                     :wrap-kind 6
                     :alts (no-alts)
                     :var v
                     :seq (.code lo)
                     :hi `0
                     :lets (empty-code)
                     :row ""
                     :tests (empty-code)
                     :binds (empty-code))))
    (g/KPatHead [] (pat-head-open! (mut k) h))
    ;; `x in [e]`: a list of one, which is only `e`; nothing is made.
    (g/KInHead []
               (if (and (= (.kind (kid h 1)) (g/KListLit))
                        (= (len (list-kids (kid (kid h 1) 0))) 1)
                        (not (spread-arg? (get (list-kids (kid (kid h 1) 0)) 0))))
                   (let [e
                           (expr (mut k)
                                 (get (list-kids (kid (kid h 1) 0)) 0)
                                 "")
                         v (bind-local! (mut k) (.text (kid h 0)) (.ty e) false)]
                     (HeadInfo
                       :wrap-kind 12
                       :alts (no-alts)
                       :var v
                       :seq (.code e)
                       :hi `0
                       :lets (empty-code)
                       :row ""
                       :tests (empty-code)
                       :binds (empty-code)))
                   (let [e (expr (mut k) (kid h 1) "")
                         t (.ty e)
                         kind
                           (cond (list? t) 0
                                 (map? t) 1
                                 (= t "Text") 2
                                 (opt? t) 11
                                 :else
                                   (die (mut k) h (cat "cannot loop over " t)))
                         v
                           (bind-local! (mut k)
                                        (.text (kid h 0))
                                        (cond (list? t) (elem-of t)
                                              (map? t) (map-key t)
                                              (opt? t) (opt-of t)
                                              :else "Int")
                                        false)]
                     (HeadInfo
                       :wrap-kind kind
                       :alts (no-alts)
                       :var v
                       :seq (.code e)
                       :hi `0
                       :lets (empty-code)
                       :row ""
                       :tests (empty-code)
                       :binds (empty-code)))))
    (g/KQueryHead [] (query-open! (mut k) (kid h 0)))
    (_ (die (mut k) h "expected a loop head"))))

;;; `db.rel(a, ?x, _)`: rows matching the known columns, binding the `?` ones.
(defn query-open! [(k (mut Comp)) (call g/Node)] (-> HeadInfo)
  (unless (and (= (.kind call) (g/KCall)) (= (.kind (kid call 0)) (g/KFieldE)))
    (die (mut k) call "a query is db.relation(columns)"))
  (let [rel-name (.text (kid (kid call 0) 1))
        base (kid (kid call 0) 0)
        db (if (is-place? base) (place (mut k) base) (expr (mut k) base ""))
        rel-of `(~(primitive/code-symbol "." rel-name) ~(.code db))
        held (writable? (mut k) base)
        copy (fresh (mut k) "rel")
        rel-code (if held `(mut ~rel-of) `(mut ~(sym copy)))
        args (list-kids (kid call 1))
        (mut lets) (primitive/code-list-new)
        (mut tests) (primitive/code-list-new)
        (mut binds) (primitive/code-list-new)
        row (fresh (mut k) "row")
        rowsym (sym row)
        (mut key-col) -1
        (mut key-sym) ""]
    (rel-check (mut k) call (.ty db) rel-name (len args))
    ;; A query only reads, though it may build an index as it goes. A relation's indexes live in
    ;; storage its copies share, so one held by `let` (or made by a call) is read through a copy.
    (unless held
      (push! (mut lets) `(mut ~(sym copy)))
      (push! (mut lets) rel-of))
    (for i (range 0 (len args))
      (let [a (get args i)]
        (cond (= (.kind a) (g/KQvar)) 0
              (and (= (.kind a) (g/KName)) (= (.text a) "_")) 0
              :else
                (let [v (expect (mut k) a (expr (mut k) a "Int") "Int")
                      t (fresh (mut k) "key")]
                  (push! (mut lets) (sym t))
                  (push! (mut lets) (.code v))
                  (if (< key-col 0)
                      (do (set! key-col i) (set! key-sym t))
                      (push! (mut tests)
                             `(= (rt/rel-at ~rel-code ~rowsym ~i) ~(sym t))))))))
    (for i (range 0 (len args))
      (let [a (get args i)]
        (when (= (.kind a) (g/KQvar))
          (let [v
                  (bind-local! (mut k)
                               (subslice (.text a) 1 (len (.text a)))
                               "Int"
                               false)]
            (push! (mut binds) (sym v))
            (push! (mut binds) `(rt/rel-at ~rel-code ~rowsym ~i))))))
    (HeadInfo
      :wrap-kind 4
      :alts (no-alts)
      :var ""
      :seq
        (if (>= key-col 0)
            `(rt/rel-bucket ~rel-code ~key-col ~(sym key-sym))
            `(range 0 (.count ~(if held rel-of (sym copy)))))
      :hi `0
      :lets `(~@lets)
      :row row
      :tests `(~@tests)
      :binds `(~@binds))))

(defn rel-check [(k (mut Comp))
                 (n g/Node)
                 (db-ty (slice u8))
                 (rel (slice u8))
                 (count i64)] (-> void)
  (unless (and (> (last-dot db-ty) 0) (= (type-name db-ty) "Db"))
    (die (mut k)
         n
         (cat "a relation is read from a fact database, but this is " db-ty)))
  (match (find-rel (mod-at (mut k) (type-module db-ty)) rel)
    (None []
          (die (mut k)
               n
               (cat4 (type-module db-ty) " has no relation named " rel "")))
    (Some [r]
          (unless (= (.arity r) count)
            (die (mut k)
                 n
                 (cat4 rel " has " (rt/num-text (.arity r)) " columns"))))))

;;; `inner` under the first alternative that matches.
(defn alts-code [(k (mut Comp)) (alts (ArrayList PatAlt)) (inner Code)]
  (-> Code)
  (if (= (len alts) 1)
      (let [a (get alts 0)]
        (wrap-steps (.steps a) 0 `(let [~@(.moves a)] ~inner)))
      (let [label (primitive/code-symbol ":" (fresh (mut k) "alt"))
            (mut tries) (primitive/code-list-new)]
        (for a alts
          (push! (mut tries)
                 (wrap-steps (.steps a)
                             0
                             `(let [~@(.moves a)] ~inner (return-from ~label 0)))))
        `(block ~label ~@tries 0))))

;;; A comprehension's clause, opened in order: a loop, a test, or a pattern.
(defn clause-open! [(k (mut Comp)) (c g/Node)] (-> HeadInfo)
  (match (.kind c)
    (g/KIfClause []
                 (let [t
                         (expect (mut k)
                                 (kid c 0)
                                 (expr (mut k) (kid c 0) "Bool")
                                 "Bool")]
                   (HeadInfo
                     :wrap-kind 7
                     :alts (no-alts)
                     :var ""
                     :seq (.code t)
                     :hi `0
                     :lets (empty-code)
                     :row ""
                     :tests (empty-code)
                     :binds (empty-code))))
    (g/KLetClause [] (let-clause-open! (mut k) c))
    (g/KWhileClause []
                    (let [t
                            (expect (mut k)
                                    (kid c 0)
                                    (expr (mut k) (kid c 0) "Bool")
                                    "Bool")]
                      (HeadInfo
                        :wrap-kind 9
                        :alts (no-alts)
                        :var ""
                        :seq (.code t)
                        :hi `0
                        :lets (empty-code)
                        :row ""
                        :tests (empty-code)
                        :binds (empty-code))))
    ;; A key that is none always passes: `distinct` then sees only the items that have one.
    (g/KDistinctClause []
                       (let [key (expr (mut k) (kid c 0) "")
                             t
                               (if (opt? (.ty key))
                                   (opt-of (.ty key))
                                   (.ty key))]
                         (unless (or (= t "Int") (= t "Text"))
                           (die (mut k)
                                (kid c 0)
                                (cat "distinct keys are Int or Text, or optionally one, not "
                                     (.ty key))))
                         (HeadInfo
                           :wrap-kind 10
                           :alts (no-alts)
                           :var (fresh (mut k) "seen")
                           :seq (.code key)
                           :hi `0
                           :lets (empty-code)
                           :row (.ty key)
                           :tests (empty-code)
                           :binds (empty-code))))
    (_ (do (bounded! (mut k) c) (head-open! (mut k) c)))))

(defn loop-kind? [(w i64)] (-> bool)
  (or (and (>= w 0) (<= w 6)) (= w 11) (= w 12)))

;;; A comprehension's opened clauses around `inner`, the first outermost. A `while` leaves the
;;; nearest loop before it; a `distinct` remembers, across the whole comprehension, the keys it let by.
(defn clauses-code [(k (mut Comp))
                    (cs (ArrayList g/Node))
                    (opened (ArrayList HeadInfo))
                    (inner Code)] (-> Code)
  (let [(mut labels) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut stops) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut seen) (primitive/code-list-new)]
    (for _ opened (do (push! (mut labels) "") (push! (mut stops) "")))
    (for i (range 0 (len opened))
      (let [h (get opened i)]
        (when (= (.wrap-kind h) 9)
          (let [(mut j) (- i 1)]
            (while (and (>= j 0) (not (loop-kind? (.wrap-kind (get opened j)))))
              (set! j (- j 1)))
            (when (< j 0)
              (die (mut k)
                   (get cs i)
                   "a `while` stops the loop before it, and there is none"))
            (when (= (len (get labels j)) 0)
              (set! (mut labels) j (fresh (mut k) "stop")))
            (set! (mut stops) i (get labels j))))
        (when (= (.wrap-kind h) 10)
          (push! (mut seen) `(mut ~(sym (.var h))))
          (push! (mut seen)
                 (new-map (mut k)
                          (cat3 "{"
                                (if (opt? (.row h)) (opt-of (.row h)) (.row h))
                                ":Bool}"))))))
    (let [(mut body) inner
          (mut i) (- (len opened) 1)]
      (while (>= i 0)
        (let [h (get opened i)]
          (cond (= (.wrap-kind h) 9)
                  (set! body
                        `(do
                           (unless ~(.seq h)
                             (return-from ~(primitive/code-symbol ":"
                                                                  (get stops i))
                                          0))
                           ~body))
                (= (.wrap-kind h) 10)
                  (let [kv (fresh (mut k) "key")
                        once
                          `(unless (match (get ~(sym (.var h)) ~(sym kv))
                                     (Some [_] true)
                                     (None [] false))
                             (set! (mut ~(sym (.var h))) ~(sym kv) true)
                             ~body)]
                    (set! body
                          (if (opt? (.row h))
                              `(match ~(.seq h)
                                 (Some [~(sym kv)] (do ~once 0))
                                 (None [] (do ~body 0)))
                              `(let [~(sym kv) ~(.seq h)] ~once))))
                :else (set! body (head-wrap (mut k) h body)))
          (when (> (len (get labels i)) 0)
            (set! body
                  `(block ~(primitive/code-symbol ":" (get labels i)) ~body 0))))
        (set! i (- i 1)))
      `(let [~@seen] ~body))))

(defn head-wrap [(k (mut Comp)) (h HeadInfo) (inner Code)] (-> Code)
  (let [v (if (> (len (.var h)) 0) (sym (.var h)) `_)]
    (cond (= (.wrap-kind h) 0) `(for (ref ~v) ~(.seq h) ~inner)
          (= (.wrap-kind h) 1) `(for ~v ~(.seq h) ~inner)
          (= (.wrap-kind h) 2)
            (let [t (fresh (mut k) "c")]
              `(for ~(sym t) ~(.seq h) (let [~v (cast i64 ~(sym t))] ~inner)))
          (= (.wrap-kind h) 3) `(for ~v (range ~(.seq h) ~(.hi h)) ~inner)
          ;; An option is a list of none or one.
          (= (.wrap-kind h) 11)
            `(match ~(.seq h) (Some [~v] (do ~inner 0)) (None [] 0))
          (= (.wrap-kind h) 12) `(let [~v ~(.seq h)] ~inner)
          (= (.wrap-kind h) 5)
            `(for (ref ~v) ~(.seq h) ~(alts-code (mut k) (.alts h) inner))
          (= (.wrap-kind h) 7) `(when ~(.seq h) ~inner)
          (= (.wrap-kind h) 8)
            `(let [~v ~(.seq h)] ~(alts-code (mut k) (.alts h) inner))
          (= (.wrap-kind h) 6)
            `(let [(mut ~v) ~(.seq h)] (while true ~inner (set! ~v (+ ~v 1))))
          :else
            `(let [~@(.lets h)]
               (for ~(sym (.row h)) ~(.seq h)
                 (when (and ~@(.tests h) true)
                   (let [~@(.binds h)] ~inner)))))))

;; ---------------------------------------------------------------- places

;;; An expression as an addressable path, for `(mut …)`.
(defn place [(k (mut Comp)) (e g/Node)] (-> TE)
  (match (.kind e)
    (g/KName []
             (match (find-local (mut k) (.text e))
               (Some [l] (te (sym (.sym l)) (.ty l)))
               (None []
                     (let [m (self-mod (mut k))]
                       (match (find-global m (.text e))
                         (Some [x]
                               (te `(~(primitive/code-symbol "." (.name x)) ~(storage-call (mut k)
                                                                                           x))
                                   (.ty x)))
                         (None []
                               (die (mut k) e (cat "nothing named " (.text e)))))))))
    (g/KGroup [] (place (mut k) (kid e 0)))
    (g/KFieldE []
               (let [base (kid e 0)
                     field (.text (kid e 1))]
                 (match (module-prefix (mut k) base)
                   (Some [module]
                         (match (find-global (mod-at (mut k) module) field)
                           (Some [x]
                                 (te `(~(primitive/code-symbol "." field) ~(storage-of (mut k)
                                                                                       module
                                                                                       x))
                                     (.ty x)))
                           (None []
                                 (die (mut k)
                                      e
                                      (cat4 module
                                            " has no state named "
                                            field
                                            "")))))
                   (None []
                         (let [b (place (mut k) base)]
                           (when (named-child? (mut k) (.ty b) field)
                             (die (mut k)
                                  e
                                  (cat3 "a node's children do not change in place; make a new node with `with { "
                                        field
                                        ": ... }`")))
                           (te `(~(primitive/code-symbol "." field) ~(.code b))
                               (field-type (mut k) e (.ty b) field)))))))
    (g/KIndex []
              (let [b (place (mut k) (kid e 0))]
                (unless (list? (.ty b))
                  (die (mut k)
                       e
                       (cat "only a list's element is a place, not one of "
                            (.ty b))))
                (let [i
                        (expect (mut k)
                                (kid e 1)
                                (expr (mut k) (kid e 1) "Int")
                                "Int")]
                  (te `(elem (mut ~(.code b)) ~(.code i)) (elem-of (.ty b))))))
    (_ (die (mut k) e "this cannot be assigned or passed by reference"))))

;;; A named child: each kind that names a child `field`, and where that child is.
(defstruct Slot [(kind (slice u8)) (index i64)])

(defn child-slots [(gr Mod) (field (slice u8))] (-> (ArrayList Slot))
  (let [(mut out) (ArrayList::new [Slot] (malloc-allocator))]
    (for e (.kinds gr)
      (for i (range 0 (len (.fields e)))
        (when (= (get (.fields e) i) field)
          (push! (mut out) (Slot :kind (.name e) :index i)))))
    out))

(defn node-builtin-field? [(field (slice u8))] (-> bool)
  (or (= field "text")
      (= field "lo")
      (= field "hi")
      (= field "gen")
      (= field "kids")
      (= field "kind")))

(defn named-child? [(k (mut Comp)) (ty (slice u8)) (field (slice u8))] (-> bool)
  (and (not (builtin-type? ty))
       (> (last-dot ty) 0)
       (= (type-name ty) "Node")
       (not (node-builtin-field? field))
       (> (len (child-slots (mod-at (mut k) (type-module ty)) field)) 0)))

;;; `n.field`: the child of that name, wherever this node's kind keeps it. A kind with no child of
;;; that name is a mistake in the program, so it stops.
(defn child-code [(k (mut Comp)) (ty (slice u8)) (field (slice u8)) (code Code)]
  (-> Code)
  (let [gr (mod-at (mut k) (type-module ty))
        x (sym (fresh (mut k) "n"))]
    `(let [~x ~code]
       (get (.kids ~x) ~(child-index-code (mut k) gr field x)))))

;;; Whether `base` is a name a rewrite's pattern bound, with a rewritten form.
(defn out-bound? [(k (mut Comp)) (base g/Node)] (-> bool)
  (and (= (.kind base) (g/KName))
       (match (find-local (mut k) (.text base))
         (Some [l]
               (let [(mut hit) false]
                 (for o (.outs k) (when (= (.sym o) (.sym l)) (set! hit true)))
                 hit))
         (None [] false))))

;;; `x.out` in a rewrite: what the child `x` became, or with the rule's `as` name, the node rebuilt
;;; from its children's.
(defn out-of [(k (mut Comp)) (n g/Node) (base g/Node)] (-> Code)
  (let [(mut hit) (None [Code])]
    (when (= (.kind base) (g/KName))
      (match (find-local (mut k) (.text base))
        (Some [l]
              (for o (.outs k)
                (when (= (.sym o) (.sym l)) (set! hit (Some (.code o))))))
        (None [] 0)))
    (match hit
      (Some [c] c)
      (None []
            (die (mut k)
                 n
                 "only in a rewrite, of its node or of a child its pattern names, is there an `out`")))))

;;; Where node `x` keeps its child `field`.
(defn child-index-code [(k (mut Comp)) (gr Mod) (field (slice u8)) (x Code)]
  (-> Code)
  (let [(mut arms) (primitive/code-list-new)]
    (for s (child-slots gr field)
      (push! (mut arms) `(~(kind-code gr (.kind s)) [] ~(.index s))))
    `(match (.kind ~x)
       ~@arms
       (_ (panic ~(cat "a {} node has no child named " field)
                 (~(primitive/code-symbol (alias-of (.name gr)) "/kind-name") (.kind ~x)))))))

;;; `base` names an imported module, rather than a value.
(defn module-prefix [(k (mut Comp)) (base g/Node)] (-> (Option (slice u8)))
  (if (and (= (.kind base) (g/KName))
           (match (find-local (mut k) (.text base))
             (Some [_] false)
             (None [] true)))
      (alias-target (self-mod (mut k)) (.text base))
      (None [(slice u8)])))

(defn field-type [(k (mut Comp)) (n g/Node) (ty (slice u8)) (field (slice u8))]
  (-> (slice u8))
  (cond (builtin-type? ty)
          (die (mut k) n (cat4 ty " has no field named " field ""))
        (or (list? ty) (map? ty) (opt? ty) (fn? ty))
          (die (mut k) n (cat4 ty " has no field named " field ""))
        (= (type-name ty) "Node")
          (cond (= field "text") "Text"
                (= field "lo") "Int"
                (= field "hi") "Int"
                (= field "gen") "Int"
                (= field "kids") (cat3 "[" ty "]")
                (= field "kind") (cat (type-module ty) ".Kind")
                (> (len (child-slots (mod-at (mut k) (type-module ty)) field))
                   0)
                  ty
                :else
                  (die (mut k)
                       n
                       (cat4 "a node has text, lo, hi, kids, kind and its grammar's named children, not "
                             field
                             ""
                             "")))
        :else
          (match (find-rec (mod-at (mut k) (type-module ty)) (type-name ty))
            (None [] (die (mut k) n (cat4 ty " has no field named " field "")))
            (Some [r]
                  (let [(mut out) ""]
                    (for f (.fields r)
                      (when (= (.name f) field) (set! out (.ty f))))
                    (when (= (len out) 0)
                      (die (mut k) n (cat4 ty " has no field named " field "")))
                    out)))))

;; ---------------------------------------------------------------- calls

(defn args-code [(k (mut Comp)) (n g/Node) (f Func) (args (ArrayList g/Node))]
  (-> Code)
  (unless (= (len args) (len (.params f)))
    (die (mut k)
         n
         (cat4 (.name f)
               " takes "
               (rt/num-text (len (.params f)))
               (cat " arguments, this has " (rt/num-text (len args))))))
  (let [(mut out) (primitive/code-list-new)]
    (for i (range 0 (len args))
      (let [p (get (.params f) i)
            a (get args i)]
        (if (.by-ref p)
            (let [x (place (mut k) a)]
              (unless (= (.ty x) (.ty p))
                (die (mut k) a (cat4 "expected " (.ty p) ", found " (.ty x))))
              (push! (mut out) `(mut ~(.code x))))
            (let [x (expect (mut k) a (expr (mut k) a (.ty p)) (.ty p))]
              (push! (mut out) (.code x))))))
    `(~@out)))

(defn call-func [(k (mut Comp))
                 (n g/Node)
                 (module (slice u8))
                 (f Func)
                 (args (ArrayList g/Node))] (-> TE)
  (let [cs (args-code (mut k) n f args)]
    (te `(~(sym (qualified (mut k) module (.coil f))) ~@cs) (.ret f))))

;;; Calls the language itself understands, for any element type.
(defn builtin-call [(k (mut Comp))
                    (n g/Node)
                    (name (slice u8))
                    (args (ArrayList g/Node))] (-> (Option TE))
  (let [count (len args)]
    (cond (and (= name "len") (= count 1))
            (Some (te `(len ~(.code (expr (mut k) (get args 0) ""))) "Int"))
          (and (= name "is-some") (= count 1))
            (Some (te `(match ~(.code (expr (mut k) (get args 0) ""))
                         (Some [_] true)
                         (None [] false))
                      "Bool"))
          (and (= name "is-none") (= count 1))
            (Some (te `(match ~(.code (expr (mut k) (get args 0) ""))
                         (Some [_] false)
                         (None [] true))
                      "Bool"))
          (and (= name "pop") (= count 1))
            (let [p (place (mut k) (get args 0))]
              (Some (te `(pop! (mut ~(.code p))) "Void")))
          (and (= name "clear") (= count 1))
            (let [p (place (mut k) (get args 0))]
              (Some (te `(clear! (mut ~(.code p))) "Void")))
          (and (= name "last") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "l")]
              (unless (list? (.ty e)) (die (mut k) n "last needs a list"))
              (Some (te `(let [~(sym t) ~(.code e)]
                           (get ~(sym t) (- (len ~(sym t)) 1)))
                        (elem-of (.ty e)))))
          (and (or (= name "max") (= name "min")) (= count 2))
            (let [a
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Int")
                            "Int")
                  b
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "Int")
                            "Int")
                  x (fresh (mut k) "a")
                  y (fresh (mut k) "b")]
              (Some (te `(let [~(sym x) ~(.code a)
                               ~(sym y) ~(.code b)]
                           (if ~(if (= name "max")
                                    `(> ~(sym x) ~(sym y))
                                    `(< ~(sym x) ~(sym y)))
                               ~(sym x)
                               ~(sym y)))
                        "Int")))
          ;; `tally(keys)`: how many times each key is in the list. `tally(keys, weights)`: the sum of the
          ;; weights at each key's places.
          ;; `updated(xs, {k: v for …})`: `xs` with each value at its key's place, as the comprehension
          ;; makes them, a later one over an earlier one; no map is made.
          (and (= name "updated")
               (= count 2)
               (= (.kind (get args 1)) (g/KMapComp)))
            (let [xs (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty xs))
                      (die (mut k)
                           n
                           (cat "updated takes a list, not " (.ty xs))))
                  comp (get args 1)
                  o (fresh (mut k) "out")
                  key-v (fresh (mut k) "key")
                  mark (locals-mark (mut k))
                  (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
                  _
                    (for c (list-kids (kid comp 2))
                      (push! (mut opened) (clause-open! (mut k) c)))
                  key
                    (expect (mut k)
                            (kid comp 0)
                            (expr (mut k) (kid comp 0) "Int")
                            "Int")
                  val
                    (expect (mut k)
                            (kid comp 1)
                            (expr (mut k) (kid comp 1) (elem-of (.ty xs)))
                            (elem-of (.ty xs)))
                  body
                    (clauses-code (mut k)
                                  (list-kids (kid comp 2))
                                  opened
                                  `(let [~(sym key-v) ~(.code key)]
                                     (when (or (< ~(sym key-v) 0)
                                               (>= ~(sym key-v) (len ~(sym o))))
                                       (panic "updated: key {} is outside 0 to {}"
                                              ~(sym key-v)
                                              (len ~(sym o))))
                                     (set! (mut ~(sym o))
                                           ~(sym key-v)
                                           ~(.code val))))]
              (locals-reset! (mut k) mark)
              (Some (te `(let [(mut ~(sym o))
                                 ~(if (match (.kind (get args 0))
                                        (g/KName [] true)
                                        (g/KFieldE [] true)
                                        (g/KIndex [] true)
                                        (_ false))
                                      (list-copy (mut k) xs)
                                      (.code xs))]
                           ~body
                           ~(sym o))
                        (.ty xs))))
          ;; `updated(xs, keys, values)`: `xs` with each value at its key's place, a later one over an
          ;; earlier one at the same place: a list with some of its items replaced.
          (and (= name "updated") (= count 3))
            (let [xs (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty xs))
                      (die (mut k)
                           n
                           (cat "updated takes a list, not " (.ty xs))))
                  ks
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "[Int]")
                            "[Int]")
                  vs
                    (expect (mut k)
                            (get args 2)
                            (expr (mut k) (get args 2) (.ty xs))
                            (.ty xs))
                  o (fresh (mut k) "out")
                  kv (fresh (mut k) "keys")
                  vv (fresh (mut k) "values")
                  i (fresh (mut k) "i")
                  key-v (fresh (mut k) "key")]
              (Some (te `(let [(mut ~(sym o))
                                 ~(if (match (.kind (get args 0))
                                        (g/KName [] true)
                                        (g/KFieldE [] true)
                                        (g/KIndex [] true)
                                        (_ false))
                                      (list-copy (mut k) xs)
                                      (.code xs))
                               ~(sym kv) ~(.code ks)
                               ~(sym vv) ~(.code vs)]
                           (unless (= (len ~(sym kv)) (len ~(sym vv)))
                             (panic "updated needs a value for each key"))
                           (for ~(sym i) (range 0 (len ~(sym kv)))
                             (let [~(sym key-v) (get ~(sym kv) ~(sym i))]
                               (when (or (< ~(sym key-v) 0)
                                         (>= ~(sym key-v) (len ~(sym o))))
                                 (panic "updated: key {} is outside 0 to {}"
                                        ~(sym key-v)
                                        (len ~(sym o))))
                               (set! (mut ~(sym o))
                                     ~(sym key-v)
                                     (get ~(sym vv) ~(sym i)))))
                           ~(sym o))
                        (.ty xs))))
          ;; `histogram(n, keys)`: for keys from 0 below `n`, how many times each is in the list, as a list
          ;; of `n`; `histogram(n, keys, weights)` adds up the weights instead. Over a comprehension of
          ;; keys, each is counted as it is made.
          (and (= name "histogram") (or (= count 2) (= count 3)))
            (let [size
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Int")
                            "Int")
                  o (fresh (mut k) "bins")
                  n-v (fresh (mut k) "n")
                  key-v (fresh (mut k) "key")]
              (if (and (= count 2) (= (.kind (get args 1)) (g/KComp)))
                  (let [comp (get args 1)
                        mark (locals-mark (mut k))
                        (mut opened)
                          (ArrayList::new [HeadInfo] (malloc-allocator))
                        _
                          (for c (list-kids (kid comp 1))
                            (push! (mut opened) (clause-open! (mut k) c)))
                        key
                          (expect (mut k)
                                  (kid comp 0)
                                  (expr (mut k) (kid comp 0) "Int")
                                  "Int")
                        body
                          (clauses-code (mut k)
                                        (list-kids (kid comp 1))
                                        opened
                                        `(let [~(sym key-v) ~(.code key)]
                                           ~(histogram-add o key-v n-v `1)))]
                    (locals-reset! (mut k) mark)
                    (Some (te `(let [~(sym n-v) ~(.code size)
                                     (mut ~(sym o)) ~(zeros-code (mut k) n-v)]
                                 ~body
                                 ~(sym o))
                              "[Int]")))
                  (let [ks
                          (expect (mut k)
                                  (get args 1)
                                  (expr (mut k) (get args 1) "[Int]")
                                  "[Int]")
                        ws
                          (if (= count 3)
                              (.code (expect (mut k)
                                             (get args 2)
                                             (expr (mut k) (get args 2) "[Int]")
                                             "[Int]"))
                              `0)
                        kv (fresh (mut k) "keys")
                        wv (fresh (mut k) "weights")
                        i (fresh (mut k) "i")]
                    (Some (te `(let [~(sym n-v) ~(.code size)
                                     ~(sym kv) ~(.code ks)
                                     ~(sym wv) ~ws
                                     (mut ~(sym o)) ~(zeros-code (mut k) n-v)]
                                 ~(if (= count 3)
                                      `(unless (= (len ~(sym kv))
                                                  (len ~(sym wv)))
                                         (panic "histogram needs a weight for each key"))
                                      `0)
                                 (for ~(sym i) (range 0 (len ~(sym kv)))
                                   (let [~(sym key-v) (get ~(sym kv) ~(sym i))]
                                     ~(histogram-add o
                                                     key-v
                                                     n-v
                                                     (if (= count 3)
                                                         `(get ~(sym wv)
                                                               ~(sym i))
                                                         `1))))
                                 ~(sym o))
                              "[Int]")))))
          ;; Over a comprehension, each key is counted as it is made: no list of them.
          (and (= name "tally") (= count 1) (= (.kind (get args 0)) (g/KComp)))
            (let [comp (get args 0)
                  mark (locals-mark (mut k))
                  (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
                  _
                    (for c (list-kids (kid comp 1))
                      (push! (mut opened) (clause-open! (mut k) c)))
                  key (expr (mut k) (kid comp 0) "")
                  kt (.ty key)
                  _
                    (unless (or (= kt "Int") (= kt "Text"))
                      (die (mut k)
                           n
                           (cat "tally's keys are Int or Text, not " kt)))
                  ty (cat3 "{" kt ":Int}")
                  o (fresh (mut k) "tally")
                  kv (fresh (mut k) "key")
                  body
                    (clauses-code (mut k)
                                  (list-kids (kid comp 1))
                                  opened
                                  `(let [~(sym kv) ~(.code key)]
                                     (set! (mut ~(sym o))
                                           ~(sym kv)
                                           (+ (match (get ~(sym o) ~(sym kv))
                                                (Some [v] v)
                                                (None [] 0))
                                              1))))]
              (locals-reset! (mut k) mark)
              (Some (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)]
                           ~body
                           ~(sym o))
                        ty)))
          (and (= name "tally") (or (= count 1) (= count 2)))
            (let [ks (expr (mut k) (get args 0) "")
                  _
                    (unless (list? (.ty ks))
                      (die (mut k) n "tally counts the keys of a list"))
                  kt (elem-of (.ty ks))
                  _
                    (unless (or (= kt "Int") (= kt "Text"))
                      (die (mut k)
                           n
                           (cat "tally's keys are Int or Text, not " kt)))
                  ws
                    (if (= count 2)
                        (.code (expect (mut k)
                                       (get args 1)
                                       (expr (mut k) (get args 1) "[Int]")
                                       "[Int]"))
                        `0)
                  ty (cat3 "{" kt ":Int}")
                  o (fresh (mut k) "tally")
                  kv (fresh (mut k) "keys")
                  wv (fresh (mut k) "weights")
                  i (fresh (mut k) "i")
                  key (fresh (mut k) "key")]
              (Some (te `(let [~(sym kv) ~(.code ks)
                               ~(sym wv) ~ws
                               (mut ~(sym o)) ~(new-map (mut k) ty)]
                           ~(if (= count 2)
                                `(unless (= (len ~(sym kv)) (len ~(sym wv)))
                                   (panic "tally needs a weight for each key"))
                                `0)
                           (for ~(sym i) (range 0 (len ~(sym kv)))
                             (let [~(sym key) (get ~(sym kv) ~(sym i))]
                               (set! (mut ~(sym o))
                                     ~(sym key)
                                     (+ (match (get ~(sym o) ~(sym key))
                                          (Some [v] v)
                                          (None [] 0))
                                        ~(if (= count 2)
                                             `(get ~(sym wv) ~(sym i))
                                             `1)))))
                           ~(sym o))
                        ty)))
          (and (= name "reversed") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "xs")
                  o (fresh (mut k) "out")
                  i (fresh (mut k) "i")]
              (unless (list? (.ty e)) (die (mut k) n "reversed needs a list"))
              (Some (te `(let [~(sym t) ~(.code e)
                               (mut ~(sym o))
                                 ~(new-list (mut k) (elem-of (.ty e)))
                               (mut ~(sym i)) (len ~(sym t))]
                           (while (> ~(sym i) 0)
                             (set! ~(sym i) (- ~(sym i) 1))
                             (push! (mut ~(sym o)) (get ~(sym t) ~(sym i))))
                           ~(sym o))
                        (.ty e))))
          (and (= name "keys") (= count 1))
            (let [e (expr (mut k) (get args 0) "")
                  t (fresh (mut k) "k")
                  o (fresh (mut k) "out")]
              (unless (map? (.ty e)) (die (mut k) n "keys needs a map"))
              (Some (te `(let [(mut ~(sym o))
                                 ~(new-list (mut k) (map-key (.ty e)))]
                           (for ~(sym t) ~(.code e)
                             (push! (mut ~(sym o)) ~(sym t)))
                           ~(sym o))
                        (cat3 "[" (map-key (.ty e)) "]"))))
          ;; `parallel-map(xs, f, n)`: `f` of each element on `n` threads, results in the order of `xs`.
          ;; Each thread takes the next index it finds free, so uneven work evens out.
          (and (= name "parallel-map") (= count 3))
            (let [xs (expr (mut k) (get args 0) "")
                  f (expr (mut k) (get args 1) "")
                  threads
                    (expect (mut k)
                            (get args 2)
                            (expr (mut k) (get args 2) "Int")
                            "Int")]
              (unless (list? (.ty xs))
                (die (mut k) n "parallel-map needs a list"))
              (unless (fn? (.ty f))
                (die (mut k) n "parallel-map needs a function"))
              (let [t (elem-of (.ty xs))
                    ps (fn-params (.ty f))
                    r (fn-ret (.ty f))]
                (unless (and (= (len ps) 1) (= (get ps 0) t))
                  (die (mut k)
                       n
                       (cat4 "parallel-map's function must take one "
                             t
                             ", not "
                             (.ty f))))
                (let [ct (coil-type (mut k) t)
                      cr (coil-type (mut k) r)
                      job (fresh (mut k) "PJob")
                      body (fresh (mut k) "pjob-body")
                      xs-v (fresh (mut k) "pxs")
                      out-v (fresh (mut k) "pout")
                      job-v (fresh (mut k) "pjob")
                      res-v (fresh (mut k) "pres")
                      o-v (fresh (mut k) "po")
                      v-v (fresh (mut k) "pv")]
                  (push! (mut (.aux k))
                         `(defstruct ~(sym job)
                            [(next i64)
                             (xs (ArrayList ~ct))
                             (out (ArrayList (Option ~cr)))
                             (f (fnptr (cc/C) [~ct] ~cr))]))
                  (push! (mut (.aux k))
                         `(defn ~(sym body) [(arg (ptr i8))] (-> (ptr i8))
                            (let [j (cast (ptr ~(sym job)) arg)
                                  f (.f j)
                                  xs (.xs j)
                                  (mut out) (.out j)
                                  (mut go) true]
                              (while go
                                (let [i (atomic/add (cast (ptr i64) j) 1)]
                                  (if (< i (len xs))
                                      (set! (mut out) i (Some (f (get xs i))))
                                      (set! go false))))
                              arg)))
                  (Some (te `(let [~(sym xs-v) ~(.code xs)
                                   (mut ~(sym out-v))
                                     (ArrayList::new [(Option ~cr)]
                                                     (malloc-allocator))]
                               (for _ ~(sym xs-v)
                                 (push! (mut ~(sym out-v)) (None [~cr])))
                               (let [(mut ~(sym job-v))
                                       (~(sym job)
                                         :next 0
                                         :xs ~(sym xs-v)
                                         :out ~(sym out-v)
                                         :f ~(.code f))]
                                 (rt/run-workers (fnptr-of ~(sym body))
                                                 (cast (ptr i8)
                                                       (mut ~(sym job-v)))
                                                 ~(.code threads))
                                 (let [(mut ~(sym res-v))
                                         (ArrayList::new [~cr]
                                                         (rt/tree-allocator))]
                                   (for ~(sym o-v) (.out ~(sym job-v))
                                     (match ~(sym o-v)
                                       (Some [~(sym v-v)]
                                             (push! (mut ~(sym res-v))
                                                    ~(sym v-v)))
                                       (None []
                                             (panic "a parallel task left no result"))))
                                   ~(sym res-v))))
                            (cat3 "[" r "]"))))))
          ;; `parallel-walk(roots, visit, next, n)`: a graph found as it is walked. Each name is visited
          ;; once, on whichever of `n` threads takes it, and `next` of its result names more, visited
          ;; after what is waiting already. A thread that finds work waiting never waits for a whole
          ;; wave to finish. Results come in the order they finish.
          ;; `parallel-walk(roots, visit, next, first, n)`: `first` of a result names what goes on with
          ;; that item's own work, visited before anything waiting.
          ;; `parallel-walk(roots, visit, next, first, after, n)`: `after` of a result names what comes
          ;; once everything new `first` named for it has been visited, ahead of anything waiting.
          (and (= name "parallel-walk")
               (or (= count 4) (= count 5) (= count 6)))
            (let [roots
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "[Text]")
                            "[Text]")
                  visit (expr (mut k) (get args 1) "")
                  follow (expr (mut k) (get args 2) "")
                  urgent (if (>= count 5) (expr (mut k) (get args 3) "") follow)
                  has-urgent (>= count 5)
                  later (if (= count 6) (expr (mut k) (get args 4) "") follow)
                  has-later (= count 6)
                  threads
                    (expect (mut k)
                            (get args (- count 1))
                            (expr (mut k) (get args (- count 1)) "Int")
                            "Int")]
              (unless (fn? (.ty visit))
                (die (mut k) n "parallel-walk needs a function to visit with"))
              (let [ps (fn-params (.ty visit))
                    r (fn-ret (.ty visit))]
                (unless (and (= (len ps) 1) (= (get ps 0) "Text"))
                  (die (mut k)
                       n
                       "parallel-walk visits names: its function takes one Text"))
                (unless (= (.ty follow) (cat3 "Fn(" r ")->[Text]"))
                  (die (mut k)
                       n
                       (cat3 "parallel-walk's next must take a "
                             r
                             " and give [Text]")))
                (unless (= (.ty urgent) (cat3 "Fn(" r ")->[Text]"))
                  (die (mut k)
                       n
                       (cat3 "parallel-walk's first must take a "
                             r
                             " and give [Text]")))
                (unless (= (.ty later) (cat3 "Fn(" r ")->[Text]"))
                  (die (mut k)
                       n
                       (cat3 "parallel-walk's after must take a "
                             r
                             " and give [Text]")))
                (let [cr (coil-type (mut k) r)
                      job (fresh (mut k) "WJob")
                      body (fresh (mut k) "wjob-body")
                      job-v (fresh (mut k) "wjob")
                      res-v (fresh (mut k) "wres")
                      root-v (fresh (mut k) "wroot")]
                  (push! (mut (.aux k))
                         `(defstruct ~(sym job)
                            [(gate (ptr rt/Gate))
                             (head i64)
                             (busy i64)
                             (waiting i64)
                             (done i64)
                             (queue (ArrayList (slice u8)))
                             (seen (HashMap (slice u8) bool))
                             (results (ArrayList ~cr))
                             (visit (fnptr (cc/C) [(slice u8)] ~cr))
                             (follow (fnptr (cc/C) [~cr] (ArrayList (slice u8))))
                             (urgent (fnptr (cc/C) [~cr] (ArrayList (slice u8))))
                             (has-urgent bool)
                             (later (fnptr (cc/C) [~cr] (ArrayList (slice u8))))
                             (has-later bool)
                             ;; Items waited for: which wait each ends a part of, how many each wait has
                             ;; left, and what comes once it has none.
                             (group-of (HashMap (slice u8) i64))
                             (left (ArrayList i64))
                             (thens (ArrayList (ArrayList (slice u8))))]))
                  (push! (mut (.aux k))
                         `(defn ~(sym body) [(arg (ptr i8))] (-> (ptr i8))
                            ;; A worker with nothing to do sleeps until another adds work or finishes
                            ;; the last of it.
                            (let [j (cast (ptr ~(sym job)) arg)
                                  g (.gate j)
                                  visit (.visit j)
                                  follow (.follow j)
                                  urgent (.urgent j)
                                  later (.later j)
                                  (mut go) true]
                              (rt/gate-lock! g)
                              (while go
                                (if (< (.head j) (len (.queue j)))
                                    (let [item (get (.queue j) (.head j))]
                                      (set! (.head j) (+ (.head j) 1))
                                      (set! (.busy j) (+ (.busy j) 1))
                                      (rt/gate-unlock! g)
                                      (let [r (visit item)
                                            more (follow r)
                                            now
                                              (if (.has-urgent j)
                                                  (urgent r)
                                                  (ArrayList::new [(slice u8)]
                                                                  (malloc-allocator)))
                                            then
                                              (if (.has-later j)
                                                  (later r)
                                                  (ArrayList::new [(slice u8)]
                                                                  (malloc-allocator)))
                                            (mut added) false]
                                        (rt/gate-lock! g)
                                        (push! (mut (.results j)) r)
                                        ;; Ahead of what waits: into the places already taken, or a new queue.
                                        (let [(mut fresh)
                                                (ArrayList::new [(slice u8)]
                                                                (malloc-allocator))]
                                          (for x now
                                            (unless (match (get (.seen j) x)
                                                      (Some [_] true)
                                                      (None [] false))
                                              (set! (mut (.seen j)) x true)
                                              (push! (mut fresh) x)))
                                          ;; What comes after: once what is new above has been visited,
                                          ;; or at once if nothing is.
                                          (when (> (len then) 0)
                                            (if (> (len fresh) 0)
                                                (let [g (len (.left j))]
                                                  (push! (mut (.left j))
                                                         (len fresh))
                                                  (push! (mut (.thens j)) then)
                                                  (for x fresh
                                                    (set! (mut (.group-of j))
                                                          x
                                                          g)))
                                                (for x then
                                                  (unless (match (get (.seen j)
                                                                      x)
                                                            (Some [_] true)
                                                            (None [] false))
                                                    (set! (mut (.seen j))
                                                          x
                                                          true)
                                                    (push! (mut fresh) x)))))
                                          ;; This item may be the last a wait was for.
                                          (match (get (.group-of j) item)
                                            (Some [g]
                                                  (let [n
                                                          (- (get (.left j) g)
                                                             1)]
                                                    (set! (mut (.left j)) g n)
                                                    (when (= n 0)
                                                      (for x (get (.thens j) g)
                                                        (unless (match (get (.seen j)
                                                                            x)
                                                                  (Some [_]
                                                                        true)
                                                                  (None []
                                                                        false))
                                                          (set! (mut (.seen j))
                                                                x
                                                                true)
                                                          (push! (mut fresh) x))))))
                                            (None [] 0))
                                          (when (> (len fresh) 0)
                                            (set! added true)
                                            (if (>= (.head j) (len fresh))
                                                (let [start
                                                        (- (.head j)
                                                           (len fresh))]
                                                  (for i (range 0 (len fresh))
                                                    (set! (mut (.queue j))
                                                          (+ start i)
                                                          (get fresh i)))
                                                  (set! (.head j) start))
                                                (do
                                                  (for i (range (.head j)
                                                                (len (.queue j)))
                                                    (push! (mut fresh)
                                                           (get (.queue j) i)))
                                                  (set! (.queue j) fresh)
                                                  (set! (.head j) 0)))))
                                        (for x more
                                          (unless (match (get (.seen j) x)
                                                    (Some [_] true)
                                                    (None [] false))
                                            (set! (mut (.seen j)) x true)
                                            (push! (mut (.queue j)) x)
                                            (set! added true)))
                                        (set! (.busy j) (- (.busy j) 1))
                                        (atomic/store (field j waiting)
                                                      (- (len (.queue j))
                                                         (.head j)))
                                        (when (= (.busy j) 0)
                                          (atomic/store (field j done) 1))
                                        (when (or added (= (.busy j) 0))
                                          (rt/gate-wake-all! g))))
                                    (if (= (.busy j) 0)
                                        (do
                                          (atomic/store (field j done) 1)
                                          (set! go false))
                                        ;; A while looking for new work, then asleep until some comes.
                                        (do
                                          (atomic/store (field j waiting)
                                                        (- (len (.queue j))
                                                           (.head j)))
                                          (rt/gate-unlock! g)
                                          (let [(mut spins) 0]
                                            (while (and (< spins 4000)
                                                        (= (atomic/read (field j
                                                                               waiting))
                                                           0)
                                                        (= (atomic/read (field j
                                                                               done))
                                                           0))
                                              (set! spins (+ spins 1)))
                                            (rt/gate-lock! g)
                                            (when (and (= spins 4000)
                                                       (>= (.head j)
                                                           (len (.queue j)))
                                                       (> (.busy j) 0))
                                              (rt/gate-wait! g)))))))
                              (rt/gate-unlock! g)
                              arg)))
                  (Some (te `(let [(mut ~(sym job-v))
                                     (~(sym job)
                                       :gate (rt/gate-new)
                                       :head 0
                                       :busy 0
                                       :waiting 0
                                       :done 0
                                       :queue
                                         (ArrayList::new [(slice u8)]
                                                         (malloc-allocator))
                                       :seen
                                         (HashMap::new [(slice u8) bool]
                                                       (malloc-allocator)
                                                       (str/keyops))
                                       :results
                                         (ArrayList::new [~cr]
                                                         (malloc-allocator))
                                       :visit ~(.code visit)
                                       :follow ~(.code follow)
                                       :urgent ~(.code urgent)
                                       :has-urgent ~(if has-urgent `true `false)
                                       :later ~(.code later)
                                       :has-later ~(if has-later `true `false)
                                       :group-of
                                         (HashMap::new [(slice u8) i64]
                                                       (malloc-allocator)
                                                       (str/keyops))
                                       :left
                                         (ArrayList::new [i64]
                                                         (malloc-allocator))
                                       :thens
                                         (ArrayList::new [(ArrayList (slice u8))]
                                                         (malloc-allocator)))]
                               (for ~(sym root-v) ~(.code roots)
                                 (unless (match (get (.seen ~(sym job-v))
                                                     ~(sym root-v))
                                           (Some [_] true)
                                           (None [] false))
                                   (set! (mut (.seen ~(sym job-v)))
                                         ~(sym root-v)
                                         true)
                                   (push! (mut (.queue ~(sym job-v)))
                                          ~(sym root-v))))
                               ;; What arrives where (`arrive!`) is counted afresh for each walk.
                               (rt/arrivals-reset!)
                               (rt/run-workers (fnptr-of ~(sym body))
                                               (cast (ptr i8)
                                                     (mut ~(sym job-v)))
                                               ~(.code threads))
                               (let [(mut ~(sym res-v))
                                       (ArrayList::new [~cr]
                                                       (rt/tree-allocator))]
                                 (for x (.results ~(sym job-v))
                                   (push! (mut ~(sym res-v)) x))
                                 ~(sym res-v)))
                            (cat3 "[" r "]"))))))
          ;; `timed(on, label, e)`: `e`, and when `on`, how long it has been since the last lap said.
          (and (= name "timed") (= count 3))
            (let [on
                    (expect (mut k)
                            (get args 0)
                            (expr (mut k) (get args 0) "Bool")
                            "Bool")
                  label
                    (expect (mut k)
                            (get args 1)
                            (expr (mut k) (get args 1) "Text")
                            "Text")
                  v (expr (mut k) (get args 2) "")
                  x (fresh (mut k) "timed")]
              (Some (if (= (.ty v) "Void")
                        (te `(do
                               ~(.code v)
                               (when ~(.code on) (rt/lap! ~(.code label)))
                               0)
                            "Void")
                        (te `(let [~(sym x) ~(.code v)]
                               (when ~(.code on) (rt/lap! ~(.code label)))
                               ~(sym x))
                            (.ty v)))))
          (and (= name "include-text")
               (= count 1)
               (= (.kind (get args 0)) (g/KStr)))
            (Some (te `(~(sym "include-str") ~(str-literal (get args 0)))
                      "Text"))
          :else (None [TE]))))

(defn call-expr [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [callee (kid n 0)
        args (list-kids (kid n 1))]
    (match (.kind callee)
      (g/KName []
               (let [name (.text callee)]
                 (match (find-local (mut k) name)
                   (Some [l]
                         (unless (fn? (.ty l))
                           (die (mut k)
                                n
                                (cat4 name " is a " (.ty l) ", not a function")))
                         (fn-value-call (mut k) n (sym (.sym l)) (.ty l) args))
                   (None []
                         (match (builtin-call (mut k) n name args)
                           (Some [b] b)
                           (None []
                                 (match (find-func (self-mod (mut k)) name)
                                   (Some [f]
                                         (call-func (mut k) n (.self k) f args))
                                   (None []
                                         (match (find-global (self-mod (mut k))
                                                             name)
                                           (Some [x]
                                                 (unless (fn? (.ty x))
                                                   (die (mut k)
                                                        n
                                                        (cat4 name
                                                              " is a "
                                                              (.ty x)
                                                              ", not a function")))
                                                 (fn-value-call (mut k)
                                                                n
                                                                `(~(primitive/code-symbol "."
                                                                                          name) ~(storage-call (mut k)
                                                                                                               x))
                                                                (.ty x)
                                                                args))
                                           (None []
                                                 (match (find-func (mod-at (mut k)
                                                                           "hl.rt")
                                                                   name)
                                                   (Some [f]
                                                         (if (and (= name
                                                                     "join")
                                                                  (= (len args)
                                                                     2)
                                                                  (= (.kind (get args
                                                                                 0))
                                                                     (g/KComp))
                                                                  (= (.kind (get args
                                                                                 1))
                                                                     (g/KStr)))
                                                             (join-comprehension (mut k)
                                                                                 (get args
                                                                                      0)
                                                                                 (get args
                                                                                      1))
                                                             (call-func (mut k)
                                                                        n
                                                                        "hl.rt"
                                                                        f
                                                                        args)))
                                                   (None []
                                                         (die (mut k)
                                                              callee
                                                              (cat "no function named "
                                                                   name))))))))))))))
      (g/KFieldE []
                 (let [base (kid callee 0)
                       name (.text (kid callee 1))]
                   (match (module-prefix (mut k) base)
                     (Some [module]
                           (match (find-func (mod-at (mut k) module) name)
                             (Some [f] (call-func (mut k) n module f args))
                             (None []
                                   (die (mut k)
                                        callee
                                        (cat4 module
                                              " has no function named "
                                              name
                                              "")))))
                     (None []
                           (let [b
                                   (if (is-place? base)
                                       (place (mut k) base)
                                       (expr (mut k) base ""))]
                             (if (and (> (last-dot (.ty b)) 0)
                                      (= (type-name (.ty b)) "Db")
                                      (not (builtin-type? (.ty b))))
                                 (relation-test (mut k) n b name args)
                                 (let [ft
                                         (field-type (mut k)
                                                     callee
                                                     (.ty b)
                                                     name)]
                                   (unless (fn? ft)
                                     (die (mut k)
                                          n
                                          (cat name " is not a function")))
                                   (fn-value-call (mut k)
                                                  n
                                                  `(~(primitive/code-symbol "."
                                                                            name) ~(.code b))
                                                  ft
                                                  args))))))))
      (g/KMember []
                 (ctor-qualified (mut k) n callee args want))
      (_ (die (mut k) n "this cannot be called")))))

;;; Whether `(mut e)` may be taken: a `var`, a setting or state, or a field of one.
(defn writable? [(k (mut Comp)) (e g/Node)] (-> bool)
  (match (.kind e)
    (g/KName []
             (match (find-local (mut k) (.text e))
               (Some [l] (.mutable l))
               (None [] true)))
    (g/KFieldE []
               (match (module-prefix (mut k) (kid e 0))
                 (Some [_] true)
                 (None [] (writable? (mut k) (kid e 0)))))
    (g/KGroup [] (writable? (mut k) (kid e 0)))
    (_ false)))

(defn is-place? [(e g/Node)] (-> bool)
  (match (.kind e)
    (g/KName [] true)
    (g/KFieldE [] (is-place? (kid e 0)))
    (g/KIndex [] (is-place? (kid e 0)))
    (g/KGroup [] (is-place? (kid e 0)))
    (_ false)))

;;; A named function as a value, as the pointer its type says. A Coil function takes a struct by
;;; reference, and `fnptr-of` gives the entry that takes it by value only when it knows the pointer
;;; type wanted: a map or list of functions would otherwise hold the other kind.
(defn fn-value [(k (mut Comp)) (ptr Code) (f Func)] (-> Code)
  `(: ~ptr ~(coil-type (mut k) (func-type f))))

(defn fn-value-call [(k (mut Comp))
                     (n g/Node)
                     (f Code)
                     (ty (slice u8))
                     (args (ArrayList g/Node))] (-> TE)
  (let [ps (fn-params ty)
        (mut out) (primitive/code-list-new)]
    (unless (= (len ps) (len args))
      (die (mut k)
           n
           (cat "wrong number of arguments for a function of type " ty)))
    (for i (range 0 (len args))
      (let [x
              (expect (mut k)
                      (get args i)
                      (expr (mut k) (get args i) (get ps i))
                      (get ps i))]
        (push! (mut out) (.code x))))
    ;; A call's head must be a name.
    (let [t (fresh (mut k) "f")]
      (te `(let [~(sym t) ~f] (~(sym t) ~@out)) (fn-ret ty)))))

;;; `db.rel(a, b)` as a question: is there such a row? `_` matches anything.
(defn relation-test [(k (mut Comp))
                     (n g/Node)
                     (db TE)
                     (rel (slice u8))
                     (args (ArrayList g/Node))] (-> TE)
  (rel-check (mut k) n (.ty db) rel (len args))
  (let [module (type-module (.ty db))
        (mut wild) false
        (mut cs) (primitive/code-list-new)]
    (for a args
      (when (and (= (.kind a) (g/KName)) (= (.text a) "_")) (set! wild true)))
    (if wild
        (let [mark (locals-mark (mut k))
              label (primitive/code-symbol ":" (fresh (mut k) "q"))
              h (query-open! (mut k) n)
              code (head-wrap (mut k) h `(return-from ~label true))]
          (locals-reset! (mut k) mark)
          (te `(block ~label ~code false) "Bool"))
        (do
          (for a args
            (let [x (expect (mut k) a (expr (mut k) a "Int") "Int")]
              (push! (mut cs) (.code x))))
          (let [has (sym (qualified (mut k) module (cat3 "has-" rel "?")))]
            (if (writable? (mut k) (kid (kid n 0) 0))
                (te `(~has (mut ~(.code db)) ~@cs) "Bool")
                ;; Read through a copy, as a query does: the copies share their indexes.
                (let [copy (sym (fresh (mut k) "db"))]
                  (te `(let [(mut ~copy) ~(.code db)] (~has (mut ~copy) ~@cs)) "Bool"))))))))

;; ---------------------------------------------------------------- constructors

(defn build-record [(k (mut Comp))
                    (n g/Node)
                    (module (slice u8))
                    (r RecDef)
                    (args (ArrayList g/Node))] (-> TE)
  (let [(mut inits) (primitive/code-list-new)]
    (for a args
      (unless (= (.kind a) (g/KNamed))
        (die (mut k) a (cat3 "the fields of " (.name r) " are given by name"))))
    (for f (.fields r)
      (let [(mut found) false]
        (for a args
          (when (= (.text (kid a 0)) (.name f))
            (set! found true)
            (push! (mut inits) (primitive/code-symbol ":" (.name f)))
            (push! (mut inits)
                   (.code (expect (mut k)
                                  (kid a 1)
                                  (expr (mut k) (kid a 1) (.ty f))
                                  (.ty f))))))
        (unless found
          (die (mut k) n (cat4 (.name r) " needs its field " (.name f) "")))))
    (for a args
      (let [(mut known) false]
        (for f (.fields r)
          (when (= (.name f) (.text (kid a 0))) (set! known true)))
        (unless known
          (die (mut k)
               a
               (cat4 (.name r) " has no field named " (.text (kid a 0)) "")))))
    (te `(~(sym (qualified (mut k) module (.name r))) ~@inits)
        (cat3 module "." (.name r)))))

(defn build-node [(k (mut Comp))
                  (n g/Node)
                  (gr Mod)
                  (entry syntax/KindEntry)
                  (args (ArrayList g/Node))] (-> TE)
  (let [alias (alias-of (.name gr))
        ty (cat (.name gr) ".Node")
        kind (kind-code gr (.name entry))]
    (cond (.leaf entry)
            (do
              (unless (= (len args) 1)
                (die (mut k)
                     n
                     (cat (.name entry) " is a token: it holds one text")))
              (let [t
                      (expect (mut k)
                              (get args 0)
                              (expr (mut k) (get args 0) "Text")
                              "Text")]
                (te `(~(primitive/code-symbol alias "/leaf") (~kind)
                        ~(.code t)
                        0
                        0)
                    ty)))
          (= (.name entry) "None")
            (te `(~(primitive/code-symbol alias "/none-node")) ty)
          :else
            (let [(mut pushes) (primitive/code-list-new)
                  (mut count) 0
                  (mut spread) false
                  kids (fresh (mut k) "kids")]
              (for a args
                (if (spread-arg? a)
                    (let [xs (spread-list (mut k) a (cat3 "[" ty "]"))
                          each (fresh (mut k) "each")]
                      (set! spread true)
                      (push! (mut pushes)
                             `(for (ref ~(sym each)) ~xs
                                (push! (mut ~(sym kids)) ~(sym each)))))
                    (let [x (expect (mut k) a (expr (mut k) a ty) ty)]
                      (set! count (+ count 1))
                      (push! (mut pushes) `(push! (mut ~(sym kids)) ~(.code x))))))
              (when (and (>= (.arity entry) 0)
                         (not spread)
                         (!= count (.arity entry)))
                (die (mut k)
                     n
                     (cat4 (.name entry)
                           " has "
                           (rt/num-text (.arity entry))
                           (cat " children, this gives it " (rt/num-text count)))))
              (te `(let [(mut ~(sym kids))
                           (~(primitive/code-symbol alias "/new-kids"))]
                     ~@pushes
                     (~(primitive/code-symbol alias "/mk") (~kind)
                        ~(sym kids)
                        0
                        0))
                  ty)))))

(defn spread-arg? [(a g/Node)] (-> bool)
  (or (= (.kind a) (g/KRest)) (= (.kind a) (g/KSpread))))

;;; `xs...` or `e...` in a list or a node: the list whose items go in, which must be a `want`.
(defn spread-list [(k (mut Comp)) (a g/Node) (want (slice u8))] (-> Code)
  (if (= (.kind a) (g/KRest))
      (let [name (subslice (.text a) 0 (- (len (.text a)) 3))]
        (match (find-local (mut k) name)
          (None [] (die (mut k) a (cat "nothing named " name)))
          (Some [l]
                (unless (= (.ty l) want)
                  (die (mut k)
                       a
                       (cat4 "only a " want " can be spread here, not " (.ty l))))
                (sym (.sym l)))))
      (.code (expect (mut k) (kid a 0) (expr (mut k) (kid a 0) want) want))))

(defn ctor [(k (mut Comp))
            (n g/Node)
            (name (slice u8))
            (args (ArrayList g/Node))] (-> TE)
  (let [m (self-mod (mut k))]
    (match (find-rec m name)
      (Some [r] (build-record (mut k) n (.self k) r args))
      (None []
            (match (find-rec (mod-at (mut k) "hl.rt") name)
              (Some [r] (build-record (mut k) n "hl.rt" r args))
              (None []
                    (when (= (len (.over m)) 0)
                      (die (mut k)
                           n
                           (cat3 "no record named "
                                 name
                                 ", and this file names no grammar")))
                    (let [gr (mod-at (mut k) (.over m))]
                      (match (find-kind gr name)
                        (Some [entry] (build-node (mut k) n gr entry args))
                        (None []
                              (die (mut k)
                                   n
                                   (cat4 "nothing named "
                                         name
                                         " here, nor in the grammar "
                                         (.name gr))))))))))))

(defn ctor-qualified [(k (mut Comp))
                      (n g/Node)
                      (callee g/Node)
                      (args (ArrayList g/Node))
                      (want (slice u8))] (-> TE)
  (let [base (kid callee 0)
        name (.text (kid callee 1))]
    (match (module-prefix (mut k) base)
      (None [] (die (mut k) callee "expected module.Name"))
      (Some [module]
            (let [m (mod-at (mut k) module)]
              (match (find-rec m name)
                (Some [r] (build-record (mut k) n module r args))
                (None []
                      (match (find-kind m name)
                        (Some [entry] (build-node (mut k) n m entry args))
                        (None []
                              (die (mut k)
                                   callee
                                   (cat4 module " has nothing named " name "")))))))))))

;; ---------------------------------------------------------------- templates

(defn hole-name? [(c u8)] (-> bool)
  (or (rt/name-char? c)))

(defn template [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [raw (.text n)
        (mut tick) 0]
    (while (!= (get raw tick) #\`) (set! tick (+ tick 1)))
    (let [tag (subslice raw 0 tick)
          src (subslice raw (+ tick 1) (- (len raw) 1))
          m (self-mod (mut k))
          (mut path-code) (primitive/code-list-new)
          (mut known) false
          (mut holes) (primitive/code-list-new)
          (mut seen) (text-list)
          (mut i) 0]
      (when (= (len (.over m)) 0)
        (die (mut k) n "a template needs `over GRAMMAR` in the header"))
      (for q (.quotes m)
        (when (= (.name q) tag)
          (set! known true)
          (for s (.path q) (push! (mut path-code) `~s))))
      (unless known
        (die (mut k)
             n
             (cat3 "no template form named " tag "; declare it with `quote`")))
      ;; Each `$name` is a variable in scope, with `_` standing for `-`: JavaScript
      ;; names have no hyphen.
      (while (< i (len src))
        (if (= (get src i) #\$)
            (let [splice (and (< (+ i 1) (len src)) (= (get src (+ i 1)) #\$))
                  from (if splice (+ i 2) (+ i 1))
                  (mut j) from]
              (while (and (< j (len src)) (hole-name? (get src j)))
                (set! j (+ j 1)))
              (when (> j from)
                (let [name (subslice src from j)
                      (mut dashed) (str/StrBuf::new (malloc-allocator))
                      (mut dup) false]
                  (for c name
                    (push! (mut (.bytes dashed)) (if (= c #\_) #\- c)))
                  (for s seen (when (= s name) (set! dup true)))
                  (unless dup
                    (push! (mut seen) name)
                    (let [var-name (finish! (mut dashed))]
                      (match (find-local (mut k) var-name)
                        (None []
                              (die (mut k)
                                   n
                                   (cat "this template's hole has no variable named "
                                        var-name)))
                        (Some [l]
                              (let [sort
                                      (cond (= (.ty l) "Text") "text"
                                            (= (.ty l) (cat (.over m) ".Node"))
                                              "node"
                                            (= (.ty l)
                                               (cat3 "[" (.over m) ".Node]"))
                                              "list"
                                            :else
                                              (die (mut k)
                                                   n
                                                   (cat4 "a hole holds text, a node or a list of nodes, but "
                                                         var-name
                                                         " is "
                                                         (.ty l))))]
                                (push! (mut holes)
                                       `(~name ~(sym (.sym l)) ~sort))))))))
                (set! i j))
              (when (<= j from) (set! i (+ i 1))))
            (set! i (+ i 1))))
      (te `(~(primitive/code-symbol (alias-of (.over m)) "/quote-template") ~(alias-of (.over m))
              ~(unescape-template src)
              (~@path-code)
              (~@holes))
          (cat (.over m) ".Node")))))

(defn unescape-template [(src (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))
        (mut i) 0]
    (while (< i (len src))
      (if (and (= (get src i) #\\)
               (< (+ i 1) (len src))
               (= (get src (+ i 1)) #\`))
          (do (push! (mut (.bytes b)) #\`) (set! i (+ i 2)))
          (do (push! (mut (.bytes b)) (get src i)) (set! i (+ i 1)))))
    (finish! (mut b))))

;; ---------------------------------------------------------------- expressions

;;; Whether a concatenation of lists is made in one list: one of more than two, or one with a part that
;;; is being made (a comprehension or a list written out), which can go straight in.
(defn one-buffer? [(n g/Node)] (-> bool)
  (let [(mut parts) (ArrayList::new [g/Node] (malloc-allocator))
        (mut made) false]
    (concat-operands! n (mut parts))
    (for p parts
      (let [q (if (= (.kind p) (g/KGroup)) (kid p 0) p)]
        (when (or (= (.kind q) (g/KComp))
                  (= (.kind q) (g/KCompSpread))
                  (= (.kind q) (g/KListLit)))
          (set! made true))))
    (or made (> (len parts) 2))))

(defn concat-operands! [(n g/Node) (out (mut (ArrayList g/Node)))] (-> void)
  (if (= (.kind n) (g/KConcat))
      (do
        (concat-operands! (kid n 0) (mut out))
        (concat-operands! (kid n 1) (mut out)))
      (push! (mut out) n)))

(defn binary-int [(k (mut Comp)) (n g/Node) (op Code)] (-> TE)
  (let [a (expect (mut k) (kid n 0) (expr (mut k) (kid n 0) "Int") "Int")
        b (expect (mut k) (kid n 1) (expr (mut k) (kid n 1) "Int") "Int")]
    (te `(~op ~(.code a) ~(.code b)) "Int")))

(defn compare [(k (mut Comp)) (n g/Node) (op Code)] (-> TE)
  (let [a (expr (mut k) (kid n 0) "")
        b (expr (mut k) (kid n 1) (.ty a))]
    (unless (= (.ty a) (.ty b))
      (die (mut k) n (cat4 "cannot compare " (.ty a) " with " (.ty b))))
    (if (= (.ty a) "Text")
        (te `(~op (str/cmp ~(.code a) ~(.code b)) 0) "Bool")
        (do
          (unless (= (.ty a) "Int")
            (die (mut k) n (cat "cannot order " (.ty a))))
          (te `(~op ~(.code a) ~(.code b)) "Bool")))))

(defn equality [(k (mut Comp)) (n g/Node) (negate bool)] (-> TE)
  (let [left (kid n 0)
        right (kid n 1)]
    (if (= (.kind right) (g/KNoneE))
        (let [a (expr (mut k) left "")]
          (te (if negate
                  `(match ~(.code a) (Some [_] true) (None [] false))
                  `(match ~(.code a) (Some [_] false) (None [] true)))
              "Bool"))
        (let [a (expr (mut k) left "")
              b (expr (mut k) right (.ty a))]
          (unless (= (.ty a) (.ty b))
            (die (mut k) n (cat4 "cannot compare " (.ty a) " with " (.ty b))))
          (when (or (list? (.ty a)) (map? (.ty a)) (opt? (.ty a)))
            (die (mut k) n (cat "cannot compare values of " (.ty a))))
          (te (if negate `(!= ~(.code a) ~(.code b)) `(= ~(.code a) ~(.code b)))
              "Bool")))))

(defn in-test [(k (mut Comp)) (n g/Node)] (-> TE)
  (let [right (expr (mut k) (kid n 1) "")
        t (.ty right)]
    (cond (list? t)
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) (elem-of t))
                            (elem-of t))
                  x (fresh (mut k) "x")
                  e (fresh (mut k) "e")
                  label (primitive/code-symbol ":" (fresh (mut k) "in"))]
              (te `(let [~(sym x) ~(.code a)]
                     (block
                       ~label
                       (for ~(sym e) ~(.code right)
                         (when (= ~(sym e) ~(sym x)) (return-from ~label true)))
                       false))
                  "Bool"))
          (map? t)
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) (map-key t))
                            (map-key t))]
              (te `(match (get ~(.code right) ~(.code a))
                     (Some [_] true)
                     (None [] false))
                  "Bool"))
          (= t "Text")
            (let [a
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Text")
                            "Text")]
              (te `(rt/contains-text? ~(.code right) ~(.code a)) "Bool"))
          :else (die (mut k) n (cat "cannot look inside " t)))))

(defn if-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [c (expect (mut k) (kid n 0) (expr (mut k) (kid n 0) "Bool") "Bool")
        then-node (kid n 1)
        else-node (kid n 2)]
    (if (none? else-node)
        (te `(when ~(.code c) ~(.code (stmt (mut k) then-node "Void"))) "Void")
        (let [want
                (cond (> (len want0) 0) want0
                      (needs-want? then-node) (.ty (stmt (mut k) else-node ""))
                      :else "")
              a (stmt (mut k) then-node want)
              b
                (stmt (mut k)
                      else-node
                      (if (and (= (len want) 0) (!= (.ty a) "Never"))
                          (.ty a)
                          want))
              ty (unify (mut k) n (.ty a) (.ty b))]
          (te (if (= ty "Void")
                  `(if ~(.code c) (do ~(.code a) 0) (do ~(.code b) 0))
                  `(if ~(.code c) ~(.code a) ~(.code b)))
              ty)))))

(defn if-let-code [(k (mut Comp)) (n g/Node) (want0 (slice u8))] (-> TE)
  (let [pattern (kid n 0)
        subject (expr (mut k) (kid n 1) "")
        s (fresh (mut k) "m")
        label (primitive/code-symbol ":" (fresh (mut k) "if"))
        mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) pattern (sym s) (.ty subject) (mut steps) "")
    (let [else-node (kid n 3)
          want
            (if (> (len want0) 0)
                want0
                (if (none? else-node) "Void" ""))
          body (expr (mut k) (kid n 2) want)
          ty0 (.ty body)
          inner
            (cond (= ty0 "Never") (.code body)
                  (or (= ty0 "Void") (= want "Void"))
                    `(do ~(.code body) (return-from ~label 0))
                  :else `(return-from ~label ~(.code body)))
          wrapped (wrap-steps steps 0 inner)]
      (locals-reset! (mut k) mark)
      (if (none? else-node)
          (te `(let [~(sym s) ~(.code subject)] (block ~label ~wrapped 0))
              "Void")
          (let [b
                  (stmt (mut k)
                        else-node
                        (if (> (len want) 0) want (if (= ty0 "Never") "" ty0)))
                ty (unify (mut k) n ty0 (.ty b))]
            (te `(let [~(sym s) ~(.code subject)]
                   (block
                     ~label
                     ~wrapped
                     ~(if (= ty "Void") `(do ~(.code b) 0) (.code b))))
                ty))))))

;;; `[e for …]`, or with `spread`, `[e... for …]`: each `e` a list whose items all go in.
(defn comprehension [(k (mut Comp)) (n g/Node) (want (slice u8)) (spread bool)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        value (kid n 0)
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 1)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [twin (if spread (into-twin (mut k) value) (None [Func]))
          v
            (match twin
              (Some [f]
                    (te `0
                        (.ty (get (.params f) (len (list-kids (kid value 1)))))))
              (None []
                    (expr (mut k)
                          value
                          (if spread want (if (list? want) (elem-of want) "")))))
          _
            (when (and spread (not (list? (.ty v))))
              (die (mut k)
                   value
                   (cat "only a list can be spread, not " (.ty v))))
          elem (if spread (elem-of (.ty v)) (.ty v))
          o (fresh (mut k) "out")
          each (fresh (mut k) "each")
          push-code
            (match twin
              (Some [_] (spread-into (mut k) value (sym o) (.ty v)))
              (None []
                    (if spread
                        `(for (ref ~(sym each)) ~(.code v)
                           (push! (mut ~(sym o)) ~(sym each)))
                        `(push! (mut ~(sym o)) ~(.code v)))))
          clauses (list-kids (kid n 1))
          ;; One loop over a list or a range, with nothing that skips an item: as many items as it
          ;; has, made room for at once, so the list never moves as it grows.
          sized
            (and (not spread)
                 (= (len clauses) 1)
                 (or (= (.kind (get clauses 0)) (g/KInHead))
                     (= (.kind (get clauses 0)) (g/KRangeHead)))
                 (or (= (.wrap-kind (get opened 0)) 0)
                     (= (.wrap-kind (get opened 0)) 3)))]
      (if sized
          (let [h (get opened 0)
                seq (fresh (mut k) "seq")
                hi (fresh (mut k) "hi")
                (mut held) h]
            (set! (.seq held) (sym seq))
            (when (= (.wrap-kind h) 3) (set! (.hi held) (sym hi)))
            (let [loop (head-wrap (mut k) held push-code)
                  code
                    (if (= (.wrap-kind h) 3)
                        `(let [~(sym seq) ~(.seq h)
                               ~(sym hi) ~(.hi h)
                               (mut ~(sym o)) ~(new-list (mut k) elem)]
                           (when (> ~(sym hi) ~(sym seq))
                             (reserve! (mut ~(sym o)) (- ~(sym hi) ~(sym seq))))
                           ~loop
                           ~(sym o))
                        `(let [~(sym seq) ~(.seq h)
                               (mut ~(sym o)) ~(new-list (mut k) elem)]
                           (reserve! (mut ~(sym o)) (len ~(sym seq)))
                           ~loop
                           ~(sym o)))]
              (locals-reset! (mut k) mark)
              (te code (cat3 "[" elem "]"))))
          (let [body (clauses-code (mut k) clauses opened push-code)]
            (locals-reset! (mut k) mark)
            (te `(let [(mut ~(sym o)) ~(new-list (mut k) elem)] ~body ~(sym o))
                (cat3 "[" elem "]")))))))

;;; `{key: value for …}`: a later key replaces an earlier one, as assigning would.
(defn map-comprehension [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [mark (locals-mark (mut k))
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 2)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [key (expr (mut k) (kid n 0) (if (map? want) (map-key want) ""))
          val (expr (mut k) (kid n 1) (if (map? want) (map-val want) ""))
          ty (cat4 "{" (.ty key) ":" (cat (.ty val) "}"))
          o (fresh (mut k) "out")
          body
            (clauses-code (mut k)
                          (list-kids (kid n 2))
                          opened
                          `(set! (mut ~(sym o)) ~(.code key) ~(.code val)))]
      (locals-reset! (mut k) mark)
      (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)] ~body ~(sym o)) ty))))

;;; `{k: v, …}`: typed by what is wanted, or else by its first entry.
(defn map-literal [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [entries (list-kids (kid n 0))
        e0 (get entries 0)
        ty
          (if (map? want)
              want
              (cat4 "{"
                    (.ty (expr (mut k) (kid e0 0) ""))
                    ":"
                    (cat (.ty (expr (mut k) (kid e0 1) "")) "}")))
        o (fresh (mut k) "out")]
    (te `(let [(mut ~(sym o)) ~(new-map (mut k) ty)]
           ~(map-extend-code (mut k) n (sym o) ty)
           ~(sym o))
        ty)))

;;; `m ++= e`, as a fold accumulating a map does it: a literal's entries, or a comprehension's, go
;;; straight into `m`; the right of `a ++ b` wins.
(defn map-extend-code [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (match (.kind e)
    (g/KMapLit []
               (let [(mut sets) (primitive/code-list-new)]
                 (for x (list-kids (kid e 0))
                   (let [key
                           (expect (mut k)
                                   (kid x 0)
                                   (expr (mut k) (kid x 0) (map-key t))
                                   (map-key t))
                         val
                           (expect (mut k)
                                   (kid x 1)
                                   (expr (mut k) (kid x 1) (map-val t))
                                   (map-val t))]
                     (push! (mut sets)
                            `(set! (mut ~target) ~(.code key) ~(.code val)))))
                 `(do ~@sets 0)))
    (g/KConcat []
               `(do
                  ~(map-extend-code (mut k) (kid e 0) target t)
                  ~(map-extend-code (mut k) (kid e 1) target t)
                  0))
    (g/KMapComp []
                (let [mark (locals-mark (mut k))
                      (mut opened)
                        (ArrayList::new [HeadInfo] (malloc-allocator))]
                  (for c (list-kids (kid e 2))
                    (push! (mut opened) (clause-open! (mut k) c)))
                  (let [key
                          (expect (mut k)
                                  (kid e 0)
                                  (expr (mut k) (kid e 0) (map-key t))
                                  (map-key t))
                        val
                          (expect (mut k)
                                  (kid e 1)
                                  (expr (mut k) (kid e 1) (map-val t))
                                  (map-val t))
                        body
                          (clauses-code (mut k)
                                        (list-kids (kid e 2))
                                        opened
                                        `(set! (mut ~target)
                                               ~(.code key)
                                               ~(.code val)))]
                    (locals-reset! (mut k) mark)
                    `(do ~body 0))))
    (_ (let [v (expect (mut k) e (expr (mut k) e t) t)]
         (map-copy-into (mut k) (.code v) target)))))

(defn map-copy-into [(k (mut Comp)) (from Code) (target Code)] (-> Code)
  (let [m (fresh (mut k) "m")
        x (fresh (mut k) "key")
        v (fresh (mut k) "v")]
    `(let [~(sym m) ~from]
       (for ~(sym x) ~(sym m)
         (match (get ~(sym m) ~(sym x))
           (Some [~(sym v)] (set! (mut ~target) ~(sym x) ~(sym v)))
           (None [] 0)))
       0)))

;;; `join([a ++ b for …], ", ")`: each item's pieces go straight into one buffer, with no list and no
;;; text for each item. The separator is a literal, so nothing it does can move.
(defn join-comprehension [(k (mut Comp)) (comp g/Node) (sep-node g/Node)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        b (fresh (mut k) "b")
        first (fresh (mut k) "first")
        sep (expect (mut k) sep-node (expr (mut k) sep-node "Text") "Text")
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))
        (mut parts) (ArrayList::new [g/Node] (malloc-allocator))
        (mut pushes) (primitive/code-list-new)]
    (for c (list-kids (kid comp 1))
      (push! (mut opened) (clause-open! (mut k) c)))
    (if (= (.kind (kid comp 0)) (g/KConcat))
        (concat-operands! (kid comp 0) (mut parts))
        (push! (mut parts) (kid comp 0)))
    (for p parts
      (let [x (expect (mut k) p (expr (mut k) p "Text") "Text")]
        (push! (mut pushes) `(push-str! (mut ~(sym b)) ~(.code x)))))
    (let [each
            `(do
               (unless ~(sym first) (push-str! (mut ~(sym b)) ~(.code sep)))
               (set! ~(sym first) false)
               ~@pushes)
          body (clauses-code (mut k) (list-kids (kid comp 1)) opened each)]
      (locals-reset! (mut k) mark)
      (te `(let [(mut ~(sym b)) (str/StrBuf::new (malloc-allocator))
                 (mut ~(sym first)) true]
             ~body
             (finish! (mut ~(sym b))))
          "Text"))))

(defn zeros-code [(k (mut Comp)) (n-v (slice u8))] (-> Code)
  `(let [(mut z) ~(new-list (mut k) "Int")]
     (reserve! (mut z) ~(sym n-v))
     (for _ (range 0 ~(sym n-v)) (push! (mut z) 0))
     z))

(defn histogram-add [(o (slice u8))
                     (key-v (slice u8))
                     (n-v (slice u8))
                     (w Code)] (-> Code)
  `(do
     (when (or (< ~(sym key-v) 0) (>= ~(sym key-v) ~(sym n-v)))
       (panic "histogram key {} is outside 0 to {}" ~(sym key-v) ~(sym n-v)))
     (set! (mut ~(sym o)) ~(sym key-v) (+ (get ~(sym o) ~(sym key-v)) ~w))))

;;; `fold acc = init for …: e`: `acc` starts as `init`, and each time round becomes `e`. With
;;; `scan`, the list of what it became each time.
;;; Whether `more` can go into the accumulator `name` as it is made: when nothing in it reads the
;;; accumulator, or when all of it is made before any of it goes in. `extend-code` and
;;; `map-extend-code` add a literal's items, a comprehension's and the two sides of `++` one at a
;;; time, so those must not read it unless one item is all there is; anything they add whole is
;;; made first.
(defn added-whole? [(more g/Node) (name (slice u8))] (-> bool)
  (if (not (mentions-name? more name))
      true
      (match (.kind more)
        (g/KListLit []
                    (or (= (len (list-kids (kid more 0))) 0)
                        (and (= (len (list-kids (kid more 0))) 1)
                             (not (spread-arg? (kid (kid more 0) 0))))))
        (g/KMapLit [] (= (len (list-kids (kid more 0))) 1))
        (g/KIf []
               (or (none? (kid more 2))
                   (= (.kind (kid more 1)) (g/KBlock))
                   (= (.kind (kid more 2)) (g/KBlock))
                   (and (added-whole? (kid more 1) name)
                        (added-whole? (kid more 2) name))))
        (g/KConcat [] false)
        (g/KComp [] false)
        (g/KCompSpread [] false)
        (g/KMapComp [] false)
        (g/KCall [] false)
        (_ true))))

;;; A record accumulator's first value, its own: a list or map field that came from a name is copied,
;;; so changing it in place changes nothing else.
(defn record-start [(k (mut Comp)) (init-node g/Node) (init TE)] (-> Code)
  (let [r (fresh (mut k) "start")
        rec
          (match (find-rec (mod-at (mut k) (type-module (.ty init)))
                           (type-name (.ty init)))
            (Some [x] x)
            (None [] (die (mut k) init-node "no such record")))
        (mut copies) (primitive/code-list-new)]
    (for f (.fields rec)
      (when (and (or (list? (.ty f)) (map? (.ty f)))
                 (record-field-shared? init-node (.name f)))
        (let [field `(~(primitive/code-symbol "." (.name f)) ~(sym r))]
          (push! (mut copies)
                 `(set! ~field ~(list-copy (mut k) (te field (.ty f))))))))
    `(let [(mut ~(sym r)) ~(.code init)] ~@copies ~(sym r))))

;;; Whether a constructor's field may share its list or map with something else: anything but a
;;; constructor whose argument for the field makes a new one.
(defn record-field-shared? [(init g/Node) (field (slice u8))] (-> bool)
  (if (not (= (.kind init) (g/KCtor)))
      true
      (let [(mut shared) true]
        (for a (list-kids (kid init 1))
          (when (and (= (.kind a) (g/KNamed)) (= (.text (kid a 0)) field))
            (set! shared
                  (match (.kind (kid a 1))
                    (g/KName [] true)
                    (g/KFieldE [] true)
                    (g/KIndex [] true)
                    (_ false)))))
        shared)))

;;; One step of a record fold: every new value worked out from the accumulator as it stands, then
;;; each field changed. `acc.f ++ more` adds to the field in place: `more` worked out first when it is
;;; one entry or item, or in place when it does not read the accumulator; any other value replaces.
(defn record-step [(k (mut Comp))
                   (step g/Node)
                   (acc Code)
                   (acc-name (slice u8))
                   (ty (slice u8))] (-> Code)
  (let [(mut lets) (primitive/code-list-new)
        (mut applies) (primitive/code-list-new)]
    (for fi (list-kids (kid step 1))
      (let [field (.text (kid fi 0))
            v (kid fi 1)
            fty (field-type (mut k) fi ty field)
            target `(~(primitive/code-symbol "." field) ~acc)
            extends
              (and (or (list? fty) (map? fty))
                   (= (.kind v) (g/KConcat))
                   (= (.kind (kid v 0)) (g/KFieldE))
                   (= (.kind (kid (kid v 0) 0)) (g/KName))
                   (= (.text (kid (kid v 0) 0)) acc-name)
                   (= (.text (kid (kid v 0) 1)) field))
            more (if extends (kid v 1) v)
            reads (mentions-name? more acc-name)]
        (cond (and extends
                   (map? fty)
                   (= (.kind more) (g/KMapLit))
                   (= (len (list-kids (kid more 0))) 1))
                (let [entry (get (list-kids (kid more 0)) 0)
                      key
                        (expect (mut k)
                                (kid entry 0)
                                (expr (mut k) (kid entry 0) (map-key fty))
                                (map-key fty))
                      val
                        (expect (mut k)
                                (kid entry 1)
                                (expr (mut k) (kid entry 1) (map-val fty))
                                (map-val fty))
                      tk (fresh (mut k) "key")
                      tv (fresh (mut k) "val")]
                  (push! (mut lets) (sym tk))
                  (push! (mut lets) (.code key))
                  (push! (mut lets) (sym tv))
                  (push! (mut lets) (.code val))
                  (push! (mut applies)
                         `(set! (mut ~target) ~(sym tk) ~(sym tv))))
              (and extends
                   (list? fty)
                   (= (.kind more) (g/KListLit))
                   (= (len (list-kids (kid more 0))) 1)
                   (not (spread-arg? (get (list-kids (kid more 0)) 0))))
                (let [item (get (list-kids (kid more 0)) 0)
                      x
                        (expect (mut k)
                                item
                                (expr (mut k) item (elem-of fty))
                                (elem-of fty))
                      tx (fresh (mut k) "item")]
                  (push! (mut lets) (sym tx))
                  (push! (mut lets) (.code x))
                  (push! (mut applies) `(push! (mut ~target) ~(sym tx))))
              (and extends (not reads))
                (push! (mut applies)
                       (if (map? fty)
                           (map-extend-code (mut k) more target fty)
                           (extend-code (mut k) more target fty)))
              :else
                (let [x (expect (mut k) v (expr (mut k) v fty) fty)
                      t (fresh (mut k) "new")]
                  (push! (mut lets) (sym t))
                  (push! (mut lets) (.code x))
                  (push! (mut applies) `(set! ~target ~(sym t)))))))
    `(let [~@lets] ~@applies 0)))

(defn mentions-name? [(n g/Node) (name (slice u8))] (-> bool)
  (if (and (= (.kind n) (g/KName)) (= (.text n) name))
      true
      (let [(mut found) false]
        (for c (.kids n)
          (when (and (not found) (mentions-name? c name)) (set! found true)))
        found)))

(defn fold-expr [(k (mut Comp)) (n g/Node) (want (slice u8)) (scan bool)]
  (-> TE)
  (let [mark (locals-mark (mut k))
        init
          (expr (mut k)
                (kid n 1)
                (if scan (if (list? want) (elem-of want) "") want))
        ty (.ty init)
        acc (bind-local! (mut k) (.text (kid n 0)) ty false)
        o (fresh (mut k) "steps")
        step-node (kid n 3)
        ;; `fold xs = … : xs ++ more`: `more` goes into the accumulator, which is its own, as a
        ;; `var`'s is, and the list or map is never copied.
        in-place
          (and (not scan)
               (or (list? ty) (map? ty))
               (= (.kind step-node) (g/KConcat))
               (= (.kind (kid step-node 0)) (g/KName))
               (= (.text (kid step-node 0)) (.text (kid n 0)))
               (added-whole? (kid step-node 1) (.text (kid n 0))))
        ;; `fold r = R(…) …: r with { names: r.names ++ more, count: r.count + 1 }`: a record's
        ;; fields changed where they are, each new value worked out before any changes.
        ;; Also `(r with { … } where x = …)`: the equations are worked out first, from `r` as it stands.
        step-where
          (if (and (= (.kind step-node) (g/KGroup))
                   (= (.kind (kid step-node 0)) (g/KWhereE)))
              (Some (kid step-node 0))
              (None [g/Node]))
        with-node (match step-where (Some [w] (kid w 0)) (None [] step-node))
        in-record
          (and (not scan)
               (not in-place)
               (record-type? (mut k) ty)
               (= (.kind with-node) (g/KWithE))
               (= (.kind (kid with-node 0)) (g/KName))
               (= (.text (kid with-node 0)) (.text (kid n 0))))
        start
          (cond (and in-place
                     (match (.kind (kid n 1))
                       (g/KName [] true)
                       (g/KFieldE [] true)
                       (g/KIndex [] true)
                       (_ false)))
                  (list-copy (mut k) init)
                in-record (record-start (mut k) (kid n 1) init)
                :else (.code init))
        (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (for c (list-kids (kid n 2)) (push! (mut opened) (clause-open! (mut k) c)))
    (let [each
            (cond in-record
                    (match step-where
                      (Some [w]
                            (let [lets (where-open! (mut k) w)]
                              `(let [~@lets]
                                 ~(record-step (mut k)
                                               with-node
                                               (sym acc)
                                               (.text (kid n 0))
                                               ty))))
                      (None []
                            (record-step (mut k)
                                         with-node
                                         (sym acc)
                                         (.text (kid n 0))
                                         ty)))
                  in-place
                    (if (map? ty)
                        (map-extend-code (mut k) (kid step-node 1) (sym acc) ty)
                        (extend-code (mut k) (kid step-node 1) (sym acc) ty))
                  scan
                    (let [step
                            (expect (mut k)
                                    step-node
                                    (expr (mut k) step-node ty)
                                    ty)]
                      `(do
                         (set! ~(sym acc) ~(.code step))
                         (push! (mut ~(sym o)) ~(sym acc))))
                  :else
                    (let [step
                            (expect (mut k)
                                    step-node
                                    (expr (mut k) step-node ty)
                                    ty)]
                      `(set! ~(sym acc) ~(.code step))))
          body (clauses-code (mut k) (list-kids (kid n 2)) opened each)]
      (locals-reset! (mut k) mark)
      (if scan
          (te `(let [(mut ~(sym acc)) ~(.code init)
                     (mut ~(sym o)) ~(new-list (mut k) ty)]
                 ~body
                 ~(sym o))
              (cat3 "[" ty "]"))
          (te `(let [(mut ~(sym acc)) ~start] ~body ~(sym acc)) ty)))))

(defn loop-all [(k (mut Comp)) (n g/Node) (negate-empty bool)] (-> TE)
  (let [mark (locals-mark (mut k))
        opened (quant-open! (mut k) n)
        c (expect (mut k) (kid n 2) (expr (mut k) (kid n 2) "Bool") "Bool")
        label (primitive/code-symbol ":" (fresh (mut k) "q"))
        inner
          (if negate-empty
              `(when ~(.code c) (return-from ~label true))
              `(unless ~(.code c) (return-from ~label false)))
        code (quant-wrap (mut k) n opened inner)]
    (locals-reset! (mut k) mark)
    (te `(block ~label ~code ~(if negate-empty `false `true)) "Bool")))

;;; A quantifier's loop and the clauses after it, `first x in xs if p(x) for y in ys: …`, opened in
;;; order.
(defn quant-open! [(k (mut Comp)) (n g/Node)] (-> (ArrayList HeadInfo))
  (let [(mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
    (push! (mut opened) (head-open! (mut k) (kid n 0)))
    (for c (list-kids (kid n 1)) (push! (mut opened) (clause-open! (mut k) c)))
    opened))

(defn quant-wrap [(k (mut Comp))
                  (n g/Node)
                  (opened (ArrayList HeadInfo))
                  (inner Code)] (-> Code)
  (if (= (len opened) 1)
      (head-wrap (mut k) (get opened 0) inner)
      (let [(mut cs) (ArrayList::new [g/Node] (malloc-allocator))]
        (push! (mut cs) (kid n 0))
        (for c (list-kids (kid n 1)) (push! (mut cs) c))
        (clauses-code (mut k) cs opened inner))))

(defn expr [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (match (.kind n)
    (g/KInt [] (te `~(rt/parse-int (.text n)) "Int"))
    (g/KStr [] (te `~(str-literal n) "Text"))
    (g/KChar [] (te `~(char-value n) "Int"))
    (g/KTrue [] (te `true "Bool"))
    (g/KFalse [] (te `false "Bool"))
    (g/KNoneE []
              (unless (opt? want)
                (die (mut k) n "this `none` needs a known type"))
              (te `(None [~(coil-type (mut k) (opt-of want))]) want))
    (g/KSomeE []
              (let [inner
                      (expr (mut k) (kid n 0) (if (opt? want) (opt-of want) ""))]
                (te `(Some ~(.code inner)) (opt-type (.ty inner)))))
    (g/KGroup [] (expr (mut k) (kid n 0) want))
    (g/KName []
             (match (find-local (mut k) (.text n))
               (Some [l] (te (sym (.sym l)) (.ty l)))
               (None []
                     (let [m (self-mod (mut k))]
                       (match (find-global m (.text n))
                         (Some [x] (te (global-read (mut k) x) (.ty x)))
                         (None []
                               (match (find-func m (.text n))
                                 (Some [f]
                                       (te (fn-value (mut k) `(fnptr-of ~(sym (.coil f))) f)
                                           (func-type f)))
                                 (None []
                                       (die (mut k)
                                            n
                                            (cat "nothing named " (.text n)))))))))))
    (g/KQvar [] (die (mut k) n "a `?name` only binds in a loop's query"))
    (g/KUpper [] (enum-value (mut k) n (.text n) want))
    (g/KMember []
               (let [base (kid n 0)
                     name (.text (kid n 1))]
                 (match (module-prefix (mut k) base)
                   (None [] (die (mut k) n "expected module.Name"))
                   (Some [module]
                         (match (find-enum-of (mod-at (mut k) module) name)
                           (None []
                                 (die (mut k)
                                      n
                                      (cat4 module
                                            " has no value named "
                                            name
                                            "")))
                           (Some [e]
                                 (te `(~(sym (qualified (mut k) module name)))
                                     (cat3 module "." (.name e)))))))))
    (g/KFieldE []
               (let [base (kid n 0)
                     field (.text (kid n 1))]
                 (match (module-prefix (mut k) base)
                   (Some [module]
                         (let [mo (mod-at (mut k) module)]
                           (match (find-global mo field)
                             (Some [x]
                                   (if (= (.attr x) 5)
                                       (te (input-read (mut k)
                                                       module
                                                       x
                                                       (storage-of (mut k)
                                                                   module
                                                                   x))
                                           (.ty x))
                                       (place (mut k) n)))
                             (None []
                                   (match (find-func mo field)
                                     (Some [f]
                                           (te (fn-value (mut k)
                                                         `(fnptr-of ~(sym (qualified (mut k)
                                                                                     module
                                                                                     (.coil f))))
                                                         f)
                                               (func-type f)))
                                     (None []
                                           (die (mut k)
                                                n
                                                (cat4 module
                                                      " has nothing named "
                                                      field
                                                      ""))))))))
                   (None []
                         (let [b (expr (mut k) base "")]
                           (if (and (= field "out") (out-bound? (mut k) base))
                               (te (out-of (mut k) n base) (.ty b))
                               (if (named-child? (mut k) (.ty b) field)
                                   (te (child-code (mut k)
                                                   (.ty b)
                                                   field
                                                   (.code b))
                                       (.ty b))
                                   (te `(~(primitive/code-symbol "." field) ~(.code b))
                                       (field-type (mut k) n (.ty b) field)))))))))
    (g/KCall [] (call-expr (mut k) n want))
    (g/KCtor [] (ctor (mut k) n (.text (kid n 0)) (list-kids (kid n 1))))
    (g/KIndex []
              (let [b (expr (mut k) (kid n 0) "")
                    t (.ty b)]
                (cond (list? t)
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) "Int")
                                        "Int")]
                          (te `(get ~(.code b) ~(.code i)) (elem-of t)))
                      (map? t)
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) (map-key t))
                                        (map-key t))]
                          (te `(get ~(.code b) ~(.code i))
                              (opt-type (map-val t))))
                      (= t "Text")
                        (let [i
                                (expect (mut k)
                                        (kid n 1)
                                        (expr (mut k) (kid n 1) "Int")
                                        "Int")]
                          (te `(cast i64 (get ~(.code b) ~(.code i))) "Int"))
                      :else (die (mut k) n (cat "cannot index " t)))))
    (g/KSlice []
              (let [b (expr (mut k) (kid n 0) "")
                    lo
                      (expect (mut k)
                              (kid n 1)
                              (expr (mut k) (kid n 1) "Int")
                              "Int")
                    hi
                      (expect (mut k)
                              (kid n 2)
                              (expr (mut k) (kid n 2) "Int")
                              "Int")]
                (cond (= (.ty b) "Text")
                        (te `(subslice ~(.code b) ~(.code lo) ~(.code hi))
                            "Text")
                      (list? (.ty b))
                        (let [o (fresh (mut k) "out")
                              s (fresh (mut k) "src")
                              i (fresh (mut k) "i")]
                          (te `(let [~(sym s) ~(.code b)
                                     (mut ~(sym o))
                                       ~(new-list (mut k) (elem-of (.ty b)))]
                                 (for ~(sym i) (range ~(.code lo) ~(.code hi))
                                   (push! (mut ~(sym o))
                                          (get ~(sym s) ~(sym i))))
                                 ~(sym o))
                              (.ty b)))
                      :else (die (mut k) n (cat "cannot slice " (.ty b))))))
    (g/KListLit []
                (let [args (list-kids (kid n 0))
                      elem
                        (cond (list? want) (elem-of want)
                              (> (len args) 0)
                                (.ty (first-elem-type (mut k) (get args 0)))
                              :else
                                (die (mut k) n "this `[]` needs a known type"))
                      o (fresh (mut k) "out")
                      (mut pushes) (primitive/code-list-new)]
                  (for a args
                    (if (spread-arg? a)
                        (let [xs (spread-list (mut k) a (cat3 "[" elem "]"))
                              each (fresh (mut k) "each")]
                          (push! (mut pushes)
                                 `(for (ref ~(sym each)) ~xs
                                    (push! (mut ~(sym o)) ~(sym each)))))
                        (let [x (expect (mut k) a (expr (mut k) a elem) elem)]
                          (push! (mut pushes)
                                 `(push! (mut ~(sym o)) ~(.code x))))))
                  (te `(let [(mut ~(sym o)) ~(new-list (mut k) elem)]
                         ~@pushes
                         ~(sym o))
                      (cat3 "[" elem "]"))))
    (g/KComp [] (comprehension (mut k) n want false))
    (g/KCompSpread [] (comprehension (mut k) n want true))
    (g/KMapComp [] (map-comprehension (mut k) n want))
    (g/KMapLit [] (map-literal (mut k) n want))
    (g/KFold [] (fold-expr (mut k) n want false))
    (g/KScan [] (fold-expr (mut k) n want true))
    (g/KSum []
            (let [_ (bounded! (mut k) (kid n 0))
                  mark (locals-mark (mut k))
                  opened (quant-open! (mut k) n)
                  c
                    (expect (mut k)
                            (kid n 2)
                            (expr (mut k) (kid n 2) "Int")
                            "Int")
                  total (fresh (mut k) "n")
                  code
                    (quant-wrap (mut k)
                                n
                                opened
                                `(set! ~(sym total) (+ ~(sym total) ~(.code c))))]
              (locals-reset! (mut k) mark)
              (te `(let [(mut ~(sym total)) 0] ~code ~(sym total)) "Int")))
    (g/KAll [] (loop-all (mut k) n false))
    (g/KAny [] (loop-all (mut k) n true))
    (g/KCount []
              (let [_ (bounded! (mut k) (kid n 0))
                    mark (locals-mark (mut k))
                    opened (quant-open! (mut k) n)
                    c
                      (expect (mut k)
                              (kid n 2)
                              (expr (mut k) (kid n 2) "Bool")
                              "Bool")
                    total (fresh (mut k) "n")
                    code
                      (quant-wrap (mut k)
                                  n
                                  opened
                                  `(when ~(.code c)
                                     (set! ~(sym total) (+ ~(sym total) 1))))]
                (locals-reset! (mut k) mark)
                (te `(let [(mut ~(sym total)) 0] ~code ~(sym total)) "Int")))
    ;; The first some(…), or with a value that is no option, the first value the clauses let by.
    ;; Over `n..`, which has no end, it finds an answer or runs forever: it is the answer itself.
    (g/KFirst []
              (let [endless (= (.kind (kid n 0)) (g/KFromHead))
                    mark (locals-mark (mut k))
                    opened (quant-open! (mut k) n)
                    v
                      (expr (mut k)
                            (kid n 2)
                            (if (and endless (> (len want) 0) (not (opt? want)))
                                (opt-type want)
                                want))
                    label (primitive/code-symbol ":" (fresh (mut k) "q"))
                    x (fresh (mut k) "x")
                    optional (opt? (.ty v))
                    inner
                      (cond (not optional)
                              `(return-from ~label
                                            ~(if endless
                                                 (.code v)
                                                 `(Some ~(.code v))))
                            :else
                              `(match ~(.code v)
                                 (Some [~(sym x)]
                                       (return-from ~label
                                                    ~(if endless
                                                         (sym x)
                                                         `(Some ~(sym x)))))
                                 (None [] 0)))
                    found (if optional (opt-of (.ty v)) (.ty v))]
                (let [code (quant-wrap (mut k) n opened inner)]
                  (locals-reset! (mut k) mark)
                  (if endless
                      (te `(block
                             ~label
                             ~code
                             (panic "a range with no end came to an end"))
                          found)
                      (te `(block
                             ~label
                             ~code
                             (None [~(coil-type (mut k) found)]))
                          (opt-type found))))))
    ;; The last some(…), or value, every item looked at.
    (g/KLast []
             (let [_ (bounded! (mut k) (kid n 0))
                   mark (locals-mark (mut k))
                   opened (quant-open! (mut k) n)
                   v (expr (mut k) (kid n 2) want)
                   o (fresh (mut k) "found")
                   x (fresh (mut k) "x")
                   optional (opt? (.ty v))
                   found (if optional (opt-of (.ty v)) (.ty v))]
               (let [code
                       (quant-wrap (mut k)
                                   n
                                   opened
                                   (if optional
                                       `(match ~(.code v)
                                          (Some [~(sym x)]
                                                (do
                                                  (set! ~(sym o)
                                                        (Some ~(sym x)))
                                                  0))
                                          (None [] 0))
                                       `(set! ~(sym o) (Some ~(.code v)))))]
                 (locals-reset! (mut k) mark)
                 (te `(let [(mut ~(sym o)) (None [~(coil-type (mut k) found)])]
                        ~code
                        ~(sym o))
                     (opt-type found)))))
    (g/KSort []
             (let [mark (locals-mark (mut k))
                   items (expr (mut k) (kid n 1) "")
                   _
                     (unless (list? (.ty items))
                       (die (mut k) n "sort needs a list"))
                   v
                     (bind-local! (mut k)
                                  (.text (kid n 0))
                                  (elem-of (.ty items))
                                  false)
                   key (expr (mut k) (kid n 2) "")
                   all (fresh (mut k) "items")
                   keys (fresh (mut k) "keys")
                   o (fresh (mut k) "out")
                   i (fresh (mut k) "i")
                   desc (if (none? (kid n 3)) `false `true)
                   order
                     (if (= (.ty key) "Text")
                         `(rt/sort-order-text ~(sym keys) ~desc)
                         `(rt/sort-order-int ~(sym keys) ~desc))]
               (unless (or (= (.ty key) "Int") (= (.ty key) "Text"))
                 (die (mut k)
                      n
                      (cat "sort keys are Int or Text, not " (.ty key))))
               (locals-reset! (mut k) mark)
               (te `(let [~(sym all) ~(.code items)
                          (mut ~(sym keys)) ~(new-list (mut k) (.ty key))
                          (mut ~(sym o))
                            ~(new-list (mut k) (elem-of (.ty items)))]
                      (for (ref ~(sym v)) ~(sym all)
                        (push! (mut ~(sym keys)) ~(.code key)))
                      (for ~(sym i) ~order
                        (push! (mut ~(sym o)) (get ~(sym all) ~(sym i))))
                      ~(sym o))
                   (.ty items))))
    (g/KIf [] (if-code (mut k) n want))
    (g/KIfLet [] (if-let-code (mut k) n want))
    (g/KMatch [] (match-code (mut k) n (kid n 0) (list-kids (kid n 1)) want))
    (g/KMatchN [] (match-n-code (mut k) n want))
    (g/KWhereE [] (where-code (mut k) n want))
    (g/KWithCtx [] (stmt (mut k) n want))
    (g/KBlock []
              (let [stmts (list-kids (kid n 0))]
                (if (and (= (len stmts) 0) (map? want))
                    (te (new-map (mut k) want) want)
                    (let [mark (locals-mark (mut k))
                          r (block-from (mut k) stmts 0 want)]
                      (locals-reset! (mut k) mark)
                      r))))
    (g/KTmpl [] (template (mut k) n))
    (g/KNot []
            (let [x
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Bool")
                            "Bool")]
              (te `(not ~(.code x)) "Bool")))
    (g/KNeg []
            (let [x
                    (expect (mut k)
                            (kid n 0)
                            (expr (mut k) (kid n 0) "Int")
                            "Int")]
              (te `(- 0 ~(.code x)) "Int")))
    (g/KOr []
           (let [a
                   (expect (mut k)
                           (kid n 0)
                           (expr (mut k) (kid n 0) "Bool")
                           "Bool")
                 b
                   (expect (mut k)
                           (kid n 1)
                           (expr (mut k) (kid n 1) "Bool")
                           "Bool")]
             (te `(or ~(.code a) ~(.code b)) "Bool")))
    (g/KAnd [] (and-code (mut k) n))
    (g/KEq [] (equality (mut k) n false))
    (g/KNe [] (equality (mut k) n true))
    (g/KLt [] (compare (mut k) n `<))
    (g/KLe [] (compare (mut k) n `<=))
    (g/KGt [] (compare (mut k) n `>))
    (g/KGe [] (compare (mut k) n `>=))
    (g/KIn [] (in-test (mut k) n))
    (g/KAdd [] (binary-int (mut k) n `+))
    (g/KSub [] (binary-int (mut k) n `-))
    (g/KMul [] (binary-int (mut k) n `*))
    (g/KDiv [] (binary-int (mut k) n `/))
    (g/KMod [] (binary-int (mut k) n `%))
    (g/KConcat []
               (let [first-ty (.ty (expr (mut k) (kid n 0) want))]
                 (if (map? first-ty)
                     (let [o (fresh (mut k) "out")]
                       (te `(let [(mut ~(sym o)) ~(new-map (mut k) first-ty)]
                              ~(map-extend-code (mut k) n (sym o) first-ty)
                              ~(sym o))
                           first-ty))
                     (if (and (list? first-ty) (one-buffer? n))
                         ;; Several lists, or one being made: each goes straight into one list, with no list
                         ;; for a part, nor for the parts so far, copied into the next.
                         (let [o (fresh (mut k) "out")]
                           (te `(let [(mut ~(sym o))
                                        ~(new-list (mut k) (elem-of first-ty))]
                                  ~(extend-code (mut k) n (sym o) first-ty)
                                  ~(sym o))
                               first-ty))
                         (if (list? first-ty)
                             (let [a (expr (mut k) (kid n 0) want)
                                   b
                                     (expect (mut k)
                                             (kid n 1)
                                             (expr (mut k) (kid n 1) first-ty)
                                             first-ty)
                                   o (fresh (mut k) "out")
                                   e (fresh (mut k) "e")
                                   x (fresh (mut k) "left")
                                   y (fresh (mut k) "right")]
                               (te `(let [~(sym x) ~(.code a)
                                          ~(sym y) ~(.code b)
                                          (mut ~(sym o))
                                            ~(new-list (mut k)
                                                       (elem-of first-ty))]
                                      (reserve! (mut ~(sym o))
                                                (+ (len ~(sym x))
                                                   (len ~(sym y))))
                                      (for (ref ~(sym e)) ~(sym x)
                                        (push! (mut ~(sym o)) ~(sym e)))
                                      (for (ref ~(sym e)) ~(sym y)
                                        (push! (mut ~(sym o)) ~(sym e)))
                                      ~(sym o))
                                   first-ty))
                             ;; The operands, in order, then one buffer of their whole length: no growing.
                             (let [(mut parts)
                                     (ArrayList::new [g/Node]
                                                     (malloc-allocator))
                                   b (fresh (mut k) "b")
                                   (mut binds) (primitive/code-list-new)
                                   (mut lens) (primitive/code-list-new)
                                   (mut pushes) (primitive/code-list-new)]
                               (concat-operands! n (mut parts))
                               (for p parts
                                 (let [x
                                         (expect (mut k)
                                                 p
                                                 (expr (mut k) p "Text")
                                                 "Text")
                                       v (fresh (mut k) "part")]
                                   (push! (mut binds) (sym v))
                                   (push! (mut binds) (.code x))
                                   (push! (mut lens) `(len ~(sym v)))
                                   (push! (mut pushes)
                                          `(push-str! (mut ~(sym b)) ~(sym v)))))
                               (te `(let [~@binds (mut ~(sym b))
                                          (str/StrBuf::new (malloc-allocator))]
                                      (reserve! (mut (.bytes ~(sym b)))
                                                (+ ~@lens 0))
                                      ~@pushes
                                      (finish! (mut ~(sym b))))
                                   "Text")))))))
    (g/KDefault []
                (let [a
                        (expr (mut k)
                              (kid n 0)
                              (if (> (len want) 0)
                                  (if (opt? want) want (opt-type want))
                                  ""))]
                  (unless (opt? (.ty a))
                    (die (mut k)
                         n
                         (cat "`??` needs an option on its left, but this is "
                              (.ty a))))
                  (let [x (fresh (mut k) "x")
                        b
                          (expr (mut k)
                                (kid n 1)
                                (if (> (len want) 0) want (opt-of (.ty a))))]
                    (cond (= (.ty b) (.ty a))
                            (te `(match ~(.code a)
                                   (Some [~(sym x)] (Some ~(sym x)))
                                   (None [] ~(.code b)))
                                (.ty a))
                          (or (= (.ty b) (opt-of (.ty a))) (= (.ty b) "Never"))
                            (te `(match ~(.code a)
                                   (Some [~(sym x)] ~(sym x))
                                   (None [] ~(.code b)))
                                (opt-of (.ty a)))
                          :else
                            (die (mut k)
                                 n
                                 (cat4 "`??` has " (.ty a) " and " (.ty b)))))))
    (g/KIsE []
            (let [s (expr (mut k) (kid n 0) "")
                  t (fresh (mut k) "m")]
              (te `(let [~(sym t) ~(.code s)]
                     ~(pat-test (mut k) (kid n 1) (sym t) (.ty s)))
                  "Bool")))
    (g/KWithE []
              (match (kids-mapped (mut k) n)
                (Some [shared] shared)
                (None [] (with-fields (mut k) n want))))
    (g/KPanic []
              (let [(mut args) (primitive/code-list-new)]
                (for a (list-kids (kid n 1))
                  (push! (mut args) (.code (expr (mut k) a ""))))
                (te `(panic ~(str-literal (kid n 0)) ~@args) "Never")))
    (g/KReturn []
               (when (> (.in-with k) 0)
                 (die (mut k)
                      n
                      "cannot return from inside `with`: its context would not be restored"))
               (set! (.returned k) true)
               (if (none? (kid n 0))
                   (te `(return-from :fn 0) "Never")
                   (let [v
                           (expect (mut k)
                                   (kid n 0)
                                   (expr (mut k) (kid n 0) (.ret k))
                                   (.ret k))]
                     (te `(return-from :fn ~(.code v)) "Never"))))
    (_ (die (mut k)
            n
            (cat "this is not an expression: " (g/kind-name (.kind n)))))))

;;; `n with { … }`: a copy of `n` with the given fields.
(defn with-fields [(k (mut Comp)) (n g/Node) (want (slice u8))] (-> TE)
  (let [base (expr (mut k) (kid n 0) want)
        t (fresh (mut k) "w")
        (mut sets) (primitive/code-list-new)]
    (for f (list-kids (kid n 1))
      (let [name (.text (kid f 0))
            ft (field-type (mut k) f (.ty base) name)
            v (expect (mut k) (kid f 1) (expr (mut k) (kid f 1) ft) ft)]
        (if (named-child? (mut k) (.ty base) name)
            (let [gr (mod-at (mut k) (type-module (.ty base)))]
              (push! (mut sets)
                     `(set! (.kids ~(sym t))
                            (~(primitive/code-symbol (alias-of (.name gr))
                                                     "/kids-with") (.kids ~(sym t))
                               ~(child-index-code (mut k) gr name (sym t))
                               ~(.code v)))))
            (push! (mut sets)
                   `(set! (~(primitive/code-symbol "." name) ~(sym t))
                          ~(.code v))))))
    (te `(let [(mut ~(sym t)) ~(.code base)] ~@sets ~(sym t)) (.ty base))))

;;; Whether `e` is `name.field`.
(defn field-of? [(e g/Node) (name (slice u8)) (field (slice u8))] (-> bool)
  (and (= (.kind e) (g/KFieldE))
       (= (.kind (kid e 0)) (g/KName))
       (= (.text (kid e 0)) name)
       (= (.text (kid e 1)) field)))

;;; `n with { kids: [f(c) for c in n.kids if p(c)] }` on a node. Nodes are values that never change,
;;; so when every child is kept and each `f(c)` is `c`, the result is `n` itself: an unchanged tree is
;;; shared, not copied. A new list starts at the first child that changes or is left out.
(defn kids-mapped [(k (mut Comp)) (n g/Node)] (-> (Option TE))
  (let [base-n (kid n 0)
        fields (list-kids (kid n 1))]
    (if (not (and (= (.kind base-n) (g/KName))
                  (= (len fields) 1)
                  (= (.text (kid (get fields 0) 0)) "kids")
                  (= (.kind (kid (get fields 0) 1)) (g/KComp))))
        (None [TE])
        (let [comp (kid (get fields 0) 1)
              heads (list-kids (kid comp 1))]
          (if (not (and (or (= (len heads) 1)
                            (and (= (len heads) 2)
                                 (= (.kind (get heads 1)) (g/KIfClause))))
                        (= (.kind (get heads 0)) (g/KInHead))
                        (field-of? (kid (get heads 0) 1) (.text base-n) "kids")))
              (None [TE])
              (match (find-local (mut k) (.text base-n))
                (None [] (None [TE]))
                (Some [l]
                      (let [ty (.ty l)]
                        (if (not (and (not (builtin-type? ty))
                                      (> (last-dot ty) 0)
                                      (= (type-name ty) "Node")))
                            (None [TE])
                            (Some (shared-kids-code (mut k)
                                                    comp
                                                    (get heads 0)
                                                    (sym (.sym l))
                                                    ty)))))))))))

(defn shared-kids-code [(k (mut Comp))
                        (comp g/Node)
                        (head g/Node)
                        (base Code)
                        (ty (slice u8))] (-> TE)
  (let [gr (grammar-of-type (mut k) comp ty)
        same (primitive/code-symbol (alias-of (.name gr)) "/same-node?")
        mark (locals-mark (mut k))
        v (bind-local! (mut k) (.text (kid head 0)) ty false)
        value (expect (mut k) (kid comp 0) (expr (mut k) (kid comp 0) ty) ty)
        clauses (list-kids (kid comp 1))
        keep
          (if (= (len clauses) 1)
              `true
              (let [filter (kid (get clauses 1) 0)]
                (.code (expect (mut k)
                               filter
                               (expr (mut k) filter "Bool")
                               "Bool"))))
        w (fresh (mut k) "w")
        src (fresh (mut k) "src")
        o (fresh (mut k) "out")
        changed (fresh (mut k) "changed")
        i (fresh (mut k) "i")
        j (fresh (mut k) "j")
        r (fresh (mut k) "r")
        start
          `(do
             (set! ~(sym changed) true)
             (set! ~(sym o) ~(new-list (mut k) ty))
             (reserve! (mut ~(sym o)) (len ~(sym src)))
             (for ~(sym j) (range 0 ~(sym i))
               (push! (mut ~(sym o)) (get ~(sym src) ~(sym j)))))]
    (locals-reset! (mut k) mark)
    ;; `out` starts as the old list only to have a value: nothing is pushed before a change
    ;; replaces it with a new one.
    (te `(let [~(sym w) ~base
               ~(sym src) (.kids ~(sym w))
               (mut ~(sym o)) ~(sym src)
               (mut ~(sym changed)) false]
           (for ~(sym i) (range 0 (len ~(sym src)))
             (let [~(sym v) (get ~(sym src) ~(sym i))]
               (if ~keep
                   (let [~(sym r) ~(.code value)]
                     (when (and (not ~(sym changed))
                                (not (~same ~(sym r) ~(sym v))))
                       ~start)
                     (when ~(sym changed) (push! (mut ~(sym o)) ~(sym r))))
                   (unless ~(sym changed) ~start))))
           (if ~(sym changed)
               (let [(mut ~(sym w)) ~(sym w)]
                 (set! (.kids ~(sym w)) ~(sym o))
                 ~(sym w))
               ~(sym w)))
        ty)))

(defn first-elem-type [(k (mut Comp)) (a g/Node)] (-> TE)
  (expr (mut k) a ""))

(defn func-type [(f Func)] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))
        (mut first) true]
    (push-str! (mut b) "Fn(")
    (for p (.params f)
      (unless first (push-str! (mut b) ","))
      (set! first false)
      (push-str! (mut b) (.ty p)))
    (push-str! (mut b) ")->")
    (push-str! (mut b) (.ret f))
    (finish! (mut b))))

;;; A bare capitalised name: a value of the enum that's wanted, or of this module's.
(defn enum-value [(k (mut Comp)) (n g/Node) (name (slice u8)) (want (slice u8))]
  (-> TE)
  (let [from-want
          (if (and (> (len want) 0)
                   (not (builtin-type? want))
                   (> (last-dot want) 0)
                   (not (list? want))
                   (not (map? want))
                   (not (opt? want))
                   (not (fn? want)))
              (match (find-enum-named (mod-at (mut k) (type-module want))
                                      (type-name want))
                (Some [e]
                      (let [(mut hit) false]
                        (for v (.variants e) (when (= v name) (set! hit true)))
                        hit))
                (None [] false))
              false)]
    (if from-want
        (te `(~(sym (qualified (mut k) (type-module want) name))) want)
        (match (find-enum-of (self-mod (mut k)) name)
          (Some [e] (te `(~(sym name)) (cat3 (.self k) "." (.name e))))
          (None [] (die (mut k) n (cat "nothing named " name)))))))

;; ---------------------------------------------------------------- statements

;;; A list or a map of its own, for a `var` or an accumulator that will change in place.
(defn list-copy [(k (mut Comp)) (e TE)] (-> Code)
  (if (map? (.ty e))
      (let [o (fresh (mut k) "out")]
        `(let [(mut ~(sym o)) ~(new-map (mut k) (.ty e))]
           ~(map-copy-into (mut k) (.code e) (sym o))
           ~(sym o)))
      (if (list? (.ty e))
          (let [o (fresh (mut k) "out")
                x (fresh (mut k) "x")]
            `(let [(mut ~(sym o)) ~(new-list (mut k) (elem-of (.ty e)))]
               (for (ref ~(sym x)) ~(.code e) (push! (mut ~(sym o)) ~(sym x)))
               ~(sym o)))
          (.code e))))

(defn stmt [(k (mut Comp)) (s g/Node) (want (slice u8))] (-> TE)
  (match (.kind s)
    (g/KFor []
            (let [_ (bounded! (mut k) (kid s 0))
                  mark (locals-mark (mut k))
                  h (head-open! (mut k) (kid s 0))
                  body (expr (mut k) (kid s 1) "Void")
                  code (head-wrap (mut k) h (.code body))]
              (locals-reset! (mut k) mark)
              (te code "Void")))
    (g/KWhile []
              (let [c
                      (expect (mut k)
                              (kid s 0)
                              (expr (mut k) (kid s 0) "Bool")
                              "Bool")
                    body (expr (mut k) (kid s 1) "Void")]
                (te `(while ~(.code c) ~(.code body)) "Void")))
    (g/KAssert []
               (let [call-node (kid s 0)]
                 (unless (and (= (.kind call-node) (g/KCall))
                              (= (.kind (kid call-node 0)) (g/KFieldE)))
                   (die (mut k) s "assert takes db.relation(columns)"))
                 (let [db (place (mut k) (kid (kid call-node 0) 0))
                       rel (.text (kid (kid call-node 0) 1))
                       args (list-kids (kid call-node 1))
                       (mut cs) (primitive/code-list-new)]
                   (rel-check (mut k) s (.ty db) rel (len args))
                   (for a args
                     (push! (mut cs)
                            (.code (expect (mut k)
                                           a
                                           (expr (mut k) a "Int")
                                           "Int"))))
                   (te `(~(sym (qualified (mut k)
                                          (type-module (.ty db))
                                          (cat3 "add-" rel "!"))) (mut ~(.code db))
                           ~@cs)
                       "Void"))))
    (g/KWithCtx []
                (let [inits (list-kids (kid s 0))
                      (mut saves) (primitive/code-list-new)
                      (mut sets) (primitive/code-list-new)
                      (mut restores) (primitive/code-list-new)
                      m (self-mod (mut k))]
                  (for init inits
                    (let [qname (.text (kid init 0))
                          dot (last-dot qname)
                          module
                            (if (> dot 0)
                                (match (alias-target m (subslice qname 0 dot))
                                  (Some [mo] mo)
                                  (None []
                                        (die (mut k)
                                             init
                                             (cat "no module named "
                                                  (subslice qname 0 dot)))))
                                (.self k))
                          name
                            (if (> dot 0)
                                (subslice qname (+ dot 1) (len qname))
                                qname)
                          owner (mod-at (mut k) module)]
                      (match (find-global owner name)
                        (None []
                              (die (mut k)
                                   init
                                   (cat "no context or input named " qname)))
                        (Some [x]
                              (unless (or (= (.attr x) 5)
                                          (and (<= dot 0)
                                               (.task x)
                                               (= (.attr x) 0)))
                                (die (mut k)
                                     init
                                     (cat3 "only a context or a module's input is given by `with`, and "
                                           qname
                                           " is neither")))
                              (let [saved (fresh (mut k) "saved")
                                    storage
                                      (if (> dot 0)
                                          (storage-of (mut k) module x)
                                          (storage-call (mut k) x))
                                    field
                                      `(~(primitive/code-symbol "." name) ~storage)
                                    v
                                      (expect (mut k)
                                              (kid init 1)
                                              (expr (mut k)
                                                    (kid init 1)
                                                    (.ty x))
                                              (.ty x))
                                    ;; Memo answers made from the value it had are dead, now and after:
                                    ;; while dependencies are tracked, exactly those; otherwise every
                                    ;; answer of the module's.
                                    changed `(rt/dep-changed! ~(cat4 "s:" module "." name))
                                    forget
                                      (match (find-func owner "forget-memos!")
                                        (Some [_]
                                              `(if (rt/dep-tracking?)
                                                   ~changed
                                                   ~(if (> dot 0)
                                                        `(~(sym (qualified (mut k)
                                                                           module
                                                                           "forget-memos!")))
                                                        `(forget-memos!))))
                                        (None [] changed))]
                                (push! (mut saves) (sym saved))
                                (push! (mut saves) field)
                                (if (= (.attr x) 5)
                                    (let [bound
                                            `(~(primitive/code-symbol "."
                                                                      (bound-field name)) ~storage)]
                                      (push! (mut sets)
                                             `(set! ~field ~(.code v)))
                                      (push! (mut sets)
                                             `(set! ~bound (+ ~bound 1)))
                                      (push! (mut sets) forget)
                                      (push! (mut restores)
                                             `(set! ~field ~(sym saved)))
                                      (push! (mut restores)
                                             `(set! ~bound (- ~bound 1)))
                                      (push! (mut restores) forget))
                                    (do
                                      (push! (mut sets)
                                             `(set! ~field ~(.code v)))
                                      (push! (mut restores)
                                             `(set! ~field ~(sym saved))))))))))
                  (set! (.in-with k) (+ (.in-with k) 1))
                  ;; Its value is its block's, taken before the context is put back.
                  (let [body
                          (expr (mut k)
                                (kid s 1)
                                (if (= (len want) 0) "Void" want))
                        r (fresh (mut k) "r")]
                    (set! (.in-with k) (- (.in-with k) 1))
                    (if (or (= (.ty body) "Void") (= (.ty body) "Never"))
                        (te `(let [~@saves] ~@sets ~(.code body) ~@restores 0)
                            "Void")
                        (te `(let [~@saves]
                               ~@sets
                               (let [~(sym r) ~(.code body)]
                                 ~@restores
                                 ~(sym r)))
                            (.ty body))))))
    (g/KPrint []
              (let [(mut args) (primitive/code-list-new)]
                (for a (list-kids (kid s 1))
                  (push! (mut args) (.code (expr (mut k) a ""))))
                (te `(println ~(str-literal (kid s 0)) ~@args) "Void")))
    (g/KAssign []
               (match (attr-assign (mut k) s)
                 (Some [done] done)
                 (None [] (plain-assign (mut k) s))))
    (g/KAppend []
               (match (first-collect (mut k) s)
                 (Some [done] done)
                 (None [] (plain-append (mut k) s))))
    (g/KExtend []
               (let [p (place (mut k) (kid s 0))
                     t (.ty p)]
                 (check-assignable! (mut k) (kid s 0))
                 (unless (list? t)
                   (die (mut k) s (cat "++= extends a list, not " t)))
                 (te (extend-code (mut k) (kid s 1) (.code p) t) "Void")))
    (_ (expr (mut k) s want))))

;;; `xs ++= e`: a list literal's items, or a comprehension's, go straight into `xs`, with no list
;;; made for them on the way.
(defn extend-code [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (let [elem (elem-of t)]
    (match (.kind e)
      (g/KListLit []
                  (let [(mut pushes) (primitive/code-list-new)]
                    (for a (list-kids (kid e 0))
                      (if (spread-arg? a)
                          (push! (mut pushes)
                                 (if (= (.kind a) (g/KSpread))
                                     (spread-into (mut k) (kid a 0) target t)
                                     (let [each (fresh (mut k) "each")]
                                       `(for (ref ~(sym each)) ~(spread-list (mut k)
                                                                             a
                                                                             t)
                                          (push! (mut ~target) ~(sym each))))))
                          (let [x (expect (mut k) a (expr (mut k) a elem) elem)]
                            (push! (mut pushes)
                                   `(push! (mut ~target) ~(.code x))))))
                    `(do ~@pushes 0)))
      ;; `a ++ b` of lists: each in turn.
      (g/KConcat []
                 `(do
                    ~(extend-code (mut k) (kid e 0) target t)
                    ~(extend-code (mut k) (kid e 1) target t)
                    0))
      (g/KCompSpread []
                     (let [mark (locals-mark (mut k))
                           (mut opened)
                             (ArrayList::new [HeadInfo] (malloc-allocator))]
                       (for c (list-kids (kid e 1))
                         (push! (mut opened) (clause-open! (mut k) c)))
                       (let [body
                               (clauses-code (mut k)
                                             (list-kids (kid e 1))
                                             opened
                                             (spread-into (mut k)
                                                          (kid e 0)
                                                          target
                                                          t))]
                         (locals-reset! (mut k) mark)
                         `(do ~body 0))))
      ;; `if c then a else b`: whichever it is goes in.
      (g/KIf []
             (if (or (none? (kid e 2))
                     (= (.kind (kid e 1)) (g/KBlock))
                     (= (.kind (kid e 2)) (g/KBlock)))
                 (extend-whole (mut k) e target t)
                 (let [c
                         (expect (mut k)
                                 (kid e 0)
                                 (expr (mut k) (kid e 0) "Bool")
                                 "Bool")]
                   `(if ~(.code c)
                        (do ~(extend-code (mut k) (kid e 1) target t) 0)
                        (do ~(extend-code (mut k) (kid e 2) target t) 0)))))
      (g/KComp []
               (let [mark (locals-mark (mut k))
                     (mut opened) (ArrayList::new [HeadInfo] (malloc-allocator))]
                 (for c (list-kids (kid e 1))
                   (push! (mut opened) (clause-open! (mut k) c)))
                 (let [v
                         (expect (mut k)
                                 (kid e 0)
                                 (expr (mut k) (kid e 0) elem)
                                 elem)
                       body
                         (clauses-code (mut k)
                                       (list-kids (kid e 1))
                                       opened
                                       `(push! (mut ~target) ~(.code v)))]
                   (locals-reset! (mut k) mark)
                   `(do ~body 0))))
      (g/KCall [] (spread-into (mut k) e target t))
      ;; `e where x = …`: the equations, then `e` goes in.
      (g/KWhereE []
                 (let [mark (locals-mark (mut k))
                       lets (where-open! (mut k) e)
                       inner (extend-code (mut k) (kid e 0) target t)]
                   (locals-reset! (mut k) mark)
                   `(let [~@lets] ~inner 0)))
      (g/KGroup [] (extend-code (mut k) (kid e 0) target t))
      (_ (extend-whole (mut k) e target t)))))

(defn extend-whole [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (let [v (expect (mut k) e (expr (mut k) e t) t)
        x (fresh (mut k) "e")]
    `(for (ref ~(sym x)) ~(.code v) (push! (mut ~target) ~(sym x)))))

;;; The function `g` of a call `g(…)`, when it has a twin `g-into!` that adds its answer to a list it
;;; is handed: a list-giving `everywhere fn`, or a function that gives a list partly made of its own.
(defn into-twin [(k (mut Comp)) (call g/Node)] (-> (Option Func))
  (if (and (= (.kind call) (g/KCall))
           (= (.kind (kid call 0)) (g/KName))
           (match (find-local (mut k) (.text (kid call 0)))
             (Some [_] false)
             (None [] true)))
      (match (find-func (self-mod (mut k)) (cat (.text (kid call 0)) "-into!"))
        (Some [f]
              (let [n (len (list-kids (kid call 1)))]
                (if (and (= (len (.params f)) (+ n 1))
                         (.by-ref (get (.params f) n))
                         (all-plain-args? (list-kids (kid call 1))))
                    (Some f)
                    (None [Func]))))
        (None [] (None [Func])))
      (None [Func])))

(defn all-plain-args? [(args (ArrayList g/Node))] (-> bool)
  (let [(mut ok) true]
    (for a args
      (when (or (spread-arg? a) (= (.kind a) (g/KNamed))) (set! ok false)))
    ok))

;;; A list's items into `target`: by the twin of a call that has one, else one at a time.
(defn spread-into [(k (mut Comp)) (e g/Node) (target Code) (t (slice u8))]
  (-> Code)
  (match (into-twin (mut k) e)
    (Some [f]
          (let [args (list-kids (kid e 1))
                (mut codes) (primitive/code-list-new)]
            (unless (= (.ty (get (.params f) (len args))) t)
              (die (mut k)
                   e
                   (cat4 "this adds to a "
                         t
                         ", but its function makes a "
                         (.ty (get (.params f) (len args))))))
            (for i (range 0 (len args))
              (let [p (get (.params f) i)
                    a (get args i)]
                (when (.by-ref p)
                  (die (mut k) a "a twin's arguments are values"))
                (push! (mut codes)
                       (.code (expect (mut k)
                                      a
                                      (expr (mut k) a (.ty p))
                                      (.ty p))))))
            `(~(sym (qualified (mut k) (.self k) (.coil f))) ~@codes
                (mut ~target))))
    (None []
          (let [v (expect (mut k) e (expr (mut k) e t) t)
                x (fresh (mut k) "each")]
            `(for (ref ~(sym x)) ~(.code v) (push! (mut ~target) ~(sym x)))))))

;;; In an `on` block, `child.attr = value` for an inherited attribute, and `c = value` for a
;;; collected one. Anywhere else a collected attribute is only added to.
(defn attr-assign [(k (mut Comp)) (s g/Node)] (-> (Option TE))
  (let [target (kid s 0)]
    (cond (and (.in-on k) (child-equation? (mut k) s))
            (let [who (.text (kid target 0))
                  attr (.text (kid target 1))
                  (mut out) (None [TE])]
              (for e (.eq-slots k)
                (when (and (= (.target e) who) (= (.attr e) attr))
                  (let [v
                          (expect (mut k)
                                  (kid s 1)
                                  (expr (mut k) (kid s 1) (.ty e))
                                  (.ty e))]
                    (set! out
                          (Some (te `(set! ~(sym (.sym e)) ~(.code v)) "Void"))))))
              (match out
                (Some [_] out)
                (None []
                      (die (mut k)
                           s
                           "this equation is not one this block gives its children"))))
          (= (.kind target) (g/KName))
            (match (attr-global (mut k) (.text target) 3)
              (None [] (None [TE]))
              (Some [x]
                    (unless (.in-on k)
                      (die (mut k)
                           s
                           (cat3 "a collected attribute is added to with +=; only an `on` block gives "
                                 (.name x)
                                 " a node's whole value")))
                    (let [v
                            (expect (mut k)
                                    (kid s 1)
                                    (expr (mut k) (kid s 1) (.ty x))
                                    (.ty x))
                          (mut out) (None [TE])]
                      (for o (.ovr-slots k)
                        (when (= (.attr o) (.name x))
                          (set! out
                                (Some (te `(set! ~(sym (.sym o))
                                                 (Some ~(.code v)))
                                          "Void")))))
                      (match out
                        (Some [_] out)
                        (None []
                              (die (mut k)
                                   s
                                   "this collected attribute was not found among the whole values"))))))
          :else (None [TE]))))

;;; `c += x` on a collected option keeps the first some.
(defn first-collect [(k (mut Comp)) (s g/Node)] (-> (Option TE))
  (let [target (kid s 0)]
    (if (not (= (.kind target) (g/KName)))
        (None [TE])
        (match (attr-global (mut k) (.text target) 3)
          (None [] (None [TE]))
          (Some [x]
                (if (not (opt? (.ty x)))
                    (None [TE])
                    ;; `problem += p` keeps the first; with `p` an option, the first some.
                    (let [p (place (mut k) target)
                          v0 (expr (mut k) (kid s 1) (.ty x))
                          y (fresh (mut k) "y")]
                      (if (= (.ty v0) (.ty x))
                          (Some (te `(match ~(.code v0)
                                       (Some [~(sym y)]
                                             (match ~(.code p)
                                               (None []
                                                     (set! ~(.code p)
                                                           (Some ~(sym y))))
                                               (_ 0)))
                                       (None [] 0))
                                    "Void"))
                          (let [v (expect (mut k) (kid s 1) v0 (opt-of (.ty x)))]
                            (Some (te `(match ~(.code p)
                                         (None []
                                               (set! ~(.code p)
                                                     (Some ~(.code v))))
                                         (_ 0))
                                      "Void")))))))))))

(defn plain-assign [(k (mut Comp)) (s g/Node)] (-> TE)
  (let [target (kid s 0)]
    (if (and (= (.kind target) (g/KIndex))
             (let [b (place (mut k) (kid target 0))]
               (or (list? (.ty b)) (map? (.ty b)))))
        (let [b (place (mut k) (kid target 0))]
          (if (map? (.ty b))
              (let [i
                      (expect (mut k)
                              (kid target 1)
                              (expr (mut k) (kid target 1) (map-key (.ty b)))
                              (map-key (.ty b)))
                    v
                      (expect (mut k)
                              (kid s 1)
                              (expr (mut k) (kid s 1) (map-val (.ty b)))
                              (map-val (.ty b)))]
                (te `(set! (mut ~(.code b)) ~(.code i) ~(.code v)) "Void"))
              (let [i
                      (expect (mut k)
                              (kid target 1)
                              (expr (mut k) (kid target 1) "Int")
                              "Int")
                    v
                      (expect (mut k)
                              (kid s 1)
                              (expr (mut k) (kid s 1) (elem-of (.ty b)))
                              (elem-of (.ty b)))]
                (te `(set! (mut ~(.code b)) ~(.code i) ~(.code v)) "Void"))))
        (let [p (place (mut k) target)
              v
                (expect (mut k)
                        (kid s 1)
                        (expr (mut k) (kid s 1) (.ty p))
                        (.ty p))]
          (check-assignable! (mut k) target)
          (te `(set! ~(.code p) ~(.code v)) "Void")))))

(defn plain-append [(k (mut Comp)) (s g/Node)] (-> TE)
  (let [p (place (mut k) (kid s 0))
        t (.ty p)]
    (check-assignable! (mut k) (kid s 0))
    (cond (list? t)
            (let [v
                    (expect (mut k)
                            (kid s 1)
                            (expr (mut k) (kid s 1) (elem-of t))
                            (elem-of t))]
              (te `(push! (mut ~(.code p)) ~(.code v)) "Void"))
          (= t "Int")
            (let [v
                    (expect (mut k)
                            (kid s 1)
                            (expr (mut k) (kid s 1) "Int")
                            "Int")]
              (te `(set! ~(.code p) (+ ~(.code p) ~(.code v))) "Void"))
          :else (die (mut k) s (cat "cannot add to " t)))))

;;; A plain local is assignable only when declared with `var`.
(defn check-assignable! [(k (mut Comp)) (target g/Node)] (-> void)
  (match (.kind target)
    (g/KName []
             (match (find-local (mut k) (.text target))
               (Some [l]
                     (unless (.mutable l)
                       (die (mut k)
                            target
                            (cat3 "cannot change "
                                  (.text target)
                                  ": declare it with `var`"))))
               (None [] 0)))
    (g/KFieldE [] (check-assignable! (mut k) (kid target 0)))
    (g/KIndex [] (check-assignable! (mut k) (kid target 0)))
    (_ 0)))

(defn let-like? [(s g/Node)] (-> bool)
  (or (= (.kind s) (g/KLet)) (= (.kind s) (g/KVar))))

;;; A block, kept as flat as it can be: Coil's expander pays for depth, so a run of `let`s
;;; shares one binding vector rather than each nesting the rest of the block.
(defn block-from [(k (mut Comp))
                  (stmts (ArrayList g/Node))
                  (i i64)
                  (want (slice u8))] (-> TE)
  (let [(mut forms) (primitive/code-list-new)
        (mut ty) "Void"
        (mut j) i
        n (len stmts)
        (mut go) (< j n)]
    (while go
      (let [s (get stmts j)
            at-end (= j (- n 1))]
        (if (let-like? s)
            (let [(mut binds) (primitive/code-list-new)]
              (while (and (< j n) (let-like? (get stmts j)))
                (let [b (get stmts j)
                      is-var (= (.kind b) (g/KVar))
                      declared
                        (if (none? (kid b 1))
                            ""
                            (resolve-type (mut k) (.self k) (kid b 1)))
                      v
                        (expect (mut k)
                                (kid b 2)
                                (expr (mut k) (kid b 2) declared)
                                declared)
                      fresh-value
                        (match (.kind (kid b 2))
                          (g/KName [] false)
                          (g/KFieldE [] false)
                          (g/KIndex [] false)
                          (_ true))
                      init
                        (if (or (not is-var) fresh-value)
                            (.code v)
                            (list-copy (mut k) v))
                      local
                        (bind-local! (mut k) (.text (kid b 0)) (.ty v) is-var)]
                  (if is-var
                      (push! (mut binds) `(mut ~(sym local)))
                      (push! (mut binds) (sym local)))
                  (push! (mut binds) init))
                (set! j (+ j 1)))
              (let [rest (block-from (mut k) stmts j want)]
                (push! (mut forms) `(let [~@binds] ~(.code rest)))
                (set! ty (.ty rest))
                (set! go false)))
            (let [e (stmt (mut k) s (if at-end want "Void"))]
              (push! (mut forms) (.code e))
              (when at-end (set! ty (.ty e)))
              (set! j (+ j 1))
              (when (>= j n) (set! go false))))))
    (when (>= i n) (push! (mut forms) `0))
    (te `(do ~@forms) ty)))

;; ---------------------------------------------------------------- declarations

(defn reserved-name? [(s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for w ["field"
            "len"
            "get"
            "set"
            "elem"
            "for"
            "let"
            "if"
            "do"
            "block"
            "match"
            "when"
            "unless"
            "while"
            "not"
            "and"
            "or"
            "range"
            "cond"
            "push!"
            "pop!"
            "clear!"
            "reserve!"
            "set!"
            "cast"
            "load"
            "store!"
            "slice"
            "panic"
            "print"
            "println"
            "join"
            "call"
            "rules-state"
            "rules-state-first"
            "rules-init!"
            "main"
            "rules-worker"
            "mut"
            "ref"
            "fn"
            "defn"
            "const"
            "def"
            "import"
            "module"
            "export"
            "impl"
            "defstruct"
            "defsum"]
      (when (= w s) (set! hit true)))
    hit))

(defn compile-fn [(k (mut Comp)) (d g/Node)] (-> Code)
  (compile-fn-as (mut k) d (.text (kid d 0))))

(defn compile-fn-as [(k (mut Comp)) (d g/Node) (coil-name (slice u8))] (-> Code)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))
        (mut params) (primitive/code-list-new)
        body-node (kid d 3)]
    (when (reserved-name? name)
      (die (mut k) (kid d 0) (cat3 "the name " name " is reserved")))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) (.ret f))
    (for p (.params f)
      (let [local (bind-local! (mut k) (.name p) (.ty p) (.by-ref p))]
        (push! (mut params)
               (if (.by-ref p)
                   `(~(sym local) (mut ~(coil-type (mut k) (.ty p))))
                   `(~(sym local) ~(coil-type (mut k) (.ty p)))))))
    (set! (.in-fn k) true)
    (set! (.task-used k) false)
    (let [body
            (expect (mut k)
                    body-node
                    (expr (mut k) body-node (.ret f))
                    (.ret f))
          inner (if (.returned k) `(block :fn ~(.code body)) (.code body))
          code
            (if (.task-used k)
                `(let [rules-task-here (rules-task)] ~inner)
                inner)]
      (set! (.in-fn k) false)
      (when (and (!= (.ret f) "Void") (= (.ty body) "Void"))
        (die (mut k) body-node (cat "this function must answer " (.ret f))))
      `(defn ~(sym coil-name) [~@params] (-> ~(coil-type (mut k) (.ret f)))
         ~code))))

;; ---------------------------------------------------------------- attribute grammars

;;; `.attrs`: an attribute grammar over a grammar's trees. No walk is written: attributes are
;;; declared, `on` blocks give equations for the nodes their patterns match, and the compiler
;;; makes one traversal that computes them all.
;;;
;;;   attrs bundle.calls over bundle.js
;;;   inh in-loop: Bool = false       # inherited: a child has its parent's, unless an equation
;;;                                   #   of the parent's says otherwise
;;;   given role: Role = Plain        # inherited, not copied: a child has this, unless an
;;;                                   #   equation of its parent's says otherwise
;;;   input bindings: {Int:Int}       # given to `run`, the same everywhere
;;;   collect requires: [Text]        # synthesized: what the nodes add, in tree order; an
;;;                                   #   option keeps the first some
;;;   on For(init, test, update, body) { body.in-loop = true }
;;;   on CallExpr(Ident("require"), Args(List(Str(raw)))) { requires += unquote(raw) }
;;;   on FuncDecl(...) { declares = [] }   # a node's whole value: its subtree adds nothing
;;;
;;; `run(tree, inputs...)` answers a record `Attrs` with each collected attribute at the root.
;;; A node's own additions come before its children's. Only one block may give a node's
;;; children attributes: the first, in the file, whose pattern matches it.

(defn attrs-only! [(k (mut Comp)) (tree g/Node) (d g/Node)] (-> void)
  (unless (= (.kind tree) (g/KAttrsFile))
    (die (mut k) d "attributes and `on` blocks belong in an `attrs` file")))

;;; The record of results, and `run`, as other modules see them.
(defn attrs-signature! [(k (mut Comp))
                        (ix2 i64)
                        (name (slice u8))
                        (over (slice u8))
                        (decls (ArrayList g/Node))] (-> void)
  (let [(mut fields) (ArrayList::new [FieldDef] (malloc-allocator))
        (mut f) (func-of "run" (cat name ".Attrs"))]
    (param (mut f) "tree" (cat over ".Node") false)
    (for d decls
      (when (= (.kind d) (g/KCollect))
        (let [ty (resolve-type (mut k) name (kid d 1))]
          (unless (or (list? ty) (opt? ty))
            (die (mut k)
                 d
                 (cat "a collected attribute is a list or an option, not " ty)))
          (push! (mut fields) (FieldDef :name (.text (kid d 0)) :ty ty))))
      (when (= (.kind d) (g/KInput))
        (param (mut f)
               (.text (kid d 0))
               (resolve-type (mut k) name (kid d 1))
               false))
      (when (and (= (.kind d) (g/KFn)) (= (.text (kid d 0)) "run"))
        (die (mut k) d "an attribute grammar's `run` is its own")))
    (when (rewrites? decls)
      (for f2 fields
        (when (= (.name f2) "tree")
          (die (mut k)
               (g/none-node)
               "`tree` is the rewritten tree; a collection cannot be named so")))
      (push! (mut fields) (FieldDef :name "tree" :ty (cat over ".Node"))))
    ;; An included grammar's equations run in this one's traversal, and what it collects is
    ;; this one's answer too.
    (for d decls
      (when (= (.kind d) (g/KInclude))
        (let [m (mod-at (mut k) (.text (kid d 0)))]
          (unless (= (.over m) over)
            (die (mut k)
                 d
                 (cat "an included attribute grammar is over the same grammar; this one is over "
                      (.over m))))
          (for x (.globals m)
            (when (= (.attr x) 2)
              (die (mut k)
                   d
                   (cat3 "an included attribute grammar takes no inputs, not yet: "
                         (.name x)
                         " is one")))
            (when (= (.attr x) 3)
              (for f2 fields
                (when (= (.name f2) (.name x))
                  (die (mut k)
                       d
                       (cat3 "two collected attributes are named " (.name x) ""))))
              (push! (mut fields) (FieldDef :name (.name x) :ty (.ty x))))))))
    (for i (range 0 (len (.recs (get (.mods k) ix2))))
      (when (= (.name (get (.recs (get (.mods k) ix2)) i)) "Attrs")
        (set! (.fields (elem (mut (.recs (elem (mut (.mods k)) ix2))) i))
              fields)))
    (push! (mut (.funcs (elem (mut (.mods k)) ix2))) f)))

;;; Whether a grammar rewrites trees as well as computing attributes.
;;; Whether a grammar takes inputs: they hold only while `run` runs, which `attrs-depth` counts.
(defn inputs? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KInput)) (set! hit true)))
    hit))

(defn rewrites? [(decls (ArrayList g/Node))] (-> bool)
  (let [(mut hit) false]
    (for d decls (when (= (.kind d) (g/KRewrite)) (set! hit true)))
    hit))

;;; The attribute grammar whose attributes a block's names mean: this module's, or while an
;;; included one's blocks are read, that one's.
(defn attrs-mod [(k (mut Comp))] (-> Mod)
  (if (= (len (.attrs-from k)) 0)
      (self-mod (mut k))
      (mod-at (mut k) (.attrs-from k))))

(defn attr-global [(k (mut Comp)) (name (slice u8)) (attr i64)]
  (-> (Option Global))
  (match (find-global (attrs-mod (mut k)) name)
    (Some [x] (if (= (.attr x) attr) (Some x) (None [Global])))
    (None [] (None [Global]))))

;;; The empty value of a type, for an input before `run` and a collection at its start.
(defn default-of [(k (mut Comp)) (at g/Node) (ty (slice u8))] (-> Code)
  (cond (list? ty) (new-list (mut k) (elem-of ty))
        (opt? ty) `(None [~(coil-type (mut k) (opt-of ty))])
        (map? ty) (new-map (mut k) ty)
        (= ty "Int") `0
        (= ty "Bool") `false
        (= ty "Text") `""
        ;; A record's is its fields' empty values, and an enum's its first value.
        (> (last-dot ty) 0)
          (let [m (mod-at (mut k) (type-module ty))]
            (match (find-rec m (type-name ty))
              (Some [r]
                    (let [(mut inits) (primitive/code-list-new)]
                      (for f (.fields r)
                        (push! (mut inits)
                               (primitive/code-symbol ":" (.name f)))
                        (push! (mut inits) (default-of (mut k) at (.ty f))))
                      `(~(sym (qualified (mut k) (type-module ty) (.name r))) ~@inits)))
              (None []
                    (match (find-enum-named m (type-name ty))
                      (Some [e]
                            `(~(sym (qualified (mut k)
                                               (type-module ty)
                                               (get (.variants e) 0)))))
                      (None [] (die (mut k) at (cat "no empty value of " ty)))))))
        :else (die (mut k) at (cat "no empty value of " ty))))

;;; A global's first value: its own expression, or the empty one for an input or a collection. A
;;; setting is never read before a `with` gives it one, so a type with no empty value of its own,
;;; such as a foreign one, is held as zeroes until then.
(defn global-init [(k (mut Comp)) (d g/Node) (x Global)] (-> Code)
  (cond (and (= (.kind d) (g/KSetting)) (not (has-default? (mut k) (.ty x))))
          `(primitive/zeroed ~(coil-type (mut k) (.ty x)))
        (or (= (.kind d) (g/KInput))
            (= (.kind d) (g/KCollect))
            (= (.kind d) (g/KSetting)))
          (default-of (mut k) d (.ty x))
        :else
          (.code (expect (mut k)
                         (kid d 2)
                         (expr (mut k) (kid d 2) (.ty x))
                         (.ty x)))))

;;; Whether `default-of` has an empty value for the type.
(defn has-default? [(k (mut Comp)) (ty (slice u8))] (-> bool)
  (cond (or (list? ty)
            (opt? ty)
            (map? ty)
            (= ty "Int")
            (= ty "Bool")
            (= ty "Text"))
          true
        (fn? ty) false
        (> (last-dot ty) 0)
          (let [m (mod-at (mut k) (type-module ty))]
            (match (find-rec m (type-name ty))
              (Some [r]
                    (let [(mut ok) true]
                      (for f (.fields r)
                        (unless (has-default? (mut k) (.ty f)) (set! ok false)))
                      ok))
              (None []
                    (match (find-enum-named m (type-name ty))
                      (Some [_] true)
                      (None [] false)))))
        :else false))

(defn task-field [(name (slice u8)) (task Code)] (-> Code)
  `(~(primitive/code-symbol "." name) ~task))

;;; One alternative of an `on` block: or-patterns at the top become several. `block` is which
;;; block, in the file's order.
(defstruct OnAlt
  [(pat g/Node)
   (as-name g/Node)
   (guard g/Node)
   (body g/Node)
   (owner bool)
   (block i64)])

;;; An `on` block's body, with its `where` equations first, each after those it uses.
(defn on-body-with-where [(d g/Node)] (-> g/Node)
  (let [body (kid d 2)
        w (kid d 3)]
    (if (none? w)
        body
        (let [inits (list-kids (kid w 0))
              (mut stmts) (g/new-kids)]
          (for j (where-order inits)
            (let [i (get inits j)]
              (push! (mut stmts)
                     (g/mk (g/KLet)
                           (three (kid i 0) (g/none-node) (kid i 1))
                           (.lo i)
                           (.hi i)))))
          (for s (list-kids (kid body 0)) (push! (mut stmts) s))
          (g/mk (g/KBlock)
                (one (list-node stmts (kid body 0)))
                (.lo body)
                (.hi body))))))

(defn on-alts [(k (mut Comp)) (decls (ArrayList g/Node))] (-> (ArrayList OnAlt))
  (let [(mut out) (ArrayList::new [OnAlt] (malloc-allocator))
        (mut b) 0]
    (for d decls
      (when (= (.kind d) (g/KOn))
        (let [p0 (kid d 0)
              has-as (= (.kind p0) (g/KPAs))
              as-name (if has-as (kid p0 1) (g/none-node))
              p (if has-as (kid p0 0) p0)
              body (on-body-with-where d)
              owner (gives-children? (mut k) body)
              guard (kid d 1)]
          (if (= (.kind p) (g/KPOr))
              (do
                (push! (mut out)
                       (OnAlt
                         :pat (kid p 0)
                         :as-name as-name
                         :guard guard
                         :body body
                         :owner owner
                         :block b))
                (for q (list-kids (kid p 1))
                  (push! (mut out)
                         (OnAlt
                           :pat q
                           :as-name as-name
                           :guard guard
                           :body body
                           :owner owner
                           :block b))))
              (push! (mut out)
                     (OnAlt
                       :pat p
                       :as-name as-name
                       :guard guard
                       :body body
                       :owner owner
                       :block b)))
          (set! b (+ b 1)))))
    out))

;;; A block's body, compiled once as a function of the node, the names its pattern binds and, for
;;; the children its equations give attributes, where they are; each alternative of its pattern
;;; only tests and calls. A block that gives a collected attribute a node's whole value stays
;;; inline, since what it gives waits in the traversal's frame.
(defstruct OnVar [(name (slice u8)) (ty (slice u8))])

;;; `task` is the task state its attributes live in: this module's, or an included one's.
(defstruct OnBlock
  [(body g/Node)
   (owner bool)
   (inline bool)
   (vars (ArrayList OnVar))
   (targets (ArrayList (slice u8)))
   (fname (slice u8))
   (task Code)])

(defn on-head [(a OnAlt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

;;; Is `s` an equation for a child, `x.attr = value` with `attr` inherited?
(defn child-equation? [(k (mut Comp)) (s g/Node)] (-> bool)
  (and (= (.kind s) (g/KAssign))
       (= (.kind (kid s 0)) (g/KFieldE))
       (= (.kind (kid (kid s 0) 0)) (g/KName))
       (inherited? (mut k) (.text (kid (kid s 0) 1)))))

(defn inherited? [(k (mut Comp)) (name (slice u8))] (-> bool)
  (match (find-global (attrs-mod (mut k)) name)
    (Some [x] (or (= (.attr x) 1) (= (.attr x) 4)))
    (None [] false)))

(defn gives-children? [(k (mut Comp)) (n g/Node)] (-> bool)
  (let [(mut hit) (child-equation? (mut k) n)]
    (for c (.kids n) (when (gives-children? (mut k) c) (set! hit true)))
    hit))

(defn find-eqs! [(k (mut Comp)) (n g/Node) (out (mut (ArrayList EqSlot)))]
  (-> void)
  (when (child-equation? (mut k) n)
    (let [target (.text (kid (kid n 0) 0))
          attr (.text (kid (kid n 0) 1))
          (mut seen) false]
      (for e out
        (when (and (= (.target e) target) (= (.attr e) attr)) (set! seen true)))
      (unless seen
        (match (find-global (attrs-mod (mut k)) attr)
          (Some [x]
                (push! (mut out)
                       (EqSlot
                         :target target
                         :attr attr
                         :sym (fresh (mut k) "eq")
                         :ty (.ty x))))
          (None [] 0)))))
  (for c (.kids n) (find-eqs! (mut k) c (mut out))))

;;; Collected attributes some block gives a whole value, `c = value`.
(defn find-ovrs! [(k (mut Comp)) (n g/Node) (out (mut (ArrayList OvrSlot)))]
  (-> void)
  (when (and (= (.kind n) (g/KAssign)) (= (.kind (kid n 0)) (g/KName)))
    (match (attr-global (mut k) (.text (kid n 0)) 3)
      (Some [x]
            (let [(mut seen) false]
              (for e out (when (= (.attr e) (.name x)) (set! seen true)))
              (unless seen
                (push! (mut out)
                       (OvrSlot
                         :attr (.name x)
                         :sym (fresh (mut k) "whole")
                         :ty (.ty x)
                         :mark (fresh (mut k) "mark"))))))
      (None [] 0)))
  (for c (.kids n) (find-ovrs! (mut k) c (mut out))))

;;; Which child the pattern's top-level name `name` is: an index, or one counted from the end
;;; past a rest.
(defn child-index [(p g/Node) (name (slice u8)) (subject Code)]
  (-> (Option Code))
  (let [args
          (match (.kind p)
            (g/KPNode [] (Some (list-kids (kid p 1))))
            (g/KPNodeQ [] (Some (list-kids (kid p 2))))
            (_ (None [(ArrayList g/Node)])))]
    (match args
      (None [] (None [Code]))
      (Some [xs]
            (let [n (len xs)
                  (mut rest-at) -1
                  (mut out) (None [Code])]
              (for i (range 0 n)
                (let [a (get xs i)]
                  (when (or (= (.kind a) (g/KPAny)) (= (.kind a) (g/KRest)))
                    (set! rest-at i))))
              (for i (range 0 n)
                (let [a (get xs i)
                      bound
                        (cond (= (.kind a) (g/KName)) (.text a)
                              (= (.kind a) (g/KPAs)) (.text (kid a 1))
                              :else "")]
                  (when (= bound name)
                    (set! out
                          (Some (if (or (< rest-at 0) (< i rest-at))
                                    `~i
                                    `(- (len (.kids ~subject)) ~(- n i))))))))
              out)))))

;;; Visit `call`'s child with these inherited attributes, and the `given` ones no equation gives
;;; at their defaults, then put back the parent's.
(defn with-attrs-code [(k (mut Comp))
                       (slots (ArrayList EqSlot))
                       (task Code)
                       (call Code)] (-> Code)
  (let [(mut saves) (primitive/code-list-new)
        (mut sets) (primitive/code-list-new)
        (mut restores) (primitive/code-list-new)
        (mut count) 0]
    (for s slots
      (let [saved (fresh (mut k) "saved")
            field (task-field (.attr s) task)]
        (set! count (+ count 1))
        (push! (mut saves) (sym saved))
        (push! (mut saves) field)
        (push! (mut sets) `(set! ~field ~(sym (.sym s))))
        (push! (mut restores) `(set! ~field ~(sym saved)))))
    (for gv (.givens k)
      (let [(mut covered) false]
        (for s slots (when (= (.attr s) (.attr gv)) (set! covered true)))
        (unless covered
          (let [saved (fresh (mut k) "saved")
                field (task-field (.attr gv) task)]
            (set! count (+ count 1))
            (push! (mut saves) (sym saved))
            (push! (mut saves) field)
            (push! (mut sets) `(set! ~field ~(.default gv)))
            (push! (mut restores) `(set! ~field ~(sym saved)))))))
    (if (= count 0)
        call
        `(let [~@saves] ~@sets ~call ~@restores 0))))

(defn default-traverse [(k (mut Comp)) (subject Code) (task Code) (visit Code)]
  (-> Code)
  (let [c (sym (fresh (mut k) "c"))]
    `(for (ref ~c) (.kids ~subject)
       ~(with-attrs-code (mut k)
                         (ArrayList::new [EqSlot] (malloc-allocator))
                         task
                         `(~visit ~c ~task)))))

;;; The children of a node an owner block matched, each with what the equations give it.
;;; `indices` says where each of `targets` is among them.
(defn owner-traverse [(k (mut Comp))
                      (at g/Node)
                      (slots (ArrayList EqSlot))
                      (targets (ArrayList (slice u8)))
                      (indices (ArrayList Code))
                      (subject Code)
                      (task Code)
                      (visit Code)] (-> Code)
  (let [ci (sym (fresh (mut k) "ci"))
        c (sym (fresh (mut k) "c"))
        call `(~visit ~c ~task)
        (mut arms) (primitive/code-list-new)
        (mut all-kids) (ArrayList::new [EqSlot] (malloc-allocator))]
    (for s slots (when (= (.target s) "kids") (push! (mut all-kids) s)))
    (for i (range 0 (len targets))
      (let [t (get targets i)
            (mut mine) (ArrayList::new [EqSlot] (malloc-allocator))]
        (for s slots (when (= (.target s) t) (push! (mut mine) s)))
        (for s all-kids
          (let [(mut shadowed) false]
            (for m slots
              (when (and (= (.target m) t) (= (.attr m) (.attr s)))
                (set! shadowed true)))
            (unless shadowed (push! (mut mine) s))))
        (push! (mut arms) `(= ~ci ~(get indices i)))
        (push! (mut arms) (with-attrs-code (mut k) mine task call))))
    (if (= (len targets) 0)
        `(for (ref ~c) (.kids ~subject)
           ~(with-attrs-code (mut k) all-kids task call))
        `(for ~ci (range 0 (len (.kids ~subject)))
           (let [~c (get (.kids ~subject) ~ci)]
             (cond ~@arms :else ~(with-attrs-code (mut k) all-kids task call)))))))

;;; The children a block's equations name, `kids` aside, in the order first named.
(defn eq-targets [(slots (ArrayList EqSlot))] (-> (ArrayList (slice u8)))
  (let [(mut out) (text-list)]
    (for s slots
      (unless (= (.target s) "kids")
        (let [(mut seen) false]
          (for x out (when (= x (.target s)) (set! seen true)))
          (unless seen (push! (mut out) (.target s))))))
    out))

(defn target-indices [(k (mut Comp))
                      (a OnAlt)
                      (targets (ArrayList (slice u8)))
                      (subject Code)] (-> (ArrayList Code))
  (let [(mut out) (ArrayList::new [Code] (malloc-allocator))]
    (for t targets
      (match (child-index (.pat a) t subject)
        (Some [index] (push! (mut out) index))
        (None []
              (die (mut k)
                   (.body a)
                   (cat3 "an equation gives an attribute to a child, and "
                         t
                         " is not one this pattern names at its top")))))
    out))

;;; The block's statements, with the slots its equations fill; then, for an owner, the children.
(defn on-body-code [(k (mut Comp))
                    (body-node g/Node)
                    (owner bool)
                    (slots (ArrayList EqSlot))
                    (targets (ArrayList (slice u8)))
                    (indices (ArrayList Code))
                    (subject Code)
                    (task Code)
                    (visit Code)
                    (label Code)
                    (leave bool)] (-> Code)
  (set! (.eq-slots k) slots)
  (set! (.in-on k) true)
  (let [body (expr (mut k) body-node "Void")]
    (set! (.in-on k) false)
    (set! (.eq-slots k) (ArrayList::new [EqSlot] (malloc-allocator)))
    (when (.returned k) (die (mut k) body-node "an `on` block cannot return"))
    (let [(mut decls) (primitive/code-list-new)]
      (for s slots
        (push! (mut decls) `(mut ~(sym (.sym s))))
        (push! (mut decls) (task-field (.attr s) task)))
      (if owner
          `(let [~@decls]
             ~(.code body)
             ~(owner-traverse (mut k)
                              body-node
                              slots
                              targets
                              indices
                              subject
                              task
                              visit)
             ~(if leave `(return-from ~label 0) `0))
          `(do ~(.code body) 0)))))

;;; The names an alternative's pattern binds, its own included, with their types.
(defn alt-vars [(k (mut Comp)) (a OnAlt) (subject Code) (ty (slice u8))]
  (-> (ArrayList OnVar))
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))
        (mut out) (ArrayList::new [OnVar] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) (on-head a))
    (unless (none? (.as-name a))
      (bind-local! (mut k) (.text (.as-name a)) ty false))
    ;; What the guard's `is` patterns bind, the block sees too.
    (unless (none? (.guard a)) (guard-steps! (mut k) (.guard a) (mut steps)))
    (for i (range mark (len (.locals k)))
      (let [l (get (.locals k) i)]
        (push! (mut out) (OnVar :name (.name l) :ty (.ty l)))))
    (locals-reset! (mut k) mark)
    out))

(defn on-blocks [(k (mut Comp))
                 (alts (ArrayList OnAlt))
                 (count i64)
                 (subject Code)
                 (ty (slice u8))] (-> (ArrayList OnBlock))
  (let [(mut out) (ArrayList::new [OnBlock] (malloc-allocator))]
    (for b (range 0 count)
      (let [(mut first) (None [OnAlt])]
        (for a alts
          (when (and (= (.block a) b)
                     (match first (None [] true) (Some [_] false)))
            (set! first (Some a))))
        (match first
          (None [] (die (mut k) (g/none-node) "an `on` block with no pattern"))
          (Some [a0]
                (let [vars (alt-vars (mut k) a0 subject ty)
                      (mut ovrs) (ArrayList::new [OvrSlot] (malloc-allocator))
                      (mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
                  (for a alts
                    (when (= (.block a) b)
                      (let [mine (alt-vars (mut k) a subject ty)
                            (mut same) (= (len mine) (len vars))]
                        (for v vars
                          (let [(mut hit) false]
                            (for w mine
                              (when (and (= (.name w) (.name v))
                                         (= (.ty w) (.ty v)))
                                (set! hit true)))
                            (unless hit (set! same false))))
                        (unless same
                          (die (mut k)
                               (.pat a)
                               "every alternative of an `on` pattern binds the same names, of the same types")))))
                  (find-ovrs! (mut k) (.body a0) (mut ovrs))
                  (when (.owner a0) (find-eqs! (mut k) (.body a0) (mut slots)))
                  (push! (mut out)
                         (OnBlock
                           :body (.body a0)
                           :owner (.owner a0)
                           :inline (> (len ovrs) 0)
                           :vars vars
                           :targets (eq-targets slots)
                           :fname (cat "attrs-block-" (rt/num-text b))
                           :task `rules-task-here)))))))
    out))

(defn on-block-fn [(k (mut Comp))
                   (b OnBlock)
                   (subject Code)
                   (node-coil Code)
                   (task Code)
                   (visit Code)] (-> Code)
  (clear! (mut (.locals k)))
  (set! (.returned k) false)
  (let [(mut params) (primitive/code-list-new)
        (mut indices) (ArrayList::new [Code] (malloc-allocator))
        (mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
    (for v (.vars b)
      (let [s (bind-local! (mut k) (.name v) (.ty v) false)]
        (push! (mut params) `(~(sym s) ~(coil-type (mut k) (.ty v))))))
    (for t (.targets b)
      (let [s (fresh (mut k) "at")]
        (push! (mut indices) (sym s))
        (push! (mut params) `(~(sym s) i64))))
    (when (.owner b) (find-eqs! (mut k) (.body b) (mut slots)))
    (let [code
            (on-body-code (mut k)
                          (.body b)
                          (.owner b)
                          slots
                          (.targets b)
                          indices
                          subject
                          task
                          visit
                          `0
                          false)]
      (clear! (mut (.locals k)))
      `(defn ~(sym (.fname b)) [(~subject ~node-coil)
                                (~task (ptr RulesTask))
                                ~@params] (-> void)
         ~code
         0))))

;;; One alternative at a node of kind `head` ("" when the dispatch knows none): its pattern's
;;; test, then its block, called or inline. An owner visits the children and leaves `label`.
(defn on-alt-code [(k (mut Comp))
                   (a OnAlt)
                   (b OnBlock)
                   (subject Code)
                   (ty (slice u8))
                   (head (slice u8))
                   (label Code)
                   (task Code)
                   (visit Code)] (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) head)
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))))
    ;; `on Pat if cond { … }`: the block holds only where the condition does.
    (unless (none? (.guard a))
      (guard-steps! (mut k) (.guard a) (mut steps)))
    (let [indices (target-indices (mut k) a (.targets b) subject)
          code
            (if (.inline b)
                (let [(mut slots) (ArrayList::new [EqSlot] (malloc-allocator))]
                  (when (.owner b) (find-eqs! (mut k) (.body b) (mut slots)))
                  (on-body-code (mut k)
                                (.body b)
                                (.owner b)
                                slots
                                (.targets b)
                                indices
                                subject
                                task
                                visit
                                label
                                true))
                (let [(mut args) (primitive/code-list-new)]
                  (for v (.vars b)
                    (match (find-local (mut k) (.name v))
                      (Some [l] (push! (mut args) (sym (.sym l))))
                      (None []
                            (die (mut k)
                                 (.pat a)
                                 (cat "this pattern does not bind " (.name v))))))
                  (for i indices (push! (mut args) i))
                  (let [call `(~(sym (.fname b)) ~subject ~(.task b) ~@args)]
                    (if (.owner b) `(do ~call (return-from ~label 0)) call))))]
      (locals-reset! (mut k) mark)
      (wrap-steps steps 0 code))))

;;; At a node of kind `head`: the blocks that only add, in the file's order, then the first
;;; owner that matches visits the children; with none, they are visited as they are.
(defn on-arm-code [(k (mut Comp))
                   (alts (ArrayList OnAlt))
                   (blocks (ArrayList OnBlock))
                   (head (slice u8))
                   (subject Code)
                   (ty (slice u8))
                   (task Code)
                   (visit Code)] (-> Code)
  (let [(mut adds) (primitive/code-list-new)
        (mut owners) (primitive/code-list-new)
        label (primitive/code-symbol ":" (fresh (mut k) "own"))]
    (for a alts
      (let [h (on-head a)
            b (get blocks (.block a))]
        (when (or (= h head) (= (len h) 0))
          (if (.owner a)
              (push! (mut owners)
                     (on-alt-code (mut k) a b subject ty head label task visit))
              (push! (mut adds)
                     (on-alt-code (mut k) a b subject ty head label task visit))))))
    `(do
       ~@adds
       (block ~label ~@owners ~(default-traverse (mut k) subject task visit) 0)
       0)))

;;; The field of this grammar's task state that holds an included one's.
(defn include-field [(m Mod)] (-> (slice u8))
  (cat "attrs-in-" (alias-of (.name m))))

;;; An included grammar's blocks, added to this traversal's: each alternative calls the block's
;;; function in the included module, with that module's task state. Its blocks only add what
;;; they collect; giving children attributes, or a collection a node's whole value, would need its
;;; equations merged with this grammar's, which is not built yet.
(defn included-blocks! [(k (mut Comp))
                        (d g/Node)
                        (subject Code)
                        (ty (slice u8))
                        (task Code)
                        (alts (mut (ArrayList OnAlt)))
                        (blocks (mut (ArrayList OnBlock)))
                        (heads (mut (ArrayList (slice u8))))
                        (gr Mod)
                        (over (slice u8))] (-> void)
  (let [name (.text (kid d 0))
        m (mod-at (mut k) name)
        path
          (match (file-of (mut k) name)
            (Some [p] p)
            (None [] (die (mut k) d (cat "no file for " name))))
        saved-src (.src k)
        saved-path (.path k)
        src (rt/read-all path)
        mtree (parse-file (mut k) src path)
        mdecls (list-kids (kid mtree 2))
        offset (len blocks)
        its (task-field (include-field m) task)
        (mut count) 0]
    (unless (= (.kind mtree) (g/KAttrsFile))
      (die (mut k) d (cat name " is not an attribute grammar")))
    (for x (.globals m)
      (when (= (.attr x) 4)
        (die (mut k)
             d
             (cat3 "an included attribute grammar gives no attributes, not yet: "
                   (.name x)
                   " is given"))))
    (set! (.src k) src)
    (set! (.path k) path)
    (set! (.attrs-from k) name)
    (for md mdecls (when (= (.kind md) (g/KOn)) (set! count (+ count 1))))
    (let [malts (on-alts (mut k) mdecls)
          mblocks (on-blocks (mut k) malts count subject ty)]
      (for b mblocks
        (when (or (.owner b) (.inline b))
          (die (mut k)
               (.body b)
               "an included attribute grammar's blocks only add what they collect, not yet more"))
        (push! (mut blocks)
               (OnBlock
                 :body (.body b)
                 :owner false
                 :inline false
                 :vars (.vars b)
                 :targets (.targets b)
                 :fname (cat3 (alias-of (.name m)) "/" (.fname b))
                 :task its)))
      (for a malts
        (let [h (on-head a)
              (mut seen) (= (len h) 0)]
          (for x heads (when (= x h) (set! seen true)))
          (unless seen
            (unless (match (find-kind gr h) (Some [_] true) (None [] false))
              (die (mut k)
                   (.pat a)
                   (cat4 "the grammar " over " has no node named " h)))
            (push! (mut heads) h)))
        (push! (mut alts)
               (OnAlt
                 :pat (.pat a)
                 :as-name (.as-name a)
                 :guard (.guard a)
                 :body (.body a)
                 :owner false
                 :block (+ (.block a) offset)))))
    (set! (.attrs-from k) "")
    (set! (.src k) saved-src)
    (set! (.path k) saved-path)
    (clear! (mut (.locals k)))))

;;; `rewrite Pattern if guard => value`: what a node becomes. The pattern and the guard see the node
;;; as it was; `x.out` is what a child the pattern names became, and with the rule's `as` name, the
;;; node rebuilt from its children's. Tried in the file's order; the first that matches gives the
;;; node, or a list of nodes in a list's place, and a node no rule matches is rebuilt.
(defstruct RwAlt [(pat g/Node) (as-name g/Node) (guard g/Node) (body g/Node)])

(defn rewrite-alts [(decls (ArrayList g/Node))] (-> (ArrayList RwAlt))
  (let [(mut out) (ArrayList::new [RwAlt] (malloc-allocator))]
    (for d decls
      (when (= (.kind d) (g/KRewrite))
        (let [p0 (kid d 0)
              has-as (= (.kind p0) (g/KPAs))
              as-name (if has-as (kid p0 1) (g/none-node))
              p (if has-as (kid p0 0) p0)]
          (for q (top-alternatives p)
            (push! (mut out)
                   (RwAlt
                     :pat q
                     :as-name as-name
                     :guard (kid d 1)
                     :body (kid d 2)))))))
    out))

(defn rw-head [(a RwAlt)] (-> (slice u8))
  (match (.kind (.pat a))
    (g/KPNode [] (.text (kid (.pat a) 0)))
    (g/KPNodeQ [] (.text (kid (.pat a) 1)))
    (_ "")))

(defn results-field [(task Code)] (-> Code)
  `(.attrs-results ~task))

;;; One rule at a node of kind `head`: on a match, its value goes where the node was.
(defn rw-alt-code [(k (mut Comp))
                   (a RwAlt)
                   (subject Code)
                   (rebuilt Code)
                   (ty (slice u8))
                   (head (slice u8))
                   (label Code)
                   (task Code)
                   (same Code)] (-> Code)
  (let [mark (locals-mark (mut k))
        (mut steps) (ArrayList::new [Step] (malloc-allocator))]
    (pat! (mut k) (.pat a) subject ty (mut steps) head)
    (clear! (mut (.outs k)))
    ;; The children the pattern names at its top, and its node, have rewritten forms.
    (for i (range mark (len (.locals k)))
      (let [l (get (.locals k) i)]
        (match (child-index (.pat a) (.name l) subject)
          (Some [index]
                (push! (mut (.outs k))
                       (Out :sym (.sym l) :code `(get (.kids ~rebuilt) ~index))))
          (None [] 0))))
    (unless (none? (.as-name a))
      (let [s (bind-local! (mut k) (.text (.as-name a)) ty false)]
        (push! (mut steps) (SBind s subject))
        (push! (mut (.outs k)) (Out :sym s :code rebuilt))))
    (set! (.in-on k) true)
    (let [guard
            (if (none? (.guard a))
                `true
                (.code (expect (mut k)
                               (.guard a)
                               (expr (mut k) (.guard a) "Bool")
                               "Bool")))
          many (cat3 "[" ty "]")
          ;; `[…]` is the nodes that go in the node's place; anything else, the one node.
          v
            (expr (mut k)
                  (.body a)
                  (if (= (.kind (.body a)) (g/KListLit)) many ty))
          each (fresh (mut k) "each")
          got (fresh (mut k) "got")
          changed `(set! (.attrs-changes ~task) (+ (.attrs-changes ~task) 1))
          push
            (cond (= (.ty v) ty)
                    `(let [~(sym got) ~(.code v)]
                       (unless (~same ~(sym got) ~subject) ~changed)
                       (push! (mut ~(results-field task)) ~(sym got)))
                  (= (.ty v) many)
                    `(do
                       ~changed
                       (for (ref ~(sym each)) ~(.code v)
                         (push! (mut ~(results-field task)) ~(sym each))))
                  :else
                    (die (mut k)
                         (.body a)
                         (cat4 "a rewrite gives a "
                               ty
                               " or a "
                               (cat3 many ", not " (.ty v)))))]
      (set! (.in-on k) false)
      (clear! (mut (.outs k)))
      (when (.returned k) (die (mut k) (.body a) "a rewrite cannot return"))
      (locals-reset! (mut k) mark)
      (wrap-steps steps 0 `(when ~guard ~push (return-from ~label 0))))))

;;; The rules for a node of kind `head`, then the node as rebuilt.
(defn rw-arm-code [(k (mut Comp))
                   (alts (ArrayList RwAlt))
                   (head (slice u8))
                   (subject Code)
                   (rebuilt Code)
                   (ty (slice u8))
                   (task Code)
                   (same Code)] (-> Code)
  (let [label (primitive/code-symbol ":" (fresh (mut k) "rw"))
        (mut tries) (primitive/code-list-new)]
    (for a alts
      (let [h (rw-head a)]
        (when (or (= h head) (= (len h) 0))
          (push! (mut tries)
                 (rw-alt-code (mut k) a subject rebuilt ty head label task same)))))
    `(block ~label ~@tries (push! (mut ~(results-field task)) ~rebuilt) 0)))

;;; The traversal's rewriting: each visit leaves what its node became on `attrs-results`, so a
;;; node finds its children's past `mark`. A node is itself when no rewrite under it changed
;;; anything, which `attrs-changes` counts, so a node that stayed costs no comparing.
(defn rewrite-fns [(k (mut Comp))
                   (decls (ArrayList g/Node))
                   (gr Mod)
                   (over (slice u8))
                   (ty (slice u8))
                   (node-coil Code)
                   (task Code)] (-> Code)
  (let [alts (rewrite-alts decls)
        n (sym "rw-node")
        rebuilt (sym "rw-rebuilt")
        (mut heads) (text-list)
        (mut arms) (primitive/code-list-new)
        alias (alias-of (.name gr))
        same (primitive/code-symbol alias "/same-node?")
        sublist (primitive/code-symbol alias "/sublist")
        kind-name (primitive/code-symbol alias "/kind-name")]
    (for a alts
      (let [h (rw-head a)
            (mut seen) (= (len h) 0)]
        (for x heads (when (= x h) (set! seen true)))
        (unless seen
          (unless (match (find-kind gr h) (Some [_] true) (None [] false))
            (die (mut k)
                 (.pat a)
                 (cat4 "the grammar " over " has no node named " h)))
          (push! (mut heads) h))))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) "Void")
    (set! (.in-fn k) true)
    (for h heads
      (push! (mut arms)
             `(~(kind-code gr h) []
                 ~(rw-arm-code (mut k) alts h n rebuilt ty task same))))
    (let [wild (rw-arm-code (mut k) alts "" n rebuilt ty task same)]
      (set! (.in-fn k) false)
      (clear! (mut (.locals k)))
      `(do
         (defn attrs-rebuilt [(~n ~node-coil)
                              (~task (ptr RulesTask))
                              (mark i64)
                              (before i64)] (-> ~node-coil)
           (if (= (.attrs-changes ~task) before)
               ~n
               (let [got (- (len ~(results-field task)) mark)]
                 (unless (or (= (.kind ~n) (~(kind-code gr "List")))
                             (= got (len (.kids ~n))))
                   (panic "a rewrite gave {} nodes in place of one child of a {} node"
                          got
                          (~kind-name (.kind ~n))))
                 (let [(mut x) ~n]
                   (set! (.kids x)
                         (~sublist ~(results-field task)
                            mark
                            (len ~(results-field task))))
                   x))))
         (defn attrs-rewrite! [(~n ~node-coil)
                               (~rebuilt ~node-coil)
                               (~task (ptr RulesTask))] (-> void)
           (match (.kind ~n) ~@arms (_ ~wild))
           0)
         (defn attrs-truncate! [(~task (ptr RulesTask)) (mark i64)] (-> void)
           (set! (.len ~(results-field task)) mark)
           0)))))

;;; The traversal, and `run`.
(defn compile-attrs [(k (mut Comp)) (tree g/Node) (decls (ArrayList g/Node))]
  (-> Code)
  (let [over (.text (kid tree 1))
        ty (cat over ".Node")
        gr (mod-at (mut k) over)
        node-coil (coil-type (mut k) ty)
        visit (sym "attrs-visit")
        n (sym "attrs-node")
        task (sym "rules-task-here")
        (mut alts) (on-alts (mut k) decls)
        (mut ovrs) (ArrayList::new [OvrSlot] (malloc-allocator))
        (mut heads) (text-list)]
    (for d decls
      (when (= (.kind d) (g/KOn))
        (find-ovrs! (mut k) (on-body-with-where d) (mut ovrs))))
    (let [(mut givens) (ArrayList::new [Given] (malloc-allocator))]
      (for d decls
        (when (= (.kind d) (g/KGiven))
          (let [x
                  (match (attr-global (mut k) (.text (kid d 0)) 4)
                    (Some [g] g)
                    (None [] (die (mut k) d "this was not collected")))]
            (push! (mut givens)
                   (Given
                     :attr (.name x)
                     :default
                       (.code (expect (mut k)
                                      (kid d 2)
                                      (expr (mut k) (kid d 2) (.ty x))
                                      (.ty x))))))))
      (set! (.givens k) givens))
    (for a alts
      (let [h (on-head a)
            (mut seen) (= (len h) 0)]
        (for x heads (when (= x h) (set! seen true)))
        (unless seen
          (unless (match (find-kind gr h) (Some [_] true) (None [] false))
            (die (mut k)
                 (.pat a)
                 (cat4 "the grammar " over " has no node named " h)))
          (push! (mut heads) h))))
    (clear! (mut (.locals k)))
    (set! (.returned k) false)
    (set! (.ret k) "Void")
    (set! (.in-fn k) true)
    (set! (.ovr-slots k) ovrs)
    (let [(mut arms) (primitive/code-list-new)
          (mut block-fns) (primitive/code-list-new)
          (mut marks) (primitive/code-list-new)
          (mut fixups) (primitive/code-list-new)
          (mut count) 0]
      (for d decls (when (= (.kind d) (g/KOn)) (set! count (+ count 1))))
      (let [own-blocks (on-blocks (mut k) alts count n ty)
            (mut blocks) (ArrayList::new [OnBlock] (malloc-allocator))]
        (for b own-blocks
          (push! (mut blocks) b)
          (unless (.inline b)
            (push! (mut block-fns)
                   (on-block-fn (mut k) b n node-coil task visit))))
        (clear! (mut (.locals k)))
        (for d decls
          (when (= (.kind d) (g/KInclude))
            (included-blocks! (mut k)
                              d
                              n
                              ty
                              task
                              (mut alts)
                              (mut blocks)
                              (mut heads)
                              gr
                              over)))
        (for h heads
          (push! (mut arms)
                 `(~(kind-code gr h) []
                     ~(on-arm-code (mut k) alts blocks h n ty task visit))))
        (let [wild (on-arm-code (mut k) alts blocks "" n ty task visit)]
          (set! (.in-fn k) false)
          (set! (.ovr-slots k) (ArrayList::new [OvrSlot] (malloc-allocator)))
          (for o ovrs
            (let [field (task-field (.attr o) task)
                  v (sym (fresh (mut k) "v"))
                  e (sym (fresh (mut k) "e"))]
              (push! (mut marks) `(mut ~(sym (.sym o))))
              (push! (mut marks) `(None [~(coil-type (mut k) (.ty o))]))
              (push! (mut marks) (sym (.mark o)))
              (push! (mut marks) (if (list? (.ty o)) `(len ~field) field))
              (push! (mut fixups)
                     (if (list? (.ty o))
                         `(match ~(sym (.sym o))
                            (Some [~v]
                                  (while (> (len ~field) ~(sym (.mark o)))
                                    (pop! (mut ~field)))
                                  (for (ref ~e) ~v (push! (mut ~field) ~e))
                                  0)
                            (None [] 0))
                         `(match ~(sym (.sym o))
                            (Some [~v]
                                  (set! ~field ~(sym (.mark o)))
                                  (match ~(sym (.mark o))
                                    (None [] (set! ~field ~v))
                                    (_ 0))
                                  0)
                            (None [] 0))))))
          (let [(mut params) (primitive/code-list-new)
                (mut saves) (primitive/code-list-new)
                (mut sets) (primitive/code-list-new)
                (mut restores) (primitive/code-list-new)
                (mut fields) (primitive/code-list-new)
                t (sym "attrs-task")
                root (sym "attrs-tree")]
            (for d decls
              (when (= (.kind d) (g/KInput))
                (let [name (.text (kid d 0))
                      x
                        (match (attr-global (mut k) name 2)
                          (Some [g] g)
                          (None [] (die (mut k) d "this was not collected")))
                      p (fresh (mut k) "in")
                      saved (fresh (mut k) "saved")]
                  (push! (mut params) `(~(sym p) ~(coil-type (mut k) (.ty x))))
                  (push! (mut saves) (sym saved))
                  (push! (mut saves) (task-field name t))
                  (push! (mut sets) `(set! ~(task-field name t) ~(sym p)))
                  (push! (mut restores)
                         `(set! ~(task-field name t) ~(sym saved)))))
              (when (= (.kind d) (g/KCollect))
                (let [name (.text (kid d 0))
                      x
                        (match (attr-global (mut k) name 3)
                          (Some [g] g)
                          (None [] (die (mut k) d "this was not collected")))]
                  (push! (mut sets)
                         `(set! ~(task-field name t)
                                ~(default-of (mut k) d (.ty x))))
                  (push! (mut fields) (primitive/code-symbol ":" name))
                  (push! (mut fields) (task-field name t))))
              ;; An included grammar's task state, found once, and what it collects, from empty.
              (when (= (.kind d) (g/KInclude))
                (let [m (mod-at (mut k) (.text (kid d 0)))
                      its (task-field (include-field m) t)]
                  (push! (mut sets)
                         `(set! ~its
                                (~(primitive/code-symbol (alias-of (.name m))
                                                         "/rules-task"))))
                  (for x (.globals m)
                    (when (= (.attr x) 3)
                      (push! (mut sets)
                             `(set! ~(task-field (.name x) its)
                                    ~(default-of (mut k) d (.ty x))))
                      (push! (mut fields) (primitive/code-symbol ":" (.name x)))
                      (push! (mut fields) (task-field (.name x) its)))))))
            (let [rw (rewrites? decls)
                  rw-mark (sym "rw-mark")
                  rw-fns
                    (if rw
                        (rewrite-fns (mut k) decls gr over ty node-coil task)
                        `(do))
                  rw-before (sym "rw-before")
                  visit-marks
                    (if rw
                        `(~@marks ~rw-mark
                            (len ~(results-field task))
                            ~rw-before
                            (.attrs-changes ~task))
                        `(~@marks))
                  post
                    (if rw
                        `(let [rebuilt
                                 (attrs-rebuilt ~n ~task ~rw-mark ~rw-before)]
                           (attrs-truncate! ~task ~rw-mark)
                           (attrs-rewrite! ~n rebuilt ~task))
                        `0)
                  start (sym "rw-start")]
              (when rw
                (push! (mut fields) `:tree)
                (push! (mut fields) `(get ~(results-field t) ~start)))
              `(do
                 ~@block-fns
                 ~rw-fns
                 (defn ~visit [(~n ~node-coil) (~task (ptr RulesTask))]
                   (-> void)
                   (let [~@visit-marks]
                     (match (.kind ~n) ~@arms (_ ~wild))
                     ~@fixups
                     ~post
                     0))
                 (defn run [(~root ~node-coil) ~@params] (-> Attrs)
                   (let [~t (rules-task)
                         ~start ~(if rw `(len ~(results-field t)) `0)
                         ~@saves]
                     ~@sets
                     ~(if (inputs? decls)
                          `(set! (.attrs-depth ~t) (+ (.attrs-depth ~t) 1))
                          `0)
                     (~visit ~root ~t)
                     (let [result (Attrs ~@fields)]
                       ~(if rw `(attrs-truncate! ~t ~start) `0)
                       ~(if (inputs? decls)
                            `(set! (.attrs-depth ~t) (- (.attrs-depth ~t) 1))
                            `0)
                       ~@restores
                       result)))))))))))

;; ---------------------------------------------------------------- memo functions

;;; `memo fn f(k: K) -> R`: each answer is computed once, by whichever worker asks first, and
;;; every worker shares it; one that asks while another computes it waits. Each keeps a table of
;;; its own in front of the shared one, so a question asked again costs no lock. The answer must not
;;; be changed by whoever gets it. While dependencies are tracked it is kept until something it
;;; was made from changes: a file it read, a setting, another memo's answer (see the dependencies in
;;; hl.rt), so a long-running program computes again only what an edit reaches. Otherwise binding a
;;; setting of the module starts all its memos over.
(defn memo-check! [(k (mut Comp)) (d g/Node)] (-> Func)
  (let [f
          (match (find-func (self-mod (mut k)) (.text (kid d 0)))
            (Some [x] x)
            (None [] (die (mut k) d "this function was not collected")))]
    (when (= (len (.params f)) 0)
      (die (mut k)
           d
           "a memo function takes what it remembers by: at least one argument"))
    (for p (.params f)
      (when (.by-ref p)
        (die (mut k) d "a memo function's argument cannot be mut"))
      (unless (or (= (.ty p) "Text") (= (.ty p) "Int"))
        (die (mut k) d "a memo function's arguments are Text or Int, for now")))
    (when (= (.ret f) "Void")
      (die (mut k) d "a memo function must answer something"))
    f))

;;; What a memo is looked up by: its one argument, or its arguments' text joined.
(defn memo-key-type [(f Func)] (-> (slice u8))
  (if (= (len (.params f)) 1) (.ty (get (.params f) 0)) "Text"))

;;; The memo's own name for its argument `i`.
(defn memo-arg [(i i64)] (-> Code)
  (sym (cat "memo-arg-" (rt/num-text i))))

(defn memo-key-code [(f Func)] (-> Code)
  (if (= (len (.params f)) 1)
      (memo-arg 0)
      (let [(mut pushes) (primitive/code-list-new)]
        (for i (range 0 (len (.params f)))
          (push! (mut pushes)
                 `(push! (mut memo-parts)
                         ~(if (= (.ty (get (.params f) i)) "Int")
                              `(rt/num-text ~(memo-arg i))
                              (memo-arg i)))))
        `(let [(mut memo-parts) (ArrayList::new [(slice u8)] (malloc-allocator))]
           ~@pushes
           (rt/memo-key-of memo-parts)))))

(defn memo-map-type [(f Func)] (-> (slice u8))
  (cat4 "{" (memo-key-type f) ":" (cat (.ret f) "}")))

;;; Who is computing an answer: the worker's slot plus one.
(defn memo-busy-type [(f Func)] (-> (slice u8))
  (cat3 "{" (memo-key-type f) ":Int}"))

(defn memo-near [(name (slice u8))] (-> (slice u8))
  (cat "memo-near--" name))

(defn memo-near-gen [(name (slice u8))] (-> (slice u8))
  (cat "memo-near-gen--" name))

;;; The task struct's fields for a memo: its near table and the generation that table is of.
(defn memo-new-map [(k (mut Comp)) (d g/Node)] (-> Code)
  (new-map (mut k) (memo-map-type (memo-check! (mut k) d))))

(defn memo-near-field [(k (mut Comp)) (d g/Node)] (-> Code)
  `(~(sym (memo-near (.text (kid d 0)))) ~(coil-type (mut k)
                                                     (memo-map-type (memo-check! (mut k)
                                                                                 d)))))

(defn memo-gen-field [(d g/Node)] (-> Code)
  `(~(sym (memo-near-gen (.text (kid d 0)))) i64))

(defn memo-near-init [(k (mut Comp)) (d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near (.text (kid d 0)))) s)
         ~(memo-new-map (mut k) d)))

(defn memo-gen-init [(d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near-gen (.text (kid d 0)))) s) -1))

(defn memo-near-rev [(name (slice u8))] (-> (slice u8))
  (cat "memo-near-rev--" name))

(defn memo-rev-field [(d g/Node)] (-> Code)
  `(~(sym (memo-near-rev (.text (kid d 0)))) i64))

(defn memo-rev-init [(d g/Node)] (-> Code)
  `(set! (~(primitive/code-symbol "." (memo-near-rev (.text (kid d 0)))) s) -1))

;;; Whether two values of a rules type are the same, as code: what keeps a memo's recomputed answer
;;; from counting as changed. Lists, maps and records are compared by helpers made once per type;
;;; a list whose buffer is the other's is the same without a look inside. Functions, and a foreign
;;; module's opaque types, cannot be looked into: two of them are never the same.
(defn same-code [(k (mut Comp)) (t (slice u8)) (a Code) (b Code)] (-> Code)
  (cond (or (= t "Int") (= t "Bool") (= t "Text")) `(= ~a ~b)
        (fn? t) `false
        (opt? t)
          (let [x (fresh (mut k) "x")
                y (fresh (mut k) "y")]
            `(match ~a
               (Some [~(sym x)] (match ~b (Some [~(sym y)] ~(same-code (mut k) (opt-of t) (sym x) (sym y))) (None [] false)))
               (None [] (match ~b (Some [_] false) (None [] true)))))
        (or (list? t) (map? t)) `(~(same-helper (mut k) t) ~a ~b)
        :else
          (let [mo (mod-at (mut k) (type-module t))]
            (cond (and (= (.sort mo) (SGrammar)) (= (type-name t) "Node"))
                    `(~(sym (qualified (mut k) (type-module t) "node-same?")) ~a ~b)
                  (is-some? (find-enum-named mo (type-name t))) `(= ~a ~b)
                  (is-some? (find-rec mo (type-name t))) `(~(same-helper (mut k) t) ~a ~b)
                  :else `false))))

(defn is-some? [T] [(o (Option T))] (-> bool)
  (match o (Some [_] true) (None [] false)))

(defn same-name [(t (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut b) "same--")
    (for i (range 0 (len t))
      (let [c (get t i)]
        (push-str! (mut b)
                   (cond (= c #\[) "L" (= c #\]) "E" (= c #\{) "M" (= c #\}) "N" (= c #\:) "C" (= c #\?) "O"
                         (= c #\.) "_" (= c #\,) "S" (= c #\-) "h"
                         :else (subslice t i (+ i 1))))))
    (finish! (mut b))))

;;; The helper comparing two values of a list, map or record type, made the first time it is asked for.
(defn same-helper [(k (mut Comp)) (t (slice u8))] (-> Code)
  (let [name (same-name t)
        ty (coil-type (mut k) t)]
    (unless (has-text? (.sames k) name)
      (push! (mut (.sames k)) name)
      (push! (mut (.aux k))
             (cond (list? t)
                     `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                        (and (= (len a) (len b))
                             (or (= (primitive/cast i64 (data (slice a))) (primitive/cast i64 (data (slice b))))
                                 (block :same
                                        (for i (range 0 (len a))
                                          (unless ~(same-code (mut k) (elem-of t) `(get a i) `(get b i))
                                            (return-from :same false)))
                                        true))))
                   (map? t)
                     `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                        (and (= (len a) (len b))
                             (block :same
                                    (for key a
                                      (match (get b key)
                                        (Some [y]
                                              (match (get a key)
                                                (Some [x] (unless ~(same-code (mut k) (map-val t) `x `y) (return-from :same false)))
                                                (None [] (return-from :same false))))
                                        (None [] (return-from :same false))))
                                    true)))
                   :else
                     (let [r (match (find-rec (mod-at (mut k) (type-module t)) (type-name t))
                               (Some [r] r)
                               (None [] (panic "rules: no record {}" t)))
                           (mut tests) (primitive/code-list-new)]
                       (for f (.fields r)
                         (push! (mut tests)
                                (same-code (mut k) (.ty f)
                                           `(~(primitive/code-symbol "." (.name f)) a)
                                           `(~(primitive/code-symbol "." (.name f)) b))))
                       `(defn ~(sym name) [(a ~ty) (b ~ty)] (-> bool)
                          (and true ~@tests))))))
    (sym name)))

(defn has-text? [(xs (ArrayList (slice u8))) (x (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for y xs (when (= y x) (set! hit true)))
    hit))

;;; The shared table, its lock and generation; the function; the computation under another name.
(defn compile-memo! [(k (mut Comp)) (d g/Node) (out (mut str/StrBuf))] (-> void)
  (let [f (memo-check! (mut k) d)
        name (.text (kid d 0))
        mt (memo-map-type f)
        store (sym (cat "MemoStore--" name))
        store-fn (sym (cat "memo-store--" name))
        compute (cat "memo-compute--" name)
        ensure (sym (cat "memo-ensure--" name))
        near (primitive/code-symbol "." (memo-near name))
        near-gen (primitive/code-symbol "." (memo-near-gen name))
        near-rev (primitive/code-symbol "." (memo-near-rev name))
        qname (cat3 (.self k) "." name)
        key-text (if (= (memo-key-type f) "Int") `(rt/num-text key) `key)
        (mut params) (primitive/code-list-new)
        (mut args) (primitive/code-list-new)
        (mut parsed) (primitive/code-list-new)
        rt (coil-type (mut k) (.ret f))]
    (for i (range 0 (len (.params f)))
      (push! (mut params)
             `(~(memo-arg i) ~(coil-type (mut k) (.ty (get (.params f) i)))))
      (push! (mut args) (memo-arg i))
      (let [part (if (= (len (.params f)) 1) `text `(get parts ~i))]
        (push! (mut parsed) (if (= (.ty (get (.params f) i)) "Int") `(rt/parse-int ~part) part))))
    (emit! (mut out) (compile-fn-as (mut k) d compute))
    ;; The lock word comes first, so the store's address is the word's.
    (emit! (mut out)
           `(defstruct ~store
              [(lock i64)
               (ready bool)
               (gen i64)
               (table ~(coil-type (mut k) mt))
               (busy ~(coil-type (mut k) (memo-busy-type f)))]))
    ;; An answer asked for by its key's text, as checking an answer that read it asks.
    (emit! (mut out)
           `(defn ~ensure [(text (slice u8))] (-> i64)
              (let [parts ~(if (> (len (.params f)) 1) `(rt/memo-key-parts text) `(rt/memo-key-parts ""))]
                (~(sym name) ~@parsed)
                0)))
    (emit! (mut out)
           `(defn ~store-fn [] (-> (ptr ~store))
              (let [s (primitive/alloc-static ~store)]
                (unless (.ready s)
                  (rt/init-lock!)
                  (unless (.ready s)
                    (set! (.table s) ~(new-map (mut k) mt))
                    (set! (.busy s) ~(new-map (mut k) (memo-busy-type f)))
                    (set! (.gen s) (rt/next-pass!))
                    (set! (.ready s) true))
                  (rt/init-unlock!)
                  (rt/dep-ensurer! ~qname (fnptr-of ~ensure)))
                s)))
    ;; While dependencies are tracked, an answer from an earlier revision is current only once each
    ;; thing it read is shown unchanged, and an answer computed again that is the same as the one
    ;; it replaces is kept, and does not count as changed.
    (emit! (mut out)
           `(defn ~(sym name) [~@params] (-> ~rt)
              (let [key ~(memo-key-code f)
                    t (rules-task)
                    s (~store-fn)
                    word (cast (ptr i64) s)
                    tracking (rt/dep-tracking?)
                    node (if tracking (rt/memo-node ~qname ~key-text) "")]
                ;; A memo computing now is made from this answer.
                (when (and tracking (rt/dep-in-frame?)) (rt/dep-note! node))
                (when (!= (~near-gen t) (.gen s))
                  (set! (~near t) ~(new-map (mut k) mt))
                  (set! (~near-gen t) (.gen s)))
                (when tracking
                  (let [rev (rt/dep-revision)]
                    (when (!= (~near-rev t) rev)
                      (set! (~near t) ~(new-map (mut k) mt))
                      (set! (~near-rev t) rev))))
                (match (get (~near t) key)
                  (Some [v] v)
                  (None []
                        (let [me (+ (rt/worker-slot) 1)
                              (mut answer) (None [~rt])
                              (mut go) true]
                          (while go
                            (rt/spin-lock! word)
                            (let [found (get (.table s) key)
                                  current (match found
                                            (Some [_] (or (not tracking) (rt/dep-current? node)))
                                            (None [] false))]
                              (if current
                                  (do
                                    (rt/spin-unlock! word)
                                    (set! answer found)
                                    (set! go false))
                                  (let [owner
                                          (match (get (.busy s) key)
                                            (Some [o] o)
                                            (None [] 0))]
                                    (cond (= owner me)
                                            (do
                                              (rt/spin-unlock! word)
                                              (panic "memo fn {} asks for its own answer"
                                                     ~name))
                                          (> owner 0)
                                            (do
                                              (rt/spin-unlock! word)
                                              (rt/pause!))
                                          :else
                                            (do
                                              (set! (mut (.busy s)) key me)
                                              (rt/spin-unlock! word)
                                              (let [made
                                                      (match found
                                                        (Some [old]
                                                              (if (rt/dep-still? node)
                                                                  old
                                                                  (do
                                                                    (rt/dep-begin!)
                                                                    (let [fresh (~(sym compute) ~@args)
                                                                          same ~(same-code (mut k) (.ret f) `old `fresh)]
                                                                      (rt/dep-end! node same)
                                                                      (if same old fresh)))))
                                                        (None []
                                                              (do
                                                                (when tracking (rt/dep-begin!))
                                                                (let [fresh (~(sym compute) ~@args)]
                                                                  (when tracking (rt/dep-end! node false))
                                                                  (rt/dep-untracked!)
                                                                  fresh))))]
                                                (rt/spin-lock! word)
                                                (set! (mut (.table s))
                                                      key
                                                      made)
                                                (set! (mut (.busy s)) key 0)
                                                (rt/spin-unlock! word)
                                                (set! answer (Some made))
                                                (set! go false))))))))
                          (match answer
                            (Some [v] (do (set! (mut (~near t)) key v) v))
                            (None [] (panic "memo fn {} lost its answer" ~name)))))))))))

;;; Every memo of the module starts over, when dependencies are not tracked. Only while no other
;;; worker runs.
(defn compile-forget! [(k (mut Comp)) (decls (ArrayList g/Node))] (-> Code)
  (let [(mut body) (primitive/code-list-new)]
    (for d decls
      (when (= (.kind d) (g/KMemoFn))
        (let [f (memo-check! (mut k) d)
              name (.text (kid d 0))]
          (push! (mut body)
                 `(let [s (~(sym (cat "memo-store--" name)))]
                    (set! (.table s) ~(new-map (mut k) (memo-map-type f)))
                    (set! (.busy s) ~(new-map (mut k) (memo-busy-type f)))
                    (set! (.gen s) (rt/next-pass!)))))))
    `(defn forget-memos! [] (-> void)
       ~@body
       0)))

(defn compile-record [(k (mut Comp)) (r RecDef)] (-> Code)
  (let [(mut fields) (primitive/code-list-new)]
    (for f (.fields r)
      (push! (mut fields) `(~(sym (.name f)) ~(coil-type (mut k) (.ty f)))))
    `(defstruct ~(sym (.name r)) [~@fields])))

;;; An enum, compared by its tag: one load each, where a derived comparison is a call.
(defn compile-enum [(e EnumDef)] (-> Code)
  (let [(mut variants) (primitive/code-list-new)
        (mut tags) (primitive/code-list-new)
        ty (sym (.name e))
        tag (sym (cat "enum-tag-" (.name e)))]
    (for i (range 0 (len (.variants e)))
      (let [v (get (.variants e) i)]
        (push! (mut variants) `(~(sym v)))
        (push! (mut tags) `(~(sym v) [] ~i))))
    `(do
       (defsum ~ty ~@variants)
       (defn ~tag :inline (Always) [(x ~ty)] (-> i64)
         (match x ~@tags))
       (impl Eq ~ty
         (= [(a ~ty) (b ~ty)] (-> bool)
           (= (~tag a) (~tag b)))))))

;;; Text, one form to a line, is what the generated module is.
(defn emit! [(out (mut str/StrBuf)) (form Code)] (-> void)
  (push-str! (mut out) (dsl/render form))
  (push-str! (mut out) "\n"))

(defn prelude-text [] (-> (slice u8))
  (include-str "../../src/languages/rules_prelude.rules"))

;;; Placeholder values for a fresh task struct's fields, before its own thread initialises them.
(defn task-zeroes [(k (mut Comp)) (self Mod) (decls (ArrayList g/Node))]
  (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for d decls
      (when (or (= (.kind d) (g/KTaskState))
                (= (.kind d) (g/KContext))
                (= (.kind d) (g/KInh))
                (= (.kind d) (g/KInput))
                (= (.kind d) (g/KCollect))
                (= (.kind d) (g/KGiven)))
        (let [g-name (.text (kid d 0))
              x
                (match (find-global self g-name)
                  (Some [v] v)
                  (None [] (die (mut k) d "this was not collected")))]
          (when (.task x)
            (push! (mut out) (primitive/code-symbol ":" g-name))
            (push! (mut out) (global-init (mut k) d x)))))
      (when (= (.kind d) (g/KInclude))
        (let [m (mod-at (mut k) (.text (kid d 0)))]
          (push! (mut out) (primitive/code-symbol ":" (include-field m)))
          (push! (mut out)
                 `(cast (ptr ~(primitive/code-symbol (alias-of (.name m))
                                                     "/RulesTask"))
                        0))))
      (when (= (.kind d) (g/KMemoFn))
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near (.text (kid d 0)))))
        (push! (mut out) (memo-new-map (mut k) d))
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near-gen (.text (kid d 0)))))
        (push! (mut out) `-1)
        (push! (mut out)
               (primitive/code-symbol ":" (memo-near-rev (.text (kid d 0)))))
        (push! (mut out) `-1)))
    (when (inputs? decls)
      (push! (mut out) `:attrs-depth)
      (push! (mut out) `0))
    (when (rewrites? decls)
      (push! (mut out) `:attrs-results)
      (push! (mut out) (new-list (mut k) (cat (.over self) ".Node")))
      (push! (mut out) `:attrs-changes)
      (push! (mut out) `0))
    `(~@out)))

(defn compile-module [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut k)
          (Comp
            :mods (ArrayList::new [Mod] (malloc-allocator))
            :self ""
            :table (ArrayList::new [Alias] (malloc-allocator))
            :base ""
            :depends (text-list)
            :src src
            :path path
            :locals (ArrayList::new [Local] (malloc-allocator))
            :counter 0
            :in-with 0
            :returned false
            :ret "Void"
            :aux (ArrayList::new [Code] (malloc-allocator))
            :in-fn false
            :task-used false
            :in-on false
            :eq-slots (ArrayList::new [EqSlot] (malloc-allocator))
            :ovr-slots (ArrayList::new [OvrSlot] (malloc-allocator))
            :givens (ArrayList::new [Given] (malloc-allocator))
            :outs (ArrayList::new [Out] (malloc-allocator))
            :sames (text-list)
            :attrs-from "")
        manifest (meta/read-context-manifest context)]
    (read-manifest! (mut k) manifest)
    (load-prelude! (mut k))
    (let [tree (load-rules-file! (mut k) path src true)
          name (.text (kid tree 0))
          decls (list-kids (kid tree 2))
          (mut out) (str/StrBuf::new (malloc-allocator))]
      (set! (.self k) name)
      (set! (.src k) src)
      (set! (.path k) path)
      ;; Every file sees the prelude's foreign modules by their aliases.
      (emit! (mut out)
             `(do
                (import "coil.primitive" :as primitive)
                (import "coil.alloc" :use [malloc-allocator])
                (import "coil.arraylist" :use [ArrayList])
                (import "coil.hashmap" :use [HashMap i64-keyops])
                (import "coil.slice" :use [subslice])
                (import "coil.str" :as str)
                (import "coil.cc" :as cc)
                (import "coil.control" :use [return-from])))
      (for m (.mods k)
        (unless (or (= (.name m) name)
                    (= (.name m) "hl.prelude")
                    (= (.name m) "hl.rt"))
          (emit! (mut out) `(import ~(.name m) :as ~(sym (alias-of (.name m)))))))
      (emit! (mut out) `(import "hl.rt" :as rt))
      (emit! (mut out) `(import "hl.rt" :as hl-rt))
      (emit! (mut out) `(import "coil.atomic" :as atomic))
      (let [(mut deps) (primitive/code-list-new)]
        (for d (.depends k) (push! (mut deps) `~d))
        (when (> (len (.depends k)) 0)
          (emit! (mut out) `(depends-on ~@deps))))
      (let [self (self-mod (mut k))
            (mut state-fields) (primitive/code-list-new)
            (mut state-inits) (primitive/code-list-new)]
        (for e (.enums self) (emit! (mut out) (compile-enum e)))
        (for r (.recs self) (emit! (mut out) (compile-record (mut k) r)))
        (let [(mut task-fields) (primitive/code-list-new)
              (mut task-inits) (primitive/code-list-new)]
          (for d decls
            (when (or (= (.kind d) (g/KState))
                      (= (.kind d) (g/KTaskState))
                      (= (.kind d) (g/KContext))
                      (= (.kind d) (g/KConst))
                      (= (.kind d) (g/KInh))
                      (= (.kind d) (g/KInput))
                      (= (.kind d) (g/KCollect))
                      (= (.kind d) (g/KGiven))
                      (= (.kind d) (g/KSetting)))
              (let [g-name (.text (kid d 0))
                    x
                      (match (find-global self g-name)
                        (Some [v] v)
                        (None [] (die (mut k) d "this was not collected")))
                    v (global-init (mut k) d x)]
                (if (.task x)
                    (do
                      (push! (mut task-fields)
                             `(~(sym g-name) ~(coil-type (mut k) (.ty x))))
                      (push! (mut task-inits)
                             `(set! (~(primitive/code-symbol "." g-name) s) ~v)))
                    (do
                      (push! (mut state-fields)
                             `(~(sym g-name) ~(coil-type (mut k) (.ty x))))
                      (push! (mut state-inits)
                             `(set! (~(primitive/code-symbol "." g-name) s) ~v))
                      (when (= (.attr x) 5)
                        (push! (mut state-fields)
                               `(~(sym (bound-field g-name)) i64))
                        (push! (mut state-inits)
                               `(set! (~(primitive/code-symbol "."
                                                               (bound-field g-name)) s)
                                      0)))))))
            (when (= (.kind d) (g/KInclude))
              (let [m (mod-at (mut k) (.text (kid d 0)))
                    rt-ty
                      `(ptr ~(primitive/code-symbol (alias-of (.name m))
                                                    "/RulesTask"))]
                (push! (mut task-fields) `(~(sym (include-field m)) ~rt-ty))
                (push! (mut task-inits)
                       `(set! (~(primitive/code-symbol "." (include-field m)) s)
                              (cast ~rt-ty 0)))))
            (when (= (.kind d) (g/KMemoFn))
              (push! (mut task-fields) (memo-near-field (mut k) d))
              (push! (mut task-fields) (memo-gen-field d))
              (push! (mut task-fields) (memo-rev-field d))
              (push! (mut task-inits) (memo-near-init (mut k) d))
              (push! (mut task-inits) (memo-gen-init d))
              (push! (mut task-inits) (memo-rev-init d))))
          (when (inputs? decls)
            (push! (mut task-fields) `(attrs-depth i64))
            (push! (mut task-inits) `(set! (.attrs-depth s) 0)))
          (when (and (= (.kind tree) (g/KAttrsFile)) (rewrites? decls))
            (let [lt (cat3 "[" (.text (kid tree 1)) ".Node]")]
              (push! (mut task-fields) `(attrs-results ~(coil-type (mut k) lt)))
              (push! (mut task-inits)
                     `(set! (.attrs-results s) ~(new-list (mut k) (elem-of lt))))
              ;; How many nodes a rewrite has changed: a node whose children changed none is itself.
              (push! (mut task-fields) `(attrs-changes i64))
              (push! (mut task-inits) `(set! (.attrs-changes s) 0))))
          ;; Program state, set up by the first thread to use it while any other waits. The flag is
          ;; read and written atomically, so a thread that sees it ready sees what was set: 0 not
          ;; set up, 2 being set up by `rules-owner`, which may use what it has set so far, 1 ready.
          (emit! (mut out)
                 `(defstruct RulesState
                    [(rules-ready i64)
                     (rules-owner i64)
                     (rules-lock i64)
                     ~@state-fields]))
          (emit! (mut out)
                 `(defn rules-init! [(s (ptr RulesState))] (-> void)
                    ~@state-inits
                    0))
          (emit! (mut out)
                 `(defn rules-state [] (-> (ptr RulesState))
                    (let [s (primitive/alloc-static RulesState)]
                      (if (= (atomic/read (field s rules-ready)) 1)
                          s
                          (rules-state-first s)))))
          (emit! (mut out)
                 `(defn rules-state-first [(s (ptr RulesState))]
                    (-> (ptr RulesState))
                    (let [me (+ (rt/worker-slot) 1)]
                      (if (and (= (atomic/read (field s rules-ready)) 2)
                               (= (atomic/read (field s rules-owner)) me))
                          s
                          (do
                            (rt/spin-lock! (field s rules-lock))
                            (when (= (atomic/read (field s rules-ready)) 0)
                              (atomic/store (field s rules-owner) me)
                              (atomic/store (field s rules-ready) 2)
                              (rules-init! s)
                              (atomic/store (field s rules-ready) 1))
                            (rt/spin-unlock! (field s rules-lock))
                            s)))))
          ;; Task state: one copy per worker slot, made the first time its own thread asks. The
          ;; slots and the key are published by an atomic store of `ready`, after them.
          (emit! (mut out)
                 `(defstruct RulesTask [(rules-ready bool) ~@task-fields]))
          (emit! (mut out)
                 `(defstruct RulesTasks
                    [(ready i64) (slots (ArrayList RulesTask)) (key i64)]))
          (emit! (mut out)
                 `(defn rules-task-init! [(s (ptr RulesTask))] (-> void)
                    (set! (.rules-ready s) true)
                    ~@task-inits
                    0))
          (emit! (mut out)
                 ;; A thread finds its own copy through a thread-specific value: one lookup, after the first.
                 `(defn rules-task [] (-> (ptr RulesTask))
                    (let [all (primitive/alloc-static RulesTasks)]
                      (if (= (atomic/read (field all ready)) 1)
                          (let [found (rt/key-get (.key all))]
                            (if (= (primitive/cast i64 found) 0)
                                (rules-task-first all)
                                (cast (ptr RulesTask) found)))
                          (rules-task-first all)))))
          (emit! (mut out)
                 `(defn rules-task-first [(all (ptr RulesTasks))]
                    (-> (ptr RulesTask))
                    (unless (= (atomic/read (field all ready)) 1)
                      (rt/init-lock!)
                      (unless (= (atomic/read (field all ready)) 1)
                        (let [(mut slots)
                                (ArrayList::new [RulesTask] (malloc-allocator))]
                          (for _ (range 0 (rt/max-workers))
                            (push! (mut slots)
                                   (RulesTask :rules-ready
                                              false
                                              ~@(task-zeroes (mut k) self decls))))
                          (set! (.slots all) slots))
                        (set! (.key all) (rt/key-new))
                        (atomic/store (field all ready) 1))
                      (rt/init-unlock!))
                    (let [s (elem (mut (.slots all)) (rt/worker-slot))]
                      (unless (.rules-ready s) (rules-task-init! s))
                      (rt/key-set! (.key all) (cast (ptr i8) s))
                      s)))
          ;; A module's inputs are not its state: what `with` gave them stays given.
          (let [(mut keeps) (primitive/code-list-new)
                (mut puts) (primitive/code-list-new)]
            (for x (.globals self)
              (when (= (.attr x) 5)
                (let [t (fresh (mut k) "kept")
                      field
                        `(~(primitive/code-symbol "." (.name x)) (rules-state))
                      tb (fresh (mut k) "kept")
                      bound
                        `(~(primitive/code-symbol "." (bound-field (.name x))) (rules-state))]
                  (push! (mut keeps) (sym t))
                  (push! (mut keeps) field)
                  (push! (mut keeps) (sym tb))
                  (push! (mut keeps) bound)
                  (push! (mut puts) `(set! ~field ~(sym t)))
                  (push! (mut puts) `(set! ~bound ~(sym tb))))))
            (emit! (mut out)
                   `(defn reset-state! [] (-> void)
                      (let [~@keeps]
                        (rules-init! (rules-state))
                        ~@puts
                        (rules-task-init! (rules-task))))))))
      (for d decls
        (when (= (.kind d) (g/KFn))
          (emit! (mut out) (compile-fn (mut k) d)))
        (when (= (.kind d) (g/KMemoFn))
          (compile-memo! (mut k) d (mut out))))
      (when (any-memo? decls) (emit! (mut out) (compile-forget! (mut k) decls)))
      (when (= (.kind tree) (g/KAttrsFile))
        (emit! (mut out) (compile-attrs (mut k) tree decls)))
      (for a (.aux k) (emit! (mut out) a))
      (for d decls
        (when (= (.kind d) (g/KMainDecl))
          (emit! (mut out) (compile-main (mut k) d))))
      (finish! (mut out)))))

;;; `main run`: the arguments are read, then `run` starts, on a thread with room for deep
;;; trees if asked. Answers `run`'s exit status when it has one.
(defn compile-main [(k (mut Comp)) (d g/Node)] (-> Code)
  (let [name (.text (kid d 0))
        f
          (match (find-func (self-mod (mut k)) name)
            (Some [x] x)
            (None [] (die (mut k) d (cat "no function named " name))))
        answers (= (.ret f) "Int")]
    (unless (= (len (.params f)) 0)
      (die (mut k) d (cat name " must take no arguments")))
    (if (none? (kid d 1))
        `(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
           (rt/args-init! argc argv)
           ~(if answers `(~(sym name)) `(do (~(sym name)) 0)))
        `(do
           (defn rules-worker [(arg (ptr i8))] (-> (ptr i8))
             ~(if answers `(rt/answer! (~(sym name))) `(~(sym name)))
             arg)
           (defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
             (rt/args-init! argc argv)
             (rt/run-on-big-stack (fnptr-of rules-worker))
             (rt/answer))))))

(defn load-prelude! [(k (mut Comp))] (-> void)
  (let [text (prelude-text)
        (mut tree) (parse-file (mut k) text "rules_prelude.rules")]
    (push! (mut (.mods k)) (mod-new "hl.prelude" (SRules) ""))
    (set! (.src k) text)
    (for d (list-kids (kid tree 2))
      (when (= (.kind d) (g/KForeign)) (add-foreign! (mut k) d "hl.prelude")))))

;;; With HL_DUMP_DIR set, each module's generated Coil is also written there, for reading what a
;;; language made of a file.
(extern getenv :cc (cc/C) [(ptr i8)] (-> (ptr i8)))

(defn dump-generated! [(context Code) (text (slice u8))] (-> void)
  (let [dir (getenv c"HL_DUMP_DIR")]
    (unless (= (primitive/cast i64 dir) 0)
      (let [path (dsl/path-of context)
            (mut slash) -1]
        (for i (range 0 (len path)) (when (= (get path i) #\/) (set! slash i)))
        (fs/write-file (malloc-allocator)
                       (cat3 (str/from-cstr dir)
                             "/"
                             (subslice path (+ slash 1) (len path)))
                       text)
        0))))

;;; A `.rules` or `.attrs` file's module, as Coil text.
(defn rules-text [(context Code)] (-> (slice u8))
  (let [text (compile-module context)]
    (dump-generated! context text)
    text))

(defn read-rules [(context Code)] (-> Code)
  (primitive/code-read (rules-text context) `(reader-config)))
