;;; Runtime shared by everything the DSLs generate. It is ordinary Coil and also
;;; runs inside the readers at compile time: the same tokenizer reads the DSL
;;; files and the JavaScript. Nothing here touches Code.
;;;
;;; Allocation: a bundler build is one short batch process, so trees and strings
;;; live until exit, on malloc.
(module hl.rt)
(import "coil.alloc"
        :use
        [malloc-allocator overflow-arena-allocator box! Allocator AllocRequest alloc
         reallocate free create unwrap-ptr oom-at])
(import "coil.mem" :as mem)
(import "coil.math" :use [max min])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "coil.hashmap" :use [HashMap MapIter KeyOps Entry i64-keyops bytewise-hash])
(import "coil.str" :as str)
(import "coil.fs" :as fs)
(import "coil.io" :as io)
(import "coil.os" :as os)
(import "coil.path" :as cpath)
(import "coil.primitive" :as primitive)
(import "coil.unicode" :as u)
(import "coil.time"
        :use
        [monotonic-now-ms monotonic-now Instant sleep Duration])
(import "coil.thread"
        :use
        [Thread ThreadConfig available-parallelism current-id])
(import "coil.sync" :use [Mutex Condition])
(import "coil.atomic" :as atomic)
(import "coil.cc" :as cc)
(import "coil.socket" :use [TcpListener TcpConnection])
(import "coil.args" :as args)

;;; Memo values can be large records. Open-addressed slots should not reserve a
;;; multi-kilobyte payload for every empty bucket, in both global and worker caches.
;;; Large values live densely, indexed by the small hash table. Removed slots are
;;; reused; iteration visits only live keys. Small values retain direct hashing.
(defstruct MemoMap [K V]
  [(direct (HashMap K V)) (index (HashMap K i64))
   (values (ArrayList V)) (vacant (ArrayList i64))])

(impl [K V] (MemoMap K V)
  (new [(ops (ptr KeyOps))] (-> (MemoMap K V))
    (MemoMap :direct (HashMap::new [K V] (malloc-allocator) ops)
             :index (HashMap::new [K i64] (malloc-allocator) ops)
             :values (ArrayList::new [V] (malloc-allocator))
             :vacant (ArrayList::new [i64] (malloc-allocator))))
  (remove! [(m (mut (MemoMap K V))) (key K)] (-> i64)
    (if (> (primitive/sizeof V) 128)
        (match (get (.index m) key)
          (Some [at]
                (HashMap::remove! (mut (.index m)) key)
                (push! (mut (.vacant m)) at)
                1)
          (None [] 0))
        (HashMap::remove! (mut (.direct m)) key)))
  ;; Empty again, with the room it has.
  (clear! [(m (mut (MemoMap K V)))] (-> i64)
    (HashMap::clear! (mut (.direct m)))
    (HashMap::clear! (mut (.index m)))
    (clear! (mut (.values m)))
    (clear! (mut (.vacant m)))
    0)
  (free! [(m (mut (MemoMap K V)))] (-> i64)
    (free! (mut (.direct m)))
    (free! (mut (.index m)))
    (free! (mut (.values m)))
    (free! (mut (.vacant m)))
    0))

(impl [K V] Len (MemoMap K V)
  (len [(m (MemoMap K V))] (-> i64)
    (if (> (primitive/sizeof V) 128) (len (.index m)) (len (.direct m)))))

(impl [K V] Get (MemoMap K V)
  (get [(m (MemoMap K V)) (key K)] (-> (Option V))
    (if (> (primitive/sizeof V) 128)
        (match (get (.index m) key)
          (Some [at] (Some (get (.values m) at)))
          (None [] (None)))
        (get (.direct m) key))))

(impl [K V] Set (MemoMap K V)
  (set! [(m (mut (MemoMap K V))) (key K) (value V)] (-> i64)
    (if (> (primitive/sizeof V) 128)
        (match (get (.index m) key)
          (Some [at] (set! (mut (.values m)) at value) 0)
          (None []
                (let [at (match (pop! (mut (.vacant m)))
                           (Some [slot] (set! (mut (.values m)) slot value) slot)
                           (None []
                                 (let [slot (len (.values m))]
                                   (push! (mut (.values m)) value)
                                   slot)))]
                  (set! (mut (.index m)) key at)
                  1)))
        (set! (mut (.direct m)) key value))))

(defstruct MemoIter [K V] [(direct (MapIter K V)) (index (MapIter K i64))])

(impl [K V] Iterable (MemoMap K V)
  (iter [(m (MemoMap K V))] (-> (MemoIter K V))
    (MemoIter :direct (iter (.direct m)) :index (iter (.index m)))))

(impl [K V] Iterator (MemoIter K V)
  (next [(it (mut (MemoIter K V)))] (-> (Option K))
    (if (> (primitive/sizeof V) 128)
        (next (mut (.index it)))
        (next (mut (.direct it))))))

;;; ---------------------------------------------------------------- workers
;;; A program may run work on several threads. Each thread has a slot: 0 for the thread that
;;; started, 1… for workers. What must not be shared lives once per slot. There is no
;;; thread-local storage to lean on, so a thread finds its slot by its pthread id.

(defn max-workers [] (-> i64)
  64)

(extern pthread_key_create :cc (cc/C) [(ptr i64) (ptr i8)] (-> i32))

(extern pthread_setspecific :cc (cc/C) [i64 (ptr i8)] (-> i32))

(extern pthread_getspecific :cc (cc/C) [i64] (-> (ptr i8)))

;;; `key`: a thread-specific value holding the slot plus one, so no value means slot 0.
(defstruct Workers
  [(ready bool)
   (ids (ArrayList i64))
   (count i64)
   (key i64)
   (tree-key i64)
   (pass-key i64)])

;;; Called before any worker starts: from `main`, and from a reader at compile time.
(defn workers [] (-> (ptr Workers))
  (let [w (primitive/alloc-static Workers)]
    (unless (.ready w)
      (set! (.ids w) (ArrayList::new [i64] (malloc-allocator)))
      (for _ (range 0 (max-workers)) (push! (mut (.ids w)) 0))
      (set! (.count w) 1)
      (when (or (!= (pthread_key_create (field w key) (cast (ptr i8) 0))
                    (: 0 i32))
                (!= (pthread_key_create (field w tree-key) (cast (ptr i8) 0))
                    (: 0 i32))
                (!= (pthread_key_create (field w pass-key) (cast (ptr i8) 0))
                    (: 0 i32)))
        (panic "cannot make a thread-specific key"))
      (set! (.ready w) true))
    w))

;;; A thread-specific value of a program's own, for something each thread keeps: here, a pointer.
(defn key-new [] (-> i64)
  (let [(mut k) (: 0 i64)]
    (when (!= (pthread_key_create (cast (ptr i64) (mut k)) (cast (ptr i8) 0))
              (: 0 i32))
      (panic "cannot make a thread-specific key"))
    k))

(defn key-get :inline (Always) [(k i64)] (-> (ptr i8))
  (pthread_getspecific k))

(defn key-set! [(k i64) (v (ptr i8))] (-> void)
  (pthread_setspecific k v)
  0)

(defn worker-slot [] (-> i64)
  (let [v (primitive/cast i64 (pthread_getspecific (.key (workers))))]
    (if (= v 0) 0 (- v 1))))

;;; A worker thread says which slot it is, before it touches anything per slot.
(defn register-worker! [(slot i64)] (-> void)
  (let [w (workers)]
    (set! (mut (.ids w)) slot (current-id))
    (pthread_setspecific (.key w) (primitive/cast (ptr i8) (+ slot 1)))
    0))

;;; Slots 1..n-1 may be used from now on. Set by the thread that starts the workers.
(defn workers-in-use! [(n i64)] (-> void)
  (let [w (workers)]
    (when (> n (.count w)) (set! (.count w) n))
    0))

;;; A lock for the rare first touch of something per slot: a spin on one word.
;;; A lock on one word that a structure holds, for work queues: spin, then let others run.
(extern sched_yield :cc (cc/C) [] (-> i32))

;;; How often a thread gave its core away: waiting for a lock taken whole, to read beside others, or
;;; for an answer another thread is making. Counted always (a wait costs far more than counting it);
;;; shown with HL_LOCK_TRACE set (see `lock-trace-report!`).
(defstruct Yields [(whole i64) (beside i64) (answer i64)])

(defn yields [] (-> (ptr Yields))
  (primitive/alloc-static Yields))

(defn lock-looks :inline (Always) [] (-> i64) 4000)

;;; Taken only when it looks free: a thread that waits reads the word, which every waiter can do
;;; at once, and writes to it only to take it. Writing while it is held would pull the word from
;;; whoever holds it and from every other waiter, each time round.
(defn spin-lock! [(word (ptr i64))] (-> void)
  (let [(mut turns) 0]
    (while (or (!= (atomic/read word) 0) (!= (atomic/cas word 0 1) 0))
      ;; Whoever holds it may have lost its core: after a while, let it have this one. What is
      ;; done under such a lock takes well under the time giving a core away does, so the while
      ;; is some thousands of looks (`lock-looks`).
      (set! turns (+ turns 1))
      (when (> turns (lock-looks))
        (atomic/add (field (yields) whole) 1)
        (sched_yield)
        (set! turns 0))))
  0)

(defn spin-unlock! [(word (ptr i64))] (-> void)
  (atomic/store word 0)
  0)

;;; The same word read under by many at once: each reader adds two while it reads, so the word is
;;; even and above zero while only readers hold it, and whoever would take it whole (`spin-lock!`,
;;; which waits for zero and makes it one) waits for them, as they wait for it.
(defn read-lock! [(word (ptr i64))] (-> void)
  (let [(mut in) false
        (mut turns) 0]
    (while (not in)
      (let [v (atomic/read word)]
        (if (and (= (& v 1) 0) (= (atomic/cas word v (+ v 2)) v))
            (set! in true)
            (do
              (set! turns (+ turns 1))
              (when (> turns (lock-looks))
                (atomic/add (field (yields) beside) 1)
                (sched_yield)
                (set! turns 0)))))))
  0)

(defn read-unlock! [(word (ptr i64))] (-> void)
  (atomic/add word -2)
  0)

(defn pause! [] (-> void)
  (atomic/add (field (yields) answer) 1)
  (sched_yield)
  0)

;;; Static storage is per call site, so the lock's one word has one function to come from.
(defstruct InitLock [(word i64)])

(defn init-lock-word [] (-> (ptr i64))
  (primitive/cast (ptr i64) (primitive/alloc-static InitLock)))

(defn init-lock! [] (-> void)
  (spin-lock! (init-lock-word))
  0)

(defn init-unlock! [] (-> void)
  (atomic/store (init-lock-word) 0)
  0)

;;; Something made once, by whichever thread asks first, with a word of its own to say so (0 not
;;; made, 2 being made, 1 made): unlike the lock above, it may be asked for while that is held.
;;; Whether the asker is the one to make it; it says `once-made!` when it has.
(defn once-mine? [(word (ptr i64))] (-> bool)
  (cond (= (atomic/read word) 1) false
        (= (atomic/cas word 0 2) 0) true
        :else (do (while (!= (atomic/read word) 1) 0) false)))

(defn once-made! [(word (ptr i64))] (-> void)
  (atomic/store word 1)
  0)

;; ---------------------------------------------------------------- regions

;;; Values live in regions. A region is memory taken in chunks and given out by bumping a pointer,
;;; and is let go whole: nothing in it is freed on its own. Who holds a region is what the
;;; program already knows lives on: a memo's answer holds the region it was made in, a setting's
;;; value its own, a loop's turn at the top of the program its own. A region that holds a value
;;; from another region says so (`region-ref!`), so the other lives as long as it does. A region
;;; nothing holds is let go at a safe point (`regions-let-go!`), when no build runs and nothing on
;;; any stack points into it.
;;;
;;; A thread allocates through its cursor into the region on top of its stack (`value-allocator`).
;;; Each thread's stack starts with a region of its own that lives as long as the program, which
;;; is all a run that keeps nothing from one build to the next ever uses.

;;; A chunk's first word is the chunk before it in its region, its second its size in bytes.
(defn chunk-header-bytes [] (-> i64) 16)

;;; `count`: who holds the region and how many regions refer to it; when it falls to 0 the region
;;; waits in the queue to be let go. A lasting region (a thread's own) is never counted or let go.
;;; `refs`: the regions this one refers to, each once (`ref-seen` tells them apart).
(defstruct Region
  [(lock i64)
   (count i64)
   (lasting bool)
   (queued bool)
   (chunks i64)
   (bytes i64)
   (grow-limit i64)
   (refs (ArrayList i64))
   (ref-seen IntTable)
   (last-ref i64)
   (cursors (ArrayList i64))
   ;; A cursor any thread may allocate through, under `lock` (see `region-shared-allocator`).
   (shared i64)
   ;; What made it, for the trace (see `regions-labels`).
   (label (slice u8))
   ;; A scratch region's memory is stretches of the scratch space (see `scratch-space`), not
   ;; chunks of its own from the system: each stretch's start and size, in turn, and the free
   ;; bytes of the last, `space-at` up to `space-end`.
   (space bool)
   (stretches (ArrayList i64))
   (space-at i64)
   (space-end i64)
   ;; A setting's value's (see `setting-region-open!`): another setting's value copies what it
   ;; has of it rather than holding it, so no setting's region holds another's.
   (setting bool)])

;;; Where one thread allocates in one region: the free bytes of its current chunk, `at` up to
;;; `end`; the start of the last allocation, which can grow or be taken back in place; and the size
;;; of the next chunk.
(defstruct Cursor
  [(region (ptr Region)) (at i64) (end i64) (last i64) (grow i64)])

(defn region-make [(lasting bool) (grow-limit i64)] (-> (ptr Region))
  (let [r (unwrap-ptr (create [Region] (malloc-allocator)))]
    (store! r
            (Region
              :lock 0
              :count 1
              :lasting lasting
              :queued false
              :chunks 0
              :bytes 0
              :grow-limit grow-limit
              :refs (ArrayList::new [i64] (malloc-allocator))
              :ref-seen (int-table 0)
              :last-ref 0
              :cursors (ArrayList::new [i64] (malloc-allocator))
              :shared 0
              :label ""
              :space false
              :setting false
              :stretches (ArrayList::new [i64] (malloc-allocator))
              :space-at 0
              :space-end 0))
    r))

(defn cursor-make [(r (ptr Region))] (-> (ptr Cursor))
  (let [c (unwrap-ptr (create [Cursor] (malloc-allocator)))]
    (store! c (Cursor :region r :at 0 :end 0 :last 0 :grow 256))
    (spin-lock! (field r lock))
    (push! (mut (.cursors r)) (primitive/cast i64 c))
    (spin-unlock! (field r lock))
    c))

(defn align-to [(x i64) (a i64)] (-> i64)
  (& (+ x (- a 1)) (- 0 a)))

;;; A chunk of `size` bytes, its header filled, added to its region. Its first byte for values.
(defn chunk-add! [(r (ptr Region)) (size i64)] (-> i64)
  (if (.space r) (chunk-add-space! r size) (chunk-add-own! r size)))

;;; A scratch region's chunk: the next bytes of its last stretch of the scratch space, or of a
;;; new stretch when that has too few left.
(defn chunk-add-space! [(r (ptr Region)) (size i64)] (-> i64)
  (let [want (align-to size 16)]
    (spin-lock! (field r lock))
    (when (> (+ (.space-at r) want) (.space-end r))
      (let [took (stretch-size want)
            at (stretch-take! took)]
        (push! (mut (.stretches r)) at)
        (push! (mut (.stretches r)) took)
        (set! (.space-at r) at)
        (set! (.space-end r) (+ at took))))
    ;; The header is written once the lock is let go: its page is new, and the first write to
    ;; it waits for the system, which nobody else should wait behind. Nothing reads a region's
    ;; chunks while it is still being allocated in.
    (let [p (.space-at r)
          before (.chunks r)]
      (set! (.space-at r) (+ p want))
      (set! (.chunks r) p)
      (set! (.bytes r) (+ (.bytes r) want))
      (spin-unlock! (field r lock))
      (store! (primitive/cast (ptr i64) p) before)
      (store! (primitive/cast (ptr i64) (+ p 8)) want)
      (+ p (chunk-header-bytes)))))

(defn chunk-add-own! [(r (ptr Region)) (size i64)] (-> i64)
  (let [p (primitive/cast i64 (chunk-memory size))]
    (when (= p 0) (oom-at c"a region's chunk" size))
    ;; Its header is written outside the lock, as a scratch chunk's is.
    (spin-lock! (field r lock))
    (let [before (.chunks r)]
      (set! (.chunks r) p)
      (set! (.bytes r) (+ (.bytes r) size))
      (spin-unlock! (field r lock))
      (store! (primitive/cast (ptr i64) p) before)
      (store! (primitive/cast (ptr i64) (+ p 8)) size))
    (unless (.lasting r)
      (atomic/add (field (region-queue) bytes-made) size)
      (chunk-index-add! p size r))
    (+ p (chunk-header-bytes))))

(defn cursor-allocate :inline (Always) [(c (ptr Cursor)) (bytes i64) (align i64)] (-> (ptr i8))
  (let [p (align-to (.at c) align)]
    (if (and (> (.at c) 0) (<= (+ p bytes) (.end c)))
        (do (set! (.at c) (+ p bytes))
            (set! (.last c) p)
            (primitive/cast (ptr i8) p))
        (cursor-allocate-slow c bytes align))))

;;; A new chunk: one of its own for an allocation bigger than half the next chunk, which leaves
;;; the cursor where it was; else the next chunk, each twice the last up to the region's limit.
(defn cursor-allocate-slow [(c (ptr Cursor)) (bytes i64) (align i64)] (-> (ptr i8))
  (let [r (.region c)
        (mut grow) (.grow c)]
    ;; Small requests must advance a new cursor's growth too. Otherwise a stream
    ;; of 160-byte child arrays forever takes individual chunks at grow=256.
    (if (and (> (+ bytes align) (/ grow 2)) (> (+ bytes align) 4096))
        (let [base (chunk-add! r (+ bytes align (chunk-header-bytes)))]
          (primitive/cast (ptr i8) (align-to base align)))
        (do
          (while (< grow (+ bytes align (chunk-header-bytes))) (set! grow (* grow 2)))
          (let [base (chunk-add! r grow)
              p (align-to base align)]
          (set! (.end c) (+ base (- grow (chunk-header-bytes))))
          (set! (.at c) (+ p bytes))
          (set! (.last c) p)
          (when (< (* grow 2) (+ (.grow-limit r) 1)) (set! (.grow c) (* grow 2)))
          (primitive/cast (ptr i8) p))))))

(impl Allocator Cursor
  (allocate [(self (ptr Cursor)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (Some (cursor-allocate self
                                   (load (field request bytes))
                                   (load (field request align)))))
  ;; Only the last allocation grows in place; anything shrinks in place.
  (resize [(self (ptr Cursor))
           (memory (ptr i8))
           (old (ref AllocRequest))
           (new (ref AllocRequest))]
          (-> bool)
          (let [m (primitive/cast i64 memory)
                want (load (field new bytes))]
            (cond (<= want (load (field old bytes))) true
                  (and (= m (.last self)) (<= (+ m want) (.end self)))
                    (do (set! (.at self) (+ m want)) true)
                  :else false)))
  (remap [(self (ptr Cursor))
          (memory (ptr i8))
          (old (ref AllocRequest))
          (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (let [m (primitive/cast i64 memory)
               want (load (field new bytes))
               had (load (field old bytes))]
           (cond (<= want had) (Some memory)
                 (and (= m (.last self)) (<= (+ m want) (.end self)))
                   (do (set! (.at self) (+ m want)) (Some memory))
                 :else
                   (let [p (cursor-allocate self want (load (field new align)))]
                     (mem/copy [u8] (primitive/cast (ptr u8) p) (primitive/cast (ptr u8) memory) had)
                     (Some p)))))
  ;; Memory goes back with its region, never on its own: a place once given out is never given
  ;; out again while the region lives, so what knows values by where they are (the cache's writer)
  ;; is told only when regions are let go.
  (deallocate [(self (ptr Cursor))
               (memory (ptr i8))
               (request (ref AllocRequest))]
              (-> i64)
              0))

;;; A cursor any thread may use, one at a time: for a value that changes after it is made, from
;;; whichever thread changes it (a relation, as it is indexed), whose memory is its region's.
(defstruct SharedCursor [(lock i64) (cursor Cursor)])

(impl Allocator SharedCursor
  (allocate [(self (ptr SharedCursor)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (spin-lock! (field self lock))
            (let [p (cursor-allocate (field self cursor)
                                     (load (field request bytes))
                                     (load (field request align)))]
              (spin-unlock! (field self lock))
              (Some p)))
  (resize [(self (ptr SharedCursor))
           (memory (ptr i8))
           (old (ref AllocRequest))
           (new (ref AllocRequest))]
          (-> bool)
          (<= (load (field new bytes)) (load (field old bytes))))
  (remap [(self (ptr SharedCursor))
          (memory (ptr i8))
          (old (ref AllocRequest))
          (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (let [want (load (field new bytes))
               had (load (field old bytes))]
           (if (<= want had)
               (Some memory)
               (do
                 (spin-lock! (field self lock))
                 (let [p (cursor-allocate (field self cursor) want (load (field new align)))]
                   (spin-unlock! (field self lock))
                   (mem/copy [u8] (primitive/cast (ptr u8) p) (primitive/cast (ptr u8) memory) had)
                   (Some p))))))
  (deallocate [(self (ptr SharedCursor))
               (memory (ptr i8))
               (request (ref AllocRequest))]
              (-> i64)
              0))

(defn region-shared-allocator [(r (ptr Region))] (-> (dyn Allocator))
  (spin-lock! (field r lock))
  (when (= (.shared r) 0)
    (let [c (unwrap-ptr (create [SharedCursor] (malloc-allocator)))]
      (store! c (SharedCursor :lock 0 :cursor (Cursor :region r :at 0 :end 0 :last 0 :grow 1024)))
      (set! (.shared r) (primitive/cast i64 c))))
  (spin-unlock! (field r lock))
  (primitive/make-dyn Allocator (primitive/cast (ptr SharedCursor) (.shared r))))

;;; Where a value that keeps changing after it is made keeps its memory: its region's, through a
;;; cursor any thread may use, while the run reclaims memory; else malloc, as long as the program.
(defn owned-allocator [] (-> (dyn Allocator))
  (let [r (region-current)]
    (if (and (reclaiming?) (not (.lasting r)))
        (region-shared-allocator r)
        (malloc-allocator))))

;;; A thread's stack of regions: where its values go is the allocator on top, into `region`. The
;;; stack holds each entered region with its allocator's state and whether that is a shared cursor.
(defstruct ThreadRegions [(top (dyn Allocator)) (region (ptr Region)) (stack (ArrayList i64)) (scratch i64)
                          ;; The regions of the `var`s this thread holds values in (see
                          ;; `var-region-open!`); and, while a setting's value is copied, the
                          ;; regions it copies from (see `setting-region-open!`).
                          (vars (ArrayList i64))
                          (copy-from (ArrayList i64))
                          ;; How many computations working apart (see `apart-enter!`) enclose what this
                          ;; thread does now: what it is handed may be let go when they answer.
                          (apart i64)
                          ;; The text this thread last asked the kept texts for: a key goes
                          ;; into several tables in a row.
                          (kept-last (slice u8))
                          ;; Whether this thread is doing one of a run of jobs done at once
                          ;; (`run-workers`): the thread that started the run too.
                          (in-job i64)
                          ;; While this thread helps with another's job (`run-map-workers`):
                          ;; that thread's worker slot, plus one, whose own settings it reads.
                          (settings-view i64)
                          ;; Which element of a map this thread is working on now.
                          (item i64)
                          (name-notes i64)
                          ;; For a worker that looks for offers of work between the items of
                          ;; a run of its own (`help-wanted?`): how many offers had been made
                          ;; when it last found none to take, and the offer it last took from
                          ;; each place.
                          (help-seq i64)
                          (help-took (ArrayList i64))])

;;; The thread-specific key of the threads' region stacks, plus one, as each place that asks keeps
;;; it: the key never changes once made, so a place asks `workers` only the first time.
(defstruct TreeKeySeen [(key1 i64)])

(defn tree-key-from! [(seen (ptr i64))] (-> i64)
  (let [k (.tree-key (workers))]
    (atomic/store seen (+ k 1))
    k))

(defn thread-regions :inline (Always) [] (-> (ptr ThreadRegions))
  (let [seen (primitive/cast (ptr i64) (primitive/alloc-static TreeKeySeen))
        key1 (atomic/read seen)
        key (if (= key1 0) (tree-key-from! seen) (- key1 1))
        found (pthread_getspecific key)]
    (if (= (primitive/cast i64 found) 0)
        (thread-regions-new)
        (primitive/cast (ptr ThreadRegions) found))))

;;; A thread's first region: its own, as long as the program runs. Its chunks grow to 4 MB, so a
;;; build that keeps everything takes few of them.
(defn thread-regions-new [] (-> (ptr ThreadRegions))
  (let [t (unwrap-ptr (create [ThreadRegions] (malloc-allocator)))
        r (region-make true 4194304)
        c (cursor-make r)]
    (store! t (ThreadRegions :top (primitive/make-dyn Allocator c)
                             :region r
                             :stack (ArrayList::new [i64] (malloc-allocator)) :scratch 0 :apart 0
                             :vars (ArrayList::new [i64] (malloc-allocator))
                             :copy-from (ArrayList::new [i64] (malloc-allocator))
                             :kept-last "" :in-job 0 :settings-view 0 :item 0 :name-notes 0
                             :help-seq 0 :help-took (ArrayList::new [i64] (malloc-allocator))))
    (push! (mut (.stack t)) (primitive/cast i64 r))
    (push! (mut (.stack t)) (primitive/cast i64 c))
    (push! (mut (.stack t)) 0)
    (pthread_setspecific (.tree-key (workers)) (primitive/cast (ptr i8) t))
    t))

;;; Where values go on this thread: the region on top of its stack.
(defn value-allocator :inline (Always) [] (-> (dyn Allocator))
  (.top (thread-regions)))

(defn tree-allocator :inline (Always) [] (-> (dyn Allocator))
  (value-allocator))

(defn region-current [] (-> (ptr Region))
  (.region (thread-regions)))

;;; The thread's allocator as the top of its stack says.
(defn thread-regions-top! [(t (ptr ThreadRegions))] (-> void)
  (let [n (len (.stack t))
        r (primitive/cast (ptr Region) (get (.stack t) (- n 3)))
        state (get (.stack t) (- n 2))
        shared (get (.stack t) (- n 1))]
    (set! (.region t) r)
    (set! (.top t)
          (if (= shared 1)
              (primitive/make-dyn Allocator (primitive/cast (ptr SharedCursor) state))
              (primitive/make-dyn Allocator (primitive/cast (ptr Cursor) state))))
    0))

;;; This thread's own cursor into the region on top of its stack, as an address, when values go
;;; through one, and not through a cursor threads share: 0 then.
(defn top-cursor [] (-> i64)
  (let [t (thread-regions)
        n (len (.stack t))]
    (if (= (get (.stack t) (- n 1)) 0) (get (.stack t) (- n 2)) 0)))

;;; A region for values that will be held: by whoever made it, until they let it go.
(defn region-new [] (-> (ptr Region))
  (atomic/add (field (region-queue) made) 1)
  (region-make false 65536))

;;; Values made on this thread go to `r`, until `region-leave!`.
(defn region-enter! [(r (ptr Region))] (-> void)
  (let [t (thread-regions)
        c (cursor-make r)]
    (push! (mut (.stack t)) (primitive/cast i64 r))
    (push! (mut (.stack t)) (primitive/cast i64 c))
    (push! (mut (.stack t)) 0)
    (thread-regions-top! t)
    0))

;;; Values made on this thread go to `r` through its shared cursor, until `region-leave!`: for what
;;; any thread may grow later.
(defn region-enter-shared! [(r (ptr Region))] (-> void)
  (let [t (thread-regions)]
    (region-shared-allocator r)
    (push! (mut (.stack t)) (primitive/cast i64 r))
    (push! (mut (.stack t)) (.shared r))
    (push! (mut (.stack t)) 1)
    (thread-regions-top! t)
    0))

(defn region-leave! [] (-> void)
  (let [t (thread-regions)]
    (when (<= (len (.stack t)) 3) (panic "a region was left that was never entered"))
    (pop! (mut (.stack t)))
    (pop! (mut (.stack t)))
    (pop! (mut (.stack t)))
    (thread-regions-top! t)
    0))

;;; An isolated computation's scratch arena. Nothing in it may escape: the caller
;;; leaves it, copies its result into its parent's allocator, then disposes it.
;;; Unlike retained answer regions it never enters the dependency/cache lifetime graph.
;;; Its memory is stretches of the scratch space, so whether a value lies in it is asked of
;;; its address alone (`scratch-holds?`).
(defn scratch-enter! [] (-> (ptr Region))
  (let [t (thread-regions)
        saved (.scratch t)
        r (if (= saved 0)
              (let [made (region-make true 4194304)]
                (set! (.space made) true)
                made)
              (primitive/cast (ptr Region) saved))]
    ;; Remove it before entering: nested scratch computations need distinct storage.
    (set! (.scratch t) 0)
    (region-enter! r)
    (set! (.grow (primitive/cast (ptr Cursor) (get (.stack t) (- (len (.stack t)) 2)))) 65536)
    r))

(defn scratch-dispose! [(r (ptr Region))] (-> void)
  (when (or (= r (region-current)) (!= (len (.refs r)) 0))
    (panic "scratch region is still entered or owns retained references"))
  (let [t (thread-regions)
        ;; A thread keeps one scratch region with its first stretch, for the next computation.
        ;; Poisoning deliberately bypasses reuse to detect escapes.
        reuse (and (not (region-check?)) (= (.scratch t) 0) (>= (len (.stretches r)) 2)
                   (= (get (.stretches r) 1) (stretch-unit)))
        count (/ (len (.stretches r)) 2)]
    (for i (range 0 count)
      (let [at (get (.stretches r) (* i 2))
            size (get (.stretches r) (+ (* i 2) 1))
            used (if (= i (- count 1)) (- (.space-at r) at) size)]
        (if (and reuse (= i 0))
            (stretch-trim! at used)
            (stretch-give! at size used))))
    (for c (.cursors r) (primitive/free (primitive/cast (ptr i8) c)))
    (clear! (mut (.cursors r)))
    (when (!= (.shared r) 0) (primitive/free (primitive/cast (ptr i8) (.shared r))))
    (set! (.shared r) 0)
    (set! (.chunks r) 0)
    (set! (.bytes r) 0)
    (if reuse
        (let [at (get (.stretches r) 0)
              size (get (.stretches r) 1)]
          (clear! (mut (.stretches r)))
          (push! (mut (.stretches r)) at)
          (push! (mut (.stretches r)) size)
          (set! (.space-at r) at)
          (set! (.space-end r) (+ at size))
          (set! (.scratch t) (primitive/cast i64 r)))
        (do (free! (mut (.refs r)))
            (free! (mut (.cursors r)))
            (free! (mut (.stretches r)))
            (free! (mut (.keys (.ref-seen r))))
            (free! (mut (.vals (.ref-seen r))))
            (primitive/free (primitive/cast (ptr i8) r)))))
  0)

;;; Whether the byte at `p` is in scratch region `r`; in any scratch region at all, for `r` 0.
(defn scratch-holds? [(r (ptr Region)) (p i64)] (-> bool)
  (if (= (primitive/cast i64 r) 1)
      (copy-from-holds? p)
      (scratch-only-holds? r p)))

(defn scratch-only-holds? [(r (ptr Region)) (p i64)] (-> bool)
  (and (scratch-space-holds? p)
       (or (= (primitive/cast i64 r) 0)
           (let [(mut found) false
                 n (len (.stretches r))
                 (mut i) 0]
             (while (and (not found) (< i n))
               (let [at (get (.stretches r) i)]
                 (when (and (>= p at) (< p (+ at (get (.stretches r) (+ i 1)))))
                   (set! found true)))
               (set! i (+ i 2)))
             found))))

;; ---------------------------------------------------------------- kept texts
;;;
;;; The tables that keep answers are keyed by texts, a file's path as often as not, and one path
;;; keys many tables: each function kept for it, on each thread. A table that copied its keys had
;;; a copy apiece. These tables take their keys from here instead: the program's one copy of each
;;; text, never let go, so a key is a view of it and costs its table nothing.
;;;
;;; A run that reclaims memory makes keys without end (what it keeps changes from build to
;;; build), and its tables copy and free their own (`memo-keyops`).

(defstruct KeptTexts [(lock i64) (texts (HashMap (slice u8) (slice u8)))])

(defstruct KeptTextsAll [(ready i64) (parts (ArrayList KeptTexts))])

(defn kept-texts [] (-> (ptr KeptTextsAll))
  (let [all (primitive/alloc-static KeptTextsAll)]
    (when (once-mine? (field all ready))
      (let [(mut parts) (ArrayList::new [KeptTexts] (malloc-allocator))]
        ;; In parts, each with its lock: many threads keep texts at once.
        (for _ (range 0 64)
          (push! (mut parts)
                 (KeptTexts :lock 0
                            :texts (HashMap::new [(slice u8) (slice u8)]
                                                 (malloc-allocator)
                                                 (str/keyops-borrowed)))))
        (set! (.parts all) parts))
      (once-made! (field all ready)))
    all))

;;; A text's hash, eight bytes at a time: which part of the kept texts holds it.
(defn text-hash [(s (slice u8))] (-> i64)
  (let [n (len s)
        p (data s)
        (mut h) (^ n -7046029254386353131)
        (mut i) 0]
    (while (<= (+ i 8) n)
      (set! h (memo-hash (^ h (load (primitive/cast (ptr i64) (primitive/index p i))))))
      (set! i (+ i 8)))
    (while (< i n)
      (set! h (memo-hash (^ h (cast i64 (get s i)))))
      (set! i (+ i 1)))
    h))

;;; The program's own copy of `s`: the same bytes for the same text, as long as it runs.
(defn kept-text [(s (slice u8))] (-> (slice u8))
  (let [t (thread-regions)]
    (cond (= (len s) 0) ""
          (= (.kept-last t) s) (.kept-last t)
          :else
            (let [all (kept-texts)
                  part (elem (mut (.parts all)) (& (text-hash s) 63))]
              (spin-lock! (field part lock))
              (let [kept
                      (match (get (.texts part) s)
                        (Some [k] k)
                        (None []
                              (let [own (own-text s)]
                                (set! (mut (.texts part)) own own)
                                own)))]
                (spin-unlock! (field part lock))
                (set! (.kept-last t) kept)
                kept)))))

(defn kept-key-copy [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  (let [at (primitive/cast (ptr (slice u8)) slot)]
    (store! at (kept-text (load at)))
    0))

;;; A kept text is the program's, not the table's that is done with it.
(defn kept-key-free [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  0)

(defstruct KeptKeyOps [(ready i64) (ops KeyOps)])

;;; A text key's hash for a table: eight bytes at a time (`text-hash`). Keys here are often a
;;; file's whole path, and are hashed for every table that has them.
(defn text-key-hash [(slot (ptr i8)) (n i64)] (-> i64)
  (text-hash (load (primitive/cast (ptr (slice u8)) slot))))

;;; A table's own copies of its text keys, as `str/keyops` keeps them, hashed as above.
(defn text-keyops [] (-> (ptr KeyOps))
  (let [c (text-keyops-cell)]
    (when (once-mine? (field c ready))
      (let [base (load (str/keyops))]
        (set! (.ops c)
              (KeyOps :hash (primitive/fnptr-of text-key-hash)
                      :eq (.eq base)
                      :size (.size base)
                      :copy (.copy base)
                      :free (.free base)
                      :owns 1)))
      (once-made! (field c ready)))
    (field c ops)))

(defn text-keyops-cell [] (-> (ptr KeptKeyOps))
  (primitive/alloc-static KeptKeyOps))

;;; A text key's hash and equality as every table's, with these in place of copying and freeing.
(defn kept-keyops [] (-> (ptr KeyOps))
  (let [c (primitive/alloc-static KeptKeyOps)]
    (when (once-mine? (field c ready))
      (let [base (load (str/keyops))]
        (set! (.ops c)
              (KeyOps :hash (primitive/fnptr-of text-key-hash)
                      :eq (.eq base)
                      :size (.size base)
                      :copy (primitive/fnptr-of kept-key-copy)
                      :free (primitive/fnptr-of kept-key-free)
                      :owns 1)))
      (once-made! (field c ready)))
    (field c ops)))

;;; How a table of kept answers holds its Text keys: views of kept texts; or, in a run that
;;; reclaims memory, copies of its own that go when it lets them go.
;;; Text keys a table only looks at: whoever fills it keeps each text for as long as the table.
(defn held-key-copy [(ap (ptr (dyn Allocator))) (slot (ptr i8))] (-> i64)
  0)

(defn held-keyops [] (-> (ptr KeyOps))
  (let [c (primitive/alloc-static HeldKeyOps)]
    (when (once-mine? (field c ready))
      (let [base (load (str/keyops))]
        (set! (.ops c)
              (KeyOps :hash (primitive/fnptr-of text-key-hash)
                      :eq (.eq base)
                      :size (.size base)
                      :copy (primitive/fnptr-of held-key-copy)
                      :free (primitive/fnptr-of kept-key-free)
                      :owns 1)))
      (once-made! (field c ready)))
    (field c ops)))

(defstruct HeldKeyOps [(ready i64) (ops KeyOps)])

(defn memo-keyops [] (-> (ptr KeyOps))
  (if (reclaiming?) (text-keyops) (kept-keyops)))

;; ---------------------------------------------------------------- values out of scratch storage
;;;
;;; A value leaves scratch storage by its own copy of whatever part of it lies there, and no
;;; more: what it holds from outside (a tree some kept answer made, a file's text) it goes on
;;; holding. A container outside scratch storage holds nothing inside it, since nothing made
;;; before a computation can point at what the computation makes; so a copy stops at the first
;;; container that is outside. `from` is the scratch region left, or 0 for every scratch
;;; region there is.

(defn any-scratch [] (-> (ptr Region))
  (primitive/cast (ptr Region) 0))

;;; One copy out, on one thread: a container reached twice is copied once, and the value still
;;; holds one container in two places. `seen` has each copied container's old memory, and where
;;; in `kept` its copy (the list's or map's own few words, or a boxed record's address) was put.
(defstruct OwnCopies [(ready bool) (depth i64) (seen IntTable) (kept (ArrayList u8))])

(defn own-copies [] (-> (ptr OwnCopies))
  (let [slot (worker-slot)
        all (own-copies-all)]
    (elem (mut (.slots all)) slot)))

(defstruct OwnCopiesAll [(ready i64) (slots (ArrayList OwnCopies))])

(defn own-copies-all [] (-> (ptr OwnCopiesAll))
  (let [all (primitive/alloc-static OwnCopiesAll)]
    (when (once-mine? (field all ready))
      (let [(mut slots) (ArrayList::new [OwnCopies] (malloc-allocator))]
        (for _ (range 0 (max-workers))
          (push! (mut slots)
                 (OwnCopies :ready true
                            :depth 0
                            :seen (int-table 0)
                            :kept (ArrayList::new [u8] (malloc-allocator)))))
        (set! (.slots all) slots))
      (once-made! (field all ready)))
    all))

;;; A copy out begins and ends; what it noted is forgotten when the outermost ends.
(defn own-begin! [] (-> i64)
  (let [c (own-copies)]
    (set! (.depth c) (+ (.depth c) 1))
    0))

(defn own-end! [] (-> void)
  (let [c (own-copies)]
    (set! (.depth c) (- (.depth c) 1))
    (when (and (= (.depth c) 0) (> (.count (.seen c)) 0))
      (free! (mut (.keys (.seen c))))
      (free! (mut (.vals (.seen c))))
      (set! (.seen c) (int-table 0))
      (if (> (cap (.kept c)) 65536)
          (do (free! (mut (.kept c)))
              (set! (.kept c) (ArrayList::new [u8] (malloc-allocator))))
          (clear! (mut (.kept c)))))
    0))

;;; Where the copy of the container whose memory is at `storage` was kept, or nothing.
(defn own-seen [(storage i64)] (-> (ptr u8))
  (let [c (own-copies)
        at (if (= storage 0) -1 (int-get (mut (.seen c)) storage))]
    (if (< at 0)
        (primitive/cast (ptr u8) 0)
        (primitive/index (data (slice (.kept c))) at))))

;;; The container whose memory was at `storage` has this copy, `size` bytes at `value`.
(defn own-keep! [(storage i64) (value (ptr u8)) (size i64)] (-> void)
  (when (!= storage 0)
    (let [c (own-copies)
          at (align-to (len (.kept c)) 8)]
      (ArrayList::extend-zeroed! (mut (.kept c)) (- (+ at size) (len (.kept c))))
      (mem/copy [u8] (primitive/index (data (slice (.kept c))) at) value size)
      (int-put! (mut (.seen c)) storage at)))
  0)

;;; Whether a container whose memory is at `storage` is copied: its memory is in scratch
;;; storage, or it has none yet, and would take its first from an allocator that may be gone.
(defn storage-in? :inline (Always) [(from (ptr Region)) (storage i64) (capacity i64)] (-> bool)
  (or (= capacity 0) (scratch-holds? from storage)))

(defn list-storage [T] [(xs (ArrayList T))] (-> i64)
  (primitive/cast i64 (data (slice xs))))

(defn map-storage [K V] [(m (HashMap K V))] (-> i64)
  (primitive/cast i64 (.slots m)))

(defn map-capacity [K V] [(m (HashMap K V))] (-> i64)
  (.cap m))

;;; A map whose keys and values are numbers and truths, copied whole into storage of `a`: its
;;; slots as they are, so the copy answers as the first does and gives its keys in the same
;;; order, with no key hashed or placed again.
(defn map-copy-plain [K V] [(m (HashMap K V)) (a (dyn Allocator))] (-> (HashMap K V))
  (let [(mut out) (HashMap::new [K V] a (.ops m))]
    (when (> (.cap m) 0)
      (HashMap::grow! (mut out) (.cap m))
      (when (!= (.cap out) (.cap m))
        (panic "a map's copy has room for {} where the map has {}" (.cap out) (.cap m)))
      (mem/copy [(Entry K V)] (.slots out) (.slots m) (.cap m))
      (set! (.len out) (.len m))
      (set! (.tombs out) (.tombs m)))
    out))

(defn text-own-in [(from (ptr Region)) (s (slice u8))] (-> (slice u8))
  (if (and (> (len s) 0) (scratch-holds? from (primitive/cast i64 (data s))))
      (text-copy s)
      s))

(defn ints-own-in [(from (ptr Region)) (xs (ArrayList i64))] (-> (ArrayList i64))
  (if (storage-in? from (list-storage xs) (cap xs))
      (let [seen (if (< (len xs) 64) (primitive/cast (ptr u8) 0) (own-seen (list-storage xs)))]
        (if (and (!= (primitive/cast i64 seen) 0)
                 (= (len (load (primitive/cast (ptr (ArrayList i64)) seen))) (len xs)))
            (load (primitive/cast (ptr (ArrayList i64)) seen))
            (let [(mut out) (ArrayList::new [i64] (value-allocator))]
              (reserve! (mut out) (len xs))
              (for x xs (push! (mut out) x))
              ;; A short list of numbers is as cheap to copy again as to look up.
              (when (>= (len xs) 64)
                (own-keep! (list-storage xs) (primitive/cast (ptr u8) (mut out)) (sizeof (ArrayList i64))))
              out)))
      xs))

(defn texts-own-in [(from (ptr Region)) (xs (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (if (storage-in? from (list-storage xs) (cap xs))
      (let [(mut out) (ArrayList::new [(slice u8)] (value-allocator))]
        (reserve! (mut out) (len xs))
        (for x xs (push! (mut out) (text-own-in from x)))
        out)
      xs))

;;; What the runtime keeps on its own memory is no part of any scratch storage.
(defn apart-own-Names [(from (ptr Region)) (v Names)] (-> Names) v)
(defn apart-own-Places [(from (ptr Region)) (v Places)] (-> Places) v)
(defn apart-own-Ranks [(from (ptr Region)) (v Ranks)] (-> Ranks) v)

;;; A printer and a buffer are written to in place: not values a computation answers with.
(defn apart-own-W [(from (ptr Region)) (v W)] (-> W)
  (panic "a printer is not a value: it cannot be an answer or an argument of a computation working apart"))

(defn apart-own-Buf [(from (ptr Region)) (v Buf)] (-> Buf)
  (panic "a buffer is not a value: it cannot be an answer or an argument of a computation working apart"))

;; ---------------------------------------------------------------- working apart
;;;
;;; A function a run's strategy has work apart (`apart` in the pipeline language) makes what it
;;; makes in storage of its own; its answer is copied out and the rest let go, at once. A build
;;; that runs once keeps nothing else it made on the way.
;;;
;;; While such a computation is open on a thread, whatever is meant to outlive it is made in the
;;; thread's own lasting storage instead (`lasting-enter!`): a kept function's answer, from the
;;; store's own copy of its arguments, and a setting's value. So nothing that lasts points into
;;; storage that is let go. Workers started meanwhile work in their own lasting storage, and are
;;; told that what they are handed may not last (`apart-inherit!`).

(defn apart-open? :inline (Always) [] (-> bool)
  (> (.apart (thread-regions)) 0))

(defn apart-enter! [] (-> (ptr Region))
  (let [r (scratch-enter!)
        t (thread-regions)]
    (set! (.apart t) (+ (.apart t) 1))
    r))

;;; The computation is done: values go where they went before it. Its storage is still there,
;;; for its answer to be copied from, until `scratch-dispose!`.
(defn apart-leave! [] (-> void)
  (let [t (thread-regions)]
    (when (< (.apart t) 1) (panic "a computation apart was left that was never entered"))
    (region-leave!)
    (set! (.apart t) (- (.apart t) 1))
    0))

;;; What is made from here on, on this thread, lasts: until `lasting-leave!` values go to the
;;; thread's first region, and nothing is apart. How many computations apart were open (0: none,
;;; and nothing changed).
(defn lasting-enter! [] (-> i64)
  (let [t (thread-regions)
        open (.apart t)]
    (when (> open 0)
      (let [region (get (.stack t) 0)
            state (get (.stack t) 1)
            shared (get (.stack t) 2)]
        (push! (mut (.stack t)) region)
        (push! (mut (.stack t)) state)
        (push! (mut (.stack t)) shared)
        (thread-regions-top! t)
        (set! (.apart t) 0)))
    open))

(defn lasting-leave! [(open i64)] (-> i64)
  (when (> open 0)
    (region-leave!)
    (set! (.apart (thread-regions)) open))
  0)

;;; A worker's job starts and ends: while whoever started the run works apart, so does the worker,
;;; as far as what it is handed goes.
(defn apart-inherit! [(open i64)] (-> void)
  (set! (.apart (thread-regions)) (if (> open 0) 1 0))
  0)

;;; Which functions the run's strategy has work apart, by their numbers.
(defstruct ApartState [(chosen bool) (on (ArrayList bool))])

(defn apart-state [] (-> (ptr ApartState))
  (primitive/alloc-static ApartState))

(defn apart-only! [(count i64) (on (ArrayList i64))] (-> void)
  (let [s (apart-state)
        (mut flags) (ArrayList::new [bool] (malloc-allocator))]
    (for _ (range 0 count) (push! (mut flags) false))
    (for i on (set! (mut flags) i true))
    (set! (.on s) flags)
    (set! (.chosen s) true)
    0))

;;; Does this run have function `index` work apart? Never while the run reclaims memory or tracks
;;; what answers were made from: there each answer has a region of its own already.
(defn apart? [(index i64)] (-> bool)
  (let [s (apart-state)]
    (and (.chosen s) (get (.on s) index) (not (reclaiming?)) (not (dep-tracking?)))))

;;; The program's state (its modules' defaults, what the runtime keeps of values), made while this
;;; thread is in the program's own region: as long as the program, grown by any thread.
(defstruct StateRegion [(region i64)])

(defn state-region [] (-> (ptr Region))
  (let [o (primitive/alloc-static StateRegion)]
    (when (= (.region o) 0)
      (init-lock!)
      (when (= (.region o) 0) (set! (.region o) (primitive/cast i64 (region-make true 4194304))))
      (init-unlock!))
    (primitive/cast (ptr Region) (.region o))))

(defn state-region-enter! [] (-> void)
  (region-enter-shared! (state-region)))

(defn region-hold! [(r (ptr Region))] (-> void)
  (unless (.lasting r) (atomic/add (field r count) 1))
  0)

;;; One holder fewer; with none left, the region waits to be let go.
(defn region-release! [(r (ptr Region))] (-> void)
  (unless (.lasting r)
    (let [was (atomic/add (field r count) -1)]
      (cond (= was 1) (regions-queue! r)
            (< was 1) (panic "a region was let go more often than it was held"))))
  0)

;;; `from` holds a value of `to`'s: `to` lives at least as long as `from`.
(defn region-ref! [(from (ptr Region)) (to (ptr Region))] (-> void)
  (unless (or (.lasting to) (= (primitive/cast i64 from) (primitive/cast i64 to))
              (.lasting from) (= (.last-ref from) (primitive/cast i64 to)))
    (let [key (primitive/cast i64 to)]
      (spin-lock! (field from lock))
      (when (< (int-get (mut (.ref-seen from)) key) 0)
        (int-put! (mut (.ref-seen from)) key 1)
        (push! (mut (.refs from)) key)
        (region-hold! to))
      (set! (.last-ref from) key)
      (spin-unlock! (field from lock))))
  0)

;;; What this thread is making holds a value of `to`'s.
(defn region-uses! [(to (ptr Region))] (-> void)
  (region-ref! (region-current) to))

;;; Regions waiting to be let go; and how many were made and let go, and their bytes, for the trace.
(defstruct RegionQueue [(lock i64) (ready bool) (waiting (ArrayList i64)) (let-go i64) (bytes-let-go i64)
                        (made i64) (bytes-made i64)])

(defn region-queue [] (-> (ptr RegionQueue))
  (let [q (primitive/alloc-static RegionQueue)]
    (unless (.ready q)
      (init-lock!)
      (unless (.ready q)
        (set! (.waiting q) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.ready q) true))
      (init-unlock!))
    q))

(defn regions-queue! [(r (ptr Region))] (-> void)
  (let [q (region-queue)]
    (spin-lock! (field q lock))
    (when (.queued r) (spin-unlock! (field q lock)) (panic "a region was queued twice"))
    (set! (.queued r) true)
    (push! (mut (.waiting q)) (primitive/cast i64 r))
    (spin-unlock! (field q lock))
    0))

;;; Every region nothing holds, let go, and so whatever only they held: at a safe point only, when
;;; no build runs and no value on any stack is in one of them. What was let go, as (start, end)
;;; pairs of addresses, for what knows values by where they are (the cache's writer).
(defn regions-let-go! [] (-> (ArrayList i64))
  (let [q (region-queue)
        (mut ranges) (ArrayList::new [i64] (malloc-allocator))
        (mut n) 0]
    (spin-lock! (field q lock))
    (while (> (len (.waiting q)) 0)
      (let [r (primitive/cast (ptr Region) (match (pop! (mut (.waiting q))) (Some [x] x) (None [] 0)))]
        (spin-unlock! (field q lock))
        (when (!= (atomic/read (field r count)) 0)
          (panic "a region was let go while something held it"))
        (when (region-labels?) (regions-live-remove! r))
        (for to (.refs r) (region-release! (primitive/cast (ptr Region) to)))
        (let [(mut at) (.chunks r)]
          (while (!= at 0)
            (let [before (load (primitive/cast (ptr i64) at))
                  size (load (primitive/cast (ptr i64) (+ at 8)))]
              (push! (mut ranges) at)
              (push! (mut ranges) (+ at size))
              ;; Checking, with HL_REGION_GONE set: each chunk let go and what made its region,
              ;; so an address a stale read faults on names the region that held it.
              (when (and (region-check?) (env-on? "HL_REGION_GONE"))
                (eprintln "[region gone] {} {} {}" at (+ at size) (.label r)))
              (unless (.lasting r) (chunk-index-remove! at size))
              (chunk-let-go! at size)
              (set! at before))))
        (set! (.bytes-let-go q) (+ (.bytes-let-go q) (.bytes r)))
        (for c (.cursors r) (primitive/free (primitive/cast (ptr i8) c)))
        (when (!= (.shared r) 0) (primitive/free (primitive/cast (ptr i8) (.shared r))))
        (free! (mut (.refs r)))
        (free! (mut (.cursors r)))
        (free! (mut (.keys (.ref-seen r))))
        (free! (mut (.vals (.ref-seen r))))
        (primitive/free (primitive/cast (ptr i8) r))
        (set! n (+ n 1))
        (spin-lock! (field q lock))))
    (set! (.let-go q) (+ (.let-go q) n))
    (spin-unlock! (field q lock))
    ranges))

;;; Whether this run lets go of what it no longer needs: while watching, answers live in regions
;;; of their own, and each build's end is a safe point. Else every value lives as long as the
;;; program, which ends soon.
(defstruct Reclaim [(on bool)])

;;; Static storage is per call site: the switch has one place, found through this.
(defn reclaim-cell [] (-> (ptr Reclaim))
  (primitive/alloc-static Reclaim))

(defn reclaiming? :inline (Always) [] (-> bool)
  (.on (reclaim-cell)))

;;; With HL_RECLAIM_OFF set, a watcher keeps everything, as a run that builds once does: to tell
;;; what reclaiming changes from what it does not.
(defn reclaim! [] (-> void)
  (unless (env-on? "HL_RECLAIM_OFF") (set! (.on (reclaim-cell)) true))
  0)

;;; A memo's answer is made in a region of its own, held by the memo's table from then on (and so
;;; a setting's value, a key's arguments, a var's value), `label` saying what made it. 0 when the
;;; run reclaims nothing.
(defn answer-region-open! [(label (slice u8))] (-> i64)
  (if (reclaiming?)
      (let [r (region-new)]
        (set! (.label r) label)
        (when (region-labels?) (regions-live-add! r))
        (region-enter! r)
        (primitive/cast i64 r))
      0))

;;; With HL_REGION_LABELS set, every region a label names is kept track of while it lives, and each
;;; safe point says which labels hold the most.
(defstruct RegionLabels [(ready bool) (on bool) (lock i64) (live (HashMap i64 bool))])

(defn region-labels-state [] (-> (ptr RegionLabels))
  (let [l (primitive/alloc-static RegionLabels)]
    (unless (.ready l)
      (init-lock!)
      (unless (.ready l)
        (set! (.on l) (env-on? "HL_REGION_LABELS"))
        (set! (.live l) (HashMap::new [i64 bool] (malloc-allocator) (i64-keyops)))
        (set! (.ready l) true))
      (init-unlock!))
    l))

(defn region-labels? [] (-> bool)
  (.on (region-labels-state)))

(defn regions-live-add! [(r (ptr Region))] (-> void)
  (let [l (region-labels-state)]
    (spin-lock! (field l lock))
    (set! (mut (.live l)) (primitive/cast i64 r) true)
    (spin-unlock! (field l lock)))
  0)

(defn regions-live-remove! [(r (ptr Region))] (-> void)
  (let [l (region-labels-state)]
    (spin-lock! (field l lock))
    (HashMap::remove! (mut (.live l)) (primitive/cast i64 r))
    (spin-unlock! (field l lock)))
  0)

;;; The labels whose live regions hold the most, with how many and how much.
(defn regions-labels-report! [] (-> void)
  (let [l (region-labels-state)
        (mut counts) (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))
        (mut bytes) (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))]
    (spin-lock! (field l lock))
    (for key (.live l)
      (let [r (primitive/cast (ptr Region) key)
            label (.label r)]
        (set! (mut counts) label (+ 1 (match (get counts label) (Some [n] n) (None [] 0))))
        (set! (mut bytes) label (+ (.bytes r) (match (get bytes label) (Some [n] n) (None [] 0))))))
    (spin-unlock! (field l lock))
    (let [(mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
          (mut sizes) (ArrayList::new [i64] (malloc-allocator))]
      (for key bytes
        (push! (mut names) key)
        (push! (mut sizes) (match (get bytes key) (Some [n] n) (None [] 0))))
      (let [order (sort-order-int sizes true)]
        (for i (range 0 (if (< (len order) 12) (len order) 12))
          (let [name (get names (get order i))]
            (println "[regions]   {} KB in {} regions: {}"
                     (/ (get sizes (get order i)) 1024)
                     (match (get counts name) (Some [n] n) (None [] 0))
                     name)))))
    (free! (mut counts))
    (free! (mut bytes)))
  0)

(defn answer-region-close! [(r i64)] (-> i64)
  (when (!= r 0) (region-leave!))
  0)

(defn region-release-id! [(r i64)] (-> void)
  (when (!= r 0) (region-release! (primitive/cast (ptr Region) r)))
  0)

(defn region-uses-id! [(r i64)] (-> void)
  (when (!= r 0) (region-uses! (primitive/cast (ptr Region) r)))
  0)

(defn region-ref-id! [(from i64) (to i64)] (-> void)
  (when (and (!= from 0) (!= to 0))
    (region-ref! (primitive/cast (ptr Region) from) (primitive/cast (ptr Region) to)))
  0)

(defn region-enter-id! [(r i64)] (-> void)
  (region-enter! (primitive/cast (ptr Region) r))
  0)

;;; A memo store's region for its keys' arguments, made the first time one is copied (`cell` is the
;;; store's field, `word` its lock), lasting as long as the store; entered through its shared cursor,
;;; since any thread computes. Whether it was entered: only while the run reclaims memory.
(defn keys-region-enter! [(cell (ptr i64)) (word (ptr i64))] (-> bool)
  (if (reclaiming?)
      (do
        (spin-lock! word)
        (when (= (load cell) 0)
          (let [r (region-make true 262144)]
            (set! (.label r) "a memo's keys")
            (store! cell (primitive/cast i64 r))))
        (let [r (primitive/cast (ptr Region) (load cell))]
          (spin-unlock! word)
          (region-enter-shared! r)
          true))
      false))

(defn keys-region-leave! [(entered bool)] (-> i64)
  (when entered (region-leave!))
  0)

;;; A statement loop at the top of a program that watches (no memo computing): where this thread's
;;; regions are, before the loop; each turn lets the last turn's region go and, while the run
;;; reclaims memory, makes its own; the loop's end lets the last go. Elsewhere nothing happens.
;;; Whether the turns have regions is the same for every turn, so the mark says it once: -1 when
;;; they have none, and each turn then costs one comparison.
(defn iteration-mark [] (-> i64)
  (if (and (reclaiming?) (not (dep-in-frame?)))
      (len (.stack (thread-regions)))
      -1))

(defn iteration-begin! :inline (Always) [(mark i64)] (-> void)
  (when (>= mark 0) (iteration-turn! mark))
  0)

(defn iteration-turn! [(mark i64)] (-> void)
  (iteration-end! mark)
  (let [r (region-new)]
    (set! (.label r) "a loop's turn")
    (when (region-labels?) (regions-live-add! r))
    (region-enter! r))
  0)

(defn iteration-end! :inline (Always) [(mark i64)] (-> void)
  (when (>= mark 0) (iteration-leave! mark))
  0)

(defn iteration-leave! [(mark i64)] (-> void)
  (let [t (thread-regions)]
    (while (> (len (.stack t)) mark)
      (let [r (region-current)]
        (region-leave!)
        (region-release! r))))
  0)

;;; Whether a turn of the loop marked `mark` has a region of its own.
(defn iterating-since? [(mark i64)] (-> bool)
  (and (>= mark 0) (> (len (.stack (thread-regions))) mark)))

;;; A region a `var` held, taken over by the region values go to now when the var's block ends: it
;;; lives as long as that region, which may hold the var's value. One the program's own region
;;; would take over stays held.
(defn region-adopt-id! [(r i64)] (-> void)
  (when (!= r 0)
    (let [cur (region-current)]
      (unless (.lasting cur)
        (region-ref! cur (primitive/cast (ptr Region) r))
        (region-release-id! r))))
  0)

;;; A `var`'s region (see `escape-assign` in the rules compiler), which this thread knows of while
;;; the var holds it: a setting given part of the var's value copies that part (see
;;; `setting-region-open!`), since the var lets its region go when it is given another.
(defn var-region-open! [] (-> i64)
  (let [r (answer-region-open! "var")]
    (when (!= r 0) (push! (mut (.vars (thread-regions))) r))
    r))

(defn var-region-forget! [(r i64)] (-> void)
  (when (!= r 0)
    (let [t (thread-regions)
          (mut at) -1]
      (for i (range 0 (len (.vars t))) (when (= (get (.vars t) i) r) (set! at i)))
      (when (< at 0) (panic "a var's region was let go that this thread does not know"))
      (set! (mut (.vars t)) at (get (.vars t) (- (len (.vars t)) 1)))
      (pop! (mut (.vars t)))))
  0)

;;; The var given another value lets its region go.
(defn var-region-release! [(r i64)] (-> void)
  (var-region-forget! r)
  (region-release-id! r)
  0)

;;; The var's block ended: its region taken over (`region-adopt-id!`).
(defn var-region-adopt! [(r i64)] (-> void)
  (var-region-forget! r)
  (region-adopt-id! r)
  0)

;;; Which region of those that can be let go each chunk is in, by address: what a copy that shares
;;; part of a value asks, so what it is copied into holds the region that part lies in (see
;;; `copy-from-holds?`). Each chunk is listed under every 4 KB page it covers: `pages` has each
;;; page's first entry, and an entry its chunk's start, end and region and the page's next entry.
;;; A chunk is listed as it is added (`chunk-add-own!`) and taken off as its region is let go.
(defstruct ChunkIndex
  [(ready i64) (lock i64) (pages (HashMap i64 i64))
   (starts (ArrayList i64)) (ends (ArrayList i64)) (regions (ArrayList i64)) (nexts (ArrayList i64))
   (free (ArrayList i64))])

(defn chunk-index [] (-> (ptr ChunkIndex))
  (let [c (primitive/alloc-static ChunkIndex)]
    (when (once-mine? (field c ready))
      (set! (.pages c) (HashMap::new [i64 i64] (malloc-allocator) (i64-keyops)))
      (set! (.starts c) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.ends c) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.regions c) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.nexts c) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.free c) (ArrayList::new [i64] (malloc-allocator)))
      (once-made! (field c ready)))
    c))

(defn chunk-index-page :inline (Always) [(p i64)] (-> i64) (>> p 12))

(defn chunk-index-add! [(at i64) (size i64) (r (ptr Region))] (-> void)
  (let [c (chunk-index)]
    (spin-lock! (field c lock))
    (for page (range (chunk-index-page at) (+ (chunk-index-page (- (+ at size) 1)) 1))
      (let [next (match (get (.pages c) page) (Some [e] e) (None [] -1))
            e (match (pop! (mut (.free c)))
                (Some [e] e)
                (None [] (let [n (len (.starts c))]
                           (push! (mut (.starts c)) 0)
                           (push! (mut (.ends c)) 0)
                           (push! (mut (.regions c)) 0)
                           (push! (mut (.nexts c)) 0)
                           n)))]
        (set! (mut (.starts c)) e at)
        (set! (mut (.ends c)) e (+ at size))
        (set! (mut (.regions c)) e (primitive/cast i64 r))
        (set! (mut (.nexts c)) e next)
        (set! (mut (.pages c)) page e)))
    (spin-unlock! (field c lock)))
  0)

(defn chunk-index-remove! [(at i64) (size i64)] (-> void)
  (let [c (chunk-index)]
    (spin-lock! (field c lock))
    (for page (range (chunk-index-page at) (+ (chunk-index-page (- (+ at size) 1)) 1))
      (let [(mut before) -1
            (mut e) (match (get (.pages c) page) (Some [e] e) (None [] -1))]
        (while (and (>= e 0) (!= (get (.starts c) e) at))
          (set! before e)
          (set! e (get (.nexts c) e)))
        (when (< e 0) (panic "a chunk let go was never listed"))
        (let [next (get (.nexts c) e)]
          (cond (>= before 0) (set! (mut (.nexts c)) before next)
                (>= next 0) (set! (mut (.pages c)) page next)
                :else (HashMap::remove! (mut (.pages c)) page)))
        (push! (mut (.free c)) e)))
    (spin-unlock! (field c lock)))
  0)

;;; The region that can be let go whose memory `p` lies in; 0 for any other memory (a lasting
;;; region's, a kept text's, the program's own).
(defn region-at [(p i64)] (-> i64)
  (let [c (chunk-index)]
    (spin-lock! (field c lock))
    (let [(mut e) (match (get (.pages c) (chunk-index-page p)) (Some [e] e) (None [] -1))
          (mut found) 0]
      (while (>= e 0)
        (if (and (>= p (get (.starts c) e)) (< p (get (.ends c) e)))
            (do (set! found (get (.regions c) e)) (set! e -1))
            (set! e (get (.nexts c) e))))
      (spin-unlock! (field c lock))
      found)))

;;; While a setting's value is copied (see `setting-region-open!`): whether the part at `p` is
;;; copied, as it lies in a region that may be let go while the setting holds it (one on this
;;; thread's stack, a var's, another setting's); else it is shared, and the region the value is
;;; copied into holds the region it lies in, if any.
(defn copy-from-holds? [(p i64)] (-> bool)
  (let [r (region-at p)]
    (cond (= r 0) false
          (.setting (primitive/cast (ptr Region) r)) true
          :else
            (let [t (thread-regions)
                  (mut found) false]
              (for f (.copy-from t) (when (= f r) (set! found true)))
              (unless found (region-ref! (region-current) (primitive/cast (ptr Region) r)))
              found))))

;;; The `from` of a copy of a setting's value (see `own-in-code` in the rules compiler): the regions
;;; `setting-region-open!` named, in place of a scratch region.
(defn setting-copy-from [] (-> (ptr Region))
  (primitive/cast (ptr Region) 1))

;;; The region a setting's value is made in, while the run reclaims memory, entered: the setting
;;; holds it until it is given another. The value is made before, where values went then, and
;;; copied into it (`setting-copy-from`) as far as it lies in regions that may be let go while the
;;; setting holds it: those on this thread's stack (a loop's turn, an answer being made), its vars',
;;; and other settings' values. What it shares lies in regions the new one holds (an answer's, a
;;; relation's), as any region holds those it has values of; so no setting's region holds
;;; another's, or a loop's turn, which hold it as they read the setting.
(defn setting-region-open! [(label (slice u8))] (-> i64)
  (if (reclaiming?)
      (let [t (thread-regions)
            r (region-new)
            n (/ (len (.stack t)) 3)]
        (set! (.label r) label)
        (set! (.setting r) true)
        (when (region-labels?) (regions-live-add! r))
        (clear! (mut (.copy-from t)))
        (for i (range 0 n)
          (let [from (primitive/cast (ptr Region) (get (.stack t) (* i 3)))]
            (unless (.lasting from) (push! (mut (.copy-from t)) (primitive/cast i64 from)))))
        (for v (.vars t) (push! (mut (.copy-from t)) v))
        (region-enter! r)
        (primitive/cast i64 r))
      0))

;;; A text's own copy, in the region values go to now.
(defn text-copy [(s (slice u8))] (-> (slice u8))
  (if (= (len s) 0)
      ""
      (match (alloc [u8] (value-allocator) (len s))
        (Some [m] (do (mem/copy [u8] (data m) (data s) (len s)) m))
        (None [] (panic "no memory to copy a text")))))

;;; A text the runtime keeps in place of another it kept: its own copy, the one it replaces let go.
;;; The empty text is no copy.
(defn stored-text-set! [(at (ptr (slice u8))) (s (slice u8))] (-> void)
  (let [old (load at)]
    (unless (and (= (len old) (len s)) (= (primitive/cast i64 (data old)) (primitive/cast i64 (data s))))
      (store! at (own-text s))
      (when (> (len old) 0) (free [u8] (malloc-allocator) old))))
  0)

;;; Each text's own copy, in place.
(defn owned-texts [(xs (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) xs]
    (for i (range 0 (len out)) (set! (mut out) i (own-text (get out i))))
    out))

;;; A text's copy that the runtime keeps, for as long as it keeps it: on malloc.
(defn own-text [(s (slice u8))] (-> (slice u8))
  (if (= (len s) 0)
      ""
      (match (alloc [u8] (malloc-allocator) (len s))
        (Some [m] (do (mem/copy [u8] (data m) (data s) (len s)) m))
        (None [] (panic "no memory to keep a text")))))

;;; Where a writer's and a reader's own tables go (their bytes, the table of objects it has met, a
;;; reader's arena): on malloc up to a megabyte, and past it pages of their own, given back to the
;;; system when let go. They grow to sizes what is written decides, so a big block freed on malloc
;;; is seldom the size the next one wants, and Darwin's malloc keeps it resident: a watcher that
;;; copies what it keeps from each build (and saves the cache) kept a few more such blocks each
;;; time. A block is pages exactly when it is more than the threshold; a resize in place never
;;; crosses it, or changes the pages a block has, so it is freed as what it is.
(defstruct BigAllocator [(unused i64)])

(defn big-threshold :inline (Always) [] (-> i64) 1048576)

(defn big-paged? [(bytes i64)] (-> bool) (> bytes (big-threshold)))

(defn big-new [(bytes i64)] (-> (Option (ptr i8)))
  (if (big-paged? bytes)
      (let [p (pages-new bytes)]
        (if (= (primitive/cast i64 p) 0) (None) (Some p)))
      (let [p (malloc (primitive/cast isize bytes))]
        (if (= (primitive/cast i64 p) 0) (None) (Some p)))))

(defn big-let-go! [(memory (ptr i8)) (bytes i64)] (-> i64)
  (if (big-paged? bytes)
      (do (munmap memory (primitive/cast isize (chunk-pages bytes))) 0)
      (do (primitive/free memory) 0)))

(impl Allocator BigAllocator
  (allocate [(self (ptr BigAllocator)) (request (ref AllocRequest))]
            (-> (Option (ptr i8)))
            (if (> (load (field request align)) 16)
                (None)
                (big-new (max 1 (load (field request bytes))))))
  (resize [(self (ptr BigAllocator)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))]
          (-> bool)
          (let [o (load (field old bytes))
                n (load (field new bytes))]
            (and (<= n o)
                 (= (big-paged? o) (big-paged? n))
                 (or (not (big-paged? o)) (= (chunk-pages o) (chunk-pages n))))))
  (remap [(self (ptr BigAllocator)) (memory (ptr i8)) (old (ref AllocRequest)) (new (ref AllocRequest))]
         (-> (Option (ptr i8)))
         (let [o (load (field old bytes))
               n (load (field new bytes))]
           (cond (> (load (field new align)) 16) (None)
                 (and (not (big-paged? o)) (not (big-paged? n)))
                   (let [p (realloc memory (primitive/cast isize (max 1 n)))]
                     (if (= (primitive/cast i64 p) 0) (None) (Some p)))
                 :else
                   (match (big-new (max 1 n))
                     (Some [p] (do (mem/copy [u8] (primitive/cast (ptr u8) p) (primitive/cast (ptr u8) memory) (min o n))
                                   (big-let-go! memory o)
                                   (Some p)))
                     (None [] (None))))))
  (deallocate [(self (ptr BigAllocator)) (memory (ptr i8)) (request (ref AllocRequest))]
              (-> i64)
              (big-let-go! memory (load (field request bytes)))))

(defn big-allocator [] (-> (dyn Allocator))
  (primitive/make-dyn Allocator (primitive/alloc-static BigAllocator)))

;;; A writer for copying one value: written, then read back where values go now (see `own-code` in
;;; the rules compiler), so the copy points at nothing the original did.
(defn copy-writer-new [] (-> (ptr Writer))
  (let [w (unwrap-ptr (create [Writer] (malloc-allocator)))]
    (store! w (copy-writer-value))
    w))

(defn copy-writer-value [] (-> Writer)
  (Writer
    :mem
      (match (alloc [u8] (big-allocator) 256)
        (Some [m] m)
        (None [] (panic "no memory to copy a value")))
    :pos 0
    :base 0
    :objects false
    :keys (ArrayList::new [i64] (big-allocator))
    :ids (ArrayList::new [i64] (big-allocator))
    :mask -1
    :filled 0
    :shared (HashMap::new [(slice u8) i64] (big-allocator) (text-keyops))
    :next-id 0
    :defined (ArrayList::new [i64] (big-allocator))
    :open (ArrayList::new [i64] (big-allocator))
    :modules (HashMap::new [(slice u8) i64] (big-allocator) (text-keyops))))

;;; What a copy writer wrote, as a reader of its bytes copied where values go now; the writer let go.
(defn copy-reader [(w (ptr Writer))] (-> (ptr Reader))
  (let [bytes (text-copy (subslice (.mem w) 0 (.pos w)))
        r (unwrap-ptr (create [Reader] (malloc-allocator)))]
    (writer-free! w)
    (primitive/free (primitive/cast (ptr i8) w))
    (store! r (reader-new bytes false))
    r))

(defn copy-reader-done! [(r (ptr Reader))] (-> void)
  (reader-free! r)
  (primitive/free (primitive/cast (ptr i8) r))
  0)

;;; A memo's last key kept by its store: its own copy, the one it replaces let go.
(defn last-key-set! [(at (ptr (slice u8))) (key (slice u8))] (-> void)
  (let [old (load at)]
    (unless (and (= (len old) (len key)) (= (primitive/cast i64 (data old)) (primitive/cast i64 (data key))))
      (store! at (own-text key))
      (when (> (len old) 0) (free [u8] (malloc-allocator) old))))
  0)

(defn writer-free! [(w (ptr Writer))] (-> void)
  (free [u8] (big-allocator) (.mem w))
  (free! (mut (.keys w)))
  (free! (mut (.ids w)))
  (free! (mut (.shared w)))
  (free! (mut (.defined w)))
  (free! (mut (.open w)))
  (free! (mut (.modules w)))
  0)

(defn reader-free! [(r (ptr Reader))] (-> void)
  (free! (mut (.returns r)))
  (free! (mut (.offsets r)))
  (free! (mut (.values r)))
  (free! (mut (.arena r)))
  (free! (mut (.frames r)))
  (free! (mut (.modules r)))
  0)

;;; The end of a build, while watching: what nothing holds any more let go, once the cache's last
;;; save is done (it reads what builds made), and the cache's writer told what went, since it knows
;;; values by where they were.
(defn regions-safe-point! [] (-> void)
  (when (reclaiming?)
    (cache-saved!)
    (let [q (region-queue)
          before (.let-go q)
          bytes-before (.bytes-let-go q)
          (mut ranges) (regions-let-go!)]
      (chunk-pool-trim!)
      (when (> (len ranges) 0) (writer-forget-ranges! (the-writer) ranges))
      (when (env-on? "HL_REGION_TRACE")
        (println "[regions] let go {} regions, {} KB; {} alive, {} KB"
                 (- (.let-go q) before)
                 (/ (- (.bytes-let-go q) bytes-before) 1024)
                 (- (atomic/read (field q made)) (.let-go q))
                 (/ (- (atomic/read (field q bytes-made)) (.bytes-let-go q)) 1024))
        (when (region-labels?) (regions-labels-report!))
        (let [d (deps)]
          (println "[regions] graph: {} nodes, {} edges, {} sites"
                   (len (.texts d)) (len (.edge-to d)) (len (.sites d)))))
      (free! (mut ranges))))
  0)

;;; Chunks come from malloc and go back to it; with HL_REGION_CHECK set they are pages of their
;;; own that are never used again once let go, and can be read by nobody, so a value read after
;;; its region was let go stops the program where it is read.
(defstruct RegionCheck [(ready bool) (on bool)])

(defn region-check? [] (-> bool)
  (let [c (primitive/alloc-static RegionCheck)]
    (unless (.ready c)
      (set! (.on c) (!= (primitive/cast i64 (os/getenv (str/to-cstr (malloc-allocator) "HL_REGION_CHECK"))) 0))
      (set! (.ready c) true))
    (.on c)))

(extern malloc :cc (cc/C) [isize] (-> (ptr i8)))
(extern realloc :cc (cc/C) [(ptr i8) isize] (-> (ptr i8)))

;;; hygiene: the platform's flag enters this module's namespace on purpose.
(defn gen-map-anon-private [] (-> Code)
  `(const ~(primitive/syntax->datum `MAP-ANON-PRIVATE)
          ~(match (target-os) (Linux [] 34) (Darwin [] 4098) (Wasm [] 34) (BareMetal [] 34))))

(gen-map-anon-private)

;;; MAP_NORESERVE: address space no memory is set aside for until it is written.
(defn gen-map-noreserve [] (-> Code)
  `(const ~(primitive/syntax->datum `MAP-NORESERVE)
          ~(match (target-os) (Linux [] 16384) (Darwin [] 64) (Wasm [] 16384) (BareMetal [] 16384))))

(gen-map-noreserve)

(extern mmap :cc (cc/C) [(ptr i8) isize i32 i32 i32 i64] (-> (ptr i8)))
(extern munmap :cc (cc/C) [(ptr i8) isize] (-> i32))
(extern mprotect :cc (cc/C) [(ptr i8) isize i32] (-> i32))
(extern madvise :cc (cc/C) [(ptr i8) isize i32] (-> i32))

;;; A big chunk is pages of its own, from the system and given back to it when its region is let
;;; go, so what a build no longer needs is no longer the program's: malloc keeps what is freed for
;;; its next use, and a run of builds whose big chunks differ in size (a big file parsed again)
;;; would leave it holding more and more it cannot reuse. Small chunks, which it reuses well, are
;;; malloc's. Map chunks from 64 KB onward, matching the mapping granularity: leaving 64 KB
;;; regions in malloc mixes short-lived region storage with long-lived metadata and can retain
;;; dirty pages across rebuilds even while live allocation counts stay flat. Pages are counted
;;; in 64 KB, a multiple of every supported page size.
;;; Chunks of the one size regions grow to are not given back at once: as many as the last build
;;; asked for wait for the next (see ChunkPool).
(defn big-chunk? [(size i64)] (-> bool)
  (>= size 65536))

(defn chunk-pages [(size i64)] (-> i64)
  (align-to size 65536))

(defn pages-new [(size i64)] (-> (ptr i8))
  ;; PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON (macOS 0x1002, Linux 0x22)
  (let [p (mmap (primitive/cast (ptr i8) 0) (primitive/cast isize (chunk-pages size)) (: 3 i32)
                (primitive/cast i32 MAP-ANON-PRIVATE) (: -1 i32) 0)]
    (if (= (primitive/cast i64 p) -1) (primitive/cast (ptr i8) 0) p)))

;;; The size a region's chunks grow to (see `region-new`): nearly all of a region's memory is in
;;; chunks of exactly this size, so one let go fits the next one asked for.
(defn pooled-chunk-size :inline (Always) [] (-> i64) 65536)

;;; Chunks of that size that regions have let go, kept for the next region to take: a program
;;; that lets regions go makes more (a watcher's next build, a loop's next turn), and a chunk
;;; taken back from here costs neither the system call nor the page faults of a new one (a
;;; watcher's rebuild of a big module is about 6% faster for it). It keeps no more than were
;;; asked for since the last safe point, what one build or turn used: the rest goes back to the
;;; system there, as every chunk did before (see `chunk-pool-trim!`), so a build bigger than
;;; those after it does not leave its size behind.
(defstruct ChunkPool [(lock i64) (ready bool) (free (ArrayList i64)) (asked i64)])

(defn chunk-pool [] (-> (ptr ChunkPool))
  (let [q (primitive/alloc-static ChunkPool)]
    (unless (.ready q)
      (init-lock!)
      (unless (.ready q)
        (set! (.free q) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.ready q) true))
      (init-unlock!))
    q))

;;; A kept chunk, or 0; and one more asked for.
(defn chunk-pool-take! [] (-> i64)
  (let [q (chunk-pool)]
    (spin-lock! (field q lock))
    (set! (.asked q) (+ (.asked q) 1))
    (let [at (match (pop! (mut (.free q))) (Some [a] a) (None [] 0))]
      (spin-unlock! (field q lock))
      at)))

(defn chunk-pool-keep! [(at i64)] (-> void)
  (let [q (chunk-pool)]
    (spin-lock! (field q lock))
    (push! (mut (.free q)) at)
    (spin-unlock! (field q lock)))
  0)

;;; At a safe point, after regions were let go: the chunks kept beyond how many were asked for
;;; since the last one go back to the system.
(defn chunk-pool-trim! [] (-> void)
  (let [q (chunk-pool)
        (mut go) true]
    (spin-lock! (field q lock))
    (let [keep (.asked q)]
      (set! (.asked q) 0)
      (while (and go (> (len (.free q)) keep))
        (match (pop! (mut (.free q)))
          (Some [at]
                (munmap (primitive/cast (ptr i8) at) (primitive/cast isize (pooled-chunk-size))))
          (None [] (set! go false)))))
    (spin-unlock! (field q lock)))
  0)

(defn chunk-memory [(size i64)] (-> (ptr i8))
  (cond (region-check?) (pages-new size)
        (= size (pooled-chunk-size))
          (let [at (chunk-pool-take!)]
            (if (!= at 0) (primitive/cast (ptr i8) at) (pages-new size)))
        (big-chunk? size) (pages-new size)
        :else (malloc (primitive/cast isize size))))

(defn chunk-let-go! [(at i64) (size i64)] (-> void)
  (cond (region-check?)
          ;; Replace storage with an anonymous PROT_NONE reservation at the same address.
          ;; MADV_DONTNEED alone need not discard dirty anonymous pages on macOS. MAP_FIXED
          ;; releases their backing while keeping the address poisoned and unavailable for reuse.
          (let [p (mmap (primitive/cast (ptr i8) at)
                         (primitive/cast isize (chunk-pages size)) (: 0 i32)
                         (primitive/cast i32 (+ MAP-ANON-PRIVATE 16)) (: -1 i32) 0)]
            (when (!= (primitive/cast i64 p) at)
              (panic "cannot poison released region pages")))
        (= size (pooled-chunk-size)) (chunk-pool-keep! at)
        (big-chunk? size)
          (munmap (primitive/cast (ptr i8) at) (primitive/cast isize (chunk-pages size)))
        :else
          (primitive/free (primitive/cast (ptr i8) at)))
  0)

;; ---------------------------------------------------------------- the scratch space
;;;
;;; Scratch regions take their memory from one stretch of address space the program reserves
;;; and never gives back, so "is this value in scratch storage" is two comparisons, whatever
;;; the system's allocator hands out between times. The space is cut in units; a region takes a
;;; unit at a time, and several in a row for one allocation bigger than a unit. A unit given
;;; back keeps its address and loses its pages, for the next region to take. Reserved, the space
;;; costs nothing: only pages written to are the program's.
;;;
;;; With HL_REGION_CHECK set, a unit given back is made unreadable and never taken again, so
;;; whatever still points into it faults; units are small then, to last.

(defstruct ScratchSpace
  [(ready i64) (lock i64) (base i64) (end i64) (next i64) (unit i64) (free (ArrayList i64))])

(defn scratch-space-cell [] (-> (ptr ScratchSpace))
  (primitive/alloc-static ScratchSpace))

(defn scratch-space [] (-> (ptr ScratchSpace))
  (let [s (scratch-space-cell)]
    (when (once-mine? (field s ready))
      (do
        (let [check (region-check?)
              ;; 256 GB in 64 MB units; checking, 1 TB in 1 MB units.
              size (if check 1099511627776 274877906944)
              p (mmap (primitive/cast (ptr i8) 0) (primitive/cast isize size) (: 0 i32)
                      (primitive/cast i32 (+ MAP-ANON-PRIVATE MAP-NORESERVE)) (: -1 i32) 0)]
          (when (= (primitive/cast i64 p) -1)
            (panic "cannot reserve address space for scratch storage"))
          (set! (.base s) (primitive/cast i64 p))
          (set! (.end s) (+ (primitive/cast i64 p) size))
          (set! (.next s) (primitive/cast i64 p))
          (set! (.unit s) (if check 1048576 67108864))
          (set! (.free s) (ArrayList::new [i64] (malloc-allocator)))
          (once-made! (field s ready)))))
    s))

;;; Whether `p` is in the scratch space: false before anything took any of it.
(defn scratch-space-holds? :inline (Always) [(p i64)] (-> bool)
  (let [s (scratch-space-cell)]
    (and (>= p (.base s)) (< p (.end s)))))

(defn stretch-unit [] (-> i64)
  (.unit (scratch-space)))

;;; The size of the stretch a region takes for `want` bytes: whole units.
(defn stretch-size [(want i64)] (-> i64)
  (align-to want (stretch-unit)))

;;; A stretch of `size` bytes (whole units), readable and writable: a unit given back before,
;;; or the next never taken.
(defn stretch-take! [(size i64)] (-> i64)
  (let [s (scratch-space)]
    (spin-lock! (field s lock))
    (if (and (= size (.unit s)) (> (len (.free s)) 0))
        (let [at (match (pop! (mut (.free s))) (Some [a] a) (None [] 0))]
          (spin-unlock! (field s lock))
          at)
        (let [at (.next s)]
          (when (> (+ at size) (.end s))
            (panic "the scratch space is used up: {} bytes more were asked for" size))
          (set! (.next s) (+ at size))
          (spin-unlock! (field s lock))
          ;; PROT_READ|PROT_WRITE
          (when (!= (mprotect (primitive/cast (ptr i8) at) (primitive/cast isize size) (: 3 i32)) (: 0 i32))
            (panic "cannot make scratch storage writable"))
          at))))

;;; The pages written in a stretch that is kept, all but the first few, given back to the system.
(defn stretch-trim! [(at i64) (used i64)] (-> void)
  (when (> used 262144)
    (let [from (+ at 262144)
          size (- (align-to used 65536) 262144)
          p (mmap (primitive/cast (ptr i8) from) (primitive/cast isize size) (: 3 i32)
                  (primitive/cast i32 (+ MAP-ANON-PRIVATE MAP-NORESERVE 16)) (: -1 i32) 0)]
      (when (!= (primitive/cast i64 p) from) (panic "cannot give back scratch pages"))))
  0)

;;; A stretch a region is done with, `used` bytes of it written. One unit goes to the next region
;;; that takes one; a longer stretch is not taken again. Checking, it is made unreadable for good.
(defn stretch-give! [(at i64) (size i64) (used i64)] (-> void)
  (let [s (scratch-space)]
    (if (or (region-check?) (!= size (.unit s)))
        (let [p (mmap (primitive/cast (ptr i8) at) (primitive/cast isize size) (: 0 i32)
                      (primitive/cast i32 (+ MAP-ANON-PRIVATE MAP-NORESERVE 16)) (: -1 i32) 0)]
          (when (!= (primitive/cast i64 p) at) (panic "cannot poison released scratch storage")))
        (do
          (stretch-trim! at used)
          (spin-lock! (field s lock))
          (push! (mut (.free s)) at)
          (spin-unlock! (field s lock)))))
  0)

;; ---------------------------------------------------------------- tokens

(defsum TokKind (TIdent) (TNum) (TStr) (TClass) (TPunct) (TEof))

(derive Eq Debug TokKind)

(defstruct Tok [(kind TokKind) (text (slice u8)) (line i64) (col i64)])

(defstruct LexFail [(msg (slice u8)) (line i64) (col i64)])

;;; `dsl-names` lets a name also contain `- . /`, for names like `fold-add`.
;;; `classes` reads `[a-z]` as one token, for grammars.
(defstruct LexConfig
  [(comment (slice u8))
   (puncts (ArrayList (slice u8)))
   (dsl-names bool)
   (classes bool)])

(defn digit? [(c u8)] (-> bool)
  (and (>= c #\0) (<= c #\9)))

(defn name-start? [(c u8)] (-> bool)
  (or (and (>= c #\a) (<= c #\z))
      (and (>= c #\A) (<= c #\Z))
      (= c #\_)
      (= c #\$)))

(defn name-char? [(c u8)] (-> bool)
  (or (name-start? c) (digit? c)))

(defn dsl-name-char? [(c u8)] (-> bool)
  (or (name-char? c) (= c #\-) (= c #\.) (= c #\/)))

(defn at? [(src (slice u8)) (i i64) (s (slice u8))] (-> bool)
  (and (<= (+ i (len s)) (len src)) (= (subslice src i (+ i (len s))) s)))

;;; Tokenize. Punctuation is tried in the order given, so list longer ones first.
(defn lex [(src (slice u8)) (cfg LexConfig)]
  (-> (Result (ArrayList Tok) LexFail))
  (block
    :out
      (let [(mut toks) (ArrayList::new [Tok] (value-allocator))
            n (len src)
            (mut i) 0
            (mut line) 1
            (mut line-start) 0]
        (while (< i n)
          (let [c (get src i)
                col (+ (- i line-start) 1)]
            (cond (= c #\newline)
                    (do
                      (set! i (+ i 1))
                      (set! line (+ line 1))
                      (set! line-start i))
                  (or (= c #\space) (= c #\tab) (= c #\return)) (set! i (+ i 1))
                  (at? src i (.comment cfg))
                    (while (and (< i n) (!= (get src i) #\newline))
                      (set! i (+ i 1)))
                  (name-start? c)
                    (let [start i]
                      (while (and (< i n)
                                  (if (.dsl-names cfg)
                                      (dsl-name-char? (get src i))
                                      (name-char? (get src i))))
                        (set! i (+ i 1)))
                      (push! (mut toks)
                             (Tok
                               :kind (TIdent)
                               :text (subslice src start i)
                               :line line
                               :col col)))
                  (digit? c)
                    (let [start i]
                      (while (and (< i n) (digit? (get src i)))
                        (set! i (+ i 1)))
                      (when (and (< i n)
                                 (or (= (get src i) #\.)
                                     (name-start? (get src i))))
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "the PoC reads integer literals only"
                                   :line line
                                   :col col))))
                      (push! (mut toks)
                             (Tok
                               :kind (TNum)
                               :text (subslice src start i)
                               :line line
                               :col col)))
                  (and (.classes cfg) (= c #\[))
                    (let [start (+ i 1)]
                      (set! i start)
                      (while (and (< i n) (!= (get src i) #\]))
                        (when (= (get src i) #\newline)
                          (return-from
                            :out
                              (Err (LexFail
                                     :msg "unterminated character class"
                                     :line line
                                     :col col))))
                        (set! i (+ i (if (= (get src i) #\\) 2 1))))
                      (when (>= i n)
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "unterminated character class"
                                   :line line
                                   :col col))))
                      (push! (mut toks)
                             (Tok
                               :kind (TClass)
                               :text (subslice src start i)
                               :line line
                               :col col))
                      (set! i (+ i 1)))
                  (= c #\")
                    (let [start (+ i 1)]
                      (set! i start)
                      (while (and (< i n) (!= (get src i) #\"))
                        (when (= (get src i) #\newline)
                          (return-from
                            :out
                              (Err (LexFail
                                     :msg "unterminated string"
                                     :line line
                                     :col col))))
                        (set! i (+ i (if (= (get src i) #\\) 2 1))))
                      (when (>= i n)
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "unterminated string"
                                   :line line
                                   :col col))))
                      (push! (mut toks)
                             (Tok
                               :kind (TStr)
                               :text (subslice src start i)
                               :line line
                               :col col))
                      (set! i (+ i 1)))
                  :else
                    (let [(mut hit) -1]
                      (for k (range 0 (len (.puncts cfg)))
                        (when (and (< hit 0) (at? src i (get (.puncts cfg) k)))
                          (set! hit k)))
                      (when (< hit 0)
                        (return-from
                          :out
                            (Err (LexFail
                                   :msg "unexpected character"
                                   :line line
                                   :col col))))
                      (let [p (get (.puncts cfg) hit)]
                        (push! (mut toks)
                               (Tok
                                 :kind (TPunct)
                                 :text p
                                 :line line
                                 :col col))
                        (set! i (+ i (len p))))))))
        (push! (mut toks)
               (Tok
                 :kind (TEof)
                 :text "end of input"
                 :line line
                 :col (+ (- i line-start) 1)))
        (Ok toks))))

;; ---------------------------------------------------------------- parser state

;;; One memo table entry: did the rule match here, where did it end, and its node, as an index
;;; into the parse's kept answers, because this module does not know the grammar's node type.
(defstruct MemoHit [(ok bool) (end i64) (node i64)])

;;; Generated parsers work directly on bytes. `pos` is always just past the last
;;; token with whitespace unskipped, so `@nl` can see what lies before the next
;;; token. `ws-*` caches the most recent skip, and `far`/`want` keep the farthest
;;; failure, the one worth reporting from a backtracking parser.
(defstruct P
  [(src (slice u8))
   (path (slice u8))
   (pos i64)
   (flags i64)
   (ws-from i64)
   (ws-to i64)
   ;; Whether the space from `ws-nl-at` holds a line end: worked out when a rule asks, since few do.
   (ws-nl bool)
   (ws-nl-at i64)
   (ws-scan i64)
   (far i64)
   (want (slice u8))
   (memos (ArrayList MemoTable))
   ;; The memo's answers as they are made, the last `memo-ring-size` of them, in a ring: answer
   ;; number n is in slot n mod the size, its node in the same slot of `memo-ring-nodes`. An
   ;; answer is asked for again only after the parse backtracks over it, so answers wait here,
   ;; cheaply, and go into `memos` only then (see `backtrack!`); every answer at or past the place
   ;; backtracked to is the backtracked one's. Answers `memo-low` up to `memo-next` are in the
   ;; ring. One pushed out by later ones is forgotten: it is parsed again if a backtrack over
   ;; more answers than the ring holds ever asks.
   (memo-log (ArrayList MemoEntry))
   (memo-low i64)
   (memo-next i64)
   ;; The nodes of the ring's answers, and those of the answers in `memos` (`MemoHit.node` is an
   ;; index into these): bytes, because this module does not know the grammar's node type.
   (memo-ring-nodes (ArrayList u8))
   (memo-kept (ArrayList u8))
   (memo-node-bytes i64)
   ;; The furthest key any table holds: past it, every table is asked for nothing.
   (memo-top i64)
   ;; Where the space from some offsets ends, once skipped: a small table of the last ones asked
   ;; about, an offset's slot its low bits, the entry the offset plus one above the length plus
   ;; one; 0 an empty slot. A backtracking parser skips the same space, comments and all, once for
   ;; every way it tries the token after.
   (ws-ends (ArrayList i64))
   (ws-mask i64)
   ;; Try every alternative, as if no first-byte guard ruled any out: for the parse that says why
   ;; a program is wrong, whose furthest failure is then what trying them all finds.
   (careful bool)
   ;; Where the tree goes: the storage the parse began in; and, when that is this thread's own
   ;; cursor, the cursor, which a node's children are taken from directly (see `p-alloc`).
   (alloc (dyn Allocator))
   (cursor i64)
   ;; The grammar's own working list, which this module cannot name: the items of lists being
   ;; parsed.
   (stack i64)
   ;; The token last lexed: where, which of the grammar's token bodies, where it ended, whether it
   ;; matched. Alternatives often ask for the same token again where the last one began.
   (tok-at i64)
   (tok-id i64)
   (tok-end i64)
   (tok-ok bool)])

;;; An answer in the memo's log: which memo, its key, the answer.
(defstruct MemoEntry [(id i64) (key i64) (hit MemoHit)])

;;; A memo table: open addressing on the key, which is never negative and is kept plus one, so a
;;; slot of zeros is empty and a table is made by zeroing memory.
(defstruct MemoTable
  [(keys (ArrayList i64)) (vals (ArrayList MemoHit)) (count i64) (mask i64)])

(defn memo-table [(cap i64)] (-> MemoTable)
  (let [(mut keys) (ArrayList::new [i64] (malloc-allocator))
        (mut vals) (ArrayList::new [MemoHit] (malloc-allocator))]
    (ArrayList::extend-zeroed! (mut keys) cap)
    (ArrayList::extend-zeroed! (mut vals) cap)
    (MemoTable
      :keys keys
      :vals vals
      :count 0
      :mask (- cap 1))))

(defn memo-hash :inline (Always) [(key i64)] (-> i64)
  (let [h (primitive/imul key -7046029254386353131)]
    (^ h (>> h 29))))

;;; How many parts a memo's store keeps its answers in while a run only makes and reads them (see
;;; `MemoPart--` in the rules compiler), and which of them a key of this hash is in: by bits a
;;; table does not place its keys by.
(defn memo-parts :inline (Always) [] (-> i64) 64)

;;; How many answers a thread keeps by itself, of each memo, in a run that only makes answers and
;;; reads them: the ones it last asked for, which it asks for again without touching what the
;;; threads share. A thread that works through every module in turn would otherwise hold a copy
;;; of every answer.
(defn near-most :inline (Always) [] (-> i64) 64)

(defn memo-part-of :inline (Always) [(hash i64)] (-> i64)
  (& (>> hash 40) 63))

(defn memo-table-get [(t (mut MemoTable)) (key i64)] (-> (Option MemoHit))
  (let [(mut i) (& (memo-hash key) (.mask t))
        (mut out) (None [MemoHit])
        (mut go) true]
    (while go
      (let [k (get (.keys t) i)]
        (cond (= k (+ key 1))
                (do (set! out (Some (get (.vals t) i))) (set! go false))
              (= k 0) (set! go false)
              :else (set! i (& (+ i 1) (.mask t))))))
    out))

(defn memo-table-put! [(t (mut MemoTable)) (key i64) (hit MemoHit)] (-> void)
  (when (> (* (+ (.count t) 1) 2) (+ (.mask t) 1))
    (let [old t
          (mut bigger) (memo-table (* (+ (.mask t) 1) 2))]
      (for i (range 0 (len (.keys old)))
        (let [k (get (.keys old) i)]
          (when (> k 0)
            (memo-table-put! (mut bigger) (- k 1) (get (.vals old) i)))))
      (free! (mut (.keys t)))
      (free! (mut (.vals t)))
      (set! t bigger)))
  (let [(mut i) (& (memo-hash key) (.mask t))
        (mut go) true]
    (while go
      (let [k (get (.keys t) i)]
        (cond (= k (+ key 1)) (do (set! (mut (.vals t)) i hit) (set! go false))
              (= k 0)
                (do
                  (set! (mut (.keys t)) i (+ key 1))
                  (set! (mut (.vals t)) i hit)
                  (set! (.count t) (+ (.count t) 1))
                  (set! go false))
              :else (set! i (& (+ i 1) (.mask t))))))
    0))

(defn memo-table-free! [(t (mut MemoTable))] (-> void)
  (free! (mut (.keys t)))
  (free! (mut (.vals t)))
  0)

(defstruct ParseError
  [(path (slice u8)) (line i64) (col i64) (want (slice u8)) (found (slice u8))])

;;; How many answers the memo's ring holds, and how many offsets the space table.
(defn memo-ring-size :inline (Always) [] (-> i64) 1024)
(defn ws-slots :inline (Always) [] (-> i64) 4096)

;;; A parser over `src` from `from` on: what comes before is another parser's, and the end of
;;; `src` is the end of input. `node-bytes` is the size of the grammar's node.
(defn p-new [(src (slice u8))
             (path (slice u8))
             (flags i64)
             (memo-count i64)
             (from i64)
             (node-bytes i64)] (-> P)
  (let [(mut memos) (ArrayList::new [MemoTable] (malloc-allocator))
        (mut ends) (ArrayList::new [i64] (malloc-allocator))
        (mut log) (ArrayList::new [MemoEntry] (malloc-allocator))
        (mut ring-nodes) (ArrayList::new [u8] (malloc-allocator))
        size (- (len src) from)
        ;; A short text asks about few offsets: its table is no bigger than it.
        (mut slots) 16]
    (while (and (< slots (ws-slots)) (< slots (+ size 1))) (set! slots (* slots 2)))
    ;; The tables hold only answers backtracked over, few of them: they start small and grow.
    (for _ (range 0 memo-count) (push! (mut memos) (memo-table 64)))
    (extend-zeroed! (mut ends) slots)
    (when (> memo-count 0)
      (reserve! (mut log) (memo-ring-size))
      (reserve! (mut ring-nodes) (* (memo-ring-size) node-bytes)))
    (P
      :src src
      :path path
      :pos from
      :flags flags
      :ws-from -1
      :ws-to from
      :ws-nl false
      :ws-nl-at -1
      :ws-scan from
      :far from
      :want "a program"
      :memos memos
      :memo-log log
      :memo-low 0
      :memo-next 0
      :memo-ring-nodes ring-nodes
      :memo-kept (ArrayList::new [u8] (malloc-allocator))
      :memo-node-bytes node-bytes
      :memo-top -1
      :ws-ends ends
      :ws-mask (- slots 1)
      :careful false
      :alloc (tree-allocator)
      :cursor (top-cursor)
      :stack 0
      :tok-at -1
      :tok-id -1
      :tok-end -1
      :tok-ok false)))

;;; A parse is done: its memo tables and space cache go.
(defn p-free! [(p (mut P))] (-> void)
  (for i (range 0 (len (.memos p)))
    (memo-table-free! (elem (mut (.memos p)) i)))
  (free! (mut (.memos p)))
  (free! (mut (.memo-log p)))
  (free! (mut (.memo-ring-nodes p)))
  (free! (mut (.memo-kept p)))
  (free! (mut (.ws-ends p)))
  0)

(defn p-alloc :inline (Always) [(p (mut P)) (bytes i64)] (-> (ptr i8))
  (cursor-allocate (primitive/cast (ptr Cursor) (.cursor p)) bytes 8))

;;; The length plus one of the space from `from`, or 0 when the table does not hold it.
(defn ws-known :inline (Always) [(p (mut P)) (from i64)] (-> i64)
  (let [e (load (primitive/index (.data (.ws-ends p)) (& from (.ws-mask p))))]
    (if (= (>> e 32) (+ from 1)) (& e 4294967295) 0)))

(defn ws-remember! :inline (Always) [(p (mut P)) (from i64) (to i64)] (-> void)
  (store! (primitive/index (.data (.ws-ends p)) (& from (.ws-mask p)))
          (| (<< (+ from 1) 32) (+ (- to from) 1)))
  0)

(defn peek :inline (Always) [(p (mut P))] (-> i64)
  (if (< (.pos p) (len (.src p))) (cast i64 (get (.src p) (.pos p))) -1))

;;; The byte at an offset of a text; -1 past its end.
(defn byte-at-or-end :inline (Always) [(s (slice u8)) (at i64)] (-> i64)
  (if (< at (len s)) (cast i64 (get s at)) -1))

(defn advance! :inline (Always) [(p (mut P)) (n i64)] (-> void)
  (set! (.pos p) (+ (.pos p) n)))

(defn at-bytes? :inline (Always) [(p (mut P)) (s (slice u8))] (-> bool)
  (at? (.src p) (.pos p) s))

;;; Whether the byte `offset` past the parse position is one of `bytes`.
(defn followed-by-any? [(p (mut P)) (offset i64) (bytes (slice u8))] (-> bool)
  (let [at (+ (.pos p) offset)
        (mut hit) false]
    (when (< at (len (.src p)))
      (let [b (get (.src p) at)]
        (for i (range 0 (len bytes))
          (when (= (get bytes i) b) (set! hit true)))))
    hit))

(defn eof? :inline (Always) [(p (mut P))] (-> bool)
  (>= (.pos p) (len (.src p))))

(defn span :inline (Always) [(p (mut P)) (lo i64) (hi i64)] (-> (slice u8))
  (subslice (.src p) lo hi))

(defn note-fail! [(p (mut P)) (want (slice u8))] (-> void)
  (when (> (.pos p) (.far p))
    (set! (.far p) (.pos p))
    (set! (.want p) want)))


;;; How many of each byte value the text holds: 256 counts.
(defn byte-counts [(s (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))]
    (reserve! (mut out) 256)
    (for _ (range 0 256) (push! (mut out) 0))
    (for i (range 0 (len s))
      (let [c (cast i64 (get s i))]
        (set! (mut out) c (+ (get out c) 1))))
    out))

;;; Lists of numbers added place by place: as long as the longest, a shorter one adding nothing
;;; past its end.
(defn summed-lists [(lists (ArrayList (ArrayList i64)))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))]
    (for (ref xs) lists
      (while (< (len out) (len xs)) (push! (mut out) 0))
      (for i (range 0 (len xs))
        (set! (mut out) i (+ (get out i) (get xs i)))))
    out))

;;; Does the text hold this byte?
(defn has-byte? [(s (slice u8)) (b i64)] (-> bool)
  (and (> (len s) 0)
       (>= b 0)
       (< b 256)
       (!= (primitive/cast i64 (memchr (primitive/cast (ptr i8) (data s)) (cast i32 b) (len s))) 0)))

(extern memchr :cc (cc/C) [(ptr i8) i32 isize] (-> (ptr i8)))

;;; Plain substring search.
(defn contains-text? [(s (slice u8)) (needle (slice u8))] (-> bool)
  (let [(mut hit) false
        (mut i) 0
        n (- (len s) (len needle))
        first (get needle 0)]
    (while (and (not hit) (<= i n))
      (when (and (= (get s i) first) (at? s i needle)) (set! hit true))
      (set! i (+ i 1)))
    hit))


(defn apply-flags [(flags i64) (on i64) (off i64)] (-> i64)
  (| (& flags (- -1 off)) on))

(defn flag? :inline (Always) [(p (mut P)) (bit i64)] (-> bool)
  (!= (& (.flags p) bit) 0))

(defn memo-key [(p (mut P))] (-> i64)
  (+ (* (.pos p) 256) (.flags p)))

(defn memo-get :inline (Always) [(p (mut P)) (id i64) (key i64)] (-> (Option MemoHit))
  (if (> key (.memo-top p))
      (None [MemoHit])
      (memo-table-get (elem (mut (.memos p)) id) key)))

;;; The slot of the ring the next answer goes in: its node is written there first (the
;;; grammar's module does that, knowing the type), then `memo-put!` writes the answer.
(defn memo-slot :inline (Always) [(p (mut P))] (-> i64)
  (& (.memo-next p) (- (memo-ring-size) 1)))

(defn memo-put! :inline (Always) [(p (mut P)) (id i64) (key i64) (hit MemoHit)] (-> void)
  (let [n (.memo-next p)]
    (store! (primitive/index (.data (.memo-log p)) (& n (- (memo-ring-size) 1)))
            (MemoEntry :id id :key key :hit hit))
    (set! (.memo-next p) (+ n 1))
    ;; A full ring gives up its oldest answer.
    (when (> (- (+ n 1) (.memo-low p)) (memo-ring-size)) (set! (.memo-low p) (+ (.memo-low p) 1))))
  0)

;;; The parse goes back to `to`: what the memo answered at or past it was the attempt that failed,
;;; and may be asked for again.
(defn backtrack! :inline (Always) [(p (mut P)) (to i64)] (-> void)
  (set! (.pos p) to)
  (let [n (.memo-next p)]
    (when (and (> n (.memo-low p))
               (>= (.key (load (primitive/index (.data (.memo-log p)) (& (- n 1) (- (memo-ring-size) 1)))))
                   (* to 256)))
      (memo-promote! (mut p) to)))
  0)

(defn memo-promote! [(p (mut P)) (to i64)] (-> void)
  (let [(mut go) true
        mask (- (memo-ring-size) 1)
        size (.memo-node-bytes p)]
    (while go
      (let [n (.memo-next p)]
        (if (> n (.memo-low p))
            (let [slot (& (- n 1) mask)
                  e (load (primitive/index (.data (.memo-log p)) slot))]
              (if (>= (.key e) (* to 256))
                  (let [(mut hit) (.hit e)]
                    ;; Its node moves to where the tables' answers keep theirs.
                    (when (.ok hit)
                      (let [at (len (.memo-kept p))]
                        (extend! (mut (.memo-kept p))
                                 (primitive/index (.data (.memo-ring-nodes p)) (* slot size))
                                 size)
                        (set! (.node hit) (/ at size))))
                    (memo-table-put! (elem (mut (.memos p)) (.id e)) (.key e) hit)
                    (when (> (.key e) (.memo-top p)) (set! (.memo-top p) (.key e)))
                    (set! (.memo-next p) (- n 1)))
                  (set! go false)))
            (set! go false)))))
  0)

;;; Is byte `c` in the set whose 256 bits are w0..w3? -1, the end of input, is in none.
(defn byte-in? :inline (Always) [(c i64) (w0 i64) (w1 i64) (w2 i64) (w3 i64)]
  (-> bool)
  (if (or (< c 0) (> c 255))
      false
      (let [w (cond (< c 64) w0 (< c 128) w1 (< c 192) w2 :else w3)]
        (!= (& (>> w (% c 64)) 1) 0))))

;;; Where a byte offset falls, for messages.
(defn line-col [(src (slice u8)) (at i64)] (-> Pos)
  (let [(mut line) 1
        (mut col) 1]
    (for i (range 0 (if (< at (len src)) at (len src)))
      (if (= (get src i) #\newline)
          (do (set! line (+ line 1)) (set! col 1))
          (set! col (+ col 1))))
    (Pos :line line :col col)))

(defstruct Pos [(line i64) (col i64)])

;;; Where a tool that handles failure itself finds the last one.
(defstruct LastParse [(last ParseError)])

(defn last-parse-error [] (-> (ptr LastParse))
  (primitive/alloc-static LastParse))

(defn last-parse-path [] (-> (slice u8))
  (.path (.last (last-parse-error))))

(defn last-parse-line [] (-> i64)
  (.line (.last (last-parse-error))))

(defn last-parse-col [] (-> i64)
  (.col (.last (last-parse-error))))

(defn last-parse-want [] (-> (slice u8))
  (.want (.last (last-parse-error))))

(defn last-parse-found [] (-> (slice u8))
  (.found (.last (last-parse-error))))

(defn fail-last-parse [] (-> never)
  (parse-failed (.last (last-parse-error))))

;;; A program that cannot be built, said to whoever builds it: the message, and exit status 1,
;;; with no trace of where in the builder it was found.
(extern exit :cc (cc/C) [i32] (-> void))

(defn fail-build [(message (slice u8))] (-> never)
  (eprintln "error: {}" message)
  (exit 1)
  (panic "exit returned"))

(defn parse-error [(p (mut P))] (-> ParseError)
  (let [at (line-col (.src p) (.far p))
        n (len (.src p))
        end (if (< (+ (.far p) 20) n) (+ (.far p) 20) n)]
    (ParseError
      :path (.path p)
      :line (.line at)
      :col (.col at)
      :want (.want p)
      :found
        (if (>= (.far p) n) "end of input" (subslice (.src p) (.far p) end)))))

(defn parse-failed [(e ParseError)] (-> never)
  (panic "{}:{}:{}: expected {}, found: {}"
         (.path e)
         (.line e)
         (.col e)
         (.want e)
         (.found e)))

;; ---------------------------------------------------------------- printer

;;; `keep` counts enclosing positions where parentheses must stay as written, and
;;; `pending` holds a soft token (`soft`, as the grammar prints it) that a following closing token
;;; makes unnecessary.
;;; `marks`, when `tracking`, records where each leaf token landed, for source maps.
(defstruct Mark [(out i64) (src i64)])

;;; `open`: the text ends where a `;` the grammar may drop was dropped, so whatever follows it
;;; has to begin with one.
(defstruct Rendered [(text (slice u8)) (marks (ArrayList Mark)) (open bool)])

;;; How a language's tokens sit next to each other. A grammar declares it; nothing here knows
;;; any language. `word` holds a true for each byte value that belongs to a word; `apart` is
;;; pairs of bytes that must not touch; `apart-digits` may not follow a token of only digits.
(defstruct PrintStyle
  [(word (ArrayList bool))
   (apart (slice u8))
   (apart-digits (slice u8))
   (soft-close (slice u8))
   (breaks (ArrayList (slice u8)))])

(defstruct W
  [(buf (ArrayList u8))
   (pretty bool)
   (pending bool)
   (soft (slice u8))
   (keep i64)
   (after-int bool)
   (tracking bool)
   ;; Tracking by file: a mark only where the output passes to another source (a source position
   ;; is its file's number above 2^32, and its offset below), not at every leaf.
   (by-file bool)
   (marks (ArrayList Mark))
   (next-src i64)
   (style PrintStyle)])

(defn w-new [(pretty bool) (style PrintStyle)] (-> W)
  (W
    :buf (ArrayList::new [u8] (value-allocator))
    :pretty pretty
    :pending false
    :soft ""
    :keep 0
    :after-int false
    :tracking false
    :by-file false
    :marks (ArrayList::new [Mark] (value-allocator))
    :next-src 0
    :style style))

;;; `bytes` are word characters; `high` makes every byte above ASCII one too.
(defn print-style [(bytes (slice u8))
                   (high bool)
                   (apart (slice u8))
                   (apart-digits (slice u8))
                   (soft-close (slice u8))
                   (breaks (ArrayList (slice u8)))] (-> PrintStyle)
  (let [(mut word) (ArrayList::new [bool] (value-allocator))]
    (for i (range 0 256) (push! (mut word) (and high (>= i 128))))
    (for c bytes (set! (mut word) (cast i64 c) true))
    (PrintStyle
      :word word
      :apart apart
      :apart-digits apart-digits
      :soft-close soft-close
      :breaks breaks)))

(defn word-byte? [(w (mut W)) (c u8)] (-> bool)
  (get (.word (.style w)) (cast i64 c)))

;;; Two tokens that would read differently run together get a space between them.
(defn must-separate? [(w (mut W)) (a u8) (next (slice u8))] (-> bool)
  (let [b (get next 0)]
    (or (and (word-byte? (mut w) a) (word-byte? (mut w) b))
        (let [pairs (.apart (.style w))
              (mut hit) false
              (mut i) 0]
          (while (< (+ i 1) (len pairs))
            (when (and (= (get pairs i) a) (= (get pairs (+ i 1)) b))
              (set! hit true))
            (set! i (+ i 2)))
          hit))))

(defn digit-guarded? [(w (mut W)) (c u8)] (-> bool)
  (let [(mut hit) false]
    (for x (.apart-digits (.style w)) (when (= x c) (set! hit true)))
    hit))

(defn breaks-line? [(w (mut W)) (s (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for b (.breaks (.style w)) (when (= b s) (set! hit true)))
    hit))

(defn all-digits? [(s (slice u8))] (-> bool)
  (let [(mut ok) (> (len s) 0)]
    (for c s (unless (digit? c) (set! ok false)))
    ok))

(defn w-bytes! [(w (mut W)) (s (slice u8))] (-> void)
  (when (> (len s) 0) (ArrayList::extend! (mut (.buf w)) (data s) (len s))))

(defn flush-semi! [(w (mut W))] (-> void)
  (when (.pending w)
    (set! (.pending w) false)
    (w-bytes! (mut w) (.soft w))
    (when (.pretty w) (push! (mut (.buf w)) #\newline))))

;;; What a mark tells apart when only files are tracked: the module, and whether the code is the
;;; module's own or written for it with no place in it (the offset 2^32-1, see bundle.sourcemap).
(defn file-key [(src i64)] (-> i64)
  (+ (* (/ src 4294967296) 2) (if (= (% src 4294967296) 4294967295) 1 0)))

;;; Write one token. Pretty output breaks lines after the tokens the style names.
(defn tok! [(w (mut W)) (s (slice u8))] (-> void)
  (when (> (len s) 0)
    (if (and (.pending w) (= s (.soft-close (.style w))))
        (set! (.pending w) false)
        (flush-semi! (mut w)))
    (let [n (len (.buf w))]
      (when (and (> n 0)
                 (or (must-separate? (mut w) (get (.buf w) (- n 1)) s)
                     (and (.after-int w) (digit-guarded? (mut w) (get s 0)))))
        (push! (mut (.buf w)) #\space)))
    (w-bytes! (mut w) s)
    (when (> (.next-src w) 0)
      (when (or (not (.by-file w))
                (= (len (.marks w)) 0)
                (!= (file-key (.src (get (.marks w) (- (len (.marks w)) 1))))
                    (file-key (.next-src w))))
        (push! (mut (.marks w))
               (Mark :out (- (len (.buf w)) (len s)) :src (.next-src w))))
      (set! (.next-src w) 0))
    ;; A token is all digits only if it ends in one: most do not, and are not looked through.
    (set! (.after-int w) (and (digit? (get s (- (len s) 1))) (all-digits? s)))
    (when (and (.pretty w) (breaks-line? (mut w) s))
      (push! (mut (.buf w)) #\newline))))

;;; A leaf: its text, and where it came from.
(defn leaf-tok! [(w (mut W)) (s (slice u8)) (src i64)] (-> void)
  (note-source! (mut w) src)
  (tok! (mut w) s))

;;; The next token printed starts the node that came from `src`.
(defn note-source! [(w (mut W)) (src i64)] (-> void)
  (when (and (.tracking w) (>= src 4294967296))
    (set! (.next-src w) src)))

;;; A token the grammar prints softly: dropped before the token it says closes, kept otherwise.
(defn soft-semi! [(w (mut W)) (token (slice u8))] (-> void)
  (flush-semi! (mut w))
  (set! (.soft w) token)
  (set! (.pending w) true))

;;; Remember where the next token will land, for a later `w-wrap!`.
(defn w-mark! [(w (mut W))] (-> i64)
  (flush-semi! (mut w))
  (len (.buf w)))

(defn skip-printed-space [(w (mut W)) (from i64)] (-> i64)
  (let [(mut i) from]
    (while (and (< i (len (.buf w))) (= (get (.buf w) i) #\space))
      (set! i (+ i 1)))
    i))

;;; Did what was printed since `mark` begin with this punctuation?
(defn w-starts? [(w (mut W)) (mark i64) (s (slice u8))] (-> bool)
  (at? (slice (.buf w)) (skip-printed-space (mut w) mark) s))

;;; Did it begin with this word?
(defn w-starts-word? [(w (mut W)) (mark i64) (s (slice u8))] (-> bool)
  (let [i (skip-printed-space (mut w) mark)
        end (+ i (len s))]
    (and (at? (slice (.buf w)) i s)
         (or (>= end (len (.buf w)))
             (not (word-byte? (mut w) (get (.buf w) end)))))))

;;; Parenthesise everything printed since `mark`.
(defn w-wrap! [(w (mut W)) (mark i64) (open (slice u8)) (close (slice u8))]
  (-> void)
  (flush-semi! (mut w))
  (let [at (skip-printed-space (mut w) mark)
        tail (ArrayList::new [u8] (value-allocator))
        (mut saved) tail]
    (for i (range at (len (.buf w))) (push! (mut saved) (get (.buf w) i)))
    (while (> (len (.buf w)) at) (pop! (mut (.buf w))))
    (w-bytes! (mut w) open)
    (w-bytes! (mut w) (slice saved))
    (w-bytes! (mut w) close)
    ;; What was printed since `at` moved along by the new opening.
    (for i (range 0 (len (.marks w)))
      (let [m (get (.marks w) i)]
        (when (>= (.out m) at)
          (set! (mut (.marks w))
                i
                (Mark :out (+ (.out m) (len open)) :src (.src m))))))
    (set! (.after-int w) false)))

(defn w-finish [(w W)] (-> (slice u8))
  (slice (.buf w)))

;; ---------------------------------------------------------------- strings

;;; The content of a quoted string token.
(defn subtext [(s (slice u8)) (from i64) (to i64)] (-> (slice u8))
  (subslice s from to))

(defn str-content [(raw (slice u8))] (-> (slice u8))
  (subslice raw 1 (- (len raw) 1)))

;;; A double-quoted token holding this already-escaped content.
(defn quote-str [(content (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) "\"")
    (push-str! (mut b) content)
    (push-str! (mut b) "\"")
    (finish! (mut b))))

;;; Each run of a rewrite gets a number; a node stamped with it is already normal. Numbers are
;;; handed out in blocks, one to a thread at a time, so threads that rewrite at once never contend
;;; for them: a run per leaf, on every thread, would otherwise all touch one word.
(defstruct PassCounter [(n i64)])

(defstruct PassBlock [(next i64) (end i64)])

(defn pass-block [] (-> (ptr PassBlock))
  (let [key (.pass-key (workers))
        found (pthread_getspecific key)]
    (if (= (primitive/cast i64 found) 0)
        (let [cell
                (box! (malloc-allocator) PassBlock (PassBlock :next 0 :end 0))]
          (pthread_setspecific key (cast (ptr i8) cell))
          cell)
        (cast (ptr PassBlock) found))))

(defn next-pass! [] (-> i64)
  (let [b (pass-block)]
    (when (>= (.next b) (.end b))
      (let [start
              (atomic/add (primitive/cast (ptr i64)
                                          (primitive/alloc-static PassCounter))
                          65536)]
        (set! (.next b) (+ start 1))
        (set! (.end b) (+ start 65537))))
    (let [p (.next b)]
      (set! (.next b) (+ p 1))
      p)))

;; ---------------------------------------------------------------- integers

;;; A run of decimal digits, or nothing when it is not one or will not fit.
(defn parse-num [(s (slice u8))] (-> (Option i64))
  (let [(mut v) 0
        (mut ok) (> (len s) 0)]
    (for c s
      (when ok
        (if (and (digit? c) (< v 900000000000000000))
            (set! v (+ (* v 10) (- (cast i64 c) 48)))
            (set! ok false))))
    (if ok (Some v) (None [i64]))))

(defn num-text [(v i64)] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-i64! (mut b) v)
    (finish! (mut b))))

;; ---------------------------------------------------------------- relations

;;; A relation of up to four columns of ids, with its rows stored flat. Row
;;; membership hashes into a chain, and each column gets an index on first use.
;;; Rules queue new rows and flush after a scan, so nothing grows under a loop.
;;; A table from integers to row numbers or bucket numbers, which are never negative: open
;;; addressing on the key. A value is kept plus one, so a slot of zeros is empty, and a table is
;;; made, or grown, by zeroing memory.
(defstruct IntTable
  [(keys (ArrayList i64)) (vals (ArrayList i64)) (count i64) (mask i64) (alc (dyn Allocator))])

;;; Capacity 0: nothing allocated until the first put.
(defn int-table [(cap i64)] (-> IntTable)
  (int-table-in cap (malloc-allocator)))

;;; One whose memory comes from `a`, as it grows too.
(defn int-table-in [(cap i64) (a (dyn Allocator))] (-> IntTable)
  (let [(mut keys) (ArrayList::new [i64] a)
        (mut vals) (ArrayList::new [i64] a)]
    (when (> cap 0)
      (ArrayList::extend-zeroed! (mut keys) cap)
      (ArrayList::extend-zeroed! (mut vals) cap))
    (IntTable
      :keys keys
      :vals vals
      :count 0
      :mask (- cap 1)
      :alc a)))

;;; A capacity that holds `n` keys without growing.
(defn int-capacity [(n i64)] (-> i64)
  (let [(mut cap) 64]
    (while (< cap (* n 2)) (set! cap (* cap 2)))
    cap))

;;; The value for `key`, or -1.
(defn int-get [(t (mut IntTable)) (key i64)] (-> i64)
  (let [(mut i) (& (memo-hash key) (.mask t))
        (mut out) -1
        (mut go) (> (.count t) 0)]
    (while go
      (let [v (get (.vals t) i)]
        (cond (= v 0) (set! go false)
              (= (get (.keys t) i) key) (do (set! out (- v 1)) (set! go false))
              :else (set! i (& (+ i 1) (.mask t))))))
    out))

(defn int-put! [(t (mut IntTable)) (key i64) (val i64)] (-> void)
  (when (> (* (+ (.count t) 1) 2) (+ (.mask t) 1))
    (let [old t
          (mut bigger)
            (int-table-in (if (< (.mask t) 31) 64 (* (+ (.mask t) 1) 2)) (.alc t))]
      (for i (range 0 (len (.vals old)))
        (let [v (get (.vals old) i)]
          (when (> v 0) (int-put! (mut bigger) (get (.keys old) i) (- v 1)))))
      (free! (mut (.keys t)))
      (free! (mut (.vals t)))
      (set! t bigger)))
  (let [(mut i) (& (memo-hash key) (.mask t))
        (mut go) true]
    (while go
      (let [v (get (.vals t) i)]
        (cond (= v 0)
                (do
                  (set! (mut (.keys t)) i key)
                  (set! (mut (.vals t)) i (+ val 1))
                  (set! (.count t) (+ (.count t) 1))
                  (set! go false))
              (= (get (.keys t) i) key)
                (do (set! (mut (.vals t)) i (+ val 1)) (set! go false))
              :else (set! i (& (+ i 1) (.mask t))))))
    0))

;;; The Int keys a `distinct` has let by: the first few in place, with nothing allocated, and
;;; more than that in a table.
(defstruct IntSeen [(n i64) (small (array i64 8)) (more IntTable)])

(defn int-seen [] (-> IntSeen)
  (primitive/zeroed IntSeen))

;;; Whether `key` is new; it is not from now on.
(defn int-seen-add! [(s (mut IntSeen)) (key i64)] (-> bool)
  (let [n (.n s)
        (mut found) false]
    (for i (range 0 (if (< n 8) n 8))
      (when (= (get (.small s) i) key) (set! found true)))
    (cond found false
          (< n 8)
            (do
              (set! (mut (.small s)) n key)
              (set! (.n s) (+ n 1))
              true)
          :else
            (do
              (when (= n 8) (set! (.more s) (int-table-in 64 (value-allocator))))
              (if (>= (int-get (mut (.more s)) key) 0)
                  false
                  (do
                    (int-put! (mut (.more s)) key 0)
                    (set! (.n s) (+ n 1))
                    true))))))

;;; An index from a key to the rows holding it: a table to the bucket's number, and the buckets.
;;; A column's rows by key. Every key that occurs has a slot; a slot's rows are a chain in the
;;; order they came: its first, its last, how many, and for each row of the relation the next
;;; with the same key (`links`, -1 at a chain's end). A key costs three numbers and a row one,
;;; with no list of its own. Rows join in the relation's order, none passed over.
(defstruct Index
  [(table IntTable)
   (heads (ArrayList i32))
   (tails (ArrayList i32))
   (counts (ArrayList i32))
   (links (ArrayList i32))
   (alc (dyn Allocator))])

(defn index-new [(a (dyn Allocator))] (-> Index)
  (Index
    :table (int-table-in 0 a)
    :heads (ArrayList::new [i32] a)
    :tails (ArrayList::new [i32] a)
    :counts (ArrayList::new [i32] a)
    :links (ArrayList::new [i32] a)
    :alc a))

;;; How many slots there are: the next new key's.
(defn index-slots [(x (mut Index))] (-> i64)
  (len (.heads x)))

;;; `row` joins `slot`'s chain at its end; a slot one past the last is new.
(defn index-link! [(x (mut Index)) (slot i64) (row i64)] (-> void)
  (when (!= (len (.links x)) row)
    (panic "a relation's index takes its rows in order: row {} after {}" row (len (.links x))))
  (push! (mut (.links x)) (: -1 i32))
  (if (< slot (len (.heads x)))
      (do
        (set! (mut (.links x)) (cast i64 (get (.tails x) slot)) (cast i32 row))
        (set! (mut (.tails x)) slot (cast i32 row))
        (set! (mut (.counts x)) slot (+ (get (.counts x) slot) (: 1 i32))))
      (do
        (push! (mut (.heads x)) (cast i32 row))
        (push! (mut (.tails x)) (cast i32 row))
        (push! (mut (.counts x)) (: 1 i32))))
  0)

(defn index-push! [(x (mut Index)) (key i64) (row i64)] (-> void)
  (let [at (int-get (mut (.table x)) key)]
    (if (>= at 0)
        (index-link! (mut x) at row)
        (let [slot (index-slots (mut x))]
          (int-put! (mut (.table x)) key slot)
          (index-link! (mut x) slot row)))
    0))

;;; The rows of one key, in the order they came: as many as there were when it was asked for,
;;; whatever joins the chain meanwhile.
(defstruct RelRows [(links (ptr (ArrayList i32))) (row i64) (left i64)])

(impl Iterable RelRows
  (iter [(r RelRows)] (-> RelRows) r))

(impl Iterator RelRows
  (next [(r (mut RelRows))]
        (-> (Option i64))
        (if (> (.left r) 0)
            (let [row (.row r)]
              (set! (.left r) (- (.left r) 1))
              (set! (.row r) (cast i64 (get (load (.links r)) row)))
              (Some row))
            (None))))

(impl Len RelRows
  (len [(r RelRows)] (-> i64) (.left r)))

;;; No rows: what a query that matches nothing walks.
(defn no-rows [] (-> RelRows)
  (primitive/zeroed RelRows))

(defn index-slot-rows [(x (mut Index)) (slot i64)] (-> RelRows)
  (RelRows :links (primitive/cast (ptr (ArrayList i32)) (field x links))
           :row (cast i64 (get (.heads x) slot))
           :left (cast i64 (get (.counts x) slot))))

(defn index-rows [(x (mut Index)) (key i64)] (-> RelRows)
  (let [at (int-get (mut (.table x)) key)]
    (if (>= at 0) (index-slot-rows (mut x) at) (no-rows))))

;;; A relation's rows by what they hold: row numbers (plus one, 0 for none) in an open table, a
;;; row found by its hash and then by its columns. Four bytes a slot, and nothing else per row.
(defstruct RowTable [(slots (ArrayList i32)) (mask i64) (count i64)])

(defn row-table-in [(cap i64) (a (dyn Allocator))] (-> RowTable)
  (let [(mut slots) (ArrayList::new [i32] a)]
    (when (> cap 0) (ArrayList::extend-zeroed! (mut slots) cap))
    (RowTable :slots slots :mask (- cap 1) :count 0)))

;;; A fact's columns are numbers of 32 bits (names, symbols, parts, modules), and are kept so.
(defstruct Rel
  [(arity i64)
   (data (ArrayList i32))
   (count i64)
   (heads RowTable)  ; the rows of a relation with more than one column, or keys too big to mark
   (index (ArrayList Index))
   ;; Numeric keys map to slots (plus one) of the column's index below, with no hashing. Only
   ;; keys that occur have a slot, shared with the keys the index hashes.
   (dense (ArrayList (ArrayList i32)))
   (indexed (ArrayList i64))
   ;; By two columns at once, for `(col1 * arity + col2)`.
   (pair-index (ArrayList Index))
   (pair-indexed (ArrayList i64))
   (queue (ArrayList i64))
   ;; A one-column relation's small keys: which are there, by position, with no hashing.
   (present (ArrayList u8))
   ;; The rows the last round added, for evaluating only what they make possible.
   (seen i64)
   (delta-from i64)
   (delta-to i64)
   ;; Rows taken out, as a database is brought up to date in place (see `solved-from` in hl.facts):
   ;; each row's mark (0 in, 2 taken out by this update, 1 by an earlier one) and how many are out.
   ;; A row taken out stays where it is, in its chain and its indexes, until the relation is made
   ;; again (`rel-settle!`), and what reads the relation passes it by.
   (dead (ArrayList u8))
   (gone i64)
   ;; While an update runs, the rows below `start` are those it began with: what it reads of the
   ;; relation as it was. The rows it took out (`killed`) and the small keys whose presence it
   ;; changed (`touched`), to put right when it ends.
   (start i64)
   (updating bool)
   (killed (ArrayList i64))
   (touched (ArrayList i64))
   ;; For a relation of given facts: how many of the facts state each row.
   (counts (ArrayList i64))
   ;; How many updates have changed it in place: kept in its memory (`stamp`), which every copy of it
   ;; shares, and as this copy last saw it (`version`). A copy whose `version` is behind was made
   ;; before an update changed what it reads.
   (stamp (ArrayList i64))
   (version i64)
   ;; When its rows came: for each round of the solve that added some, the round and the first row
   ;; it added (see `rel-stamp!`). A row is explained by rows that came before it (`why` in hl.facts).
   (rounds (ArrayList i64))
   ;; Where all of its memory comes from, as it grows and is indexed, whichever thread asks: while
   ;; the run reclaims memory, a region of its own (`region`), which the region it is made in holds,
   ;; and anything else that holds the relation holds too (`rel-held!`); else malloc's.
   (alc (dyn Allocator))
   (region i64)])

;;; A relation's memory, of its own: what it is made in holds it. 0 where the run keeps everything.
(defn rel-region-new [] (-> i64)
  (let [cur (region-current)]
    (if (and (reclaiming?) (not (.lasting cur)))
        (let [r (region-new)]
          (set! (.label r) "a relation")
          (when (region-labels?) (regions-live-add! r))
          (region-ref! cur r)
          (region-release! r)
          (primitive/cast i64 r))
        0)))

;;; What is being made now holds `r`.
(defn rel-held! [(r Rel)] (-> void)
  (region-uses-id! (.region r))
  0)

(defn rel-new [(arity i64)] (-> Rel)
  (let [region (rel-region-new)
        a (if (= region 0)
              (malloc-allocator)
              (region-shared-allocator (primitive/cast (ptr Region) region)))
        (mut index) (ArrayList::new [Index] a)
        (mut indexed) (ArrayList::new [i64] a)
        (mut dense) (ArrayList::new [(ArrayList i32)] a)
        (mut pair-index) (ArrayList::new [Index] a)
        (mut pair-indexed) (ArrayList::new [i64] a)]
    (for _ (range 0 arity)
      (push! (mut index) (index-new a))
      (push! (mut dense) (ArrayList::new [i32] a))
      (push! (mut indexed) 0))
    (for _ (range 0 (* arity arity))
      (push! (mut pair-index) (index-new a))
      (push! (mut pair-indexed) 0))
    (Rel
      :alc a
      :region region
      :arity arity
      :data (ArrayList::new [i32] a)
      :count 0
      :heads (row-table-in 0 a)
      :index index
      :indexed indexed
      :dense dense
      :pair-index pair-index
      :pair-indexed pair-indexed
      :queue (ArrayList::new [i64] a)
      :present (ArrayList::new [u8] a)
      :seen 0
      :delta-from 0
      :delta-to 0
      :dead (ArrayList::new [u8] a)
      :gone 0
      :start 0
      :updating false
      :killed (ArrayList::new [i64] a)
      :touched (ArrayList::new [i64] a)
      :counts (ArrayList::new [i64] a)
      :stamp (let [(mut s) (ArrayList::new [i64] a)] (push! (mut s) 0) s)
      :version 0
      :rounds (ArrayList::new [i64] a))))

;;; Room for `n` more rows, when about that many are known to be coming: no growing as they come.
(defn rel-reserve! [(r (mut Rel)) (n i64)] (-> void)
  (reserve! (mut (.data r)) (+ (len (.data r)) (* n (.arity r))))
  (when (> (.arity r) 1)
    (let [cap (int-capacity (+ (.count r) n))]
      (when (> cap (+ (.mask (.heads r)) 1)) (rows-grow! (mut r) cap))))
  0)

(defn rel-at :inline (Always) [(r (mut Rel)) (row i64) (col i64)] (-> i64)
  (cast i64 (get (.data r) (+ (* row (.arity r)) col))))

;;; A row's hash, from its own columns: unused ones count as 0, as whoever asks passes them.
(defn row-hash-of [(r (mut Rel)) (row i64)] (-> i64)
  (let [n (.arity r)]
    (row-hash (rel-at (mut r) row 0)
              (if (>= n 2) (rel-at (mut r) row 1) 0)
              (if (>= n 3) (rel-at (mut r) row 2) 0)
              (if (>= n 4) (rel-at (mut r) row 3) 0))))

;;; The row table with `cap` slots (a power of two), every row it had in it.
(defn rows-grow! [(r (mut Rel)) (cap i64)] (-> void)
  (let [old (.heads r)
        (mut bigger) (row-table-in cap (.alc r))]
    (for i (range 0 (len (.slots old)))
      (let [s (cast i64 (get (.slots old) i))]
        (when (> s 0)
          (let [(mut at) (& (memo-hash (row-hash-of (mut r) (- s 1))) (.mask bigger))]
            (while (!= (get (.slots bigger) at) (: 0 i32))
              (set! at (& (+ at 1) (.mask bigger))))
            (set! (mut (.slots bigger)) at (cast i32 s))
            (set! (.count bigger) (+ (.count bigger) 1))))))
    (let [(mut gone) (.slots old)] (free! (mut gone)))
    (set! (.heads r) bigger)
    0))

;;; A row just appended goes in the table.
(defn rows-put! [(r (mut Rel)) (hash i64) (row i64)] (-> void)
  (when (> (* (+ (.count (.heads r)) 1) 2) (+ (.mask (.heads r)) 1))
    (rows-grow! (mut r) (if (< (.mask (.heads r)) 31) 64 (* (+ (.mask (.heads r)) 1) 2))))
  (let [(mut at) (& (memo-hash hash) (.mask (.heads r)))]
    (while (!= (get (.slots (.heads r)) at) (: 0 i32))
      (set! at (& (+ at 1) (.mask (.heads r)))))
    (set! (mut (.slots (.heads r))) at (cast i32 (+ row 1)))
    (set! (.count (.heads r)) (+ (.count (.heads r)) 1))
    0))

;;; The row that holds these columns and is in (`old`: was in as the update running began), or -1.
(defn rows-find [(r (mut Rel)) (old bool) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (if (= (.count (.heads r)) 0)
      -1
      (let [(mut at) (& (memo-hash (row-hash a b c d)) (.mask (.heads r)))
            (mut out) -1
            (mut go) true]
        (while go
          (let [s (cast i64 (get (.slots (.heads r)) at))]
            (cond (= s 0) (set! go false)
                  (and (if old (rel-old-row? (mut r) (- s 1)) (rel-live-row? (mut r) (- s 1)))
                       (row-equal? (mut r) (- s 1) a b c d))
                    (do (set! out (- s 1)) (set! go false))
                  :else (set! at (& (+ at 1) (.mask (.heads r)))))))
        out)))

;;; FNV-style mixing, which wraps on purpose.
(defn row-hash [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (let [p 1099511628211
        h1 (primitive/imul (^ -3750763034362895579 a) p)
        h2 (primitive/imul (^ h1 b) p)
        h3 (primitive/imul (^ h2 c) p)]
    (primitive/imul (^ h3 d) p)))

(defn row-equal? [(r (mut Rel)) (row i64) (a i64) (b i64) (c i64) (d i64)]
  (-> bool)
  (let [n (.arity r)]
    (and (= (rel-at (mut r) row 0) a)
         (or (< n 2) (= (rel-at (mut r) row 1) b))
         (or (< n 3) (= (rel-at (mut r) row 2) c))
         (or (< n 4) (= (rel-at (mut r) row 3) d)))))

;;; Unused columns are passed as 0.
(defn rel-has? [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> bool)
  (if (and (= (.arity r) 1) (dense-key? a))
      (and (< a (len (.present r)))
           (!= (& (cast i64 (get (.present r) a)) 1) 0))
      (>= (rows-find (mut r) false a b c d) 0)))

;;; A small key's mark in a one-column relation: 1 while the row is in; 2 once an update has changed
;;; whether it is, with 4 when it was in as the update began.
(defn present-mark [(r (mut Rel)) (a i64)] (-> i64)
  (if (< a (len (.present r))) (cast i64 (get (.present r) a)) 0))

(defn present-mark! [(r (mut Rel)) (a i64) (mark i64)] (-> void)
  (while (<= (len (.present r)) a)
    (push! (mut (.present r)) (: 0 u8)))
  (set! (mut (.present r)) a (cast u8 mark))
  0)

;;; A small key's mark as an update changes whether it is in: the first change says whether it was
;;; in as the update began, and files the key to be put right when the update ends.
(defn rel-changed-mark [(r (mut Rel)) (a i64) (mark i64)] (-> i64)
  (cond (not (.updating r)) (& mark 1)
        (!= (& mark 2) 0) mark
        :else
          (do
            (push! (mut (.touched r)) a)
            (| 2 (if (!= (& mark 1) 0) 4 0)))))

;;; Whether a row is in now: not taken out.
(defn rel-live-row? :inline (Always) [(r (mut Rel)) (row i64)] (-> bool)
  (or (= (.gone r) 0)
      (>= row (len (.dead r)))
      (= (get (.dead r) row) (: 0 u8))))

;;; Whether a row was in as the update running began: one of those it began with, not taken out
;;; before it.
(defn rel-old-row? :inline (Always) [(r (mut Rel)) (row i64)] (-> bool)
  (and (< row (.start r))
       (or (= (.gone r) 0)
           (>= row (len (.dead r)))
           (!= (get (.dead r) row) (: 1 u8)))))

;;; `rel-has?` of the relation as the update running began.
(defn rel-has-old? [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> bool)
  (if (and (= (.arity r) 1) (dense-key? a))
      (let [mark (present-mark (mut r) a)]
        (if (!= (& mark 2) 0) (!= (& mark 4) 0) (!= (& mark 1) 0)))
      (>= (rows-find (mut r) true a b c d) 0)))

(defn dense-key? :inline (Always) [(key i64)] (-> bool)
  (and (>= key 0) (< key 4194304)))

(defn index-add! [(r (mut Rel)) (col i64) (row i64)] (-> void)
  (let [key (rel-at (mut r) row col)]
    (if (dense-key? key)
        (let [d (elem (mut (.dense r)) col)
              x (elem (mut (.index r)) col)]
          (when (<= (len (load d)) key)
            (ArrayList::extend-zeroed! d (+ (- key (len (load d))) 1)))
          (when (= (get (load d) key) (: 0 i32))
            (set! d key (cast i32 (+ (index-slots x) 1))))
          (index-link! x (- (cast i64 (get (load d) key)) 1) row))
        (index-push! (elem (mut (.index r)) col) key row))))

;;; One key for two columns. Different pairs may share it, and a scan tests each column anyway.
(defn pair-key [(x i64) (y i64)] (-> i64)
  (primitive/imul (^ (primitive/imul (^ -3750763034362895579 x) 1099511628211)
                     y)
                  1099511628211))

(defn pair-index-add! [(r (mut Rel)) (slot i64) (c1 i64) (c2 i64) (row i64)]
  (-> void)
  (index-push! (elem (mut (.pair-index r)) slot)
               (pair-key (rel-at (mut r) row c1) (rel-at (mut r) row c2))
               row))

;;; True when the row is new.
(defn rel-add! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> bool)
  (if (and (= (.arity r) 1) (dense-key? a))
      (if (rel-has? (mut r) a 0 0 0)
          false
          (let [mark (present-mark (mut r) a)]
            (present-mark! (mut r) a (| (rel-changed-mark (mut r) a mark) 1))
            (rel-append! (mut r) a b c d)
            true))
      (rel-add-hashed! (mut r) a b c d)))

(defn rel-add-hashed! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> bool)
  (if (>= (rows-find (mut r) false a b c d) 0)
      false
      (do
        (rel-append! (mut r) a b c d)
        (rows-put! (mut r) (row-hash a b c d) (- (.count r) 1))
        true)))

;;; A column's value as a relation keeps it. One that does not fit is no fact's column.
(defn rel-column [(x i64)] (-> i32)
  (when (or (> x 2147483647) (< x -2147483648))
    (panic "a relation's column holds {}, which is not a number of 32 bits" x))
  (cast i32 x))

;;; A new row at the end, in its indexes.
(defn rel-append! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)]
  (-> void)
  (let [row (.count r)
        n (.arity r)]
    (when (>= row 2147483646) (panic "a relation has more rows than it can number"))
    (push! (mut (.data r)) (rel-column a))
    (when (>= n 2) (push! (mut (.data r)) (rel-column b)))
    (when (>= n 3) (push! (mut (.data r)) (rel-column c)))
    (when (>= n 4) (push! (mut (.data r)) (rel-column d)))
    (set! (.count r) (+ row 1))
    (for col (range 0 n)
      (when (!= (get (.indexed r) col) 0)
        (index-add! (mut r) col row)))
    (for c1 (range 0 n)
      (for c2 (range 0 n)
        (when (!= (get (.pair-indexed r) (+ (* c1 n) c2)) 0)
          (pair-index-add! (mut r) (+ (* c1 n) c2) c1 c2 row))))
    0))

(defn rel-queue! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> void)
  (push! (mut (.queue r)) a)
  (push! (mut (.queue r)) b)
  (push! (mut (.queue r)) c)
  (push! (mut (.queue r)) d))

;;; Move queued rows in. True when any was new.
(defn rel-flush! [(r (mut Rel))] (-> bool)
  (let [(mut changed) false
        n (/ (len (.queue r)) 4)]
    (for i (range 0 n)
      (when (rel-add! (mut r)
                      (get (.queue r) (* i 4))
                      (get (.queue r) (+ (* i 4) 1))
                      (get (.queue r) (+ (* i 4) 2))
                      (get (.queue r) (+ (* i 4) 3)))
        (set! changed true)))
    ;; A long queue's memory goes back: a relation is flushed often, and filled like that once.
    (if (> (cap (.queue r)) 4096)
        (do (free! (mut (.queue r)))
            (set! (.queue r) (ArrayList::new [i64] (.alc r))))
        (clear! (mut (.queue r))))
    changed))

;;; The rows whose column equals `key`. Stable until the next flush.
;;; An index is made the first time a query needs it. Queries may run on many threads at once
;;; once nothing adds rows, so the first to need it makes it under a lock, and says so last.
(defn rel-bucket :inline (Always) [(r (mut Rel)) (col i64) (key i64)]
  (-> RelRows)
  (when (!= (atomic/read (elem (mut (.indexed r)) col)) 1)
    (rel-index-column! (mut r) col))
  (if (dense-key? key)
      (let [d (get (.dense r) col)
            bucket (if (< key (len d)) (cast i64 (get d key)) 0)]
        (if (> bucket 0) (index-slot-rows (elem (mut (.index r)) col) (- bucket 1)) (no-rows)))
      (index-rows (elem (mut (.index r)) col) key)))

;;; The rows whose two columns equal these keys, and perhaps a few others. Stable until the next flush.
;;; The index a query needs first, made under a lock by whichever thread needs it first.
;;; Made by the first thread to need it, with the column's own word to say so: threads that need
;;; other columns, of this relation or another, make theirs meanwhile.
(defn rel-index-column! [(r (mut Rel)) (col i64)] (-> void)
  (let [flag (elem (mut (.indexed r)) col)]
    (when (once-mine? flag)
      (for row (range 0 (.count r)) (index-add! (mut r) col row))
      (once-made! flag))
    0))

;; ---------------------------------------------------------------- rules run at once
;;;
;;; A round of a stratum's rules (see `stratum-rounds` in hl.facts): `run(db, i, out)` runs rule
;;; `i`, which queues the rows it finds on `out`; the rules marked `active` run, each once, on
;;; however many threads the program has at work.

(defn row-queue! [(q (ptr (ArrayList i64))) (a i64) (b i64) (c i64) (d i64)] (-> void)
  (push! q a)
  (push! q b)
  (push! q c)
  (push! q d)
  0)

(defn rule-outs [(n i64)] (-> (ArrayList (ArrayList i64)))
  (let [(mut outs) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
    (for _ (range 0 n) (push! (mut outs) (ArrayList::new [i64] (malloc-allocator))))
    outs))

(defn rule-outs-free! [(outs (mut (ArrayList (ArrayList i64))))] (-> void)
  (for i (range 0 (len outs)) (free! (elem (mut outs) i)))
  (free! (mut outs))
  0)

(defn rule-flags [(n i64)] (-> (ArrayList bool))
  (let [(mut flags) (ArrayList::new [bool] (malloc-allocator))]
    (for _ (range 0 n) (push! (mut flags) false))
    flags))

(defstruct RulesJob
  [(next i64)
   (db (ptr i8))
   (run (fnptr (cc/C) [(ptr i8) i64 (ptr i8)] (ptr i8)))
   (active (ArrayList bool))
   (outs (ptr (ArrayList (ArrayList i64))))])

(defn rules-job [(arg (ptr i8))] (-> (ptr i8))
  (let [j (primitive/cast (ptr RulesJob) arg)
        n (len (.active j))
        (mut go) true]
    (while go
      (let [i (atomic/add (primitive/cast (ptr i64) j) 1)]
        (if (< i n)
            (when (get (.active j) i)
              (primitive/call-ptr (.run j)
                                  (.db j)
                                  i
                                  (primitive/cast (ptr i8) (elem (.outs j) i))))
            (set! go false))))
    arg))

(defn rules-run! [(db (ptr i8))
                  (run (fnptr (cc/C) [(ptr i8) i64 (ptr i8)] (ptr i8)))
                  (active (ArrayList bool))
                  (outs (mut (ArrayList (ArrayList i64))))] (-> void)
  (let [(mut count) 0]
    (for a active (when a (set! count (+ count 1))))
    (let [(mut job) (RulesJob :next 0
                              :db db
                              :run run
                              :active active
                              :outs (primitive/cast (ptr (ArrayList (ArrayList i64))) (mut outs)))]
      (if (> count 1)
          (run-map-workers (primitive/fnptr-of rules-job) (primitive/cast (ptr i8) (mut job)) (pool-size))
          (rules-job (primitive/cast (ptr i8) (mut job)))))
    0))

;;; What a round's rules queued, taken into the relations: `take(db, h, outs)` takes what the rules
;;; of head `h` queued, in their order; each of the `heads` is taken once, many at once when
;;; there is enough queued to be worth waking anyone for.
(defstruct TakeJob
  [(next i64)
   (db (ptr i8))
   (take (fnptr (cc/C) [(ptr i8) i64 (ptr i8)] (ptr i8)))
   (heads i64)
   (outs (ptr i8))])

(defn take-job [(arg (ptr i8))] (-> (ptr i8))
  (let [j (primitive/cast (ptr TakeJob) arg)
        (mut go) true]
    (while go
      (let [i (atomic/add (primitive/cast (ptr i64) j) 1)]
        (if (< i (.heads j))
            (primitive/call-ptr (.take j) (.db j) i (.outs j))
            (set! go false))))
    arg))

(defn rules-take! [(db (ptr i8))
                   (take (fnptr (cc/C) [(ptr i8) i64 (ptr i8)] (ptr i8)))
                   (heads i64)
                   (outs (mut (ArrayList (ArrayList i64))))] (-> void)
  (let [(mut queued) 0]
    (for i (range 0 (len outs)) (set! queued (+ queued (len (get outs i)))))
    (let [(mut job) (TakeJob :next 0
                             :db db
                             :take take
                             :heads heads
                             :outs (primitive/cast (ptr i8) (mut outs)))]
      (if (and (> heads 1) (> queued 16000))
          (run-map-workers (primitive/fnptr-of take-job) (primitive/cast (ptr i8) (mut job)) (pool-size))
          (take-job (primitive/cast (ptr i8) (mut job)))))
    0))

;;; The rows a rule queued, added to its head's relation. True when any was new.
(defn rel-take! [(r (mut Rel)) (rows (ptr (ArrayList i64)))] (-> bool)
  (let [(mut changed) false
        q (load rows)
        n (/ (len q) 4)]
    ;; Room in the table of rows for all that is queued, at once: grown a doubling at a time,
    ;; every row it holds is placed again each time.
    (when (and (> n 256) (> (.arity r) 1))
      (let [need (* (+ (.count (.heads r)) n 1) 2)]
        (when (> need (+ (.mask (.heads r)) 1))
          (let [(mut cap) 64]
            (while (< cap need) (set! cap (* cap 2)))
            (rows-grow! (mut r) cap)))))
    (for i (range 0 n)
      (when (rel-add! (mut r)
                      (get q (* i 4))
                      (get q (+ (* i 4) 1))
                      (get q (+ (* i 4) 2))
                      (get q (+ (* i 4) 3)))
        (set! changed true)))
    (clear! rows)
    changed))

(defn rel-bucket2 [(r (mut Rel)) (c1 i64) (c2 i64) (k1 i64) (k2 i64)]
  (-> RelRows)
  (let [slot (+ (* c1 (.arity r)) c2)
        flag (elem (mut (.pair-indexed r)) slot)]
    (when (once-mine? flag)
      (set! (.table (elem (mut (.pair-index r)) slot))
            (int-table-in (int-capacity (.count r)) (.alc r)))
      (for row (range 0 (.count r)) (pair-index-add! (mut r) slot c1 c2 row))
      (once-made! flag))
    (index-rows (elem (mut (.pair-index r)) slot) (pair-key k1 k2))))

;; -------------------------------------------------------------- relations updated, not solved again

;;; One of `r`'s rows, its columns as `rel-add!` takes them.
(defn row-col [(r (mut Rel)) (row i64) (col i64)] (-> i64)
  (if (< col (.arity r)) (rel-at (mut r) row col) 0))

;;; A database's id of its own, one more than the last: which a database made from it in place names.
(defn db-id-next! [] (-> i64)
  (let [cell (primitive/alloc-static DbIds)]
    (+ (atomic/add (field cell next) 1) 1)))

(defstruct DbIds [(next i64)])

;;; ---------------------------------------------------------------- updated in place

;;; An update in place begins (see `solved-from` in hl.facts): the rows there now are what it reads
;;; as the relation as it was, whatever it adds or takes out.
(defn rel-begin! [(r (mut Rel))] (-> void)
  (unless (= (len (.queue r)) 0)
    (panic "a relation with rows still queued cannot be brought up to date"))
  (set! (.start r) (.count r))
  (set! (.updating r) true)
  (clear! (mut (.killed r)))
  (clear! (mut (.touched r)))
  (set! (mut (.stamp r)) 0 (+ (get (.stamp r) 0) 1))
  (set! (.version r) (get (.stamp r) 0))
  0)

;;; Whether this copy of a relation is what its memory holds: no update has changed it in place since.
(defn rel-current? [(r (mut Rel))] (-> bool)
  (= (get (.stamp r) 0) (.version r)))

;;; The row that holds these columns now, or -1.
(defn rel-find [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> i64)
  (if (and (= (.arity r) 1) (dense-key? a))
      (if (!= (& (present-mark (mut r) a) 1) 0)
          (let [rows (rel-bucket (mut r) 0 a)
                (mut out) -1]
            (for row rows
              (when (and (< out 0) (rel-live-row? (mut r) row)) (set! out row)))
            out)
          -1)
      (rows-find (mut r) false a b c d)))

;;; An aggregate being worked out (`count`, `sum`, `min`, `max` in a `.facts` rule's head): its groups
;;; as rows of a relation of their columns, in the order first met, and each group's value so far.
;;; `kind`: 1 count, 2 sum, 3 min, 4 max. A group of no columns is the one row 0.
(defstruct Agg [(groups Rel) (values (ArrayList i64)) (kind i64)])

(defn agg-new [(columns i64) (kind i64)] (-> Agg)
  (Agg :groups (rel-new (if (> columns 0) columns 1))
       :values (ArrayList::new [i64] (value-allocator))
       :kind kind))

;;; One more of the body's answers, in the group `a b c`, with `v` the aggregated column's value.
(defn agg-step! [(g (mut Agg)) (a i64) (b i64) (c i64) (v i64)] (-> void)
  (if (rel-add! (mut (.groups g)) a b c 0)
      (push! (mut (.values g)) (if (= (.kind g) 1) 1 v))
      (let [row (rel-find (mut (.groups g)) a b c 0)
            old (get (.values g) row)]
        (set! (mut (.values g))
              row
              (cond (= (.kind g) 1) (+ old 1)
                    (= (.kind g) 2) (+ old v)
                    (= (.kind g) 3) (if (< v old) v old)
                    :else (if (> v old) v old)))))
  0)

(defn agg-count [(g (mut Agg))] (-> i64) (len (.values g)))
(defn agg-group [(g (mut Agg)) (row i64) (col i64)] (-> i64) (rel-at (mut (.groups g)) row col))
(defn agg-value [(g (mut Agg)) (row i64)] (-> i64) (get (.values g) row))

;;; Take out the row that holds these columns. True when one did. It stays where it is, passed by,
;;; until the relation is made again.
(defn rel-kill! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64)] (-> bool)
  (let [row (rel-find (mut r) a b c d)]
    (if (< row 0)
        false
        (do
          (while (<= (len (.dead r)) row)
            (push! (mut (.dead r)) (: 0 u8)))
          (set! (mut (.dead r)) row (if (.updating r) (: 2 u8) (: 1 u8)))
          (set! (.gone r) (+ (.gone r) 1))
          (when (.updating r) (push! (mut (.killed r)) row))
          (when (and (= (.arity r) 1) (dense-key? a))
            (present-mark! (mut r)
                           a
                           (& (rel-changed-mark (mut r) a (present-mark (mut r) a)) 6)))
          true))))

;;; Take out each row `gone` holds; then every row there is counted seen, so what is added after is
;;; what the next round starts from. Answers how many were taken out.
(defn rel-kill-rows! [(r (mut Rel)) (gone (mut Rel))] (-> i64)
  (let [(mut n) 0]
    (for row (range 0 (.count gone))
      (when (and (rel-live-row? (mut gone) row)
                 (rel-kill! (mut r)
                            (row-col (mut gone) row 0)
                            (row-col (mut gone) row 1)
                            (row-col (mut gone) row 2)
                            (row-col (mut gone) row 3)))
        (set! n (+ n 1))))
    (set! (.seen r) (.count r))
    n))

;;; The update ends: what it took out is out as an earlier update's is, and the keys it changed are
;;; marked plainly again. A relation more than half taken out is made again of what is in, in its
;;; own memory, so what was taken out goes with the memory it was in.
(defn rel-settle! [(r (mut Rel))] (-> void)
  (for row (.killed r) (set! (mut (.dead r)) row (: 1 u8)))
  (for a (.touched r) (present-mark! (mut r) a (& (present-mark (mut r) a) 1)))
  (clear! (mut (.killed r)))
  (clear! (mut (.touched r)))
  (set! (.updating r) false)
  (set! (.start r) (.count r))
  (when (and (> (.gone r) 64) (> (* (.gone r) 2) (.count r)))
    (set! r (rel-compacted (mut r))))
  0)

;;; A relation of its own with the rows of `r` that are in, in their order, and how many facts state
;;; each; every row counted seen.
(defn rel-compacted [(r (mut Rel))] (-> Rel)
  (let [(mut out) (rel-new (.arity r))
        counted (> (len (.counts r)) 0)]
    (rel-reserve! (mut out) (- (.count r) (.gone r)))
    (for row (range 0 (.count r))
      (when (rel-live-row? (mut r) row)
        (rel-add! (mut out)
                  (row-col (mut r) row 0)
                  (row-col (mut r) row 1)
                  (row-col (mut r) row 2)
                  (row-col (mut r) row 3))
        (when counted (push! (mut (.counts out)) (rel-count-at (mut r) row)))))
    (set! (.seen out) (.count out))
    (set! (.start out) (.count out))
    out))

;;; Every row that is in, taken out: what solving a stratum afresh in place starts from. Every row
;;; counted seen.
(defn rel-kill-all! [(r (mut Rel))] (-> void)
  (for row (range 0 (.count r))
    (when (rel-live-row? (mut r) row)
      (rel-kill! (mut r)
                 (row-col (mut r) row 0)
                 (row-col (mut r) row 1)
                 (row-col (mut r) row 2)
                 (row-col (mut r) row 3))))
  (set! (.seen r) (.count r))
  0)

;;; What an update that solved the relation afresh changed: the rows in now that were not as it began
;;; (to `plus`), and those in as it began that are not now (to `minus`).
(defn rel-whole-diff! [(r (mut Rel)) (plus (mut Rel)) (minus (mut Rel))] (-> void)
  (for row (range 0 (.count r))
    (let [a (row-col (mut r) row 0)
          b (row-col (mut r) row 1)
          c (row-col (mut r) row 2)
          d (row-col (mut r) row 3)]
      (when (and (rel-live-row? (mut r) row) (not (rel-has-old? (mut r) a b c d)))
        (rel-add! (mut plus) a b c d))
      (when (and (rel-old-row? (mut r) row) (not (rel-has? (mut r) a b c d)))
        (rel-add! (mut minus) a b c d))))
  0)

;;; How many rows are in.
(defn rel-live-count [(r (mut Rel))] (-> i64)
  (- (.count r) (.gone r)))

;;; How many of the given facts state row `row`.
(defn rel-count-at [(r (mut Rel)) (row i64)] (-> i64)
  (if (< row (len (.counts r))) (get (.counts r) row) 0))

(defn rel-count-set! [(r (mut Rel)) (row i64) (n i64)] (-> void)
  (while (<= (len (.counts r)) row)
    (push! (mut (.counts r)) 0))
  (set! (mut (.counts r)) row n)
  0)

;;; One more fact states this row (`by` more, or fewer when negative): the row added when it is new.
(defn rel-tally! [(r (mut Rel)) (a i64) (b i64) (c i64) (d i64) (by i64)] (-> void)
  (if (rel-add! (mut r) a b c d)
      (rel-count-set! (mut r) (- (.count r) 1) by)
      (let [row (rel-find (mut r) a b c d)]
        (rel-count-set! (mut r) row (+ (rel-count-at (mut r) row) by))))
  0)

;;; How many rows of `tally` say a change: an upper bound on how many rows of the relation they
;;; tally will be added or taken out.
(defn rel-tally-changes [(tally (mut Rel))] (-> i64)
  (let [(mut n) 0]
    (for row (range 0 (.count tally))
      (unless (= (rel-count-at (mut tally) row) 0) (set! n (+ n 1))))
    n))

;;; Each row of `tally` by how many more (or fewer) facts state it: a row no fact stated before is
;;; added to `r` and to `plus`; one no fact states now is taken out of `r` and added to `minus`.
;;; Answers how many rows were added or taken out.
(defn rel-apply-tally! [(r (mut Rel)) (tally (mut Rel)) (plus (mut Rel)) (minus (mut Rel))]
  (-> i64)
  (let [(mut n) 0]
    (for row (range 0 (.count tally))
      (let [by (rel-count-at (mut tally) row)]
        (unless (= by 0)
          (let [a (row-col (mut tally) row 0)
                b (row-col (mut tally) row 1)
                c (row-col (mut tally) row 2)
                d (row-col (mut tally) row 3)
                at (rel-find (mut r) a b c d)
                was (if (< at 0) 0 (rel-count-at (mut r) at))
                now (+ was by)]
            (when (< now 0)
              (panic "a fact is counted out of a relation more often than it was counted in"))
            (cond (and (= was 0) (> now 0))
                    (do
                      (when (>= at 0)
                        (panic "a relation of given facts holds a row no fact states"))
                      (rel-add! (mut r) a b c d)
                      (rel-count-set! (mut r) (- (.count r) 1) now)
                      (rel-add! (mut plus) a b c d)
                      (set! n (+ n 1)))
                  (and (> was 0) (= now 0))
                    (do
                      (rel-kill! (mut r) a b c d)
                      (rel-add! (mut minus) a b c d)
                      (set! n (+ n 1)))
                  :else (rel-count-set! (mut r) at now))))))
    n))

;;; `r` made to hold just what `tally` counts, each row stated by as many facts as it says: what it
;;; held that `tally` has not taken out (and added to `minus`), what `tally` has that it had not
;;; added (and to `plus`). For a relation whose counts are not known: one read back from the cache.
(defn rel-reset-tally! [(r (mut Rel)) (tally (mut Rel)) (plus (mut Rel)) (minus (mut Rel))]
  (-> i64)
  (let [(mut n) 0
        before (.count r)]
    (for row (range 0 before)
      (when (rel-live-row? (mut r) row)
        (let [a (row-col (mut r) row 0)
              b (row-col (mut r) row 1)
              c (row-col (mut r) row 2)
              d (row-col (mut r) row 3)]
          (when (< (rel-find (mut tally) a b c d) 0)
            (rel-kill! (mut r) a b c d)
            (rel-add! (mut minus) a b c d)
            (set! n (+ n 1))))))
    (for row (range 0 (.count tally))
      (let [a (row-col (mut tally) row 0)
            b (row-col (mut tally) row 1)
            c (row-col (mut tally) row 2)
            d (row-col (mut tally) row 3)
            at (rel-find (mut r) a b c d)]
        (if (< at 0)
            (do
              (rel-add! (mut r) a b c d)
              (rel-count-set! (mut r) (- (.count r) 1) (rel-count-at (mut tally) row))
              (rel-add! (mut plus) a b c d)
              (set! n (+ n 1)))
            (rel-count-set! (mut r) at (rel-count-at (mut tally) row)))))
    n))

;;; The rows that are in, every column of each, in order: what a database says it gained or lost.
(defn rel-rows [(r (mut Rel))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (value-allocator))]
    (for row (range 0 (.count r))
      (when (rel-live-row? (mut r) row)
        (for c (range 0 (.arity r)) (push! (mut out) (rel-at (mut r) row c)))))
    out))

;;; A list of its own with `xs`'s items.
(defn ints-copy [(xs (ArrayList i64))] (-> (ArrayList i64))
  (ints-copy-in xs (value-allocator)))

(defn ints-copy-in [(xs (ArrayList i64)) (a (dyn Allocator))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] a)]
    (reserve! (mut out) (len xs))
    (for x xs (push! (mut out) x))
    out))

;;; Rows `from` to `to` of `a` that `b` has not, added to `out`. Answers how many.
(defn rel-range-diff-into! [(a (mut Rel))
                            (from i64)
                            (to i64)
                            (b (mut Rel))
                            (out (mut Rel))] (-> i64)
  (let [(mut n) 0]
    (for row (range from to)
      (when (rel-live-row? (mut a) row)
        (let [x0 (row-col (mut a) row 0)
              x1 (row-col (mut a) row 1)
              x2 (row-col (mut a) row 2)
              x3 (row-col (mut a) row 3)]
          (unless (rel-has? (mut b) x0 x1 x2 x3)
            (when (rel-add! (mut out) x0 x1 x2 x3) (set! n (+ n 1)))))))
    n))

;;; Rows of `a` that `b` has not, added to `out`. Answers how many.
(defn rel-diff-into! [(a (mut Rel)) (b (mut Rel)) (out (mut Rel))] (-> i64)
  (rel-range-diff-into! (mut a) 0 (.count a) (mut b) (mut out)))

;;; Whether `a` and `b` hold the same rows, whatever their order.
(defn rel-same-rows? [(a (mut Rel)) (b (mut Rel))] (-> bool)
  (and (= (rel-live-count (mut a)) (rel-live-count (mut b)))
       (let [(mut none) (rel-new (.arity a))]
         (= (rel-diff-into! (mut a) (mut b) (mut none)) 0))))

;;; Whether the environment variable `name` is set.
;;; Whether an environment variable says exactly this.
(defn env-is? [(name (slice u8)) (value (slice u8))] (-> bool)
  (let [c (str/to-cstr (malloc-allocator) name)
        found (os/getenv c)
        same (and (!= (primitive/cast i64 found) 0) (= (str/from-cstr found) value))]
    (primitive/free (primitive/cast (ptr i8) c))
    same))

(defn env-on? [(name (slice u8))] (-> bool)
  (let [c (str/to-cstr (malloc-allocator) name)
        on (!= (primitive/cast i64 (os/getenv c)) 0)]
    (primitive/free (primitive/cast (ptr i8) c))
    on))

;;; Start a round: what arrived since the last start is now the delta. True when there is any.
(defn rel-advance! [(r (mut Rel))] (-> bool)
  (set! (.delta-from r) (.seen r))
  (set! (.delta-to r) (.count r))
  (set! (.seen r) (.count r))
  (< (.delta-from r) (.delta-to r)))

;;; The rows the last advance made new came in round `time` of the solve.
(defn rel-stamp! [(r (mut Rel)) (time i64)] (-> void)
  (when (< (.delta-from r) (.delta-to r))
    (push! (mut (.rounds r)) time)
    (push! (mut (.rounds r)) (.delta-from r)))
  0)

;;; The round row `row` came in; -1 for a given fact, there before any round.
(defn rel-row-time [(r (mut Rel)) (row i64)] (-> i64)
  (let [(mut time) -1
        (mut i) 0
        n (/ (len (.rounds r)) 2)]
    (while (and (< i n) (<= (get (.rounds r) (+ (* 2 i) 1)) row))
      (set! time (get (.rounds r) (* 2 i)))
      (set! i (+ i 1)))
    time))

(defn rel-delta? :inline (Always) [(r (mut Rel))] (-> bool)
  (< (.delta-from r) (.delta-to r)))

;; ---------------------------------------------------------------- graphs

;;; A depth-first walk of the graph `children` describes, from each root in turn and through each
;;; node's children in the order it gives them: each node once, in the order the walk first reaches
;;; it (`pre`); what reached it, as the index in `pre` of that node and which of its children it was,
;;; or -1 for a root (`parent`, `slot`); and the indexes in `pre` in the order the walk finishes
;;; each (`post`). A node's children are asked for once, when it is reached.
(defstruct Walk
  [(pre (ArrayList (slice u8)))
   (post (ArrayList i64))
   (parent (ArrayList i64))
   (slot (ArrayList i64))
   ;; Where each of a node's children is in `pre`, in the order it gave them: whoever follows an
   ;; edge has the node it leads to by number, with no name to look up.
   (targets (ArrayList (ArrayList i64)))])

;;; Where a walk is: the nodes from a root down, each one's children, and the next of them to try.
(defstruct WalkPath
  [(at (ArrayList i64))
   (kids (ArrayList (ArrayList (slice u8))))
   (next (ArrayList i64))])

(defn walk-reach! [(w (mut Walk))
                   (seen (mut (HashMap (slice u8) i64)))
                   (path (mut WalkPath))
                   (children (fnptr (cc/C) [(slice u8)] (ArrayList (slice u8))))
                   (node (slice u8))
                   (parent i64)
                   (slot i64)]
  (-> void)
  (let [i (len (.pre w))]
    (set! (mut seen) node i)
    (push! (mut (.pre w)) node)
    (push! (mut (.parent w)) parent)
    (push! (mut (.slot w)) slot)
    (push! (mut (.targets w)) (ArrayList::new [i64] (tree-allocator)))
    (push! (mut (.at path)) i)
    (push! (mut (.kids path)) (children node))
    (push! (mut (.next path)) 0)
    0))

;;; Where a text is and how long, as one number: the same for the same bytes in the same place,
;;; and for no other text. 0 for an empty text and for one of 64 KB or more, which have none.
(defn text-place :inline (Always) [(s (slice u8))] (-> i64)
  (if (and (> (len s) 0) (< (len s) 65536))
      (^ (primitive/cast i64 (data s)) (<< (len s) 48))
      0))

(defn depth-first [(roots (ArrayList (slice u8)))
                   (children (fnptr (cc/C) [(slice u8)] (ArrayList (slice u8))))]
  (-> Walk)
  (let [(mut w)
          (Walk
            :pre (ArrayList::new [(slice u8)] (tree-allocator))
            :post (ArrayList::new [i64] (tree-allocator))
            :parent (ArrayList::new [i64] (tree-allocator))
            :slot (ArrayList::new [i64] (tree-allocator))
            :targets (ArrayList::new [(ArrayList i64)] (tree-allocator)))
        ;; Every node's text is the walk's own (`pre`), for as long as this table is.
        (mut seen)
          (HashMap::new [(slice u8) i64] (value-allocator) (held-keyops))
        ;; Where a text led, by where the text itself is: many nodes are named by one text many
        ;; times over (what an import resolves to is worked out once for all that import it from
        ;; one place), and such a name is found again without being read.
        (mut by-place) (int-table-in 0 (value-allocator))
        (mut path)
          (WalkPath
            :at (ArrayList::new [i64] (value-allocator))
            :kids (ArrayList::new [(ArrayList (slice u8))] (value-allocator))
            :next (ArrayList::new [i64] (value-allocator)))]
    (for r roots
      (match (get seen r)
        (Some [_] 0)
        (None []
              (walk-reach! (mut w) (mut seen) (mut path) children r -1 -1)
              (while (> (len (.at path)) 0)
                (let [top (- (len (.at path)) 1)
                      k (get (.next path) top)
                      ks (get (.kids path) top)]
                  (if (< k (len ks))
                      (let [c (get ks k)
                            from (get (.at path) top)
                            place (text-place c)
                            known (if (!= place 0) (int-get (mut by-place) place) -1)]
                        (set! (mut (.next path)) top (+ k 1))
                        (if (>= known 0)
                            (do (push! (elem (mut (.targets w)) from) known) 0)
                            (match (get seen c)
                              (Some [at]
                                    (do
                                      (when (!= place 0) (int-put! (mut by-place) place at))
                                      (push! (elem (mut (.targets w)) from) at)
                                      0))
                              (None []
                                    (when (!= place 0) (int-put! (mut by-place) place (len (.pre w))))
                                    (push! (elem (mut (.targets w)) from) (len (.pre w)))
                                    (walk-reach! (mut w)
                                                 (mut seen)
                                                 (mut path)
                                                 children
                                                 c
                                                 from
                                                 k)))))
                      (do
                        (push! (mut (.post w)) (get (.at path) top))
                        (pop! (mut (.at path)))
                        (pop! (mut (.kids path)))
                        (pop! (mut (.next path)))
                        0))))
              0)))
    w))

;;; Strings to the dense ids relations hold.
(defstruct Names [(ids (HashMap (slice u8) i64)) (strs (ArrayList (slice u8)))])

(defn names-new [] (-> Names)
  (Names
    :ids (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))
    :strs (ArrayList::new [(slice u8)] (malloc-allocator))))

;;; A copy that interns apart from `ns`, with the same ids.
(defn names-copy [(ns Names)] (-> Names)
  (let [(mut out) (names-new)]
    (for s (.strs ns) (intern! (mut out) s))
    out))

;;; Whether two interners hold the same names, with the same ids.
(defn names-same? [(a Names) (b Names)] (-> bool)
  (and (= (len (.strs a)) (len (.strs b)))
       (block :same
         (for i (range 0 (len (.strs a)))
           (unless (= (get (.strs a) i) (get (.strs b) i))
             (return-from :same false)))
         true)))

(defn intern! [(ns (mut Names)) (s (slice u8))] (-> i64)
  (match (get (.ids ns) s)
    (Some [id] id)
    (None []
          (if (names-recording?) (name-record! s) (name-new! (mut ns) s)))))

;;; Names met while a stage's work looks for the names it will need (`names by` in the pipeline
;;; language). A name's id is its place in the order names are first met, and a map run on many
;;; threads meets them in no order: so the map runs once only to say which names each element
;;; needs, these are given ids in the elements' order, as one thread would have met them, and
;;; the map runs again with every name known. While it looks, a name not yet known is noted with
;;; the element that asked, by the thread that met it, and answered -1.
(defstruct NameNote [(item i64) (name (slice u8))])

(defstruct NamesRecord [(on i64) (notes (ArrayList (ArrayList NameNote)))])

(defn names-record [] (-> (ptr NamesRecord))
  (primitive/alloc-static NamesRecord))

(defn names-recording? :inline (Always) [] (-> bool)
  (= (atomic/read (field (names-record) on)) 1))

;;; Which element of a map this thread works on from here.
(defn item-current :inline (Always) [] (-> i64) (.item (thread-regions)))

(defn item-begin! :inline (Always) [(i i64)] (-> void)
  (set! (.item (thread-regions)) i)
  0)

(defn name-record! [(s (slice u8))] (-> i64)
  (let [r (names-record)
        t (thread-regions)]
    (push! (elem (mut (.notes r)) (worker-slot))
           (NameNote :item (.item t) :name (own-text s)))
    (set! (.name-notes t) (+ (.name-notes t) 1))
    -1))

;;; How many names this thread has noted so far: more after a computation than before it means
;;; its answer may hold a name's -1.
(defn name-notes :inline (Always) [] (-> i64)
  (.name-notes (thread-regions)))

(defn names-record-begin! [] (-> void)
  (let [r (names-record)]
    (when (= (len (.notes r)) 0)
      (set! (.notes r) (ArrayList::new [(ArrayList NameNote)] (malloc-allocator)))
      (for _ (range 0 (max-workers))
        (push! (mut (.notes r)) (ArrayList::new [NameNote] (malloc-allocator)))))
    (atomic/store (field r on) 1)
    0))

;;; The names noted, each given to `namer` in the order of the elements that asked, and within an
;;; element in the order it asked: `count` elements in all.
(defn names-record-end! [(namer (fnptr (cc/C) [(slice u8)] i64)) (count i64)] (-> void)
  (let [r (names-record)
        (mut by-item) (ArrayList::new [(ArrayList (slice u8))] (malloc-allocator))]
    (atomic/store (field r on) 0)
    (for _ (range 0 count)
      (push! (mut by-item) (ArrayList::new [(slice u8)] (malloc-allocator))))
    (for slot (range 0 (len (.notes r)))
      (for note (get (.notes r) slot)
        (when (or (< (.item note) 0) (>= (.item note) count))
          (panic "a recorded name has no item in its stage: {} of {}" (.item note) count))
        (push! (elem (mut by-item) (.item note)) (.name note)))
      (clear! (elem (mut (.notes r)) slot)))
    (for i (range 0 count)
      (for name (get by-item i)
        (primitive/call-ptr namer name)
        (free [u8] (malloc-allocator) name))
      (free! (elem (mut by-item) i)))
    (free! (mut by-item))
    0))

(defn name-new! [(ns (mut Names)) (s (slice u8))] (-> i64)
  (match (get (.ids ns) s)
    (Some [id] id)
    (None []
          ;; A table that grows under one job is read wrong by the others.
          (when (in-job?)
            (panic "the name {} is new to the build's table while several jobs run: a stage whose work meets new names says `names by` in the pipeline" s))
          ;; Its own copy: the text is a value, of whatever region made it.
          (let [id (len (.strs ns))
                kept (own-text s)]
            (set! (mut (.ids ns)) kept id)
            (push! (mut (.strs ns)) kept)
            id))))

;;; An id's string, and nothing for an id it never gave: so asking a table of another build, which
;;; may hold fewer, is safe.
(defn name-of [(ns Names) (id i64)] (-> (slice u8))
  (if (and (>= id 0) (< id (len (.strs ns)))) (get (.strs ns) id) ""))

(defn name-count [(ns Names)] (-> i64)
  (len (.strs ns)))

;;; A string's id if it has one, and -1 if it was never interned: a lookup that changes nothing.
(defn known-name [(ns Names) (s (slice u8))] (-> i64)
  (match (get (.ids ns) s) (Some [id] id) (None [] -1)))

;;; Blocks of numbers by key: where each key's block starts, kept from one use to the next while it
;;; is big enough; a key whose block is too small, or that has none, gets a new one at the end. So a
;;; key that grows, or appears, moves nothing but itself. Numbers no key uses any more stay empty.
(defstruct Places
  [(slot (HashMap (slice u8) i64))
   (starts (ArrayList i64))
   (sizes (ArrayList i64))
   (keys (ArrayList (slice u8)))
   (end i64)])

(defn places-new [] (-> Places)
  (Places
    ;; A key is one text, here and in `keys`, which holds it for as long as this does (see
    ;; `place-key`). A key is looked up once for its place among `keys`, where its block's start
    ;; and size are.
    :slot (HashMap::new [(slice u8) i64] (malloc-allocator) (held-keyops))
    :starts (ArrayList::new [i64] (malloc-allocator))
    :sizes (ArrayList::new [i64] (malloc-allocator))
    :keys (ArrayList::new [(slice u8)] (malloc-allocator))
    :end 0))

;;; A key as a table of places holds it: the text itself when it lives as long as the program
;;; (a run that reclaims nothing, and a text not in scratch storage), else the program's own copy.
(defn place-key [(key (slice u8))] (-> (slice u8))
  (if (or (reclaiming?) (= (len key) 0) (scratch-space-holds? (primitive/cast i64 (data key))))
      (kept-text key)
      key))

;;; Where `key`'s block of `size` numbers starts: its block if it holds that many, else a new one.
(defn place! [(p (mut Places)) (key (slice u8)) (size i64)] (-> i64)
  (match (get (.slot p) key)
    (Some [i]
          (if (>= (get (.sizes p) i) size)
              (get (.starts p) i)
              (let [a (.end p)]
                (set! (mut (.starts p)) i a)
                (set! (mut (.sizes p)) i size)
                (set! (.end p) (+ a size))
                a)))
    (None []
          (let [a (.end p)
                i (len (.keys p))
                kept (place-key key)]
            (push! (mut (.keys p)) kept)
            (push! (mut (.starts p)) a)
            (push! (mut (.sizes p)) size)
            (set! (mut (.slot p)) kept i)
            (set! (.end p) (+ a size))
            a))))

;;; Where `key`'s block starts, or -1 when it has none: a lookup that changes nothing.
(defn place-of [(p Places) (key (slice u8))] (-> i64)
  (match (get (.slot p) key) (Some [i] (get (.starts p) i)) (None [] -1)))

(defn place-size [(p Places) (key (slice u8))] (-> i64)
  (match (get (.slot p) key) (Some [i] (get (.sizes p) i)) (None [] -1)))

;;; The first number no block holds.
(defn places-end [(p Places)] (-> i64)
  (.end p))

;;; Whether two have the same blocks, in the same places.
(defn places-same? [(a Places) (b Places)] (-> bool)
  (and (= (.end a) (.end b))
       (= (len (.keys a)) (len (.keys b)))
       (block :same
         (for key (.keys a)
           (unless (and (= (place-of a key) (place-of b key))
                        (= (place-size a key) (place-size b key)))
             (return-from :same false)))
         true)))

;;; Ranks that keep keys in order: each key's rank, kept from one order to the next while the key
;;; stays in order with the keys around it, so a key that arrives, or moves, takes a rank between its
;;; new neighbours' and no other key's changes. Ranks are spaced apart to leave room; only when a run
;;; of new keys finds no room between its neighbours is every key ranked afresh. `version` counts the
;;; orders that changed any rank.
(defstruct Ranks
  [(at (HashMap (slice u8) i64))
   (keys (ArrayList (slice u8)))
   (version i64)])

(defn ranks-new [] (-> Ranks)
  (Ranks
    :at (HashMap::new [(slice u8) i64] (malloc-allocator) (kept-keyops))
    :keys (ArrayList::new [(slice u8)] (malloc-allocator))
    :version 0))

;;; A key's rank, or -1 when it has none.
(defn rank-of [(r Ranks) (key (slice u8))] (-> i64)
  (match (get (.at r) key) (Some [n] n) (None [] -1)))

(defn ranks-version [(r Ranks)] (-> i64)
  (.version r))

(defn rank-gap [] (-> i64)
  1048576)

;;; Ranks for `keys`, in that order, each greater than the one before: the most keys that can keep
;;; the ranks they had keep them (the longest run of them already in order), and the rest are spread
;;; between their neighbours.
(defn rank! [(r (mut Ranks)) (keys (ArrayList (slice u8)))] (-> (ArrayList i64))
  (let [n (len keys)
        (mut old) (ArrayList::new [i64] (value-allocator))
        (mut kept) (ArrayList::new [bool] (value-allocator))
        (mut out) (ArrayList::new [i64] (value-allocator))]
    (for key keys (push! (mut old) (rank-of r key)) (push! (mut kept) false) (push! (mut out) 0))
    ;; The longest strictly increasing run of old ranks, by patience: `tails[j]` ends the best run of
    ;; length j + 1 found so far, and each key links to the key before it in its run.
    (let [(mut tails) (ArrayList::new [i64] (value-allocator))
          (mut before) (ArrayList::new [i64] (value-allocator))]
      (for i (range 0 n)
        (push! (mut before) -1)
        (let [o (get old i)]
          (when (>= o 0)
            (let [(mut lo) 0
                  (mut hi) (len tails)]
              (while (< lo hi)
                (let [mid (/ (+ lo hi) 2)]
                  (if (< (get old (get tails mid)) o) (set! lo (+ mid 1)) (set! hi mid))))
              (when (> lo 0) (set! (mut before) i (get tails (- lo 1))))
              (if (= lo (len tails)) (push! (mut tails) i) (set! (mut tails) lo i))))))
      (let [(mut at) (if (> (len tails) 0) (get tails (- (len tails) 1)) -1)]
        (while (>= at 0)
          (set! (mut kept) at true)
          (set! at (get before at)))))
    ;; Each run of keys that keep no rank, between the kept ranks around it.
    (let [(mut room) true
          (mut i) 0]
      (while (and room (< i n))
        (if (get kept i)
            (do (set! (mut out) i (get old i)) (set! i (+ i 1)))
            (let [(mut j) i]
              (while (and (< j n) (not (get kept j))) (set! j (+ j 1)))
              (let [m (- j i)
                    lo (if (> i 0) (get out (- i 1)) -1)
                    hi (if (< j n) (get old j) (+ lo (* (rank-gap) (+ m 1))))]
                (if (< (- hi lo 1) m)
                    (set! room false)
                    (let [step (/ (- hi lo) (+ m 1))]
                      (for k (range 0 m) (set! (mut out) (+ i k) (+ lo (* step (+ k 1)))))))
                (set! i j)))))
      (unless room
        (for i (range 0 n) (set! (mut out) i (* (rank-gap) (+ i 1))))))
    (let [(mut changed) false]
      (for i (range 0 n)
        (let [key (get keys i)]
          (unless (= (get old i) (get out i))
            (set! changed true)
            (when (< (get old i) 0) (push! (mut (.keys r)) (kept-text key)))
            (set! (mut (.at r)) key (get out i)))))
      (when changed (set! (.version r) (+ (.version r) 1))))
    out))

;;; Whether two give the same keys the same ranks.
(defn ranks-same? [(a Ranks) (b Ranks)] (-> bool)
  (and (= (len (.keys a)) (len (.keys b)))
       (block :same
         (for key (.keys a)
           (unless (= (rank-of a key) (rank-of b key)) (return-from :same false)))
         true)))

;; ---------------------------------------------------------------- files

(extern lseek :cc (cc/C) [i32 i64 i32] (-> i64))

(extern read :cc (cc/C) [i32 (ptr i8) isize] (-> isize))

;;; A whole file. A regular file is read into one buffer of its size: one seek to learn the size,
;;; then reads straight into the buffer. Anything that cannot seek goes the general way.
(defn read-all [(path (slice u8))] (-> (slice u8))
  (let [tracked (dep-in-frame?)
        stamp (if tracked (file-stamp path) "")
        bytes (read-all-raw path)]
    (when tracked (dep-input! (join "f:" path) (print-of bytes) stamp))
    bytes))

;;; With HL_READ_TRACE set, when files are read: how long after the first each tenth, hundredth
;;; and thousandth was. A build's loading is as fast as its files arrive; this shows where they
;;; stop arriving.
(defstruct ReadTrace [(count i64) (start i64) (on i64) (walked i64)])

(defn read-trace-state [] (-> (ptr ReadTrace))
  (let [t (primitive/alloc-static ReadTrace)]
    (when (= (.on t) 0) (set! (.on t) (if (env-on? "HL_READ_TRACE") 1 2)) (set! (.start t) (now-ns)))
    t))

;;; With the same set: a directory listed, when it was done and how long it took.
(defn read-trace-listed! [(path (slice u8)) (began i64)] (-> void)
  (let [t (read-trace-state)]
    (when (= (.on t) 1)
      (eprintln "listed {} at {} us, in {} us" path (/ (- (now-ns) (.start t)) 1000) (/ (- (now-ns) began) 1000)))
    0))

;;; With the same set: the first items a walk visits, when each was done and how long it took.
(defn walk-trace-on? :inline (Always) [] (-> bool)
  (= (.on (read-trace-state)) 1))

(defn walk-trace! [(item (slice u8)) (began i64)] (-> void)
  (let [t (read-trace-state)]
    (when (and (= (.on t) 1) (< (atomic/add (field t walked) 1) 160))
      (eprintln "walked {} at {} us, in {} us, by {}"
                (if (> (len item) 40) (subslice item (- (len item) 40) (len item)) item)
                (/ (- (now-ns) (.start t)) 1000)
                (/ (- (now-ns) began) 1000)
                (worker-slot)))
    0))

(defn read-trace! [] (-> void)
  (let [t (read-trace-state)]
    (when (= (.on t) 1)
      (let [n (atomic/add (field t count) 1)]
        (when (or (= (% n 1000) 0) (and (< n 1000) (= (% n 100) 0)) (and (< n 100) (= (% n 10) 0)))
          (eprintln "read {} at {} us" n (/ (- (now-ns) (.start t)) 1000)))))
    0))

(defn read-all-raw [(path (slice u8))] (-> (slice u8))
  (read-trace!)
  (match (read-ahead-take path)
    (Some [bytes] bytes)
    (None [] (read-all-here path))))

(defn read-all-here [(path (slice u8))] (-> (slice u8))
  (let [a (value-allocator)
        fd
          (os/open (str/to-cstr a path)
                   (primitive/cast i32 (| fs/O_RDONLY fs/O_CLOEXEC))
                   0)]
    (when (< fd (: 0 i32)) (panic "cannot read {}" path))
    (let [size (lseek fd 0 2)]
      (if (< size 0)
          (do (os/close fd) (read-all-general path))
          (let [buf
                  (match (alloc [u8] a (+ size 1))
                    (Some [b] b)
                    (None [] (panic "no memory to read {}" path)))
                (mut off) 0
                (mut more) true]
            (lseek fd 0 0)
            (while (and more (< off size))
              (let [n
                      (read fd
                            (primitive/cast (ptr i8)
                                            (primitive/index (data buf) off))
                            (primitive/cast isize (- size off)))]
                (if (> (primitive/cast i64 n) 0)
                    (set! off (+ off (primitive/cast i64 n)))
                    (set! more false))))
            (os/close fd)
            (subslice buf 0 off))))))

(defn read-all-general [(path (slice u8))] (-> (slice u8))
  (try (let [bytes
               (try-or! (fs/read-file (value-allocator) path)
                        (panic "cannot read {}" path))]
         bytes)))

;; ---------------------------------------------------------------- files read ahead
;;;
;;; Opening a file is work the system does a little of at a time whoever asks: ten thousand small
;;; files are read in about 50 ms by four threads and in 121 by twelve (benchmarks/io). So while
;;; a walk finds files (`reach`, in a stage that says its names are files, `reads files`), a few
;;; threads of their own read what was found, in the order it was found, and whoever then reads
;;; a file (`read-all-raw`) takes what was read for it, waiting only for its own file. A file
;;; nobody said to read ahead, and any file while no walk is under way, is read where it is
;;; asked for, as before.
;;;
;;; A file's place holds how far it is (0 said, 1 being read, 2 read, 3 could not be read, 4
;;; taken), its bytes and how many. The lists never move: they have room for `read-ahead-room`
;;; files from the start, and a file found when they are full is read where it is asked for.
(defstruct ReadAhead
  [(lock i64)
   (on i64)
   (stop i64)
   (next i64)
   (end i64)
   (paths (ArrayList (ptr i8)))
   (state (ArrayList i64))
   (bytes (ArrayList i64))
   (sizes (ArrayList i64))
   (places (HashMap (slice u8) i64))
   (threads (ArrayList Thread))])

(defn read-ahead-state [] (-> (ptr ReadAhead))
  (primitive/alloc-static ReadAhead))

(defn read-ahead-room [] (-> i64) 1048576)

;;; How many threads read ahead. HL_READ_AHEAD says otherwise; 0 for none.
(defstruct ReadAheadThreads [(known i64) (n i64)])

(defn read-ahead-threads [] (-> i64)
  (let [w (primitive/alloc-static ReadAheadThreads)]
    (when (= (.known w) 0)
      (let [name (str/to-cstr (malloc-allocator) "HL_READ_AHEAD")
            said (os/getenv name)]
        (set! (.n w) (if (!= (primitive/cast i64 said) 0) (parse-int (str/from-cstr said)) 4))
        (primitive/free (primitive/cast (ptr i8) name))
        (set! (.known w) 1)))
    (.n w)))

;;; One file read into memory of its own: its place says so when it is done.
(defn read-ahead-one! [(r (ptr ReadAhead)) (i i64)] (-> void)
  (let [fd (os/open (get (.paths r) i) (primitive/cast i32 (| fs/O_RDONLY fs/O_CLOEXEC)) 0)]
    (if (< fd (: 0 i32))
        (atomic/store (elem (mut (.state r)) i) 3)
        (let [size (lseek fd 0 2)]
          (if (< size 0)
              (do (os/close fd) (atomic/store (elem (mut (.state r)) i) 3))
              (let [buf (malloc (primitive/cast isize (+ size 1)))
                    (mut off) 0
                    (mut more) true]
                (lseek fd 0 0)
                (while (and more (< off size))
                  (let [n (read fd (primitive/index buf off) (primitive/cast isize (- size off)))]
                    (if (> (primitive/cast i64 n) 0)
                        (set! off (+ off (primitive/cast i64 n)))
                        (set! more false))))
                (os/close fd)
                (set! (mut (.bytes r)) i (primitive/cast i64 buf))
                (set! (mut (.sizes r)) i off)
                (atomic/store (elem (mut (.state r)) i) 2)))))
    0))

;;; A reading thread: the next file said and not begun, until told to stop. With nothing to read
;;; it looks again at once for a while, then lets others have its core between looks.
(defn read-ahead-thread [(arg (ptr i8))] (-> (ptr i8))
  (let [r (read-ahead-state)
        (mut idle) 0]
    (prefer-fast-cores!)
    (while (= (atomic/read (field r stop)) 0)
      (let [i (atomic/read (field r next))]
        (if (< i (atomic/read (field r end)))
            (when (= (atomic/cas (field r next) i (+ i 1)) i)
              (set! idle 0)
              (atomic/store (elem (mut (.state r)) i) 1)
              (read-ahead-one! r i))
            (do
              (set! idle (+ idle 1))
              (when (> idle 2000) (sched_yield) (set! idle 0))))))
    arg))

;;; From here files said (`read-ahead!`) are read by threads of their own, until `read-ahead-end!`.
(defn read-ahead-begin! [] (-> void)
  (let [r (read-ahead-state)]
    (when (and (= (.on r) 0) (> (read-ahead-threads) 0))
      (set! (.paths r) (ArrayList::new [(ptr i8)] (malloc-allocator)))
      (set! (.state r) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.bytes r) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.sizes r) (ArrayList::new [i64] (malloc-allocator)))
      (reserve! (mut (.paths r)) (read-ahead-room))
      (reserve! (mut (.state r)) (read-ahead-room))
      (reserve! (mut (.bytes r)) (read-ahead-room))
      (reserve! (mut (.sizes r)) (read-ahead-room))
      (set! (.places r) (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.threads r) (ArrayList::new [Thread] (malloc-allocator)))
      (atomic/store (field r next) 0)
      (atomic/store (field r end) 0)
      (atomic/store (field r stop) 0)
      (for _ (range 0 (read-ahead-threads))
        (push! (mut (.threads r)) (Thread :handle (cast (ptr i8) 0))))
      (for i (range 0 (read-ahead-threads))
        (when (!= (Thread::spawn-configured (elem (mut (.threads r)) i)
                                            (fnptr-of read-ahead-thread)
                                            (cast (ptr i8) 0)
                                            (ThreadConfig :stack-size 524288 :guard-size 0))
                  (: 0 i32))
          (panic "could not start a thread to read files ahead")))
      (atomic/store (field r on) 1))
    0))

;;; A file to read ahead: said once, in the order files are found.
(defn read-ahead! [(path (slice u8))] (-> void)
  (let [r (read-ahead-state)]
    (when (and (!= (atomic/read (field r on)) 0) (> (len path) 0))
      (spin-lock! (field r lock))
      (let [i (len (.paths r))]
        (when (and (< i (read-ahead-room))
                   (match (get (.places r) path) (Some [_] false) (None [] true)))
          (push! (mut (.paths r)) (str/to-cstr (malloc-allocator) path))
          (push! (mut (.state r)) 0)
          (push! (mut (.bytes r)) 0)
          (push! (mut (.sizes r)) 0)
          (set! (mut (.places r)) path i)
          (atomic/store (field r end) (+ i 1))))
      (spin-unlock! (field r lock)))
    0))

;;; What was read ahead for `path`, as values go now, or nothing: for a file not said, one that
;;; could not be read (whoever asks reads it, and says why it cannot), and one taken already.
(defn read-ahead-take [(path (slice u8))] (-> (Option (slice u8)))
  (let [r (read-ahead-state)]
    (if (= (atomic/read (field r on)) 0)
        (None)
        (let [at (do
                   (spin-lock! (field r lock))
                   (let [found (match (get (.places r) path) (Some [i] i) (None [] -1))]
                     (spin-unlock! (field r lock))
                     found))]
          (if (< at 0)
              (None)
              (let [(mut looks) 0]
                ;; Its own file, said and not read yet: one of the readers is at it or about to be.
                (while (< (atomic/read (elem (mut (.state r)) at)) 2)
                  (set! looks (+ looks 1))
                  (when (> looks 2000) (sched_yield) (set! looks 0)))
                (if (= (atomic/cas (elem (mut (.state r)) at) 2 4) 2)
                    (let [size (get (.sizes r) at)
                          from (primitive/cast (ptr u8) (get (.bytes r) at))
                          out
                            (match (alloc [u8] (value-allocator) (+ size 1))
                              (Some [b] b)
                              (None [] (panic "no memory to read {}" path)))]
                      (mem/copy [u8] (data out) from size)
                      (primitive/free (primitive/cast (ptr i8) from))
                      (set! (mut (.bytes r)) at 0)
                      (Some (subslice out 0 size)))
                    (None))))))))

;;; The reading threads stopped and joined, and whatever they read that nobody took let go.
(defn read-ahead-end! [] (-> void)
  (let [r (read-ahead-state)]
    (when (!= (atomic/read (field r on)) 0)
      (atomic/store (field r stop) 1)
      (for i (range 0 (len (.threads r)))
        (join (cast (ptr Thread) (elem (mut (.threads r)) i))))
      (atomic/store (field r on) 0)
      (for i (range 0 (len (.paths r)))
        (primitive/free (get (.paths r) i))
        (when (!= (get (.bytes r) i) 0)
          (primitive/free (primitive/cast (ptr i8) (get (.bytes r) i)))))
      (free! (mut (.paths r)))
      (free! (mut (.state r)))
      (free! (mut (.bytes r)))
      (free! (mut (.sizes r)))
      (free! (mut (.places r)))
      (free! (mut (.threads r))))
    0))

;;; Directory part of a path: "." when there is none, and "/" for a file at the root.
(defn dir-of [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (cond (< cut 0) "."
          (= cut 0) "/"
          :else (subslice path 0 cut))))

;;; Files written in turn, and after each what to say about it, when there is something. One with no
;;; path is only what is said.
(defn write-files! [(paths (ArrayList (slice u8)))
                    (texts (ArrayList (slice u8)))
                    (said (ArrayList (slice u8)))] (-> void)
  (for i (range 0 (len paths))
    (when (> (len (get paths i)) 0)
      (write-output (get paths i) (get texts i))
      (input-rewritten! (get paths i)))
    (when (> (len (get said i)) 0) (println "{}" (get said i))))
  0)

;;; A file the program wrote that answers have read (a framework's generated route tree, written as
;;; each build starts and read by the build): what they read changed now, not when the next wait for
;;; changes looks, so the build that wrote it reads it as it is. A file nothing read is not an input.
(defn input-rewritten! [(path (slice u8))] (-> void)
  (let [d (deps)]
    (when (.tracking d)
      (let [node (join "f:" path)]
        (deps-lock! d)
        (let [known (get (.ids d) node)]
          (deps-unlock! d)
          (match known
            (Some [id]
                  (let [now (input-print-now node)]
                    (deps-lock! d)
                    (let [was (get (.prints d) id)]
                      (stored-text-set! (elem (mut (.stamps d)) id) (input-stamp node))
                      (if (and (> (len was) 0) (!= now was))
                          (do (stored-text-set! (elem (mut (.prints d)) id) now)
                              (deps-unlock! d)
                              (dep-changed-id! id))
                          (deps-unlock! d)))))
            (None [] 0))))))
  0)

;;; The directory the program runs in.
(defn working-dir [] (-> (slice u8))
  (cpath/cwd-slice (value-allocator)))

;;; SHA-256 of some bytes, as lowercase hex (FIPS 180-4): what TanStack Start names a server function
;;; by. Words are i64 kept below 2^32.
(defn sha256-k-text [] (-> (slice u8)) "")
(defn sha256-h-text [] (-> (slice u8)) "6a09e667bb67ae853c6ef372a54ff53a510e527f9b05688c1f83d9ab5be0cd19")

(defn sha256-word [(t (slice u8)) (i i64)] (-> i64)
  (let [(mut v) 0]
    (for j (range 0 8) (set! v (| (<< v 4) (hex-value (get t (+ (* i 8) j))))))
    v))

(defn sha256-rotr [(x i64) (n i64)] (-> i64)
  (& (| (>> x n) (<< x (- 32 n))) 4294967295))

(defn sha256-hex [(input (slice u8))] (-> (slice u8))
  (let [mask 4294967295
        n (len input)
        (mut msg) (ArrayList::new [i64] (value-allocator))
        (mut h) (ArrayList::new [i64] (value-allocator))
        (mut w) (ArrayList::new [i64] (value-allocator))
        k (sha256-k-text)]
    (for i (range 0 n) (push! (mut msg) (cast i64 (get input i))))
    (push! (mut msg) 128)
    (while (!= (% (+ (len msg) 8) 64) 0) (push! (mut msg) 0))
    (for i (range 0 8) (push! (mut msg) (& (>> (* n 8) (* (- 7 i) 8)) 255)))
    (for i (range 0 8) (push! (mut h) (sha256-word (sha256-h-text) i)))
    (ArrayList::extend-zeroed! (mut w) 64)
    (for block (range 0 (/ (len msg) 64))
      (for t (range 0 16)
        (let [at (+ (* block 64) (* t 4))]
          (set! (mut w) t (| (| (<< (get msg at) 24) (<< (get msg (+ at 1)) 16)) (| (<< (get msg (+ at 2)) 8) (get msg (+ at 3)))))))
      (for t (range 16 64)
        (let [x (get w (- t 15))
              y (get w (- t 2))
              s0 (^ (^ (sha256-rotr x 7) (sha256-rotr x 18)) (>> x 3))
              s1 (^ (^ (sha256-rotr y 17) (sha256-rotr y 19)) (>> y 10))]
          (set! (mut w) t (& (+ (+ (get w (- t 16)) s0) (+ (get w (- t 7)) s1)) mask))))
      (let [(mut a) (get h 0) (mut b) (get h 1) (mut c) (get h 2) (mut d) (get h 3)
            (mut e) (get h 4) (mut f) (get h 5) (mut g) (get h 6) (mut hh) (get h 7)]
        (for t (range 0 64)
          (let [big1 (^ (^ (sha256-rotr e 6) (sha256-rotr e 11)) (sha256-rotr e 25))
                ch (^ (& e f) (& (^ e mask) g))
                t1 (& (+ (+ (+ hh big1) (+ ch (sha256-word k t))) (get w t)) mask)
                big0 (^ (^ (sha256-rotr a 2) (sha256-rotr a 13)) (sha256-rotr a 22))
                maj (^ (^ (& a b) (& a c)) (& b c))
                t2 (& (+ big0 maj) mask)]
            (set! hh g) (set! g f) (set! f e) (set! e (& (+ d t1) mask))
            (set! d c) (set! c b) (set! b a) (set! a (& (+ t1 t2) mask))))
        (set! (mut h) 0 (& (+ (get h 0) a) mask)) (set! (mut h) 1 (& (+ (get h 1) b) mask))
        (set! (mut h) 2 (& (+ (get h 2) c) mask)) (set! (mut h) 3 (& (+ (get h 3) d) mask))
        (set! (mut h) 4 (& (+ (get h 4) e) mask)) (set! (mut h) 5 (& (+ (get h 5) f) mask))
        (set! (mut h) 6 (& (+ (get h 6) g) mask)) (set! (mut h) 7 (& (+ (get h 7) hh) mask))))
    (let [(mut out) (str/StrBuf::new (value-allocator))
          digits "0123456789abcdef"]
      (for i (range 0 8)
        (for j (range 0 8)
          (push! (mut (.bytes out)) (get digits (& (>> (get h i) (* (- 7 j) 4)) 15)))))
      (finish! (mut out)))))

;;; `[lo, hi)` of a text or list of `n` elements, as `x[lo..hi]` in the rules: one that ends where it
;;; starts, or before, is empty; any other reaching outside is a mistake in the rules, said as one,
;;; never memory read outside it.
(defn slice-checked! [(lo i64) (hi i64) (n i64)] (-> void)
  (when (and (< lo hi) (or (< lo 0) (> hi n)))
    (panic "slice [{}..{}] of {} elements is out of range" lo hi n)))

(defn text-slice [(t (slice u8)) (lo i64) (hi i64)] (-> (slice u8))
  (if (>= lo hi)
      (subslice t 0 0)
      (do (slice-checked! lo hi (len t))
          (subslice t lo hi))))

;;; A program started beside this one, found on PATH as a shell finds it, with this process's
;;; environment and its own arguments (the first its name): its process id, or -1 when it could not
;;; be started. It is not waited for; it ends when it ends, or with this process's group.
(defn spawn-process! [(args (ArrayList (slice u8)))] (-> i64)
  (let [(mut cs) (ArrayList::new [i64] (malloc-allocator))]
    (for a args (push! (mut cs) (primitive/cast i64 (str/to-cstr (malloc-allocator) a))))
    (push! (mut cs) 0)
    (let [pid (os/spawn (primitive/cast (ptr i8) (get cs 0))
                        (primitive/cast (ptr (ptr i8)) (data (slice cs)))
                        (os/environment))]
      (if (< pid 0) -1 pid))))

;;; The process's environment: a `NAME=value` line each, as it was started.
(defn environment-text [] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))
        env (os/environment)
        (mut i) 0]
    (while (!= (primitive/cast i64 (load (primitive/index env i))) 0)
      (push-str! (mut b) (str/from-cstr (load (primitive/index env i))))
      (push-str! (mut b) "\n")
      (set! i (+ i 1)))
    (finish! (mut b))))

;;; A path with its links resolved, as the file system has it; the path itself when nothing is there.
(defn real-path [(path (slice u8))] (-> (slice u8))
  (let [p (real-path-raw path)]
    ;; No stamp: a link anywhere along the path can change it.
    (when (dep-in-frame?) (dep-input! (join "r:" path) p ""))
    p))

(defn real-path-raw [(path (slice u8))] (-> (slice u8))
  (match (cpath/realpath-opt (value-allocator) path)
    (Some [p] p)
    (None [] path)))

(defn write-standard-output! [(bytes (slice u8))] (-> void)
  (match (io/print-str (io/stdout) bytes)
    (Ok [_] 0)
    (Err [_] (panic "cannot write to standard output"))))

;;; A directory, made with any it is inside that are not there yet.
(defn make-dirs! [(dir (slice u8))] (-> void)
  (try (let [there
               (try-or! (fs/exists? (malloc-allocator) dir)
                        (panic "cannot inspect directory {}" dir))]
         (unless there
           (make-dirs! (dir-of dir))
           (match (fs/create-dir (malloc-allocator) dir 493)
             (Ok [_] 0)
             (Err [_] (panic "cannot create directory {}" dir))))))
  0)

(defn write-output [(path (slice u8)) (bytes (slice u8))] (-> void)
  (make-dirs! (dir-of path))
  (match (fs/write-file (malloc-allocator) path bytes)
    (Ok [_] 0)
    (Err [_] (panic "cannot write {}" path))))

;;; JSON written into one buffer (`json(x)` in `.rules`, whose code the rules compiler derives from
;;; x's type): text quoted with what JSON escapes, numbers, and the rest as given.
(defn json-buf [] (-> str/StrBuf) (str/StrBuf::new (value-allocator)))

(defn json-raw! [(b (mut str/StrBuf)) (s (slice u8))] (-> void)
  (push-str! (mut b) s)
  0)

(defn json-int! [(b (mut str/StrBuf)) (n i64)] (-> void)
  (push-i64! (mut b) n)
  0)

(defn json-text! [(b (mut str/StrBuf)) (s (slice u8))] (-> void)
  (push-str! (mut b) "\"")
  (let [(mut from) 0]
    (for i (range 0 (len s))
      (let [c (get s i)
            escape (cond (= c #\") "\\\""
                         (= c #\\) "\\\\"
                         (= c #\newline) "\\n"
                         (= c #\return) "\\r"
                         (= c #\tab) "\\t"
                         (< c 32) "\\u00"
                         :else "")]
        (when (> (len escape) 0)
          (push-str! (mut b) (subslice s from i))
          (push-str! (mut b) escape)
          (when (= escape "\\u00")
            (push-str! (mut b) (subslice "0123456789abcdef" (/ (cast i64 c) 16) (+ (/ (cast i64 c) 16) 1)))
            (push-str! (mut b) (subslice "0123456789abcdef" (% (cast i64 c) 16) (+ (% (cast i64 c) 16) 1))))
          (set! from (+ i 1)))))
    (push-str! (mut b) (subslice s from (len s))))
  (push-str! (mut b) "\"")
  0)

(defn json-done [(b (mut str/StrBuf))] (-> (slice u8)) (finish! (mut b)))

;;; JSON read back (`read-json`): a value, its kind 0 null, 1 false, 2 true, 3 a number, 4 a string,
;;; 5 an array (its items), 6 an object (its keys beside its items). Numbers are integers, as `json`
;;; writes them; anything else is an error, not a guess.
(defstruct JVal [(kind i64) (num i64) (text (slice u8)) (items (ArrayList JVal)) (keys (ArrayList (slice u8)))])
(defstruct JReader [(s (slice u8)) (at i64)])

(defn jv-new [(kind i64)] (-> JVal)
  (JVal :kind kind :num 0 :text ""
        :items (ArrayList::new [JVal] (value-allocator))
        :keys (ArrayList::new [(slice u8)] (value-allocator))))

(defn jr-fail [(r (mut JReader)) (what (slice u8))] (-> never)
  (panic "read-json: expected {} at byte {}" what (.at r)))

(defn json-space? [(c u8)] (-> bool)
  (or (= c #\space) (= c #\newline) (= c #\return) (= c #\tab)))

(defn jr-peek [(r (mut JReader))] (-> u8)
  (while (and (< (.at r) (len (.s r))) (json-space? (get (.s r) (.at r))))
    (set! (.at r) (+ (.at r) 1)))
  (if (< (.at r) (len (.s r))) (get (.s r) (.at r)) (cast u8 0)))

(defn jr-expect! [(r (mut JReader)) (c u8) (what (slice u8))] (-> void)
  (unless (= (jr-peek (mut r)) c) (jr-fail (mut r) what))
  (set! (.at r) (+ (.at r) 1))
  0)

(defn jr-word! [(r (mut JReader)) (w (slice u8))] (-> void)
  (unless (at? (.s r) (.at r) w) (jr-fail (mut r) w))
  (set! (.at r) (+ (.at r) (len w)))
  0)

(defn hex-value [(c u8)] (-> i64)
  (cond (digit? c) (- (cast i64 c) 48)
        (and (>= c #\a) (<= c #\f)) (- (cast i64 c) 87)
        (and (>= c #\A) (<= c #\F)) (- (cast i64 c) 55)
        :else (panic "read-json: {} is not a hex digit" c)))

(defn hex4 [(t (slice u8)) (i i64)] (-> i64)
  (when (> (+ i 4) (len t)) (panic "read-json: a \\u escape is cut short"))
  (+ (* 4096 (hex-value (get t i))) (+ (* 256 (hex-value (get t (+ i 1))))
                                       (+ (* 16 (hex-value (get t (+ i 2)))) (hex-value (get t (+ i 3)))))))

(defn push-utf8! [(b (mut str/StrBuf)) (cp i64)] (-> void)
  (cond (< cp 128) (push! (mut (.bytes b)) (cast u8 cp))
        (< cp 2048) (do (push! (mut (.bytes b)) (cast u8 (+ 192 (/ cp 64))))
                        (push! (mut (.bytes b)) (cast u8 (+ 128 (% cp 64)))))
        (< cp 65536) (do (push! (mut (.bytes b)) (cast u8 (+ 224 (/ cp 4096))))
                         (push! (mut (.bytes b)) (cast u8 (+ 128 (% (/ cp 64) 64))))
                         (push! (mut (.bytes b)) (cast u8 (+ 128 (% cp 64)))))
        :else (do (push! (mut (.bytes b)) (cast u8 (+ 240 (/ cp 262144))))
                  (push! (mut (.bytes b)) (cast u8 (+ 128 (% (/ cp 4096) 64))))
                  (push! (mut (.bytes b)) (cast u8 (+ 128 (% (/ cp 64) 64))))
                  (push! (mut (.bytes b)) (cast u8 (+ 128 (% cp 64))))))
  0)

;;; A string's text between its quotes, its escapes undone; a surrogate pair is one code point.
(defn json-unescape [(t (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))
        (mut i) 0]
    (while (< i (len t))
      (let [c (get t i)]
        (if (!= c #\\)
            (do (push! (mut (.bytes b)) c) (set! i (+ i 1)))
            (let [e (get t (+ i 1))]
              (cond (= e #\n) (do (push! (mut (.bytes b)) #\newline) (set! i (+ i 2)))
                    (= e #\r) (do (push! (mut (.bytes b)) #\return) (set! i (+ i 2)))
                    (= e #\t) (do (push! (mut (.bytes b)) #\tab) (set! i (+ i 2)))
                    (= e #\b) (do (push! (mut (.bytes b)) (cast u8 8)) (set! i (+ i 2)))
                    (= e #\f) (do (push! (mut (.bytes b)) (cast u8 12)) (set! i (+ i 2)))
                    (= e #\u)
                      (let [hi (hex4 t (+ i 2))]
                        (if (and (>= hi 55296) (< hi 56320) (at? t (+ i 6) "\\u"))
                            (do (push-utf8! (mut b) (+ 65536 (+ (* (- hi 55296) 1024) (- (hex4 t (+ i 8)) 56320))))
                                (set! i (+ i 12)))
                            (do (push-utf8! (mut b) hi) (set! i (+ i 6)))))
                    :else (do (push! (mut (.bytes b)) e) (set! i (+ i 2))))))))
    (finish! (mut b))))

(defn jr-string! [(r (mut JReader))] (-> (slice u8))
  (jr-expect! (mut r) #\" "a string")
  (let [s (.s r)
        start (.at r)
        (mut i) start
        (mut plain) true]
    (while (and (< i (len s)) (!= (get s i) #\"))
      (when (= (get s i) #\\) (set! plain false) (set! i (+ i 1)))
      (set! i (+ i 1)))
    (when (>= i (len s)) (jr-fail (mut r) "the end of a string"))
    (set! (.at r) (+ i 1))
    (if plain (subslice s start i) (json-unescape (subslice s start i)))))

(defn jr-number! [(r (mut JReader))] (-> i64)
  (let [s (.s r)
        negative (= (get s (.at r)) #\-)
        start (if negative (+ (.at r) 1) (.at r))
        (mut i) start]
    (while (and (< i (len s)) (digit? (get s i))) (set! i (+ i 1)))
    (when (and (< i (len s)) (or (= (get s i) #\.) (= (get s i) #\e) (= (get s i) #\E)))
      (jr-fail (mut r) "an integer, not a fraction or an exponent,"))
    (set! (.at r) i)
    (match (parse-num (subslice s start i))
      (Some [v] (if negative (- 0 v) v))
      (None [] (jr-fail (mut r) "an integer")))))

(defn jr-value! [(r (mut JReader))] (-> JVal)
  (let [c (jr-peek (mut r))]
    (cond (= c #\{) (jr-object! (mut r))
          (= c #\[) (jr-array! (mut r))
          (= c #\") (let [(mut v) (jv-new 4)] (set! (.text v) (jr-string! (mut r))) v)
          (= c #\t) (do (jr-word! (mut r) "true") (jv-new 2))
          (= c #\f) (do (jr-word! (mut r) "false") (jv-new 1))
          (= c #\n) (do (jr-word! (mut r) "null") (jv-new 0))
          (or (= c #\-) (digit? c)) (let [(mut v) (jv-new 3)] (set! (.num v) (jr-number! (mut r))) v)
          :else (jr-fail (mut r) "a value"))))

(defn jr-array! [(r (mut JReader))] (-> JVal)
  (let [(mut v) (jv-new 5)]
    (jr-expect! (mut r) #\[ "[")
    (if (= (jr-peek (mut r)) #\])
        (set! (.at r) (+ (.at r) 1))
        (do (push! (mut (.items v)) (jr-value! (mut r)))
            (while (= (jr-peek (mut r)) #\,)
              (set! (.at r) (+ (.at r) 1))
              (push! (mut (.items v)) (jr-value! (mut r))))
            (jr-expect! (mut r) #\] "] or ,")))
    v))

(defn jr-object! [(r (mut JReader))] (-> JVal)
  (let [(mut v) (jv-new 6)]
    (jr-expect! (mut r) #\{ "{")
    (if (= (jr-peek (mut r)) #\})
        (set! (.at r) (+ (.at r) 1))
        (do (push! (mut (.keys v)) (jr-string! (mut r)))
            (jr-expect! (mut r) #\: ":")
            (push! (mut (.items v)) (jr-value! (mut r)))
            (while (= (jr-peek (mut r)) #\,)
              (set! (.at r) (+ (.at r) 1))
              (push! (mut (.keys v)) (jr-string! (mut r)))
              (jr-expect! (mut r) #\: ":")
              (push! (mut (.items v)) (jr-value! (mut r))))
            (jr-expect! (mut r) #\} "} or ,")))
    v))

;;; A whole text as one JSON value.
(defn json-parsed [(s (slice u8))] (-> JVal)
  (let [(mut r) (JReader :s s :at 0)
        v (jr-value! (mut r))]
    (when (!= (jr-peek (mut r)) (cast u8 0)) (jr-fail (mut r) "the end"))
    v))

(defn jv-kind-name [(v JVal)] (-> (slice u8))
  (cond (= (.kind v) 0) "null" (= (.kind v) 1) "false" (= (.kind v) 2) "true" (= (.kind v) 3) "a number"
        (= (.kind v) 4) "a string" (= (.kind v) 5) "an array" :else "an object"))

(defn jv-int [(v JVal)] (-> i64)
  (if (= (.kind v) 3) (.num v) (panic "read-json: expected an Int, got {}" (jv-kind-name v))))

(defn jv-text [(v JVal)] (-> (slice u8))
  (if (= (.kind v) 4) (.text v) (panic "read-json: expected a Text, got {}" (jv-kind-name v))))

(defn jv-bool [(v JVal)] (-> bool)
  (cond (= (.kind v) 2) true
        (= (.kind v) 1) false
        :else (panic "read-json: expected a Bool, got {}" (jv-kind-name v))))

(defn jv-null? [(v JVal)] (-> bool) (= (.kind v) 0))

(defn jv-items [(v JVal)] (-> (ArrayList JVal))
  (if (= (.kind v) 5) (.items v) (panic "read-json: expected a list, got {}" (jv-kind-name v))))

;;; An object's field: where `json` writes it, the i-th, or wherever it is.
(defn jv-field [(v JVal) (i i64) (name (slice u8))] (-> JVal)
  (unless (= (.kind v) 6) (panic "read-json: expected an object with {}, got {}" name (jv-kind-name v)))
  (if (and (< i (len (.keys v))) (= (get (.keys v) i) name))
      (get (.items v) i)
      (let [(mut found) -1]
        (for j (range 0 (len (.keys v)))
          (when (= (get (.keys v) j) name) (set! found j)))
        (when (< found 0) (panic "read-json: the object has no field {}" name))
        (get (.items v) found))))

(defn join [(a (slice u8)) (b (slice u8))] (-> (slice u8))
  (let [(mut sb) (str/StrBuf::new (value-allocator))]
    (push-str! (mut sb) a)
    (push-str! (mut sb) b)
    (finish! (mut sb))))

(defn parse-int [(s (slice u8))] (-> i64)
  (match (parse-num s)
    (Some [v] v)
    (None [] (panic "expected a number, got {}" s))))

;; ---------------------------------------------------------------- text and paths

;;; Text and file paths, what every language here needs and none should spell out byte by byte.

(defn index-of [(s (slice u8)) (what (slice u8))] (-> (Option i64))
  (if (= (len what) 0)
      (Some 0)
      (let [(mut at) -1
            (mut i) 0
            n (- (len s) (len what))
            first (get what 0)]
        (while (and (< at 0) (<= i n))
          (when (and (= (get s i) first) (at? s i what)) (set! at i))
          (set! i (+ i 1)))
        (if (< at 0) (None [i64]) (Some at)))))

(defn last-index-of [(s (slice u8)) (what (slice u8))] (-> (Option i64))
  (if (= (len what) 0)
      (Some (len s))
      (let [(mut at) -1
            (mut i) (- (len s) (len what))
            first (get what 0)]
        (while (and (< at 0) (>= i 0))
          (when (and (= (get s i) first) (at? s i what)) (set! at i))
          (set! i (- i 1)))
        (if (< at 0) (None [i64]) (Some at)))))

;;; What comes before the first `sep`, or all of `s` without one; and what comes after it, or nothing.
(defn text-before [(s (slice u8)) (sep (slice u8))] (-> (slice u8))
  (match (index-of s sep) (Some [i] (subslice s 0 i)) (None [] s)))

(defn text-after [(s (slice u8)) (sep (slice u8))] (-> (slice u8))
  (match (index-of s sep)
    (Some [i] (subslice s (+ i (len sep)) (len s)))
    (None [] "")))

;;; A directory and each one it is inside, up to the top: ".", "/" or "".
(defn path-ancestors [(dir (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (tree-allocator))
        (mut d) dir
        (mut go) true]
    (while go
      (push! (mut out) d)
      (if (or (= d ".") (= d "/") (= (len d) 0))
          (set! go false)
          (set! d (dir-of d))))
    out))

;;; One text for a memo's several arguments, each told apart by its length, whatever it holds.
;;; Whether `n` bytes at two places are the same.
(defn same-bytes? [(a (ptr u8)) (b (ptr u8)) (n i64)] (-> bool)
  (let [(mut same) true
        (mut i) 0]
    (while (and same (< i n))
      (when (!= (load (primitive/index a i)) (load (primitive/index b i)))
        (set! same false))
      (set! i (+ i 1)))
    same))

;;; A tree's identity: see `node-key` in the grammars. Its numbers as eight bytes each, then its
;;; text: a key only ever hashed and compared, never read as text. The text is there by what it
;;; says, not where it is, so a leaf made again from the same words is the same leaf, in this run
;;; or after a load from the cache; no children are no children wherever an empty list is.
(defn node-identity [(kind i64)
                     (lo i64)
                     (hi i64)
                     (text (slice u8))
                     (kids i64)
                     (count i64)] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] (value-allocator))]
    (reserve! (mut b) (+ 40 (len text)))
    (for v [kind lo hi (if (= count 0) 0 kids) count]
      (for i (range 0 8)
        (push! (mut b) (cast u8 (& (>> v (* i 8)) 255)))))
    (when (> (len text) 0) (ArrayList::extend! (mut b) (data text) (len text)))
    (slice b)))

;;; A key `memo-key-of` made, back into its parts.
(defn memo-key-parts [(key (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (value-allocator))
        (mut at) 0]
    (while (< at (len key))
      (let [(mut colon) at]
        (while (and (< colon (len key)) (!= (get key colon) (cast u8 58)))
          (set! colon (+ colon 1)))
        (let [n (parse-int (subslice key at colon))]
          (push! (mut out) (subslice key (+ colon 1) (+ colon 1 n)))
          (set! at (+ colon 1 n)))))
    out))

;;; A memo's key written as it is made, into one buffer: an integer's digits and a comma, a text's
;;; length, a colon and the text, a list's length and a hash before its elements, a record's
;;; fields in turn. No key is the start of another of the same function's.
(defn key-buf-new [] (-> str/StrBuf)
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (reserve! (mut (.bytes b)) 48)
    b))

(defn key-int! [(b (mut str/StrBuf)) (v i64)] (-> void)
  (push-i64! (mut b) v)
  (push-str! (mut b) ",")
  0)

(defn key-text! [(b (mut str/StrBuf)) (t (slice u8))] (-> void)
  (push-i64! (mut b) (len t))
  (push-str! (mut b) ":")
  (push-str! (mut b) t)
  0)

(defn key-count! [(b (mut str/StrBuf)) (n i64)] (-> void)
  (push-i64! (mut b) n)
  (push-str! (mut b) "#")
  0)

(defn key-done! [(b (mut str/StrBuf))] (-> (slice u8))
  (finish! (mut b)))

(defn memo-key-of [(parts (ArrayList (slice u8)))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (for p parts
      (push-str! (mut b) (num-text (len p)))
      (push-str! (mut b) ":")
      (push-str! (mut b) p))
    (finish! (mut b))))

;;; `s` with each of `whats` replaced by the `bys` at its place, in one pass, the first that matches
;;; winning. Nothing found, `s` itself.
(defn replace-many [(s (slice u8))
                    (whats (ArrayList (slice u8)))
                    (bys (ArrayList (slice u8)))] (-> (slice u8))
  (unless (= (len whats) (len bys))
    (panic "replace-many needs as many replacements as texts to replace"))
  (let [(mut w0) 0
        (mut w1) 0
        (mut w2) 0
        (mut w3) 0
        (mut b) (str/StrBuf::new (value-allocator))
        (mut start) 0
        (mut i) 0
        (mut any) false]
    (for w whats
      (when (= (len w) 0) (panic "replace-many needs text to look for"))
      (let [x (cast i64 (get w 0))
            bit (<< 1 (% x 64))]
        (cond (< x 64) (set! w0 (| w0 bit))
              (< x 128) (set! w1 (| w1 bit))
              (< x 192) (set! w2 (| w2 bit))
              :else (set! w3 (| w3 bit)))))
    (while (< i (len s))
      (let [c (get s i)
            (mut hit) -1]
        (when (byte-in? (cast i64 c) w0 w1 w2 w3)
          (let [(mut k) 0]
            (while (and (< hit 0) (< k (len whats)))
              (let [w (get whats k)]
                (when (and (= (get w 0) c) (at? s i w)) (set! hit k)))
              (set! k (+ k 1)))))
        (if (< hit 0)
            (set! i (+ i 1))
            (do
              (unless any
                (set! any true)
                (reserve! (mut (.bytes b)) (+ (len s) 16)))
              (push-str! (mut b) (subslice s start i))
              (push-str! (mut b) (get bys hit))
              (set! i (+ i (len (get whats hit))))
              (set! start i)))))
    (if any
        (do (push-str! (mut b) (subslice s start (len s))) (finish! (mut b)))
        s)))

;;; Every place in `s` where one of `whats` starts, in order, in one pass. Their first bytes are a
;;; 256-bit set in four words, so most bytes cost one test.
(defn occurrences [(s (slice u8)) (whats (ArrayList (slice u8)))]
  (-> (ArrayList i64))
  (if (and (= (len whats) 1) (= (len (get whats 0)) 1))
      (byte-places s (get (get whats 0) 0))
      (occurrences-of-many s whats)))

;;; Every place byte `b` is in `s`.
(defn byte-places [(s (slice u8)) (b u8)] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))]
    (for i (range 0 (len s)) (when (= (get s i) b) (push! (mut out) i)))
    out))

;;; Needles with at most four first bytes between them are found by comparing with those; more, by
;;; a 256-bit set.
(defn occurrences-of-many [(s (slice u8)) (whats (ArrayList (slice u8)))]
  (-> (ArrayList i64))
  (let [(mut firsts) (ArrayList::new [i64] (value-allocator))]
    (for w whats
      (when (= (len w) 0) (panic "occurrences needs text to look for"))
      (let [b (cast i64 (get w 0))
            (mut seen) false]
        (for x firsts (when (= x b) (set! seen true)))
        (unless seen (push! (mut firsts) b))))
    (if (<= (len firsts) 4)
        (let [f0 (get firsts 0)
              f1 (if (> (len firsts) 1) (get firsts 1) -1)
              f2 (if (> (len firsts) 2) (get firsts 2) -1)
              f3 (if (> (len firsts) 3) (get firsts 3) -1)
              (mut out) (ArrayList::new [i64] (tree-allocator))]
          (for i (range 0 (len s))
            (let [c (cast i64 (get s i))]
              (when (or (= c f0) (= c f1) (= c f2) (= c f3))
                (let [(mut hit) false
                      (mut k) 0]
                  (while (and (not hit) (< k (len whats)))
                    (let [w (get whats k)]
                      (when (and (= (cast i64 (get w 0)) c) (at? s i w))
                        (set! hit true)))
                    (set! k (+ k 1)))
                  (when hit (push! (mut out) i))))))
          out)
        (occurrences-by-set s whats))))

;;; Where any of `whats` first appears in `s`, in one pass that stops there.
(defn index-of-any [(s (slice u8)) (whats (ArrayList (slice u8)))]
  (-> (Option i64))
  (let [(mut w0) 0
        (mut w1) 0
        (mut w2) 0
        (mut w3) 0]
    (for w whats
      (when (= (len w) 0) (panic "index-of-any needs text to look for"))
      (let [b (cast i64 (get w 0))
            bit (<< 1 (% b 64))]
        (cond (< b 64) (set! w0 (| w0 bit))
              (< b 128) (set! w1 (| w1 bit))
              (< b 192) (set! w2 (| w2 bit))
              :else (set! w3 (| w3 bit)))))
    (let [(mut i) 0
          (mut found) -1
          n (len s)]
      (while (and (< found 0) (< i n))
        (let [c (get s i)]
          (when (byte-in? (cast i64 c) w0 w1 w2 w3)
            (for w whats
              (when (and (< found 0) (= (get w 0) c) (at? s i w))
                (set! found i)))))
        (set! i (+ i 1)))
      (if (< found 0) (None [i64]) (Some found)))))

(defn occurrences-by-set [(s (slice u8)) (whats (ArrayList (slice u8)))]
  (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))
        (mut w0) 0
        (mut w1) 0
        (mut w2) 0
        (mut w3) 0]
    (for w whats
      (when (= (len w) 0) (panic "occurrences needs text to look for"))
      (let [b (cast i64 (get w 0))
            bit (<< 1 (% b 64))]
        (cond (< b 64) (set! w0 (| w0 bit))
              (< b 128) (set! w1 (| w1 bit))
              (< b 192) (set! w2 (| w2 bit))
              :else (set! w3 (| w3 bit)))))
    (for i (range 0 (len s))
      (let [c (get s i)]
        (when (byte-in? (cast i64 c) w0 w1 w2 w3)
          (let [(mut hit) false
                (mut k) 0]
            (while (and (not hit) (< k (len whats)))
              (let [w (get whats k)]
                (when (and (= (get w 0) c) (at? s i w)) (set! hit true)))
              (set! k (+ k 1)))
            (when hit (push! (mut out) i))))))
    out))

;;; The pieces between `sep`s: n separators make n + 1 pieces, empty ones included.
(defn split [(s (slice u8)) (sep (slice u8))] (-> (ArrayList (slice u8)))
  (when (= (len sep) 0) (panic "split needs a separator that is not empty"))
  (let [(mut out) (ArrayList::new [(slice u8)] (tree-allocator))
        (mut start) 0
        (mut i) 0]
    (while (<= (+ i (len sep)) (len s))
      (if (at? s i sep)
          (do
            (push! (mut out) (subslice s start i))
            (set! i (+ i (len sep)))
            (set! start i))
          (set! i (+ i 1))))
    (push! (mut out) (subslice s start (len s)))
    out))

(defn joined [(xs (ArrayList (slice u8))) (sep (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (for i (range 0 (len xs))
      (when (> i 0) (push-str! (mut b) sep))
      (push-str! (mut b) (get xs i)))
    (finish! (mut b))))

(defn replace-all [(s (slice u8)) (what (slice u8)) (by (slice u8))]
  (-> (slice u8))
  (if (or (= (len what) 0) (not (contains-text? s what)))
      s
      (joined (split s what) by)))

(defn ascii-space? [(c u8)] (-> bool)
  (or (= c #\space)
      (= c #\tab)
      (= c #\newline)
      (= c (cast u8 13))
      (= c (cast u8 12))
      (= c (cast u8 11))))

;;; Without the ASCII space at either end.
(defn trim [(s (slice u8))] (-> (slice u8))
  (let [(mut from) 0
        (mut to) (len s)]
    (while (and (< from to) (ascii-space? (get s from))) (set! from (+ from 1)))
    (while (and (> to from) (ascii-space? (get s (- to 1)))) (set! to (- to 1)))
    (subslice s from to)))

;;; Is byte `c` one of `chars`?
(defn byte-among? [(c u8) (chars (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for x chars (when (= x c) (set! hit true)))
    hit))

;;; How many bytes from `from` are among `chars`; and how many are not.
(defn span-of [(s (slice u8)) (from i64) (chars (slice u8))] (-> i64)
  (let [(mut i) from]
    (while (and (< i (len s)) (byte-among? (get s i) chars)) (set! i (+ i 1)))
    (- i from)))

(defn span-not-of [(s (slice u8)) (from i64) (chars (slice u8))] (-> i64)
  (let [(mut i) from]
    (while (and (< i (len s)) (not (byte-among? (get s i) chars)))
      (set! i (+ i 1)))
    (- i from)))

;;; How many bytes at the end are among `chars`.
(defn span-back-of [(s (slice u8)) (chars (slice u8))] (-> i64)
  (let [(mut i) (len s)]
    (while (and (> i 0) (byte-among? (get s (- i 1)) chars)) (set! i (- i 1)))
    (- (len s) i)))

;;; Without the bytes among `chars` at either end.
(defn trim-bytes [(s (slice u8)) (chars (slice u8))] (-> (slice u8))
  (let [from (span-of s 0 chars)]
    (if (= from (len s))
        ""
        (subslice s from (- (len s) (span-back-of s chars))))))

(defn ascii-lower [(s (slice u8))] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] (value-allocator))]
    (for c s (push! (mut b) (if (and (>= c 65) (<= c 90)) (+ c 32) c)))
    (slice b)))

;;; A path's last segment, its extension (from the segment's last `.`, or nothing), and the
;;; segment without it.
(defn path-base [(p (slice u8))] (-> (slice u8))
  (match (last-index-of p "/")
    (Some [i] (subslice p (+ i 1) (len p)))
    (None [] p)))

(defn path-ext [(p (slice u8))] (-> (slice u8))
  (let [base (path-base p)]
    (match (last-index-of base ".")
      (Some [i] (subslice base i (len base)))
      (None [] ""))))

(defn path-stem [(p (slice u8))] (-> (slice u8))
  (let [base (path-base p)]
    (subslice base 0 (- (len base) (len (path-ext base))))))

;;; The segments that name something: no empty ones and no `.`.
(defn path-segments [(p (slice u8))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (tree-allocator))]
    (for seg (split p "/")
      (unless (or (= (len seg) 0) (= seg ".")) (push! (mut out) seg)))
    out))

;;; Without `.` and `..` segments, as far as the path itself says: a leading `..` stays.
(defn path-normalize [(p (slice u8))] (-> (slice u8))
  (let [(mut parts) (ArrayList::new [(slice u8)] (tree-allocator))]
    (for seg (path-segments p)
      (if (and (= seg "..")
               (> (len parts) 0)
               (!= (get parts (- (len parts) 1)) ".."))
          (pop! (mut parts))
          (push! (mut parts) seg)))
    (let [body (joined parts "/")]
      (if (and (> (len p) 0) (= (get p 0) #\/)) (join "/" body) body))))

;; ---------------------------------------------------------------- what `.rules` calls

;;; A leaf's text is this, or is this in quotes.
(defn leaf-is? [(text (slice u8)) (want (slice u8))] (-> bool)
  (or (= text want)
      (and (= (len text) (+ (len want) 2))
           (or (= (get text 0) #\") (= (get text 0) #\'))
           (= (subslice text 1 (- (len text) 1)) want))))

(defn starts-with [(s (slice u8)) (prefix (slice u8))] (-> bool)
  (at? s 0 prefix))

(defn ends-with [(s (slice u8)) (suffix (slice u8))] (-> bool)
  (and (>= (len s) (len suffix))
       (= (subslice s (- (len s) (len suffix)) (len s)) suffix)))

;;; A list of two numbers.
(defn ints-of [(a i64) (b i64)] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (value-allocator))]
    (push! (mut out) a)
    (push! (mut out) b)
    out))

;;; Indices of `keys` in sorted order, equal keys keeping their order.
(defn sort-order-int [(keys (ArrayList i64)) (desc bool)] (-> (ArrayList i64))
  (let [n (len keys)
        (mut a) (ArrayList::new [i64] (value-allocator))
        (mut b) (ArrayList::new [i64] (value-allocator))
        (mut width) 1]
    (for i (range 0 n) (push! (mut a) i) (push! (mut b) i))
    (while (< width n)
      (let [(mut lo) 0]
        (while (< lo n)
          (let [mid (if (< (+ lo width) n) (+ lo width) n)
                hi (if (< (+ lo (* 2 width)) n) (+ lo (* 2 width)) n)
                (mut i) lo
                (mut j) mid
                (mut at) lo]
            (while (< at hi)
              (if (and (< i mid)
                       (or (>= j hi)
                           (let [x (get keys (get a i))
                                 y (get keys (get a j))]
                             (if desc (>= x y) (<= x y)))))
                  (do (set! (mut b) at (get a i)) (set! i (+ i 1)))
                  (do (set! (mut b) at (get a j)) (set! j (+ j 1))))
              (set! at (+ at 1))))
          (set! lo (+ lo (* 2 width)))))
      (for i (range 0 n) (set! (mut a) i (get b i)))
      (set! width (* width 2)))
    a))

;;; The same over text, by bytes: a module sorts few names.
(defn sort-order-text [(keys (ArrayList (slice u8))) (desc bool)]
  (-> (ArrayList i64))
  (let [(mut order) (ArrayList::new [i64] (value-allocator))]
    (for i (range 0 (len keys)) (push! (mut order) i))
    (for i (range 1 (len keys))
      (let [(mut j) i]
        (while (and (> j 0)
                    (let [c
                            (str/cmp (get keys (get order j))
                                     (get keys (get order (- j 1))))]
                      (if desc (> c 0) (< c 0))))
          (let [x (get order j)]
            (set! (mut order) j (get order (- j 1)))
            (set! (mut order) (- j 1) x))
          (set! j (- j 1)))))
    order))

;;; A growing piece of text.
(defstruct Buf [(bytes (ArrayList u8))])

(defn buf-new [] (-> Buf)
  (Buf :bytes (ArrayList::new [u8] (value-allocator))))

(defn buf-add! [(b (mut Buf)) (s (slice u8))] (-> void)
  (when (> (len s) 0)
    (ArrayList::extend! (mut (.bytes b)) (data s) (len s)))
  0)

(defn buf-byte! [(b (mut Buf)) (c i64)] (-> void)
  (push! (mut (.bytes b)) (cast u8 c)))

(defn buf-text [(b (mut Buf))] (-> (slice u8))
  (slice (.bytes b)))

(defn buf-len [(b (mut Buf))] (-> i64)
  (len (.bytes b)))

;;; A one-element text from a byte.
;;; A byte's value as a digit of `base` (up to 36, letters either case), if it is one.
(defn digit-value [(c i64) (base i64)] (-> (Option i64))
  (let [v
          (cond (and (>= c 48) (<= c 57)) (- c 48)
                (and (>= c 97) (<= c 122)) (+ (- c 97) 10)
                (and (>= c 65) (<= c 90)) (+ (- c 65) 10)
                :else 99)]
    (if (< v base) (Some v) (None [i64]))))

;;; Digits of `base` as a number, if they all are digits and there is at least one, and it is at
;;; most `limit`. Past the limit it stops counting, so nothing overflows.
(defn digits-number [(s (slice u8)) (base i64) (limit i64)] (-> (Option i64))
  (let [(mut v) 0
        (mut ok) (> (len s) 0)]
    (for c s
      (match (digit-value (cast i64 c) base)
        (Some [d] (when (<= v limit) (set! v (+ (* v base) d))))
        (None [] (set! ok false))))
    (if (and ok (<= v limit)) (Some v) (None [i64]))))

;;; `s` with the bytes from `from` up to `to` made spaces, but for line breaks: what is left reads
;;; as if that text were not there, and everything keeps its place and its line.
(defn blanked [(s (slice u8)) (from i64) (to i64)] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] (tree-allocator))]
    (reserve! (mut out) (len s))
    (for i (range 0 (len s))
      (let [c (get s i)]
        (push! (mut out)
               (if (and (>= i from) (< i to) (!= c 10) (!= c 13))
                   (cast u8 32)
                   c))))
    (slice out)))

;;; Where each line of `s` starts: 0, and after every line break.
(defn line-starts [(s (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))]
    (push! (mut out) 0)
    (for i (range 0 (len s)) (when (= (get s i) 10) (push! (mut out) (+ i 1))))
    out))

;;; How far each of those lines is indented with spaces, or -1 for a line with nothing else on it.
(defn line-indents [(s (slice u8)) (starts (ArrayList i64))]
  (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (tree-allocator))
        n (len s)]
    (for st starts
      (let [(mut i) st]
        (while (and (< i n) (= (get s i) 32)) (set! i (+ i 1)))
        (push! (mut out)
               (if (or (>= i n)
                       (= (get s i) 10)
                       (= (get s i) 13)
                       (= (get s i) 9))
                   -1
                   (- i st)))))
    out))

;;; How many times byte `b` appears from `from` up to `to`.
(defn count-byte [(s (slice u8)) (from i64) (to i64) (b i64)] (-> i64)
  (let [(mut c) 0]
    (for i (range from to) (when (= (cast i64 (get s i)) b) (set! c (+ c 1))))
    c))

;;; `s` written `n` times.
(defn repeated [(s (slice u8)) (n i64)] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] (tree-allocator))]
    (reserve! (mut out) (* n (len s)))
    (for _ (range 0 n) (ArrayList::extend! (mut out) (data s) (len s)))
    (slice out)))

;;; Whether every byte of `s` is ASCII, below 128.
(defn ascii-text? [(s (slice u8))] (-> bool)
  (let [n (len s)
        (mut i) 0]
    (while (and (< i n) (< (get s i) 128)) (set! i (+ i 1)))
    (= i n)))

;;; How many items of the sorted `xs` are at most `x`: where `x` would go after its equals.
(defn bisect [(xs (ArrayList i64)) (x i64)] (-> i64)
  (let [(mut lo) 0
        (mut hi) (len xs)]
    (while (< lo hi)
      (let [mid (/ (+ lo hi) 2)]
        (if (<= (get xs mid) x) (set! lo (+ mid 1)) (set! hi mid))))
    lo))

;;; Bitwise and, or and exclusive or of two integers.
(defn bit-and [(a i64) (b i64)] (-> i64)
  (& a b))

(defn bit-or [(a i64) (b i64)] (-> i64)
  (| a b))

(defn bit-xor [(a i64) (b i64)] (-> i64)
  (^ a b))

;;; Every byte in order, made once, so a one-byte text is a slice of it and costs nothing. The
;;; ready word comes first, read and written atomically: whoever sees it set sees the bytes.
(defstruct ByteTable [(ready i64) (bytes (slice u8))])

(defn every-byte [] (-> (slice u8))
  (let [t (primitive/alloc-static ByteTable)
        ready (primitive/cast (ptr i64) t)]
    (when (= (atomic/read ready) 0)
      (init-lock!)
      (when (= (atomic/read ready) 0)
        (let [(mut b) (ArrayList::new [u8] (malloc-allocator))]
          (for i (range 0 256) (push! (mut b) (cast u8 i)))
          (set! (.bytes t) (slice b))
          (atomic/store ready 1)))
      (init-unlock!))
    (.bytes t)))

(defn text-of-byte [(c i64)] (-> (slice u8))
  (when (or (< c 0) (> c 255)) (panic "byte-text of {}, which is no byte" c))
  (subslice (every-byte) c (+ c 1)))

(defn line-of [(src (slice u8)) (at i64)] (-> i64)
  (.line (line-col src at)))

(defn col-of [(src (slice u8)) (at i64)] (-> i64)
  (.col (line-col src at)))

(defn file-exists? [(path (slice u8))] (-> bool)
  (let [tracked (dep-in-frame?)
        stamp (if tracked (file-stamp path) "")
        there (file-exists-raw? path)]
    (when tracked (dep-input! (join "e:" path) (if there "1" "0") stamp))
    there))

(defn file-exists-raw? [(path (slice u8))] (-> bool)
  (match (fs/exists? (value-allocator) path)
    (Ok [e] e)
    (Err [_] false)))

;;; The names of the files in a directory, one per line after a kind letter: `f` for a file, `d`
;;; for a directory, `l` for anything else (a link, which only a look at the target can settle).
;;; Empty if the directory cannot be opened. One system call per directory, not per question.
(defn dir-listing [(path (slice u8))] (-> (slice u8))
  (let [tracked (dep-in-frame?)
        stamp (if tracked (file-stamp (if (= (len path) 0) "." path)) "")
        listing (dir-listing-raw path)]
    (when tracked (dep-input! (join "d:" path) (print-of listing) stamp))
    listing))

(defn dir-listing-raw [(path (slice u8))] (-> (slice u8))
  (let [(mut out) (ArrayList::new [u8] (value-allocator))
        began (now-ns)]
    (match (fs/Directory::open (malloc-allocator)
                               (if (= (len path) 0) "." path))
      (Ok [d]
          (let [(mut dir) d
                (mut go) true]
            (while go
              (match (fs/Directory::next! (mut dir))
                (Ok [(Some [e])]
                    (push! (mut out)
                           (match (.kind e)
                             (fs/EntryRegular [] (cast u8 102))
                             (fs/EntryDirectory [] (cast u8 100))
                             (_ (cast u8 108))))
                    (for b (.name e) (push! (mut out) b))
                    (push! (mut out) (cast u8 10)))
                (_ (set! go false))))
            (fs/Directory::close! (mut dir))
            0))
      (Err [_] 0))
    (read-trace-listed! path began)
    (slice out)))

;;; Exists and can be read: a directory exists, but is not a file.
(defn readable-file? [(path (slice u8))] (-> bool)
  (if (dep-in-frame?)
      (let [stamp (file-stamp path)
            print (file-print path)]
        (dep-input! (join "f:" path) print stamp)
        (!= print "missing"))
      (readable-raw? path)))

;;; The same question with nothing recorded: the file is opened and one byte asked of it, which a
;;; directory refuses. What the file says is not read.
(defn readable-raw? [(path (slice u8))] (-> bool)
  (let [a (value-allocator)
        fd
          (os/open (str/to-cstr a path)
                   (primitive/cast i32 (| fs/O_RDONLY fs/O_CLOEXEC))
                   0)]
    (if (< fd (: 0 i32))
        false
        (let [buf
                (match (alloc [u8] a 1)
                  (Some [b] b)
                  (None [] (panic "no memory to read {}" path)))
              n (read fd (primitive/cast (ptr i8) (data buf)) (primitive/cast isize 1))]
          (os/close fd)
          (>= (primitive/cast i64 n) 0)))))

;;; What a file says, as an input's print: "missing" when it cannot be read.
(defn file-print [(path (slice u8))] (-> (slice u8))
  (if (file-exists-raw? path)
      (match (fs/read-file (value-allocator) path)
        (Ok [b] (print-of b))
        (Err [_] "missing"))
      "missing"))

;;; UTF-8 text as code points. A truncated sequence ends with a -1.
(defn code-points-of [(s (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (value-allocator))
        (mut i) 0
        n (len s)]
    (while (< i n)
      (let [c (cast i64 (get s i))]
        (cond (< c 128) (do (push! (mut out) c) (set! i (+ i 1)))
              (and (< c 224) (< (+ i 1) n))
                (do
                  (push! (mut out)
                         (+ (* (- c 192) 64) (- (cast i64 (get s (+ i 1))) 128)))
                  (set! i (+ i 2)))
              (and (< c 240) (< (+ i 2) n))
                (do
                  (push! (mut out)
                         (+ (* (- c 224) 4096)
                            (* (- (cast i64 (get s (+ i 1))) 128) 64)
                            (- (cast i64 (get s (+ i 2))) 128)))
                  (set! i (+ i 3)))
              (< (+ i 3) n)
                (do
                  (push! (mut out)
                         (+ (* (- c 240) 262144)
                            (* (- (cast i64 (get s (+ i 1))) 128) 4096)
                            (* (- (cast i64 (get s (+ i 2))) 128) 64)
                            (- (cast i64 (get s (+ i 3))) 128)))
                  (set! i (+ i 4)))
              :else (do (push! (mut out) -1) (set! i n)))))
    out))

;;; Code points as UTF-8 text.
(defn text-of-points [(points (ArrayList i64))] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] (value-allocator))]
    (for cp points
      (cond (< cp 128) (push! (mut b) (cast u8 cp))
            (< cp 2048)
              (do
                (push! (mut b) (cast u8 (+ 192 (/ cp 64))))
                (push! (mut b) (cast u8 (+ 128 (% cp 64)))))
            (< cp 65536)
              (do
                (push! (mut b) (cast u8 (+ 224 (/ cp 4096))))
                (push! (mut b) (cast u8 (+ 128 (% (/ cp 64) 64))))
                (push! (mut b) (cast u8 (+ 128 (% cp 64)))))
            :else
              (do
                (push! (mut b) (cast u8 (+ 240 (/ cp 262144))))
                (push! (mut b) (cast u8 (+ 128 (% (/ cp 4096) 64))))
                (push! (mut b) (cast u8 (+ 128 (% (/ cp 64) 64))))
                (push! (mut b) (cast u8 (+ 128 (% cp 64)))))))
    (slice b)))

;;; Bytes as text, each as it is: what iterating over a text gives back.
(defn text-of-bytes [(bytes (ArrayList i64))] (-> (slice u8))
  (let [(mut b) (ArrayList::new [u8] (value-allocator))]
    (for x bytes (push! (mut b) (cast u8 x)))
    (slice b)))

;;; Unicode's general category of a code point, as its two-letter abbreviation.
(defn unicode-category [(cp i64)] (-> (slice u8))
  (u/general-category-abbrev (u/general-category (str/Rune :value (cast u32 cp)))))

(defn now-ms [] (-> i64)
  (match (monotonic-now-ms)
    (Ok [now] now)
    (Err [_] 0)))

;;; The most memory the process has held at once, in bytes (macOS's `ru_maxrss`).
(extern getrusage :cc (cc/C) [i32 (ptr i8)] (-> i32))

(defstruct Usage
  [(utime-s i64)
   (utime-us i64)
   (stime-s i64)
   (stime-us i64)
   (maxrss i64)
   (r5 i64)
   (r6 i64)
   (r7 i64)
   (r8 i64)
   (r9 i64)
   (r10 i64)
   (r11 i64)
   (r12 i64)
   (r13 i64)
   (r14 i64)
   (r15 i64)
   (r16 i64)
   (r17 i64)])

(defn max-rss [] (-> i64)
  (let [(mut u)
          (Usage
            :utime-s 0
            :utime-us 0
            :stime-s 0
            :stime-us 0
            :maxrss 0
            :r5 0
            :r6 0
            :r7 0
            :r8 0
            :r9 0
            :r10 0
            :r11 0
            :r12 0
            :r13 0
            :r14 0
            :r15 0
            :r16 0
            :r17 0)]
    (getrusage (: 0 i32) (cast (ptr i8) (mut u)))
    (.maxrss u)))

;;; Microseconds on the same clock.
(defn now-us [] (-> i64)
  (match (monotonic-now)
    (Ok [i] (+ (* (.sec i) 1000000) (/ (.nsec i) 1000)))
    (Err [_] 0)))

(defn now-ns [] (-> i64)
  (match (monotonic-now)
    (Ok [i] (+ (* (.sec i) 1000000000) (.nsec i)))
    (Err [_] 0)))

;;; The time each worker has spent auditing (see the memo audit), in nanoseconds: what a call's own
;;; time leaves out, of the audited calls it made.
(defstruct AuditOverhead [(ns (array i64 64))])

(defn audit-overhead [] (-> (ptr AuditOverhead))
  (primitive/alloc-static AuditOverhead))

(defn audit-overhead-now [] (-> i64)
  (load (primitive/cast (ptr i64)
                        (primitive/index (primitive/cast (ptr i8)
                                                         (audit-overhead))
                                         (* 8 (worker-slot))))))

(defn audit-overhead-add! [(ns i64)] (-> void)
  (let [at
          (primitive/cast (ptr i64)
                          (primitive/index (primitive/cast (ptr i8)
                                                           (audit-overhead))
                                           (* 8 (worker-slot))))]
    (store! at (+ (load at) ns))
    0))

;;; A lap of a timed run: how long since the last lap, under its label, how much memory the process
;;; has held at most, and where the system counts them, the instructions retired in the lap. The
;;; first lap only starts the clock, and says how many instructions came before it.
(defstruct Laps [(last i64) (instr i64) (user i64) (system i64) (faults i64)])

(defn lap! [(label (slice u8))] (-> void)
  (let [l (primitive/alloc-static Laps)
        now (now-us)
        instr (instructions-retired)
        user (cpu-user-us)
        system (cpu-system-us)
        faults (page-faults)]
    (if (> (.last l) 0)
        (let [us (- now (.last l))]
          (if (>= instr 0)
              (println "{:>4}.{} ms  {}  ({} MB, {}.{} M instructions; on the CPU {} ms ours, {} ms the system's; {} page faults)"
                       (/ us 1000)
                       (/ (% us 1000) 100)
                       label
                       (/ (max-rss) 1048576)
                       (/ (- instr (.instr l)) 1000000)
                       (/ (% (- instr (.instr l)) 1000000) 100000)
                       (/ (- user (.user l)) 1000)
                       (/ (- system (.system l)) 1000)
                       (- faults (.faults l)))
              (println "{:>4}.{} ms  {}  ({} MB)"
                       (/ us 1000)
                       (/ (% us 1000) 100)
                       label
                       (/ (max-rss) 1048576))))
        (when (>= instr 0)
          (println "         start  ({}.{} M instructions before the first lap)"
                   (/ instr 1000000)
                   (/ (% instr 1000000) 100000))))
    (set! (.last l) now)
    (set! (.instr l) instr)
    (set! (.user l) user)
    (set! (.system l) system)
    (set! (.faults l) faults)
    0))

;;; Trees can be as deep as a merged statement list is long, so builds run on a thread
;;; with room for that.
(defn run-on-big-stack [(body (fnptr (cc/C) [(ptr i8)] (ptr i8)))] (-> void)
  (let [(mut t) (Thread :handle (cast (ptr i8) 0))]
    (when (!= (Thread::spawn-configured (cast (ptr Thread) (mut t))
                                        body
                                        (cast (ptr i8) 0)
                                        (ThreadConfig
                                          :stack-size 1073741824
                                          :guard-size 0))
              (: 0 i32))
      (panic "could not start the build thread"))
    (join-thread! (mut t))
    0))

(defn join-thread! [(t (mut Thread))] (-> void)
  (join (cast (ptr Thread) (mut t)))
  0)

;;; How many threads the machine can run at once.
(defn cores [] (-> i64)
  (match (available-parallelism)
    (Ok [n] (if (> n 0) n 1))
    (Err [_] 1)))

;;; One offer of work inside a run: `seq` which offer this place holds (0: none yet), `on`
;;; while workers may still join, `left` how many are in it, and the rest as for a run.
(defstruct HelpRun
  [(seq i64)
   (on bool)
   (left i64)
   (body (fnptr (cc/C) [(ptr i8)] (ptr i8)))
   (job (ptr i8))
   (apart i64)
   (apart-region i64)
   (slot i64)
   ;; When the offer was made by a memo computing: what each helper read, for it.
   (inherit bool)
   (read (ArrayList i64))])

;;; The workers: started the first time a program runs anything in parallel, then parked between
;;; runs, so a run costs a wake-up rather than a thread's start. Each has a slot, 1…; the thread
;;; that asks for a run is slot 0 and works too.
(defstruct Pool
  [(ready bool)
   (mutex Mutex)
   (wake Condition)  ; a new run
   (done Condition)  ; the last worker of a run finished
   (threads (ArrayList Thread))
   (started i64)  ; workers there are: slots 1..started
   (round i64)  ; runs so far
   (born i64)  ; the round before the run new workers were started for
   (want i64)  ; threads in this run, slot 0 among them
   (left i64)  ; workers of this run still at it
   (running bool)
   (body (fnptr (cc/C) [(ptr i8)] (ptr i8)))
   (job (ptr i8))
   ;; When the run was started by a memo computing, what each worker read, for it.
   (inherit bool)
   (read (ArrayList i64))
   ;; The region of whatever started the run: what the workers make is its, so each works in it
   ;; (through a cursor of its own) and their values live as long as what they were made for.
   (region i64)
   ;; Whether whoever started the run works apart (see `apart-inherit!`), and the scratch
   ;; region it works in: what the workers make is made there too, each through a cursor of
   ;; its own, so the answer's copy out finds it and the rest goes with the region.
   (apart i64)
   (apart-region i64)
   ;; A run inside a run. A job that maps over a list of its own (`run-map-workers`) while the
   ;; pool runs offers it here, and whichever workers have nothing to do in the run under way
   ;; take part: `help-seq` counts the offers, `help-on` says one stands, `help-left` how many
   ;; workers are in it, and the rest is as for a run.
   ;; Several offers may stand at once, each in a place of its own (`helps`); `help-seq` counts
   ;; every offer made, for a worker looking out for one.
   (help-seq i64)
   (helps (ArrayList HelpRun))
   ;; Where the workers of the run under way sleep when they find nothing to do, if they look
   ;; for offers too (`help-wanted?`): an offer wakes them there. 0 for none.
   (idle-gate i64)])

(defn pool-fail [(what (slice u8))] (-> void)
  (panic "worker pool: {}" what))

(defn pool [] (-> (ptr Pool))
  (let [p (primitive/alloc-static Pool)]
    (unless (.ready p)
      (match (Mutex::init (field p mutex))
        (Ok [_] 0)
        (Err [_] (pool-fail "no mutex")))
      (match (Condition::init (field p wake))
        (Ok [_] 0)
        (Err [_] (pool-fail "no condition")))
      (match (Condition::init (field p done))
        (Ok [_] 0)
        (Err [_] (pool-fail "no condition")))
      (set! (.threads p) (ArrayList::new [Thread] (malloc-allocator)))
      (set! (.helps p) (ArrayList::new [HelpRun] (malloc-allocator)))
      (for _ (range 0 4) (push! (mut (.helps p)) (primitive/zeroed HelpRun)))
      (set! (.read p) (ArrayList::new [i64] (malloc-allocator)))
      (for _ (range 0 (max-workers))
        (push! (mut (.threads p)) (Thread :handle (cast (ptr i8) 0))))
      (set! (.ready p) true))
    p))

(defn pool-lock! [(p (ptr Pool))] (-> void)
  (match (Mutex::lock! (field p mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot lock"))))

(defn pool-unlock! [(p (ptr Pool))] (-> void)
  (match (Mutex::unlock! (field p mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot unlock"))))

(defn pool-wait! [(p (ptr Pool)) (c (ptr Condition))] (-> void)
  (match (Condition::wait! c (field p mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot wait"))))

;;; The C library's RTLD_DEFAULT, the handle dlsym looks through every loaded library with: 0 for
;;; glibc and musl, -2 on Darwin.
(defn rtld-default [] (-> (ptr i8))
  (os/os-pick (primitive/cast (ptr i8) 0)
              (primitive/cast (ptr i8) -2)
              (primitive/cast (ptr i8) 0)))

;;; Ask for the fast cores, where a machine has fast and slow ones: the work is someone waiting.
;;; Only Darwin has the call, so it is found when the program runs; elsewhere there is none.
(defn prefer-fast-cores! [] (-> void)
  (let [f
          (os/dlsym-cached (primitive/alloc-static (ptr i8))
                           c"pthread_set_qos_class_self_np"
                           (rtld-default))]
    (unless (= (primitive/cast i64 f) 0)
      ;; QOS_CLASS_USER_INTERACTIVE
      (primitive/call-ptr (primitive/cast (fnptr (cc/C) [i32 i32] i32) f)
                          (: 33 i32)
                          (: 0 i32)))
    0))

;;; A worker: wait for a run that wants it, do its part, say so; forever.
;;; A worker's job is done and its stack is shallow again: the pages below, which a deep job
;;; wrote to (a tree walked to its leaves), go back to the system. They stay the stack's, empty
;;; until it next grows into them; kept, every worker would hold its deepest job's stack for
;;; as long as the program runs. A worker's stack is 512 MB (`spawn-worker!`), so the 64 MB
;;; below where it stands now are its own.
(defn stack-trim! [] (-> void)
  (let [(mut here) 0
        sp (primitive/cast i64 (primitive/cast (ptr i8) (mut here)))
        hi (& (- sp 262144) -16384)
        lo (- hi 67108864)
        p (mmap (primitive/cast (ptr i8) lo) (primitive/cast isize (- hi lo)) (: 3 i32)
                (primitive/cast i32 (+ MAP-ANON-PRIVATE 16)) (: -1 i32) 0)]
    (when (!= (primitive/cast i64 p) lo) (panic "cannot give back a worker's stack pages"))
    0))

;;; The place of an offer this worker may still join and has not, or -1. Under the pool's lock.
(defn help-open [(p (ptr Pool)) (seen (ArrayList i64))] (-> i64)
  (let [(mut at) -1]
    (for i (range 0 (len (.helps p)))
      (let [h (get (.helps p) i)]
        (when (and (< at 0) (.on h) (!= (.seq h) (get seen i)))
          (set! at i))))
    at))

;;; With HL_RUN_TRACE set, each run on many threads says how long it took and how long its
;;; threads were at it, all together: a run whose threads were mostly waiting shows as a small
;;; share of what that many threads could have done.
(defstruct RunTrace [(on i64) (busy i64) (joined i64) (seq i64) (began i64)])

(defn run-trace [] (-> (ptr RunTrace))
  (let [t (primitive/alloc-static RunTrace)]
    (when (= (.on t) 0) (set! (.on t) (if (env-on? "HL_RUN_TRACE") 1 2)))
    t))

(defn run-tracing? :inline (Always) [] (-> bool)
  (= (.on (run-trace)) 1))

;;; A thread's part in a run, from `began`.
(defn run-trace-part! [(began i64)] (-> void)
  (when (> began 0)
    (let [t (run-trace)]
      (atomic/add (field t busy) (- (now-ns) began))
      (atomic/add (field t joined) 1)))
  0)

(defn pool-worker [(arg (ptr i8))] (-> (ptr i8))
  (let [slot (primitive/cast i64 arg)
        p (pool)
        (mut seen) 0
        ;; The offer this worker last took from each place.
        (mut seen-help) (ArrayList::new [i64] (malloc-allocator))]
    (for _ (range 0 4) (push! (mut seen-help) 0))
    (register-worker! slot)
    (prefer-fast-cores!)
    (pool-lock! p)
    ;; Started for the run about to begin, which may have begun before this got the lock.
    (set! seen (.born p))
    (loop
      ;; Runs often come one after another: look for the next a little while, then sleep. An
      ;; offer of work inside the run under way wakes a worker too.
      (while (and (= (.round p) seen) (< (help-open p seen-help) 0))
        (pool-unlock! p)
        (let [(mut spins) 0
              offers (atomic/read (field p help-seq))]
          (while (and (< spins 20000)
                      (= (atomic/read (field p round)) seen)
                      (= (atomic/read (field p help-seq)) offers))
            (set! spins (+ spins 1))))
        (pool-lock! p)
        (when (and (= (.round p) seen) (< (help-open p seen-help) 0))
          (pool-wait! p (field p wake))))
      (if (= (.round p) seen)
          ;; Help with a run inside the run: this worker has no part in that one, or has done it.
          (let [at (help-open p seen-help)
                h (elem (mut (.helps p)) at)
                body (.body h)
                job (.job h)
                apart (.apart h)
                apart-region (.apart-region h)
                view (.slot h)
                inherit (.inherit h)]
            (set! (mut seen-help) at (.seq h))
            (set! (.left h) (+ (.left h) 1))
            (pool-unlock! p)
            (when inherit (dep-begin!))
            (when (!= apart-region 0) (region-enter-id! apart-region))
            (apart-inherit! apart)
            (set! (.in-job (thread-regions)) 1)
            (set! (.settings-view (thread-regions)) (+ view 1))
            (let [began (if (run-tracing?) (now-ns) 0)]
              (body job)
              (run-trace-part! began))
            (set! (.settings-view (thread-regions)) 0)
            (set! (.in-job (thread-regions)) 0)
            (stack-trim!)
            (apart-inherit! 0)
            (when (!= apart-region 0) (region-leave!))
            (let [(mut notes)
                    (if inherit (dep-take-notes!) (ArrayList::new [i64] (malloc-allocator)))]
              (pool-lock! p)
              (for x notes (push! (mut (.read h)) x))
              (free! (mut notes)))
            (set! (.left h) (- (.left h) 1))
            (when (= (.left h) 0)
              (match (Condition::notify-all! (field p done))
                (Ok [_] 0)
                (Err [_] (pool-fail "cannot notify")))))
          (do
            (set! seen (.round p))
            (when (< slot (.want p))
              (let [body (.body p)
                    job (.job p)
                    inherit (.inherit p)
                    region (.region p)
                    apart (.apart p)
                    apart-region (.apart-region p)]
                (pool-unlock! p)
                (when inherit (dep-begin!))
                (when (!= region 0) (region-enter-id! region))
                (when (!= apart-region 0) (region-enter-id! apart-region))
                (apart-inherit! apart)
                (set! (.in-job (thread-regions)) 1)
                (let [began (if (run-tracing?) (now-ns) 0)]
                  (body job)
                  (run-trace-part! began))
                (set! (.in-job (thread-regions)) 0)
                (stack-trim!)
                (apart-inherit! 0)
                (when (!= apart-region 0) (region-leave!))
                (when (!= region 0) (region-leave!))
                (let [(mut read)
                        (if inherit
                            (dep-take-notes!)
                            (ArrayList::new [i64] (malloc-allocator)))]
                  (pool-lock! p)
                  (for x read (push! (mut (.read p)) x))
                  (free! (mut read)))
                (atomic/store (field p left) (- (.left p) 1))
                (when (= (.left p) 0)
                  (match (Condition::notify-all! (field p done))
                    (Ok [_] 0)
                    (Err [_] (pool-fail "cannot notify")))))))))
    arg))

;;; Arrivals: of the `total` callers that arrive with one key, the last is told so, and goes on
;;; with what needed all of them, while the others go do something else. Nobody waits.
(defstruct Arrivals [(lock i64) (ready bool) (counts (HashMap (slice u8) i64))])

(defn arrivals [] (-> (ptr Arrivals))
  (let [a (primitive/alloc-static Arrivals)]
    (unless (.ready a)
      (init-lock!)
      (unless (.ready a)
        (set! (.counts a)
              (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
        (set! (.ready a) true))
      (init-unlock!))
    a))

(defn arrive! [(key (slice u8)) (total i64)] (-> bool)
  (let [a (arrivals)
        word (cast (ptr i64) a)]
    (spin-lock! word)
    (let [n (+ (match (get (.counts a) key) (Some [c] c) (None [] 0)) 1)]
      (set! (mut (.counts a)) key n)
      (spin-unlock! word)
      (= n total))))

;;; A new build: nobody has arrived anywhere. Only while no other thread runs.
(defn arrivals-reset! [] (-> void)
  (let [a (arrivals)]
    (set! (.counts a)
          (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
    0))

;;; A lock to wait under: whoever finds nothing to do sleeps on it until whoever adds work, or
;;; finishes the last of it, wakes them.
(defstruct Gate [(mutex Mutex) (cond Condition)])

(defn gate-new [] (-> (ptr Gate))
  (let [g (box! (malloc-allocator) Gate (primitive/zeroed Gate))]
    (match (Mutex::init (field g mutex))
      (Ok [_] 0)
      (Err [_] (pool-fail "no mutex")))
    (match (Condition::init (field g cond))
      (Ok [_] 0)
      (Err [_] (pool-fail "no condition")))
    g))

(defn gate-free! [(g (ptr Gate))] (-> void)
  (Mutex::destroy! (field g mutex))
  (Condition::destroy! (field g cond))
  (primitive/free (primitive/cast (ptr i8) g))
  0)

(defn gate-lock! [(g (ptr Gate))] (-> void)
  (match (Mutex::lock! (field g mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot lock"))))

(defn gate-unlock! [(g (ptr Gate))] (-> void)
  (match (Mutex::unlock! (field g mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot unlock"))))

(defn gate-wait! [(g (ptr Gate))] (-> void)
  (match (Condition::wait! (field g cond) (field g mutex))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot wait"))))

(defn gate-wake-one! [(g (ptr Gate))] (-> void)
  (match (Condition::notify-one! (field g cond))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot notify"))))

(defn gate-wake-all! [(g (ptr Gate))] (-> void)
  (match (Condition::notify-all! (field g cond))
    (Ok [_] 0)
    (Err [_] (pool-fail "cannot notify"))))

;;; One more worker, in the next slot. Under the pool's lock.
(defn spawn-worker! [(p (ptr Pool))] (-> void)
  (let [slot (+ (.started p) 1)]
    (workers-in-use! (+ slot 1))
    (when (!= (Thread::spawn-configured (elem (mut (.threads p)) slot)
                                        (fnptr-of pool-worker)
                                        (primitive/cast (ptr i8) slot)
                                        (ThreadConfig
                                          :stack-size 536870912
                                          :guard-size 0))
              (: 0 i32))
      (panic "could not start a worker thread"))
    (set! (.started p) slot)
    0))

;;; Run `body(job)` on `n` threads at once, this one among them, and wait for all. Each worker
;;; thread has a big stack, since a parse of a deep file recurses. A body takes work until there
;;; is none, so a run asked for inside another, or from a worker, is this thread's alone.
(defn run-workers [(body (fnptr (cc/C) [(ptr i8)] (ptr i8)))
                   (job (ptr i8))
                   (n i64)] (-> void)
  (let [count (if (> n (max-workers)) (max-workers) n)
        p (pool)]
    (if (or (<= count 1) (!= (worker-slot) 0) (.running p))
        (body job)
        (do
          (pool-lock! p)
          (when (= (.started p) 0) (prefer-fast-cores!))
          (set! (.born p) (.round p))
          (while (< (.started p) (- count 1)) (spawn-worker! p))
          (set! (.running p) true)
          (set! (.body p) body)
          (set! (.job p) job)
          (set! (.inherit p) (dep-in-frame?))
          (set! (.read p) (ArrayList::new [i64] (malloc-allocator)))
          (set! (.region p) (let [r (region-current)] (if (.lasting r) 0 (primitive/cast i64 r))))
          (set! (.apart p) (.apart (thread-regions)))
          (set! (.apart-region p)
                (if (> (.apart (thread-regions)) 0) (primitive/cast i64 (region-current)) 0))
          (set! (.want p) count)
          (atomic/store (field p left) (- count 1))
          (atomic/store (field p round) (+ (.round p) 1))
          (match (Condition::notify-all! (field p wake))
            (Ok [_] 0)
            (Err [_] (pool-fail "cannot notify")))
          (pool-unlock! p)
          (let [t (thread-regions)
                was (.in-job t)
                began (if (run-tracing?) (now-ns) 0)]
            (when (> began 0)
              (atomic/store (field (run-trace) busy) 0)
              (atomic/store (field (run-trace) joined) 0)
              (set! (.began (run-trace)) began))
            (set! (.in-job t) 1)
            (body job)
            (run-trace-part! began)
            (set! (.in-job t) was))
          ;; The others are usually nearly done: watch a little while before sleeping.
          (let [(mut spins) 0]
            (while (and (< spins 20000) (> (atomic/read (field p left)) 0))
              (set! spins (+ spins 1))))
          (pool-lock! p)
          (while (> (.left p) 0) (pool-wait! p (field p done)))
          (when (run-tracing?)
            (let [r (run-trace)
                  wall (- (now-ns) (.began r))]
              (set! (.seq r) (+ (.seq r) 1))
              (when (> wall 300000)
                (eprintln "[run {}] {} us, {} threads asked, its threads at it {} us in {} parts: {}% of {} threads"
                          (.seq r)
                          (/ wall 1000)
                          count
                          (/ (atomic/read (field r busy)) 1000)
                          (atomic/read (field r joined))
                          (/ (* 100 (atomic/read (field r busy))) (* wall count))
                          count))))
          (set! (.running p) false)
          (let [(mut read) (.read p)]
            (pool-unlock! p)
            ;; What the workers read, this thread's memo read.
            (for x read (dep-note-id! x))
            (free! (mut read)))))
    0))

;;; Run `body(job)` for a map over a list: each thread in it takes the next element it finds
;;; free until none is left, so it does not matter how many take part or when they come. Asked
;;; while the pool runs (by one of its jobs), the work is offered to the workers with nothing to
;;; do in that run, and this thread does its share and waits for those that joined; one offer
;;; stands at a time, and a second asker does its work alone. Not while what answers were made
;;; from is tracked: there a run's workers say what they read to the one who asked.
(defn run-map-workers [(body (fnptr (cc/C) [(ptr i8)] (ptr i8)))
                       (job (ptr i8))
                       (n i64)] (-> void)
  (let [p (pool)]
    ;; A thread that is itself helping does its own maps alone: whoever joined would read its
    ;; settings, and it reads another's.
    (if (and (> n 1) (.running p) (> (.started p) 0) (not (reclaiming?))
             (= (.settings-view (thread-regions)) 0))
        (do
          (pool-lock! p)
          ;; A place no offer stands in and no worker is still leaving.
          (let [(mut at) -1]
            (for i (range 0 (len (.helps p)))
              (let [h (get (.helps p) i)]
                (when (and (< at 0) (not (.on h)) (= (.left h) 0)) (set! at i))))
            (if (or (< at 0) (not (.running p)))
                (do (pool-unlock! p) (body job))
                (let [h (elem (mut (.helps p)) at)]
                  (set! (.body h) body)
                  (set! (.job h) job)
                  (set! (.apart h) (.apart (thread-regions)))
                  (set! (.apart-region h)
                        (if (> (.apart (thread-regions)) 0) (primitive/cast i64 (region-current)) 0))
                  (set! (.slot h) (worker-slot))
                  ;; While answers are tracked, what the helpers read is what this thread's
                  ;; memo read, as with a run's workers.
                  (set! (.inherit h) (dep-in-frame?))
                  (set! (.read h) (ArrayList::new [i64] (malloc-allocator)))
                  (atomic/store (field p help-seq) (+ (.help-seq p) 1))
                  (set! (.seq h) (.help-seq p))
                  (set! (.on h) true)
                  (match (Condition::notify-all! (field p wake))
                    (Ok [_] 0)
                    (Err [_] (pool-fail "cannot notify")))
                  (let [idle (.idle-gate p)]
                    (pool-unlock! p)
                    (when (!= idle 0)
                      (let [g (primitive/cast (ptr Gate) idle)]
                        (gate-lock! g)
                        (gate-wake-all! g)
                        (gate-unlock! g))))
                  (body job)
                  (pool-lock! p)
                  (set! (.on h) false)
                  (while (> (.left h) 0) (pool-wait! p (field p done)))
                  (let [(mut read) (.read h)]
                    (set! (.read h) (ArrayList::new [i64] (malloc-allocator)))
                    (pool-unlock! p)
                    (for x read (dep-note-id! x))
                    (free! (mut read)))))))
        (run-workers body job n))
    0))

;;; A run whose workers find their work as they go (a walk) has them take offers too: a job of
;;; the run that maps over a list of its own (a big file's pieces, say) is helped by the others
;;; before they take anything new, so one job's own work never waits behind the rest's.
;;; `idle-gate!` says where such workers sleep, for an offer to wake them; 0 when the run is over.
(defn idle-gate! [(g (ptr Gate))] (-> void)
  (let [p (pool)]
    (pool-lock! p)
    (set! (.idle-gate p) (primitive/cast i64 g))
    (pool-unlock! p)
    0))

;;; Whether offers have been made since this thread last found none to take: a read of one
;;; number, for a worker to ask between items.
(defn help-wanted? :inline (Always) [] (-> bool)
  (!= (atomic/read (field (pool) help-seq)) (.help-seq (thread-regions))))

;;; Take part in an offer this thread has not taken, if one stands, as a worker with nothing to
;;; do would (see `pool-worker`), and come back to what this thread was at: its own place among
;;; the regions, its own settings, its own item.
(defn help-now! [] (-> void)
  (let [p (pool)
        t (thread-regions)]
    (while (< (len (.help-took t)) (len (.helps p))) (push! (mut (.help-took t)) 0))
    (pool-lock! p)
    (let [at (help-open p (.help-took t))]
      (if (< at 0)
          (do
            (set! (.help-seq t) (.help-seq p))
            (pool-unlock! p))
          (let [h (elem (mut (.helps p)) at)
                body (.body h)
                job (.job h)
                apart (.apart h)
                apart-region (.apart-region h)
                view (.slot h)
                inherit (.inherit h)
                own-apart (.apart t)
                own-view (.settings-view t)
                own-item (.item t)
                own-job (.in-job t)]
            (set! (mut (.help-took t)) at (.seq h))
            (set! (.left h) (+ (.left h) 1))
            (pool-unlock! p)
            (when inherit (dep-begin!))
            (when (!= apart-region 0) (region-enter-id! apart-region))
            (apart-inherit! apart)
            (set! (.in-job t) 1)
            (set! (.settings-view t) (+ view 1))
            (let [began (if (run-tracing?) (now-ns) 0)]
              (body job)
              (run-trace-part! began))
            (set! (.settings-view t) own-view)
            (set! (.in-job t) own-job)
            (set! (.item t) own-item)
            (set! (.apart t) own-apart)
            (when (!= apart-region 0) (region-leave!))
            (let [(mut notes)
                    (if inherit (dep-take-notes!) (ArrayList::new [i64] (malloc-allocator)))]
              (pool-lock! p)
              (for x notes (push! (mut (.read h)) x))
              (free! (mut notes)))
            (set! (.left h) (- (.left h) 1))
            (when (= (.left h) 0)
              (match (Condition::notify-all! (field p done))
                (Ok [_] 0)
                (Err [_] (pool-fail "cannot notify"))))
            (pool-unlock! p))))
    0))

;;; How many threads the program has put to work so far, this one among them: what work with
;;; no plan of its own to ask may spread over. One, until something runs in parallel.
(defn pool-size [] (-> i64)
  (+ (.started (pool)) 1))

;;; Where a solve's time went, rule by rule (see `rule-timed` in hl.facts): each label's
;;; nanoseconds and how often it ran, said after each solve, most first.
(defstruct RuleTimes [(ready bool) (ns (HashMap (slice u8) i64)) (runs (HashMap (slice u8) i64))])

(defn rule-times [] (-> (ptr RuleTimes))
  (let [t (primitive/alloc-static RuleTimes)]
    (unless (.ready t)
      (set! (.ns t) (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.runs t) (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.ready t) true))
    t))

(defn rule-time! [(label (slice u8)) (ns i64)] (-> void)
  (let [t (rule-times)]
    (set! (mut (.ns t)) label (+ ns (match (get (.ns t) label) (Some [n] n) (None [] 0))))
    (set! (mut (.runs t)) label (+ 1 (match (get (.runs t) label) (Some [n] n) (None [] 0))))
    0))

(defn rule-times-report! [] (-> void)
  (let [t (rule-times)
        (mut labels) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut costs) (ArrayList::new [i64] (malloc-allocator))]
    (for label (.ns t)
      (push! (mut labels) label)
      (push! (mut costs) (match (get (.ns t) label) (Some [n] n) (None [] 0))))
    (for i (sort-order-int costs true)
      (eprintln "{} us  {} runs  {}"
                (/ (get costs i) 1000)
                (match (get (.runs t) (get labels i)) (Some [n] n) (None [] 0))
                (get labels i)))
    (free! (mut labels))
    (free! (mut costs))
    0))

;;; What a program answered, carried from the thread it ran on to `main`.
(defstruct Answer [(value i64)])

(defn answered [] (-> (ptr Answer))
  (primitive/alloc-static Answer))

(defn answer! [(v i64)] (-> void)
  (set! (.value (answered)) v)
  0)

(defn answer [] (-> i64)
  (.value (answered)))

;;; Command-line arguments, for a program written in `.rules`.
(defn args-init! [(argc i32) (argv (ptr (ptr i8)))] (-> void)
  (workers)
  (args/init! argc argv)
  0)

(defn arg-count [] (-> i64)
  (args/count))

(defn arg-at [(i i64)] (-> (slice u8))
  (args/nth i))

(defn digit-i64? [(c i64)] (-> bool)
  (and (>= c 48) (<= c 57)))

;; ---------------------------------------------------------------- dependencies

;;; What each memo's answer was made from, so answers can be kept from one build to the next, and
;;; what changed can stop where it makes no difference. A node is named by text: a memo's answer (its
;;; function, a NUL, its key), a setting ("s:" and its name), or an input: a file read ("f:"), a
;;; directory listed ("d:"), a path asked about ("e:", "r:").
;;;
;;; Every change moves the revision on. Each node keeps the revision it last changed in, and a
;;; memo's answer the revision it was last known current in and the nodes it read, in order. Asked
;;; for in a later revision, an answer first brings each node it read up to date, in the order it
;;; read them (a memo's answer through that memo, by its key); only if one of them changed since is
;;; it computed again, and only if the new answer differs from the old does it count as changed
;;; itself. So an edit that leaves something's answer the same goes no further than that answer.

;;; A frame's notes: what the memo computing on a worker has read, each once. `literals` holds the
;;; addresses of names given as literals, the same each time a place reads them, so a setting read
;;; in a loop is checked without hashing.
(defstruct DepFrame
  [(notes (ArrayList i64))
   (seen IntTable)
   (literals (ArrayList i64))
   ;; Elements read by index, by site and index, each once; and their keys, in the order read. A
   ;; note -1 - i stands for the element `pending[i]`, whose node is found when the frame closes,
   ;; under the lock taken then anyway, rather than once per read.
   (elements IntTable)
   (pending (ArrayList i64))
   ;; Whether a numbered node was noted by its id, as what other threads read is: then an element
   ;; pending may be one noted already.
   (mixed bool)])

;;; A frame that closed: its tables freed, its notes kept.
(defn frame-free! [(f (mut DepFrame))] (-> void)
  (free! (mut (.keys (.seen f))))
  (free! (mut (.vals (.seen f))))
  (free! (mut (.keys (.elements f))))
  (free! (mut (.vals (.elements f))))
  (free! (mut (.literals f)))
  (free! (mut (.pending f)))
  0)

;;; A closing frame's notes with each element read by index replaced by its node, made when it
;;; has none, and still each once. Under the lock.
(defn frame-resolve! [(d (ptr Deps)) (f (mut DepFrame))] (-> void)
  (when (> (len (.pending f)) 0)
    (let [(mut out) (ArrayList::new [i64] (malloc-allocator))]
      (reserve! (mut out) (len (.notes f)))
      (for x (.notes f)
        (if (>= x 0)
            (push! (mut out) x)
            (let [key (get (.pending f) (- -1 x))
                  site (/ key 4294967296)
                  id (dep-element! d site (- key (* site 4294967296)))]
              ;; Elements pending are each a different node; only one noted by id could repeat.
              (when (or (not (.mixed f)) (< (int-get (mut (.seen f)) id) 0))
                (push! (mut out) id)))))
      (free! (mut (.notes f)))
      (set! (.notes f) out)))
  0)

;;; The lock word comes first. `depth-key`: a thread-specific value holding how many frames the
;;; thread has open.
(defstruct Deps
  [(lock i64)
   (depth-key i64)
   (revision i64)
   (ready bool)
   (ids (HashMap (slice u8) i64))
   (texts (ArrayList (slice u8)))
   (changed (ArrayList i64))
   (verified (ArrayList i64))
   (reads (ArrayList (ArrayList i64)))
   ;; Who read each node, and whether a node may have changed since it was last current: a
   ;; change marks all that read it, through any number of answers, so an answer nothing marked is
   ;; current without a look at what it read. Who read a node is a chain of edges from its head,
   ;; through `edge-next`, each naming the reader in `edge-to`: one store for all of them, so a
   ;; node costs no allocation of its own.
   (dep-heads (ArrayList i64))
   (edge-to (ArrayList i64))
   (edge-next (ArrayList i64))
   (dirty (ArrayList bool))
   (prints (ArrayList (slice u8)))
   ;; A file input's size and modification time when its print was taken: while they stay, the
   ;; file is not read again to see whether it changed.
   (stamps (ArrayList (slice u8)))
   ;; Places that read an element of a setting by index: each one's setting and path before the
   ;; index, by the site's number; and the node each site and index is.
   ;; Query paths of database settings, by what a row would have to hold to be seen by one: the
   ;; setting, relation, first bound column and its value; or only the setting and relation when
   ;; no column is bound. A changed row finds the queries it changes there.
   (queries (HashMap (slice u8) (ArrayList i64)))
   (sites (ArrayList (slice u8)))
   (site-settings (ArrayList i64))
   (site-prefixes (ArrayList (slice u8)))
   (site-suffixes (ArrayList (slice u8)))
   ;; A query site's relation and column; and the sites of each setting.
   (site-rels (ArrayList (slice u8)))
   (site-cols (ArrayList i64))
   ;; A site that reads a map by Text: the keys it has read, numbered in turn.
   (site-keys (ArrayList (ArrayList (slice u8))))
   ;; Each site by its `site-key`.
   (site-ids (HashMap (slice u8) i64))
   (site-key-ids (ArrayList (HashMap (slice u8) i64)))
   (setting-sites (HashMap (slice u8) (ArrayList i64)))
   ;; Numbered nodes, the elements read by index: leaves that only change and are read, so each
   ;; keeps just that, its site and its index, apart from the nodes with text. Their ids carry
   ;; `numbered-tag`, and the rest is the place in these.
   (num-changed (ArrayList i64))
   (num-heads (ArrayList i64))
   (num-sites (ArrayList i64))
   (num-indexes (ArrayList i64))
   ;; Each site's nodes by index, in pages of 1024 made as an index in one is first read (-1: none).
   (site-pages (ArrayList (ArrayList (ArrayList i64))))
   ;; Each memo's function that brings one of its answers up to date, by the answer's node: its
   ;; store, read from the cache first if it must be, makes its key from the node's text.
   (ensurers (HashMap (slice u8) (fnptr (cc/C) [i64] i64)))
   (paths (HashMap (slice u8) (ArrayList (slice u8))))
   (stacks (ArrayList (ArrayList DepFrame)))
   (computed i64)
   (tracking bool)
   (untracked i64)
   ;; How many nodes with text the cache held when it was read: those numbered below are an earlier
   ;; run's, whose answers, made again while all they read is unchanged, are what they were.
   (before i64)])

(defn deps [] (-> (ptr Deps))
  (let [d (primitive/alloc-static Deps)]
    (unless (.ready d)
      (init-lock!)
      (unless (.ready d)
        (set! (.ids d)
              (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
        (set! (.texts d) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.changed d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.verified d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.reads d) (ArrayList::new [(ArrayList i64)] (malloc-allocator)))
        (set! (.dep-heads d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.edge-to d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.edge-next d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.dirty d) (ArrayList::new [bool] (malloc-allocator)))
        (set! (.prints d) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.stamps d) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.queries d)
              (HashMap::new [(slice u8) (ArrayList i64)]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.sites d) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.site-settings d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.site-prefixes d)
              (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.site-suffixes d)
              (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.site-rels d) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.site-cols d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.site-keys d)
              (ArrayList::new [(ArrayList (slice u8))] (malloc-allocator)))
        (set! (.site-ids d)
              (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
        (set! (.site-key-ids d)
              (ArrayList::new [(HashMap (slice u8) i64)] (malloc-allocator)))
        (set! (.setting-sites d)
              (HashMap::new [(slice u8) (ArrayList i64)]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.num-changed d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.num-heads d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.num-sites d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.num-indexes d) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.site-pages d)
              (ArrayList::new [(ArrayList (ArrayList i64))] (malloc-allocator)))
        (set! (.ensurers d)
              (HashMap::new [(slice u8) (fnptr (cc/C) [i64] i64)]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.paths d)
              (HashMap::new [(slice u8) (ArrayList (slice u8))]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.stacks d)
              (ArrayList::new [(ArrayList DepFrame)] (malloc-allocator)))
        (for _ (range 0 (max-workers))
          (push! (mut (.stacks d))
                 (ArrayList::new [DepFrame] (malloc-allocator))))
        (set! (.depth-key d) (key-new))
        (atomic/store (field d revision) 1)
        (atomic/store (field d untracked) 0)
        (set! (.ready d) true))
      (init-unlock!))
    d))

(defn deps-lock! [(d (ptr Deps))] (-> void)
  (spin-lock! (cast (ptr i64) d)))

(defn deps-unlock! [(d (ptr Deps))] (-> void)
  (spin-unlock! (cast (ptr i64) d)))

;;; A node's id, made when it has none: changed and known current in no revision yet. Under the lock.
(defn dep-id! [(d (ptr Deps)) (node (slice u8))] (-> i64)
  (match (get (.ids d) node)
    (Some [id] id)
    (None []
          (let [id (len (.texts d))
                kept (own-text node)]
            ;; The graph keeps its own copy: `node` is a value, of whatever region made it.
            (set! (mut (.ids d)) kept id)
            (push! (mut (.texts d)) kept)
            (push! (mut (.changed d)) 0)
            (push! (mut (.verified d)) 0)
            (push! (mut (.reads d)) (ArrayList::new [i64] (malloc-allocator)))
            (push! (mut (.dep-heads d)) -1)
            (push! (mut (.dirty d)) false)
            (push! (mut (.prints d)) "")
            (push! (mut (.stamps d)) "")
            id))))

;;; The bit a numbered node's id has.
(defn numbered-tag [] (-> i64)
  4611686018427387904)

(defn numbered? [(id i64)] (-> bool)
  (>= id (numbered-tag)))

;;; The first edge of who read node `id`, -1 for none. Under the lock.
(defn dep-head [(d (ptr Deps)) (id i64)] (-> i64)
  (if (numbered? id)
      (get (.num-heads d) (- id (numbered-tag)))
      (get (.dep-heads d) id)))

;;; The revision node `id` last changed in. Under the lock.
(defn dep-changed-at [(d (ptr Deps)) (id i64)] (-> i64)
  (if (numbered? id)
      (get (.num-changed d) (- id (numbered-tag)))
      (get (.changed d) id)))

;;; Node `to` read node `from`. Under the lock.
(defn dep-edge! [(d (ptr Deps)) (from i64) (to i64)] (-> void)
  (push! (mut (.edge-to d)) to)
  (push! (mut (.edge-next d)) (dep-head d from))
  (if (numbered? from)
      (set! (mut (.num-heads d))
            (- from (numbered-tag))
            (- (len (.edge-to d)) 1))
      (set! (mut (.dep-heads d)) from (- (len (.edge-to d)) 1)))
  0)

;;; A numbered node, element `index` of `site`: no text, which only tracing makes. Under the lock.
(defn dep-new-numbered! [(d (ptr Deps)) (site i64) (index i64)] (-> i64)
  (let [n (len (.num-changed d))]
    (push! (mut (.num-changed d)) 0)
    (push! (mut (.num-heads d)) -1)
    (push! (mut (.num-sites d)) site)
    (push! (mut (.num-indexes d)) index)
    (+ (numbered-tag) n)))

;;; A node's text: its own, or a numbered one's made from its site. Under the lock.
(defn dep-node-text [(d (ptr Deps)) (id i64)] (-> (slice u8))
  (if (numbered? id)
      (let [n (- id (numbered-tag))
            site (get (.num-sites d) n)
            index (get (.num-indexes d) n)
            keys (get (.site-keys d) site)]
        (join (get (.sites d) site)
              (join (if (< index (len keys)) (get keys index) (num-text index))
                    (get (.site-suffixes d) site))))
      (get (.texts d) id)))

;;; Dependencies are tracked from here on, which only a program that builds more than once needs.
;;; Before any memo has computed anything, since what it computed untracked could never be checked.
(defstruct TrackingSwitch [(on i64)])
(defn tracking-switch :inline (Always) [] (-> (ptr TrackingSwitch))
  (primitive/alloc-static TrackingSwitch))

(defn dep-track! [] (-> void)
  (let [d (deps)]
    (when (> (atomic/read (field d untracked)) 0)
      (panic "dependencies are tracked only from before any memo computes"))
    (set! (.tracking d) true)
    (atomic/store (field (tracking-switch) on) 1)
    0))

(defn dep-tracking? :inline (Always) [] (-> bool)
  (= (atomic/read (field (tracking-switch) on)) 1))

;;; A memo computed an answer while dependencies were not tracked.
(defn dep-untracked! [] (-> void)
  (let [d (deps)]
    (unless (.tracking d) (atomic/add (field d untracked) 1))
    0))

(defn dep-revision [] (-> i64)
  (atomic/read (field (deps) revision)))

;;; Whether this worker is computing a memo, so what it reads is noted.
(defn dep-in-frame? :inline (Always) [] (-> bool)
  (and (dep-tracking?)
       (!= (primitive/cast i64 (key-get (.depth-key (deps)))) 0)))

(defn dep-top [(d (ptr Deps)) (slot i64)] (-> i64)
  (- (len (get (.stacks d) slot)) 1))

;;; Node `id` was read by the memo this worker is computing.
(defn dep-note-id! [(id i64)] (-> void)
  (let [d (deps)
        slot (worker-slot)
        top (dep-top d slot)]
    (when (>= top 0)
      (when (numbered? id)
        (set! (.mixed (elem (mut (elem (mut (.stacks d)) slot)) top)) true))
      (when (< (int-get (mut (.seen (elem (mut (elem (mut (.stacks d)) slot))
                                          top)))
                        id)
               0)
        (int-put! (mut (.seen (elem (mut (elem (mut (.stacks d)) slot)) top)))
                  id
                  1)
        (push! (mut (.notes (elem (mut (elem (mut (.stacks d)) slot)) top))) id)
        0)))
  0)

;;; `node` was read by the memo this worker is computing.
(defn dep-note! [(node (slice u8))] (-> void)
  (let [d (deps)]
    (deps-lock! d)
    (let [id (dep-id! d node)]
      (deps-unlock! d)
      (dep-note-id! id))))

;;; The same, for a name given as a literal, whose address stands for it.
(defn dep-note-literal! [(node (slice u8))] (-> void)
  (let [d (deps)
        slot (worker-slot)
        top (dep-top d slot)
        at (primitive/cast i64 (data node))]
    (when (>= top 0)
      (let [(mut seen) false]
        (for x (.literals (get (get (.stacks d) slot) top))
          (when (= x at) (set! seen true)))
        (unless seen
          (push! (mut (.literals (elem (mut (elem (mut (.stacks d)) slot)) top)))
                 at)
          (dep-note! node)))))
  0)

;;; A site that reads elements of `setting` by index, through `prefix` (`#`, or `.field#`): its
;;; number, kept where `cache` points, from the first time the site reads.
(defn dep-site! [(cache (ptr i64))
                 (setting (slice u8))
                 (prefix (slice u8))
                 (suffix (slice u8))] (-> i64)
  (let [known (atomic/read cache)]
    (if (> known 0)
        (- known 1)
        (let [d (deps)
              key (site-key setting prefix suffix)]
          (deps-lock! d)
          (let [site
                  (match (get (.site-ids d) key)
                    (Some [known] known)
                    (None [] (dep-new-site! d setting prefix suffix)))]
            (deps-unlock! d)
            (atomic/store cache (+ site 1))
            site)))))

;;; What names a site, where it is read and what it reads alike: the setting, the path before the
;;; number and after. Two places in the program that read the same part share its nodes, and a
;;; program run again finds the sites an earlier run kept.
(defn site-key [(setting (slice u8)) (prefix (slice u8)) (suffix (slice u8))]
  (-> (slice u8))
  (join setting (join "\0" (join prefix (join "\0" suffix)))))

;;; A new site. Under the lock.
(defn dep-new-site! [(d (ptr Deps))
                     (setting (slice u8))
                     (prefix (slice u8))
                     (suffix (slice u8))] (-> i64)
  (let [site (len (.sites d))
        setting-id (dep-id! d setting)]
    (set! (mut (.site-ids d)) (site-key setting prefix suffix) site)
    ;; The graph's own copies: these are values, of whatever region made them.
    (push! (mut (.sites d)) (own-text (join setting prefix)))
    (push! (mut (.site-settings d)) setting-id)
    (push! (mut (.site-prefixes d)) (own-text prefix))
    (push! (mut (.site-suffixes d)) (own-text suffix))
    (push! (mut (.site-pages d))
           (ArrayList::new [(ArrayList i64)] (malloc-allocator)))
    (push! (mut (.site-keys d))
           (ArrayList::new [(slice u8)] (malloc-allocator)))
    (push! (mut (.site-key-ids d))
           (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
    ;; `.rel(_,_,` is a query by one column: the relation and which column.
    (let [open (name-end-at prefix 40)
          query
            (and (> (len prefix) 0)
                 (= (cast i64 (get prefix 0)) 46)
                 (< open (len prefix)))]
      (push! (mut (.site-rels d)) (if query (own-text (subslice prefix 1 open)) ""))
      (push! (mut (.site-cols d))
             (if query (count-byte prefix open (len prefix) 44) -1)))
    (let [(mut sites)
            (match (get (.setting-sites d) setting)
              (Some [xs] xs)
              (None [] (ArrayList::new [i64] (malloc-allocator))))]
      (push! (mut sites) site)
      (set! (mut (.setting-sites d)) setting sites))
    site))

;;; Element `index` of a setting was read, at a site (`dep-site!`), by the memo this worker is
;;; computing. Numbers all the way: the element's node and its path's text are made only the first
;;; time any memo reads it.
(defn dep-note-element! [(cache (ptr i64))
                         (setting (slice u8))
                         (prefix (slice u8))
                         (index i64)] (-> void)
  (dep-note-numbered! cache setting prefix "" index))

;;; The same for any part of a setting named by one number between a fixed `prefix` and `suffix`:
;;; `@symbol-at(` 12 `)`, an accessor applied to it; `.live(` 7 `)`, a query by one column.
(defn dep-note-numbered! [(cache (ptr i64))
                          (setting (slice u8))
                          (prefix (slice u8))
                          (suffix (slice u8))
                          (index i64)] (-> void)
  (if (and (>= index 0) (< index 4294967296))
      (dep-note-at! (dep-site! cache setting prefix suffix) index)
      ;; A number no site numbers by: the part's path, as text.
      (dep-note-path! setting (join prefix (join (num-text index) suffix))))
  0)

;;; The same for a map by Text read at a key, `prefix` its path up to the key: the key numbered
;;; by the site, which keeps its text for comparing the map's old and new values there.
(defn dep-note-keyed! [(cache (ptr i64))
                       (setting (slice u8))
                       (prefix (slice u8))
                       (key (slice u8))] (-> void)
  (let [site (dep-site! cache setting prefix "")
        d (deps)]
    (when (>= (dep-top d (worker-slot)) 0)
      (deps-lock! d)
      (let [index
              (match (get (get (.site-key-ids d) site) key)
                (Some [i] i)
                (None []
                      (let [i (len (get (.site-keys d) site))
                            kept (own-text key)]
                        (push! (mut (elem (mut (.site-keys d)) site)) kept)
                        (set! (mut (elem (mut (.site-key-ids d)) site)) kept i)
                        i)))]
        (deps-unlock! d)
        (dep-note-at! site index))))
  0)

;;; The keys a keyed site has numbered, by number.
(defn site-keys [(site i64)] (-> (ArrayList (slice u8)))
  (let [d (deps)
        (mut out) (ArrayList::new [(slice u8)] (value-allocator))]
    (deps-lock! d)
    (for k (get (.site-keys d) site) (push! (mut out) k))
    (deps-unlock! d)
    out))

;;; Element `index` of `site` was read by the memo this worker is computing.
(defn dep-note-at! [(site i64) (index i64)] (-> void)
  (let [d (deps)
        slot (worker-slot)
        top (dep-top d slot)]
    (when (>= top 0)
      (let [key (+ (* site 4294967296) index)]
        (when (< (int-get (mut (.elements (elem (mut (elem (mut (.stacks d))
                                                           slot))
                                                top)))
                          key)
                 0)
          (int-put! (mut (.elements (elem (mut (elem (mut (.stacks d)) slot))
                                          top)))
                    key
                    1)
          (push! (mut (.notes (elem (mut (elem (mut (.stacks d)) slot)) top)))
                 (- -1 (len (.pending (get (get (.stacks d) slot) top)))))
          (push! (mut (.pending (elem (mut (elem (mut (.stacks d)) slot)) top)))
                 key)
          0))))
  0)

;;; Element `index` of `site`'s node, or -1 when none was read. Under the lock.
(defn dep-element-at [(d (ptr Deps)) (site i64) (index i64)] (-> i64)
  (let [page (/ index 1024)
        pages (get (.site-pages d) site)]
    (if (or (>= page (len pages)) (= (len (get pages page)) 0))
        -1
        (get (get pages page) (- index (* page 1024))))))

;;; Element `index` of `site`'s node, made when it has none. Under the lock.
(defn dep-element! [(d (ptr Deps)) (site i64) (index i64)] (-> i64)
  (let [page (/ index 1024)
        at (- index (* page 1024))]
    (while (<= (len (get (.site-pages d) site)) page)
      (push! (mut (elem (mut (.site-pages d)) site))
             (ArrayList::new [i64] (malloc-allocator))))
    (when (= (len (get (get (.site-pages d) site) page)) 0)
      (for _ (range 0 1024)
        (push! (mut (elem (mut (elem (mut (.site-pages d)) site)) page)) -1)))
    (let [known (get (get (get (.site-pages d) site) page) at)]
      (if (>= known 0)
          known
          (let [id (dep-new-numbered! d site index)]
            (set! (mut (elem (mut (elem (mut (.site-pages d)) site)) page))
                  at
                  id)
            id)))))

;;; Whether a memo is computing on this worker, so a part of `setting` it reads is worth naming.
(defn dep-wants-path? [(setting (slice u8))] (-> bool)
  (let [d (deps)]
    (>= (dep-top d (worker-slot)) 0)))

;;; Part of a setting was read by the memo this worker is computing: `setting` at `path`. The setting
;;; keeps the paths read of it, so that binding it again can change just those that differ.
(defn dep-note-path! [(setting (slice u8)) (path (slice u8))] (-> void)
  (let [node (join setting path)
        d (deps)
        slot (worker-slot)
        top (dep-top d slot)]
    (when (>= top 0)
      (deps-lock! d)
      (let [id
              (match (get (.ids d) node)
                (Some [i] i)
                (None []
                      (let [i (dep-id! d node)
                            (mut paths)
                              (match (get (.paths d) setting)
                                (Some [ps] ps)
                                (None []
                                      (ArrayList::new [(slice u8)]
                                                      (malloc-allocator))))]
                        (push! (mut paths) (own-text path))
                        (set! (mut (.paths d)) setting paths)
                        (query-index! d setting path i)
                        i)))]
        (deps-unlock! d)
        (dep-note-id! id))))
  0)

;;; The same for a path fixed where it is read (`.linked.any-reexport`): its node found once, and
;;; kept where `cache` points, since a node, once made, is for as long as the program runs.
(defn dep-note-fixed! [(cache (ptr i64)) (setting (slice u8)) (path (slice u8))]
  (-> void)
  (let [d (deps)]
    (when (>= (dep-top d (worker-slot)) 0)
      (let [known (atomic/read cache)]
        (if (> known 0)
            (dep-note-id! (- known 1))
            (let [node (join setting path)]
              (deps-lock! d)
              (let [id
                      (match (get (.ids d) node)
                        (Some [i] i)
                        (None []
                              (let [i (dep-id! d node)
                                    (mut paths)
                                      (match (get (.paths d) setting)
                                        (Some [ps] ps)
                                        (None []
                                              (ArrayList::new [(slice u8)]
                                                              (malloc-allocator))))]
                                (push! (mut paths) (own-text path))
                                (set! (mut (.paths d)) setting paths)
                                (query-index! d setting path i)
                                i)))]
                (deps-unlock! d)
                (atomic/store cache (+ id 1))
                (dep-note-id! id)))))))
  0)

;;; The numbered sites memos have read a setting at, and each one's fixed text and (index, node) pairs.
(defn dep-sites [(setting (slice u8))] (-> (ArrayList i64))
  (let [d (deps)
        (mut out) (ArrayList::new [i64] (value-allocator))]
    (deps-lock! d)
    (match (get (.setting-sites d) setting)
      (Some [xs] (for x xs (push! (mut out) x)))
      (None [] 0))
    (deps-unlock! d)
    out))

(defn site-prefix [(site i64)] (-> (slice u8))
  (let [d (deps)]
    (deps-lock! d)
    (let [p (get (.site-prefixes d) site)] (deps-unlock! d) p)))

(defn site-suffix [(site i64)] (-> (slice u8))
  (let [d (deps)]
    (deps-lock! d)
    (let [p (get (.site-suffixes d) site)] (deps-unlock! d) p)))

(defn site-nodes [(site i64)] (-> (ArrayList i64))
  (let [d (deps)
        (mut out) (ArrayList::new [i64] (value-allocator))]
    (deps-lock! d)
    (let [pages (get (.site-pages d) site)]
      (for p (range 0 (len pages))
        (let [page (get pages p)]
          (for j (range 0 (len page))
            (let [id (get page j)]
              (when (>= id 0)
                (push! (mut out) (+ (* p 1024) j))
                (push! (mut out) id)))))))
    (deps-unlock! d)
    out))

;;; The same, for the elements from `lo` up to `hi` only: what a value that knows where it changed
;;; (see `changes-T` in a foreign module) has looked at, and no more.
(defn site-nodes-in [(site i64) (lo i64) (hi i64)] (-> (ArrayList i64))
  (let [d (deps)
        (mut out) (ArrayList::new [i64] (value-allocator))]
    (deps-lock! d)
    (let [pages (get (.site-pages d) site)
          from (if (< lo 0) 0 lo)]
      (let [(mut at) from]
        (while (< at hi)
          (let [p (/ at 1024)]
            (if (>= p (len pages))
                (set! at hi)
                (let [page (get pages p)
                      page-end (* (+ p 1) 1024)
                      stop (if (< hi page-end) hi page-end)]
                  (when (> (len page) 0)
                    (for k (range at stop)
                      (let [id (get page (- k (* p 1024)))]
                        (when (>= id 0)
                          (push! (mut out) k)
                          (push! (mut out) id)))))
                  (set! at stop)))))))
    (deps-unlock! d)
    out))

;;; The paths memos have read of a setting.
(defn dep-paths [(setting (slice u8))] (-> (ArrayList (slice u8)))
  (let [d (deps)
        (mut out) (ArrayList::new [(slice u8)] (value-allocator))]
    (deps-lock! d)
    (match (get (.paths d) setting)
      (Some [ps] (for p ps (push! (mut out) p)))
      (None [] 0))
    (deps-unlock! d)
    out))

;;; Where byte `c` first is in a path, or its end.
(defn name-end-at [(path (slice u8)) (c i64)] (-> i64)
  (let [(mut i) 0]
    (while (and (< i (len path)) (!= (cast i64 (get path i)) c))
      (set! i (+ i 1)))
    i))

;;; An accessor call's path: `@name(args)`, its arguments as `memo-key-of` joins them.
(defn call-path-text [(name (slice u8)) (parts (ArrayList (slice u8)))]
  (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) "@")
    (push-str! (mut b) name)
    (push-str! (mut b) "(")
    (push-str! (mut b) (memo-key-of parts))
    (push-str! (mut b) ")")
    (finish! (mut b))))

;;; An accessor call's path when its arguments are numbers and truths: `@name(a,b)`.
(defn call-path [(name (slice u8)) (parts (ArrayList (slice u8)))]
  (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) "@")
    (push-str! (mut b) name)
    (push-str! (mut b) "(")
    (for i (range 0 (len parts))
      (when (> i 0) (push-str! (mut b) ","))
      (push-str! (mut b) (get parts i)))
    (push-str! (mut b) ")")
    (finish! (mut b))))

;;; A query's path: `.rel(c0,c1,…)`, each column a value or `_`.
(defn query-path [(rel (slice u8)) (parts (ArrayList (slice u8)))]
  (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) ".")
    (push-str! (mut b) rel)
    (push-str! (mut b) "(")
    (for i (range 0 (len parts))
      (when (> i 0) (push-str! (mut b) ","))
      (push-str! (mut b) (get parts i)))
    (push-str! (mut b) ")")
    (finish! (mut b))))

;;; A query path (`.rel(c0,c1,…)`) filed where a changed row of its relation finds it. Under the lock.
(defn query-index! [(d (ptr Deps))
                    (setting (slice u8))
                    (path (slice u8))
                    (id i64)] (-> void)
  (when (and (> (len path) 0) (= (cast i64 (get path 0)) 46))
    (let [open (name-end-at path 40)]
      (when (< open (len path))
        (let [rel (subslice path 1 open)
              cols (split (subslice path (+ open 1) (- (len path) 1)) ",")
              (mut first) -1]
          (for c (range 0 (len cols))
            (when (and (< first 0) (!= (get cols c) "_")) (set! first c)))
          (let [key
                  (if (>= first 0)
                      (query-key setting rel first (parse-int (get cols first)))
                      (query-key setting rel -1 0))
                (mut ids)
                  (match (get (.queries d) key)
                    (Some [xs] xs)
                    (None [] (ArrayList::new [i64] (malloc-allocator))))]
            (push! (mut ids) id)
            (set! (mut (.queries d)) key ids))))))
  0)

(defn query-key [(setting (slice u8)) (rel (slice u8)) (col i64) (value i64)]
  (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) setting)
    (push-str! (mut b) "|")
    (push-str! (mut b) rel)
    (push-str! (mut b) "|")
    (push-str! (mut b) (num-text col))
    (push-str! (mut b) "|")
    (push-str! (mut b) (num-text value))
    (finish! (mut b))))

;;; Rows of `a` that `b` has not: each one's columns, `arity` to a row.
(defn rel-minus [(a (mut Rel)) (b (mut Rel))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (value-allocator))
        n (.arity a)]
    (for row (range 0 (.count a))
      (when (rel-live-row? (mut a) row)
        (let [x0 (rel-at (mut a) row 0)
              x1 (if (> n 1) (rel-at (mut a) row 1) 0)
              x2 (if (> n 2) (rel-at (mut a) row 2) 0)
              x3 (if (> n 3) (rel-at (mut a) row 3) 0)]
          (unless (rel-has? (mut b) x0 x1 x2 x3)
            (for c (range 0 n) (push! (mut out) (rel-at (mut a) row c)))))))
    out))

;;; Whether a query path's bound columns hold a row's values.
(defn query-sees? [(path (slice u8)) (row (ArrayList i64)) (at i64)] (-> bool)
  (let [open (name-end-at path 40)
        cols (split (subslice path (+ open 1) (- (len path) 1)) ",")
        (mut sees) true]
    (for c (range 0 (len cols))
      (when (and sees
                 (!= (get cols c) "_")
                 (!= (parse-int (get cols c)) (get row (+ at c))))
        (set! sees false)))
    sees))

;;; Relation `rel` of a database setting went from `a` to `b`: each query some memo made of it that
;;; sees a row only one of them has is changed, and nothing else. What it costs is the relations'
;;; size and what changed, not how much was read of them.
(defn dep-rel-changed! [(setting (slice u8))
                        (rel (slice u8))
                        (a (mut Rel))
                        (b (mut Rel))] (-> void)
  (unless (and (rel-current? (mut a)) (rel-current? (mut b)))
    (panic "the relation {} of {} was changed in place, and a value made before still reads it"
           rel
           setting))
  (unless (and (= (primitive/cast i64 (data (slice (.data a))))
                  (primitive/cast i64 (data (slice (.data b)))))
               (= (.count a) (.count b))
               (= (.gone a) (.gone b)))
    (dep-rows-changed! setting rel (rel-minus (mut a) (mut b)) (rel-minus (mut b) (mut a)) (.arity a)))
  0)

;;; The same, given the rows the relation lost (`gone`) and gained (`come`), `n` columns to a row:
;;; what a database brought up to date in place says changed. What it costs is what changed.
(defn dep-rows-changed! [(setting (slice u8))
                         (rel (slice u8))
                         (gone (ArrayList i64))
                         (come (ArrayList i64))
                         (n i64)] (-> void)
  (let [d (deps)
        (mut hit) (ArrayList::new [i64] (malloc-allocator))]
    (when (> (+ (len gone) (len come)) 0)
      (deps-lock! d)
      (match (get (.queries d) (query-key setting rel -1 0))
        (Some [ids] (for id ids (push! (mut hit) id)))
        (None [] 0))
      ;; Queries by one column, numbered: the site and the row's value there name the node.
      (match (get (.setting-sites d) setting)
        (Some [sites]
              (for site sites
                (when (= (get (.site-rels d) site) rel)
                  (let [col (get (.site-cols d) site)]
                    (for rows [gone come]
                      (for at (range 0 (/ (len rows) n))
                        (let [v (get rows (+ (* at n) col))]
                          (when (and (>= v 0) (< v 4294967296))
                            (let [id (dep-element-at d site v)]
                              (when (>= id 0) (push! (mut hit) id)))))))))))
        (None [] 0))
      (for rows [gone come]
        (for at (range 0 (/ (len rows) n))
          (for c (range 0 n)
            (match (get (.queries d)
                        (query-key setting rel c (get rows (+ (* at n) c))))
              (Some [ids]
                    (for id ids
                      (when (query-sees? (subslice (get (.texts d) id)
                                                   (len setting)
                                                   (len (get (.texts d) id)))
                                         rows
                                         (* at n))
                        (push! (mut hit) id))))
              (None [] 0)))))
      (deps-unlock! d)
      (for id hit (dep-changed-id! id))
      (free! (mut hit))))
  0)

;;; The rows of a relation a query sees, `spec` giving each column's value or `_` for any: every
;;; column of each, in the order the relation holds them.
(defn rel-matching [(r (mut Rel)) (spec (slice u8))] (-> (ArrayList i64))
  (let [cols (split spec ",")
        (mut out) (ArrayList::new [i64] (value-allocator))
        (mut first) -1]
    (for i (range 0 (len cols))
      (when (and (< first 0) (!= (get cols i) "_")) (set! first i)))
    (if (>= first 0)
        (for row (rel-bucket (mut r) first (parse-int (get cols first)))
          (rel-matching-row! (mut r) cols row (mut out)))
        (for row (range 0 (.count r))
          (rel-matching-row! (mut r) cols row (mut out))))
    out))

;;; One row's columns added to `out`, when the row is in and fits what `cols` asks.
(defn rel-matching-row! [(r (mut Rel))
                         (cols (ArrayList (slice u8)))
                         (row i64)
                         (out (mut (ArrayList i64)))] (-> void)
  (let [(mut fits) (rel-live-row? (mut r) row)]
    (for c (range 0 (len cols))
      (when (and fits
                 (!= (get cols c) "_")
                 (!= (rel-at (mut r) row c) (parse-int (get cols c))))
        (set! fits false)))
    (when fits
      (for c (range 0 (.arity r))
        (push! (mut out) (rel-at (mut r) row c)))))
  0)

;;; Whether a query sees the same rows of two relations.
(defn rel-rows-same? [(a (mut Rel)) (b (mut Rel)) (spec (slice u8))] (-> bool)
  (let [x (rel-matching (mut a) spec)
        y (rel-matching (mut b) spec)]
    (and (= (len x) (len y))
         (block :same
           (for i (range 0 (len x))
             (when (!= (get x i) (get y i)) (return-from :same false)))
           true))))

;;; Where a field's name ends in a path: at the next `.` or `#`, or the end.
(defn name-end [(path (slice u8))] (-> i64)
  (let [(mut i) 0]
    (while (and (< i (len path))
                (!= (get path i) (cast u8 46))
                (!= (get path i) (cast u8 35)))
      (set! i (+ i 1)))
    i))

;;; A memo answer, by its function's name and its key, was read by the memo this worker is computing.
(defn dep-note-memo! [(name (slice u8)) (key (slice u8))] (-> void)
  (dep-note! (memo-node name key)))

;;; A memo can be asked for an answer by its key's text: what checking an answer that read it calls.
(defn dep-ensurer! [(name (slice u8)) (f (fnptr (cc/C) [i64] i64))] (-> void)
  (let [d (deps)]
    (deps-lock! d)
    (set! (mut (.ensurers d)) name f)
    (deps-unlock! d)
    0))

;;; A memo starts computing on this worker.
(defn dep-begin! [] (-> void)
  (let [d (deps)
        slot (worker-slot)]
    (push! (mut (elem (mut (.stacks d)) slot))
           (DepFrame
             :notes (ArrayList::new [i64] (malloc-allocator))
             :seen (int-table 0)
             :literals (ArrayList::new [i64] (malloc-allocator))
             :elements (int-table 0)
             :pending (ArrayList::new [i64] (malloc-allocator))
             :mixed false))
    (key-set! (.depth-key d)
              (primitive/cast (ptr i8) (len (get (.stacks d) slot))))
    0))

;;; A memo answer's node id: made, with its text, the first time its store asks.
(defn dep-memo-id! [(name (slice u8)) (key (slice u8))] (-> i64)
  (let [d (deps)
        node (memo-node name key)]
    (deps-lock! d)
    (let [id (dep-id! d node)]
      (deps-unlock! d)
      id)))

;;; The memo this worker was computing is done, and is node `me`: it read what was noted, and is
;;; current in this revision; changed in it unless its answer is the one it had (`same`).
(defn dep-end-id! [(me i64) (same bool)] (-> void)
  (dep-end-with! me same true true))

;;; The same for an answer checked otherwise than by what it read (see `check` in the pipeline
;;; language): it reads nothing, so nothing it read changes it; one kept while no input changes is
;;; noted, so any change marks it.
(defn dep-end-ignoring-reads! [(me i64) (same bool) (any-change bool)] (-> void)
  (dep-end-with! me same false true)
  (when any-change (dep-any-change-node! me))
  0)

;;; An answer checked by a function of its own (`check by`), whose version is the one it was made
;;; with: current again, not made again, and so not counted as computed.
(defn dep-end-same-version! [(me i64)] (-> void)
  (dep-end-with! me true false false)
  (dep-any-change-node! me)
  0)

(defstruct AnyChange
  [(lock i64) (ready bool) (ids (ArrayList i64)) (seen (HashMap i64 bool))])

(defn any-change-nodes [] (-> (ptr AnyChange))
  (let [a (primitive/alloc-static AnyChange)]
    (unless (.ready a)
      (init-lock!)
      (unless (.ready a)
        (set! (.seen a)
              (HashMap::new [i64 bool] (malloc-allocator) (i64-keyops)))
        (set! (.ids a) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.ready a) true))
      (init-unlock!))
    a))

(defn dep-any-change-node! [(id i64)] (-> void)
  (let [a (any-change-nodes)]
    (spin-lock! (cast (ptr i64) a))
    (match (get (.seen a) id)
      (Some [_] 0)
      (None [] (do (set! (mut (.seen a)) id true) (push! (mut (.ids a)) id) 0)))
    (spin-unlock! (cast (ptr i64) a))
    0))

(defn dep-end-with! [(me i64) (same bool) (keep-reads bool) (made bool)]
  (-> void)
  (let [d (deps)
        slot (worker-slot)
        (mut frame)
          (match (pop! (mut (elem (mut (.stacks d)) slot)))
            (Some [f] f)
            (None [] (panic "a memo finished that never started")))]
    (key-set! (.depth-key d)
              (primitive/cast (ptr i8) (len (get (.stacks d) slot))))
    (deps-lock! d)
    (frame-resolve! d (mut frame))
    (frame-free! (mut frame))
    (unless keep-reads
      (let [(mut read) (.notes frame)] (free! (mut read)))
      (set! (.notes frame) (ArrayList::new [i64] (malloc-allocator))))
    (let [now (atomic/read (field d revision))
          before (get (.reads d) me)
          ;; Read just what it read last time, in the same order: its edges are there already.
          again
            (and (= (len before) (len (.notes frame)))
                 (block :again
                   (for i (range 0 (len before))
                     (when (!= (get before i) (get (.notes frame) i))
                       (return-from :again false)))
                   true))]
      (set! (mut (.reads d)) me (.notes frame))
      ;; A frame notes each read once, so its reads are each a new edge, but for those the answer's
      ;; last computation read too, whose edges are there already.
      (unless again
        (if (= (len before) 0)
            (for read (.notes frame) (dep-edge! d read me))
            (let [(mut had) (int-table (int-capacity (len before)))]
              (for read before (int-put! (mut had) read 1))
              (for read (.notes frame)
                (when (< (int-get (mut had) read) 0)
                  (dep-edge! d read me)))
              (free! (mut (.keys had)))
              (free! (mut (.vals had)))
              0)))
      ;; Only the worker holding this answer's key reads its list, and that is this one.
      (let [(mut old) before] (free! (mut old)))
      (set! (mut (.dirty d)) me false)
      (when (dep-tracing?)
        (println "[deps] {} {}"
                 (if made (if same "same" "changed") "same version")
                 (dep-node-text d me)))
      (set! (mut (.verified d)) me now)
      (unless same (set! (mut (.changed d)) me now))
      (when made (set! (.computed d) (+ (.computed d) 1))))
    (deps-unlock! d)
    0))

;;; What this worker read since its frame opened, the frame closed: work a memo on another thread
;;; handed it, whose reads are that memo's.
(defn dep-take-notes! [] (-> (ArrayList i64))
  (let [d (deps)
        slot (worker-slot)
        (mut frame)
          (match (pop! (mut (elem (mut (.stacks d)) slot)))
            (Some [f] f)
            (None [] (panic "work for a memo finished that never started")))]
    (deps-lock! d)
    (frame-resolve! d (mut frame))
    (deps-unlock! d)
    (frame-free! (mut frame))
    (key-set! (.depth-key d)
              (primitive/cast (ptr i8) (len (get (.stacks d) slot))))
    (.notes frame)))

;;; An input was read: noted, with what it said, when a memo reads it. `stamp`: its size and time
;;; (see `file-stamp`), taken before it was read, so a change while it was read changes the stamp
;;; too; "" for an input no stamp settles.
(defn dep-input! [(node (slice u8)) (print (slice u8)) (stamp0 (slice u8))]
  (-> void)
  (when (and (dep-in-frame?) (not (trusted-path? (subslice node 2 (len node)))))
    (dep-note! node)
    (let [d (deps)]
      (deps-lock! d)
      (let [id (dep-id! d node)]
        (when (= (len (get (.prints d) id)) 0)
          (set! (mut (.changed d)) id (atomic/read (field d revision))))
        (stored-text-set! (elem (mut (.prints d)) id) print)
        (stored-text-set! (elem (mut (.stamps d)) id)
                          (if (rechecked-path? (subslice node 2 (len node))) "" stamp0)))
      (deps-unlock! d)))
  0)

;;; `node` changed: a new revision, which it changed in.
(defn dep-changed! [(node (slice u8))] (-> void)
  (let [d (deps)]
    (when (.tracking d)
      (deps-lock! d)
      (let [id (dep-id! d node)]
        (deps-unlock! d)
        (dep-changed-id! id)))
    0))

(defn dep-changed-id! [(id i64)] (-> void)
  (let [d (deps)]
    (when (.tracking d)
      (deps-lock! d)
      (let [now (+ (atomic/read (field d revision)) 1)
            (mut todo) (ArrayList::new [i64] (malloc-allocator))]
        (atomic/store (field d revision) now)
        (if (numbered? id)
            (set! (mut (.num-changed d)) (- id (numbered-tag)) now)
            (set! (mut (.changed d)) id now))
        ;; Everything that read it, through any number of answers, may have changed.
        (push! (mut todo) id)
        (let [(mut marked) 0]
          (while (> (len todo) 0)
            (let [at (match (pop! (mut todo)) (Some [x] x) (None [] -1))]
              (let [(mut e) (dep-head d at)]
                (while (>= e 0)
                  (let [out (get (.edge-to d) e)]
                    (unless (get (.dirty d) out)
                      (set! (mut (.dirty d)) out true)
                      (set! marked (+ marked 1))
                      (push! (mut todo) out)))
                  (set! e (get (.edge-next d) e))))))
          (when (and (dep-tracing-checks?) (> marked 0))
            (println "[deps] {} changed: {} more may have" (dep-node-text d id) marked)))
        (free! (mut todo)))
      (deps-unlock! d)
      (when (dep-tracing?) (println "[deps] changed {}" (dep-node-text d id))))
    0))

;;; Whether a memo's answer is known current: checked in this revision, or marked by no change
;;; since it was (and so current now).
(defn dep-current-id? [(id i64)] (-> bool)
  (let [d (deps)]
    (deps-lock! d)
    (let [now (atomic/read (field d revision))
          out (or (= (get (.verified d) id) now) (not (get (.dirty d) id)))]
      (when out (set! (mut (.verified d)) id now))
      (deps-unlock! d)
      out)))

;;; Whether a memo's answer, computed in an earlier revision, is still what it would be: each node
;;; it read brought up to date in turn, and none changed since it was last current. If so it is
;;; current now. Called by the worker that has the answer's key to itself.
(defn dep-still-id? [(me i64)] (-> bool)
  (let [d (deps)]
    (deps-lock! d)
    (match (Some me)
      (None [] (do (deps-unlock! d) false))
      (Some [me]
            (let [since (get (.verified d) me)
                  reads (get (.reads d) me)
                  node (dep-node-text d me)]
              (deps-unlock! d)
              (block :check
                ;; What it read that no memo makes first (inputs, and settings' parts): telling
                ;; whether one changed computes nothing, and one that did settles it.
                (for read reads
                  (unless (dep-made? d read)
                    (let [changed (dep-bring-up! d read)]
                      (when (> changed since)
                        (when (dep-tracing?)
                          (deps-lock! d)
                          (let [what (dep-node-text d read)]
                            (deps-unlock! d)
                            (println "[deps] {} because {}" node what)))
                        (return-from :check false)))))
                (for read reads
                  (when (dep-made? d read)
                    (let [changed (dep-bring-up! d read)]
                      (when (> changed since)
                        (when (dep-tracing?)
                          (deps-lock! d)
                          (let [what (dep-node-text d read)]
                            (deps-unlock! d)
                            (println "[deps] {} because {}" node what)))
                        (return-from :check false)))))
                (deps-lock! d)
                (set! (mut (.verified d)) me (atomic/read (field d revision)))
                (set! (mut (.dirty d)) me false)
                (deps-unlock! d)
                (when (dep-tracing-checks?)
                  (println "[deps] checked {}, {} reads" node (len reads)))
                true))))))

;;; Whether a memo's answer is an earlier run's (read with the cache) and all it read is unchanged:
;;; then it is what it was, whether or not its value was saved. An answer kept only in memory is
;;; not saved, and after a restart need not be made again for what read it to be current; made again
;;; when its value is asked for, it is the same, and changes nothing that read it.
(defn dep-earlier-current? [(me i64)] (-> bool)
  (let [d (deps)]
    (deps-lock! d)
    (let [earlier (and (not (numbered? me)) (< me (.before d)))]
      (deps-unlock! d)
      (and earlier (dep-still-id? me)))))

;;; Whether a node is a memo's answer, which bringing up to date may compute: one whose text names
;;; its function and key.
(defn dep-made? [(d (ptr Deps)) (id i64)] (-> bool)
  (if (numbered? id)
      false
      (do
        (deps-lock! d)
        (let [made (match (index-of (get (.texts d) id) "\0") (Some [_] true) (None [] false))]
          (deps-unlock! d)
          made))))

;;; A node up to date, and the revision it last changed in: an input or setting as it stands, a
;;; memo's answer through its memo.
(defn dep-bring-up! [(d (ptr Deps)) (id i64)] (-> i64)
  (deps-lock! d)
  (if (numbered? id)
      (let [c (dep-changed-at d id)] (deps-unlock! d) c)
      (dep-bring-up-text! d id)))

;;; The same for a node with text, under the lock, which it gives up.
(defn dep-bring-up-text! [(d (ptr Deps)) (id i64)] (-> i64)
  (let [text (get (.texts d) id)
        cut (match (index-of text "\0") (Some [i] i) (None [] -1))]
    (if (< cut 0)
        (let [c (get (.changed d) id)] (deps-unlock! d) c)
        (let [name (subslice text 0 cut)
              f
                (match (get (.ensurers d) name)
                  (Some [f] f)
                  (None [] (panic "no memo named {} to ask for {}" name text)))]
          (deps-unlock! d)
          (f id)
          (deps-lock! d)
          (let [c (get (.changed d) id)] (deps-unlock! d) c)))))

;;; A memo answer's node: its function's name, a NUL, its key.
(defn memo-node [(name (slice u8)) (key (slice u8))] (-> (slice u8))
  (let [(mut b) (str/StrBuf::new (value-allocator))]
    (push-str! (mut b) name)
    (push-str! (mut b) "\0")
    (push-str! (mut b) key)
    (finish! (mut b))))

;;; Whether HL_TRACE_CHECKS is set: each memo answer that might have changed, checked and found
;;; current, is printed, with how many reads it checked.
(defn dep-tracing-checks? [] (-> bool)
  (let [t (primitive/alloc-static DepTrace)]
    (when (= (.known t) 0)
      (set! (.on t)
            (if (= (primitive/cast i64
                                   (os/getenv (str/to-cstr (malloc-allocator)
                                                           "HL_TRACE_CHECKS")))
                   0)
                0
                1))
      (set! (.known t) 1))
    (= (.on t) 1)))

;;; Whether HL_TRACE_DEPS is set: each memo answer computed is printed, and whether it changed.
(defn dep-tracing? [] (-> bool)
  (let [t (primitive/alloc-static DepTrace)]
    (when (= (.known t) 0)
      (set! (.on t)
            (if (= (primitive/cast i64
                                   (os/getenv (str/to-cstr (malloc-allocator)
                                                           "HL_TRACE_DEPS")))
                   0)
                0
                1))
      (set! (.known t) 1))
    (= (.on t) 1)))

(defstruct DepTrace [(known i64) (on i64)])

;;; How many memo answers have been computed, ever.
(defn dep-computed [] (-> i64)
  (let [d (deps)]
    (deps-lock! d)
    (let [n (.computed d)]
      (deps-unlock! d)
      n)))

;;; A 64-bit hash of an input's bytes, eight at a time, as text: what it said, small enough to keep.
(defn print-of [(bytes (slice u8))] (-> (slice u8))
  (num-text (bytes-hash bytes)))

;;; Where `struct stat` keeps a file's size and modification time on the platform compiled for:
;;; 64-bit Darwin on arm64, and Linux on x86-64 and arm64. Elsewhere -1, and a file is known by
;;; its contents alone.
(defn stat-offset [(darwin-arm i64) (linux-x86 i64) (linux-arm i64)] (-> i64)
  (let [darwin
          (match (target-arch)
            (Aarch64 [] darwin-arm)
            (X86_64 [] -1)
            (Wasm32 [] -1)
            (Wasm64 [] -1)
            (Riscv32 [] -1))
        linux
          (match (target-arch)
            (X86_64 [] linux-x86)
            (Aarch64 [] linux-arm)
            (Wasm32 [] -1)
            (Wasm64 [] -1)
            (Riscv32 [] -1))]
    (match (target-os)
      (Linux [] linux)
      (Darwin [] darwin)
      (Wasm [] -1)
      (BareMetal [] -1))))

;;; hygiene: the platform's offsets enter this module's namespace on purpose.
(defn gen-stat-size [] (-> Code)
  `(const ~(primitive/syntax->datum `STAT-SIZE) ~(stat-offset 96 48 48)))

(defn gen-stat-mtime [] (-> Code)
  `(const ~(primitive/syntax->datum `STAT-MTIME) ~(stat-offset 48 88 72)))

(gen-stat-size)

(gen-stat-mtime)

(extern stat :cc (cc/C) [(ptr i8) (ptr u8)] (-> i32))

(defstruct StatBuf [(bytes (array u8 256))])

;;; A file's or directory's size and modification time, eight bytes each with the nanoseconds: what
;;; changes when a file is written, or a directory gains or loses an entry. Compared, never read.
;;; Empty where the platform's layout is not known, and "missing" for nothing there.
(defn file-stamp [(path (slice u8))] (-> (slice u8))
  (if (< STAT-SIZE 0)
      ""
      (let [(mut buf) (primitive/zeroed StatBuf)
            at (cast (ptr u8) (mut buf))]
        (if (!= (stat (str/to-cstr (value-allocator) path) at) (: 0 i32))
            "missing"
            (let [size (load (cast (ptr i64) (primitive/index at STAT-SIZE)))
                  sec (load (cast (ptr i64) (primitive/index at STAT-MTIME)))
                  nsec
                    (load (cast (ptr i64) (primitive/index at (+ STAT-MTIME 8))))]
              (let [(mut b) (ArrayList::new [u8] (value-allocator))]
                (reserve! (mut b) 24)
                (for v [size sec nsec]
                  (for i (range 0 8)
                    (push! (mut b) (cast u8 (& (>> v (* i 8)) 255)))))
                (slice b)))))))

;;; An input's stamp now, as its reader takes it; "" for one no stamp settles.
(defn input-stamp [(node (slice u8))] (-> (slice u8))
  (let [path (subslice node 2 (len node))
        kind (cast i64 (get node 0))]
    (cond (rechecked-path? path) ""
          (= kind 102) (file-stamp path)
          (= kind 100) (file-stamp (if (= (len path) 0) "." path))
          (= kind 101) (file-stamp path)
          :else "")))

;;; What an input says now, as `dep-input!` was told it.
(defn input-print-now [(node (slice u8))] (-> (slice u8))
  (let [path (subslice node 2 (len node))
        kind (cast i64 (get node 0))]
    ;; f, d, e, r
    (cond (= kind 102) (file-print path)
          (= kind 100) (print-of (dir-listing-raw path))
          (= kind 101) (if (file-exists-raw? path) "1" "0")
          (= kind 114) (real-path-raw path)
          :else (panic "{} is no input" node))))

;;; The inputs memos have read that say something else now, each changed in a new revision. What
;;; they say now is what they said, from here on.
(defn dep-changed-inputs! [] (-> (ArrayList (slice u8)))
  (let [d (deps)
        ;; Where values go now: a watcher's turn, which lets it go.
        (mut changed) (ArrayList::new [(slice u8)] (value-allocator))
        (mut nodes) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut prints) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (deps-lock! d)
    (let [(mut stamps) (ArrayList::new [(slice u8)] (malloc-allocator))]
      (for i (range 0 (len (.texts d)))
        (when (> (len (get (.prints d) i)) 0)
          (push! (mut nodes) (get (.texts d) i))
          (push! (mut prints) (get (.prints d) i))
          (push! (mut stamps) (get (.stamps d) i))))
      (deps-unlock! d)
      (for i (range 0 (len nodes))
        (let [node (get nodes i)
              stamp (input-stamp node)]
          ;; An input whose size and time stand is not read again.
          (unless (and (> (len stamp) 0) (= stamp (get stamps i)))
            (let [now (input-print-now node)]
              (deps-lock! d)
              (stored-text-set! (elem (mut (.stamps d)) (dep-id! d node)) stamp)
              (deps-unlock! d)
              (when (!= now (get prints i))
                (push! (mut changed) node)
                (deps-lock! d)
                (stored-text-set! (elem (mut (.prints d)) (dep-id! d node)) now)
                (deps-unlock! d)
                (dep-changed! node))))))
      (free! (mut stamps)))
    (free! (mut nodes))
    (free! (mut prints))
    (when (> (len changed) 0) (dep-any-change-dirty!))
    changed))

;;; An input changed: every answer kept only while none does (see `check any-change`), and what read
;;; those, through any number of answers, may have changed.
(defn dep-any-change-dirty! [] (-> void)
  (let [d (deps)
        anys (any-change-nodes)
        (mut todo) (ArrayList::new [i64] (malloc-allocator))]
    (when (.tracking d)
      (deps-lock! d)
      (atomic/store (field d revision) (+ (atomic/read (field d revision)) 1))
      (spin-lock! (cast (ptr i64) anys))
      (for a (.ids anys)
        (unless (get (.dirty d) a)
          (set! (mut (.dirty d)) a true)
          (push! (mut todo) a)))
      (spin-unlock! (cast (ptr i64) anys))
      (while (> (len todo) 0)
        (let [at (match (pop! (mut todo)) (Some [x] x) (None [] -1))]
          (let [(mut e) (dep-head d at)]
            (while (>= e 0)
              (let [out (get (.edge-to d) e)]
                (unless (get (.dirty d) out)
                  (set! (mut (.dirty d)) out true)
                  (push! (mut todo) out)))
              (set! e (get (.edge-next d) e))))))
      (deps-unlock! d))
    (free! (mut todo))
    0))

;;; How many inputs memos have read.
(defn dep-inputs [] (-> i64)
  (let [d (deps)
        (mut n) 0]
    (deps-lock! d)
    (for p (.prints d) (when (> (len p) 0) (set! n (+ n 1))))
    (deps-unlock! d)
    n))

;;; Wait until an input changes; the paths that changed. Where the system says when a file or a
;;; directory changes (kqueue: macOS and the BSDs; inotify: Linux), each input and the directory it
;;; is in are watched, and a change is looked for as soon as one says so; elsewhere, and for what cannot be
;;; watched, every `ms` milliseconds. Either way what changed is what `dep-changed-inputs!` finds:
;;; an event only says when to look.
(defn wait-for-changes! [(ms i64)] (-> (ArrayList (slice u8)))
  (cache-saved!)
  (let [(mut out) (dep-changed-inputs!)]
    (while (= (len out) 0)
      (if (watch-events?)
          (watch-wait! (watch-inputs!) ms)
          (sleep (Duration :sec (/ ms 1000) :nsec (* (% ms 1000) 1000000))))
      (set! out (dep-changed-inputs!)))
    out))

;;; What tells of changes, kqueue's or inotify's (`kind`: 0 none, 1 kqueue, 2 inotify), and what is
;;; watched on it: each path's descriptor (kqueue) or watch (inotify), and each of those's path.
(defstruct Watch
  [(known i64)
   (kind i64)
   (kq i32)
   (fds (HashMap (slice u8) i64))
   (paths (HashMap i64 (slice u8)))])

(defn watch-state [] (-> (ptr Watch))
  (primitive/alloc-static Watch))

(defn kqueue-fn [] (-> (ptr i8))
  (os/dlsym-cached (primitive/alloc-static (ptr i8)) c"kqueue" (rtld-default)))

(defn kevent-fn [] (-> (ptr i8))
  (os/dlsym-cached (primitive/alloc-static (ptr i8)) c"kevent" (rtld-default)))

;;; Whether the system tells of changes: kqueue, else inotify. The first time, one is made; for
;;; kqueue, as many files may be open as the system allows (up to 10240), since each watched path
;;; holds one.
(defn watch-events? [] (-> bool)
  (let [w (watch-state)]
    (when (= (.known w) 0)
      (set! (.kq w) (: -1 i32))
      (set! (.fds w)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.paths w)
            (HashMap::new [i64 (slice u8)] (malloc-allocator) (i64-keyops)))
      (cond (and (!= (primitive/cast i64 (kqueue-fn)) 0)
                 (!= (primitive/cast i64 (kevent-fn)) 0))
              (do
                (set! (.kq w)
                      (primitive/call-ptr (primitive/cast (fnptr (cc/C) [] i32)
                                                          (kqueue-fn))))
                (set! (.kind w) 1)
                (raise-open-files!))
            (and (!= (primitive/cast i64 (inotify-init-fn)) 0)
                 (!= (primitive/cast i64 (inotify-add-fn)) 0))
              ;; IN_NONBLOCK | IN_CLOEXEC
              (do
                (set! (.kq w)
                      (primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                                                 [i32]
                                                                 i32)
                                                          (inotify-init-fn))
                                          (: 526336 i32)))
                (set! (.kind w) 2))
            :else 0)
      (set! (.known w) 1))
    (>= (.kq w) (: 0 i32))))

(defn inotify-init-fn [] (-> (ptr i8))
  (os/dlsym-cached (primitive/alloc-static (ptr i8))
                   c"inotify_init1"
                   (rtld-default)))

(defn inotify-add-fn [] (-> (ptr i8))
  (os/dlsym-cached (primitive/alloc-static (ptr i8))
                   c"inotify_add_watch"
                   (rtld-default)))

(extern getrlimit :cc (cc/C) [i32 (ptr i8)] (-> i32))

(extern setrlimit :cc (cc/C) [i32 (ptr i8)] (-> i32))

;;; RLIMIT_NOFILE, 8 where kqueue is: the soft limit raised to the hard one, at most 10240.
(defn raise-open-files! [] (-> void)
  (let [lim (primitive/alloc-stack (array u8 16))
        at (primitive/cast (ptr i8) lim)]
    (when (= (getrlimit (: 8 i32) at) (: 0 i32))
      (let [hard (load (primitive/cast (ptr i64) (primitive/index at 8)))
            want (if (or (< hard 0) (> hard 10240)) 10240 hard)]
        (when (> want (load (primitive/cast (ptr i64) at)))
          (store! (primitive/cast (ptr i64) at) want)
          (setrlimit (: 8 i32) at))))
    0))

;;; Each path an input reads, and the directory it is in (a file written whole elsewhere and moved
;;; into place changes its directory, not the file it replaced), on the kqueue. How many could not
;;; be opened: those only a timeout looks at again.
(defn watch-inputs! [] (-> i64)
  (let [d (deps)
        (mut paths) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut missed) 0]
    (deps-lock! d)
    (for i (range 0 (len (.texts d)))
      (when (> (len (get (.prints d) i)) 0)
        (let [node (get (.texts d) i)
              path (subslice node 2 (len node))
              kind (cast i64 (get node 0))]
          (if (= kind 100)
              (push! (mut paths) (if (= (len path) 0) "." path))
              (do
                (push! (mut paths) path)
                (push! (mut paths) (dir-of-path path)))))))
    (deps-unlock! d)
    (for p paths
      (unless (watch-path! p) (set! missed (+ missed 1))))
    (free! (mut paths))
    missed))

(defn dir-of-path [(path (slice u8))] (-> (slice u8))
  (let [(mut cut) -1]
    (for i (range 0 (len path)) (when (= (get path i) #\/) (set! cut i)))
    (cond (< cut 0) "."
          (= cut 0) "/"
          :else (subslice path 0 cut))))

;;; One path watched, once: for writes, growth, attributes, removal, renaming, links, and in a
;;; directory, entries made and removed. False when it cannot be (it does not exist yet, say: its
;;; directory is watched).
(defn watch-path! [(path (slice u8))] (-> bool)
  (let [w (watch-state)]
    (match (get (.fds w) path)
      (Some [_] true)
      (None []
            (if (= (.kind w) 2) (inotify-watch! w path) (kqueue-watch! w path))))))

;;; IN_MODIFY | IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE |
;;; IN_DELETE_SELF | IN_MOVE_SELF
(defn inotify-watch! [(w (ptr Watch)) (path (slice u8))] (-> bool)
  (let [c (str/to-cstr (malloc-allocator) path)
        wd
          (primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                                     [i32 (ptr i8) u32]
                                                     i32)
                                              (inotify-add-fn))
                              (.kq w)
                              c
                              (: 4046 u32))]
    (primitive/free (primitive/cast (ptr i8) c))
    (if (< wd (: 0 i32))
        false
        (do
          (set! (mut (.fds w)) path (primitive/cast i64 wd))
          (set! (mut (.paths w)) (primitive/cast i64 wd) (own-text path))
          true))))

(defn kqueue-watch! [(w (ptr Watch)) (path (slice u8))] (-> bool)
  ;; O_EVTONLY: open only to be told of events, which does not keep a volume busy.
  (let [c (str/to-cstr (malloc-allocator) path)
        fd (os/open c (: 32768 i32) 0)]
    (primitive/free (primitive/cast (ptr i8) c))
    (if (< fd (: 0 i32))
        false
        (let [event (primitive/alloc-stack (array u8 32))
              e (primitive/cast (ptr i8) event)]
          (store! (primitive/cast (ptr u64) e) (primitive/cast u64 fd))
          ;; EVFILT_VNODE; EV_ADD | EV_CLEAR; NOTE_DELETE | WRITE | EXTEND | ATTRIB | LINK | RENAME | REVOKE
          (store! (primitive/cast (ptr i16) (primitive/index e 8)) (: -4 i16))
          (store! (primitive/cast (ptr u16) (primitive/index e 10)) (: 33 u16))
          (store! (primitive/cast (ptr u32) (primitive/index e 12)) (: 127 u32))
          (store! (primitive/cast (ptr i64) (primitive/index e 16)) 0)
          (store! (primitive/cast (ptr i64) (primitive/index e 24)) 0)
          (if (< (primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                                            [i32
                                                             (ptr i8)
                                                             i32
                                                             (ptr i8)
                                                             i32
                                                             (ptr i8)]
                                                            i32)
                                                     (kevent-fn))
                                     (.kq w)
                                     e
                                     (: 1 i32)
                                     (primitive/cast (ptr i8) 0)
                                     (: 0 i32)
                                     (primitive/cast (ptr i8) 0))
                 (: 0 i32))
              (do (os/close fd) false)
              (do
                (set! (mut (.fds w)) path (primitive/cast i64 fd))
                (set! (mut (.paths w)) (primitive/cast i64 fd) (own-text path))
                true))))))

;;; Until something watched changes; at most `ms` milliseconds when some path could not be watched,
;;; else a second, which only bounds how long a missed event could go unseen. A path that was
;;; removed or renamed is let go, and watched again, as whatever is there, next time.
(defn watch-wait! [(missed i64) (ms i64)] (-> void)
  (if (= (.kind (watch-state)) 2)
      (inotify-wait! (if (> missed 0) ms 1000))
      (kqueue-wait! missed ms)))

(extern poll :cc (cc/C) [(ptr i8) u32 i32] (-> i32))

;;; Until inotify has something to say, or `wait` milliseconds: its events read, each watch whose
;;; path went away (IN_DELETE_SELF, IN_MOVE_SELF, IN_IGNORED) let go.
(defn inotify-wait! [(wait i64)] (-> void)
  (let [w (watch-state)
        pfd (primitive/alloc-stack (array u8 8))
        p (primitive/cast (ptr i8) pfd)]
    (store! (primitive/cast (ptr i32) p) (.kq w))
    ;; POLLIN
    (store! (primitive/cast (ptr i16) (primitive/index p 4)) (: 1 i16))
    (store! (primitive/cast (ptr i16) (primitive/index p 6)) (: 0 i16))
    (when (> (poll p (: 1 u32) (primitive/cast i32 wait)) (: 0 i32))
      (let [buf (primitive/alloc-stack (array u8 8192))
            b (primitive/cast (ptr i8) buf)
            (mut more) true]
        (while more
          (let [n (primitive/cast i64 (read (.kq w) b (: 8192 isize)))]
            (if (<= n 0)
                (set! more false)
                (let [(mut at) 0]
                  (while (< at n)
                    (let [e (primitive/index b at)
                          wd
                            (primitive/cast i64
                                            (load (primitive/cast (ptr i32) e)))
                          mask
                            (primitive/cast i64
                                            (load (primitive/cast (ptr u32)
                                                                  (primitive/index e
                                                                                   4))))
                          name-len
                            (primitive/cast i64
                                            (load (primitive/cast (ptr u32)
                                                                  (primitive/index e
                                                                                   12))))]
                      (unless (= (& mask 35840) 0)
                        (match (get (.paths w) wd)
                          (Some [path]
                                (do
                                  (HashMap::remove! (mut (.fds w)) path)
                                  (HashMap::remove! (mut (.paths w)) wd)
                                  (free [u8] (malloc-allocator) path)
                                  0))
                          (None [] 0)))
                      (set! at (+ at 16 name-len))))))))))
    0))

(defn kqueue-wait! [(missed i64) (ms i64)] (-> void)
  (let [w (watch-state)
        wait (if (> missed 0) ms 1000)
        timeout (primitive/alloc-stack (array u8 16))
        t (primitive/cast (ptr i8) timeout)
        events (primitive/alloc-stack (array u8 2048))
        es (primitive/cast (ptr i8) events)]
    (store! (primitive/cast (ptr i64) t) (/ wait 1000))
    (store! (primitive/cast (ptr i64) (primitive/index t 8))
            (* (% wait 1000) 1000000))
    (let [n
            (primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                                       [i32
                                                        (ptr i8)
                                                        i32
                                                        (ptr i8)
                                                        i32
                                                        (ptr i8)]
                                                       i32)
                                                (kevent-fn))
                                (.kq w)
                                (primitive/cast (ptr i8) 0)
                                (: 0 i32)
                                es
                                (: 64 i32)
                                t)]
      (for i (range 0 (primitive/cast i64 n))
        (let [e (primitive/index es (* i 32))
              fd (primitive/cast i64 (load (primitive/cast (ptr u64) e)))
              fflags
                (primitive/cast i64
                                (load (primitive/cast (ptr u32)
                                                      (primitive/index e 12))))]
          ;; NOTE_DELETE | NOTE_RENAME | NOTE_REVOKE: the path names something else now, if anything.
          (unless (= (& fflags 97) 0)
            (match (get (.paths w) fd)
              (Some [path]
                    (do
                      (HashMap::remove! (mut (.fds w)) path)
                      (HashMap::remove! (mut (.paths w)) fd)
                      (free [u8] (malloc-allocator) path)
                      (os/close (primitive/cast i32 fd))
                      0))
              (None [] 0))))))
    0))

;; ---------------------------------------------------------------- serving

;;; A development server: the files of one directory over HTTP, and at a caller-chosen path a stream of events
;;; (server-sent events, which a browser's EventSource reads) that `broadcast!` writes to every
;;; client listening. One thread accepts and answers; a stream stays open until a write to it fails.
(defstruct Server
  [(lock i64)
   (ready bool)
   (dir (slice u8))
   (page (slice u8))
   (events-path (slice u8))
   (port i64)
   (listener TcpListener)
   (clients (ArrayList TcpConnection))
   (thread Thread)
   ;; Whether pages and files asked for wait (1) until what is served is written: a development
   ;; server holds them until its first build is, so a browser that comes early is not given a
   ;; page whose script is not there yet.
   (held i64)])

;;; What is served is not written yet: pages and files asked for wait for `served-written!`.
(defn serve-hold! [] (-> void)
  (atomic/store (field (server) held) 1)
  0)

;;; What is served is written: pages and files asked for are answered.
(defn served-written! [] (-> void)
  (atomic/store (field (server) held) 0)
  0)

(defn server [] (-> (ptr Server))
  (primitive/alloc-static Server))

;;; Serve `dir` on `port` of 127.0.0.1 (0: any free port), `page` answering `/` when the directory
;;; has no index.html, and server-sent events at `events-path`. Answers the port.
(defn serve! [(port i64) (dir (slice u8)) (page (slice u8)) (events-path (slice u8))] (-> i64)
  (let [s (server)]
    (when (.ready s) (panic "already serving on port {}" (.port s)))
    (set! (.dir s) dir)
    (set! (.page s) page)
    (set! (.events-path s) (own-text events-path))
    (set! (.clients s) (ArrayList::new [TcpConnection] (malloc-allocator)))
    (match (TcpListener::listen (malloc-allocator)
                                (field s listener)
                                "127.0.0.1"
                                port
                                true
                                64)
      (Err [_] (panic "cannot listen on port {}" port))
      (Ok [_] 0))
    (set! (.port s)
          (match (TcpListener::port (field s listener))
            (Ok [p] p)
            (Err [_] (panic "cannot learn the port being served"))))
    (set! (.ready s) true)
    (when (!= (Thread::spawn-configured (field s thread)
                                        (fnptr-of server-loop)
                                        (cast (ptr i8) 0)
                                        (ThreadConfig
                                          :stack-size 8388608
                                          :guard-size 0))
              (: 0 i32))
      (panic "could not start the server thread"))
    (.port s)))

(defn server-loop [(arg (ptr i8))] (-> (ptr i8))
  (let [s (server)]
    (while true
      (let [(mut c) (TcpConnection :fd (: -1 i32) :closed true)]
        (match (TcpListener::accept (field s listener)
                                    (cast (ptr TcpConnection) (mut c)))
          (Ok [_] (answer-request! c))
          (Err [_] 0))))
    (cast (ptr i8) 0)))

;;; Everything, or false when the client has gone.
(defn send-all! [(c TcpConnection) (bytes (slice u8))] (-> bool)
  (let [(mut conn) c
        (mut off) 0
        (mut ok) true]
    (while (and ok (< off (len bytes)))
      (match (TcpConnection::write (cast (ptr TcpConnection) (mut conn))
                                   (cast (ptr i8)
                                         (primitive/index (data bytes) off))
                                   (- (len bytes) off))
        (Ok [n] (if (> n 0) (set! off (+ off n)) (set! ok false)))
        (Err [_] (set! ok false))))
    ok))

(defn close-connection! [(c TcpConnection)] (-> void)
  (let [(mut conn) c]
    (TcpConnection::close! (cast (ptr TcpConnection) (mut conn)))
    0))

;;; The request's head, up to the blank line, or as much as came.
(defn request-head [(c TcpConnection)] (-> (slice u8))
  (let [(mut conn) c
        (mut buf) (ArrayList::new [u8] (malloc-allocator))
        chunk
          (match (alloc [u8] (malloc-allocator) 4096)
            (Some [b] b)
            (None [] (panic "no memory")))
        (mut go) true]
    (while go
      (match (TcpConnection::read (cast (ptr TcpConnection) (mut conn))
                                  (cast (ptr i8) (data chunk))
                                  4096)
        (Ok [n]
            (if (<= n 0)
                (set! go false)
                (do
                  (for i (range 0 n) (push! (mut buf) (get chunk i)))
                  (when (or (contains-text? (data-slice buf) "\r\n\r\n")
                            (> (len buf) 65536))
                    (set! go false)))))
        (Err [_] (set! go false))))
    (data-slice buf)))

(defn data-slice [(b (ArrayList u8))] (-> (slice u8))
  (slice b))

(defn content-type [(path (slice u8))] (-> (slice u8))
  (cond (ends-with path ".js") "text/javascript; charset=utf-8"
        (ends-with path ".css") "text/css; charset=utf-8"
        (ends-with path ".html") "text/html; charset=utf-8"
        (ends-with path ".json") "application/json"
        (ends-with path ".map") "application/json"
        (ends-with path ".svg") "image/svg+xml"
        (ends-with path ".png") "image/png"
        (ends-with path ".ico") "image/x-icon"
        (or (ends-with path ".jpg") (ends-with path ".jpeg")) "image/jpeg"
        (ends-with path ".gif") "image/gif"
        (ends-with path ".webp") "image/webp"
        (ends-with path ".woff2") "font/woff2"
        (ends-with path ".woff") "font/woff"
        (ends-with path ".txt") "text/plain; charset=utf-8"
        :else "application/octet-stream"))

(defn respond! [(c TcpConnection)
                (status (slice u8))
                (kind (slice u8))
                (body (slice u8))] (-> void)
  (let [(mut b) (str/StrBuf::new (malloc-allocator))]
    (push-str! (mut b) "HTTP/1.1 ")
    (push-str! (mut b) status)
    (push-str! (mut b) "\r\nContent-Type: ")
    (push-str! (mut b) kind)
    (push-str! (mut b) "\r\nContent-Length: ")
    (push-str! (mut b) (num-text (len body)))
    (push-str! (mut b)
               "\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n")
    (push-str! (mut b) body)
    (send-all! c (finish! (mut b)))
    (close-connection! c)))

(defn answer-request! [(c TcpConnection)] (-> void)
  (let [s (server)
        head (request-head c)
        line (text-before head "\r\n")
        target (text-before (text-after line " ") " ")
        path (text-before target "?")]
    (cond (not (starts-with line "GET "))
            (respond! c "405 Method Not Allowed" "text/plain" "GET only\n")
          (= path (.events-path s))
            (when (send-all! c
                             "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\nAccess-Control-Allow-Origin: *\r\n\r\n: hello\n\n")
              (spin-lock! (cast (ptr i64) s))
              (push! (mut (.clients s)) c)
              (spin-unlock! (cast (ptr i64) s))
              0)
          (contains-text? path "..")
            (respond! c "404 Not Found" "text/plain" "not found\n")
          :else
            ;; A path naming no file, whose last part has no extension, is a page of the app the
            ;; page is (a single-page app's route): it is answered with the page, as Vite's server
            ;; answers it.
            (let [file (do (while (= (atomic/read (field s held)) 1)
                             (sleep (Duration :sec 0 :nsec 10000000)))
                           (join (.dir s) (if (= path "/") "/index.html" path)))
                  last-part (subslice path (+ (match (last-index-of path "/") (Some [i] i) (None [] -1)) 1) (len path))]
              (cond (file-exists-raw? file)
                      (respond! c
                                "200 OK"
                                (content-type file)
                                (read-all-raw file))
                    (or (= path "/") (not (contains-text? last-part ".")))
                      (let [index (join (.dir s) "/index.html")]
                        (if (file-exists-raw? index)
                            (respond! c "200 OK" "text/html; charset=utf-8" (read-all-raw index))
                            (respond! c "200 OK" "text/html; charset=utf-8" (.page s))))
                    :else
                      (respond! c "404 Not Found" "text/plain" "not found\n"))))
    0))

;;; An event to every client listening at the configured event path; one that has gone is dropped.
(defn broadcast! [(event (slice u8)) (text (slice u8))] (-> void)
  (let [s (server)]
    ;; Nothing is served (a watcher with no --serve): there is no one to send it to.
    (when (.ready s)
      (let [(mut b) (str/StrBuf::new (malloc-allocator))]
        (push-str! (mut b) "event: ")
        (push-str! (mut b) event)
        (push-str! (mut b) "\n")
        (for l (split text "\n")
          (push-str! (mut b) "data: ")
          (push-str! (mut b) l)
          (push-str! (mut b) "\n"))
        (push-str! (mut b) "\n")
        (let [message (finish! (mut b))
              (mut kept) (ArrayList::new [TcpConnection] (malloc-allocator))]
          (spin-lock! (cast (ptr i64) s))
          (for c (.clients s)
            (if (send-all! c message)
                (push! (mut kept) c)
                (close-connection! c)))
          (free! (mut (.clients s)))
          (set! (.clients s) kept)
          (spin-unlock! (cast (ptr i64) s))
          (free [u8] (malloc-allocator) message))))
    0))

;;; How many clients listen at the configured event path.
(defn listeners [] (-> i64)
  (let [s (server)]
    (if (.ready s)
        (do
          (spin-lock! (cast (ptr i64) s))
          (let [n (len (.clients s))] (spin-unlock! (cast (ptr i64) s)) n))
        0)))

;; ---------------------------------------------------------------- the cache on disk

;;; What a program computed, kept on disk so that a later run starts where an earlier one stopped,
;;; and reads back only what it uses. Two files: the dependency graph above, written whole each
;;; time (`.deps`), and a log (`.cache`) of every memo answer, setting and state of the program's
;;; modules, which their generated code writes through a Writer and reads through a Reader.
;;;
;;; The log is segments, each written once and never changed: what changed since the last save,
;;; then an index of it. A run reads the indexes, and an answer or a setting only when it is first
;;; asked for. An object several values hold (a tree's list of children, a long text, an opaque
;;; value) has a number for as long as the log does: written whole the first time, with its length,
;;; so a reader that does not want it yet skips it, and after that by number; read once, by
;;; whichever value is read first, and then shared, so one object is one object after a load, and a
;;; tree's identity (`node-identity`) means what it meant. When the log has grown to twice what it
;;; holds, the next save writes it again whole. Values go with no names or types: only the build of
;;; the program that wrote them reads them, which the headers check.

(defstruct Writer
  ;; What is written so far: `pos` bytes of `mem`, which start at `base` in the file.
  [(mem (slice u8))
   (pos i64)
   (base i64)
   ;; Whether objects are shared (the log's writer) or each written where it is (the graph's).
   (objects bool)
   ;; Objects in the log, by (tag, where, how long): open addressing over three columns, each
   ;; slot's number kept plus one so a slot of zeros is empty; and by their bytes.
   (keys (ArrayList i64))
   (ids (ArrayList i64))
   (mask i64)
   (filled i64)
   (shared (HashMap (slice u8) i64))
   (next-id i64)
   ;; Objects this buffer defines, as (number, where its content starts) pairs; and the places of
   ;; the lengths of those still being written.
   (defined (ArrayList i64))
   (open (ArrayList i64))
   (modules (HashMap (slice u8) i64))])

(defstruct Reader
  [(bytes (slice u8))
   (at i64)
   (objects bool)
   ;; Where to come back to after reading something elsewhere.
   (returns (ArrayList i64))
   ;; Each object's content by number (-1: not in the log), and its value once read: where its
   ;; bytes are in `arena`, plus one.
   (offsets (ArrayList i64))
   (values (ArrayList i64))
   (arena (ArrayList u8))
   ;; Objects being read: number, whether it is written here (1) or elsewhere (0), where it ends.
   (frames (ArrayList i64))
   (modules (HashMap (slice u8) i64))])

(defn writer-new [(objects bool)] (-> Writer)
  (Writer
    :mem
      (match (alloc [u8] (big-allocator) 1048576)
        (Some [m] m)
        (None [] (panic "no memory to write the cache")))
    :pos 0
    :base 0
    :objects objects
    :keys (ArrayList::new [i64] (big-allocator))
    :ids (ArrayList::new [i64] (big-allocator))
    :mask -1
    :filled 0
    :shared (HashMap::new [(slice u8) i64] (big-allocator) (text-keyops))
    :next-id 0
    :defined (ArrayList::new [i64] (big-allocator))
    :open (ArrayList::new [i64] (big-allocator))
    :modules (HashMap::new [(slice u8) i64] (big-allocator) (text-keyops))))

;;; A buffer to write the next part in, at `base`, keeping what objects are known.
(defn writer-restart! [(w (ptr Writer)) (base i64)] (-> void)
  (set! (.pos w) 0)
  (set! (.base w) base)
  (clear! (mut (.defined w)))
  (clear! (mut (.open w)))
  (HashMap::clear! (mut (.modules w)))
  0)

(defn reader-new [(bytes (slice u8)) (objects bool)] (-> Reader)
  (Reader
    :bytes bytes
    :at 0
    :objects objects
    :returns (ArrayList::new [i64] (big-allocator))
    :offsets (ArrayList::new [i64] (big-allocator))
    :values (ArrayList::new [i64] (big-allocator))
    :arena (ArrayList::new [u8] (big-allocator))
    :frames (ArrayList::new [i64] (big-allocator))
    :modules (HashMap::new [(slice u8) i64] (big-allocator) (text-keyops))))

(defn written-bytes [(w (ptr Writer))] (-> (slice u8))
  (subslice (.mem w) 0 (.pos w)))

;;; Where the next byte goes, in the file.
(defn writer-at [(w (ptr Writer))] (-> i64)
  (+ (.base w) (.pos w)))

;;; Room for `n` more bytes.
(defn put-room! [(w (ptr Writer)) (n i64)] (-> void)
  (when (> (+ (.pos w) n) (len (.mem w)))
    (set! (.mem w)
          (match (reallocate [u8] (big-allocator) (.mem w) (+ (* 2 (len (.mem w))) n 65536))
            (Some [m] m)
            (None [] (panic "no memory to write the cache")))))
  0)

(defn put-byte! [(w (ptr Writer)) (b i64)] (-> void)
  (put-room! w 1)
  (store! (primitive/index (data (.mem w)) (.pos w)) (cast u8 (& b 255)))
  (set! (.pos w) (+ (.pos w) 1))
  0)

;;; An integer's 64 bits, seven at a time, low first, each byte but the last with its top bit set.
(defn put-varint! [(w (ptr Writer)) (v i64)] (-> void)
  (put-room! w 10)
  (let [base (data (.mem w))
        (mut p) (.pos w)
        (mut u) v]
    (while (or (< u 0) (> u 127))
      (store! (primitive/index base p) (cast u8 (| (& u 127) 128)))
      (set! p (+ p 1))
      (set! u (& (>> u 7) 144115188075855871)))
    (store! (primitive/index base p) (cast u8 u))
    (set! (.pos w) (+ p 1)))
  0)

;;; An integer of either sign, a small one short: zigzag, then `put-varint!`.
(defn put-int! [(w (ptr Writer)) (v i64)] (-> void)
  (put-varint! w (^ (<< v 1) (>> v 63))))

(defn put-bool! [(w (ptr Writer)) (b bool)] (-> void)
  (put-byte! w (if b 1 0)))

(defn put-raw! [(w (ptr Writer)) (s (slice u8))] (-> void)
  (when (> (len s) 0)
    (put-room! w (len s))
    (mem/copy (primitive/index (data (.mem w)) (.pos w)) (data s) (len s))
    (set! (.pos w) (+ (.pos w) (len s))))
  0)

;;; Eight bytes, low first, at `at` in what is written: a length known only once what it measures is.
(defn put-word-at! [(w (ptr Writer)) (at i64) (v i64)] (-> void)
  (for i (range 0 8)
    (store! (primitive/index (data (.mem w)) (+ at i))
            (cast u8 (& (>> v (* i 8)) 255))))
  0)

(defn put-word! [(w (ptr Writer)) (v i64)] (-> void)
  (put-room! w 8)
  (put-word-at! w (.pos w) v)
  (set! (.pos w) (+ (.pos w) 8))
  0)

(defn take-byte [(r (ptr Reader))] (-> i64)
  (when (>= (.at r) (len (.bytes r)))
    (panic "the cache ends before what it holds does"))
  (let [b (cast i64 (get (.bytes r) (.at r)))]
    (set! (.at r) (+ (.at r) 1))
    b))

(defn take-varint [(r (ptr Reader))] (-> i64)
  (let [bytes (.bytes r)
        n (len bytes)
        base (data bytes)
        (mut at) (.at r)
        (mut out) 0
        (mut shift) 0
        (mut go) true]
    (while go
      (when (>= at n) (panic "the cache ends before what it holds does"))
      (let [b (cast i64 (load (primitive/index base at)))]
        (set! at (+ at 1))
        (set! out (| out (<< (& b 127) shift)))
        (set! shift (+ shift 7))
        (when (< b 128) (set! go false))))
    (set! (.at r) at)
    out))

(defn take-int [(r (ptr Reader))] (-> i64)
  (let [u (take-varint r)]
    (^ (& (>> u 1) 9223372036854775807) (- 0 (& u 1)))))

(defn take-bool [(r (ptr Reader))] (-> bool)
  (= (take-byte r) 1))

(defn take-raw [(r (ptr Reader)) (n i64)] (-> (slice u8))
  (let [at (.at r)]
    (when (> (+ at n) (len (.bytes r)))
      (panic "the cache ends before what it holds does"))
    (set! (.at r) (+ at n))
    (subslice (.bytes r) at (+ at n))))

(defn word-at [(bytes (slice u8)) (at i64)] (-> i64)
  (let [(mut v) 0]
    (for i (range 0 8)
      (set! v (| v (<< (cast i64 (get bytes (+ at i))) (* i 8)))))
    v))

(defn take-word [(r (ptr Reader))] (-> i64)
  (let [at (.at r)]
    (when (> (+ at 8) (len (.bytes r)))
      (panic "the cache ends before what it holds does"))
    (set! (.at r) (+ at 8))
    (word-at (.bytes r) at)))

;;; Reading something elsewhere in the bytes, and back.
(defn reader-seek! [(r (ptr Reader)) (at i64)] (-> void)
  (push! (mut (.returns r)) (.at r))
  (set! (.at r) at)
  0)

(defn reader-return! [(r (ptr Reader))] (-> void)
  (match (pop! (mut (.returns r)))
    (Some [at] (set! (.at r) at))
    (None [] (panic "the cache's reader came back from nowhere")))
  0)

;; ---- objects

(defn object-slot [(tag i64) (at i64) (n i64) (mask i64)] (-> i64)
  (& (memo-hash (^ (memo-hash (^ (memo-hash tag) at)) n)) mask))

;;; The table of objects known, twice as big, each where it falls now.
(defn objects-grow! [(w (ptr Writer))] (-> void)
  (let [old-keys (.keys w)
        old-ids (.ids w)
        cap (if (< (.mask w) 1023) 1024 (* (+ (.mask w) 1) 2))
        (mut keys) (ArrayList::new [i64] (big-allocator))
        (mut ids) (ArrayList::new [i64] (big-allocator))]
    (ArrayList::extend-zeroed! (mut keys) (* cap 3))
    (ArrayList::extend-zeroed! (mut ids) cap)
    (for j (range 0 (len old-ids))
      (let [v (get old-ids j)]
        (when (> v 0)
          (let [tag (get old-keys (* j 3))
                at (get old-keys (+ (* j 3) 1))
                n (get old-keys (+ (* j 3) 2))
                (mut i) (object-slot tag at n (- cap 1))]
            (while (!= (get ids i) 0) (set! i (& (+ i 1) (- cap 1))))
            (set! (mut keys) (* i 3) tag)
            (set! (mut keys) (+ (* i 3) 1) at)
            (set! (mut keys) (+ (* i 3) 2) n)
            (set! (mut ids) i v)))))
    (let [(mut ok) old-keys
          (mut oi) old-ids]
      (free! (mut ok))
      (free! (mut oi)))
    (set! (.keys w) keys)
    (set! (.ids w) ids)
    (set! (.mask w) (- cap 1)))
  0)

;;; Whether `x` is in one of `ranges`: (start, end) pairs sorted by start, none overlapping.
(defn in-ranges? [(ranges (ArrayList i64)) (x i64)] (-> bool)
  (let [(mut lo) 0
        (mut hi) (/ (len ranges) 2)]
    ;; The last range starting at or before `x`.
    (while (< lo hi)
      (let [mid (/ (+ lo hi) 2)]
        (if (<= (get ranges (* mid 2)) x) (set! lo (+ mid 1)) (set! hi mid))))
    (and (> lo 0) (< x (get ranges (+ (* (- lo 1) 2) 1))))))

;;; The order of (start, end) pairs by their starts.
(defn ranges-order [(ranges (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut starts) (ArrayList::new [i64] (malloc-allocator))]
    (for i (range 0 (/ (len ranges) 2)) (push! (mut starts) (get ranges (* i 2))))
    (let [order (sort-order-int starts false)]
      (free! (mut starts))
      order)))

;;; Memory that was let go (`ranges`, as `regions-let-go!` gives them), forgotten by a writer that
;;; knows objects by where they are: one there now is another object. Texts and lists it knew there
;;; are written again whole when next written; opaque values whose bytes point there, likewise.
(defn writer-forget-ranges! [(w (ptr Writer)) (ranges (ArrayList i64))] (-> void)
  (let [order (ranges-order ranges)
        (mut sorted) (ArrayList::new [i64] (malloc-allocator))]
    (for i order
      (push! (mut sorted) (get ranges (* i 2)))
      (push! (mut sorted) (get ranges (+ (* i 2) 1))))
    (when (>= (.mask w) 0)
      (let [cap (+ (.mask w) 1)
            old-keys (.keys w)
            old-ids (.ids w)
            (mut keys) (ArrayList::new [i64] (big-allocator))
            (mut ids) (ArrayList::new [i64] (big-allocator))
            (mut filled) 0]
        (ArrayList::extend-zeroed! (mut keys) (* cap 3))
        (ArrayList::extend-zeroed! (mut ids) cap)
        (for j (range 0 (len old-ids))
          (let [v (get old-ids j)]
            (when (and (> v 0) (not (in-ranges? sorted (get old-keys (+ (* j 3) 1)))))
              (let [tag (get old-keys (* j 3))
                    at (get old-keys (+ (* j 3) 1))
                    n (get old-keys (+ (* j 3) 2))
                    (mut i) (object-slot tag at n (- cap 1))]
                (while (!= (get ids i) 0) (set! i (& (+ i 1) (- cap 1))))
                (set! (mut keys) (* i 3) tag)
                (set! (mut keys) (+ (* i 3) 1) at)
                (set! (mut keys) (+ (* i 3) 2) n)
                (set! (mut ids) i v)
                (set! filled (+ filled 1))))))
        (let [(mut ok) old-keys
              (mut oi) old-ids]
          (free! (mut ok))
          (free! (mut oi)))
        (set! (.keys w) keys)
        (set! (.ids w) ids)
        (set! (.filled w) filled)))
    (let [(mut gone) (ArrayList::new [(slice u8)] (malloc-allocator))]
      (for key (.shared w)
        (let [(mut start) 0]
          (while (and (< start (len key)) (!= (cast i64 (get key start)) 0)) (set! start (+ start 1)))
          (let [(mut i) (+ start 1)
                (mut hit) false]
            (while (and (not hit) (<= (+ i 8) (len key)))
              (let [(mut word) 0]
                (for b (range 0 8)
                  (set! word (| word (<< (cast i64 (get key (+ i b))) (* b 8)))))
                (when (in-ranges? sorted word) (set! hit true)))
              (set! i (+ i 8)))
            (when hit (push! (mut gone) key)))))
      (for key gone (HashMap::remove! (mut (.shared w)) key))
      (free! (mut gone)))
    (free! (mut sorted))
    (let [(mut o) order] (free! (mut o))))
  0)

;;; The object at (tag, at, n)'s number, or -1; with `new`, one made for it when it has none.
(defn object-id! [(w (ptr Writer)) (tag i64) (at i64) (n i64) (new i64)]
  (-> i64)
  (when (> (* (+ (.filled w) 1) 2) (+ (.mask w) 1)) (objects-grow! w))
  (let [(mut i) (object-slot tag at n (.mask w))
        (mut out) -2]
    (while (= out -2)
      (let [v (get (.ids w) i)]
        (cond (= v 0)
                (if (< new 0)
                    (set! out -1)
                    (do
                      (set! (mut (.keys w)) (* i 3) tag)
                      (set! (mut (.keys w)) (+ (* i 3) 1) at)
                      (set! (mut (.keys w)) (+ (* i 3) 2) n)
                      (set! (mut (.ids w)) i (+ new 1))
                      (set! (.filled w) (+ (.filled w) 1))
                      (set! out -1)))
              (and (= (get (.keys w) (* i 3)) tag)
                   (= (get (.keys w) (+ (* i 3) 1)) at)
                   (= (get (.keys w) (+ (* i 3) 2)) n))
                (set! out (- v 1))
              :else (set! i (& (+ i 1) (.mask w))))))
    out))

;;; An object known by (tag, where it is, how long), such as a list of children (tag: an address
;;; that is its grammar's alone; 0 for texts): written the first time, true, and the caller writes
;;; its content next and then `put-object-end!`; after that by number, and false.
(defn put-object! [(w (ptr Writer)) (tag i64) (at i64) (n i64)] (-> bool)
  (let [known (object-id! w tag at n -1)]
    (if (>= known 0)
        (do (put-varint! w (+ (* known 2) 2)) false)
        (let [id (.next-id w)]
          (object-id! w tag at n id)
          (set! (.next-id w) (+ id 1))
          (object-open! w id)
          true))))

;;; The same for a value of type `ty` (its name) known by its bytes, `n` of them at `at`: an opaque
;;; one, whose parts are where its bytes point.
(defn put-object-bytes! [(w (ptr Writer)) (ty (slice u8)) (at (ptr u8)) (n i64)]
  (-> bool)
  (let [key (object-bytes-key ty at n)]
    (match (get (.shared w) key)
      (Some [known] (put-varint! w (+ (* known 2) 2)) false)
      (None []
            (let [id (.next-id w)]
              (set! (mut (.shared w)) key id)
              (set! (.next-id w) (+ id 1))
              (object-open! w id)
              true)))))

(defn object-bytes-key [(ty (slice u8)) (at (ptr u8)) (n i64)] (-> (slice u8))
  (let [(mut key) (ArrayList::new [u8] (malloc-allocator))]
    (for c ty (push! (mut key) c))
    (push! (mut key) (cast u8 0))
    (for i (range 0 n) (push! (mut key) (load (primitive/index at i))))
    (slice key)))

;;; An object's number, then the place its length will go; its content starts after.
(defn object-open! [(w (ptr Writer)) (id i64)] (-> void)
  (put-varint! w (+ (* id 2) 1))
  (put-room! w 8)
  (push! (mut (.open w)) (.pos w))
  (set! (.pos w) (+ (.pos w) 8))
  (push! (mut (.defined w)) id)
  (push! (mut (.defined w)) (writer-at w))
  0)

(defn put-object-end! [(w (ptr Writer))] (-> void)
  (match (pop! (mut (.open w)))
    (Some [at] (put-word-at! w at (- (.pos w) (+ at 8))))
    (None [] (panic "an object ended that never started")))
  0)

;;; What a reader read: known from now on as object `id`, so a later save refers to it.
(defn writer-know! [(tag i64) (at i64) (n i64) (id i64)] (-> void)
  (object-id! (the-writer) tag at n id)
  0)

(defn writer-know-bytes! [(ty (slice u8)) (at (ptr u8)) (n i64) (id i64)]
  (-> void)
  (set! (mut (.shared (the-writer))) (object-bytes-key ty at n) id)
  0)

;;; An object read where a value refers to it: its number. With `object-ready?` it has been read
;;; and `object-skip!` passes it by; otherwise `object-enter!` goes where it is, the caller reads
;;; it, and `object-leave!` keeps its value and comes back.
(defn take-object [(r (ptr Reader))] (-> i64)
  (let [v (take-varint r)]
    (if (= (& v 1) 1)
        (let [id (/ (- v 1) 2)
              n (take-word r)]
          (push! (mut (.frames r)) id)
          (push! (mut (.frames r)) 1)
          (push! (mut (.frames r)) (+ (.at r) n))
          id)
        (let [id (- (/ v 2) 1)]
          (when (< id 0) (panic "the cache refers to no object"))
          (push! (mut (.frames r)) id)
          (push! (mut (.frames r)) 0)
          (push! (mut (.frames r)) 0)
          id))))

(defn object-ready? [(r (ptr Reader)) (id i64)] (-> bool)
  (and (< id (len (.values r))) (> (get (.values r) id) 0)))

;;; Where object `id`'s value is: valid until the next is kept, so read it at once.
(defn object-value [(r (ptr Reader)) (id i64)] (-> (ptr u8))
  (primitive/index (data (slice (.arena r))) (- (get (.values r) id) 1)))

(defn frame-pop! [(r (ptr Reader))] (-> i64)
  (let [n (len (.frames r))
        id (get (.frames r) (- n 3))
        inline (get (.frames r) (- n 2))
        end (get (.frames r) (- n 1))]
    (pop! (mut (.frames r)))
    (pop! (mut (.frames r)))
    (pop! (mut (.frames r)))
    (if (= inline 1) end -1)))

(defn object-skip! [(r (ptr Reader))] (-> void)
  (let [end (frame-pop! r)]
    (when (>= end 0) (set! (.at r) end)))
  0)

;;; Objects read from the log are shared by every value that holds them, so they live in a region
;;; of the cache's own, as long as the program: no one answer's region could hold them.
(defstruct ObjectsRegion [(region i64)])

(defn objects-region [] (-> (ptr Region))
  (let [o (primitive/alloc-static ObjectsRegion)]
    (when (= (.region o) 0)
      (init-lock!)
      (when (= (.region o) 0) (set! (.region o) (primitive/cast i64 (region-make true 4194304))))
      (init-unlock!))
    (primitive/cast (ptr Region) (.region o))))

(defn object-enter! [(r (ptr Reader))] (-> void)
  (when (.objects r) (region-enter! (objects-region)))
  (let [n (len (.frames r))
        id (get (.frames r) (- n 3))
        inline (get (.frames r) (- n 2))]
    (when (= inline 0)
      (let [at (if (< id (len (.offsets r))) (get (.offsets r) id) -1)]
        (when (< at 0)
          (panic "the cache refers to object {}, which it does not hold" id))
        (reader-seek! r at))))
  0)

;;; The object just read: its value kept, `n` bytes at `at`, and the reader back where it was.
(defn object-leave! [(r (ptr Reader)) (at (ptr u8)) (n i64)] (-> i64)
  (let [k (len (.frames r))
        id (get (.frames r) (- k 3))
        inline (get (.frames r) (- k 2))
        end (frame-pop! r)
        off (len (.arena r))]
    (for i (range 0 n) (push! (mut (.arena r)) (load (primitive/index at i))))
    (while (<= (len (.values r)) id) (push! (mut (.values r)) 0))
    (set! (mut (.values r)) id (+ off 1))
    (if (= inline 1)
        (set! (.at r) end)
        (reader-return! r))
    (when (.objects r) (region-leave!))
    id))

;; ---- texts and functions

;;; A text: a short one by its length (twice it) and bytes; a long one, such as a file's source, as
;;; an object (1, then as `put-object!`). Read back it is part of the cache's bytes, which are kept
;;; for as long as the program runs, as texts are. A tree's identity is its text's words, not where
;;; they are (see `node-identity`), so sharing only saves room.
(defn put-text! [(w (ptr Writer)) (s (slice u8))] (-> void)
  (if (or (< (len s) 64) (not (.objects w)))
      (do
        (put-varint! w (* (len s) 2))
        (put-raw! w s))
      (do
        (put-varint! w 1)
        (when (put-object! w 0 (primitive/cast i64 (data s)) (len s))
          (put-varint! w (len s))
          (put-raw! w s)
          (put-object-end! w))
        0)))

(defn take-text [(r (ptr Reader))] (-> (slice u8))
  (let [h (take-varint r)]
    (if (= (& h 1) 0)
        (take-raw r (/ h 2))
        (let [id (take-object r)]
          (if (object-ready? r id)
              (do
                (object-skip! r)
                (load (cast (ptr (slice u8)) (object-value r id))))
              (do
                (object-enter! r)
                (let [(mut t) (take-raw r (take-varint r))]
                  (object-leave! r (cast (ptr u8) (mut t)) (sizeof (slice u8)))
                  (writer-know! 0 (primitive/cast i64 (data t)) (len t) id)
                  t)))))))

;;; A function value: where it is from a function of this module, which is the same in each run of
;;; the same build. 0 for none.
(defn persist-base [] (-> i64)
  0)

(defn put-fn! [(w (ptr Writer)) (f i64)] (-> void)
  (put-bool! w (!= f 0))
  (when (!= f 0) (put-int! w (- f (persist-base-address))))
  0)

(defn take-fn [(r (ptr Reader))] (-> i64)
  (if (take-bool r)
      (+ (take-int r) (persist-base-address))
      0))

;;; Where `persist-base` is: a function value's bits, read as an integer.
(defn persist-base-address [] (-> i64)
  (let [(mut f) (fnptr-of persist-base)]
    (load (cast (ptr i64) (mut f)))))

;;; With HL_CACHE_SIZES set, how many bytes each part written takes, said once it is written: a
;;; part starts at `put-part!`, and ends where the next starts; and how long reading takes.
(defstruct SizeNotes [(known i64) (on i64) (label (slice u8)) (from i64)])

(defn size-notes [] (-> (ptr SizeNotes))
  (let [t (primitive/alloc-static SizeNotes)]
    (when (= (.known t) 0)
      (set! (.on t)
            (if (= (primitive/cast i64
                                   (os/getenv (str/to-cstr (malloc-allocator)
                                                           "HL_CACHE_SIZES")))
                   0)
                0
                1))
      (set! (.known t) 1))
    t))

(defn put-part! [(w (ptr Writer)) (label (slice u8))] (-> void)
  (let [t (size-notes)]
    (when (= (.on t) 1)
      (when (> (len (.label t)) 0)
        (println "[cache] {} bytes  {}" (- (.pos w) (.from t)) (.label t)))
      (set! (.label t) label)
      (set! (.from t) (.pos w))))
  0)

;;; A module's part, once in a save or a read of an index: true the first time.
(defn put-module! [(w (ptr Writer)) (name (slice u8))] (-> bool)
  (match (get (.modules w) name)
    (Some [_] false)
    (None []
          (set! (mut (.modules w)) name 1)
          true)))

(defn take-module! [(r (ptr Reader)) (name (slice u8))] (-> bool)
  (match (get (.modules r) name)
    (Some [_] false)
    (None []
          (set! (mut (.modules r)) name 1)
          true)))

;;; A name written where a part starts, read back where the reader expects that part.
(defn put-mark! [(w (ptr Writer)) (name (slice u8))] (-> void)
  (put-varint! w (len name))
  (put-raw! w name))

(defn take-mark! [(r (ptr Reader)) (name (slice u8))] (-> void)
  (let [found (take-raw r (take-varint r))]
    (unless (= found name)
      (panic "the cache has {} where this build wrote {}: its writer and reader disagree"
             found
             name)))
  0)

(defn put-ints! [(w (ptr Writer)) (xs (ArrayList i64))] (-> void)
  (put-varint! w (len xs))
  (for x xs (put-int! w x))
  0)

(defn take-ints [(r (ptr Reader))] (-> (ArrayList i64))
  (let [n (take-varint r)
        (mut out) (ArrayList::new [i64] (malloc-allocator))]
    (reserve! (mut out) n)
    (for _ (range 0 n) (push! (mut out) (take-int r)))
    out))

(defn put-texts! [(w (ptr Writer)) (xs (ArrayList (slice u8)))] (-> void)
  (put-varint! w (len xs))
  (for x xs (put-text! w x))
  0)

(defn take-texts [(r (ptr Reader))] (-> (ArrayList (slice u8)))
  (let [n (take-varint r)
        (mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (reserve! (mut out) n)
    (for _ (range 0 n) (push! (mut out) (take-text r)))
    out))

(defn put-int-lists! [(w (ptr Writer)) (xs (ArrayList (ArrayList i64)))]
  (-> void)
  (put-varint! w (len xs))
  (for x xs (put-ints! w x))
  0)

(defn take-int-lists [(r (ptr Reader))] (-> (ArrayList (ArrayList i64)))
  (let [n (take-varint r)
        (mut out) (ArrayList::new [(ArrayList i64)] (malloc-allocator))]
    (reserve! (mut out) n)
    (for _ (range 0 n) (push! (mut out) (take-ints r)))
    out))

(defn put-text-ints-map! [(w (ptr Writer))
                          (m (HashMap (slice u8) (ArrayList i64)))] (-> void)
  (put-varint! w (len m))
  (for key m
    (put-text! w key)
    (match (get m key)
      (Some [xs] (put-ints! w xs))
      (None [] (panic "a map lost a key while it was written"))))
  0)

(defn take-text-ints-map [(r (ptr Reader))]
  (-> (HashMap (slice u8) (ArrayList i64)))
  (let [n (take-varint r)
        (mut out)
          (HashMap::new [(slice u8) (ArrayList i64)]
                        (malloc-allocator)
                        (text-keyops))]
    (for _ (range 0 n)
      (let [key (take-text r)]
        (set! (mut out) key (take-ints r))))
    out))

;;; Blocks of numbers: each key with its block's start and size, and where they end.
(defn persist-encode-Places [(w (ptr Writer)) (p Places)] (-> void)
  (put-varint! w (len (.keys p)))
  (for i (range 0 (len (.keys p)))
    (put-text! w (get (.keys p) i))
    (put-int! w (get (.starts p) i))
    (put-int! w (get (.sizes p) i)))
  (put-int! w (.end p)))

(defn persist-encode-Ranks [(w (ptr Writer)) (x Ranks)] (-> void)
  (put-varint! w (len (.keys x)))
  (for key (.keys x)
    (put-text! w key)
    (put-int! w (rank-of x key)))
  (put-int! w (.version x)))

(defn persist-decode-Ranks [(r (ptr Reader))] (-> Ranks)
  (let [(mut out) (ranks-new)
        n (take-varint r)]
    (for _ (range 0 n)
      (let [key (take-text r)
            rank (take-int r)]
        (push! (mut (.keys out)) key)
        (set! (mut (.at out)) key rank)))
    (set! (.version out) (take-int r))
    out))

(defn persist-decode-Places [(r (ptr Reader))] (-> Places)
  (let [(mut out) (places-new)
        n (take-varint r)]
    (for _ (range 0 n)
      (let [key (kept-text (take-text r))
            a (take-int r)
            size (take-int r)]
        (set! (mut (.slot out)) key (len (.keys out)))
        (push! (mut (.keys out)) key)
        (push! (mut (.starts out)) a)
        (push! (mut (.sizes out)) size)))
    (set! (.end out) (take-int r))
    out))

;;; Interned names: each in the order of its id.
(defn persist-encode-Names [(w (ptr Writer)) (ns Names)] (-> void)
  (put-texts! w (.strs ns)))

(defn persist-decode-Names [(r (ptr Reader))] (-> Names)
  (let [(mut out) (names-new)]
    (for s (take-texts r) (intern! (mut out) s))
    out))

;;; A relation: its rows, in order, and where its last round started and stopped. Its indexes are
;;; made again as queries ask for them.
(defn rel-encode! [(w (ptr Writer)) (x Rel)] (-> void)
  (unless (= (len (.queue x)) 0)
    (panic "a relation with rows still queued cannot be kept"))
  (when (.updating x)
    (panic "a relation an update is still changing cannot be kept"))
  (let [(mut y) x
        live (rel-live-count (mut y))]
    (put-varint! w (.arity x))
    (put-varint! w live)
    ;; The rows that are in, numbered again from 0, so what was taken out is not kept.
    (for row (range 0 (.count x))
      (when (rel-live-row? (mut y) row)
        (for c (range 0 (.arity x)) (put-int! w (rel-at (mut y) row c)))))
    (if (= (.gone x) 0)
        (do
          (put-int! w (.seen x))
          (put-int! w (.delta-from x))
          (put-int! w (.delta-to x)))
        (do (put-int! w live) (put-int! w live) (put-int! w live))))
  0)

(defn rel-decode [(r (ptr Reader))] (-> Rel)
  (let [arity (take-varint r)
        count (take-varint r)
        (mut x) (rel-new arity)]
    (rel-reserve! (mut x) count)
    (for _ (range 0 count)
      (let [a (take-int r)
            b (if (>= arity 2) (take-int r) 0)
            c (if (>= arity 3) (take-int r) 0)
            d (if (>= arity 4) (take-int r) 0)]
        (unless (rel-add! (mut x) a b c d)
          (panic "a relation in the cache holds a row twice"))))
    (set! (.seen x) (take-int r))
    (set! (.delta-from x) (take-int r))
    (set! (.delta-to x) (take-int r))
    (set! (.start x) (.count x))
    x))

;;; The dependency graph, as `Deps` holds it. What is found by text is found again from the texts.
(defn deps-encode! [(w (ptr Writer)) (d (ptr Deps))] (-> void)
  (put-mark! w "deps")
  (put-int! w (atomic/read (field d revision)))
  (put-int! w (.computed d))
  (put-texts! w (.texts d))
  (put-ints! w (.changed d))
  (put-ints! w (.verified d))
  (put-int-lists! w (.reads d))
  (put-ints! w (.dep-heads d))
  (put-ints! w (.edge-to d))
  (put-ints! w (.edge-next d))
  (put-varint! w (len (.dirty d)))
  (for x (.dirty d) (put-bool! w x))
  (put-texts! w (.prints d))
  (put-texts! w (.stamps d))
  (put-text-ints-map! w (.queries d))
  (put-varint! w (len (.paths d)))
  (for key (.paths d)
    (put-text! w key)
    (match (get (.paths d) key)
      (Some [xs] (put-texts! w xs))
      (None [] (panic "a map lost a key while it was written"))))
  (put-texts! w (.sites d))
  (put-ints! w (.site-settings d))
  (put-texts! w (.site-prefixes d))
  (put-texts! w (.site-suffixes d))
  (put-texts! w (.site-rels d))
  (put-ints! w (.site-cols d))
  (put-varint! w (len (.site-keys d)))
  (for keys (.site-keys d) (put-texts! w keys))
  (put-text-ints-map! w (.setting-sites d))
  (put-ints! w (.num-changed d))
  (put-ints! w (.num-heads d))
  (put-ints! w (.num-sites d))
  (put-ints! w (.num-indexes d))
  (put-varint! w (len (.site-pages d)))
  (for pages (.site-pages d) (put-int-lists! w pages))
  0)

(defn deps-decode! [(r (ptr Reader)) (d (ptr Deps))] (-> void)
  (take-mark! r "deps")
  (atomic/store (field d revision) (take-int r))
  (set! (.computed d) (take-int r))
  (set! (.texts d) (take-texts r))
  (set! (.before d) (len (.texts d)))
  (set! (.changed d) (take-ints r))
  (set! (.verified d) (take-ints r))
  (set! (.reads d) (take-int-lists r))
  (set! (.dep-heads d) (take-ints r))
  (set! (.edge-to d) (take-ints r))
  (set! (.edge-next d) (take-ints r))
  (let [n (take-varint r)
        (mut dirty) (ArrayList::new [bool] (malloc-allocator))]
    (for _ (range 0 n) (push! (mut dirty) (take-bool r)))
    (set! (.dirty d) dirty))
  ;; Each the graph's own copy, as `stored-text-set!` replaces them.
  (set! (.prints d) (owned-texts (take-texts r)))
  (set! (.stamps d) (owned-texts (take-texts r)))
  (set! (.queries d) (take-text-ints-map r))
  (let [n (take-varint r)
        (mut paths)
          (HashMap::new [(slice u8) (ArrayList (slice u8))]
                        (malloc-allocator)
                        (text-keyops))]
    (for _ (range 0 n)
      (let [key (take-text r)]
        (set! (mut paths) key (take-texts r))))
    (set! (.paths d) paths))
  (set! (.sites d) (take-texts r))
  (set! (.site-settings d) (take-ints r))
  (set! (.site-prefixes d) (take-texts r))
  (set! (.site-suffixes d) (take-texts r))
  (set! (.site-rels d) (take-texts r))
  (set! (.site-cols d) (take-ints r))
  (let [n (take-varint r)
        (mut all) (ArrayList::new [(ArrayList (slice u8))] (malloc-allocator))
        (mut ids) (ArrayList::new [(HashMap (slice u8) i64)] (malloc-allocator))]
    (for _ (range 0 n)
      (let [keys (take-texts r)
            (mut by)
              (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))]
        (for i (range 0 (len keys)) (set! (mut by) (get keys i) i))
        (push! (mut all) keys)
        (push! (mut ids) by)))
    (set! (.site-keys d) all)
    (set! (.site-key-ids d) ids))
  (set! (.setting-sites d) (take-text-ints-map r))
  (set! (.num-changed d) (take-ints r))
  (set! (.num-heads d) (take-ints r))
  (set! (.num-sites d) (take-ints r))
  (set! (.num-indexes d) (take-ints r))
  (let [n (take-varint r)
        (mut all)
          (ArrayList::new [(ArrayList (ArrayList i64))] (malloc-allocator))]
    (for _ (range 0 n) (push! (mut all) (take-int-lists r)))
    (set! (.site-pages d) all))
  ;; Found by text: nodes, and sites.
  (let [(mut ids)
          (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))]
    (for i (range 0 (len (.texts d))) (set! (mut ids) (get (.texts d) i) i))
    (set! (.ids d) ids))
  (let [(mut sites)
          (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops))]
    (for i (range 0 (len (.sites d)))
      (set! (mut sites)
            (site-key (get (.texts d) (get (.site-settings d) i))
                      (get (.site-prefixes d) i)
                      (get (.site-suffixes d) i))
            i))
    (set! (.site-ids d) sites))
  0)

;; ---- reading lazily

;;; One lock for everything read from the log: a reader has one place it is at.
(defstruct CacheLock [(word i64)])

(defn cache-lock! [] (-> void)
  (spin-lock! (cast (ptr i64) (cache-lock-cell))))

(defn cache-unlock! [] (-> void)
  (spin-unlock! (cast (ptr i64) (cache-lock-cell))))

(defn cache-lock-cell [] (-> (ptr CacheLock))
  (primitive/alloc-static CacheLock))

;;; The log's reader and the writer that appends to it: one of each, for the program.
(defstruct Cells [(reader Reader) (writer Writer) (ready bool)])

(defn cells [] (-> (ptr Cells))
  (let [c (primitive/alloc-static Cells)]
    (unless (.ready c)
      (set! (.reader c) (reader-new "" true))
      (set! (.writer c) (writer-new true))
      (set! (.ready c) true))
    c))

(defn the-reader [] (-> (ptr Reader))
  (field (cells) reader))

(defn the-writer [] (-> (ptr Writer))
  (field (cells) writer))

;;; A memo answer's node, read: claimed by its store, with its text made again from its key as this
;;; run makes it, since a key may hold where a tree is.
(defn dep-retext! [(id i64) (text (slice u8))] (-> void)
  (let [d (deps)]
    (deps-lock! d)
    (let [old (get (.texts d) id)]
      (when (!= old text)
        (match (get (.ids d) old)
          (Some [x] (when (= x id) (HashMap::remove! (mut (.ids d)) old)))
          (None [] 0))
        (let [kept (own-text text)]
          (set! (mut (.texts d)) id kept)
          (set! (mut (.ids d)) kept id))))
    (dep-claim-locked! d id)
    (deps-unlock! d))
  0)

(defn dep-claim! [(id i64)] (-> void)
  (let [d (deps)]
    (deps-lock! d)
    (dep-claim-locked! d id)
    (deps-unlock! d))
  0)

(defn dep-claim-locked! [(d (ptr Deps)) (id i64)] (-> void)
  (let [l (loading-state)]
    (when (< id (len (.claimed l))) (set! (mut (.claimed l)) id true)))
  0)

;;; A memo answer's key, as its node's text has it now.
(defn dep-memo-key [(id i64)] (-> (slice u8))
  (let [d (deps)]
    (deps-lock! d)
    (let [t (get (.texts d) id)]
      (deps-unlock! d)
      (match (index-of t "\0")
        (Some [i] (subslice t (+ i 1) (len t)))
        (None [] (panic "node {} is no memo answer's" id))))))

;;; A memo whose answers are found by keys holding where trees are: its keys are made when it is
;;; first used, so its nodes are claimed then, not when the log is read.
(defn memo-pending-name! [(name (slice u8))] (-> void)
  (set! (mut (.pending (loading-state))) name 1)
  0)

;;; Memo answers' nodes of `name` (or, with "", of every memo not pending) no store claimed, of a
;;; memo whose arguments cannot be made again from its key: nothing finds them by text, and they
;;; count as changed to whatever checks what read them, which nothing does unless something else it
;;; read changed. A memo whose key is its one argument keeps its unclaimed nodes, what they read
;;; and when they changed: an answer not saved (kept only in memory) is then current after a restart
;;; while all it read is, and what read it with it (see `dep-earlier-current?`).
(defn dep-unclaimed-of! [(name (slice u8))] (-> void)
  (let [d (deps)
        l (loading-state)]
    (deps-lock! d)
    (for i (range 0 (len (.texts d)))
      (let [t (get (.texts d) i)]
        (match (index-of t "\0")
          (Some [cut]
                (let [owner (subslice t 0 cut)]
                  (when (and (< i (len (.claimed l)))
                             (not (get (.claimed l) i))
                             (match (get (.by-argument l) owner) (Some [_] false) (None [] true))
                             (if (= (len name) 0)
                                 (match (get (.pending l) owner)
                                   (Some [_] false)
                                   (None [] true))
                                 (= owner name)))
                    (HashMap::remove! (mut (.ids d)) t)
                    (set! (mut (.texts d)) i "")
                    (set! (mut (.changed d)) i 4611686018427387903))))
          (None [] 0))))
    (deps-unlock! d))
  0)

;;; While the log is read and after: which memo answers' nodes their stores have claimed, which
;;; memos claim theirs when first used, and what the files on disk hold: the log's length and the
;;; length it had when last written whole, and the revision and how many answers had been computed
;;; when they were last written or read (while both stay, a save would write nothing new).
(defstruct Loading
  [(claimed (ArrayList bool))
   (pending (HashMap (slice u8) i64))
   ;; Memos whose key is their one argument, a number or text, as their nodes' texts write it: an
   ;; answer's node no store claimed is still found by its text, and made again from it (see
   ;; `dep-unclaimed-of!`).
   (by-argument (HashMap (slice u8) i64))
   (log-end i64)
   (compacted i64)
   (kept-revision i64)
   (kept-computed i64)
   (kept bool)
   (ready bool)])

(defn loading-state [] (-> (ptr Loading))
  (let [l (primitive/alloc-static Loading)]
    (unless (.ready l)
      (set! (.claimed l) (ArrayList::new [bool] (malloc-allocator)))
      (set! (.pending l)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.by-argument l)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.ready l) true))
    l))

;;; A memo whose key is its one argument, read from the cache: its answers' nodes are found by text,
;;; and an answer not saved is made again from its key.
(defn memo-keyed-by-argument! [(name (slice u8))] (-> void)
  (set! (mut (.by-argument (loading-state))) name 1)
  0)

;;; What wrote the cache and what reads it must be the same build of the program: the executable,
;;; by where it is and its size and time.
(defn exe-path [] (-> (slice u8))
  (let [a0 (arg-at 0)]
    (if (is-some-index? (index-of a0 "/"))
        (real-path-raw a0)
        (let [found (os/getenv (str/to-cstr (malloc-allocator) "PATH"))
              (mut out) a0]
          (unless (= (primitive/cast i64 found) 0)
            (for dir (split (str/from-cstr found) ":")
              (let [p (join dir (join "/" a0))]
                (when (and (= out a0) (file-exists-raw? p))
                  (set! out (real-path-raw p))))))
          out))))

(defn is-some-index? [(o (Option i64))] (-> bool)
  (match o (Some [_] true) (None [] false)))

(defn exe-identity [] (-> (slice u8))
  (let [p (exe-path)]
    (join p (join "\0" (file-stamp p)))))

(defn bytes-hash [(bytes (slice u8))] (-> i64)
  (let [(mut h) (^ -3750763034362895579 (len bytes))
        n (len bytes)
        words (/ n 8)
        base (data bytes)]
    (for w (range 0 words)
      (let [x (load (cast (ptr i64) (primitive/index base (* w 8))))]
        (set! h (primitive/imul (^ h x) -7046029254386353131))
        (set! h (^ h (>> h 29)))))
    (for i (range (* words 8) n)
      (set! h (primitive/imul (^ h (cast i64 (get bytes i))) 1099511628211)))
    h))

;;; What a program keeps: its main's functions that write and read every module's part, and that
;;; read whatever is still unread, set as it starts.
(defstruct PersistRoot
  [(save (fnptr (cc/C) [(ptr Writer) (ptr Writer) bool] void))
   (load (fnptr (cc/C) [(ptr Reader)] void))
   (force (fnptr (cc/C) [] void))
   (set bool)])

;;; The one cell of it (`alloc-static` makes one per place it is written).
(defn persist-root-cell [] (-> (ptr PersistRoot))
  (primitive/alloc-static PersistRoot))

(defn persist-root! [(save (fnptr (cc/C) [(ptr Writer) (ptr Writer) bool] void))
                     (load (fnptr (cc/C) [(ptr Reader)] void))
                     (force (fnptr (cc/C) [] void))] (-> void)
  (let [root (persist-root-cell)]
    (set! (.save root) save)
    (set! (.load root) load)
    (set! (.force root) force)
    (set! (.set root) true))
  0)

(defn persist-root [] (-> (ptr PersistRoot))
  (let [root (persist-root-cell)]
    (unless (.set root)
      (panic "nothing says what to keep: a program's main sets that, as it starts"))
    root))

;;; Each module's part, once in a pass that reads all that is unread.
(defstruct ForceVisits [(seen (HashMap (slice u8) i64)) (ready bool)])

(defn force-module! [(name (slice u8))] (-> bool)
  (let [f (primitive/alloc-static ForceVisits)]
    (unless (.ready f)
      (set! (.seen f)
            (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
      (set! (.ready f) true))
    (match (get (.seen f) name)
      (Some [_] false)
      (None []
            (set! (mut (.seen f)) name 1)
            true))))

(defn force-pass-start! [] (-> void)
  (let [f (primitive/alloc-static ForceVisits)]
    (when (.ready f) (HashMap::clear! (mut (.seen f)))))
  (force-module! "")
  0)

(defn log-magic [] (-> (slice u8))
  "hl.rt cache 2\n")

(defn deps-magic [] (-> (slice u8))
  "hl.rt deps 2\n")

;;; Everything new since the files were last written, kept: only while no memo computes.
(defn cache-save! [(path (slice u8))] (-> void)
  (cache-saved!)
  (cache-save-now! path)
  0)

(defn cache-save-now! [(path (slice u8))] (-> void)
  (let [d (deps)
        l (loading-state)]
    (unless (.tracking d)
      (panic "the cache keeps what tracked builds compute, and nothing is tracked"))
    (unless (cache-current? d)
      ;; HL_CACHE_WHOLE set: always whole, so what that does is seen without waiting for the log to grow.
      (if (or (= (.log-end l) 0)
              (> (.log-end l) (+ (* 2 (.compacted l)) 8388608))
              (not (file-exists-raw? path))
              (!= (primitive/cast i64
                                  (os/getenv (str/to-cstr (malloc-allocator)
                                                          "HL_CACHE_WHOLE")))
                  0))
          (cache-write-whole! path d)
          (cache-append! path d)))
    0))

;;; The log written again, whole: everything read first, then numbered afresh.
(defn cache-write-whole! [(path (slice u8)) (d (ptr Deps))] (-> void)
  (let [root (persist-root)
        force (.force root)]
    (force-pass-start!)
    (force)
    (let [c (cells)]
      (set! (.writer c) (writer-new true)))
    (let [w (the-writer)
          magic (log-magic)
          id (exe-identity)
          (mut head) (ArrayList::new [u8] (malloc-allocator))]
      (for b magic (push! (mut head) b))
      (let [hw (primitive/alloc-static HeadWriter)]
        (set! (.w hw) (writer-new false))
        (put-varint! (field hw w) (len id))
        (put-raw! (field hw w) id)
        (for b (written-bytes (field hw w)) (push! (mut head) b)))
      (let [segment (segment-bytes (len head) true)
            (mut all) head]
        (ArrayList::extend! (mut all) (data segment) (len segment))
        (let [tmp (join path ".new")]
          (write-output tmp (slice all))
          (match (fs/rename-file (malloc-allocator) tmp path)
            (Ok [_] 0)
            (Err [_] (panic "cannot move {} to {}" tmp path))))
        (let [l (loading-state)]
          (set! (.log-end l) (len all))
          (set! (.compacted l) (len all)))
        (deps-write! path d))))
  0)

(defstruct HeadWriter [(w Writer)])

;;; What changed since the last save, as a segment at the log's end.
(defn cache-append! [(path (slice u8)) (d (ptr Deps))] (-> void)
  (let [l (loading-state)
        start (.log-end l)
        segment (segment-bytes start false)]
    (append-at! path start segment)
    (set! (.log-end l) (+ start (len segment)))
    (deps-write! path d))
  0)

;;; A segment starting at `start` in the log: its length, what is new (everything, when `whole`),
;;; its index (the objects it defines, then each module's part), where the index starts, and a hash.
(defn segment-bytes [(start i64) (whole bool)] (-> (slice u8))
  (let [w (the-writer)
        x (primitive/alloc-static IndexWriter)
        root (persist-root)
        save (.save root)]
    (writer-restart! w (+ start 8))
    (set! (.w x) (writer-new false))
    (save w (field x w) whole)
    (put-part! w "")
    (let [index-at (writer-at w)
          defined (.defined w)]
      (put-varint! w (/ (len defined) 2))
      (for v defined (put-varint! w v))
      (put-raw! w (written-bytes (field x w)))
      (put-word! w index-at)
      (free [u8] (big-allocator) (.mem (field x w)))
      (let [body (written-bytes w)
            f (primitive/alloc-static FrameWriter)]
        (set! (.w f) (writer-new false))
        (put-word! (field f w) (len body))
        (put-raw! (field f w) body)
        (put-word! (field f w) (bytes-hash body))
        (written-bytes (field f w))))))

(defstruct IndexWriter [(w Writer)])

(defstruct FrameWriter [(w Writer)])

(extern ftruncate :cc (cc/C) [i32 i64] (-> i32))

(extern write :cc (cc/C) [i32 (ptr i8) isize] (-> isize))

;;; `bytes` written at `at` in the file at `path`, which ends there: whatever was after it, part of
;;; a segment a run stopped in the middle of, gone.
(defn append-at! [(path (slice u8)) (at i64) (bytes (slice u8))] (-> void)
  (let [fd
          (os/open (str/to-cstr (malloc-allocator) path)
                   (primitive/cast i32 (| fs/O_WRONLY fs/O_CLOEXEC))
                   0)]
    (when (< fd (: 0 i32)) (panic "cannot write {}" path))
    (when (< (ftruncate fd at) (: 0 i32))
      (panic "cannot cut {} to where it was whole" path))
    (lseek fd at 0)
    (let [(mut off) 0]
      (while (< off (len bytes))
        (let [n
                (write fd
                       (primitive/cast (ptr i8)
                                       (primitive/index (data bytes) off))
                       (primitive/cast isize (- (len bytes) off)))]
          (when (<= (primitive/cast i64 n) 0) (panic "cannot write {}" path))
          (set! off (+ off (primitive/cast i64 n))))))
    (os/close fd))
  0)

;;; The dependency graph, beside the log: whole, with how long the log is that goes with it, moved
;;; into place once written.
(defn deps-write! [(path (slice u8)) (d (ptr Deps))] (-> void)
  (let [hw (primitive/alloc-static DepsWriter)
        l (loading-state)]
    (set! (.w hw) (writer-new false))
    (let [w (field hw w)
          id (exe-identity)]
      (put-raw! w (deps-magic))
      (put-varint! w (len id))
      (put-raw! w id)
      (put-int! w (.log-end l))
      (put-int! w (.compacted l))
      (put-part! w "dependencies")
      (deps-encode! w d)
      (put-part! w "")
      (put-word! w (bytes-hash (written-bytes w)))
      (let [tmp (join path ".deps.new")
            to (join path ".deps")]
        (write-output tmp (written-bytes w))
        (match (fs/rename-file (malloc-allocator) tmp to)
          (Ok [_] 0)
          (Err [_] (panic "cannot move {} to {}" tmp to))))
      (free [u8] (big-allocator) (.mem w))))
  (cache-kept! d)
  0)

(defstruct DepsWriter [(w Writer)])

;;; A save on a thread of its own (`cache-save-later!`).
(defstruct Saving
  [(running bool) (thread Thread) (path (slice u8)) (timing bool)])

(defn saving [] (-> (ptr Saving))
  (primitive/alloc-static Saving))

;;; Everything kept, as `cache-save!` keeps it, on a thread of its own while this one goes on, which
;;; must not change what builds computed until `cache-saved!`: a watcher saves while it waits for an
;;; edit, and waits for the save before it looks. With `timing`, says when it is done.
(defn cache-save-later! [(path (slice u8)) (timing bool)] (-> void)
  (cache-saved!)
  (let [s (saving)]
    (if (cache-current? (deps))
        (when timing (println "[cache] nothing new to save"))
        (do
          (set! (.path s) path)
          (set! (.timing s) timing)
          (set! (.running s) true)
          ;; A tree is written as deep as it is: room for that, as a build has.
          (when (!= (Thread::spawn-configured (field s thread)
                                              (fnptr-of saver-run)
                                              (cast (ptr i8) 0)
                                              (ThreadConfig
                                                :stack-size 1073741824
                                                :guard-size 0))
                    (: 0 i32))
            (panic "could not start the thread that saves the cache"))
          0)))
  0)

(defn saver-run [(arg (ptr i8))] (-> (ptr i8))
  (let [s (saving)
        start (now-us)]
    (cache-save-now! (.path s))
    (when (.timing s)
      (let [took (- (now-us) start)]
        (println "[cache] saved in {}.{} ms"
                 (/ took 1000)
                 (/ (% took 1000) 100)))))
  arg)

;;; A save on its own thread, finished.
(defn cache-saved! [] (-> void)
  (let [s (saving)]
    (when (.running s)
      (join (field s thread))
      (set! (.running s) false)))
  0)

;;; Whether the files on disk hold what is here: nothing changed, and nothing was computed, since
;;; they were read or written.
(defn cache-current? [(d (ptr Deps))] (-> bool)
  (let [l (loading-state)]
    (and (.kept l)
         (= (.kept-revision l) (atomic/read (field d revision)))
         (= (.kept-computed l) (.computed d)))))

(defn cache-kept! [(d (ptr Deps))] (-> void)
  (let [l (loading-state)]
    (set! (.kept l) true)
    (set! (.kept-revision l) (atomic/read (field d revision)))
    (set! (.kept-computed l) (.computed d)))
  0)

;;; A file's bytes when its header is `magic` and this program's identity and its last eight bytes
;;; hash the rest: the rest, after the header. Otherwise none, and why.
(defn checked-file [(path (slice u8)) (magic (slice u8)) (hashed bool)]
  (-> (Option (slice u8)))
  (let [bytes (read-all-raw path)
        n (len bytes)
        id (exe-identity)]
    (cond (or (< n (+ (len magic) 8)) (!= (subslice bytes 0 (len magic)) magic))
            (do
              (println "[cache] {} is not a cache this program wrote; building from the start"
                       path)
              (None [(slice u8)]))
          (and hashed
               (!= (bytes-hash (subslice bytes 0 (- n 8)))
                   (word-at bytes (- n 8))))
            (do
              (println "[cache] {} is damaged; building from the start" path)
              (None [(slice u8)]))
          :else
            (let [r (primitive/alloc-static HeadReader)]
              (set! (.r r) (reader-new bytes false))
              (set! (.at (field r r)) (len magic))
              (let [found (take-raw (field r r) (take-varint (field r r)))]
                (if (!= found id)
                    (do
                      (println "[cache] {} was written by another build of this program; building from the start"
                               path)
                      (None [(slice u8)]))
                    (Some (subslice bytes 0 (if hashed (- n 8) n)))))))))

(defstruct HeadReader [(r Reader)])

;;; The cache at `path` (the log, and the graph beside it), read when there is one this build wrote:
;;; the graph whole, the log's indexes, and the states; answers and settings when first asked for.
;;; True, with every input checked since, so what changed while nothing ran is changed now. False,
;;; saying why when there is a cache it will not use, when there is none. Only before any memo
;;; computes.
(defn cache-load! [(path (slice u8))] (-> bool)
  (let [d (deps)
        deps-path (join path ".deps")]
    (unless (.tracking d)
      (panic "a cache is loaded into tracked builds, and nothing is tracked"))
    (when (> (len (.texts d)) 0)
      (panic "a cache is loaded before anything is computed"))
    (if (or (not (file-exists-raw? path)) (not (file-exists-raw? deps-path)))
        false
        (match (checked-file deps-path (deps-magic) true)
          (None [] false)
          (Some [graph]
                (match (checked-file path (log-magic) false)
                  (None [] false)
                  (Some [log]
                        (let [hr (primitive/alloc-static GraphReader)]
                          (set! (.r hr) (reader-new graph false))
                          (let [g (field hr r)]
                            (set! (.at g) (len (deps-magic)))
                            (take-raw g (take-varint g))
                            (let [log-end (take-int g)
                                  compacted (take-int g)]
                              (match (segments-of log log-end)
                                (None []
                                      ;; A segment whose hash is wrong, or one too few for the graph beside it.
                                      (println "[cache] {} is damaged; building from the start"
                                               path)
                                      false)
                                (Some [starts]
                                      (let [t0 (now-us)]
                                        (deps-decode! g d)
                                        (when (= (.on (size-notes)) 1)
                                          (println "[cache] dependencies read in {} us"
                                                   (- (now-us) t0))))
                                      (log-read! log starts d)
                                      (let [l (loading-state)]
                                        (set! (.log-end l) log-end)
                                        (set! (.compacted l) compacted))
                                      (cache-kept! d)
                                      (dep-unclaimed-of! "")
                                      (dep-changed-inputs!)
                                      true))))))))))))

(defstruct GraphReader [(r Reader)])

;;; Where each whole segment of the log starts, up to `end`: none when one before it is not whole.
(defn segments-of [(log (slice u8)) (end i64)] (-> (Option (ArrayList i64)))
  (let [(mut at) (+ (len (log-magic)) 0)
        (mut starts) (ArrayList::new [i64] (malloc-allocator))
        (mut ok) true]
    ;; Past the header: the identity, a length and its bytes.
    (let [hr (primitive/alloc-static HeadReader)]
      (set! (.r hr) (reader-new log false))
      (set! (.at (field hr r)) at)
      (take-raw (field hr r) (take-varint (field hr r)))
      (set! at (.at (field hr r))))
    (while (and ok (< at end))
      (if (> (+ at 16) (len log))
          (set! ok false)
          (let [n (word-at log at)
                body-at (+ at 8)]
            (if (or (< n 0)
                    (> (+ body-at n 8) (len log))
                    (!= (bytes-hash (subslice log body-at (+ body-at n)))
                        (word-at log (+ body-at n))))
                (set! ok false)
                (do
                  (push! (mut starts) body-at)
                  (push! (mut starts) n)
                  (set! at (+ body-at n 8)))))))
    (if (and ok (= at end)) (Some starts) (None [(ArrayList i64)]))))

;;; The log's indexes, in order, each module reading its part of each: what is in which segment,
;;; later ones over earlier ones.
(defn log-read! [(log (slice u8)) (starts (ArrayList i64)) (d (ptr Deps))]
  (-> void)
  (let [c (cells)
        l (loading-state)
        t0 (now-us)]
    (set! (.reader c) (reader-new log true))
    (set! (.writer c) (writer-new true))
    (let [(mut claimed) (ArrayList::new [bool] (malloc-allocator))]
      (for _ (range 0 (len (.texts d))) (push! (mut claimed) false))
      (set! (.claimed l) claimed))
    (let [r (the-reader)
          w (the-writer)
          root (persist-root)
          load-all (.load root)]
      (for k (range 0 (/ (len starts) 2))
        (let [body-at (get starts (* k 2))
              n (get starts (+ (* k 2) 1))
              index-at (word-at log (- (+ body-at n) 8))]
          (set! (.at r) index-at)
          (let [count (take-varint r)]
            (for _ (range 0 count)
              (let [id (take-varint r)
                    at (take-varint r)]
                (while (<= (len (.offsets r)) id) (push! (mut (.offsets r)) -1))
                (set! (mut (.offsets r)) id at)
                (when (>= id (.next-id w)) (set! (.next-id w) (+ id 1))))))
          (HashMap::clear! (mut (.modules r)))
          (load-all r))))
    (when (= (.on (size-notes)) 1)
      (println "[cache] indexes and states read in {} us" (- (now-us) t0))))
  0)

;; ---------------------------------------------------------------- forgetting, while nothing is tracked

;; ---------------------------------------------------------------- contexts

;;; The contexts a program builds in side by side (`contexts` in the pipeline language): a
;;; framework's browser build and server build. One is entered by giving the setting that names it;
;;; while it is, each setting a context has of its own holds that context's value, binding count and
;;; last value (what its next binding is compared with), each context's kept apart (`slots`, by
;;; context), so going back to a context finds its settings as it left them, and an answer that reads
;;; none of them is the same in every context. Context 0 is none: a build outside any context.
(defstruct ContextOwn
  [(name (slice u8))
   ;; The setting's state taken out, as a block of its own (panics if it is given just now); and a
   ;; block put back (0: a context that never gave it: unbound, nothing held).
   (save (fnptr (cc/C) [] (ptr u8)))
   (load (fnptr (cc/C) [(ptr u8)] void))
   (slots (ArrayList i64))])

(defstruct ContextsState
  [(ready bool)
   (current i64)
   (names (ArrayList (slice u8)))
   (stack (ArrayList i64))
   (owns (ArrayList ContextOwn))])

(defn contexts [] (-> (ptr ContextsState))
  (let [c (primitive/alloc-static ContextsState)]
    (unless (.ready c)
      (init-lock!)
      (unless (.ready c)
        (set! (.names c) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (push! (mut (.names c)) "")
        (set! (.stack c) (ArrayList::new [i64] (malloc-allocator)))
        (set! (.owns c) (ArrayList::new [ContextOwn] (malloc-allocator)))
        (set! (.ready c) true))
      (init-unlock!))
    c))

(defn context-active? [] (-> bool) (> (.current (contexts)) 0))

(defn context-index [(name (slice u8))] (-> i64)
  (let [c (contexts)
        (mut at) -1]
    (for i (range 0 (len (.names c))) (when (= (get (.names c) i) name) (set! at i)))
    (when (< at 0)
      (set! at (len (.names c)))
      (when (>= at 64) (panic "more than 63 contexts: {}" name))
      (push! (mut (.names c)) (own-text name)))
    at))

;;; A context's own setting given while a context is entered: from now on it is swapped as contexts
;;; change. Named once; a second module's helpers for the same setting are the same.
(defn context-own-give! [(name (slice u8))
                         (save (fnptr (cc/C) [] (ptr u8)))
                         (load (fnptr (cc/C) [(ptr u8)] void))] (-> void)
  (let [c (contexts)]
    (when (and (> (.current c) 0) (not (in-job?)))
      (let [(mut known) false]
        (for o (.owns c) (when (= (.name o) name) (set! known true)))
        (unless known
          (let [(mut slots) (ArrayList::new [i64] (malloc-allocator))]
            (for i (range 0 64) (push! (mut slots) 0))
            (push! (mut (.owns c)) (ContextOwn :name (own-text name) :save save :load load :slots slots)))))))
  0)

(defn context-swap! [(from i64) (to i64)] (-> void)
  (let [c (contexts)]
    (for i (range 0 (len (.owns c)))
      (let [o (get (.owns c) i)
            out (primitive/call-ptr (.save o))
            back (get (.slots o) to)]
        (set! (mut (.slots (elem (mut (.owns c)) i))) from (primitive/cast i64 out))
        (primitive/call-ptr (.load o) (primitive/cast (ptr u8) back))
        (when (!= back 0) (primitive/free (primitive/cast (ptr i8) back)))
        (set! (mut (.slots (elem (mut (.owns c)) i))) to 0))))
  0)

;;; The setting naming the context was given `name`: its own settings as that context left them.
(defn context-enter! [(name (slice u8))] (-> void)
  (when (in-job?) (panic "a context is entered by the program's own thread, not a job's: {}" name))
  (let [c (contexts)
        to (if (= (len name) 0) 0 (context-index name))]
    (push! (mut (.stack c)) (.current c))
    (when (!= to (.current c)) (context-swap! (.current c) to))
    (set! (.current c) to))
  0)

;;; And its binding ended: back to the context it was given in.
(defn context-leave! [] (-> void)
  (let [c (contexts)
        back (match (pop! (mut (.stack c))) (Some [b] b) (None [] (panic "a context left that was never entered")))]
    (when (!= back (.current c)) (context-swap! (.current c) back))
    (set! (.current c) back))
  0)

;;; A context's own answer's key: its key and the context it is made in (none: the key itself).
(defn context-int-key [(k i64)] (-> (slice u8))
  (context-text-key (num-text k)))

;;; Length-prefixed fields distinguish every context and key, including the context outside any
;;; named one. The complete integer is encoded too: reserving low bits would lose its high bits.
(defn context-text-key [(k (slice u8))] (-> (slice u8))
  (let [c (contexts)
        (mut b) (key-buf-new)]
    (key-text! (mut b) (get (.names c) (.current c)))
    (key-text! (mut b) k)
    (key-done! (mut b))))

;;; While dependencies are not tracked, a setting given a new value has each kept answer that reads
;;; it start over: each memo says, when its store is made, which settings it reads (as the compiler
;;; worked out from the code), and how to forget.
(defstruct Forgetting
  [(lock i64)
   (ready bool)
   (by (HashMap (slice u8) (ArrayList (fnptr (cc/C) [] void))))])

(defn forgetting [] (-> (ptr Forgetting))
  (let [f (primitive/alloc-static Forgetting)]
    (unless (.ready f)
      (init-lock!)
      (unless (.ready f)
        (set! (.by f)
              (HashMap::new [(slice u8) (ArrayList (fnptr (cc/C) [] void))]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.ready f) true))
      (init-unlock!))
    f))

(defn forget-when! [(setting (slice u8)) (forget (fnptr (cc/C) [] void))]
  (-> void)
  (let [f (forgetting)]
    (spin-lock! (cast (ptr i64) f))
    (let [(mut xs)
            (match (get (.by f) setting)
              (Some [xs] xs)
              (None []
                    (ArrayList::new [(fnptr (cc/C) [] void)] (malloc-allocator))))]
      (push! (mut xs) forget)
      (set! (mut (.by f)) setting xs))
    (spin-unlock! (cast (ptr i64) f)))
  0)

(defn forget-readers! [(setting (slice u8))] (-> void)
  (let [f (forgetting)]
    (spin-lock! (cast (ptr i64) f))
    (let [xs
            (match (get (.by f) setting)
              (Some [xs] xs)
              (None []
                    (ArrayList::new [(fnptr (cc/C) [] void)] (malloc-allocator))))]
      (spin-unlock! (cast (ptr i64) f))
      ;; Given to one job among several at once, a setting is that job's own: an answer kept
      ;; from it would be handed to the other jobs as theirs.
      (when (and (in-job?) (> (len xs) 0))
        (panic "the setting {} is given to one of several jobs done at once, and this run keeps {} answers made from it"
               setting
               (len xs)))
      (unless (in-job?) (for forget xs (forget)))))
  0)

;;; Whether threads are running work at once now (`run-workers`).
(defn in-parallel? [] (-> bool)
  (.running (pool)))

;;; Whether this thread is doing one of a run of jobs done at once. A setting given by `with`
;;; meanwhile is given to this thread's job alone (see `settings-own-enter!` in a rules module).
(defn in-job? :inline (Always) [] (-> bool)
  (> (.in-job (thread-regions)) 0))

;;; The worker slot whose own settings this thread reads where it has none of its own: the
;;; thread it is helping; -1 while it helps no one.
(defn settings-view :inline (Always) [] (-> i64)
  (- (.settings-view (thread-regions)) 1))

;;; A job's own copy of a module's state, `size` bytes as they are at `from`, and its end.
(defn own-state-new [(from (ptr u8)) (size i64)] (-> i64)
  (let [p (malloc (primitive/cast isize size))]
    (when (= (primitive/cast i64 p) 0) (panic "no memory for a job's own settings"))
    (mem/copy [u8] (primitive/cast (ptr u8) p) from size)
    (primitive/cast i64 p)))

(defn own-state-free! [(p i64)] (-> void)
  (primitive/free (primitive/cast (ptr i8) p))
  0)

;;; How many threads work whose jobs each give settings of their own may use: one, while what
;;; answers were made from is tracked, since an answer kept there says nothing of which job's
;;; settings it was made under.
(defn own-threads [(n i64)] (-> i64)
  (if (dep-tracking?) 1 n))

;; ---------------------------------------------------------------- a run's plan

;;; How many threads each stage of the program's pipeline works on this run, by the stage's number
;;; (see `plan` in the pipeline language). The rules say nothing of threads: where they make a
;;; list of a stage's function's answers, the list is made on that stage's threads. Until a run
;;; chooses a plan, every stage works on one.
(defstruct Stages [(threads (ArrayList i64))])

(defn stages-state [] (-> (ptr Stages))
  (primitive/alloc-static Stages))

(defn stage-threads! [(stage i64) (n i64)] (-> void)
  (let [s (stages-state)]
    (when (.running (pool))
      (panic "a run's plan is chosen before any work runs on many threads"))
    (when (= (cap (.threads s)) 0)
      (set! (.threads s) (ArrayList::new [i64] (malloc-allocator))))
    (while (<= (len (.threads s)) stage) (push! (mut (.threads s)) 1))
    (set! (mut (.threads s)) stage (if (< n 1) 1 n))
    0))

(defn stage-threads [(stage i64)] (-> i64)
  (let [s (stages-state)]
    (if (< stage (len (.threads s))) (get (.threads s) stage) 1)))

;;; The sizes the rules cut work by (`size` in the pipeline language), by each one's number: what
;;; the pipeline file gives, unless the run's plan, or the run itself, gives another
;;; (`size-given!`). A size is read once, when its module's constants are made, so it is given
;;; before then or not at all: giving one that was read already stops the program.
(defstruct Sizes [(given (ArrayList i64)) (read (ArrayList bool))])

(defn sizes-state [] (-> (ptr Sizes))
  (let [s (primitive/alloc-static Sizes)]
    (when (= (cap (.given s)) 0)
      (set! (.given s) (ArrayList::new [i64] (malloc-allocator)))
      (set! (.read s) (ArrayList::new [bool] (malloc-allocator)))
      (reserve! (mut (.given s)) 64)
      (reserve! (mut (.read s)) 64))
    s))

(defn size-given! [(index i64) (n i64)] (-> void)
  (let [s (sizes-state)]
    (while (<= (len (.given s)) index)
      (push! (mut (.given s)) -1)
      (push! (mut (.read s)) false))
    (when (get (.read s) index)
      (panic "a size was given after the rules had read it: sizes are given before a build starts"))
    (set! (mut (.given s)) index n)
    0))

(defn size [(index i64) (otherwise i64)] (-> i64)
  (let [s (sizes-state)]
    (while (<= (len (.given s)) index)
      (push! (mut (.given s)) -1)
      (push! (mut (.read s)) false))
    (set! (mut (.read s)) index true)
    (let [n (get (.given s) index)]
      (if (< n 0) otherwise n))))

;;; Whether a stage's work goes undivided (`alone F is G` in the pipeline language): when the
;;; stage works on one thread. The two ways give one answer, which is a claim to check: with
;;; HL_ALONE=always the undivided way answers whatever the threads, with HL_ALONE=never the
;;; divided one does, and what a build makes must be the same.
(defstruct AloneChoice [(seen i64)])

(defn alone? [(stage i64)] (-> bool)
  (let [c (primitive/alloc-static AloneChoice)]
    (when (= (.seen c) 0)
      (set! (.seen c)
            (cond (env-is? "HL_ALONE" "always") 2
                  (env-is? "HL_ALONE" "never") 3
                  :else 1)))
    (cond (= (.seen c) 2) true
          (= (.seen c) 3) false
          :else (<= (stage-threads stage) 1))))

;; ---------------------------------------------------------------- which functions a run keeps

;;; The strategy a run uses (see `strategy` in the pipeline language): for each function some
;;; strategy keeps, by its number, whether this run keeps it. Until a run chooses, each function
;;; is kept as the default strategy says, which its code knows.
(defstruct Kept
  [(chosen bool)
   (on (ArrayList bool))
   ;; How each is kept (see `mechanism` in the pipeline language): saved with the cache, and which
   ;; of its `store … by` functions says which answers are (-1: none, all are); how a kept answer is
   ;; checked (0 what it read, 1 that no input changed, 2 never, 3 + i by its i-th `check by`
   ;; function); when an answer made again counts as the one it replaces (0 never, 1 when equal,
   ;; 2 + i when its i-th `cutoff by` function says); at most how many answers (0: no bound); which
   ;; of its `evict by` functions lets answers go after each build (-1: none).
   (disk (ArrayList bool))
   (store-by (ArrayList i64))
   (check (ArrayList i64))
   (cutoff (ArrayList i64))
   (evict (ArrayList i64))
   (evict-by (ArrayList i64))
   ;; Which of its `update by` functions makes its answers from the last one (-1: none).
   (update-by (ArrayList i64))
   ;; Each kept function's sweep (`evict by`), by its name, once its answers are first kept.
   (sweeps (HashMap (slice u8) (fnptr (cc/C) [] i64)))
   (sweeps-ready bool)
   ;; How many builds have ended (each sweeps once).
   (swept i64)])

(defn kept-state [] (-> (ptr Kept))
  (primitive/alloc-static Kept))

(defn keep-only! [(count i64) (on (ArrayList i64))] (-> void)
  (let [s (kept-state)
        (mut flags) (ArrayList::new [bool] (malloc-allocator))]
    (when (.running (pool))
      (panic "a run's strategy is chosen before any work runs on many threads"))
    (for _ (range 0 count) (push! (mut flags) false))
    (for i on (set! (mut flags) i true))
    (set! (.on s) flags)
    (let [(mut disk) (ArrayList::new [bool] (malloc-allocator))
          (mut store-by) (ArrayList::new [i64] (malloc-allocator))
          (mut check) (ArrayList::new [i64] (malloc-allocator))
          (mut cutoff) (ArrayList::new [i64] (malloc-allocator))
          (mut evict) (ArrayList::new [i64] (malloc-allocator))
          (mut evict-by) (ArrayList::new [i64] (malloc-allocator))
          (mut update-by) (ArrayList::new [i64] (malloc-allocator))]
      (for _ (range 0 count)
        (push! (mut update-by) -1)
        (push! (mut disk) true)
        (push! (mut store-by) -1)
        (push! (mut check) 0)
        (push! (mut cutoff) 1)
        (push! (mut evict) 0)
        (push! (mut evict-by) -1))
      (set! (.disk s) disk)
      (set! (.store-by s) store-by)
      (set! (.check s) check)
      (set! (.cutoff s) cutoff)
      (set! (.evict s) evict)
      (set! (.evict-by s) evict-by)
      (set! (.update-by s) update-by))
    (set! (.chosen s) true)
    0))

;;; How function `index` is kept this run, as its strategy's mechanism for it says.
(defn keep-policy! [(index i64)
                    (disk bool)
                    (store-by i64)
                    (check i64)
                    (cutoff i64)
                    (evict i64)
                    (evict-by i64)
                    (update-by i64)] (-> void)
  (let [s (kept-state)]
    (set! (mut (.disk s)) index disk)
    (set! (mut (.store-by s)) index store-by)
    (set! (mut (.check s)) index check)
    (set! (mut (.cutoff s)) index cutoff)
    (set! (mut (.evict s)) index evict)
    (set! (mut (.evict-by s)) index evict-by)
    (set! (mut (.update-by s)) index update-by)
    0))

;;; Until a run chooses, every function is kept as the mechanism of old: saved, checked by what it
;;; read, an answer made again the same changing nothing, no bound.
(defn kept-disk? [(index i64)] (-> bool)
  (let [s (kept-state)] (if (.chosen s) (get (.disk s) index) true)))

(defn kept-check [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.check s) index) 0)))

(defn kept-store-by [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.store-by s) index) -1)))

(defn kept-cutoff [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.cutoff s) index) 1)))

(defn kept-evict [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.evict s) index) 0)))

(defn kept-evict-by [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.evict-by s) index) -1)))

(defn kept-update-by [(index i64)] (-> i64)
  (let [s (kept-state)] (if (.chosen s) (get (.update-by s) index) -1)))

;;; A strategy's functions (`… by F` in the pipeline language), by `module/function`: each as the bits
;;; of its function value, registered by its module when a run picks its strategy, so the code it
;;; serves calls it without importing its module (which may read anything the program has).
(defstruct Hooks [(lock i64) (ready bool) (by (HashMap (slice u8) i64))])

(defn hooks [] (-> (ptr Hooks))
  (let [h (primitive/alloc-static Hooks)]
    (unless (.ready h)
      (init-lock!)
      (unless (.ready h)
        (set! (.by h)
              (HashMap::new [(slice u8) i64] (malloc-allocator) (text-keyops)))
        (set! (.ready h) true))
      (init-unlock!))
    h))

(defn hook-register! [(name (slice u8)) (bits i64)] (-> void)
  (let [h (hooks)]
    (spin-lock! (cast (ptr i64) h))
    (set! (mut (.by h)) name bits)
    (spin-unlock! (cast (ptr i64) h))
    0))

;;; Function `name`'s value, its bits in `cell` (a call site's own) from the first call on.
(defn hook-cell [(name (slice u8)) (cell (ptr i64))] (-> (ptr i64))
  (when (= (atomic/read cell) 0)
    (let [h (hooks)]
      (spin-lock! (cast (ptr i64) h))
      (let [found (get (.by h) name)]
        (spin-unlock! (cast (ptr i64) h))
        (match found
          (Some [bits] (atomic/store cell bits))
          (None []
                (panic "the strategy's function {} was never registered: its module's register-hooks! did not run"
                       name))))))
  cell)

;;; Kept function `name` can let answers go after a build (`evict by`): `f` does it.
(defn sweeper! [(name (slice u8)) (f (fnptr (cc/C) [] i64))] (-> void)
  (let [s (kept-state)]
    (init-lock!)
    (unless (.sweeps-ready s)
      (set! (.sweeps s)
            (HashMap::new [(slice u8) (fnptr (cc/C) [] i64)]
                          (malloc-allocator)
                          (text-keyops)))
      (set! (.sweeps-ready s) true))
    (set! (mut (.sweeps s)) name f)
    (init-unlock!))
  0)

;;; After a build, with nothing running: each kept function's answers its `evict by` function says
;;; to let go, let go; then the next build begins.
(defn sweep-kept! [] (-> void)
  (let [s (kept-state)]
    (when (.sweeps-ready s)
      (for name (.sweeps s)
        (match (get (.sweeps s) name)
          (Some [f] (f))
          (None [] 0))))
    (set! (.swept s) (+ (.swept s) 1)))
  0)

;;; How many builds have ended: the number of the one running.
(defn builds-swept [] (-> i64)
  (.swept (kept-state)))

;; ---------------------------------------------------------------- inputs a run trusts

;;; Paths a run's strategy trusts (read as they are, never what an answer is made from) and those it
;;; compares by what they hold, never by size and time (see `trust` and `recheck` in the pipeline
;;; language): patterns with `*` within a directory, `**` across directories.
(defstruct InputPolicy
  [(trust (ArrayList (slice u8))) (recheck (ArrayList (slice u8)))])

(defn input-policy [] (-> (ptr InputPolicy))
  (primitive/alloc-static InputPolicy))

(defn trust-paths! [(patterns (ArrayList (slice u8)))] (-> void)
  (set! (.trust (input-policy)) patterns)
  0)

(defn recheck-paths! [(patterns (ArrayList (slice u8)))] (-> void)
  (set! (.recheck (input-policy)) patterns)
  0)

(defn matches-any? [(patterns (ArrayList (slice u8))) (path (slice u8))]
  (-> bool)
  (let [(mut hit) false]
    (for p patterns (when (glob-match? p path) (set! hit true)))
    hit))

(defn trusted-path? [(path (slice u8))] (-> bool)
  (matches-any? (.trust (input-policy)) path))

(defn rechecked-path? [(path (slice u8))] (-> bool)
  (matches-any? (.recheck (input-policy)) path))

;;; Whether `path` matches `pattern`: `**` any run of characters, `*` any run without a `/`, `?`
;;; one character but `/`, anything else itself.
(defn glob-match? [(pattern (slice u8)) (path (slice u8))] (-> bool)
  (glob-from? pattern 0 path 0))

(defn glob-from? [(p (slice u8)) (i i64) (s (slice u8)) (j i64)] (-> bool)
  (cond (= i (len p)) (= j (len s))
        (and (= (get p i) #\*) (< (+ i 1) (len p)) (= (get p (+ i 1)) #\*))
          ;; `**/` also matches nothing at all.
          (let [next
                  (if (and (< (+ i 2) (len p)) (= (get p (+ i 2)) #\/))
                      (+ i 3)
                      (+ i 2))
                (mut k) j
                (mut hit) false]
            (when (and (> next (+ i 2)) (glob-from? p next s j))
              (set! hit true))
            (while (and (not hit) (<= k (len s)))
              (when (glob-from? p (+ i 2) s k) (set! hit true))
              (set! k (+ k 1)))
            hit)
        (= (get p i) #\*)
          (let [(mut k) j
                (mut hit) false
                (mut going) true]
            (while (and going (not hit) (<= k (len s)))
              (when (glob-from? p (+ i 1) s k) (set! hit true))
              (if (and (< k (len s)) (!= (get s k) #\/))
                  (set! k (+ k 1))
                  (set! going false)))
            hit)
        (= j (len s)) false
        (= (get p i) #\?)
          (and (!= (get s j) #\/) (glob-from? p (+ i 1) s (+ j 1)))
        :else (and (= (get p i) (get s j)) (glob-from? p (+ i 1) s (+ j 1)))))

(defn kept? [(index i64) (default bool)] (-> bool)
  (let [s (kept-state)]
    (if (.chosen s) (get (.on s) index) default)))

;; ---------------------------------------------------------------- the memo audit

;;; With HL_MEMO_AUDIT set, each function some strategy keeps but this run does not counts its
;;; calls by their arguments, and the time they took: a function called again and again with the
;;; same arguments, at a cost, is one this run's strategy should keep. Reported at the end
;;; (`memo-audit-report!`).
(defstruct AuditRow
  [(calls i64)
   (repeats i64)
   (us i64)
   (repeat-us i64)
   (keys (HashMap (slice u8) i64))])

;; (`us` and `repeat-us` are nanoseconds for an audited plain function's calls; see `audit-call-ns!`.)

(defstruct Audit
  [(lock i64)
   (known i64)
   (on i64)
   (names (ArrayList (slice u8)))
   (rows (HashMap (slice u8) AuditRow))])

(defn audit-state [] (-> (ptr Audit))
  (let [a (primitive/alloc-static Audit)]
    (when (= (.known a) 0)
      (init-lock!)
      (when (= (.known a) 0)
        (set! (.on a)
              (if (= (primitive/cast i64
                                     (os/getenv (str/to-cstr (malloc-allocator)
                                                             "HL_MEMO_AUDIT")))
                     0)
                  0
                  1))
        (set! (.names a) (ArrayList::new [(slice u8)] (malloc-allocator)))
        (set! (.rows a)
              (HashMap::new [(slice u8) AuditRow]
                            (malloc-allocator)
                            (text-keyops)))
        (set! (.known a) 1))
      (init-unlock!))
    a))

(defn auditing? [] (-> bool)
  (= (.on (audit-state)) 1))

;;; A call of an audited plain function: its own time in nanoseconds, the audit's left out; kept
;;; in the row as microseconds' worth, to the nearest.
(defn audit-call-ns! [(name (slice u8)) (key (slice u8)) (ns i64)] (-> void)
  (audit-call! name key (/ (+ ns 500) 1000))
  0)

(defn audit-call! [(name (slice u8)) (key (slice u8)) (us i64)] (-> void)
  (let [a (audit-state)]
    (spin-lock! (cast (ptr i64) a))
    (let [(mut row)
            (match (get (.rows a) name)
              (Some [r] r)
              (None []
                    (do
                      (push! (mut (.names a)) name)
                      (AuditRow
                        :calls 0
                        :repeats 0
                        :us 0
                        :repeat-us 0
                        :keys
                          (HashMap::new [(slice u8) i64]
                                        (malloc-allocator)
                                        (text-keyops))))))
          seen (match (get (.keys row) key) (Some [n] n) (None [] 0))]
      (set! (.calls row) (+ (.calls row) 1))
      (set! (.us row) (+ (.us row) us))
      (when (> seen 0)
        (set! (.repeats row) (+ (.repeats row) 1))
        (set! (.repeat-us row) (+ (.repeat-us row) us)))
      (set! (mut (.keys row)) key (+ seen 1))
      (set! (mut (.rows a)) name row))
    (spin-unlock! (cast (ptr i64) a)))
  0)

(defn audit-spent [(a (ptr Audit)) (i i64)] (-> i64)
  (match (get (.rows a) (get (.names a) i))
    (Some [r] (.repeat-us r))
    (None [] 0)))

;;; What the audit saw, most time spent on repeats first: each function, its calls, how many had
;;; arguments seen before, and the time those took (counting what they called).
(defn lock-trace-report! [] (-> void)
  (when (env-on? "HL_LOCK_TRACE")
    (eprintln "[locks] gave a core away {} times for a lock taken whole, {} to read beside others, {} for an answer being made"
              (atomic/read (field (yields) whole))
              (atomic/read (field (yields) beside))
              (atomic/read (field (yields) answer))))
  0)

(defn memo-audit-report! [] (-> void)
  (lock-trace-report!)
  (when (auditing?)
    (let [a (audit-state)
          (mut order) (ArrayList::new [i64] (malloc-allocator))]
      ;; Most time in repeats first.
      (for i (range 0 (len (.names a)))
        (push! (mut order) i)
        (let [(mut j) i]
          (while (and (> j 0)
                      (> (audit-spent a (get order j))
                         (audit-spent a (get order (- j 1)))))
            (let [t (get order j)]
              (set! (mut order) j (get order (- j 1)))
              (set! (mut order) (- j 1) t))
            (set! j (- j 1)))))
      (eprintln "[audit] function: calls, repeated (same arguments), time in repeats ms, time in all ms")
      (for i order
        (let [n (get (.names a) i)]
          (match (get (.rows a) n)
            (Some [r]
                  (eprintln "[audit] {}: {}, {}, {}.{}, {}.{}"
                            n
                            (.calls r)
                            (.repeats r)
                            (/ (.repeat-us r) 1000)
                            (/ (% (.repeat-us r) 1000) 100)
                            (/ (.us r) 1000)
                            (/ (% (.us r) 1000) 100)))
            (None [] 0))))))
  0)

;; ---------------------------------------------------------------- the process's counters

;;; The instructions and cycles the process has retired, all threads, where the system counts them
;;; (proc_pid_rusage's RUSAGE_INFO_V4, macOS); -1 elsewhere. What a build did, apart from how fast
;;; the CPU did it.
(defn rusage-v4-at [(offset i64)] (-> i64)
  (let [f
          (os/dlsym-cached (primitive/alloc-static (ptr i8))
                           c"proc_pid_rusage"
                           (rtld-default))]
    (if (= (primitive/cast i64 f) 0)
        -1
        (let [buf (primitive/alloc-stack (array u8 512))
              at (primitive/cast (ptr i8) buf)
              pid (primitive/cast i32 (os/getpid))]
          ;; RUSAGE_INFO_V4
          (if (= (primitive/call-ptr (primitive/cast (fnptr (cc/C)
                                                            [i32 i32 (ptr i8)]
                                                            i32)
                                                     f)
                                     pid
                                     (: 4 i32)
                                     at)
                 (: 0 i32))
              (load (primitive/cast (ptr i64) (primitive/index at offset)))
              -1)))))

(defn instructions-retired [] (-> i64)
  (rusage-v4-at 248))

(defn cycles-elapsed [] (-> i64)
  (rusage-v4-at 256))

;;; The process's resource use so far (getrusage): time on the CPU in user code and in the kernel,
;;; in microseconds; page faults; and how often a thread gave up the CPU, waiting, and was made to.
(defn usage-now [] (-> Usage)
  (let [(mut u) (primitive/zeroed Usage)]
    (getrusage (: 0 i32) (cast (ptr i8) (mut u)))
    u))

(defn cpu-user-us [] (-> i64)
  (let [u (usage-now)] (+ (* (.utime-s u) 1000000) (.utime-us u))))

(defn cpu-system-us [] (-> i64)
  (let [u (usage-now)] (+ (* (.stime-s u) 1000000) (.stime-us u))))

(defn page-faults [] (-> i64)
  (let [u (usage-now)] (+ (.r8 u) (.r9 u))))

(defn switches-waiting [] (-> i64)
  (.r16 (usage-now)))

(defn switches-forced [] (-> i64)
  (.r17 (usage-now)))

;; ---------------------------------------------------------------- versions of answers

;;; What a `check by` function gave for an answer when it was made, by the answer's node (see
;;; `check by` in the pipeline language): kept with the cache's index, so it is there to compare
;;; with before the answer itself is read.
(defstruct Versions [(lock i64) (ready bool) (by (HashMap i64 (slice u8)))])

(defn versions [] (-> (ptr Versions))
  (let [v (primitive/alloc-static Versions)]
    (unless (.ready v)
      (init-lock!)
      (unless (.ready v)
        (set! (.by v)
              (HashMap::new [i64 (slice u8)] (malloc-allocator) (i64-keyops)))
        (set! (.ready v) true))
      (init-unlock!))
    v))

(defn version-of [(id i64)] (-> (slice u8))
  (let [v (versions)]
    (spin-lock! (cast (ptr i64) v))
    (let [out (match (get (.by v) id) (Some [t] t) (None [] ""))]
      (spin-unlock! (cast (ptr i64) v))
      out)))

(defn version-set! [(id i64) (text (slice u8))] (-> void)
  (when (> (len text) 0)
    (let [v (versions)]
      (spin-lock! (cast (ptr i64) v))
      ;; Its own copy: the text is a value, of whatever region made it. The one it replaces let go.
      (match (get (.by v) id)
        (Some [old] (when (> (len old) 0) (free [u8] (malloc-allocator) old)))
        (None [] 0))
      (set! (mut (.by v)) id (own-text text))
      (spin-unlock! (cast (ptr i64) v))))
  0)
