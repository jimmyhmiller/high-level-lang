;;; Cross-language checking. A language that uses another's nodes generates a
;;; top-level macro calling this, passing the table the grammar published.
(module hl.check)
(import "coil.primitive" :as primitive)
(import "hl.dsl" :as dsl)

;;; `table` is ((NAME ARITY) …) from a .syntax module; ARITY -1 means any.
;;; `uses` is ((WHERE NAME ARITY) …).
(defn against [(table Code) (uses Code)] (-> Code)
  (for u uses
    (let [where (primitive/code-str (get u 0))
          name (primitive/code-str (get u 1))
          arity (primitive/code-int (get u 2))
          (mut found) false]
      (for entry table
        (when (= (primitive/code-str (get entry 0)) name)
          (set! found true)
          (let [want (primitive/code-int (get entry 1))]
            (when (and (>= want 0) (>= arity 0) (!= want arity))
              (primitive/error (dsl/join3 where
                                          ": wrong number of children for "
                                          (dsl/join3 name
                                                     ": the grammar gives it "
                                                     (dsl/join3 (primitive/int->str want)
                                                                ", this has "
                                                                (primitive/int->str arity)))))))))
      (unless found
        (primitive/error (dsl/join3 where
                                    ": the grammar has no node named "
                                    name)))))
  `(do))
