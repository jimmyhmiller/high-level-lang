;;; Symbol and scope tables. The `.scopes` language generates the walker that fills
;;; them; these tables know nothing about any grammar.
(module hl.symtab)
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap for-entries])
(import "coil.str" :as str)
(import "hl.rt" :as rt)
(import "coil.primitive" :as primitive)
(import "coil.control" :use [return-from])
(import "coil.math" :use [min])

;;; A map from names. Names are the program's own text, which is never changed, and lives in the
;;; region of the parse that read it, which any table made from it holds (see `rt/region-uses!`),
;;; so the map need not copy them. A table's own memory is the region it is made in.
(defn names-map [] (-> (HashMap (slice u8) i64))
  (HashMap::new [(slice u8) i64] (rt/value-allocator) (str/keyops-borrowed)))

(defstruct Symbol
  [(name (slice u8))
   (scope i64)
   (uses i64)
   (final (slice u8))
   (pinned bool)])

(defstruct Scope
  [(parent i64)
   (names (HashMap (slice u8) i64))
   (symbols (ArrayList i64))
   (children (ArrayList i64))
   (dynamic bool)
   ;; The symbols of scopes around it that code in it, or in a scope inside it, refers to: what a
   ;; name of its own must not hide (see `enclose!`).
   (enclosed (ArrayList i64))])

;;; A module's own table at its place among the build's (see `placed`): scope i of the part as the
;;; joined table numbers it, `scope-start` + i - 1, and its symbol s as `symbol-start` + s, each
;;; already saying so. The part's scope 0 stands for the joined table's, which holds `roots`, the
;;; part's top scopes; `dynamic` when code can reach the part's top level by name at run time.
(defstruct Block
  [(scopes (ArrayList Scope))
   (symbols (ArrayList Symbol))
   (scope-start i64)
   (symbol-start i64)
   (roots (ArrayList i64))
   (dynamic bool)])

;;; A table joined from blocks (see `joined-from`), which it shares and never copies: the blocks by
;;; where their scopes start, and their indices by where their symbols start; the symbols linking
;;; makes, laid over them, and which scopes each is in when that is a block's; and how many scopes
;;; and symbols it numbers. Its own scope 0 is the one all the blocks' top scopes are in.
(defstruct Joined
  [(blocks (ArrayList Block))
   (by-symbol (ArrayList i64))
   (made (HashMap i64 Symbol))
   (extra (HashMap i64 (ArrayList i64)))
   (scopes i64)
   (symbols i64)
   ;; Where to start looking for an id, a page of 16 ids at a time: the block (by `blocks` for
   ;; scopes, by `by-symbol` for symbols) last to start at or before the page; and which blocks
   ;; hold scopes linking made symbols in.
   (scope-pages (ArrayList i64))
   (symbol-pages (ArrayList i64))
   (extra-in (ArrayList bool))])

(defstruct Table
  [(scopes (ArrayList Scope))
   (symbols (ArrayList Symbol))
   (free (HashMap (slice u8) i64))
   ;; In a table under another (see `table-under`): uses of that table's symbols, by symbol.
   (outer (HashMap i64 i64))
   (joined (Option Joined))])

;;; A tree's scope analysis as a value: the table it filled, its root scope, which symbol each
;;; name means by the name's offset, and the names no scope declares.
(defstruct Analysis
  [(table Table)
   (root i64)
   (bindings (HashMap i64 i64))
   (free (ArrayList (slice u8)))])

(defn table-new [] (-> Table)
  (Table
    :scopes (ArrayList::new [Scope] (rt/value-allocator))
    :symbols (ArrayList::new [Symbol] (rt/value-allocator))
    :free (names-map)
    :outer (HashMap::new-scalar [i64 i64] (rt/value-allocator))
    :joined (None [Joined])))

;;; A table of its own for code inside `scope` of `t`: its scope 0 stands for that scope, and
;;; its names are the symbols of `t` that scope can see, its own and those of the scopes around it,
;;; as -(id + 1). Code in it can be analysed while other code is, and `graft!` puts it back.
(defn table-under [(t Table) (scope i64)] (-> Table)
  (own-table! t "table-under")
  (let [(mut out) (table-new)
        sc (get (.scopes t) scope)
        (mut names) (names-map)
        (mut at) scope]
    ;; The nearest declaration of a name wins.
    (while (>= at 0)
      (let [(mut src) (.names (get (.scopes t) at))]
        (for-entries [k v (mut src)]
                     (match (get names (load k))
                       (Some [_] 0)
                       (None [] (set! (mut names) (load k) (- -1 (load v)))))))
      (set! at (.parent (get (.scopes t) at))))
    (push! (mut (.scopes out))
           (Scope
             :parent -1
             :names names
             :symbols (ArrayList::new [i64] (rt/value-allocator))
             :children (ArrayList::new [i64] (rt/value-allocator))
             :dynamic false
             :enclosed (ArrayList::new [i64] (rt/value-allocator))))
    out))

;;; A copy that changes apart from `t`.
(defn table-copy [(t Table)] (-> Table)
  (own-table! t "table-copy")
  (let [(mut out) (table-new)]
    (for sc (.scopes t)
      (let [(mut names) (names-map)
            (mut symbols) (ArrayList::new [i64] (rt/value-allocator))
            (mut children) (ArrayList::new [i64] (rt/value-allocator))]
        (let [(mut src) (.names sc)]
          (for-entries [k v (mut src)] (set! (mut names) (load k) (load v))))
        (for s (.symbols sc) (push! (mut symbols) s))
        (for c (.children sc) (push! (mut children) c))
        (push! (mut (.scopes out))
               (Scope
                 :parent (.parent sc)
                 :names names
                 :symbols symbols
                 :children children
                 :dynamic (.dynamic sc)
                 :enclosed (ints-copy (.enclosed sc))))))
    (for sym (.symbols t) (push! (mut (.symbols out)) sym))
    (for k (.free t)
      (match (get (.free t) k)
        (Some [n] (set! (mut (.free out)) k n))
        (None [] 0)))
    out))

(defn new-scope! [(t (mut Table)) (parent i64)] (-> i64)
  (own-table! t "new-scope!")
  (let [id (len (.scopes t))]
    (push! (mut (.scopes t))
           (Scope
             :parent parent
             :names (names-map)
             :symbols (ArrayList::new [i64] (rt/value-allocator))
             :children (ArrayList::new [i64] (rt/value-allocator))
             :dynamic false
             :enclosed (ArrayList::new [i64] (rt/value-allocator))))
    (when (>= parent 0)
      (push! (mut (.children (elem (mut (.scopes t)) parent))) id))
    id))

;;; Declare `name` in `scope`, or answer the symbol it already has there.
(defn declare! [(t (mut Table)) (scope i64) (name (slice u8))] (-> i64)
  (own-table! t "declare!")
  (match (get (.names (get (.scopes t) scope)) name)
    (Some [s] s)
    (None []
          (let [id (len (.symbols t))]
            (push! (mut (.symbols t))
                   (Symbol
                     :name name
                     :scope scope
                     :uses 0
                     :final name
                     :pinned false))
            (set! (mut (.names (elem (mut (.scopes t)) scope))) name id)
            (push! (mut (.symbols (elem (mut (.scopes t)) scope))) id)
            id))))

;;; A symbol with no name in any scope's map: only the program refers to it.
(defn generated-symbol! [(t (mut Table)) (scope i64) (name (slice u8))] (-> i64)
  (own-table! t "generated-symbol!")
  (let [id (len (.symbols t))]
    (push! (mut (.symbols t))
           (Symbol
             :name name
             :scope scope
             :uses 0
             :final name
             :pinned false))
    (push! (mut (.symbols (elem (mut (.scopes t)) scope))) id)
    id))

(defn resolve [(t (mut Table)) (scope i64) (name (slice u8))] (-> (Option i64))
  (let [(mut at) scope
        (mut out) (None [i64])]
    (while (>= at 0)
      (let [sc (get (.scopes t) at)]
        (match (get (.names sc) name)
          (Some [s] (set! out (Some s)) (set! at -1))
          (None [] (set! at (.parent sc))))))
    out))

;;; Code in `scope` refers to `s`: every scope from there out to the one declaring it encloses it,
;;; so a name given in any of them cannot hide it. A symbol of a table around this one (as -(id + 1))
;;; is declared somewhere in or around the scope 0 stands for: scope 0 keeps it too, and grafting
;;; carries on from the scope it stood for (see `graft!`). Each scope keeps a symbol once in a run
;;; of references to it; a later reference after others may list it again.
(defn enclose! [(t (mut Table)) (scope i64) (s i64)] (-> void)
  (let [declared (if (< s 0) -1 (.scope (get (.symbols t) s)))
        (mut at) scope]
    (while (and (>= at 0) (!= at declared))
      (let [sc (get (.scopes t) at)
            n (len (.enclosed sc))]
        (if (and (> n 0) (= (get (.enclosed sc) (- n 1)) s))
            (set! at -1)
            (do
              (push! (mut (.enclosed (elem (mut (.scopes t)) at))) s)
              (set! at (.parent sc))))))
    0))

;;; Each scope's enclosed symbols, each once: what a table keeps once its program is walked, as a walk
;;; lists a symbol again for each run of references to it.
(defn dedupe-enclosed! [(t (mut Table))] (-> void)
  (for at (range 0 (len (.scopes t)))
    (let [xs (.enclosed (get (.scopes t) at))]
      (when (> (len xs) 1)
        (let [order (rt/sort-order-int xs false)
              (mut out) (ArrayList::new [i64] (rt/value-allocator))]
          (for i order
            (let [x (get xs i)]
              (when (or (= (len out) 0) (!= (get out (- (len out) 1)) x))
                (push! (mut out) x))))
          (let [(mut sc) (get (.scopes t) at)]
            (set! (.enclosed sc) out)
            (set! (mut (.scopes t)) at sc))))))
  0)

;;; Every scope from `first` on (those made inside one node) encloses `symbols`: none may hide them.
(defn enclose-from! [(t (mut Table)) (first i64) (symbols (ArrayList i64))] (-> void)
  (for at (range first (len (.scopes t)))
    (for s symbols
      (push! (mut (.enclosed (elem (mut (.scopes t)) at))) s)))
  0)

;;; A scope directly inside `scope` may not give the names of `scope`'s symbols to its own: each
;;; encloses them, as if it referred to them.
(defn enclose-children! [(t (mut Table)) (scope i64)] (-> void)
  (let [sc (get (.scopes t) scope)]
    (for c (.children sc)
      (for s (.symbols sc)
        (push! (mut (.enclosed (elem (mut (.scopes t)) c))) s))))
  0)

;;; Symbol ids of one table as another numbers them: its own moved by `shift`, and one of the table
;;; around it, -(id + 1), as that table's id.
(defn shifted-symbols [(xs (ArrayList i64)) (shift i64)] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (rt/value-allocator))]
    (reserve! (mut out) (len xs))
    (for x xs (push! (mut out) (if (< x 0) (- -1 x) (+ x shift))))
    out))

(defn ints-copy [(xs (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (rt/value-allocator))]
    (reserve! (mut out) (len xs))
    (for x xs (push! (mut out) x))
    out))

(defn add-use! [(t (mut Table)) (s i64)] (-> void)
  (if (< s 0)
      (let [o (- -1 s)]
        (set! (mut (.outer t))
              o
              (+ (match (get (.outer t) o) (Some [n] n) (None [] 0)) 1)))
      (let [(mut sym) (get (.symbols t) s)]
        (set! (.uses sym) (+ (.uses sym) 1))
        (set! (mut (.symbols t)) s sym))))

(defn add-free! [(t (mut Table)) (name (slice u8))] (-> void)
  (match (get (.free t) name)
    (Some [n] (set! (mut (.free t)) name (+ n 1)))
    (None [] (set! (mut (.free t)) name 1))))

;;; A scope code can see by name at run time (direct eval, `with`) keeps its names,
;;; and so does every scope around it.
(defn mark-dynamic! [(t (mut Table)) (scope i64)] (-> void)
  (let [(mut at) scope]
    (while (>= at 0)
      (let [(mut sc) (get (.scopes t) at)]
        (set! (.dynamic sc) true)
        (set! (mut (.scopes t)) at sc)
        (set! at (.parent sc))))))

;;; Move what one file's own table holds into this one, under `parent`. In `from`, scope 0 stood
;;; for `parent`, and nothing was declared in it. Answers how far `from`'s scope ids moved; its
;;; symbol ids moved by `symbol-count` as it was before.
(defn graft! [(t (mut Table)) (from Table) (parent i64)] (-> i64)
  (own-table! t "graft!")
  (let [scope-shift (- (len (.scopes t)) 1)
        symbol-shift (len (.symbols t))]
    (for i (range 1 (len (.scopes from)))
      (let [sc (get (.scopes from) i)
            (mut names) (names-map)
            (mut symbols) (ArrayList::new [i64] (rt/value-allocator))
            (mut children) (ArrayList::new [i64] (rt/value-allocator))]
        (let [(mut src) (.names sc)]
          (for-entries [k v (mut src)]
                       (set! (mut names) (load k) (+ (load v) symbol-shift))))
        (for s (.symbols sc) (push! (mut symbols) (+ s symbol-shift)))
        (for c (.children sc) (push! (mut children) (+ c scope-shift)))
        (push! (mut (.scopes t))
               (Scope
                 :parent
                   (if (= (.parent sc) 0) parent (+ (.parent sc) scope-shift))
                 :names names
                 :symbols symbols
                 :children children
                 :dynamic (.dynamic sc)
                 ;; One of `t`'s own, as -(id + 1) in `from`, or one of `from`'s, moved.
                 :enclosed (shifted-symbols (.enclosed sc) symbol-shift)))))
    (for c (.children (get (.scopes from) 0))
      (push! (mut (.children (elem (mut (.scopes t)) parent)))
             (+ c scope-shift)))
    ;; What code of `from` refers to of `t`'s is enclosed from `parent` out to where it is declared.
    (for e (.enclosed (get (.scopes from) 0))
      (when (< e 0) (enclose! (mut t) parent (- -1 e))))
    (for sym (.symbols from)
      (push! (mut (.symbols t))
             (Symbol
               :name (.name sym)
               :scope
                 (if (= (.scope sym) 0) parent (+ (.scope sym) scope-shift))
               :uses (.uses sym)
               :final (.final sym)
               :pinned (.pinned sym))))
    (when (.dynamic (get (.scopes from) 0)) (mark-dynamic! (mut t) parent))
    ;; A table made by `table-under` also used `t`'s own symbols, and met names nobody declared.
    (for o (.outer from)
      (match (get (.outer from) o)
        (Some [n]
              (let [(mut sym) (get (.symbols t) o)]
                (set! (.uses sym) (+ (.uses sym) n))
                (set! (mut (.symbols t)) o sym)))
        (None [] 0)))
    (for name (.free from)
      (match (get (.free from) name)
        (Some [n]
              (set! (mut (.free t))
                    name
                    (+ (match (get (.free t) name) (Some [m] m) (None [] 0)) n)))
        (None [] 0)))
    scope-shift))

;; ---------------------------------------------------------------- what `.rules` calls

;;; A symbol, or an empty one for an id the table has no place for: asking another build's table,
;;; which may be smaller, is safe.
(defn symbol-at [(t Table) (s i64)] (-> Symbol)
  (match (.joined t)
    (Some [j] (joined-symbol-at j s))
    (None []
          (if (and (>= s 0) (< s (len (.symbols t))))
              (get (.symbols t) s)
              (no-symbol)))))

(defn no-symbol [] (-> Symbol)
  (Symbol
    :name ""
    :scope -1
    :uses 0
    :final ""
    :pinned false))

;;; A scope, or an empty one for an id the table has no place for.
(defn scope-at [(t Table) (s i64)] (-> Scope)
  (match (.joined t)
    (Some [j]
          (if (= s 0)
              (get (.scopes t) 0)
              (joined-scope-at j s)))
    (None []
          (if (and (>= s 0) (< s (len (.scopes t))))
              (get (.scopes t) s)
              (no-scope)))))

(defn no-scope [] (-> Scope)
  (Scope
    :parent -1
    :names (names-map)
    :symbols (ArrayList::new [i64] (rt/value-allocator))
    :children (ArrayList::new [i64] (rt/value-allocator))
    :dynamic false
    :enclosed (ArrayList::new [i64] (rt/value-allocator))))

(defn symbol-count [(t Table)] (-> i64)
  (match (.joined t)
    (Some [j] (.symbols j))
    (None [] (len (.symbols t)))))

;;; A table to change or copy: one of its own, not joined from blocks it shares.
(defn own-table! [(t Table) (what (slice u8))] (-> void)
  (match (.joined t)
    (Some [_]
          (panic "symtab: {} of a table joined from blocks, which it shares and may not change or copy"
                 what))
    (None [] 0)))

;;; Where tables of their own land when `joined` puts them in turn under one scope, 0: how far each
;;; one's scopes and symbols move, and how many symbols they hold in all. Known from their sizes,
;;; before they are joined.
(defstruct Layout
  [(scope-shifts (ArrayList i64)) (symbol-shifts (ArrayList i64)) (symbols i64)])

(defn layout [(parts (ArrayList Table))] (-> Layout)
  (let [(mut scopes) (ArrayList::new [i64] (rt/value-allocator))
        (mut symbols) (ArrayList::new [i64] (rt/value-allocator))
        (mut scopes-at) 0
        (mut symbols-at) 0]
    (for p parts
      (push! (mut scopes) scopes-at)
      (push! (mut symbols) symbols-at)
      (set! scopes-at (+ scopes-at (- (len (.scopes p)) 1)))
      (set! symbols-at (+ symbols-at (len (.symbols p)))))
    (Layout
      :scope-shifts scopes
      :symbol-shifts symbols
      :symbols symbols-at)))

;;; Tables of their own, grafted in turn into a new one under its one scope, 0, as
;;; `layout` says they land; then symbols no source names, one in each of `scopes`, called `names`.
(defn joined [(parts (ArrayList Table))
              (scopes (ArrayList i64))
              (names (ArrayList (slice u8)))] (-> Table)
  (let [(mut t) (table-new)]
    (new-scope! (mut t) -1)
    (for p parts (graft! (mut t) p 0))
    ;; Scope 0 is no code's: as in `joined-from`, a dynamic part keeps its own names, not these.
    (let [(mut top) (get (.scopes t) 0)]
      (set! (.dynamic top) false)
      (set! (mut (.scopes t)) 0 top))
    (for i (range 0 (len scopes))
      (generated-symbol! (mut t) (get scopes i) (get names i)))
    t))

;;; How many scopes a table has.
(defn scope-count [(t Table)] (-> i64)
  (match (.joined t)
    (Some [j] (.scopes j))
    (None [] (len (.scopes t)))))

;;; ---------------------------------------------------------------- tables joined from blocks

;;; `part`, a module's own table, at its place among the build's: its scopes from `scope-shift` + 1
;;; and its symbols from `symbol-shift`, each symbol named in the output as it is named here; made
;;; once for as long as the part and its place stay the same, and shared by every table joined from
;;; it after.
(defn placed [(part Table) (scope-shift i64) (symbol-shift i64)] (-> Block)
  (own-table! part "placed")
  (when (> (len (.outer part)) 0)
    (panic "symtab: a module's own table uses symbols of a table around it, which no block has"))
  (let [(mut scopes) (ArrayList::new [Scope] (rt/value-allocator))
        (mut symbols) (ArrayList::new [Symbol] (rt/value-allocator))
        (mut roots) (ArrayList::new [i64] (rt/value-allocator))]
    (for i (range 1 (len (.scopes part)))
      (let [sc (get (.scopes part) i)
            (mut names) (names-map)
            (mut syms) (ArrayList::new [i64] (rt/value-allocator))
            (mut children) (ArrayList::new [i64] (rt/value-allocator))]
        (let [(mut src) (.names sc)]
          (for-entries [k v (mut src)]
                       (set! (mut names) (load k) (+ (load v) symbol-shift))))
        (for s (.symbols sc) (push! (mut syms) (+ s symbol-shift)))
        (for c (.children sc) (push! (mut children) (+ c scope-shift)))
        (push! (mut scopes)
               (Scope
                 :parent (if (= (.parent sc) 0) 0 (+ (.parent sc) scope-shift))
                 :names names
                 :symbols syms
                 :children children
                 :dynamic (.dynamic sc)
                 :enclosed (shifted-symbols (.enclosed sc) symbol-shift)))))
    (for c (.children (get (.scopes part) 0)) (push! (mut roots) (+ c scope-shift)))
    (for sym (.symbols part)
      (push! (mut symbols)
             (Symbol
               :name (.name sym)
               :scope (if (= (.scope sym) 0) 0 (+ (.scope sym) scope-shift))
               :uses (.uses sym)
               ;; Named as it is until the output names it otherwise (see `renamed`).
               :final (.name sym)
               :pinned (.pinned sym))))
    (Block
      :scopes scopes
      :symbols symbols
      :scope-start (+ scope-shift 1)
      :symbol-start symbol-shift
      :roots roots
      :dynamic (.dynamic (get (.scopes part) 0)))))

;;; `joined-at`, from blocks `placed` made: a table of `scopes` scopes and `symbols` symbols that
;;; shares the blocks and copies none of them, then the symbols no source names at `ids`, each in
;;; `made-scopes[i]` and called `names[i]`. What it costs is how many blocks and made symbols there
;;; are, not how many scopes and symbols they hold.
(defn joined-from [(blocks (ArrayList Block))
                   (scopes i64)
                   (symbols i64)
                   (ids (ArrayList i64))
                   (made-scopes (ArrayList i64))
                   (names (ArrayList (slice u8)))] (-> Table)
  (let [(mut scope-starts) (ArrayList::new [i64] (rt/value-allocator))
        (mut symbol-starts) (ArrayList::new [i64] (rt/value-allocator))
        (mut children) (ArrayList::new [i64] (rt/value-allocator))
        (mut top) (ArrayList::new [i64] (rt/value-allocator))
        (mut made) (HashMap::new-scalar [i64 Symbol] (rt/value-allocator))
        (mut extra) (HashMap::new-scalar [i64 (ArrayList i64)] (rt/value-allocator))
        (mut total) symbols]
    (for b blocks
      (push! (mut scope-starts) (.scope-start b))
      (push! (mut symbol-starts) (.symbol-start b))
      (for c (.roots b) (push! (mut children) c)))
    (for id ids (when (>= id total) (set! total (+ id 1))))
    (for i (range 0 (len ids))
      (let [id (get ids i)
            scope (get made-scopes i)]
        (set! (mut made)
              id
              (Symbol
                :name (get names i)
                :scope scope
                :uses 0
                :final (get names i)
                :pinned false))
        (if (= scope 0)
            (push! (mut top) id)
            (let [(mut more)
                    (match (get extra scope)
                      (Some [xs] xs)
                      (None [] (ArrayList::new [i64] (rt/value-allocator))))]
              (push! (mut more) id)
              (set! (mut extra) scope more)))))
    (let [by-scope (rt/sort-order-int scope-starts false)
          (mut sorted) (ArrayList::new [Block] (rt/value-allocator))
          (mut starts) (ArrayList::new [i64] (rt/value-allocator))
          (mut own) (ArrayList::new [Scope] (rt/value-allocator))]
      (for i by-scope (push! (mut sorted) (get blocks i)))
      (for b sorted (push! (mut starts) (.symbol-start b)))
      (push! (mut own)
             (Scope
               :parent -1
               :names (names-map)
               :symbols top
               :children children
               ;; What it holds is linking's, named by no code: no direct eval or `with` in a
               ;; block can reach it by name, so a dynamic block keeps its own names, not these.
               :dynamic false
               :enclosed (ArrayList::new [i64] (rt/value-allocator))))
      (Table
        :scopes own
        :symbols (ArrayList::new [Symbol] (rt/value-allocator))
        :free (names-map)
        :outer (HashMap::new-scalar [i64 i64] (rt/value-allocator))
        :joined
          (Some (joined-of sorted (rt/sort-order-int starts false) made extra (+ scopes 1) total))))))

;;; A joined table's blocks and what is laid over them, with the pages that find a block for an id.
(defn joined-of [(blocks (ArrayList Block))
                 (by-symbol (ArrayList i64))
                 (made (HashMap i64 Symbol))
                 (extra (HashMap i64 (ArrayList i64)))
                 (scopes i64)
                 (symbols i64)] (-> Joined)
  (let [scope-pages (pages-of blocks (identity-order (len blocks)) true scopes)
        (mut extra-in) (ArrayList::new [bool] (rt/value-allocator))]
    (for _ blocks (push! (mut extra-in) false))
    (for s extra
      (let [at (block-at blocks (identity-order-view) scope-pages true s)]
        (when (>= at 0) (set! (mut extra-in) at true))))
    (Joined
      :blocks blocks
      :by-symbol by-symbol
      :made made
      :extra extra
      :scopes scopes
      :symbols symbols
      :scope-pages scope-pages
      :symbol-pages (pages-of blocks by-symbol false symbols)
      :extra-in extra-in)))

(defn page-size :inline (Always) [] (-> i64)
  16)

;;; For each page of ids up to `total`, the place in `order` of the last block that starts at or
;;; before it, or -1.
(defn pages-of [(blocks (ArrayList Block)) (order (ArrayList i64)) (scopes bool) (total i64)]
  (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (rt/value-allocator))
        (mut i) -1]
    (for p (range 0 (+ (/ total (page-size)) 1))
      (while (and (< (+ i 1) (len order))
                  (<= (block-start (get blocks (get order (+ i 1))) scopes) (* p (page-size))))
        (set! i (+ i 1)))
      (push! (mut out) i))
    out))

;;; An empty order, which `block-at` reads as each block in turn.
(defn identity-order-view [] (-> (ArrayList i64))
  (primitive/zeroed (ArrayList i64)))

;;; Which block holds id `s` (a scope's or a symbol's): its index in `blocks`, or -1. `order` gives
;;; the blocks by where they start (empty: as they are).
(defn block-at [(blocks (ArrayList Block)) (order (ArrayList i64)) (pages (ArrayList i64)) (scopes bool) (s i64)]
  (-> i64)
  (if (< s 0)
      -1
      (let [p (/ s (page-size))
            n (len blocks)
            (mut i) (if (< p (len pages)) (get pages p) (- n 1))
            (mut low) (+ i 1)
            (mut high) (if (< (+ p 1) (len pages))
                           (min n (+ (get pages (+ p 1)) 1))
                           n)]
        (when (< i 0) (set! i -1))
        ;; A page may contain hundreds of small blocks. Find the last start at or
        ;; before s by binary search, bounded by the next page's directory entry.
        (while (< low high)
          (let [middle (+ low (/ (- high low) 2))]
            (if (<= (block-start (get blocks (in-order order middle)) scopes) s)
                (do (set! i middle) (set! low (+ middle 1)))
                (set! high middle))))
        (if (and (>= i 0) (< s (block-end (get blocks (in-order order i)) scopes)))
            (in-order order i)
            -1))))

(defn in-order [(order (ArrayList i64)) (i i64)] (-> i64)
  (if (= (len order) 0) i (get order i)))

;;; A block's symbol, or else one linking made: no made symbol is in a block's places.
(defn joined-symbol-at [(j Joined) (s i64)] (-> Symbol)
  (let [at (block-at (.blocks j) (.by-symbol j) (.symbol-pages j) false s)]
    (if (>= at 0)
        (let [b (get (.blocks j) at)]
          (get (.symbols b) (- s (.symbol-start b))))
        (match (get (.made j) s)
          (Some [x] x)
          (None [] (no-symbol))))))

;;; A block's scope, with the symbols linking made in it after its own.
(defn joined-scope-at [(j Joined) (s i64)] (-> Scope)
  (let [at (block-at (.blocks j) (identity-order-view) (.scope-pages j) true s)]
    (if (< at 0)
        (no-scope)
        (let [b (get (.blocks j) at)
              sc (get (.scopes b) (- s (.scope-start b)))]
          (match (if (get (.extra-in j) at) (get (.extra j) s) (None [(ArrayList i64)]))
            (None [] sc)
            (Some [more]
                  (let [(mut syms) (ArrayList::new [i64] (rt/value-allocator))]
                    (for x (.symbols sc) (push! (mut syms) x))
                    (for x more (push! (mut syms) x))
                    (Scope
                      :parent (.parent sc)
                      :names (.names sc)
                      :symbols syms
                      :children (.children sc)
                      :dynamic (.dynamic sc)
                      :enclosed (.enclosed sc)))))))))

;;; Whether two blocks are the very same one, at the same place.
(defn same-block? [(a Block) (b Block)] (-> bool)
  (and (= (.scope-start a) (.scope-start b))
       (= (.symbol-start a) (.symbol-start b))
       (= (primitive/cast i64 (data (slice (.scopes a))))
          (primitive/cast i64 (data (slice (.scopes b)))))
       (= (primitive/cast i64 (data (slice (.symbols a))))
          (primitive/cast i64 (data (slice (.symbols b)))))
       (= (len (.scopes a)) (len (.scopes b)))
       (= (len (.symbols a)) (len (.symbols b)))))

;;; Where `accessor` (`scope-at`, `symbol-at`) may answer otherwise for `b` than for `a`, as ranges
;;; of the ids it takes, `lo` then `hi` for each: the places of the blocks either has that the other
;;; has not, and of the symbols linking made that differ. When `a` and `b` share most of their
;;; blocks, as one build's table and the next do, that is the blocks an edit changed. One range
;;; from -1: not known, so any id may differ.
(defn changes-Table [(a Table) (b Table) (accessor (slice u8))] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (rt/value-allocator))]
    (match (.joined a)
      (None [] (do (push! (mut out) -1) (push! (mut out) -1)))
      (Some [ja]
            (match (.joined b)
              (None [] (do (push! (mut out) -1) (push! (mut out) -1)))
              (Some [jb]
                    (cond (= accessor "scope-at")
                            (do
                              ;; Scope 0 holds every block's top scopes: compared once.
                              (push! (mut out) 0)
                              (push! (mut out) 1)
                              (blocks-changed! (mut out) (.blocks ja) (identity-order (len (.blocks ja)))
                                               (.blocks jb) (identity-order (len (.blocks jb))) true)
                              (extra-changed! (mut out) (.extra ja) (.extra jb))
                              (extra-changed! (mut out) (.extra jb) (.extra ja))
                              (count-changed! (mut out) (.scopes ja) (.scopes jb)))
                          (= accessor "symbol-at")
                            (do
                              (blocks-changed! (mut out) (.blocks ja) (.by-symbol ja)
                                               (.blocks jb) (.by-symbol jb) false)
                              (made-changed! (mut out) (.made ja) (.made jb))
                              (made-changed! (mut out) (.made jb) (.made ja))
                              (count-changed! (mut out) (.symbols ja) (.symbols jb)))
                          :else (do (push! (mut out) -1) (push! (mut out) -1)))))))
    out))

(defn identity-order [(n i64)] (-> (ArrayList i64))
  (let [(mut out) (ArrayList::new [i64] (rt/value-allocator))]
    (for i (range 0 n) (push! (mut out) i))
    out))

(defn block-start [(b Block) (scopes bool)] (-> i64)
  (if scopes (.scope-start b) (.symbol-start b)))

(defn block-end [(b Block) (scopes bool)] (-> i64)
  (if scopes
      (+ (.scope-start b) (len (.scopes b)))
      (+ (.symbol-start b) (len (.symbols b)))))

;;; The places of the blocks of `xs` and `ys`, each in its order by where it starts, that the other
;;; has not at the same place: a walk of both together.
(defn blocks-changed! [(out (mut (ArrayList i64)))
                       (xs (ArrayList Block))
                       (xo (ArrayList i64))
                       (ys (ArrayList Block))
                       (yo (ArrayList i64))
                       (scopes bool)] (-> void)
  (let [(mut i) 0
        (mut j) 0]
    (while (or (< i (len xo)) (< j (len yo)))
      (let [x-start (if (< i (len xo)) (block-start (get xs (get xo i)) scopes) -1)
            y-start (if (< j (len yo)) (block-start (get ys (get yo j)) scopes) -1)]
        (cond (or (>= j (len yo)) (and (< i (len xo)) (< x-start y-start)))
                (do
                  (push! (mut out) x-start)
                  (push! (mut out) (block-end (get xs (get xo i)) scopes))
                  (set! i (+ i 1)))
              (or (>= i (len xo)) (< y-start x-start))
                (do
                  (push! (mut out) y-start)
                  (push! (mut out) (block-end (get ys (get yo j)) scopes))
                  (set! j (+ j 1)))
              :else
                (let [x (get xs (get xo i))
                      y (get ys (get yo j))]
                  (unless (same-block? x y)
                    (push! (mut out) x-start)
                    (push! (mut out) (max-of (block-end x scopes) (block-end y scopes))))
                  (set! i (+ i 1))
                  (set! j (+ j 1)))))))
  0)

(defn max-of [(a i64) (b i64)] (-> i64)
  (if (> a b) a b))

(defn min-of [(a i64) (b i64)] (-> i64)
  (if (< a b) a b))

;;; The scopes whose made symbols `xs` and `ys` differ on, of those `xs` has.
(defn extra-changed! [(out (mut (ArrayList i64)))
                      (xs (HashMap i64 (ArrayList i64)))
                      (ys (HashMap i64 (ArrayList i64)))] (-> void)
  (for s xs
    (let [same
            (match (get xs s)
              (None [] false)
              (Some [x]
                    (match (get ys s)
                      (None [] false)
                      (Some [y]
                            (and (= (len x) (len y))
                                 (block :same
                                   (for k (range 0 (len x))
                                     (when (!= (get x k) (get y k)) (return-from :same false)))
                                   true))))))]
      (unless same
        (push! (mut out) s)
        (push! (mut out) (+ s 1)))))
  0)

;;; The made symbols `xs` and `ys` differ on, of those `xs` has.
(defn made-changed! [(out (mut (ArrayList i64)))
                     (xs (HashMap i64 Symbol))
                     (ys (HashMap i64 Symbol))] (-> void)
  (for s xs
    (let [same
            (match (get xs s)
              (None [] false)
              (Some [x]
                    (match (get ys s)
                      (None [] false)
                      (Some [y]
                            (and (= (.name x) (.name y))
                                 (= (.scope x) (.scope y))
                                 (= (.final x) (.final y)))))))]
      (unless same
        (push! (mut out) s)
        (push! (mut out) (+ s 1)))))
  0)

;;; Ids one of two counts numbers and the other does not.
(defn count-changed! [(out (mut (ArrayList i64))) (a i64) (b i64)] (-> void)
  (unless (= a b)
    (push! (mut out) (min-of a b))
    (push! (mut out) (max-of a b)))
  0)

;;; A table joined from blocks keeps no free names: ask each module's own table.
(defn own-free! [(t Table)] (-> void)
  (match (.joined t)
    (Some [_]
          (panic "symtab: a table joined from blocks keeps no free names; each module's own table has them"))
    (None [] 0)))

;;; A block of nothing: what a module with no table of its own (an outside import) has.
(defn no-block [] (-> Block)
  (Block
    :scopes (ArrayList::new [Scope] (rt/value-allocator))
    :symbols (ArrayList::new [Symbol] (rt/value-allocator))
    :scope-start 0
    :symbol-start 0
    :roots (ArrayList::new [i64] (rt/value-allocator))
    :dynamic false))

;;; `b` with each of its symbols named as it is in the output: `names[s]`, or else its own name. It
;;; shares its scopes with `b`; when every name is its own, it is `b`.
(defn renamed [(b Block) (names (HashMap i64 (slice u8)))] (-> Block)
  (if (block-names-own? b names) b (renamed-copy b names)))

;;; Whether `names` gives each symbol of `b` it names the name it has.
(defn block-names-own? [(b Block) (names (HashMap i64 (slice u8)))] (-> bool)
  (block :own
    (for s names
      (when (block-has? b s)
        (match (get names s)
          (Some [n]
                (unless (= n (.final (get (.symbols b) (- s (.symbol-start b)))))
                  (return-from :own false)))
          (None [] 0))))
    true))

(defn renamed-copy [(b Block) (names (HashMap i64 (slice u8)))] (-> Block)
  (let [(mut symbols) (ArrayList::new [Symbol] (rt/value-allocator))]
    (reserve! (mut symbols) (len (.symbols b)))
    (for i (range 0 (len (.symbols b)))
      (let [s (get (.symbols b) i)]
        (push! (mut symbols)
               (Symbol
                 :name (.name s)
                 :scope (.scope s)
                 :uses (.uses s)
                 :final
                   (match (get names (+ (.symbol-start b) i))
                     (Some [n] n)
                     (None [] (.name s)))
                 :pinned (.pinned s)))))
    (Block
      :scopes (.scopes b)
      :symbols symbols
      :scope-start (.scope-start b)
      :symbol-start (.symbol-start b)
      :roots (.roots b)
      :dynamic (.dynamic b))))

;;; Whether symbol `s` is one of `b`'s.
(defn block-has? [(b Block) (s i64)] (-> bool)
  (and (>= s (.symbol-start b)) (< s (+ (.symbol-start b) (len (.symbols b))))))

;;; `t`, a table joined from blocks, with `blocks` in place of its own, one for each (each the same
;;; but for what its symbols are named), and the symbols linking made named `made[s]`, or else as
;;; they are: every symbol's name in the output. It costs what joining does.
(defn named-from [(t Table) (blocks (ArrayList Block)) (made (HashMap i64 (slice u8)))] (-> Table)
  (match (.joined t)
    (None [] (panic "symtab: named-from takes a table joined from blocks"))
    (Some [j]
          (unless (= (len blocks) (len (.blocks j)))
            (panic "symtab: named-from was given {} blocks for a table of {}" (len blocks) (len (.blocks j))))
          (let [(mut scope-starts) (ArrayList::new [i64] (rt/value-allocator))
                (mut named) (HashMap::new-scalar [i64 Symbol] (rt/value-allocator))]
            (for b blocks (push! (mut scope-starts) (.scope-start b)))
            ;; A symbol a module claims is in its block, or one linking made: any other would be
            ;; named in no block.
            (for id made
              (match (get (.made j) id)
                (Some [_] 0)
                (None [] (panic "symtab: symbol {} is named by a module whose block does not hold it, and linking did not make it" id))))
            (for id (.made j)
              (match (get (.made j) id)
                (Some [s]
                      (set! (mut named)
                            id
                            (Symbol
                              :name (.name s)
                              :scope (.scope s)
                              :uses (.uses s)
                              :final (match (get made id) (Some [n] n) (None [] (.name s)))
                              :pinned (.pinned s))))
                (None [] 0)))
            (let [(mut sorted) (ArrayList::new [Block] (rt/value-allocator))
                  (mut starts) (ArrayList::new [i64] (rt/value-allocator))]
              (for i (rt/sort-order-int scope-starts false) (push! (mut sorted) (get blocks i)))
              (for b sorted (push! (mut starts) (.symbol-start b)))
              (Table
                :scopes (.scopes t)
                :symbols (ArrayList::new [Symbol] (rt/value-allocator))
                :free (names-map)
                :outer (HashMap::new-scalar [i64 i64] (rt/value-allocator))
                :joined
                  (Some (joined-of sorted (rt/sort-order-int starts false) named (.extra j) (.scopes j) (.symbols j)))))))))

;;; `t` with every symbol named `finals[s]`: names given the whole program at once.
(defn renamed-all [(t Table) (finals (ArrayList (slice u8)))] (-> Table)
  (match (.joined t)
    (None [] (panic "symtab: renamed-all takes a table joined from blocks"))
    (Some [j]
          (let [(mut blocks) (ArrayList::new [Block] (rt/value-allocator))
                (mut made) (HashMap::new-scalar [i64 (slice u8)] (rt/value-allocator))]
            (for b (.blocks j)
              (let [(mut names) (HashMap::new-scalar [i64 (slice u8)] (rt/value-allocator))]
                (for i (range 0 (len (.symbols b)))
                  (let [s (+ (.symbol-start b) i)]
                    (when (< s (len finals)) (set! (mut names) s (get finals s)))))
                (push! (mut blocks) (renamed b names))))
            (for id (.made j)
              (when (< id (len finals)) (set! (mut made) id (get finals id))))
            (named-from t blocks made)))))

;;; Every symbol's name in the output, by id.
(defn final-names [(t Table)] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (rt/value-allocator))]
    (for s (range 0 (symbol-count t)) (push! (mut out) (.final (symbol-at t s))))
    out))

;;; A copy of `t` with each of `parts` grafted under `parent` in turn.
(defn grafted [(t Table) (parts (ArrayList Table)) (parent i64)] (-> Table)
  (own-table! t "grafted")
  (let [(mut out) (table-copy t)]
    (for p parts (graft! (mut out) p parent))
    out))

(defn set-final! [(t (mut Table)) (s i64) (name (slice u8))] (-> void)
  (own-table! t "set-final!")
  (let [(mut symbol) (get (.symbols t) s)]
    (set! (.final symbol) name)
    (set! (mut (.symbols t)) s symbol)))

;;; The names no scope declared.
(defn free-names [(t Table)] (-> (ArrayList (slice u8)))
  (own-free! t)
  (let [(mut out) (ArrayList::new [(slice u8)] (rt/value-allocator))]
    (for k (.free t) (push! (mut out) k))
    out))

(defn has-free? [(t Table) (name (slice u8))] (-> bool)
  (own-free! t)
  (match (get (.free t) name) (Some [_] true) (None [] false)))

;; ---------------------------------------------------------------- the cache on disk

;;; A table, for the cache (see the cache in hl.rt): its scopes, symbols, free names and outer uses;
;;; or, joined from blocks, its own scope 0, its blocks and what is laid over them.
(defn persist-encode-Table [(w (ptr rt/Writer)) (t Table)] (-> void)
  (encode-scopes! w (.scopes t))
  (match (.joined t)
    (Some [j]
          (rt/put-bool! w true)
          (rt/put-varint! w (len (.blocks j)))
          (for b (.blocks j) (put-block! w b))
          (rt/put-ints! w (.by-symbol j))
          (rt/put-varint! w (len (.made j)))
          (for id (.made j)
            (rt/put-int! w id)
            (match (get (.made j) id)
              (Some [s]
                    (let [(mut one) (ArrayList::new [Symbol] (rt/value-allocator))]
                      (push! (mut one) s)
                      (encode-symbols! w one)))
              (None [] (panic "a map lost a key while it was written"))))
          (rt/put-varint! w (len (.extra j)))
          (for scope (.extra j)
            (rt/put-int! w scope)
            (match (get (.extra j) scope)
              (Some [xs] (rt/put-ints! w xs))
              (None [] (panic "a map lost a key while it was written"))))
          (rt/put-int! w (.scopes j))
          (rt/put-int! w (.symbols j)))
    (None []
          (rt/put-bool! w false)
          (encode-symbols! w (.symbols t))
          (encode-names! w (.free t))
          (rt/put-varint! w (len (.outer t)))
          (for key (.outer t)
            (rt/put-int! w key)
            (match (get (.outer t) key)
              (Some [v] (rt/put-int! w v))
              (None [] (panic "a map lost a key while it was written"))))))
  0)

;;; A block, for the cache: its scopes, symbols, place, top scopes and whether its top is dynamic. Its
;;; scopes are an object of the cache's, written once for every block that shares them (a module's
;;; block and the same named for the output).
(defn persist-encode-Block [(w (ptr rt/Writer)) (b Block)] (-> void)
  (let [(mut scopes) (.scopes b)]
    (when (rt/put-object-bytes! w "hl.symtab.Scopes" (cast (ptr u8) (mut scopes)) (sizeof (ArrayList Scope)))
      (encode-scopes! w (.scopes b))
      (rt/put-object-end! w)))
  (encode-symbols! w (.symbols b))
  (rt/put-int! w (.scope-start b))
  (rt/put-int! w (.symbol-start b))
  (rt/put-ints! w (.roots b))
  (rt/put-bool! w (.dynamic b))
  0)

(defn persist-decode-Block [(r (ptr rt/Reader))] (-> Block)
  (let [scopes (take-scopes r)
        symbols (decode-symbols r)
        scope-start (rt/take-int r)
        symbol-start (rt/take-int r)
        roots (rt/take-ints r)
        dynamic (rt/take-bool r)]
    (Block
      :scopes scopes
      :symbols symbols
      :scope-start scope-start
      :symbol-start symbol-start
      :roots roots
      :dynamic dynamic)))

;;; A block where a table joined from it holds it: an object of the cache's, as a block a memo's
;;; answer holds is, so the two are written once and read back as one.
(defn put-block! [(w (ptr rt/Writer)) (b Block)] (-> void)
  (let [(mut v) b]
    (when (rt/put-object-bytes! w "hl.symtab.Block" (cast (ptr u8) (mut v)) (sizeof Block))
      (persist-encode-Block w b)
      (rt/put-object-end! w)))
  0)

(defn take-block [(r (ptr rt/Reader))] (-> Block)
  (let [id (rt/take-object r)]
    (if (rt/object-ready? r id)
        (do
          (rt/object-skip! r)
          (load (cast (ptr Block) (rt/object-value r id))))
        (do
          (rt/object-enter! r)
          (let [(mut v) (persist-decode-Block r)]
            (rt/object-leave! r (cast (ptr u8) (mut v)) (sizeof Block))
            (rt/writer-know-bytes! "hl.symtab.Block" (cast (ptr u8) (mut v)) (sizeof Block) id)
            v)))))

(defn take-scopes [(r (ptr rt/Reader))] (-> (ArrayList Scope))
  (let [id (rt/take-object r)]
    (if (rt/object-ready? r id)
        (do
          (rt/object-skip! r)
          (load (cast (ptr (ArrayList Scope)) (rt/object-value r id))))
        (do
          (rt/object-enter! r)
          (let [(mut v) (decode-scopes r)]
            (rt/object-leave! r (cast (ptr u8) (mut v)) (sizeof (ArrayList Scope)))
            (rt/writer-know-bytes! "hl.symtab.Scopes" (cast (ptr u8) (mut v)) (sizeof (ArrayList Scope)) id)
            v)))))

(defn encode-scopes! [(w (ptr rt/Writer)) (scopes (ArrayList Scope))] (-> void)
  (rt/put-varint! w (len scopes))
  (for sc scopes
    (rt/put-int! w (.parent sc))
    (encode-names! w (.names sc))
    (rt/put-ints! w (.symbols sc))
    (rt/put-ints! w (.children sc))
    (rt/put-bool! w (.dynamic sc))
    (rt/put-ints! w (.enclosed sc)))
  0)

(defn encode-symbols! [(w (ptr rt/Writer)) (symbols (ArrayList Symbol))] (-> void)
  (rt/put-varint! w (len symbols))
  (for s symbols
    (rt/put-text! w (.name s))
    (rt/put-int! w (.scope s))
    (rt/put-int! w (.uses s))
    (rt/put-text! w (.final s))
    (rt/put-bool! w (.pinned s)))
  0)

(defn decode-scopes [(r (ptr rt/Reader))] (-> (ArrayList Scope))
  (let [(mut scopes) (ArrayList::new [Scope] (rt/value-allocator))
        n (rt/take-varint r)]
    (for _ (range 0 n)
      (let [parent (rt/take-int r)
            names (decode-names r)
            syms (rt/take-ints r)
            children (rt/take-ints r)
            dynamic (rt/take-bool r)
            enclosed (rt/take-ints r)]
        (push! (mut scopes)
               (Scope
                 :parent parent
                 :names names
                 :symbols syms
                 :children children
                 :dynamic dynamic
                 :enclosed enclosed))))
    scopes))

(defn decode-symbols [(r (ptr rt/Reader))] (-> (ArrayList Symbol))
  (let [(mut symbols) (ArrayList::new [Symbol] (rt/value-allocator))
        n (rt/take-varint r)]
    (for _ (range 0 n)
      (let [name (rt/take-text r)
            scope (rt/take-int r)
            uses (rt/take-int r)
            final (rt/take-text r)
            pinned (rt/take-bool r)]
        (push! (mut symbols)
               (Symbol
                 :name name
                 :scope scope
                 :uses uses
                 :final final
                 :pinned pinned))))
    symbols))

(defn encode-names! [(w (ptr rt/Writer)) (m (HashMap (slice u8) i64))] (-> void)
  (rt/put-varint! w (len m))
  (for key m
    (rt/put-text! w key)
    (match (get m key)
      (Some [v] (rt/put-int! w v))
      (None [] (panic "a map lost a key while it was written"))))
  0)

(defn decode-names [(r (ptr rt/Reader))] (-> (HashMap (slice u8) i64))
  (let [n (rt/take-varint r)
        (mut m) (names-map)]
    (for _ (range 0 n)
      (let [key (rt/take-text r)]
        (set! (mut m) key (rt/take-int r))))
    m))

(defn persist-decode-Table [(r (ptr rt/Reader))] (-> Table)
  (let [scopes (decode-scopes r)]
    (if (rt/take-bool r)
        (let [(mut blocks) (ArrayList::new [Block] (rt/value-allocator))
              nblocks (rt/take-varint r)]
          (for _ (range 0 nblocks) (push! (mut blocks) (take-block r)))
          (let [by-symbol (rt/take-ints r)
                (mut made) (HashMap::new-scalar [i64 Symbol] (rt/value-allocator))
                nmade (rt/take-varint r)]
            (for _ (range 0 nmade)
              (let [id (rt/take-int r)
                    one (decode-symbols r)]
                (set! (mut made) id (get one 0))))
            (let [(mut extra) (HashMap::new-scalar [i64 (ArrayList i64)] (rt/value-allocator))
                  nextra (rt/take-varint r)]
              (for _ (range 0 nextra)
                (let [scope (rt/take-int r)]
                  (set! (mut extra) scope (rt/take-ints r))))
              (let [nscopes (rt/take-int r)
                    nsymbols (rt/take-int r)]
                (Table
                  :scopes scopes
                  :symbols (ArrayList::new [Symbol] (rt/value-allocator))
                  :free (names-map)
                  :outer (HashMap::new-scalar [i64 i64] (rt/value-allocator))
                  :joined
                    (Some (joined-of blocks by-symbol made extra nscopes nsymbols)))))))
        (let [symbols (decode-symbols r)
              free (decode-names r)
              (mut outer) (HashMap::new-scalar [i64 i64] (rt/value-allocator))
              nouter (rt/take-varint r)]
          (for _ (range 0 nouter)
            (let [key (rt/take-int r)]
              (set! (mut outer) key (rt/take-int r))))
          (Table
            :scopes scopes
            :symbols symbols
            :free free
            :outer outer
            :joined (None [Joined]))))))

;; ---------------------------------------------------------------- tables out of scratch storage

;;; A table's own copy of whatever part of it lies in scratch storage (see "values out of scratch
;;; storage" in hl.rt): each list and map made there, and each name. What was made outside is
;;; shared, as a joined table shares its blocks.

(defn names-own-in [(from (ptr rt/Region)) (m (HashMap (slice u8) i64))]
  (-> (HashMap (slice u8) i64))
  (if (rt/storage-in? from (rt/map-storage m) (rt/map-capacity m))
      (let [seen (rt/own-seen (rt/map-storage m))]
        (if (!= (primitive/cast i64 seen) 0)
            (load (primitive/cast (ptr (HashMap (slice u8) i64)) seen))
            (let [(mut out) (names-map)
                  (mut src) m]
              (for-entries [k v (mut src)]
                (set! (mut out) (rt/text-own-in from (load k)) (load v)))
              (rt/own-keep! (rt/map-storage m) (primitive/cast (ptr u8) (mut out)) (sizeof (HashMap (slice u8) i64)))
              out)))
      m))

(defn int-map-own-in [(from (ptr rt/Region)) (m (HashMap i64 i64))] (-> (HashMap i64 i64))
  (if (rt/storage-in? from (rt/map-storage m) (rt/map-capacity m))
      (let [(mut out) (HashMap::new-scalar [i64 i64] (rt/value-allocator))
            (mut src) m]
        (for-entries [k v (mut src)] (set! (mut out) (load k) (load v)))
        out)
      m))

(defn symbol-own-in [(from (ptr rt/Region)) (s Symbol)] (-> Symbol)
  (Symbol
    :name (rt/text-own-in from (.name s))
    :scope (.scope s)
    :uses (.uses s)
    :final (rt/text-own-in from (.final s))
    :pinned (.pinned s)))

(defn symbols-own-in [(from (ptr rt/Region)) (xs (ArrayList Symbol))] (-> (ArrayList Symbol))
  (if (rt/storage-in? from (rt/list-storage xs) (cap xs))
      (let [seen (rt/own-seen (rt/list-storage xs))]
        (if (and (!= (primitive/cast i64 seen) 0)
                 (= (len (load (primitive/cast (ptr (ArrayList Symbol)) seen))) (len xs)))
            (load (primitive/cast (ptr (ArrayList Symbol)) seen))
            (let [(mut out) (ArrayList::new [Symbol] (rt/value-allocator))]
              (reserve! (mut out) (len xs))
              (for x xs (push! (mut out) (symbol-own-in from x)))
              (rt/own-keep! (rt/list-storage xs) (primitive/cast (ptr u8) (mut out)) (sizeof (ArrayList Symbol)))
              out)))
      xs))

(defn scope-own-in [(from (ptr rt/Region)) (sc Scope)] (-> Scope)
  (Scope
    :parent (.parent sc)
    :names (names-own-in from (.names sc))
    :symbols (rt/ints-own-in from (.symbols sc))
    :children (rt/ints-own-in from (.children sc))
    :dynamic (.dynamic sc)
    :enclosed (rt/ints-own-in from (.enclosed sc))))

(defn scopes-own-in [(from (ptr rt/Region)) (xs (ArrayList Scope))] (-> (ArrayList Scope))
  (if (rt/storage-in? from (rt/list-storage xs) (cap xs))
      (let [seen (rt/own-seen (rt/list-storage xs))]
        (if (and (!= (primitive/cast i64 seen) 0)
                 (= (len (load (primitive/cast (ptr (ArrayList Scope)) seen))) (len xs)))
            (load (primitive/cast (ptr (ArrayList Scope)) seen))
            (let [(mut out) (ArrayList::new [Scope] (rt/value-allocator))]
              (reserve! (mut out) (len xs))
              (for x xs (push! (mut out) (scope-own-in from x)))
              (rt/own-keep! (rt/list-storage xs) (primitive/cast (ptr u8) (mut out)) (sizeof (ArrayList Scope)))
              out)))
      xs))

(defn apart-own-Block [(from (ptr rt/Region)) (b Block)] (-> Block)
  (Block
    :scopes (scopes-own-in from (.scopes b))
    :symbols (symbols-own-in from (.symbols b))
    :scope-start (.scope-start b)
    :symbol-start (.symbol-start b)
    :roots (rt/ints-own-in from (.roots b))
    :dynamic (.dynamic b)))

(defn blocks-own-in [(from (ptr rt/Region)) (xs (ArrayList Block))] (-> (ArrayList Block))
  (if (rt/storage-in? from (rt/list-storage xs) (cap xs))
      (let [seen (rt/own-seen (rt/list-storage xs))]
        (if (and (!= (primitive/cast i64 seen) 0)
                 (= (len (load (primitive/cast (ptr (ArrayList Block)) seen))) (len xs)))
            (load (primitive/cast (ptr (ArrayList Block)) seen))
            (let [(mut out) (ArrayList::new [Block] (rt/value-allocator))]
              (reserve! (mut out) (len xs))
              (for x xs (push! (mut out) (apart-own-Block from x)))
              (rt/own-keep! (rt/list-storage xs) (primitive/cast (ptr u8) (mut out)) (sizeof (ArrayList Block)))
              out)))
      xs))

(defn bools-own-in [(from (ptr rt/Region)) (xs (ArrayList bool))] (-> (ArrayList bool))
  (if (rt/storage-in? from (rt/list-storage xs) (cap xs))
      (let [seen (rt/own-seen (rt/list-storage xs))]
        (if (and (!= (primitive/cast i64 seen) 0)
                 (= (len (load (primitive/cast (ptr (ArrayList bool)) seen))) (len xs)))
            (load (primitive/cast (ptr (ArrayList bool)) seen))
            (let [(mut out) (ArrayList::new [bool] (rt/value-allocator))]
              (reserve! (mut out) (len xs))
              (for x xs (push! (mut out) x))
              (rt/own-keep! (rt/list-storage xs) (primitive/cast (ptr u8) (mut out)) (sizeof (ArrayList bool)))
              out)))
      xs))

(defn joined-own-in [(from (ptr rt/Region)) (j Joined)] (-> Joined)
  (Joined
    :blocks (blocks-own-in from (.blocks j))
    :by-symbol (rt/ints-own-in from (.by-symbol j))
    :made
      (if (rt/storage-in? from (rt/map-storage (.made j)) (rt/map-capacity (.made j)))
          (let [(mut out) (HashMap::new-scalar [i64 Symbol] (rt/value-allocator))
                (mut src) (.made j)]
            (for-entries [k v (mut src)]
              (set! (mut out) (load k) (symbol-own-in from (load v))))
            out)
          (.made j))
    :extra
      (if (rt/storage-in? from (rt/map-storage (.extra j)) (rt/map-capacity (.extra j)))
          (let [(mut out) (HashMap::new-scalar [i64 (ArrayList i64)] (rt/value-allocator))
                (mut src) (.extra j)]
            (for-entries [k v (mut src)]
              (set! (mut out) (load k) (rt/ints-own-in from (load v))))
            out)
          (.extra j))
    :scopes (.scopes j)
    :symbols (.symbols j)
    :scope-pages (rt/ints-own-in from (.scope-pages j))
    :symbol-pages (rt/ints-own-in from (.symbol-pages j))
    :extra-in (bools-own-in from (.extra-in j))))

(defn apart-own-Table [(from (ptr rt/Region)) (t Table)] (-> Table)
  (Table
    :scopes (scopes-own-in from (.scopes t))
    :symbols (symbols-own-in from (.symbols t))
    :free (names-own-in from (.free t))
    :outer (int-map-own-in from (.outer t))
    :joined
      (match (.joined t)
        (Some [j] (Some (joined-own-in from j)))
        (None [] (None [Joined])))))
