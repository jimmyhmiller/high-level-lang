;;; `.facts`: the analysis language. Datalog over relations of interned ids,
;;; compiled to nested loops with hash indexes, run to a fixpoint. There is no engine
;;; at runtime.
;;;
;;;   facts
;;;   relation refs(from, to)
;;;   relation live(name)
;;;   live(Y) :- live(X), refs(X, Y) ;
;;;   visible(M, N, S) :- star(M, D), exported(D, N, S), !local(M, N) ;
;;;
;;; Negation is stratified: a negated relation is finished before any rule that reads
;;; it runs, and negation through a cycle is an error. A body atom scans through an
;;; index on its first two bound columns. Evaluation is semi-naive: every rule runs once,
;;; and after that a rule runs only from the rows the last round added to a relation it
;;; reads, starting its loops there.
;;;
;;; Generated API: `Db`, `new-db`, `add-REL!`, `has-REL?`, `solve!`, and each relation
;;; as a field of `Db`, read with `rt/rel-at`.
(module hl.facts)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "hl.dsl" :as dsl)
(import "hl.grammars.facts" :as g)

(reader-provider "hl.facts" read-facts)

(defstruct Relation [(name (slice u8)) (arity i64) (stratum i64)])

(defstruct Atom
  [(rel (slice u8))
   (args (ArrayList rt/Tok))
   (negated bool)
   (delta bool)
   ;; The database it reads: `db` (the one being solved), or, updating one (see `solved-from`), `old`
   ;; (as it was), `plus` (rows added) or `minus` (rows taken out).
   (src (slice u8))
   (tok rt/Tok)])

;;; A rule, and what its head does with a row: `db` and `minus` queue it there; `found` answers true
;;; (whether the head's row is derived, its columns bound beforehand: see `rederive-code`).
(defstruct Clause [(head Atom) (body (ArrayList Atom)) (sink (slice u8))])

(defn src-sym [(a Atom)] (-> Code)
  (primitive/code-symbol (.src a)))

(defn field-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "." n))

(defn var-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "v-" n))

(defn row-sym [(i i64)] (-> Code)
  (primitive/code-symbol "row" i))

(defn ix-sym [(i i64)] (-> Code)
  (primitive/code-symbol "ix" i))

(defn bucket-sym [(i i64)] (-> Code)
  (primitive/code-symbol "bucket" i))

(defn count-sym [(i i64)] (-> Code)
  (primitive/code-symbol "count" i))

(defn arity-of [(rels (ArrayList Relation)) (c (mut dsl/Cur)) (a Atom)] (-> i64)
  (let [(mut out) -1]
    (for r rels (when (= (.name r) (.rel a)) (set! out (.arity r))))
    (when (< out 0)
      (dsl/die (mut c) (.tok a) (dsl/join2 "no relation named " (.rel a))))
    (when (!= out (len (.args a)))
      (dsl/die (mut c)
               (.tok a)
               (dsl/join2 "wrong number of columns for " (.rel a))))
    out))

;;; A grammar node's name as the token the error messages locate.
(defn tok-of [(src (slice u8)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col src (.lo n))]
    (rt/Tok
      :kind (rt/TIdent)
      :text (.text n)
      :line (.line at)
      :col (.col at))))

(defn atom-of [(src (slice u8)) (n g/Node) (negated bool)] (-> Atom)
  (let [name (get (.kids n) 0)
        (mut args) (ArrayList::new [rt/Tok] (malloc-allocator))]
    (for arg (.kids (get (.kids n) 1)) (push! (mut args) (tok-of src arg)))
    (Atom
      :rel (.text name)
      :args args
      :negated negated
      :delta false
      :src "db"
      :tok (tok-of src name))))

(defn body-atom-of [(src (slice u8)) (n g/Node)] (-> Atom)
  (if (= (.kind n) (g/KNegated))
      (atom-of src (get (.kids n) 0) true)
      (atom-of src n false)))

(defn bound? [(bound (ArrayList (slice u8))) (n (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for b bound (when (= b n) (set! hit true)))
    hit))

;;; The four column arguments for a row call, unused columns as 0.
(defn row-args [(a Atom)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for i (range 0 4)
      (if (< i (len (.args a)))
          (push! (mut out) (var-sym (.text (get (.args a) i))))
          (push! (mut out) `0)))
    `(~@out)))

(defn head-add [(c (mut dsl/Cur))
                (a Atom)
                (bound (ArrayList (slice u8)))
                (sink (slice u8))]
  (-> Code)
  (for t (.args a)
    (unless (bound? bound (.text t))
      (dsl/die (mut c)
               t
               (dsl/join3 "the head variable "
                          (.text t)
                          " is not bound by the body"))))
  (if (= sink "found")
      `(return-from :found true)
      `(rt/rel-queue! (mut (~(field-sym (.rel a)) ~(primitive/code-symbol sink)))
                      ~@(row-args a))))

;;; Test or bind column `col` of the row atom `i` holds, then continue.
(defn columns-code [(c (mut dsl/Cur))
                    (k Clause)
                    (i i64)
                    (col i64)
                    (bound (mut (ArrayList (slice u8))))] (-> Code)
  (let [a (get (.body k) i)]
    (if (>= col (len (.args a)))
        (atoms-code (mut c) k (+ i 1) (mut bound))
        (let [n (.text (get (.args a) col))
              value
                `(rt/rel-at (mut (~(field-sym (.rel a)) ~(src-sym a)))
                            ~(row-sym i)
                            ~col)]
          (if (bound? bound n)
              `(when (= ~value ~(var-sym n))
                 ~(columns-code (mut c) k i (+ col 1) (mut bound)))
              (do
                (push! (mut bound) n)
                `(let [~(var-sym n) ~value]
                   ~(columns-code (mut c) k i (+ col 1) (mut bound)))))))))

;;; Atom `i`: a membership test when negated; otherwise a scan, through an index on
;;; its first bound column if it has one.
(defn atoms-code [(c (mut dsl/Cur))
                  (k Clause)
                  (i i64)
                  (bound (mut (ArrayList (slice u8))))] (-> Code)
  (if (>= i (len (.body k)))
      (head-add (mut c) (.head k) bound (.sink k))
      (let [a (get (.body k) i)
            rel (field-sym (.rel a))
            db (src-sym a)]
        (if (.negated a)
            (do
              (for t (.args a)
                (unless (bound? bound (.text t))
                  (dsl/die (mut c)
                           t
                           (dsl/join3 "the negated variable "
                                      (.text t)
                                      " must be bound earlier in the body"))))
              `(unless (rt/rel-has? (mut (~rel ~db)) ~@(row-args a))
                 ~(atoms-code (mut c) k (+ i 1) (mut bound))))
            (let [(mut key-col) -1
                  (mut key-col2) -1]
              (for j (range 0 (len (.args a)))
                (when (bound? bound (.text (get (.args a) j)))
                  (if (< key-col 0)
                      (set! key-col j)
                      (when (and (< key-col2 0)
                                 (!= (.text (get (.args a) j))
                                     (.text (get (.args a) key-col))))
                        (set! key-col2 j)))))
              (cond (.delta a)
                      (let [body (columns-code (mut c) k i 0 (mut bound))]
                        `(for ~(row-sym i) (range (.delta-from (~rel ~db))
                                                  (.delta-to (~rel ~db)))
                           ~body))
                    (>= key-col2 0)
                      (let [key (var-sym (.text (get (.args a) key-col)))
                            key2 (var-sym (.text (get (.args a) key-col2)))
                            body (columns-code (mut c) k i 0 (mut bound))]
                        `(let [~(bucket-sym i)
                                 (rt/rel-bucket2 (mut (~rel ~db))
                                                 ~key-col
                                                 ~key-col2
                                                 ~key
                                                 ~key2)]
                           (for ~(ix-sym i) (range 0 (len ~(bucket-sym i)))
                             (let [~(row-sym i)
                                     (get ~(bucket-sym i) ~(ix-sym i))]
                               ~body))))
                    (>= key-col 0)
                      (let [key (var-sym (.text (get (.args a) key-col)))
                            body (columns-code (mut c) k i 0 (mut bound))]
                        `(let [~(bucket-sym i)
                                 (rt/rel-bucket (mut (~rel ~db)) ~key-col ~key)]
                           (for ~(ix-sym i) (range 0 (len ~(bucket-sym i)))
                             (let [~(row-sym i)
                                     (get ~(bucket-sym i) ~(ix-sym i))]
                               ~body))))
                    :else
                      (let [body (columns-code (mut c) k i 0 (mut bound))]
                        `(for ~(row-sym i) (range 0 (.count (~rel ~db)))
                           ~body))))))))

;;; Does any rule add to this relation? One that none does never has a delta.
(defn derived? [(clauses (ArrayList Clause)) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for k clauses (when (= (.rel (.head k)) name) (set! hit true)))
    hit))

;;; How many of an atom's columns the atoms before it have bound.
(defn bound-columns [(a Atom) (bound (ArrayList (slice u8)))] (-> i64)
  (let [(mut n) 0]
    (for t (.args a) (when (bound? bound (.text t)) (set! n (+ n 1))))
    n))

;;; The join order: the first atom stays first, and then whichever atom the variables so far pin
;;; down best, so a loop is never a scan that something else could have narrowed. A negated atom
;;; waits until all its variables are bound, and then goes at once, since it can only filter.
(defn planned [(k Clause)] (-> Clause)
  (planned-from k (ArrayList::new [(slice u8)] (malloc-allocator)) true))

;;; The same with `given` bound before any atom (a head's variables, checking whether a row is
;;; derived), and with no atom kept first unless `keep-first`.
(defn planned-from [(k Clause) (given (ArrayList (slice u8))) (keep-first bool)]
  (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))
        (mut used) (ArrayList::new [bool] (malloc-allocator))
        (mut bound) given
        n (len (.body k))]
    (for _ (range 0 n) (push! (mut used) false))
    (for _ (range 0 n)
      (let [(mut best) -1
            (mut best-score) -1]
        (for i (range 0 n)
          (unless (get used i)
            (let [a (get (.body k) i)
                  have (bound-columns a bound)
                  whole (= have (len (.args a)))
                  score
                    (cond (and (.negated a) whole) 1000
                          (.negated a) -2
                          (and keep-first (= i 0)) 2000
                          :else have)]
              (when (> score best-score)
                (set! best i)
                (set! best-score score)))))
        ;; Only negated atoms are left, and their variables never get bound: report that as written.
        (when (< best 0)
          (for i (range 0 n)
            (when (and (< best 0) (not (get used i))) (set! best i))))
        (let [a (get (.body k) best)]
          (set! (mut used) best true)
          (push! (mut body) a)
          (unless (.negated a)
            (for t (.args a)
              (unless (bound? bound (.text t)) (push! (mut bound) (.text t))))))))
    (Clause
      :head (.head k)
      :body body
      :sink (.sink k))))

;;; The clause with atom `at` moved first, and reading only that relation's delta. Everything
;;; else still reads the whole of its relation, which can find a row twice but never miss one.
(defn delta-variant [(k Clause) (at i64)] (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))
        a (get (.body k) at)]
    (push! (mut body)
           (Atom
             :rel (.rel a)
             :args (.args a)
             :negated false
             :delta true
             :src (.src a)
             :tok (.tok a)))
    (for i (range 0 (len (.body k)))
      (when (!= i at) (push! (mut body) (get (.body k) i))))
    (planned (Clause
               :head (.head k)
               :body body
               :sink (.sink k)))))

;;; Stratum of each relation: at least a body relation's, above a negated one's.
(defn stratify! [(rels (mut (ArrayList Relation)))
                 (clauses (ArrayList Clause))
                 (c (mut dsl/Cur))] (-> i64)
  (let [(mut changed) true
        (mut top) 0
        limit (+ (len rels) 1)]
    (while changed
      (set! changed false)
      (for k clauses
        (let [head-at (rel-index rels (.rel (.head k)))
              (mut need) (.stratum (get rels head-at))]
          (for a (.body k)
            (let [s (.stratum (get rels (rel-index rels (.rel a))))
                  required (if (.negated a) (+ s 1) s)]
              (when (> required need) (set! need required))))
          (when (> need (.stratum (get rels head-at)))
            (when (> need limit)
              (dsl/die (mut c)
                       (.tok (.head k))
                       "this rule depends on its own negation"))
            (let [r (get rels head-at)]
              (set! (mut rels)
                    head-at
                    (Relation
                      :name (.name r)
                      :arity (.arity r)
                      :stratum need)))
            (when (> need top) (set! top need))
            (set! changed true)))))
    top))

;;; The relations of `group` solved over `db` from what is there, every relation they read outside it
;;; finished: every rule once, then from each round's new rows until a round adds none.
(defn stratum-code [(c (mut dsl/Cur))
                    (rels (ArrayList Relation))
                    (clauses (ArrayList Clause))
                    (group (ArrayList (slice u8)))] (-> Code)
  (let [(mut once) (primitive/code-list-new)
        (mut again) (primitive/code-list-new)
        (mut marks) (primitive/code-list-new)
        (mut starts) (primitive/code-list-new)]
    (for r rels
      (when (bound? group (.name r))
        (push! (mut starts)
               `(rt/rel-advance! (mut (~(field-sym (.name r)) db))))
        (push! (mut marks)
               `(when (rt/rel-advance! (mut (~(field-sym (.name r)) db)))
                  (set! changed true)))))
    (for k clauses
      (when (bound? group (.rel (.head k)))
        (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
              flush (field-sym (.rel (.head k)))]
          (push! (mut once)
                 (atoms-code (mut c) (planned k) 0 (mut bound)))
          (push! (mut once) `(rt/rel-flush! (mut (~flush db))))
          (for i (range 0 (len (.body k)))
            (let [a (get (.body k) i)
                  ra (rel-index rels (.rel a))]
              (when (and (not (.negated a)) (bound? group (.rel a)))
                (let [(mut b2) (ArrayList::new [(slice u8)] (malloc-allocator))]
                  (push! (mut again)
                         `(when (rt/rel-delta? (mut (~(field-sym (.rel a)) db)))
                            ~(atoms-code (mut c)
                                         (delta-variant k i)
                                         0
                                         (mut b2))
                            (rt/rel-flush! (mut (~flush db))))))))))))
    `(do
       ~@starts
       ~@once
       (let [(mut changed) true]
         (while changed
           (set! changed false)
           (set! rounds (+ rounds 1))
           ~@marks
           (when changed ~@again))))))

;; ---------------------------------------------------------------- updating a solved database

;;; An atom as a variant of a rule reads it: from `src`, negated or not, only the last round's rows.
(defn with-src [(a Atom) (src (slice u8)) (negated bool) (delta bool)] (-> Atom)
  (Atom
    :rel (.rel a)
    :args (.args a)
    :negated negated
    :delta delta
    :src src
    :tok (.tok a)))

;;; Rule `k` driven by `first` in place of its atom `at` (kept too, reading `rest`, when `keep`), every
;;; other atom reading `rest`, its head going to `sink`.
(defn variant [(k Clause)
               (at i64)
               (first Atom)
               (keep bool)
               (rest (slice u8))
               (sink (slice u8))] (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))]
    (push! (mut body) first)
    (for i (range 0 (len (.body k)))
      (when (or keep (!= i at))
        (let [b (get (.body k) i)]
          (push! (mut body) (with-src b rest (.negated b) false)))))
    (planned (Clause
               :head (.head k)
               :body body
               :sink sink))))

(defn stratum-of [(rels (ArrayList Relation)) (n (slice u8))] (-> i64)
  (.stratum (get rels (rel-index rels n))))

;;; The derived relations in groups that derive each other (each group's rules read the relations of
;;; no later group), in the order they can be brought up to date: what each reads outside it first.
(defn groups-in-order [(rels (ArrayList Relation)) (clauses (ArrayList Clause))]
  (-> (ArrayList (ArrayList (slice u8))))
  (let [(mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut reach) (ArrayList::new [bool] (malloc-allocator))]
    (for r rels
      (when (derived? clauses (.name r)) (push! (mut names) (.name r))))
    (let [n (len names)]
      (for _ (range 0 (* n n)) (push! (mut reach) false))
      ;; Which reads which, then what each reaches through others.
      (for k clauses
        (let [h (name-at names (.rel (.head k)))]
          (for a (.body k)
            (let [b (name-at names (.rel a))]
              (when (>= b 0) (set! (mut reach) (+ (* h n) b) true))))))
      (for m (range 0 n)
        (for i (range 0 n)
          (when (get reach (+ (* i n) m))
            (for j (range 0 n)
              (when (get reach (+ (* m n) j))
                (set! (mut reach) (+ (* i n) j) true))))))
      (let [(mut placed) (ArrayList::new [bool] (malloc-allocator))
            (mut out)
              (ArrayList::new [(ArrayList (slice u8))] (malloc-allocator))
            (mut left) n]
        (for _ (range 0 n) (push! (mut placed) false))
        (while (> left 0)
          (let [(mut took) false]
            (for i (range 0 n)
              (unless (or took (get placed i))
                ;; Its group: what it reaches that reaches it. Ready when all it reaches outside the
                ;; group is placed.
                (let [(mut group) (ArrayList::new [i64] (malloc-allocator))
                      (mut ready) true]
                  (push! (mut group) i)
                  (for j (range 0 n)
                    (when (and (!= j i)
                               (get reach (+ (* i n) j))
                               (get reach (+ (* j n) i)))
                      (push! (mut group) j)))
                  (for g group
                    (for j (range 0 n)
                      (when (and (get reach (+ (* g n) j)) (not (get placed j)))
                        (let [(mut inside) false]
                          (for h group (when (= h j) (set! inside true)))
                          (unless inside (set! ready false))))))
                  (when ready
                    (let [(mut members)
                            (ArrayList::new [(slice u8)] (malloc-allocator))]
                      (for g group
                        (set! (mut placed) g true)
                        (push! (mut members) (get names g)))
                      (set! left (- left (len group)))
                      (push! (mut out) members)
                      (set! took true))))))
            (unless took
              (panic "facts: no group of relations is ready to bring up to date"))))
        out))))

(defn name-at [(names (ArrayList (slice u8))) (n (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len names)) (when (= (get names i) n) (set! out i)))
    out))

(defn count-of [(n (slice u8)) (db (slice u8))] (-> Code)
  `(.count (~(field-sym n) ~(primitive/code-symbol db))))

(defn flush-of [(n (slice u8)) (db (slice u8))] (-> Code)
  `(rt/rel-flush! (mut (~(field-sym n) ~(primitive/code-symbol db)))))

(defn start-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "start-" n))

(defn rederive-sym [(i i64)] (-> Code)
  (primitive/code-symbol "rederived-" i))

;;; A list of its own with `xs`'s names.
(defn texts-copy [(xs (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (for x xs (push! (mut out) x))
    out))

;;; A rule's joins, from its first atom with nothing bound.
(defn joined-code [(c (mut dsl/Cur)) (k Clause)] (-> Code)
  (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (atoms-code (mut c) k 0 (mut bound))))

;;; Whether rule `k` (the i-th) derives the row `a0`..`a3` of its head from `db` as it is: its head's
;;; variables bound to the row's columns, then its body, every atom reading `db`.
(defn rederive-code [(c (mut dsl/Cur)) (k Clause) (i i64)] (-> Code)
  (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut binds) (ArrayList::new [i64] (malloc-allocator))
        head (.head k)]
    (for j (range 0 (len (.args head)))
      (let [n (.text (get (.args head) j))]
        (if (bound? bound n)
            (push! (mut binds) -1)
            (do (push! (mut bound) n) (push! (mut binds) j)))))
    (let [(mut checks) (primitive/code-list-new)
          (mut lets) (primitive/code-list-new)
          inner
            (atoms-code (mut c)
                        (planned-from (Clause
                                        :head head
                                        :body (.body k)
                                        :sink "found")
                                      (texts-copy bound)
                                      false)
                        0
                        (mut bound))]
      (for j (range 0 (len (.args head)))
        (let [n (.text (get (.args head) j))
              col (primitive/code-symbol "a" j)]
          (if (>= (get binds j) 0)
              (do (push! (mut lets) (var-sym n)) (push! (mut lets) col))
              (push! (mut checks) `(= ~(var-sym n) ~col)))))
      `(defn ~(rederive-sym i) [(db (mut Db))
                                (a0 i64)
                                (a1 i64)
                                (a2 i64)
                                (a3 i64)] (-> bool)
         (block :found
           (let [~@lets]
             (when (and true ~@checks) ~inner))
           false)))))

;;; Stratum `s` brought up to date from what changed below it, by deleting and deriving again: what
;;; a row taken out below, or one added to a relation read negated, derived in the old database is
;;; taken out (`minus`); what is still derived from what is left goes back; and what the rows added
;;; below, or those taken out of a relation read negated, derive is added, to a fixpoint. Then what
;;; changed in this stratum, for those above: `plus` the rows it gained, `minus` those it lost.
(defn update-stratum [(c (mut dsl/Cur))
                      (rels (ArrayList Relation))
                      (clauses (ArrayList Clause))
                      (group (ArrayList (slice u8)))] (-> Code)
  (let [(mut mine) (ArrayList::new [Relation] (malloc-allocator))
        (mut reads) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut touched) (primitive/code-list-new)
        (mut del-starts) (primitive/code-list-new)
        (mut del-seeds) (primitive/code-list-new)
        (mut del-marks) (primitive/code-list-new)
        (mut del-again) (primitive/code-list-new)
        (mut removes) (primitive/code-list-new)
        (mut starts) (primitive/code-list-new)
        (mut rederives) (primitive/code-list-new)
        (mut ins-seeds) (primitive/code-list-new)
        (mut ins-marks) (primitive/code-list-new)
        (mut ins-again) (primitive/code-list-new)
        (mut finals) (primitive/code-list-new)
        (mut sizes) (primitive/code-list-new)
        (mut gone-counts) (primitive/code-list-new)
        (mut empties) (primitive/code-list-new)
        (mut whole-finals) (primitive/code-list-new)]
    (for r rels (when (bound? group (.name r)) (push! (mut mine) r)))
    (for ci (range 0 (len clauses))
      (let [k (get clauses ci)
            h (.rel (.head k))]
        (when (bound? group h)
          (for i (range 0 (len (.body k)))
            (let [a (get (.body k) i)
                  l (.rel a)]
              (if (not (bound? group l))
                  (do
                    (unless (bound? reads l) (push! (mut reads) l))
                    (if (.negated a)
                        (do
                          (push! (mut del-seeds)
                                 `(when (> ~(count-of l "plus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "plus"
                                                                     false
                                                                     false)
                                                           false
                                                           "old"
                                                           "minus"))
                                    ~(flush-of h "minus")))
                          (push! (mut ins-seeds)
                                 `(when (> ~(count-of l "minus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "minus"
                                                                     false
                                                                     false)
                                                           true
                                                           "db"
                                                           "db"))
                                    ~(flush-of h "db"))))
                        (do
                          (push! (mut del-seeds)
                                 `(when (> ~(count-of l "minus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "minus"
                                                                     false
                                                                     false)
                                                           false
                                                           "old"
                                                           "minus"))
                                    ~(flush-of h "minus")))
                          (push! (mut ins-seeds)
                                 `(when (> ~(count-of l "plus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "plus"
                                                                     false
                                                                     false)
                                                           false
                                                           "db"
                                                           "db"))
                                    ~(flush-of h "db"))))))
                  ;; Read from this stratum: rows it gains or loses as the rounds go.
                  (unless (.negated a)
                    (push! (mut del-again)
                           `(when (rt/rel-delta? (mut (~(field-sym l) minus)))
                              ~(joined-code (mut c)
                                            (variant k
                                                     i
                                                     (with-src a
                                                               "minus"
                                                               false
                                                               true)
                                                     false
                                                     "old"
                                                     "minus"))
                              ~(flush-of h "minus")))
                    (push! (mut ins-again)
                           `(when (rt/rel-delta? (mut (~(field-sym l) db)))
                              ~(joined-code (mut c)
                                            (variant k
                                                     i
                                                     (with-src a
                                                               "db"
                                                               false
                                                               true)
                                                     false
                                                     "db"
                                                     "db"))
                              ~(flush-of h "db"))))))))))
    (for l reads
      (push! (mut touched) `(> ~(count-of l "plus") 0))
      (push! (mut touched) `(> ~(count-of l "minus") 0)))
    (for r mine
      (let [f (field-sym (.name r))
            n (.name r)
            (mut tests) (primitive/code-list-new)]
        (push! (mut del-starts) `(rt/rel-advance! (mut (~f minus))))
        (push! (mut del-marks)
               `(when (rt/rel-advance! (mut (~f minus))) (set! changed true)))
        ;; A relation of its own to change, `old`'s staying as it was: without what was taken out.
        (push! (mut removes)
               `(set! (~f db)
                      (if (> ~(count-of n "minus") 0)
                          (rt/rel-without (mut (~f db)) (mut (~f minus)))
                          (rt/rel-clone (mut (~f db))))))
        (push! (mut starts) (start-sym n))
        (push! (mut starts) (count-of n "db"))
        (for ci (range 0 (len clauses))
          (when (= (.rel (.head (get clauses ci))) n)
            (push! (mut tests) `(~(rederive-sym ci) (mut db) a0 a1 a2 a3))))
        (push! (mut rederives)
               `(for row (range 0 ~(count-of n "minus"))
                  (let [a0 (rt/row-col (mut (~f minus)) row 0)
                        a1 (rt/row-col (mut (~f minus)) row 1)
                        a2 (rt/row-col (mut (~f minus)) row 2)
                        a3 (rt/row-col (mut (~f minus)) row 3)]
                    (when (or false ~@tests)
                      (rt/rel-add! (mut (~f db)) a0 a1 a2 a3)))))
        (push! (mut ins-marks)
               `(when (rt/rel-advance! (mut (~f db))) (set! changed true)))
        (push! (mut sizes) (count-of n "old"))
        (push! (mut gone-counts) (count-of n "minus"))
        (push! (mut empties) `(set! (~f db) (rt/rel-new ~(.arity r))))
        (push! (mut whole-finals)
               `(let [(mut gained) (rt/rel-new ~(.arity r))
                      (mut lost) (rt/rel-new ~(.arity r))]
                  (rt/rel-diff-into! (mut (~f db)) (mut (~f old)) (mut gained))
                  (rt/rel-diff-into! (mut (~f old)) (mut (~f db)) (mut lost))
                  (set! (~f plus) gained)
                  (set! (~f minus) lost)))
        (push! (mut finals)
               `(let [(mut gone) (rt/rel-new ~(.arity r))]
                  (rt/rel-range-diff-into! (mut (~f db))
                                           ~(start-sym n)
                                           ~(count-of n "db")
                                           (mut (~f minus))
                                           (mut (~f plus)))
                  (rt/rel-diff-into! (mut (~f minus)) (mut (~f db)) (mut gone))
                  (set! (~f minus) gone)))))
    (if (= (len mine) 0)
        `0
        ;; Taking out more than a quarter of the stratum's rows (a change reaching most of what it
        ;; derives, through its recursion), deriving them back one at a time costs more than solving
        ;; the stratum afresh from the strata below, as they now are; and so that is done.
        `(when (or false ~@touched)
           (let [cap (/ (+ 0 ~@sizes) 4)
                 (mut whole) false]
             ~@del-starts
             ~@del-seeds
             (let [(mut changed) true]
               (while (and changed (not whole))
                 (set! changed false)
                 ~@del-marks
                 (when (> (+ 0 ~@gone-counts) cap) (set! whole true))
                 (when (and changed (not whole)) ~@del-again)))
             (if whole
                 (do
                   ~@empties
                   ~(stratum-code (mut c) rels clauses group)
                   ~@whole-finals
                   0)
                 (do
                   ~@removes
                   (let [~@starts]
                     ~@rederives
                     ~@ins-seeds
                     (let [(mut changed) true]
                       (while changed
                         (set! changed false)
                         (set! rounds (+ rounds 1))
                         ~@ins-marks
                         (when changed ~@ins-again)))
                     ~@finals)
                   0)))))))

(defn rel-index [(rels (ArrayList Relation)) (n (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len rels))
      (when (= (.name (get rels i)) n) (set! out i)))
    out))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree
          (match (g/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (dsl/join2 "expected " (.want e)))))
        (mut rels) (ArrayList::new [Relation] (malloc-allocator))
        (mut clauses) (ArrayList::new [Clause] (malloc-allocator))]
    (for item (.kids (get (.kids tree) 0))
      (if (= (.kind item) (g/KRelation))
          (let [a (atom-of src item false)
                n (len (.args a))]
            (when (or (< n 1) (> n 4))
              (dsl/die (mut c) (.tok a) "a relation has 1 to 4 columns"))
            (push! (mut rels)
                   (Relation
                     :name (.rel a)
                     :arity n
                     :stratum 0)))
          (let [head (atom-of src (get (.kids item) 0) false)
                (mut body) (ArrayList::new [Atom] (malloc-allocator))]
            (for b (.kids (get (.kids item) 1))
              (push! (mut body) (body-atom-of src b)))
            (push! (mut clauses)
                   (Clause
                     :head head
                     :body body
                     :sink "db")))))
    ;; Checked after reading, so a rule may precede its relation's declaration.
    (for k clauses
      (arity-of rels (mut c) (.head k))
      (for a (.body k) (arity-of rels (mut c) a)))
    (let [top (stratify! (mut rels) clauses (mut c))
          (mut fields) (primitive/code-list-new)
          (mut inits) (primitive/code-list-new)
          (mut api) (primitive/code-list-new)
          (mut strata) (primitive/code-list-new)
          (mut reserves) (primitive/code-list-new)
          (mut adds) (primitive/code-list-new)
          (mut room) (primitive/code-list-new)
          (mut rederive-fns) (primitive/code-list-new)
          (mut updates) (primitive/code-list-new)
          (mut same-checks) (primitive/code-list-new)
          (mut given-checks) (primitive/code-list-new)
          (mut base-diffs) (primitive/code-list-new)
          (mut holds) (primitive/code-list-new)
          (mut index) 0]
      (for r rels
        (let [field (primitive/code-symbol (.name r))
              access (field-sym (.name r))
              add (primitive/code-symbol "add-" (.name r) "!")
              has (primitive/code-symbol "has-" (.name r) "?")
              (mut params) (primitive/code-list-new)
              (mut args) (primitive/code-list-new)
              (mut columns) (primitive/code-list-new)]
          (push! (mut fields) `(~field rt/Rel))
          (push! (mut inits) (primitive/code-symbol ":" (.name r)))
          (push! (mut inits) `(rt/rel-new ~(.arity r)))
          (push! (mut holds) `(rt/rel-held! (~access db)))
          (for i (range 0 4)
            (push! (mut columns)
                   (primitive/code-symbol ":" (subslice "abcd" i (+ i 1))))
            (if (< i (.arity r))
                (let [p (primitive/code-symbol "a" i)]
                  (push! (mut params) `(~p i64))
                  (push! (mut args) p)
                  (push! (mut columns) `(fact-column ~p)))
                (do
                  (push! (mut args) `0)
                  (push! (mut columns) `(: 0 i32)))))
          (push! (mut api)
                 `(defn ~add [(db (mut Db)) ~@params] (-> bool)
                    (rt/rel-add! (mut (~access db)) ~@args)))
          (push! (mut api)
                 `(defn ~has [(db (mut Db)) ~@params] (-> bool)
                    (rt/rel-has? (mut (~access db)) ~@args)))
          ;; A row of this relation as a value, to be added with the others: `fact-REL`.
          (push! (mut api)
                 `(defn ~(primitive/code-symbol "fact-" (.name r)) [~@params]
                    (-> Fact)
                    (Fact :rel (: ~index i32) ~@columns)))
          (push! (mut adds) `(= (.rel f) (: ~index i32)))
          (push! (mut adds)
                 `(do
                    (rt/rel-add! (mut (~access db))
                                 (cast i64 (.a f))
                                 (cast i64 (.b f))
                                 (cast i64 (.c f))
                                 (cast i64 (.d f)))
                    0))
          (push! (mut room)
                 `(when (> (get counts ~index) 0)
                    (rt/rel-reserve! (mut (~access db)) (get counts ~index))))
          (set! index (+ index 1))
          (push! (mut reserves) `(= name ~(.name r)))
          (push! (mut reserves) `(rt/rel-reserve! (mut (~access db)) n))))
      (for ci (range 0 (len clauses))
        (push! (mut rederive-fns) (rederive-code (mut c) (get clauses ci) ci)))
      (for group (groups-in-order rels clauses)
        (push! (mut updates) (update-stratum (mut c) rels clauses group)))
      (for r rels
        (let [f (field-sym (.name r))]
          (push! (mut same-checks)
                 `(unless (rt/rel-same-rows? (mut (~f db)) (mut (~f whole)))
                    (panic "solved-from: {} differs from solving afresh"
                           ~(.name r))))
          (if (derived? clauses (.name r))
              (push! (mut given-checks)
                     `(when (> (.count (~f wanted)) 0)
                        (panic "solved-from: facts are given for {}, which rules derive"
                               ~(.name r))))
              (push! (mut base-diffs)
                     `(let [lost
                              (rt/rel-diff-into! (mut (~f old))
                                                 (mut (~f wanted))
                                                 (mut (~f minus)))
                            gained
                              (rt/rel-diff-into! (mut (~f wanted))
                                                 (mut (~f old))
                                                 (mut (~f plus)))]
                        (set! rows (+ rows (.count (~f wanted))))
                        (when (> (+ lost gained) 0)
                          (set! (~f db) (~f wanted))
                          (set! changes (+ changes lost gained))))))))
      (for s (range 0 (+ top 1))
        (let [(mut group) (ArrayList::new [(slice u8)] (malloc-allocator))]
          (for r rels
            (when (and (= (.stratum r) s) (derived? clauses (.name r)))
              (push! (mut group) (.name r))))
          (push! (mut strata) (stratum-code (mut c) rels clauses group))))
      (dsl/render `(do
                     (import "hl.rt" :as rt)
                     (import "coil.arraylist" :use [ArrayList])
                     (import "coil.alloc" :use [malloc-allocator])
                     (import "coil.control" :use [return-from])
                     (defstruct Db [~@fields])
                     ;; A row of a relation, numbered in the file's order. Every id a relation holds fits in 32
                     ;; bits, which keeps a program's many rows small.
                     (defstruct Fact
                       [(rel i32) (a i32) (b i32) (c i32) (d i32)])
                     (defn fact-column [(v i64)] (-> i32)
                       (when (or (< v -2147483648) (> v 2147483647))
                         (panic "{} is too big for a fact" v))
                       (cast i32 v))
                     (defn new-db [] (-> Db)
                       (Db ~@inits))
                     ;;; What is being made holds `db`: each of its relations, whose memory is a region
                     ;;; of its own (see `rt/rel-new`), so a database made from another (`solved-from`)
                     ;;; holds the relations it shares with it, and not the other.
                     (defn regions-held! [(db Db)] (-> void)
                       ~@holds
                       0)
                     ;;; A database of these rows, in this order, and everything the rules derive from them.
                     (defn solved [(facts (ArrayList Fact))] (-> Db)
                       (let [(mut db) (new-db)]
                         (add-facts! (mut db) facts)
                         (solve! (mut db))
                         db))
                     ;;; Rows added in the order given, each relation made big enough for its own first.
                     (defn add-facts! [(db (mut Db)) (facts (ArrayList Fact))]
                       (-> void)
                       (let [(mut counts)
                               (ArrayList::new [i64] (malloc-allocator))]
                         (for i (range 0 ~index) (push! (mut counts) 0))
                         (for (ref f) facts
                           (let [r (cast i64 (.rel f))]
                             (set! (mut counts) r (+ (get counts r) 1))))
                         ~@room
                         (for (ref f) facts
                           (cond ~@adds :else
                                 (panic "no relation numbered {}" (.rel f))))
                         (free! (mut counts)))
                       0)
                     ~@api
                     ;;; Room in the relation named `name` for `n` more rows, which are known to be coming.
                     (defn reserve! [(db (mut Db)) (name (slice u8)) (n i64)]
                       (-> void)
                       (cond ~@reserves :else
                             (panic "no relation named {}" name))
                       0)
                     ;;; Run each stratum until a whole round adds nothing. Answers the rounds.
                     (defn solve! [(db (mut Db))] (-> i64)
                       (let [(mut rounds) 0]
                         ~@strata
                         rounds))
                     ~@rederive-fns
                     ;;; What `solved` makes of `facts`, made from `last`, what it made of other facts: only
                     ;;; what the facts that differ change is derived again or taken out (see
                     ;;; `update-stratum`). Facts are given rows of relations no rule derives. When most
                     ;;; of them differ, solving afresh costs less, and is what happens. `last` stays as
                     ;;; it was. With HL_CHECK_DATALOG set, each relation is checked against solving afresh.
                     (defn solved-from [(last Db) (facts (ArrayList Fact))]
                       (-> Db)
                       (let [(mut wanted) (new-db)]
                         (add-facts! (mut wanted) facts)
                         ~@given-checks
                         (let [(mut old) last
                               (mut db) last
                               (mut plus) (new-db)
                               (mut minus) (new-db)
                               (mut changes) 0
                               (mut rows) 0
                               (mut rounds) 0]
                           ~@base-diffs
                           (cond (= changes 0) last
                                 (> (* changes 4) rows) (solved facts)
                                 :else
                                   (do
                                     ~@updates
                                     (when (rt/env-on? "HL_CHECK_DATALOG")
                                       (let [(mut whole) (solved facts)]
                                         ~@same-checks
                                         0))
                                     db))))))))))

(defn read-facts [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
