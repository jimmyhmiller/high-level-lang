;;; `.facts`: the analysis language. Datalog over relations of interned ids,
;;; compiled to nested loops with hash indexes, run to a fixpoint. There is no engine
;;; at runtime.
;;;
;;;   facts
;;;   relation refs(from, to)
;;;   relation live(name)
;;;   live(Y) :- live(X), refs(X, Y) ;
;;;   visible(M, N, S) :- star(M, D), exported(D, N, S), !local(M, N) ;
;;;
;;; Negation is stratified: a negated relation is finished before any rule that reads
;;; it runs, and negation through a cycle is an error. A body atom scans through an
;;; index on its first two bound columns. Evaluation is semi-naive: every rule runs once,
;;; and after that a rule runs only from the rows the last round added to a relation it
;;; reads, starting its loops there.
;;;
;;; Generated API: `Db`, `new-db`, `add-REL!`, `has-REL?`, `solve!`, and each relation
;;; as a field of `Db`, read with `rt/rel-at`.
(module hl.facts)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice" :use [subslice])
(import "hl.rt" :as rt)
(import "coil.os" :as os)
(import "hl.dsl" :as dsl)
(import "hl.grammars.facts" :as g)

(reader-provider "hl.facts" read-facts)

(defstruct Relation [(name (slice u8)) (arity i64) (stratum i64)])

(defstruct Atom
  [(rel (slice u8))
   (args (ArrayList rt/Tok))
   (negated bool)
   (delta bool)
   ;; The database it reads: `db` (the one being solved), or, updating one (see `solved-from`), `old`
   ;; (as it was), `plus` (rows added) or `minus` (rows taken out).
   (src (slice u8))
   (tok rt/Tok)])

;;; A rule, and what its head does with a row: `db` and `minus` queue it there; `found` answers true
;;; (whether the head's row is derived, its columns bound beforehand: see `rederive-code`). A head may
;;; aggregate (`agg`: 0 none, 1 count, 2 sum, 3 min, 4 max) the body's answers in column `agg-col`,
;;; over each group of its other columns.
(defstruct Clause [(head Atom) (body (ArrayList Atom)) (sink (slice u8)) (agg i64) (agg-col i64)])

;;; `X != Y` in a body: a filter, once both are bound, not a relation.
(defn differs? [(a Atom)] (-> bool) (= (.rel a) "!="))

;;; The database an atom reads. The relation as it was (`old`) is the one being brought up to date,
;;; read as it began (see `row-seen`): it changes in place, and nothing is copied for what it was.
(defn src-sym [(a Atom)] (-> Code)
  (primitive/code-symbol (if (old? a) "db" (.src a))))

(defn old? [(a Atom)] (-> bool)
  (= (.src a) "old"))

;;; Whether atom `i`'s row is one the atom sees: as the relation was when it reads it as it was,
;;; else one that is in now.
(defn row-seen [(a Atom) (i i64)] (-> Code)
  (if (old? a)
      `(rt/rel-old-row? (mut (~(field-sym (.rel a)) ~(src-sym a))) ~(row-sym i))
      `(rt/rel-live-row? (mut (~(field-sym (.rel a)) ~(src-sym a))) ~(row-sym i))))

(defn field-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "." n))

(defn var-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "v-" n))

(defn row-sym [(i i64)] (-> Code)
  (primitive/code-symbol "row" i))

(defn ix-sym [(i i64)] (-> Code)
  (primitive/code-symbol "ix" i))

(defn bucket-sym [(i i64)] (-> Code)
  (primitive/code-symbol "bucket" i))

(defn count-sym [(i i64)] (-> Code)
  (primitive/code-symbol "count" i))

(defn arity-of [(rels (ArrayList Relation)) (c (mut dsl/Cur)) (a Atom)] (-> i64)
  (let [(mut out) -1]
    (for r rels (when (= (.name r) (.rel a)) (set! out (.arity r))))
    (when (< out 0)
      (dsl/die (mut c) (.tok a) (dsl/join2 "no relation named " (.rel a))))
    (when (!= out (len (.args a)))
      (dsl/die (mut c)
               (.tok a)
               (dsl/join2 "wrong number of columns for " (.rel a))))
    out))

;;; A grammar node's name as the token the error messages locate.
(defn tok-of [(src (slice u8)) (n g/Node)] (-> rt/Tok)
  (let [at (rt/line-col src (.lo n))]
    (rt/Tok
      :kind (rt/TIdent)
      :text (.text n)
      :line (.line at)
      :col (.col at))))

(defn atom-of [(src (slice u8)) (n g/Node) (negated bool)] (-> Atom)
  (let [name (get (.kids n) 0)
        (mut args) (ArrayList::new [rt/Tok] (malloc-allocator))]
    (for arg (.kids (get (.kids n) 1)) (push! (mut args) (tok-of src arg)))
    (Atom
      :rel (.text name)
      :args args
      :negated negated
      :delta false
      :src "db"
      :tok (tok-of src name))))

(defn body-atom-of [(src (slice u8)) (n g/Node)] (-> Atom)
  (cond (= (.kind n) (g/KNegated)) (atom-of src (get (.kids n) 0) true)
        (= (.kind n) (g/KDiffers))
          (let [(mut args) (ArrayList::new [rt/Tok] (malloc-allocator))]
            (push! (mut args) (tok-of src (get (.kids n) 0)))
            (push! (mut args) (tok-of src (get (.kids n) 1)))
            (Atom :rel "!=" :args args :negated false :delta false :src "db" :tok (tok-of src (get (.kids n) 0))))
        :else (atom-of src n false)))

;;; A head's column: its name, aggregated or not.
(defn head-arg-node [(n g/Node)] (-> g/Node)
  (if (or (= (.kind n) (g/KCount)) (= (.kind n) (g/KSum)) (= (.kind n) (g/KMin)) (= (.kind n) (g/KMax)))
      (get (.kids n) 0)
      n))

(defn agg-kind [(n g/Node)] (-> i64)
  (cond (= (.kind n) (g/KCount)) 1
        (= (.kind n) (g/KSum)) 2
        (= (.kind n) (g/KMin)) 3
        (= (.kind n) (g/KMax)) 4
        :else 0))

(defn head-of [(src (slice u8)) (n g/Node)] (-> Atom)
  (let [name (get (.kids n) 0)
        (mut args) (ArrayList::new [rt/Tok] (malloc-allocator))]
    (for arg (.kids (get (.kids n) 1)) (push! (mut args) (tok-of src (head-arg-node arg))))
    (Atom :rel (.text name) :args args :negated false :delta false :src "db" :tok (tok-of src name))))

(defn bound? [(bound (ArrayList (slice u8))) (n (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for b bound (when (= b n) (set! hit true)))
    hit))

;;; The four column arguments for a row call, unused columns as 0.
(defn row-args [(a Atom)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for i (range 0 4)
      (if (< i (len (.args a)))
          (push! (mut out) (var-sym (.text (get (.args a) i))))
          (push! (mut out) `0)))
    `(~@out)))

(defn head-add [(c (mut dsl/Cur))
                (k Clause)
                (bound (ArrayList (slice u8)))
                (sink (slice u8))]
  (-> Code)
  (let [a (.head k)]
  (for t (.args a)
    (unless (bound? bound (.text t))
      (dsl/die (mut c)
               t
               (dsl/join3 "the head variable "
                          (.text t)
                          " is not bound by the body"))))
  (cond (> (.agg k) 0)
          ;; One more answer in its group: the head's other columns, then the aggregated one.
          (let [(mut groups) (primitive/code-list-new)
                (mut n) 0]
            (for i (range 0 (len (.args a)))
              (unless (= i (.agg-col k))
                (push! (mut groups) (var-sym (.text (get (.args a) i))))
                (set! n (+ n 1))))
            (for _ (range n 3) (push! (mut groups) `0))
            `(rt/agg-step! (mut agg) ~@groups ~(var-sym (.text (get (.args a) (.agg-col k))))))
        (= sink "found") `(return-from :found true)
        ;; A rule run as a task of a round (see `stratum-rounds`) queues what it finds for itself.
        (= sink "rule-out") `(rt/row-queue! rule-out ~@(row-args a))
        :else
          `(rt/rel-queue! (mut (~(field-sym (.rel a)) ~(primitive/code-symbol sink)))
                          ~@(row-args a)))))

;;; A row going where `sink` says, its four columns given.
(defn sink-code [(rel (slice u8)) (sink (slice u8)) (cols Code)] (-> Code)
  (if (= sink "rule-out")
      `(rt/row-queue! rule-out ~@cols)
      `(rt/rel-queue! (mut (~(field-sym rel) ~(primitive/code-symbol sink))) ~@cols)))

;;; A rule's code, its body's joins from nothing bound. An aggregate's answers are gathered by
;;; group, and each group is then one row of its head: its columns, and the aggregate in its place.
(defn rule-code [(c (mut dsl/Cur)) (k Clause)] (-> Code)
  (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
        joins (atoms-code (mut c) k 0 (mut bound))]
    (if (= (.agg k) 0)
        joins
        (let [head (.head k)
              arity (len (.args head))
              (mut cols) (primitive/code-list-new)
              (mut g) 0]
          (for i (range 0 4)
            (cond (>= i arity) (push! (mut cols) `0)
                  (= i (.agg-col k)) (push! (mut cols) `(rt/agg-value (mut agg) group))
                  :else (do (push! (mut cols) `(rt/agg-group (mut agg) group ~g)) (set! g (+ g 1)))))
          `(let [(mut agg) (rt/agg-new ~(- arity 1) ~(.agg k))]
             ~joins
             (for group (range 0 (rt/agg-count (mut agg)))
               ~(sink-code (.rel head) (.sink k) `(~@cols))))))))

;;; Test or bind column `col` of the row atom `i` holds, then continue.
(defn columns-code [(c (mut dsl/Cur))
                    (k Clause)
                    (i i64)
                    (col i64)
                    (bound (mut (ArrayList (slice u8))))] (-> Code)
  (let [a (get (.body k) i)]
    (if (>= col (len (.args a)))
        (atoms-code (mut c) k (+ i 1) (mut bound))
        (let [n (.text (get (.args a) col))
              value
                `(rt/rel-at (mut (~(field-sym (.rel a)) ~(src-sym a)))
                            ~(row-sym i)
                            ~col)]
          (if (bound? bound n)
              `(when (= ~value ~(var-sym n))
                 ~(columns-code (mut c) k i (+ col 1) (mut bound)))
              (do
                (push! (mut bound) n)
                `(let [~(var-sym n) ~value]
                   ~(columns-code (mut c) k i (+ col 1) (mut bound)))))))))

;;; Atom `i`: a membership test when negated; otherwise a scan, through an index on
;;; its first bound column if it has one.
(defn atoms-code [(c (mut dsl/Cur))
                  (k Clause)
                  (i i64)
                  (bound (mut (ArrayList (slice u8))))] (-> Code)
  (if (>= i (len (.body k)))
      (head-add (mut c) k bound (.sink k))
      (let [a (get (.body k) i)
            rel (field-sym (.rel a))
            db (src-sym a)]
        (if (differs? a)
            (do
              (for t (.args a)
                (unless (bound? bound (.text t))
                  (dsl/die (mut c) t (dsl/join3 "the variable " (.text t) " of != must be bound earlier in the body"))))
              `(when (!= ~(var-sym (.text (get (.args a) 0))) ~(var-sym (.text (get (.args a) 1))))
                 ~(atoms-code (mut c) k (+ i 1) (mut bound))))
        (if (.negated a)
            (do
              (for t (.args a)
                (unless (bound? bound (.text t))
                  (dsl/die (mut c)
                           t
                           (dsl/join3 "the negated variable "
                                      (.text t)
                                      " must be bound earlier in the body"))))
              (if (old? a)
                  `(unless (rt/rel-has-old? (mut (~rel ~db)) ~@(row-args a))
                     ~(atoms-code (mut c) k (+ i 1) (mut bound)))
                  `(unless (rt/rel-has? (mut (~rel ~db)) ~@(row-args a))
                     ~(atoms-code (mut c) k (+ i 1) (mut bound)))))
            (let [(mut key-col) -1
                  (mut key-col2) -1]
              (for j (range 0 (len (.args a)))
                (when (bound? bound (.text (get (.args a) j)))
                  (if (< key-col 0)
                      (set! key-col j)
                      (when (and (< key-col2 0)
                                 (!= (.text (get (.args a) j))
                                     (.text (get (.args a) key-col))))
                        (set! key-col2 j)))))
              (cond (.delta a)
                      (let [body (columns-code (mut c) k i 0 (mut bound))]
                        `(for ~(row-sym i) (range (.delta-from (~rel ~db))
                                                  (.delta-to (~rel ~db)))
                           ~body))
                    (>= key-col2 0)
                      (let [key (var-sym (.text (get (.args a) key-col)))
                            key2 (var-sym (.text (get (.args a) key-col2)))
                            body (columns-code (mut c) k i 0 (mut bound))]
                        `(let [~(bucket-sym i)
                                 (rt/rel-bucket2 (mut (~rel ~db))
                                                 ~key-col
                                                 ~key-col2
                                                 ~key
                                                 ~key2)]
                           (for ~(row-sym i) ~(bucket-sym i)
                             (when ~(row-seen a i) ~body))))
                    (>= key-col 0)
                      (let [key (var-sym (.text (get (.args a) key-col)))
                            body (columns-code (mut c) k i 0 (mut bound))]
                        `(let [~(bucket-sym i)
                                 (rt/rel-bucket (mut (~rel ~db)) ~key-col ~key)]
                           (for ~(row-sym i) ~(bucket-sym i)
                             (when ~(row-seen a i) ~body))))
                    :else
                      (let [body (columns-code (mut c) k i 0 (mut bound))]
                        `(for ~(row-sym i) (range 0 ~(if (old? a)
                                                          `(.start (~rel ~db))
                                                          `(.count (~rel ~db))))
                           (when ~(row-seen a i) ~body))))))))))

;;; Does any rule add to this relation? One that none does never has a delta.
(defn derived? [(clauses (ArrayList Clause)) (name (slice u8))] (-> bool)
  (let [(mut hit) false]
    (for k clauses (when (= (.rel (.head k)) name) (set! hit true)))
    hit))

;;; How many of an atom's columns the atoms before it have bound.
(defn bound-columns [(a Atom) (bound (ArrayList (slice u8)))] (-> i64)
  (let [(mut n) 0]
    (for t (.args a) (when (bound? bound (.text t)) (set! n (+ n 1))))
    n))

;;; The join order: the first atom stays first, and then whichever atom the variables so far pin
;;; down best, so a loop is never a scan that something else could have narrowed. A negated atom
;;; waits until all its variables are bound, and then goes at once, since it can only filter.
(defn planned [(k Clause)] (-> Clause)
  (planned-from k (ArrayList::new [(slice u8)] (malloc-allocator)) true))

;;; The same with `given` bound before any atom (a head's variables, checking whether a row is
;;; derived), and with no atom kept first unless `keep-first`.
(defn planned-from [(k Clause) (given (ArrayList (slice u8))) (keep-first bool)]
  (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))
        (mut used) (ArrayList::new [bool] (malloc-allocator))
        (mut bound) given
        n (len (.body k))]
    (for _ (range 0 n) (push! (mut used) false))
    (for _ (range 0 n)
      (let [(mut best) -1
            (mut best-score) -1]
        (for i (range 0 n)
          (unless (get used i)
            (let [a (get (.body k) i)
                  have (bound-columns a bound)
                  whole (= have (len (.args a)))
                  filter (or (.negated a) (differs? a))
                  score
                    (cond (and filter whole) 1000
                          filter -2
                          (and keep-first (= i 0)) 2000
                          :else have)]
              (when (> score best-score)
                (set! best i)
                (set! best-score score)))))
        ;; Only negated atoms are left, and their variables never get bound: report that as written.
        (when (< best 0)
          (for i (range 0 n)
            (when (and (< best 0) (not (get used i))) (set! best i))))
        (let [a (get (.body k) best)]
          (set! (mut used) best true)
          (push! (mut body) a)
          (unless (or (.negated a) (differs? a))
            (for t (.args a)
              (unless (bound? bound (.text t)) (push! (mut bound) (.text t))))))))
    (Clause
      :head (.head k)
      :body body
      :sink (.sink k)
      :agg (.agg k)
      :agg-col (.agg-col k))))

;;; The clause with atom `at` moved first, and reading only that relation's delta. Everything
;;; else still reads the whole of its relation, which can find a row twice but never miss one.
(defn delta-variant [(k Clause) (at i64)] (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))
        a (get (.body k) at)]
    (push! (mut body)
           (Atom
             :rel (.rel a)
             :args (.args a)
             :negated false
             :delta true
             :src (.src a)
             :tok (.tok a)))
    (for i (range 0 (len (.body k)))
      (when (!= i at) (push! (mut body) (get (.body k) i))))
    (planned (Clause
               :head (.head k)
               :body body
               :sink (.sink k)
               :agg (.agg k)
               :agg-col (.agg-col k)))))

;;; Stratum of each relation: at least a body relation's, above a negated one's.
(defn stratify! [(rels (mut (ArrayList Relation)))
                 (clauses (ArrayList Clause))
                 (c (mut dsl/Cur))] (-> i64)
  (let [(mut changed) true
        (mut top) 0
        limit (+ (len rels) 1)]
    (while changed
      (set! changed false)
      (for k clauses
        (let [head-at (rel-index rels (.rel (.head k)))
              (mut need) (.stratum (get rels head-at))]
          (for a (.body k)
            (unless (differs? a)
              (let [s (.stratum (get rels (rel-index rels (.rel a))))
                    required (if (or (.negated a) (> (.agg k) 0)) (+ s 1) s)]
                (when (> required need) (set! need required)))))
          (when (> need (.stratum (get rels head-at)))
            (when (> need limit)
              (dsl/die (mut c)
                       (.tok (.head k))
                       "this rule depends on its own negation, or aggregates what depends on it"))
            (let [r (get rels head-at)]
              (set! (mut rels)
                    head-at
                    (Relation
                      :name (.name r)
                      :arity (.arity r)
                      :stratum need)))
            (when (> need top) (set! top need))
            (set! changed true)))))
    top))

;;; The relations of `group` solved over `db` from what is there, every relation they read outside it
;;; finished: every rule once, then from each round's new rows until a round adds none.
;;; Built with HL_RULE_TIMES set, each rule's work is timed, by its head, its body and which of
;;; its atoms drives it ("first" for the whole rule once, "new R" for the rows R gained in a
;;; round), and `solve!` says where the time went (`rt/rule-times-report!`). Built without it,
;;; nothing changes.
(defn rule-times? [] (-> bool)
  (!= (primitive/cast i64 (os/getenv c"HL_RULE_TIMES")) 0))

(defn rule-timed [(k Clause) (which (slice u8)) (code Code)] (-> Code)
  (if (rule-times?)
      (let [(mut label) (rt/join (.rel (.head k)) " <-")]
        (for a (.body k)
          (set! label (rt/join label (rt/join (if (.negated a) " not " " ") (.rel a)))))
        (set! label (rt/join label (rt/join " [" (rt/join which "]"))))
        `(let [rule-started (rt/now-ns)]
           ~code
           (rt/rule-time! ~label (- (rt/now-ns) rule-started))))
      code))

(defn stratum-code [(c (mut dsl/Cur))
                    (rels (ArrayList Relation))
                    (clauses (ArrayList Clause))
                    (group (ArrayList (slice u8)))] (-> Code)
  (let [(mut once) (primitive/code-list-new)
        (mut again) (primitive/code-list-new)
        (mut marks) (primitive/code-list-new)
        (mut starts) (primitive/code-list-new)]
    (for r rels
      (when (bound? group (.name r))
        (push! (mut starts)
               `(rt/rel-advance! (mut (~(field-sym (.name r)) db))))
        (push! (mut marks)
               `(when (rt/rel-advance! (mut (~(field-sym (.name r)) db)))
                  (set! changed true)))))
    (for k clauses
      (when (bound? group (.rel (.head k)))
        (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
              flush (field-sym (.rel (.head k)))]
          (push! (mut once)
                 (rule-timed k
                             "first"
                             `(do
                                ~(rule-code (mut c) (planned k))
                                (rt/rel-flush! (mut (~flush db))))))
          (for i (range 0 (len (.body k)))
            (let [a (get (.body k) i)
                  ra (rel-index rels (.rel a))]
              (when (and (not (.negated a)) (bound? group (.rel a)))
                (let [(mut b2) (ArrayList::new [(slice u8)] (malloc-allocator))]
                  (push! (mut again)
                         `(when (rt/rel-delta? (mut (~(field-sym (.rel a)) db)))
                            ~(rule-timed k
                                         (rt/join "new " (.rel a))
                                         `(do
                                            ~(atoms-code (mut c)
                                                         (delta-variant k i)
                                                         0
                                                         (mut b2))
                                            (rt/rel-flush! (mut (~flush db))))))))))))))
    `(do
       ~@starts
       ~@once
       (let [(mut changed) true]
         (while changed
           (set! changed false)
           (set! rounds (+ rounds 1))
           ~@marks
           (when changed ~@again))))))

;;; A rule with its head's rows going to the queue of whichever task runs it.
(defn to-rule-out [(k Clause)] (-> Clause)
  (Clause :head (.head k) :body (.body k) :sink "rule-out" :agg (.agg k) :agg-col (.agg-col k)))

;;; A stratum solved in rounds whose rules run at once. Each rule, and each rule driven by the
;;; rows one of its atoms gained in the last round, is a task: it reads the relations as they
;;; stood when the round began and queues what it finds for itself. When every task is done the
;;; queues are added to the relations, in the tasks' order, and what was new drives the next
;;; round. A relation is read by many and written by none while a round's tasks run; the order
;;; rows are added in is the tasks', whichever thread ran each.
;;; What solves the stratum, and the function that runs one of its rules.
(defstruct Rounds [(solve Code) (run Code)])

(defn stratum-rounds [(c (mut dsl/Cur))
                      (rels (ArrayList Relation))
                      (clauses (ArrayList Clause))
                      (group (ArrayList (slice u8)))
                      (stratum i64)] (-> Rounds)
  (let [(mut marks) (primitive/code-list-new)
        (mut starts) (primitive/code-list-new)
        (mut arms) (primitive/code-list-new)
        (mut firsts) (primitive/code-list-new)
        (mut driven) (primitive/code-list-new)
        (mut heads) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut rule-heads) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut take-arms) (primitive/code-list-new)
        run (primitive/code-symbol (rt/join "rules-run-" (rt/num-text stratum)))
        take (primitive/code-symbol (rt/join "rules-take-" (rt/num-text stratum)))
        (mut n) 0]
    (for r rels
      (when (bound? group (.name r))
        (push! (mut starts)
               `(rt/rel-advance! (mut (~(field-sym (.name r)) db))))
        (push! (mut marks)
               `(when (rt/rel-advance! (mut (~(field-sym (.name r)) db)))
                  (set! changed true)))))
    (for k clauses
      (when (bound? group (.rel (.head k)))
        (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
              head (field-sym (.rel (.head k)))]
          (push! (mut arms) `(= rule ~n))
          (push! (mut arms)
                 (rule-timed k "first" (rule-code (mut c) (to-rule-out (planned k)))))
          (push! (mut firsts) `(set! (mut active) ~n true))
          (push! (mut driven) `(set! (mut active) ~n false))
          (push! (mut rule-heads) (.rel (.head k)))
          (unless (bound? heads (.rel (.head k))) (push! (mut heads) (.rel (.head k))))
          (set! n (+ n 1))
          (for i (range 0 (len (.body k)))
            (let [a (get (.body k) i)]
              (when (and (not (.negated a)) (bound? group (.rel a)))
                (let [(mut b2) (ArrayList::new [(slice u8)] (malloc-allocator))]
                  (push! (mut arms) `(= rule ~n))
                  (push! (mut arms)
                         (rule-timed k
                                     (rt/join "new " (.rel a))
                                     (atoms-code (mut c) (to-rule-out (delta-variant k i)) 0 (mut b2))))
                  (push! (mut firsts) `(set! (mut active) ~n false))
                  (push! (mut driven)
                         `(set! (mut active) ~n (rt/rel-delta? (mut (~(field-sym (.rel a)) db)))))
                  (push! (mut rule-heads) (.rel (.head k)))
                  (set! n (+ n 1)))))))))
    ;; What the rules queued goes into their heads' relations a relation at a time, each
    ;; relation's rules in their order: a relation is its own memory, and many are filled at once.
    (for h (range 0 (len heads))
      (let [(mut takes) (primitive/code-list-new)]
        (for i (range 0 n)
          (when (= (get rule-heads i) (get heads h))
            (push! (mut takes)
                   `(rt/rel-take! (mut (~(field-sym (get heads h)) db)) (elem outs ~i)))))
        (push! (mut take-arms) `(= head ~h))
        (push! (mut take-arms) `(do ~@takes 0))))
    (Rounds
      :run
        `(do
           (defn ~run [(arg (ptr i8)) (rule i64) (out (ptr i8))] (-> (ptr i8))
             (let [db (primitive/cast (ptr Db) arg)
                   rule-out (primitive/cast (ptr (ArrayList i64)) out)]
               (cond ~@arms :else 0)
               arg))
           (defn ~take [(arg (ptr i8)) (head i64) (queued (ptr i8))] (-> (ptr i8))
             (let [db (primitive/cast (ptr Db) arg)
                   outs (primitive/cast (ptr (ArrayList (ArrayList i64))) queued)]
               (cond ~@take-arms :else 0)
               arg)))
      :solve
    (if (= n 0)
        `(do ~@starts 0)
        `(let [(mut outs) (rt/rule-outs ~n)
               (mut active) (rt/rule-flags ~n)]
           ~@starts
           ~@firsts
           (rt/rules-run! (primitive/cast (ptr i8) (mut db)) (fnptr-of ~run) active (mut outs))
           (rt/rules-take! (primitive/cast (ptr i8) (mut db)) (fnptr-of ~take) ~(len heads) (mut outs))
           (let [(mut changed) true]
             (while changed
               (set! changed false)
               (set! rounds (+ rounds 1))
               ~@marks
               (when changed
                 ~@driven
                 (rt/rules-run! (primitive/cast (ptr i8) (mut db)) (fnptr-of ~run) active (mut outs))
                 (rt/rules-take! (primitive/cast (ptr i8) (mut db)) (fnptr-of ~take) ~(len heads) (mut outs)))))
           (rt/rule-outs-free! (mut outs))
           (free! (mut active))
           0)))))

;; ---------------------------------------------------------------- updating a solved database

;;; An atom as a variant of a rule reads it: from `src`, negated or not, only the last round's rows.
(defn with-src [(a Atom) (src (slice u8)) (negated bool) (delta bool)] (-> Atom)
  (Atom
    :rel (.rel a)
    :args (.args a)
    :negated negated
    :delta delta
    :src src
    :tok (.tok a)))

;;; Rule `k` driven by `first` in place of its atom `at` (kept too, reading `rest`, when `keep`), every
;;; other atom reading `rest`, its head going to `sink`.
(defn variant [(k Clause)
               (at i64)
               (first Atom)
               (keep bool)
               (rest (slice u8))
               (sink (slice u8))] (-> Clause)
  (let [(mut body) (ArrayList::new [Atom] (malloc-allocator))]
    (push! (mut body) first)
    (for i (range 0 (len (.body k)))
      (when (or keep (!= i at))
        (let [b (get (.body k) i)]
          (push! (mut body) (with-src b rest (.negated b) false)))))
    (planned (Clause
               :head (.head k)
               :body body
               :sink sink
               :agg (.agg k)
               :agg-col (.agg-col k)))))

(defn stratum-of [(rels (ArrayList Relation)) (n (slice u8))] (-> i64)
  (.stratum (get rels (rel-index rels n))))

;;; The derived relations in groups that derive each other (each group's rules read the relations of
;;; no later group), in the order they can be brought up to date: what each reads outside it first.
(defn groups-in-order [(rels (ArrayList Relation)) (clauses (ArrayList Clause))]
  (-> (ArrayList (ArrayList (slice u8))))
  (let [(mut names) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut reach) (ArrayList::new [bool] (malloc-allocator))]
    (for r rels
      (when (derived? clauses (.name r)) (push! (mut names) (.name r))))
    (let [n (len names)]
      (for _ (range 0 (* n n)) (push! (mut reach) false))
      ;; Which reads which, then what each reaches through others.
      (for k clauses
        (let [h (name-at names (.rel (.head k)))]
          (for a (.body k)
            (let [b (name-at names (.rel a))]
              (when (>= b 0) (set! (mut reach) (+ (* h n) b) true))))))
      (for m (range 0 n)
        (for i (range 0 n)
          (when (get reach (+ (* i n) m))
            (for j (range 0 n)
              (when (get reach (+ (* m n) j))
                (set! (mut reach) (+ (* i n) j) true))))))
      (let [(mut placed) (ArrayList::new [bool] (malloc-allocator))
            (mut out)
              (ArrayList::new [(ArrayList (slice u8))] (malloc-allocator))
            (mut left) n]
        (for _ (range 0 n) (push! (mut placed) false))
        (while (> left 0)
          (let [(mut took) false]
            (for i (range 0 n)
              (unless (or took (get placed i))
                ;; Its group: what it reaches that reaches it. Ready when all it reaches outside the
                ;; group is placed.
                (let [(mut group) (ArrayList::new [i64] (malloc-allocator))
                      (mut ready) true]
                  (push! (mut group) i)
                  (for j (range 0 n)
                    (when (and (!= j i)
                               (get reach (+ (* i n) j))
                               (get reach (+ (* j n) i)))
                      (push! (mut group) j)))
                  (for g group
                    (for j (range 0 n)
                      (when (and (get reach (+ (* g n) j)) (not (get placed j)))
                        (let [(mut inside) false]
                          (for h group (when (= h j) (set! inside true)))
                          (unless inside (set! ready false))))))
                  (when ready
                    (let [(mut members)
                            (ArrayList::new [(slice u8)] (malloc-allocator))]
                      (for g group
                        (set! (mut placed) g true)
                        (push! (mut members) (get names g)))
                      (set! left (- left (len group)))
                      (push! (mut out) members)
                      (set! took true))))))
            (unless took
              (panic "facts: no group of relations is ready to bring up to date"))))
        out))))

(defn name-at [(names (ArrayList (slice u8))) (n (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len names)) (when (= (get names i) n) (set! out i)))
    out))

(defn count-of [(n (slice u8)) (db (slice u8))] (-> Code)
  `(.count (~(field-sym n) ~(primitive/code-symbol db))))

(defn flush-of [(n (slice u8)) (db (slice u8))] (-> Code)
  `(rt/rel-flush! (mut (~(field-sym n) ~(primitive/code-symbol db)))))

(defn start-sym [(n (slice u8))] (-> Code)
  (primitive/code-symbol "start-" n))

(defn rederive-sym [(i i64)] (-> Code)
  (primitive/code-symbol "rederived-" i))

;;; A list of its own with `xs`'s names.
(defn texts-copy [(xs (ArrayList (slice u8)))] (-> (ArrayList (slice u8)))
  (let [(mut out) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (for x xs (push! (mut out) x))
    out))

;;; A rule's joins, from its first atom with nothing bound.
(defn joined-code [(c (mut dsl/Cur)) (k Clause)] (-> Code)
  (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))]
    (atoms-code (mut c) k 0 (mut bound))))

;;; Whether rule `k` (the i-th) derives the row `a0`..`a3` of its head from `db` as it is: its head's
;;; variables bound to the row's columns, then its body, every atom reading `db`.
(defn rederive-code [(c (mut dsl/Cur)) (k Clause) (i i64)] (-> Code)
  (if (> (.agg k) 0)
      ;; Its stratum is always solved afresh (see `update-stratum`).
      `(defn ~(rederive-sym i) [(db (mut Db)) (a0 i64) (a1 i64) (a2 i64) (a3 i64)] (-> bool)
         (panic "an aggregate's row is never derived again by itself"))
  (let [(mut bound) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut binds) (ArrayList::new [i64] (malloc-allocator))
        head (.head k)]
    (for j (range 0 (len (.args head)))
      (let [n (.text (get (.args head) j))]
        (if (bound? bound n)
            (push! (mut binds) -1)
            (do (push! (mut bound) n) (push! (mut binds) j)))))
    (let [(mut checks) (primitive/code-list-new)
          (mut lets) (primitive/code-list-new)
          inner
            (atoms-code (mut c)
                        (planned-from (Clause
                                        :head head
                                        :body (.body k)
                                        :sink "found"
                                        :agg 0
                                        :agg-col -1)
                                      (texts-copy bound)
                                      false)
                        0
                        (mut bound))]
      (for j (range 0 (len (.args head)))
        (let [n (.text (get (.args head) j))
              col (primitive/code-symbol "a" j)]
          (if (>= (get binds j) 0)
              (do (push! (mut lets) (var-sym n)) (push! (mut lets) col))
              (push! (mut checks) `(= ~(var-sym n) ~col)))))
      `(defn ~(rederive-sym i) [(db (mut Db))
                                (a0 i64)
                                (a1 i64)
                                (a2 i64)
                                (a3 i64)] (-> bool)
         (block :found
           (let [~@lets]
             (when (and true ~@checks) ~inner))
           false))))))

;;; Stratum `s` brought up to date from what changed below it, by deleting and deriving again: what
;;; a row taken out below, or one added to a relation read negated, derived in the old database is
;;; taken out (`minus`); what is still derived from what is left goes back; and what the rows added
;;; below, or those taken out of a relation read negated, derive is added, to a fixpoint. Then what
;;; changed in this stratum, for those above: `plus` the rows it gained, `minus` those it lost.
(defn update-stratum [(c (mut dsl/Cur))
                      (rels (ArrayList Relation))
                      (clauses (ArrayList Clause))
                      (group (ArrayList (slice u8)))] (-> Code)
  (let [(mut mine) (ArrayList::new [Relation] (malloc-allocator))
        (mut reads) (ArrayList::new [(slice u8)] (malloc-allocator))
        (mut touched) (primitive/code-list-new)
        (mut del-starts) (primitive/code-list-new)
        (mut del-seeds) (primitive/code-list-new)
        (mut del-marks) (primitive/code-list-new)
        (mut del-again) (primitive/code-list-new)
        (mut removes) (primitive/code-list-new)
        (mut starts) (primitive/code-list-new)
        (mut rederives) (primitive/code-list-new)
        (mut ins-seeds) (primitive/code-list-new)
        (mut ins-marks) (primitive/code-list-new)
        (mut ins-again) (primitive/code-list-new)
        (mut finals) (primitive/code-list-new)
        (mut sizes) (primitive/code-list-new)
        (mut gone-counts) (primitive/code-list-new)
        (mut empties) (primitive/code-list-new)
        (mut whole-finals) (primitive/code-list-new)]
    (for r rels (when (bound? group (.name r)) (push! (mut mine) r)))
    (for ci (range 0 (len clauses))
      (let [k (get clauses ci)
            h (.rel (.head k))]
        (when (and (bound? group h) (> (.agg k) 0))
          (for a (.body k)
            (unless (or (differs? a) (bound? reads (.rel a))) (push! (mut reads) (.rel a)))))
        (when (and (bound? group h) (= (.agg k) 0))
          (for i (range 0 (len (.body k)))
            (let [a (get (.body k) i)
                  l (.rel a)]
              (if (differs? a)
                  0
              (if (not (bound? group l))
                  (do
                    (unless (bound? reads l) (push! (mut reads) l))
                    (if (.negated a)
                        (do
                          (push! (mut del-seeds)
                                 `(when (> ~(count-of l "plus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "plus"
                                                                     false
                                                                     false)
                                                           false
                                                           "old"
                                                           "minus"))
                                    ~(flush-of h "minus")))
                          (push! (mut ins-seeds)
                                 `(when (> ~(count-of l "minus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "minus"
                                                                     false
                                                                     false)
                                                           true
                                                           "db"
                                                           "db"))
                                    ~(flush-of h "db"))))
                        (do
                          (push! (mut del-seeds)
                                 `(when (> ~(count-of l "minus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "minus"
                                                                     false
                                                                     false)
                                                           false
                                                           "old"
                                                           "minus"))
                                    ~(flush-of h "minus")))
                          (push! (mut ins-seeds)
                                 `(when (> ~(count-of l "plus") 0)
                                    ~(joined-code (mut c)
                                                  (variant k
                                                           i
                                                           (with-src a
                                                                     "plus"
                                                                     false
                                                                     false)
                                                           false
                                                           "db"
                                                           "db"))
                                    ~(flush-of h "db"))))))
                  ;; Read from this stratum: rows it gains or loses as the rounds go.
                  (unless (.negated a)
                    (push! (mut del-again)
                           `(when (rt/rel-delta? (mut (~(field-sym l) minus)))
                              ~(joined-code (mut c)
                                            (variant k
                                                     i
                                                     (with-src a
                                                               "minus"
                                                               false
                                                               true)
                                                     false
                                                     "old"
                                                     "minus"))
                              ~(flush-of h "minus")))
                    (push! (mut ins-again)
                           `(when (rt/rel-delta? (mut (~(field-sym l) db)))
                              ~(joined-code (mut c)
                                            (variant k
                                                     i
                                                     (with-src a
                                                               "db"
                                                               false
                                                               true)
                                                     false
                                                     "db"
                                                     "db"))
                              ~(flush-of h "db")))))))))))
    (for l reads
      (push! (mut touched) `(> ~(count-of l "plus") 0))
      (push! (mut touched) `(> ~(count-of l "minus") 0)))
    (for r mine
      (let [f (field-sym (.name r))
            n (.name r)
            (mut tests) (primitive/code-list-new)]
        (push! (mut del-starts) `(rt/rel-advance! (mut (~f minus))))
        (push! (mut del-marks)
               `(when (rt/rel-advance! (mut (~f minus))) (set! changed true)))
        ;; What was taken out, out of the relation itself; what reads it as it was still sees it.
        (push! (mut removes)
               `(rt/rel-kill-rows! (mut (~f db)) (mut (~f minus))))
        (push! (mut starts) (start-sym n))
        (push! (mut starts) (count-of n "db"))
        (for ci (range 0 (len clauses))
          (when (= (.rel (.head (get clauses ci))) n)
            (push! (mut tests) `(~(rederive-sym ci) (mut db) a0 a1 a2 a3))))
        (push! (mut rederives)
               `(for row (range 0 ~(count-of n "minus"))
                  (let [a0 (rt/row-col (mut (~f minus)) row 0)
                        a1 (rt/row-col (mut (~f minus)) row 1)
                        a2 (rt/row-col (mut (~f minus)) row 2)
                        a3 (rt/row-col (mut (~f minus)) row 3)]
                    (when (or false ~@tests)
                      (rt/rel-add! (mut (~f db)) a0 a1 a2 a3)))))
        (push! (mut ins-marks)
               `(when (rt/rel-advance! (mut (~f db))) (set! changed true)))
        (push! (mut sizes) (count-of n "old"))
        (push! (mut gone-counts) (count-of n "minus"))
        ;; Solving the stratum afresh: everything in it taken out, and derived again after.
        (push! (mut empties) `(rt/rel-kill-all! (mut (~f db))))
        (push! (mut whole-finals)
               `(let [(mut gained) (rt/rel-new ~(.arity r))
                      (mut lost) (rt/rel-new ~(.arity r))]
                  (rt/rel-whole-diff! (mut (~f db)) (mut gained) (mut lost))
                  (set! (~f plus) gained)
                  (set! (~f minus) lost)))
        (push! (mut finals)
               `(let [(mut gone) (rt/rel-new ~(.arity r))]
                  (rt/rel-range-diff-into! (mut (~f db))
                                           ~(start-sym n)
                                           ~(count-of n "db")
                                           (mut (~f minus))
                                           (mut (~f plus)))
                  (rt/rel-diff-into! (mut (~f minus)) (mut (~f db)) (mut gone))
                  (set! (~f minus) gone)))))
    (cond (= (len mine) 0)
        `0
        ;; An aggregate's group, whenever anything it reads changed, is worked out afresh.
        (aggregate-group? clauses group)
        `(when (or false ~@touched)
           ~@empties
           ~(stratum-code (mut c) rels clauses group)
           ~@whole-finals
           0)
        :else
        ;; Taking out more than a quarter of the stratum's rows (a change reaching most of what it
        ;; derives, through its recursion), deriving them back one at a time costs more than solving
        ;; the stratum afresh from the strata below, as they now are; and so that is done.
        `(when (or false ~@touched)
           (let [cap (/ (+ 0 ~@sizes) 4)
                 (mut whole) false]
             ~@del-starts
             ~@del-seeds
             (let [(mut changed) true]
               (while (and changed (not whole))
                 (set! changed false)
                 ~@del-marks
                 (when (> (+ 0 ~@gone-counts) cap) (set! whole true))
                 (when (and changed (not whole)) ~@del-again)))
             (if whole
                 (do
                   ~@empties
                   ~(stratum-code (mut c) rels clauses group)
                   ~@whole-finals
                   0)
                 (do
                   ~@removes
                   (let [~@starts]
                     ~@rederives
                     ~@ins-seeds
                     (let [(mut changed) true]
                       (while changed
                         (set! changed false)
                         (set! rounds (+ rounds 1))
                         ~@ins-marks
                         (when changed ~@ins-again)))
                     ~@finals)
                   0)))))))

(defn aggregate-group? [(clauses (ArrayList Clause)) (group (ArrayList (slice u8)))] (-> bool)
  (let [(mut hit) false]
    (for k clauses (when (and (> (.agg k) 0) (bound? group (.rel (.head k)))) (set! hit true)))
    hit))

(defn rel-index [(rels (ArrayList Relation)) (n (slice u8))] (-> i64)
  (let [(mut out) -1]
    (for i (range 0 (len rels))
      (when (= (.name (get rels i)) n) (set! out i)))
    out))

(defn module-text [(context Code)] (-> (slice u8))
  (let [src (dsl/source-of context)
        path (dsl/path-of context)
        (mut c) (dsl/cursor "" path "")
        tree
          (match (g/parse-result src path 0)
            (Ok [t] t)
            (Err [e]
                 (dsl/fail-at path
                              (.line e)
                              (.col e)
                              (dsl/join2 "expected " (.want e)))))
        (mut rels) (ArrayList::new [Relation] (malloc-allocator))
        (mut clauses) (ArrayList::new [Clause] (malloc-allocator))]
    (for item (.kids (get (.kids tree) 0))
      (if (= (.kind item) (g/KRelation))
          (let [a (atom-of src item false)
                n (len (.args a))]
            (when (or (< n 1) (> n 4))
              (dsl/die (mut c) (.tok a) "a relation has 1 to 4 columns"))
            (push! (mut rels)
                   (Relation
                     :name (.rel a)
                     :arity n
                     :stratum 0)))
          (let [head-node (get (.kids item) 0)
                head (head-of src head-node)
                (mut body) (ArrayList::new [Atom] (malloc-allocator))
                (mut agg) 0
                (mut agg-col) -1
                args (.kids (get (.kids head-node) 1))]
            (for i (range 0 (len args))
              (let [kind (agg-kind (get args i))]
                (when (> kind 0)
                  (when (> agg 0)
                    (dsl/die (mut c) (.tok head) "a rule aggregates one column of its head"))
                  (set! agg kind)
                  (set! agg-col i))))
            (for b (.kids (get (.kids item) 1))
              (push! (mut body) (body-atom-of src b)))
            (push! (mut clauses)
                   (Clause
                     :head head
                     :body body
                     :sink "db"
                     :agg agg
                     :agg-col agg-col)))))
    ;; Checked after reading, so a rule may precede its relation's declaration.
    (for k clauses
      (arity-of rels (mut c) (.head k))
      (for a (.body k) (unless (differs? a) (arity-of rels (mut c) a))))
    ;; An aggregate is the one rule of its relation: what it counts is all the relation says.
    (for ki (range 0 (len clauses))
      (let [k (get clauses ki)]
        (when (> (.agg k) 0)
          (for ji (range 0 (len clauses))
            (let [j (get clauses ji)]
              (when (and (!= ji ki) (= (.rel (.head j)) (.rel (.head k))))
                (dsl/die (mut c) (.tok (.head j)) (dsl/join2 "another rule for the aggregate " (.rel (.head k))))))))))
    (let [top (stratify! (mut rels) clauses (mut c))
          (mut fields) (primitive/code-list-new)
          (mut inits) (primitive/code-list-new)
          (mut api) (primitive/code-list-new)
          (mut strata) (primitive/code-list-new)
          (mut reserves) (primitive/code-list-new)
          (mut adds) (primitive/code-list-new)
          (mut room) (primitive/code-list-new)
          (mut rederive-fns) (primitive/code-list-new)
          (mut rule-fns) (primitive/code-list-new)
          (mut updates) (primitive/code-list-new)
          (mut same-checks) (primitive/code-list-new)
          (mut tallies) (primitive/code-list-new)
          (mut estimates) (primitive/code-list-new)
          (mut applies) (primitive/code-list-new)
          (mut begins) (primitive/code-list-new)
          (mut settles) (primitive/code-list-new)
          (mut deltas) (primitive/code-list-new)
          (mut encodes) (primitive/code-list-new)
          (mut decodes) (primitive/code-list-new)
          (mut holds) (primitive/code-list-new)
          (mut index) 0]
      (for r rels
        (let [field (primitive/code-symbol (.name r))
              access (field-sym (.name r))
              add (primitive/code-symbol "add-" (.name r) "!")
              has (primitive/code-symbol "has-" (.name r) "?")
              (mut params) (primitive/code-list-new)
              (mut args) (primitive/code-list-new)
              (mut columns) (primitive/code-list-new)]
          (push! (mut fields) `(~field rt/Rel))
          (push! (mut inits) (primitive/code-symbol ":" (.name r)))
          (push! (mut inits) `(rt/rel-new ~(.arity r)))
          (push! (mut holds) `(rt/rel-held! (~access db)))
          (for i (range 0 4)
            (push! (mut columns)
                   (primitive/code-symbol ":" (subslice "abcd" i (+ i 1))))
            (if (< i (.arity r))
                (let [p (primitive/code-symbol "a" i)]
                  (push! (mut params) `(~p i64))
                  (push! (mut args) p)
                  (push! (mut columns) `(fact-column ~p)))
                (do
                  (push! (mut args) `0)
                  (push! (mut columns) `(: 0 i32)))))
          (push! (mut api)
                 `(defn ~add [(db (mut Db)) ~@params] (-> bool)
                    (rt/rel-add! (mut (~access db)) ~@args)))
          (push! (mut api)
                 `(defn ~has [(db (mut Db)) ~@params] (-> bool)
                    (rt/rel-has? (mut (~access db)) ~@args)))
          ;; A row of this relation as a value, to be added with the others: `fact-REL`.
          (push! (mut api)
                 `(defn ~(primitive/code-symbol "fact-" (.name r)) [~@params]
                    (-> Fact)
                    (Fact :rel (: ~index i32) ~@columns)))
          (push! (mut adds) `(= (.rel f) (: ~index i32)))
          (push! (mut adds)
                 `(do
                    (rt/rel-add! (mut (~access db))
                                 (cast i64 (.a f))
                                 (cast i64 (.b f))
                                 (cast i64 (.c f))
                                 (cast i64 (.d f)))
                    0))
          (push! (mut tallies) `(= (.rel f) (: ~index i32)))
          (push! (mut tallies)
                 (if (derived? clauses (.name r))
                     `(panic "facts are given for {}, which rules derive" ~(.name r))
                     `(rt/rel-tally! (mut (~access db))
                                     (cast i64 (.a f))
                                     (cast i64 (.b f))
                                     (cast i64 (.c f))
                                     (cast i64 (.d f))
                                     by)))
          (push! (mut begins) `(rt/rel-begin! (mut (~access db))))
          (push! (mut settles) `(rt/rel-settle! (mut (~access db))))
          (push! (mut deltas) `(push! (mut gone) (rt/rel-rows (mut (~access minus)))))
          (push! (mut deltas) `(push! (mut come) (rt/rel-rows (mut (~access plus)))))
          (push! (mut encodes) `(rt/rel-encode! w (~access db)))
          (push! (mut decodes) `(set! (~access db) (rt/rel-decode r)))
          (push! (mut room)
                 `(when (> (get counts ~index) 0)
                    (rt/rel-reserve! (mut (~access db)) (get counts ~index))))
          (set! index (+ index 1))
          (push! (mut reserves) `(= name ~(.name r)))
          (push! (mut reserves) `(rt/rel-reserve! (mut (~access db)) n))))
      (for ci (range 0 (len clauses))
        (push! (mut rederive-fns) (rederive-code (mut c) (get clauses ci) ci)))
      (for group (groups-in-order rels clauses)
        (push! (mut updates) (update-stratum (mut c) rels clauses group)))
      (for r rels
        (let [f (field-sym (.name r))]
          (push! (mut same-checks)
                 `(unless (rt/rel-same-rows? (mut (~f db)) (mut (~f whole)))
                    (panic "solved-from: {} differs from solving afresh"
                           ~(.name r))))
          (unless (derived? clauses (.name r))
            (push! (mut estimates)
                   `(do
                      (set! rows (+ rows (rt/rel-live-count (mut (~f prev)))))
                      (set! changes (+ changes (rt/rel-tally-changes (mut (~f tally)))))))
            (push! (mut applies)
                   `(if known
                        (rt/rel-apply-tally! (mut (~f db)) (mut (~f tally)) (mut (~f plus)) (mut (~f minus)))
                        (rt/rel-reset-tally! (mut (~f db)) (mut (~f tally)) (mut (~f plus)) (mut (~f minus))))))))
      (for s (range 0 (+ top 1))
        (let [(mut group) (ArrayList::new [(slice u8)] (malloc-allocator))]
          (for r rels
            (when (and (= (.stratum r) s) (derived? clauses (.name r)))
              (push! (mut group) (.name r))))
          (let [made (stratum-rounds (mut c) rels clauses group s)]
            (push! (mut strata) (.solve made))
            (push! (mut rule-fns) (.run made)))))
      (dsl/render `(do
                     (import "hl.rt" :as rt)
                     (import "coil.primitive" :as primitive)
                     (import "coil.arraylist" :use [ArrayList])
                     (import "coil.alloc" :use [malloc-allocator])
                     (import "coil.control" :use [return-from])
                     (import "coil.atomic" :as atomic)
                     ;; A row of a relation, numbered in the file's order. Every id a relation holds fits in 32
                     ;; bits, which keeps a program's many rows small.
                     (defstruct Fact
                       [(rel i32) (a i32) (b i32) (c i32) (d i32)])
                     (defstruct Db
                       [~@fields
                        (known bool)
                        (blocks (ArrayList (ArrayList Fact)))
                        (id i64)
                        (from i64)
                        (gone (ArrayList (ArrayList i64)))
                        (come (ArrayList (ArrayList i64)))])
                     (defn fact-column [(v i64)] (-> i32)
                       (when (or (< v -2147483648) (> v 2147483647))
                         (panic "{} is too big for a fact" v))
                       (cast i32 v))
                     ;;; A database, its relations empty. One solved from blocks of facts (see `solved-blocks`)
                     ;;; knows the blocks, and how many facts state each given row, so the next can be made
                     ;;; from it by what the blocks that differ change (see `solved-from`). Each database has
                     ;;; an id of its own, and one made from another in place says which (`from`) and what
                     ;;; each relation, by its number, lost (`gone`) and gained (`come`).
                     (defn new-db [] (-> Db)
                       (Db ~@inits
                           :known false
                           :blocks (ArrayList::new [(ArrayList Fact)] (rt/value-allocator))
                           :id (rt/db-id-next!)
                           :from -1
                           :gone (ArrayList::new [(ArrayList i64)] (rt/value-allocator))
                           :come (ArrayList::new [(ArrayList i64)] (rt/value-allocator))))
                     ;;; What is being made holds `db`: each of its relations, whose memory is a region
                     ;;; of its own (see `rt/rel-new`), so a database made from another (`solved-from`)
                     ;;; holds the relations it shares with it, and not the other.
                     (defn regions-held! [(db Db)] (-> void)
                       ~@holds
                       0)
                     ;;; A database of these rows, in this order, and everything the rules derive from them.
                     (defn solved [(facts (ArrayList Fact))] (-> Db)
                       (let [(mut db) (new-db)]
                         (add-facts! (mut db) facts)
                         (solve! (mut db))
                         db))
                     ;;; The same from blocks of facts, one after another, knowing them and how many facts
                     ;;; state each row: what `solved-from` makes the next from.
                     (defn solved-blocks [(blocks (ArrayList (ArrayList Fact)))] (-> Db)
                       (let [(mut db) (new-db)
                             (mut counts) (ArrayList::new [i64] (malloc-allocator))]
                         (for i (range 0 ~index) (push! (mut counts) 0))
                         (for b blocks
                           (for (ref f) b
                             (let [r (cast i64 (.rel f))]
                               (set! (mut counts) r (+ (get counts r) 1)))))
                         ~@room
                         (free! (mut counts))
                         (tally-apart! (mut db) blocks)
                         (solve! (mut db))
                         (set! (.known db) true)
                         (set! (.blocks db) blocks)
                         db))
                     ;;; Every block's facts counted in, a relation at a time: a relation's rows are its
                     ;;; own memory, so each is filled by whichever thread takes it, in the order the
                     ;;; blocks give its facts, while others fill others.
                     (defstruct TallyJob [(next i64) (db (ptr Db)) (facts (ArrayList (ArrayList Fact)))])
                     (defn tally-apart! [(db (mut Db)) (blocks (ArrayList (ArrayList Fact)))] (-> void)
                       (let [(mut by-relation) (ArrayList::new [(ArrayList Fact)] (malloc-allocator))]
                         (for i (range 0 ~index)
                           (push! (mut by-relation) (ArrayList::new [Fact] (malloc-allocator))))
                         (for b blocks
                           (for (ref f) b
                             (push! (elem (mut by-relation) (cast i64 (.rel f))) (load f))))
                         (let [(mut job) (TallyJob :next 0
                                                   :db (primitive/cast (ptr Db) (mut db))
                                                   :facts by-relation)]
                           (rt/run-map-workers (fnptr-of tally-job) (cast (ptr i8) (mut job)) (rt/pool-size)))
                         (for i (range 0 ~index) (free! (elem (mut by-relation) i)))
                         (free! (mut by-relation)))
                       0)
                     (defn tally-job [(arg (ptr i8))] (-> (ptr i8))
                       (let [j (cast (ptr TallyJob) arg)
                             (mut go) true]
                         (while go
                           (let [i (atomic/add (cast (ptr i64) j) 1)]
                             (if (< i (len (.facts j)))
                                 (tally! (.db j) (get (.facts j) i) 1)
                                 (set! go false))))
                         arg))
                     ;;; Each fact of `facts` counted `by` more (or fewer) times in `db`'s relation for it.
                     (defn tally! [(db (mut Db)) (facts (ArrayList Fact)) (by i64)] (-> void)
                       (for (ref f) facts
                         (cond ~@tallies :else
                               (panic "no relation numbered {}" (.rel f))))
                       0)
                     ;;; In `tally`, the facts of the blocks `now` has and `before` has not counted in, and
                     ;;; those `before` has and `now` has not counted out. A block is the same as itself:
                     ;;; one a build kept (a memo's answer) is not looked into.
                     (defn blocks-tally! [(tally (mut Db))
                                          (before (ArrayList (ArrayList Fact)))
                                          (now (ArrayList (ArrayList Fact)))] (-> void)
                       (let [(mut left) (rt/int-table 0)]
                         (for b before
                           (let [id (block-id b)]
                             (rt/int-put! (mut left) id (+ (max0 (rt/int-get (mut left) id)) 1))))
                         (for b now
                           (let [id (block-id b)
                                 n (rt/int-get (mut left) id)]
                             (if (> n 0)
                                 (rt/int-put! (mut left) id (- n 1))
                                 (tally! (mut tally) b 1))))
                         (for b before
                           (let [id (block-id b)
                                 n (rt/int-get (mut left) id)]
                             (when (> n 0)
                               (rt/int-put! (mut left) id (- n 1))
                               (tally! (mut tally) b -1))))
                         (free! (mut (.keys left)))
                         (free! (mut (.vals left))))
                       0)
                     (defn block-id [(b (ArrayList Fact))] (-> i64)
                       (if (= (len b) 0) 0 (primitive/cast i64 (data (slice b)))))
                     (defn max0 [(n i64)] (-> i64)
                       (if (< n 0) 0 n))
                     ;;; Rows added in the order given, each relation made big enough for its own first.
                     (defn add-facts! [(db (mut Db)) (facts (ArrayList Fact))]
                       (-> void)
                       (let [(mut counts)
                               (ArrayList::new [i64] (malloc-allocator))]
                         (for i (range 0 ~index) (push! (mut counts) 0))
                         (for (ref f) facts
                           (let [r (cast i64 (.rel f))]
                             (set! (mut counts) r (+ (get counts r) 1))))
                         ~@room
                         (for (ref f) facts
                           (cond ~@adds :else
                                 (panic "no relation numbered {}" (.rel f))))
                         (free! (mut counts)))
                       0)
                     ~@api
                     ;;; Room in the relation named `name` for `n` more rows, which are known to be coming.
                     (defn reserve! [(db (mut Db)) (name (slice u8)) (n i64)]
                       (-> void)
                       (cond ~@reserves :else
                             (panic "no relation named {}" name))
                       0)
                     ;;; Run each stratum until a whole round adds nothing. Answers the rounds.
                     (defn solve! [(db (mut Db))] (-> i64)
                       (let [(mut rounds) 0]
                         ~@strata
                         ~(if (rule-times?) `(rt/rule-times-report!) `0)
                         rounds))
                     ~@rederive-fns
                     ~@rule-fns
;;; What `solved-blocks` makes of `blocks`, made from `last`, what it made of others: only
                     ;;; what the facts that differ change is derived again or taken out (see
                     ;;; `update-stratum`), in place: `last`'s relations are changed, and `last` is not to be
                     ;;; read after. The blocks `last` was made from that are the same in `blocks` are not
                     ;;; looked into, so what this costs is what changed. When most rows would change,
                     ;;; solving afresh costs less, and is what happens; and a database whose counts are not
                     ;;; known (one read back from the cache) has every fact counted again, once. With
                     ;;; HL_CHECK_DATALOG set, each relation is checked against solving afresh.
                     (defn solved-from [(last Db) (blocks (ArrayList (ArrayList Fact)))]
                       (-> Db)
                       (let [(mut tally) (new-db)
                             (mut prev) last
                             known (.known last)]
                         (if known
                             (blocks-tally! (mut tally) (.blocks last) blocks)
                             (for b blocks (tally! (mut tally) b 1)))
                         (let [(mut changes) 0
                               (mut rows) 0]
                           ;; Counts not known: every row is counted again as the update begins, which
                           ;; says what changed.
                           (when known ~@estimates)
                           ;; No row changes: the very database it was, which is what says so. The blocks
                           ;; it knows hold the same facts as these.
                           (cond (and known (= changes 0)) last
                                 (and known (> (* changes 4) rows)) (solved-blocks blocks)
                                 :else (updated-in-place last tally known blocks)))))
                     (defn updated-in-place [(last Db) (tally Db) (known bool) (blocks (ArrayList (ArrayList Fact)))]
                       (-> Db)
                       (let [(mut old) last
                             (mut db) last
                             (mut tally) tally
                             (mut plus) (new-db)
                             (mut minus) (new-db)
                             (mut gone) (ArrayList::new [(ArrayList i64)] (rt/value-allocator))
                             (mut come) (ArrayList::new [(ArrayList i64)] (rt/value-allocator))
                             (mut rounds) 0]
                         ~@begins
                         ~@applies
                         ~@updates
                         ~@settles
                         ~@deltas
                         (set! (.known db) true)
                         (set! (.blocks db) blocks)
                         (set! (.id db) (rt/db-id-next!))
                         (set! (.from db) (.id last))
                         (set! (.gone db) gone)
                         (set! (.come db) come)
                         (when (rt/env-on? "HL_CHECK_DATALOG")
                           (let [(mut whole) (solved-blocks blocks)]
                             ~@same-checks
                             0))
                         db))
                     ;;; Whether `after` was made from `before` in place, so what it says it lost and gained
                     ;;; is what changed from one to the other.
                     (defn made-from? [(before Db) (after Db)] (-> bool)
                       (= (.from after) (.id before)))
                     ;;; The rows relation `i` lost, or gained, as `after` was made from the one before.
                     (defn rows-gone [(after Db) (i i64)] (-> (ArrayList i64))
                       (if (< i (len (.gone after)))
                           (get (.gone after) i)
                           (ArrayList::new [i64] (rt/value-allocator))))
                     (defn rows-come [(after Db) (i i64)] (-> (ArrayList i64))
                       (if (< i (len (.come after)))
                           (get (.come after) i)
                           (ArrayList::new [i64] (rt/value-allocator))))
                     ;;; A database, for the cache: the rows of its relations that are in. Read back, it
                     ;;; knows no blocks and no counts.
                     (defn db-encode! [(w (ptr rt/Writer)) (db Db)] (-> void)
                       ~@encodes
                       0)
                     (defn db-decode [(r (ptr rt/Reader))] (-> Db)
                       (let [(mut db) (new-db)]
                         ~@decodes
                         db)))))))

(defn read-facts [(context Code)] (-> Code)
  (primitive/code-read (module-text context) `(reader-config)))
