;;; Generic runtime regressions: sparse page lookup and isolated scratch storage.
(module boot.runtime-check)
(import "hl.symtab" :as sym)
(import "hl.rt" :as rt)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [alloc malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.hashmap" :use [i64-keyops])

(defstruct Payload [(tag i64) (padding (array i64 128))])

(defn tracking-a [] (-> bool) (rt/dep-tracking?))
(defn tracking-b [] (-> bool) (rt/dep-tracking?))

(defn relation-index-check [] (-> void)
  (let [(mut r) (rt/rel-new 2)]
    (rt/rel-add! (mut r) 100000 1 0 0)
    (rt/rel-add! (mut r) -7 2 0 0)
    (rt/rel-add! (mut r) 100000 3 0 0)
    (let [rows (rt/rel-bucket (mut r) 0 100000)
          (mut seen) (ArrayList::new [i64] (malloc-allocator))]
      (for row rows (push! (mut seen) row))
      (when (or (!= (len rows) 2) (!= (len seen) 2) (!= (get seen 0) 0) (!= (get seen 1) 2))
        (panic "dense index changed insertion order")))
    (when (!= (len (rt/rel-bucket (mut r) 0 99999)) 0) (panic "empty dense key has rows"))
    (when (!= (len (rt/rel-bucket (mut r) 0 -7)) 1) (panic "sparse index lost a row"))
    (rt/rel-add! (mut r) 100000 4 0 0)
    (rt/rel-add! (mut r) -7 5 0 0)
    (when (!= (len (rt/rel-bucket (mut r) 0 100000)) 3) (panic "dense index missed an appended row"))
    (when (!= (len (rt/rel-bucket (mut r) 0 -7)) 2) (panic "sparse index missed an appended row"))
    (let [dense (get (.dense r) 0) heads (.heads (get (.index r) 0))]
      (when (or (!= (get dense 99999) (: 0 i32)) (!= (len heads) 2))
        (panic "dense index made slots for absent keys")))
    ;; A walk begun before a row joined its chain sees the rows there were.
    (let [rows (rt/rel-bucket (mut r) 0 -7)
          (mut walked) 0]
      (rt/rel-add! (mut r) -7 6 0 0)
      (for row rows (set! walked (+ walked 1)))
      (when (!= walked 2) (panic "a walk saw a row that joined after it began"))
      (when (!= (len (rt/rel-bucket (mut r) 0 -7)) 3) (panic "sparse index missed a third row"))))
  0)

;;; A relation's rows are found by what they hold through every growth of its table; a row taken
;;; out is passed by, and the same row added again is a new one; a column must fit 32 bits.
(defn relation-rows-check [] (-> void)
  (let [(mut r) (rt/rel-new 3)]
    (for i (range 0 20000)
      (unless (rt/rel-add! (mut r) i (* i 7) -3 0) (panic "a new row was taken for an old one")))
    (for i (range 0 20000)
      (when (rt/rel-add! (mut r) i (* i 7) -3 0) (panic "a row was added twice"))
      (when (!= (rt/rel-find (mut r) i (* i 7) -3 0) i) (panic "a row was not found where it is")))
    (when (rt/rel-has? (mut r) 5 36 -3 0) (panic "a row that is not there was found"))
    (unless (rt/rel-kill! (mut r) 5 35 -3 0) (panic "a row could not be taken out"))
    (when (rt/rel-has? (mut r) 5 35 -3 0) (panic "a row taken out is still found"))
    (unless (rt/rel-add! (mut r) 5 35 -3 0) (panic "a row taken out could not be added again"))
    (when (!= (rt/rel-find (mut r) 5 35 -3 0) 20000) (panic "the row added again is not the one found"))
    (when (!= (rt/rel-at (mut r) 7 2) -3) (panic "a negative column changed")))
  0)

;;; One text, kept once: the same bytes whoever asks, and from a copy elsewhere.
(defn kept-text-check [] (-> void)
  (let [a (rt/kept-text "features/one.js")
        b (rt/kept-text (rt/text-copy "features/one.js"))
        c (rt/kept-text "features/two.js")]
    (when (!= (primitive/cast i64 (data a)) (primitive/cast i64 (data b)))
      (panic "one text was kept twice"))
    (when (= (primitive/cast i64 (data a)) (primitive/cast i64 (data c)))
      (panic "two texts were kept as one"))
    (when (!= b "features/one.js") (panic "a kept text changed")))
  0)

;;; What `distinct` lets by: each key once, the first few in place and the rest in a table.
(defn int-seen-check [] (-> void)
  (let [(mut s) (rt/int-seen)
        (mut fresh) 0]
    (for round (range 0 3)
      (for key (range 0 100)
        (when (rt/int-seen-add! (mut s) (* key 3)) (set! fresh (+ fresh 1)))))
    (when (!= fresh 100) (panic "distinct keys were let by more than once, or not at all")))
  0)

;;; A value out of scratch storage: what was made there is copied, what was made outside is
;;; shared, and a list reached twice is still one list.
(defn scratch-copy-check [] (-> void)
  (let [(mut outside) (ArrayList::new [i64] (rt/value-allocator))]
    (for i (range 0 100) (push! (mut outside) i))
    (let [scratch (rt/scratch-enter!)
          (mut inside) (ArrayList::new [i64] (rt/value-allocator))]
      (for i (range 0 100) (push! (mut inside) (* i 2)))
      (rt/region-leave!)
      (unless (rt/scratch-holds? scratch (rt/list-storage inside)) (panic "a list made in scratch storage is not in it"))
      (when (rt/scratch-holds? scratch (rt/list-storage outside)) (panic "a list made outside scratch storage is in it"))
      (rt/own-begin!)
      (let [kept-outside (rt/ints-own-in scratch outside)
            copy (rt/ints-own-in scratch inside)
            again (rt/ints-own-in scratch inside)]
        (rt/own-end!)
        (rt/scratch-dispose! scratch)
        (when (!= (rt/list-storage kept-outside) (rt/list-storage outside)) (panic "a list outside scratch storage was copied"))
        (when (rt/scratch-space-holds? (rt/list-storage copy)) (panic "a copy out of scratch storage is still in it"))
        (when (!= (rt/list-storage copy) (rt/list-storage again)) (panic "one list reached twice was copied twice"))
        (when (or (!= (len copy) 100) (!= (get copy 99) 198)) (panic "a copy out of scratch storage lost its values")))))
  0)

(defn memo-map-check [] (-> void)
  (let [(mut values) (rt/MemoMap::new [i64 Payload] (i64-keyops))
        (mut small) (rt/MemoMap::new [i64 bool] (i64-keyops))]
    (for wave (range 0 10)
      (for key (range 0 5000)
        (set! (mut values) key (Payload :tag (+ key wave) :padding (primitive/zeroed (array i64 128))))
        (set! (mut small) key true))
      (when (!= (len values) 5000) (panic "memo map lost an insertion"))
      (for key values
        (match (get values key)
          (Some [v] (when (!= (.tag v) (+ key wave)) (panic "memo map returned stale data")))
          (None [] (panic "memo map iteration visited a missing key"))))
      (for key (range 0 5000)
        (when (!= (rt/MemoMap::remove! (mut values) key) 1) (panic "memo map removal failed"))
        (when (!= (rt/MemoMap::remove! (mut values) key) 0) (panic "memo map removed a key twice"))
        (rt/MemoMap::remove! (mut small) key))
      (when (or (!= (len values) 0) (!= (len small) 0)) (panic "memo map retained removed keys"))
      (when (!= (len (.values values)) 5000) (panic "memo map did not reuse vacant slots")))
    (free! (mut values))
    (free! (mut small)))
  0)

(defn lookup-check [] (-> void)
  (let [(mut blocks) (ArrayList::new [sym/Block] (rt/value-allocator))]
    (for i (range 0 2200)
      ;; Equal starts, one empty block, one real block, then a gap.
      (for width (range 0 2)
        (let [(mut symbols) (ArrayList::new [sym/Symbol] (rt/value-allocator))]
          (when (= width 1) (push! (mut symbols) (primitive/zeroed sym/Symbol)))
          (push! (mut blocks)
                 (sym/Block :scopes (ArrayList::new [sym/Scope] (rt/value-allocator))
                            :symbols symbols :scope-start (* i 3) :symbol-start (* i 3)
                            :roots (ArrayList::new [i64] (rt/value-allocator)) :dynamic false)))))
    (let [order (sym/identity-order (len blocks))
          pages (sym/pages-of blocks order false 6600)]
      (for id (range -1 6700)
        (let [want (if (and (>= id 0) (< id 6600) (= (% id 3) 0)) (+ (* (/ id 3) 2) 1) -1)
              got (sym/block-at blocks order pages false id)]
          (when (!= got want) (panic "sparse block lookup {}: {} expected {}" id got want)))))
    ;; The same search with physical storage reversed and an explicit sorted index.
    (let [(mut reverse) (ArrayList::new [sym/Block] (rt/value-allocator))
          (mut order) (ArrayList::new [i64] (rt/value-allocator))]
      (for i (range 0 (len blocks))
        (push! (mut reverse) (get blocks (- (- (len blocks) 1) i)))
        (push! (mut order) (- (- (len blocks) 1) i)))
      (let [pages (sym/pages-of reverse order false 6600)]
        (for id (range -1 6700)
          (let [want (if (and (>= id 0) (< id 6600) (= (% id 3) 0))
                         (- (- (len blocks) 1) (+ (* (/ id 3) 2) 1)) -1)
                got (sym/block-at reverse order pages false id)]
            (when (!= got want) (panic "indexed block lookup {}: {} expected {}" id got want)))))))
  0)

(defn scratch-check [] (-> void)
  (for turn (range 0 100)
    (let [scratch (rt/scratch-enter!)]
      (for i (range 0 1000)
        (let [(mut xs) (ArrayList::new [i64] (rt/value-allocator))]
          (reserve! (mut xs) 40)
          (for n (range 0 40) (push! (mut xs) (+ n i)))
          (when (!= (get xs 39) (+ 39 i)) (panic "scratch storage corrupted"))))
      (rt/region-leave!)
      (rt/scratch-dispose! scratch)))
  0)

;;; Settings copy short-lived values, share retained answers, and keep only the regions of the
;;; parts they actually share. Releasing the original owners must leave the setting readable.
(defn setting-copy-check [] (-> void)
  (rt/reclaim!)
  (let [v (rt/var-region-open!)
        (mut xs) (ArrayList::new [i64] (rt/value-allocator))]
    (push! (mut xs) 41)
    (rt/answer-region-close! v)
    (let [parent (rt/answer-region-open! "test parent")
          (mut ys) (ArrayList::new [i64] (rt/value-allocator))]
      (push! (mut ys) 42)
      (let [setting (rt/setting-region-open! "test setting")]
        (rt/own-begin!)
        (let [x (rt/ints-own-in (rt/setting-copy-from) xs)
              y (rt/ints-own-in (rt/setting-copy-from) ys)]
          (rt/own-end!)
          (rt/answer-region-close! setting)
          (rt/answer-region-close! parent)
          (when (or (= (rt/list-storage x) (rt/list-storage xs))
                    (= (rt/list-storage y) (rt/list-storage ys)))
            (panic "a setting shared a var's or parent's storage"))
          (rt/var-region-release! v)
          (rt/region-release-id! parent)
          (rt/regions-safe-point!)
          (when (or (!= (get x 0) 41) (!= (get y 0) 42))
            (panic "a setting lost a copied value"))
          (rt/region-release-id! setting)))))
  (let [answer (rt/answer-region-open! "test answer")
        (mut xs) (ArrayList::new [i64] (rt/value-allocator))]
    (push! (mut xs) 43)
    (rt/answer-region-close! answer)
    (let [setting (rt/setting-region-open! "test sharing")]
      (rt/own-begin!)
      (let [x (rt/ints-own-in (rt/setting-copy-from) xs)]
        (rt/own-end!)
        (rt/answer-region-close! setting)
        (when (!= (rt/list-storage x) (rt/list-storage xs)) (panic "an answer was copied instead of shared"))
        (rt/region-release-id! answer)
        (rt/regions-safe-point!)
        (when (!= (get x 0) 43) (panic "a setting did not hold its shared answer"))
        (let [address (rt/list-storage x)]
          (rt/region-release-id! setting)
          (rt/regions-safe-point!)
          (when (!= (rt/region-at address) 0) (panic "a released chunk stayed indexed"))))))
  0)

;;; Context keys retain the whole argument and unambiguously delimit arbitrary context names.
(defn context-key-check [] (-> void)
  (let [outside (rt/context-text-key "client\x01;value")]
    (rt/context-enter! "client")
    (let [inside (rt/context-text-key "value")
          low (rt/context-int-key 7)
          high (rt/context-int-key 288230376151711751)]
      (when (= outside inside) (panic "a context key collided with an outside key"))
      (when (= low high) (panic "a context key discarded an integer's high bits"))
      (when (= (rt/context-int-key -1) (rt/context-int-key 288230376151711743))
        (panic "a negative context key collided"))
      (rt/context-leave!)
      (rt/context-enter! "client")
      (when (!= low (rt/context-int-key 7)) (panic "a context key changed on reentry"))
      (rt/context-leave!)))
  (rt/context-enter! "a")
  (let [one (rt/context-text-key "b\x01;c")]
    (rt/context-leave!)
    (rt/context-enter! "a\x01;b")
    (when (= one (rt/context-text-key "c")) (panic "context names and arguments were not delimited"))
    (rt/context-leave!))
  0)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (when (> argc 1)
    (let [scratch (rt/scratch-enter!)
          bytes (match (alloc [u8] (rt/value-allocator) 1)
                  (Some [xs] xs)
                  (None [] (panic "scratch allocation failed")))]
      (store! (data bytes) (: 7 u8))
      (rt/region-leave!)
      (rt/scratch-dispose! scratch)
      ;; With HL_REGION_CHECK=1 this must fault, never print a stale value.
      (println "released value: {}" (get bytes 0))))
  (context-key-check)
  (lookup-check)
  (scratch-check)
  (memo-map-check)
  (relation-index-check)
  (relation-rows-check)
  (kept-text-check)
  (int-seen-check)
  (scratch-copy-check)
  (when (or (tracking-a) (tracking-b)) (panic "tracking started before it was enabled"))
  (setting-copy-check)
  (rt/dep-track!)
  (when (not (and (tracking-a) (tracking-b))) (panic "tracking switch is not shared"))
  (println "generic runtime checks passed")
  0)
