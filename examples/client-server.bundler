# Run from tests/: ../out/bin/spec ../examples/client-server.bundler
bundler
target app
  entry "apps/client-server/server.js"
  outfile "../out/client-server/server.cjs"
  client-outfile "../out/client-server/public/client.mjs"
  client-manifest "../out/client-server/public/manifest.json"
  define process.env.NODE_ENV = "production"
  minify
end
