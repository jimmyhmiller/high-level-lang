# Run from tests/. Application behavior remains ordinary JS; build policies are declarative.
bundler
target browser
  entry "apps/workbench/client/main.jsx"
  outdir "../out/workbench/public"
  format esm
  splitting
  chunk-policy balanced
  fragments on
  define process.env.NODE_ENV = "production"
  public-path "/static/"
  loader ".svg" = file
  loader ".txt" = text
  minify
  sourcemap
  analyze "../out/workbench/analysis"
end

target api
  entry "apps/workbench/server/main.js"
  outfile "../out/workbench/server.mjs"
  format esm
  platform node
  define process.env.NODE_ENV = "production"
  minify
  sourcemap
end
