# Rewrites of each module's code as it loads (bundle.rewrites): `esb ... --rewrite=examples/rewrites.lint`,
# or `rewrite "…"` in a build spec. They are made before scopes and linking, so tree shaking sees what
# they make: a call taken out takes what only it read with it, and with `--minify-syntax` a branch a
# rewritten flag decides goes, and all only that branch read. A condition reads what a name the
# pattern matched is in its module (`imported`, `global`, `local`), never a guess by its spelling.

# Assertions are for development: every call of `assert` imported from the project's assertions,
# taken out, and the module with them.
rewrite no-asserts `$A($$X)` => `` :- imported(A, "./assert.js", "assert") ;

# Features turned off for this build: `flags.beta` is `false`, and what only the beta branch reads
# is not shipped.
off("beta");
rewrite flags-off `$Fl.$F` => `false` :- imported(Fl, "./flags.js", "flags"), off(F) ;

# A helper the language has now: lodash-style `get(o, k)` from a package, written as `o?.[k]`, and
# the package no longer shipped. A function of the module's own called `get` is left as it is.
rewrite no-get `$G($O, $K)` => `$O?.[$K]` :- imported(G, "tiny-get", "get") ;

# The project's logging gone from what it builds, where `console` is the global one; a module that
# declares its own `console` keeps its calls.
rewrite no-console-log `$C.log($$A)` => `` :- global(C), C = "console", in-module(M), !starts-with(M, "node_modules/") ;
