(module g.helper-lang)
(import "coil.primitive" :as primitive)
(reader-provider "g.helper-lang" read-it)
;; `helper` prints the Code it receives. Expected (METAPROGRAMS.md: "a call to a
;; Code-signature function whose arguments all typecheck as Code stays a FUNCTION
;; call"): the value of t. Actual: the symbol t.
(defn helper [(f Code)] (-> Code)
  (println "helper saw: {}" (primitive/code-source f))
  f)
(defn read-it [(context Code)] (-> Code)
  (let [t `(defn v [] (-> i64) 1)] (helper t)))
