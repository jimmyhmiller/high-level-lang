(module repro)
(import "coil.primitive" :as primitive)

;; Pushing onto a code list held in a local works.
(defn local-ok [] (-> Code)
  (let [(mut xs) (primitive/code-list-new)]
    (push! (mut xs) `1)
    `(do ~@xs)))

;; The same push through a `(mut Code)` parameter does not compile:
;;   error: in 'repro.add-one!': 'code' does not implement 'Push'
(defn add-one! [(xs (mut Code))] (-> void)
  (push! (mut xs) `1))

(defn main [] (-> i64) 0)
