(module cr.gen)
(import "coil.primitive" :as primitive)
(reader-provider "cr.gen" read-it)
(defstruct Big [(x i64)])
(const LIMIT 3)
(defn limit [] (-> i64) LIMIT)
(defn read-it [(context Code)] (-> Code)
  (primitive/code-read (primitive/int->str (limit)) `(reader-config))
  `(do))
;;; The same module also serves as a compile-time library for a (meta …) generator.
(defn define-from [(s (slice u8))] (-> Code)
  (println "generator sees limit {}" (limit))
  `(do))
