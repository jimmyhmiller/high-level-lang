;;; Language A publishes compile-time knowledge: a function from nothing to Code.
(module recipe.table-lang)
(import "coil.primitive" :as primitive)
(reader-provider "recipe.table-lang" read-table)
(defn read-table [(context Code)] (-> Code)
  (let [t `(do (defn node-table [] (-> Code) `((Add 2) (Num 0) (Sub 2))))]
    (primitive/code-read (primitive/code-source t) `(reader-config))))
