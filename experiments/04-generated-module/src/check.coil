(module recipe.check)
(import "coil.primitive" :as primitive)
;;; Runs at compile time, on what language A published.
(defn size-const [(table Code)] (-> Code)
  (println "compile time: the other language's table has {} entries" (primitive/code-count table))
  (let [name (primitive/syntax->datum `TABLE-SIZE)]
    `(const ~name ~(primitive/code-count table))))
