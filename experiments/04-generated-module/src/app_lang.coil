;;; Language B consumes it. The recipe: write the module as a template, render it
;;; to text, and code-read that in the reader entry. Names then mean what the text
;;; says, so the output carries its own imports, exactly like a hand-written module.
(module recipe.app-lang)
(import "coil.primitive" :as primitive)
(reader-provider "recipe.app-lang" read-app)
(defn read-app [(context Code)] (-> Code)
  (let [t `(do
             (import "recipe.table" :as tbl)
             (import "recipe.check" :as check)
             (defn gen [] (-> Code) (check/size-const (tbl/node-table)))
             (meta (gen))
             (defn main [] (-> i64) (println "run time: table={}" TABLE-SIZE) 0))]
    (primitive/code-read (primitive/code-source t) `(reader-config))))
