;;; Smallest possible reader: dump the context, then turn each line of a
;;; non-Coil file into a definition.
(module hello.greet-reader)
(import "coil.primitive" :as primitive)

(reader-provider "hello.greet-reader" read-greet)

(defn read-greet [(context Code)] (-> Code)
  (println "reader context head:  {}" (primitive/code-sym (primitive/code-nth context 0)))
  (println "reader context count: {}" (primitive/code-count context))
  (for i (range 1 (primitive/code-count context))
    (let [item (primitive/code-nth context i)]
      (println "  [{}] string?={} list?={}" i (primitive/code-string? item) (primitive/code-list? item))
      (when (primitive/code-string? item)
        (println "       {:?}" (primitive/code-str item)))))
  (primitive/code-read "(defn hello-count [] (-> i64) 2)" `(reader-config)))
