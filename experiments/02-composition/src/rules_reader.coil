;;; .rules: emits an (import) of another reader's module, and a compile-time
;;; check that consults the OTHER language's output at expansion time.
(module compose.rules-reader)
(import "coil.primitive" :as primitive)
(import "compose.textlib" :as text)
(import "compose.rules-support" :as support)

(reader-provider "compose.rules-reader" read-rules)

(defn read-rules [(context Code)] (-> Code)
  (let [src (primitive/code-str (primitive/code-nth context 2))
        ls (text/lines src)
        target (get (get ls 0) 1)
        (mut checks) (primitive/code-list-new)]
    (for l ls
      (when (= (get l 0) "check")
        (push! (mut checks) `(~(primitive/code-symbol (get l 1)) ~(text/to-int (get l 2)))))
      )
    `(do
       (import ~target :as ~(primitive/datum->syntax context "nodes"))
       (support/check-against ~(primitive/datum->syntax context "nodes/Expr") ~@checks)
       (defn ~(primitive/datum->syntax context "rule-count") [] (-> i64)
         ~(primitive/code-count `(~@checks))))))
