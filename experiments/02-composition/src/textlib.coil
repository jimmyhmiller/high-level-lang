(module compose.textlib)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use [subslice])

;;; Whitespace-separated words of every non-blank line.
(defn lines [(src (slice u8))] (-> (ArrayList (ArrayList (slice u8))))
  (let [a (malloc-allocator)
        (mut out) (ArrayList::new [(ArrayList (slice u8))] a)
        (mut cur) (ArrayList::new [(slice u8)] a)
        (mut start) -1]
    (for i (range 0 (+ (len src) 1))
      (let [c (if (< i (len src)) (get src i) (: 10 u8))
            ws (or (= c (: 32 u8)) (= c (: 10 u8)))]
        (when (and ws (>= start 0))
          (push! (mut cur) (subslice src start i))
          (set! start -1))
        (when (and (not ws) (< start 0)) (set! start i))
        (when (= c (: 10 u8))
          (when (> (len cur) 0)
            (push! (mut out) cur)
            (set! cur (ArrayList::new [(slice u8)] a))))))
    out))

;;; Decimal digits to an integer; anything else is a hard error for the reader.
(defn to-int [(s (slice u8))] (-> i64)
  (let [(mut n) 0]
    (for c s
      (if (and (>= c #\0) (<= c #\9))
          (set! n (+ (* n 10) (- (cast i64 c) 48)))
          (primitive/error "expected a decimal integer")))
    n))
