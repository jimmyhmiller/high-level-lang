;;; A language-making language, as a compile-time library: a generator takes the
;;; text of a language definition and emits a complete reader implementation.
(module compose.langdef)
(import "coil.primitive" :as primitive)

;;; `def` is the literal text of the .langdef file. The generated reader counts
;;; lines with the given prefix, so the language definition truly shapes it.
(defn gen-reader [(def Code)] (-> Code)
  (let [text (primitive/code-str def)]
    (println "langdef generator ran on {} bytes" (len text))
    (primitive/code-read
      "(defn read-shout [(ctx Code)] (-> Code)
         (let [src (primitive/code-str (primitive/code-nth ctx 2))]
           (println \"generated reader running on {}\" (primitive/code-str (primitive/code-nth ctx 1)))
           `(defn ~(primitive/datum->syntax ctx \"shouted-size\") [] (-> i64) ~(len src))))"
      `(reader-config))))
