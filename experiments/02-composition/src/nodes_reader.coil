;;; .nodes: "Name field field" per line -> a sum type, plus a compile-time table
;;; another language can read: a function from nothing to Code.
(module compose.nodes-reader)
(import "coil.primitive" :as primitive)
(import "compose.textlib" :as text)

(reader-provider "compose.nodes-reader" read-nodes)

(defn read-nodes [(context Code)] (-> Code)
  (let [src (primitive/code-str (primitive/code-nth context 2))
        ls (text/lines src)
        (mut variants) (primitive/code-list-new)
        (mut table) (primitive/code-list-new)]
    (for l ls
      (let [(mut fields) (primitive/code-list-new)]
        (for j (range 1 (len l))
          (push! (mut fields) `(~(primitive/datum->syntax context (get l j)) i64)))
        (push! (mut variants) `(~(primitive/datum->syntax context (get l 0)) [~@fields]))
        (push! (mut table) `(~(get l 0) ~(- (len l) 1)))))
    `(do
       (defsum ~(primitive/datum->syntax context "Expr") ~@variants)
       (defn ~(primitive/datum->syntax context "node-table") [] (-> Code) `(~@table)))))
