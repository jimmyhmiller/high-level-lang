(module compose.main)
(import "compose.gen.expr" :as e)
(import "compose.gen.fold" :as fold)
(import "compose.gen.hi" :as hi)

(defn main [] (-> i64)
  (println "rules={} shouted={}" (fold/rule-count) (hi/shouted-size))
  (match (e/Num 3)
    (e/Num [v] (println "num {}" v))
    (e/Add [l r] (println "add {} {}" l r)))
  0)
