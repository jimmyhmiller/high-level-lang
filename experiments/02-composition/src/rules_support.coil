;;; A macro the .rules output expands: it REFLECTS on a type defined by another
;;; language and reports errors at expansion time.
(module compose.rules-support)
(import "coil.primitive" :as primitive)

(defn check-against [(ty Code) & (checks Code)] (-> Code)
  (println "reflect: {} has {} variants" (primitive/code-str ty) (primitive/code-variant-count ty))
  (for c checks
    (let [want (primitive/code-sym (get c 0))
          arity (primitive/code-int (get c 1))
          (mut found) false]
      (for i (range 0 (primitive/code-variant-count ty))
        (when (= (primitive/code-sym (primitive/code-variant-name ty i)) want)
          (set! found true)
          (println "  {} declared arity {} expected {}" want (primitive/code-variant-fields ty i) arity)))
      (unless found (primitive/error "rules name a node the .nodes file does not define"))))
  `(do))
